#Область Итератор

// Функция - Получить выражение итератора, аналогичная процедура в модуле обработки 
//
// Параметры:
//  чИндекс	 - Число - Итератор
// 
// Возвращаемое значение:
//   - Строка, выражение для вычисления 
//
&НаКлиенте
Функция ПолучитьВыражениеИтератора(чИндекс)
	Возврат "Объект["+Формат(чИндекс,"ЧН=0; ЧГ=")+"]";
КонецФункции

&НаКлиенте
Процедура ОбновитьПредставлениеИтератора()
	Коллекция = СтруктураПеременных.ДоступныеСтруктуры.Объект;
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(Коллекция) Тогда
		Элементы.ДекорацияКоллекция.Заголовок = "Коллекция: "+Коллекция.ПредставлениеЗначения;
		Если Не Коллекция.ОбъемКоллекции = Неопределено Тогда
			чИндекс				= Коллекция.ОбъемКоллекции-1;
			КонтекстВыполнения	= ПодготовитьКонтекст(СтруктураПеременных.ДоступныеСтруктуры,чИндекс);
			Итератор 	= КонтекстВыполнения.Объект;
			Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(Итератор) Тогда
				Элементы.ДекорацияДляКаждого.Заголовок = ПолучитьВыражениеИтератора(чИндекс)+": "+Итератор.ПредставлениеЗначения;	
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияДляКаждогоНажатие(Элемент)
	Коллекция = СтруктураПеременных.ДоступныеСтруктуры.Объект;
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(Коллекция) Тогда
		Если Коллекция.ОбъемКоллекции = Неопределено Тогда
			ПоказатьПредупреждение(,"Для переденного объекта/коллекци невозможно определить итератор");
		Иначе	
			чИндекс				= Коллекция.ОбъемКоллекции-1;
			СтруктураПеременных.Вставить("ТекущиеДанные",Новый Структура("ИмяПараметра,ЗначениеПараметра,ЭтоВыражение",Неопределено,ПолучитьВыражениеИтератора(чИндекс),Истина));
			ВыборКлиент_Ei.НачалоВыбора(,,ЭтаФорма,Элемент,СтруктураПеременных,Ложь,Ложь);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияКоллекцияНажатие(Элемент)
	СтруктураПеременных.Вставить("ТекущиеДанные",Новый Структура("ИмяПараметра,ЗначениеПараметра,ЭтоВыражение",Неопределено,"Объект",Истина));
	ВыборКлиент_Ei.НачалоВыбора(,,ЭтаФорма,Элемент,СтруктураПеременных,Ложь,Ложь);

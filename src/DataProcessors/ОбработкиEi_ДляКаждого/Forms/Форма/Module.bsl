&НаКлиенте
Функция СоздатьТочкуСтарта()
	ГрафСхемаXDTO_ 	= СериализаторXDTO.ЗаписатьXDTO(Процессы_ГрафСхема);
	НовСтарт = РаботаСГС_Ei.НовыйОбъектВыборВарианта(ГрафСхемаXDTO_,"Старт","Старт",20,20,80,80);
	ГрафСхемаXDTO_.item.Добавить(НовСтарт);
	Процессы_ГрафСхема = СериализаторXDTO.ПрочитатьXDTO(ГрафСхемаXDTO_);
	СоздатьВариантыПоКолонкамОбъекта(Процессы_ГрафСхема.ЭлементыГрафическойСхемы.Старт)
КонецФункции

&НаКлиенте
Процедура ОбновитьКнопкиКонтМенюГрафСхемы(Элемент)
	Элементы.Процессы_ГрафСхемаКонтекстноеМенюОбновитьБлокСтарта.Доступность = (Не Элемент.ТекущийЭлемент = Неопределено И ТипЗнч(Элемент.ТекущийЭлемент) = Тип("ЭлементГрафическойСхемыВыборВарианта"));
КонецПроцедуры	

&НаКлиенте
Процедура СоздатьВариантыПоКолонкамОбъекта(ЭлементВыбора)
	мКолонки = ПолучитьСписокКолонок(СтруктураПеременных.ДоступныеСтруктуры.Объект);		
	Если Не мКолонки = Неопределено Тогда
		//создаем варианты
		БылиИзменения =  Ложь;
		ГрафСхемаXDTO_ 	= СериализаторXDTO.ЗаписатьXDTO(Процессы_ГрафСхема);
		Для Каждого ОбъектСхемы ИЗ  ГрафСхемаXDTO_.item Цикл
			Если ОбъектСхемы.itemCode = ЭлементВыбора.Имя Тогда
				Для Каждого стрМассива ИЗ мКолонки Цикл
					ИмяКолонки 			= стрМассива.Колонка.Имя;
					//НайденныйВариант 	= Неопределено;
					//Для Каждого ВыборВариант ИЗ ЭлементВыбора.Элементы Цикл
					//	Если 
						РаботаСГС_Ei.ДобавитьВариант(ОбъектСхемы,ИмяКолонки);
						БылиИзменения =  Истина;
					//КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;		
		КонецЦикла;
		Если БылиИзменения Тогда
			Процессы_ГрафСхема = СериализаторXDTO.ПрочитатьXDTO(ГрафСхемаXDTO_);
		КонецЕсли;	
	Иначе
		//попросим пользователя выбрать источник, поскольку непонятно структура
		
	КонецЕсли;		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокКолонок(ОписаниеЗначения)
	Если Не ОписаниеЗначения = Неопределено Тогда
		СохраненныйРезультат	= ПолучитьИзВременногоХранилища(ОписаниеЗначения.Ссылка);
		Если Не СохраненныйРезультат =  Неопределено Тогда
			Возврат ОбщийМодульСервер_Ei.ПолучитьКолонкиРезультата(СохраненныйРезультат);
		КонецЕсли;
	КонецЕсли;	
КонецФункции	

&НаСервере
Функция ПолучитьМакетСхемыПоУмолчанию()
	Возврат РеквизитФормыВЗначение("Объект").ПолучитьМакет("СхемаПоУмолчанию");

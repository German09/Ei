#Область ВозвращаемоеЗначение

&НаКлиенте
Процедура РассчитатьВозврЗначение(Контекст,Интерактивно = Истина)
	мНаправления 	= ПроцессыВызовСервера_Ei.ПолучитьМассивНаправления(Процессы_ГрафСхема);
	СтрНаправления 	= ПроцессыКлиент_Ei.ПоследнийЭлементВложеннойКоллекции(мНаправления);		
	Если Не СтрНаправления =  Неопределено И Не СтрНаправления.Тип = Тип("ЭлементГрафическойСхемыЗавершение") Тогда
		ВозвращаемоеЗначение = Контекст.Объект;
	Иначе
		сзВызовов 	= Новый СписокЗначений;
		ПроцессыКлиент_Ei.ЗаполнитьСписокВызовов(сзВызовов,мНаправления,ПолучитьПереопределяемыйОбъектОбработки(),Контекст,Неопределено);
		ОО_Вызова 				= ПроцессыКлиент_Ei.ПоследнийЭлементВложеннойКоллекции(сзВызовов); 
		ВозвращаемоеЗначение 	= ОО_Вызова.ДополнительныеПараметры.ВозвращаемоеЗначение;
	КонецЕсли;
	Если Интерактивно Тогда
		ОбновитьПредставлениеВозврЗначения();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПредставлениеВозврЗначения()
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ВозвращаемоеЗначение) Тогда
		Элементы.ВозвращаемоеЗначениеДекорация.Заголовок = "Возвр. значение: "+ВозвращаемоеЗначение.ПредставлениеЗначения;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВозвращаемоеЗначениеДекорацияНажатие(Элемент)
	СтруктураПеременных.Вставить("ТекущиеДанные",Новый Структура("ИмяПараметра,ЗначениеПараметра,ЭтоВыражение",Неопределено,"Результат",Истина));
	СтруктураПеременных.ДоступныеСтруктуры.Вставить("Результат",ВозвращаемоеЗначение);
	ВыборКлиент_Ei.НачалоВыбора(ЭтаФорма,Элемент,СтруктураПеременных,Ложь,,Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВозрЗначение(Команда)
	// Вставить содержимое обработчика.
КонецПроцедуры


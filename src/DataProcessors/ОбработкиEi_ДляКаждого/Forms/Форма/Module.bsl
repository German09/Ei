&НаКлиенте
Перем ВсеДоступныеОбработки; //Массив свойств всех досутпных обработок, кэшируем на форме

&НаКлиенте
Перем СтруктураПеременных Экспорт;
//   - Структура данных возвращаемая процедурой ПолучитьСтруктуруПеременных из формы <КонструкторПредставления>
//		ТекущиеДанные
//			ИмяПараметра
//			ЗначениеПараметра
//			ЭтоВыражение
//			Идентификатор
//		ДоступныеСтруктуры
//			Параметры
//			ЭтаФорма - Структура
//				РезультатВыполнения
//				Варианты
//					<ИмяВарианта>
//						РезультатВыполнения - Фиксированная стрктура
//							ЭтоКоллекция -  Булево
//							ДополнениеПредставления - Строка
//							Ссылка - Строка - Адрес результата
//						Инструкции - Структура
//							Запрос - Строка
//							Алгоритм - Строка
//							СКД - Строка
//							Процессы - Строка
//						Параметры - Структура
//				История	- Массив-


#Область Процессы

&НаКлиенте
//Функция возвращает объет в котром сохраняются ГрафСхемаXDTO и Доступные обработки
//
Функция ПолучитьПереопределяемыйОбъектОбработки()
	//Необходимо переопределить при копировании
	Возврат ЭтаФорма;	
КонецФункции

#Область ГрафическаяСхема

&НаКлиенте
Процедура ПолеГрафСхемыПриАктивизации(Элемент)
	ОбъектОбработки = ПолучитьПереопределяемыйОбъектОбработки();
	ПроцессыКлиент_Ei.ПолеГрафСхемыПриАктивизации(Элемент,ОбъектОбработки,Элементы.ДоступныеОбработки);	
КонецПроцедуры

&НаКлиенте
Процедура ПолеГрафСхемыВыбор(Элемент)
	ОбъектОбработки = ПолучитьПереопределяемыйОбъектОбработки();
	ПроцессыКлиент_Ei.ПолеГрафСхемыВыбор(Элемент,Этаформа,ОбъектОбработки,СтруктураПеременных);
КонецПроцедуры

&НаКлиенте
Процедура ПолеГрафСхемыПриИзменении(Элемент)
	ОО_СохранитьИзмененияГрафСхемы(Процессы_ГрафСхема);	
КонецПроцедуры

&НаКлиенте
Процедура ОО_СохранитьИзмененияГрафСхемы(Результат,ДопПараметры = Неопределено) Экспорт
	ОбъектОбработки = ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ОбъектОбработки = Неопределено Тогда
		Процессы_ГрафСхема	 =  Результат;
		ОбъектОбработки.ГрафСхемаXDTO = ОбщийМодульКлиентСервер_Ei.Сериализовать(Процессы_ГрафСхема);
		ВычислитьМодифицированность();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьОО_СохранитьИзмененияГрафСхемы()
	Возврат Новый ОписаниеОповещения("ОО_СохранитьИзмененияГрафСхемы",ЭтаФорма);		
КонецФункции	

#КонецОбласти

#Область ДоступныеОбработкиГрафСхемы

&НаКлиенте
Процедура ДоступныеОбработкиПриАктивизацииСтроки(Элемент)
	ПроцессыКлиент_Ei.ДоступныеОбработкиПриАктивизацииСтроки(Элементы.ДоступныеОбработки.ТекущиеДанные,Процессы_ГрафСхема,Элементы.Процессы_ГрафСхема);		
КонецПроцедуры

&НаКлиенте
Процедура ДоступныеОбработкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ПроцессыКлиент_Ei.ДоступныеОбработкиВыбор(Процессы_ГрафСхема, Элементы.ДоступныеОбработки.ТекущиеДанные,ПолучитьОО_СохранитьИзмененияГрафСхемы());
КонецПроцедуры

&НаКлиенте
Процедура ДоступныеОбработкиПередУдалением(Элемент, Отказ)
	ПроцессыКлиент_Ei.ДоступныеОбработкиПередУдалением(Элемент, Отказ, Процессы_ГрафСхема,ПолучитьОО_СохранитьИзмененияГрафСхемы());
КонецПроцедуры

&НаКлиенте
Процедура ДоступныеОбработкиПередНачаломИзменения(Элемент, Отказ)
	ПроцессыКлиент_Ei.ДоступныеОбработкиПередНачаломИзменения(Элемент, Отказ);
КонецПроцедуры

&НаКлиенте
Процедура ДоступныеОбработкиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ПроцессыКлиент_Ei.ДоступныеОбработкиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Процессы_ГрафСхема, ПолучитьОО_СохранитьИзмененияГрафСхемы());
КонецПроцедуры


#КонецОбласти

#Область ВспомогательныеПроцедуры

&НаКлиенте
Процедура ЗагрузитьОбработки(ТД)
	ПроцессыКлиент_Ei.вЗагрузитьГрупповыеОбработки(ВсеДоступныеОбработки,ТД.ДоступныеОбработки.ПолучитьЭлементы(),УникальныйИдентификатор);
КонецПроцедуры	

&НаКлиенте
Процедура ВосстановитьГрафСхему(ОбъектОбработок)
	Процессы_ГрафСхема 	= ОбщийМодульКлиентСервер_Ei.Структурировать(ОбъектОбработок.ГрафСхемаXDTO,Новый ГрафическаяСхема);
КонецПроцедуры	

#КонецОбласти

#КонецОбласти

&НаКлиенте
Процедура ВычислитьМодифицированность()
	
КонецПроцедуры	

#Область Обработки

&НаКлиенте
//Загружает текущую настройку
//
Процедура ЗагрузитьНастройку(Настройка,ОбновлятьОбработки = Истина) Экспорт
	ДоступныеОбработкиXDTO = Неопределено;
	Если ТипЗнч(Настройка) = Тип("Структура") Тогда
		Если Настройка.Свойство("ДоступныеОбработки",ДоступныеОбработкиXDTO) Тогда
			Если ЗначениеЗаполнено(ДоступныеОбработкиXDTO) Тогда
				ВосстановитьДеревоОбработок(ДоступныеОбработкиXDTO);
			КонецЕсли;	
		КонецЕсли;
		Если Настройка.Свойство("ГрафСхема",ГрафСхемаXDTO) Тогда
			ВосстановитьГрафСхему(ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
	Если ОбновлятьОбработки Тогда
		ЗагрузитьОбработки(ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

// Процедура - выполняющая обрботку, последовательный запуск производится из ПроцессыКлиент_Ei.ВыполнитьПереходКСледующейОбработке
//
// Параметры:
//  ОписаниеПотока	 - Структура 	- Структура формируемая процедурой "ЗапуститьПотокВыполнения"
//										- мВызовов 	- Массив 				- последовательность подготовленных ОписанийОповещений вызова обоработок, первой располагется следующая к запуску обработка
//										- ОО		- Описание оповещения   - обрабтный вызов из процедуры выполнения обработки, процедуры менеджера потоков
//										- Контекст  - Структура  -  Аналог структуры "ДоступныеСтруктуры" из переменной формы СтруктураПеременных
//  Настройка		 - Структура	- Структура настройки экземпляра обработки
//
&НаКлиенте
Процедура ВыполнитьОбработку(ОписаниеПотока,Настройка) Экспорт
	ЗагрузитьНастройку(Настройка,Ложь);
	
	КонтекстВыполнения			= Новый Структура("Параметры,ЭтаФорма,Объект,ТекущиеДанные,СтрокаТЧ",Неопределено,Неопределено,Неопределено,Неопределено,Неопределено,);
	ЗаполнитьЗначенияСвойств(КонтекстВыполнения,ОписаниеПотока.Контекст);
	ПроцессыКлиент_Ei.ВыполнитьПроцесс(ЭтаФорма,КонтекстВыполнения);
	
	//Объязательные условия перехода к следующей обработке
	ВыполнитьОбработкуОповещения(ОписаниеПотока.ОО,ОписаниеПотока);	
Конецпроцедуры


&НаСервере
Процедура ВосстановитьДеревоОбработок(ДоступныеОбработкиXDTO) 
	ДоступныеОбработки_ = ОбщийМодульКлиентСервер_Ei.Структурировать(ДоступныеОбработкиXDTO,Новый ДеревоЗначений);
	ЗначениеВРеквизитФормы(ДоступныеОбработки_,"ДоступныеОбработки");
КонецПроцедуры	

&НаСервере
Функция ПолучитьНастройкуДляСохранения()
	Результат = Новый Структура;
	Результат.Вставить("ГрафСхема",			ОбщийМодульКлиентСервер_Ei.Сериализовать(Процессы_ГрафСхема));
	ДоступныеОбработки_ = РеквизитФормыВЗначение("ДоступныеОбработки");
	Результат.Вставить("ДоступныеОбработки",ОбщийМодульКлиентСервер_Ei.Сериализовать(ДоступныеОбработки_));
	Возврат Результат; 
КонецФункции


#КонецОбласти

// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	СтандартнаяОбработка 	= Ложь;
	ПараметрЗакрытия 		= ПолучитьНастройкуДляСохранения();
	Закрыть(ПараметрЗакрытия);
КонецПроцедуры

#КонецОбласти


//ОБЪЯЗАТЕЛЬНЫЕ ЭКСПОРТНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
#Область ОбъязатленыеЭкспортныеПроцедуры

//Возврашает структуру, которая описывает,
//поведение обработки в рамках групповой обработки
Функция ПолучитьСвойстваОбработки() Экспорт
	СтруктураСвойств=Новый Структура;
	СтруктураСвойств.Вставить("Действие"				,1); 	//Действие при назначении обработки
		//0 	- обработку нельзя использовать в таблице выбраннх обработок те обработка не предназначена для пакетной обработки 
		//1  	- обработку необходимо настраивать 
		//2  	- обработка уже настроена ее нужнно просто добавить 
	СтруктураСвойств.Вставить("сТипы"					,Новый Массив);
	СтруктураСвойств.Вставить("Функция"					,Ложь); //обработка не возвращает значений
	//Капитан очевидность
	СтруктураСвойств.Вставить("Картинка18"				,Новый Картинка(ПолучитьМакет("Картинка18")));
	СтруктураСвойств.Вставить("ИспользоватьНастройки"	,(СтруктураСвойств.Действие=1));									
    СтруктураСвойств.Вставить("РекомендуемыеВложенные"	,Новый Массив);
	СтруктураСвойств.Вставить("ТипЭлемента"				,Тип("ЭлементГрафическойСхемыВложенныйБизнесПроцесс"));			
	
	Возврат  СтруктураСвойств;
КонецФункции

Функция ВыполнитьОбработку(Настройка,ОписаниеПотока,ВозврЗначение) Экспорт
	сооНастройка 	= ОбщийМодульВызовСервера_Ei.Структурировать(Настройка,Новый Соответствие);
	ТекстМодуля 	= сооНастройка.Получить("Algoritm.bsl");
	ВозврЗначение	= ОбщийМодульКлиентСервер_Ei.__ВычислитьЗначение(ТекстМодуля,ВозврЗначение.Ссылка,,ОписаниеПотока.Контекст);
КонецФункции

#КонецОбласти
	

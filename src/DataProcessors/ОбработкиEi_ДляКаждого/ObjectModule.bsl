//ОБЪЯЗАТЕЛЬНЫЕ ЭКСПОРТНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
#Область ОбъязатленыеЭкспортныеПроцедуры

//Возврашает структуру, которая описывает,
//поведение обработки в рамках групповой обработки
Функция ПолучитьСвойстваОбработки() Экспорт
	СтруктураСвойств=Новый Структура;
	СтруктураСвойств.Вставить("Действие"				,1); 	//Действие при назначении обработки
		//0 	- обработку нельзя использовать в таблице выбраннх обработок те обработка не предназначена для пакетной обработки 
		//1  	- обработку необходимо настраивать 
		//2  	- обработка уже настроена ее нужнно просто добавить 
	СтруктураСвойств.Вставить("сТипы"					,Новый Массив);
	СтруктураСвойств.Вставить("Функция"					,Ложь); //обработка не возвращает значений
	//Капитан очевидность
	СтруктураСвойств.Вставить("Картинка18"				,Новый Картинка(ПолучитьМакет("Картинка18")));
	СтруктураСвойств.Вставить("ИспользоватьНастройки"	,(СтруктураСвойств.Действие=1));									
    СтруктураСвойств.Вставить("РекомендуемыеВложенные"	,Новый Массив);
	СтруктураСвойств.Вставить("ТипЭлемента"				,Тип("ЭлементГрафическойСхемыВложенныйБизнесПроцесс"));			
	
	Возврат  СтруктураСвойств;
КонецФункции

Функция ОО_ВыполнитьОбработку(ОО_КСледующей, ДопПараметры) Экспорт
	ОписаниеПотока 	= ОО_КСледующей.ДополнительныеПараметры;
	Возврат ВыполнитьОбработку(ДопПараметры.Настройка,ОписаниеПотока,ДопПараметры.ВозвращаемоеЗначение);	
КонецФункции

#КонецОбласти
	
// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
#Область ВспомогательныеПроцедуры

// Функция - Подготовить контекст начала выполнения, на основе структуры доступных перменных, аналогичная процедура в модуле формы
//
// Параметры:
//  ТекущийКонтекст	 		- Структура	 	- Структура доступных переменных
//  чИндекс					- Число		 	- Индекс элемента коллекции
//
// Возвращаемое значение:
//   -  Структура, 
//
Функция ПодготовитьКонтекст(ТекущийКонтекст, чИндекс =0)
	//этот блок нужен поскольку функция копируется в модуль формы и что бы оне не отличалась оформим предпроцессором
	#Если Клиент Тогда
		УнИдентификатор = УникальныйИдентификатор; //берем идентифкатор формы 
	#Иначе
		УнИдентификатор = Новый УникальныйИдентификатор;
	#КонецЕсли	
	//Необходимо переопределить при копировании
	КонтекстВыполнения				= Новый Структура("Параметры,ЭтаФорма,Объект");
	ЗаполнитьЗначенияСвойств(КонтекстВыполнения,ТекущийКонтекст);
	Выражение 						= ПолучитьВыражениеИтератора(чИндекс);
	СобытиеОтладки 					= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Подготовка контекста","Процессы",,Ложь); 
	Попытка
		Элемент						= ОбщийМодульКлиентСервер_Ei.__ВычислитьЗначение(Выражение,УнИдентификатор,,КонтекстВыполнения);
		КонтекстВыполнения.Объект   = Элемент;
	Исключение
	КонецПопытки;	
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);

	Возврат КонтекстВыполнения;
КонецФункции

// Функция - Получить выражение итератора, аналогичная процедура в модуле формы 
//
// Параметры:
//  чИндекс	 - Число - Итератор
// 
// Возвращаемое значение:
//   - Строка, выражение для вычисления 
//
Функция ПолучитьВыражениеИтератора(чИндекс)
	Возврат "Объект["+Формат(чИндекс,"ЧН=0; ЧГ=")+"]";
КонецФункции

Функция ВыполнитьОбработку(Настройка,ОписаниеПотока,ВозврЗначение)
	ОбъемКоллекции = 0;
	ОписаниеЗначенияВызовСервера_Ei.ОбъемКоллекции(ОписаниеПотока.Контекст.Объект,ОбъемКоллекции);
	Если ОбъемКоллекции Тогда
		//подготовим объект обработки
		дзДоступныеОбработки 	= Новый ДеревоЗначений;
		дзДоступныеОбработки.Колонки.Добавить("Имя",Новый ОписаниеТипов("Строка"));
		дзДоступныеОбработки.Колонки.Добавить("Представление",Новый ОписаниеТипов("Строка"));
		дзДоступныеОбработки.Колонки.Добавить("СсылкаНаКартинку",Новый ОписаниеТипов("Строка"));
		дзДоступныеОбработки.Колонки.Добавить("ИспользоватьНастройки",Новый ОписаниеТипов("Булево"));
		дзДоступныеОбработки.Колонки.Добавить("Настройка");
		дзДоступныеОбработки.Колонки.Добавить("ТипЭлемента");
		ОбъектОбработки 		= Новый Структура("ГрафСхемаXDTO,ДоступныеОбработки,ПоказателиВыполненияПроцесса","",дзДоступныеОбработки);
		//загрузка настроек
		сооНастройка 	= ОбщийМодульВызовСервера_Ei.Структурировать(Настройка,Новый Соответствие);
		ПроцессыКлиентСервер_Ei.ЗагрузитьПроцессИзСоответствия(ОбъектОбработки,сооНастройка);
		//выполнение
		Для Индекс = 0 По ОбъемКоллекции-1 Цикл
			КонтекстВыполнения = ПодготовитьКонтекст(ОписаниеПотока.Контекст, Индекс);
			ВозврЗначение = ПроцессыКлиентСервер_Ei.ВыполнитьПроцесс(ОбъектОбработки,КонтекстВыполнения);
		КонецЦикла
	КонецЕсли;		
КонецФункции

#КонецОбласти

	//	стрЗапросов =  Новый Структура;
	//	СформироватьСтруктуруЗапросов(стрЗапросов,ДеревоЗапросов.ПолучитьЭлементы());
	//СтруктураЭтаФорма.Вставить("Запросы",стрЗапросов);
	//Если Не ТДЗапросов = Неопределено И стрЗапросов.Свойство(ТДЗапросов.Запрос) Тогда

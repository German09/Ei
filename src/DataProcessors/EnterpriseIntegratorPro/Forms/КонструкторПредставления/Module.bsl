&НаКлиенте
Процедура вИзменеиеСпособаВыгрузки(чСпособВыгрузки)
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		ПроверитьПоказателиВыполнения(ТД.ПоказателиВыполнения);
		ТД.ПоказателиВыполнения.чСпособВыгрузки = чСпособВыгрузки;
		//пытаемся понять нужно ли нам вычислять параметры запроса
		ИмяОсновногоРеквизита 	= ПолучитьИмяОсновногоРеквизитаРезультата(ТД);
		ПараметрыЗапроса		= Неопределено;  //если параметры останутся неопределено то дин. список не будет выполнен
		Если ИмяОсновногоРеквизита = ПеречисленияКлиентСерверПовторноеИспользование_Ei.сРезультатДС() Тогда
			Если ЗапросуНеобходимыПараметры(ТД.ТекстВыполняемогоЗапроса) И ТД.ПоказателиРезультата.сооАдресовРезультатов.Количество() Тогда 
				//нужны параметры и уже выполняли эту строку, чтобы не запускался дин список при открытии консоли
				ПараметрыЗапроса = ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСтруктуруПараметров(ТД.ПараметрыЗапроса,УникальныйИдентификатор);	
			КонецЕсли;
		КонецЕсли;
		Если вЗагрузитьРезультатНаКлиенте(Элементы.ДеревоЗапросов.ТекущаяСтрока,ПараметрыЗапроса) = Ложь Тогда
			//Вероятнее всего был выполнен вывод динамический список поробуем заново выполнить запрос
			ВыполнитьЗапросНаКлиенте(ТД);
		КонецЕсли;
		//КонецЕсли;	
		////Разбираемся с тремя состоянимя флажка
		//ЭлементыФормы.КонтМеню.Кнопки.МенюРезультататЗапроса.Кнопки.Флажки.Кнопки.ТриСостояния.Доступность=?(НовоеЗначение=1,Ложь,Истина);
		//Если Не ЭлементыФормы.КонтМеню.Кнопки.МенюРезультататЗапроса.Кнопки.Флажки.Кнопки.ТриСостояния.Доступность
		//	и ЭлементыФормы.КонтМеню.Кнопки.МенюРезультататЗапроса.Кнопки.Флажки.Кнопки.ТриСостояния.Пометка Тогда 
		//	КонтМенюИзменитьСостояниеФлажков(ЭлементыФормы.КонтМеню.Кнопки.МенюРезультататЗапроса.Кнопки.Флажки.Кнопки.ТриСостояния);
		//КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВставитьКоллекциюРезультата(ТД)
	ИмяОсновногоРеквизита = ПолучитьИмяОсновногоРеквизитаРезультата(ТД);
	ПроверитьПоказателиРезультата(ТД.ПоказателиРезультата);
 	АдресКоллекции 	= ТД.ПоказателиРезультата.сооАдресовРезультатов.Получить(ТД.ПоказателиВыполнения.чСпособВыгрузки);
	АдресКоллекции 	= ?(АдресКоллекции = Неопределено, УникальныйИдентификатор,АдресКоллекции);
	ТД.ПоказателиРезультата.сооАдресовРезультатов.Вставить(ТД.ПоказателиВыполнения.чСпособВыгрузки,СохранитьКоллекциюРезультата(ИмяОсновногоРеквизита,АдресКоллекции))

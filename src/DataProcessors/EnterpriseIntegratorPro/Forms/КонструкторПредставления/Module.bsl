&НаКлиенте
Функция ПолучитьСохраненныйРезультатСКД()
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
    	ПроверитьПоказателиРезультата(ТД.ПоказателиРезультата);
		АдресРезультатаСКД = ТД.ПоказателиРезультата.сооАдресовРезультатов.Получить(-1); //РезультатЗапроса
		Если Не АдресРезультатаСКД = Неопределено Тогда
			Попытка
				СохраненныйРезультат	= ПолучитьИзВременногоХранилища(АдресРезультатаСКД);
			Исключение
				Возврат Неопределено
			КонецПопытки;	
			Если ТипЗнч(СохраненныйРезультат) = Тип("Структура") И СохраненныйРезультат.Свойство("АдресСхемыКомпоновкиДанных") Тогда
				Возврат СохраненныйРезультат;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
КонецФункции	

&НаКлиенте
Процедура ТДОбработкаРасшифровки(ДополнительнаяРасшифровка,Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	СохраненныйРезультат = ПолучитьСохраненныйРезультатСКД();
	Если Не СохраненныйРезультат = Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(СохраненныйРезультат.АдресДанныхРасшифровки, Новый ИсточникДоступныхНастроекКомпоновкиДанных(СохраненныйРезультат.АдресСхемыКомпоновкиДанных));
		Если ДополнительнаяРасшифровка Тогда
			ОбработкаРасшифровки.ПоказатьВыборДействия(Новый ОписаниеОповещения("РезультатТабличныйДокументОбработкаРасшифровкиЗавершение", ЭтаФорма, Новый Структура("Расшифровка,АдресДанныхРасшифровки", Расшифровка,СохраненныйРезультат.АдресДанныхРасшифровки)), Расшифровка,,,,Элементы.РезультатЗапросаТД);
        Иначе
			ОбработкаРасшифровки.ПоказатьВыборДействия(Новый ОписаниеОповещения("РезультатТабличныйДокументОбработкаРасшифровкиЗавершение", ЭтаФорма, Новый Структура("Расшифровка,АдресДанныхРасшифровки", Расшифровка,СохраненныйРезультат.АдресДанныхРасшифровки)), Расшифровка,,,Истина,);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

// Отработка выбора действия расшифровки.
&НаКлиенте
Процедура РезультатТабличныйДокументОбработкаРасшифровкиЗавершение(ВыполненноеДействие, ПараметрВыполненногоДействия, ДополнительныеПараметры) Экспорт
	Расшифровка 			= ДополнительныеПараметры.Расшифровка;
	АдресДанныхРасшифровки	= ДополнительныеПараметры.АдресДанныхРасшифровки;
	
	Если ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.Нет Тогда
	ИначеЕсли ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
		ПоказатьЗначение(, ПараметрВыполненногоДействия);
	Иначе
		ОписаниеОбработкиРасшифровки 	= Новый ОписаниеОбработкиРасшифровкиКомпоновкиДанных(АдресДанныхРасшифровки, Расшифровка, ПараметрВыполненногоДействия);
		ТД 								= Элементы.ДеревоЗапросов.ТекущиеДанные;
		СтрРасшифровки			= Новый Структура("АдресДанныхРасшифровки,ОписаниеОбработкиРасшифровки",АдресДанныхРасшифровки,ОписаниеОбработкиРасшифровки);
		Если Не ТД = Неопределено Тогда
			ВыполнитьСКДНаКлиенте(ТД,СтрРасшифровки);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры



#Область Параметры

&НаКлиенте
Процедура ПолучитьПараметрыТекстаЗапроса(Команда)
	ТС = Элементы.ДеревоЗапросов.ТекущаяСтрока;
	Если Не ТС = Неопределено Тогда
		Если Элементы.ПанельТекстаЗапроса.ТекущаяСтраница = Элементы.Предприятие Тогда 
			вПолучитьПараметрыТекстаЗапроса(ТС);
		ИначеЕсли Элементы.ПанельТекстаЗапроса.ТекущаяСтраница = Элементы.СКД Тогда
			ПолучитьПараметрыСКД(ТС);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

//Помещает значение в список такого же типа
//
&НаКлиенте
Процедура ПараметрыВСписок(Команда)
	ТД = Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущиеДанные;
	Если НЕ ТД = Неопределено И Не ТД.ЭтоВыражение Тогда
		Если ТипЗнч(ТД.ЗначениеПараметра) = Тип("СписокЗначений") Тогда
			Для Каждого ЭлСЗ ИЗ ТД.ЗначениеПараметра Цикл
				ТД.ЗначениеПараметра = ЭлСЗ.Значение;
				Прервать;
			КонецЦикла;	
		Иначе	
			Список = Новый СписокЗначений;
			Список.Добавить(ТД.ЗначениеПараметра);
			ТД.ЗначениеПараметра = Список;
		КонецЕсли;
		ДеревоЗапросовПараметрыЗапросаПриИзменении(Неопределено);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыУстановитьПериод(Команда)
	ТД = Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущиеДанные;
	Если НЕ ТД = Неопределено И Не ТД.ЭтоВыражение Тогда
		ВыбранныйПериод = Новый СтандартныйПериод;
		СтрукПериода 	= вПолучитьСтруктуруПериода(ТД);
		Если ТипЗнч(СтрукПериода) =  Тип("Структура") Тогда
			// Устанавливаем начальные данные
			ВыбранныйПериод.ДатаНачала 		= СтрукПериода.ДатаНачала.ЗначениеПараметра;
			ВыбранныйПериод.ДатаОкончания 	= СтрукПериода.ДатаОкончания.ЗначениеПараметра;
			
			Диалог = Новый ДиалогРедактированияСтандартногоПериода();
			Диалог.Период = ВыбранныйПериод;
			// Не модальный вызов диалога выбора периода
			Диалог.Показать(Новый ОписаниеОповещения("ОО_ВыборПериодаЗавершение", ЭтаФорма,СтрукПериода));
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры


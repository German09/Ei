// Процедура - выполняет встроенный язык на клиенте
//
// Параметры:
//  ДеревоЗапросовТД	 - ЭлементКоллекцииДереваФормы	 - Текущая строка дерева запросов
//  ФоновоеВыполнение	 - Булево	 -  Признак выполнения в фоне
//  ВозможностьОтладки	 - Булево	 -  Признак выполненя как внешней формы.
// 
// Возвращаемое значение:
//   - 
//
&НаКлиенте 
Процедура ВыполнитьВстроенныйЯзыкНаКлиенте(ДеревоЗапросовТД,ФоновоеВыполнение = Ложь, ВозможностьОтладки = Ложь)
	СтрокаСообщения			= "Выполнение/вычисление выражения на втроенном языке";							
	СобытиеОтладки 			= ОтладкаКлиент_Ei.ДобавитьСобытие(СтрокаСообщения+?(ФоновоеВыполнение," в фоновом режиме",""),"Конструктор");
	ТекстВыполняемогоКода 	= cПолучитьТекстДляВыполнения(ДеревоЗапросовТД,"Язык");
	Если ЗначениеЗаполнено(ТекстВыполняемогоКода) Тогда 
		Попытка								
			КонтекстВыполнения 		= ПолучитьСтруктуруДоступныхПеременных(ДеревоЗапросовТД);
			ДатаДо 					= ТекущаяУниверсальнаяДатаВМиллисекундах();
			ПроверитьПоказателиВыполнения(ДеревоЗапросовТД.ПоказателиВыполнения);
			мсТипов 				= Новый Массив;
			мсТипов.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().РезультатЗапроса);
			мсТипов.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТаблицаЗначений);
			мсТипов.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ДеревоЗначений);
			мсТипов.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТабличныйДокумент);
			
			ОписаниеЗначения		= ОбщийМодульКлиент_Ei.__ВычислитьЗначение(ТекстВыполняемогоКода,УникальныйИдентификатор,мсТипов,КонтекстВыполнения);
			ДатаКонцаВыполнения 	= ТекущаяУниверсальнаяДатаВМиллисекундах();
			сооАдресРезультата 		= Новый Соответствие;
			мсТипов.Удалить(0); 	//Уберем результат запроса, он может быть преобразован к типу/возвращен, но дальше нигде явно не учитываться и его нужно убрать
			сооАдресРезультата.Вставить(ОписаниеЗначения.ОписаниеТипов, ОписаниеЗначения);
			Если Не мсТипов.Найти(ОписаниеЗначения.ОписаниеТипов) = Неопределено Тогда
				ДеревоЗапросовТД.ПоказателиВыполнения.ВидРезультата = ОписаниеЗначения.ОписаниеТипов; //выровняем либо таблицу, либо дерево если найдено, чтобы автоматом переключится на нужную закладку
			ИначеЕсли мсТипов.Найти(ДеревоЗапросовТД.ПоказателиВыполнения.ВидРезультата) = Неопределено Тогда	
				//тут вообще не поддерживаемый тип, установим = таблице
				ДеревоЗапросовТД.ПоказателиВыполнения.ВидРезультата = ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТаблицаЗначений;
			КонецЕсли;

			вАктуализироватьТекСтраницуРезультата(ДеревоЗапросовТД);
			вИзменитьПоказателиРезультата(ДеревоЗапросовТД,сооАдресРезультата);
			вИзменитьВремяВыполнения(ДеревоЗапросовТД,ДатаКонцаВыполнения-ДатаДо);		
			//серверный вызов после всех изменений в ДеревоЗапросовТД, а то будут различатся данные с Элементы.ДеревоЗапросов.ТекущиеДанные
			ДеревоЗапросовТД.ТекстВыполняемогоЗапроса = ""; //обунулим текст если он выполнялся до этого используется при выводе произвольной таблицы в динамический список
			ДатаДо_ 					= ТекущаяУниверсальнаяДатаВМиллисекундах();
				вЗагрузитьРезультатНаКлиенте(ДеревоЗапросовТД.ПолучитьИдентификатор(),КонтекстВыполнения.Параметры);//ПараметрыЗапроса);
			ДеревоЗапросовТД.ПоказателиРезультата.сооВремя.Вставить(ДеревоЗапросовТД.ПоказателиВыполнения.ВидРезультата,ТекущаяУниверсальнаяДатаВМиллисекундах() - ДатаДо_);	
			
			ПодключитьОбработчикОжидания("ОО_ОбновитьЗаголовкиЗакладок",0.1,Истина);
			Если ТекущаяУниверсальнаяДатаВМиллисекундах()-ДатаДо>15*1000 Тогда 
				Сигнал();
			КонецЕсли;
		Исключение
			ИнфоОбОшибке = ИнформацияОбОшибке();
			ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
			ТекстМодуляКлиент_Ei.ПоказатьОшибкиКодов(Элементы.ОшибкаВыраженияТекст,ИнфоОбОшибке);
			Возврат;
		КонецПопытки;
	    ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
	КонецЕсли;	
КонецПроцедуры

&НаСервереБезКонтекста
// Функция - Определяет необходимы ли параметры переданному запросу
//
// Параметры:
//  ТекстЗапроса - Стркоа	 - Текста запроса

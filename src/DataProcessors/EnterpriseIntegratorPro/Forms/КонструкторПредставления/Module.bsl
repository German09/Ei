	Если НЕ ТД = Неопределено И Не ТД.ЭтоВыражение Тогда
		ВыбранныйПериод = Новый СтандартныйПериод;
		СтрукПериода 	= вПолучитьСтруктуруПериода(ТД);
		Если ТипЗнч(СтрукПериода) =  Тип("Структура") Тогда
			// Устанавливаем начальные данные
			ВыбранныйПериод.ДатаНачала 		= СтрукПериода.ДатаНачала.ЗначениеПараметра;
			ВыбранныйПериод.ДатаОкончания 	= СтрукПериода.ДатаОкончания.ЗначениеПараметра;
			
			Диалог = Новый ДиалогРедактированияСтандартногоПериода();
			Диалог.Период = ВыбранныйПериод;
			// Не модальный вызов диалога выбора периода
			Диалог.Показать(Новый ОписаниеОповещения("ОО_ВыборПериодаЗавершение", ЭтаФорма,СтрукПериода));
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры


&НаКлиенте
Процедура ОО_ПриАктивизацииСтроки()
	ВосстановитьЗначениеЭлементов(); //Эта процедура объязательно до изменения способа выгрузки, а то начинается свистопляска с графической схемой
	ИзменеиеСпособаВыгрузки();
	ОО_ОбновитьЗаголовкиЗакладок();
	АктуализироватьДинамическиеПоказатели();
	ВосстановитьПоказатели();
	ТД__ = Элементы.ДеревоЗапросов.ТекущиеДанные;
	ПанельТекстаЗапросаПриСменеСтраницы(Неопределено,Элементы.ПанельТекстаЗапроса.ТекущаяСтраница);
	СкрытьПанелиОшибок();
	Элементы.ОтобразитьПоказателиПроцесса.Пометка = Ложь;
КонецПроцедуры	

&НаКлиенте
Процедура ИзменеиеСпособаВыгрузки()
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда 
		Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ТД.ПоказателиВыполнения,"ВидРезультата") Тогда
			вИзменеиеСпособаВыгрузки(ТД.ПоказателиВыполнения.ВидРезультата);
		Иначе
			//возможно новая строка
			вИзменеиеСпособаВыгрузки(0);
		КонецЕсли;
		вАктуализироватьТекСтраницуРезультата(ТД)
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОО_ОбновитьЗаголовкиЗакладок()
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		Для Каждого	СтраницаПанели ИЗ Элементы.ПанельТекстаЗапроса.ПодчиненныеЭлементы Цикл
			стрОкнчание = "";
			Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ТД.ПоказателиВыполнения,"сооВремя") Тогда
				Время 		= ТД.ПоказателиВыполнения.сооВремя.Получить(СтраницаПанели.Имя);
				стрОкнчание = ?(Не ЗначениеЗаполнено(Время),"",""+ОбщийМодульЗакрытыйКлиент_Ei.вФорматироватьВремя(Время));  // 0 не выводим поскольку может использоваться динмичский список
			КонецЕсли;	
			СтраницаПанели.Заголовок = СокрЛП(СтраницаПанели.Подсказка+" "+стрОкнчание);
		КонецЦикла;
		Для Каждого СтраницаПанели ИЗ Элементы.ПанельРезультата.ПодчиненныеЭлементы Цикл
			стрОкнчание = "";
			Если Не СтраницаПанели = Элементы.DynamicList Тогда
				Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ТД.ПоказателиРезультата,"сооПометок") Тогда
					стрПометок 	= ТД.ПоказателиРезультата.сооПометок.Получить(СтраницаПанели.Имя);
					Если Не стрПометок = Неопределено И стрПометок.Ложь>0  Тогда
						стрОкнчание = ""+стрПометок.Ложь+?(Не стрПометок.Истина>0,""," ("+стрПометок.Истина+")");
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;	
			Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ТД.ПоказателиРезультата,"сооВремя") Тогда
				Время 		= ТД.ПоказателиРезультата.сооВремя.Получить(СтраницаПанели.Имя);
				стрОкнчание = стрОкнчание+?(Не ЗначениеЗаполнено(Время),""," / "+ОбщийМодульЗакрытыйКлиент_Ei.вФорматироватьВремя(Время));  // 0 не выводим поскольку может использоваться динмичский список
			КонецЕсли;	
			СтраницаПанели.Заголовок = СокрЛП(СтраницаПанели.Подсказка+" "+стрОкнчание);
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОО_ОтключитьПоиск()
	//сбросим установленные поиски
	Если ОбщийМодульКлиент_Ei.ОтключитьПоиск(ЭтаФорма) Тогда
		ОтключитьОбработчикОжидания("ОО_ОтключитьПоиск");
	КонецЕсли;	
КонецПроцедуры


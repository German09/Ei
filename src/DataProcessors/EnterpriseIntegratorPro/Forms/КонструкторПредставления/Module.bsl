Процедура вСохранитьЗапросыВФайл(сИмяФайла,ДопПараметры)
	СобытиеОтладки 	= ОбщийМодульКлиент_Ei.ДобавитьСобытие("Сохранение списка запросов в файл "+сИмяФайла,"Конструктор");
	АктуализироватьДинамическиеПоказатели(Ложь); //Актуализируем динамические показатели, могли и не бегать по строкам
	Попытка
		ЗТ = Новый ЗаписьТекста(сИмяФайла);
		ЗТ.ЗаписатьСтроку(ПолучитьПредставлениеДереваЗапросов(мИменВспомКолонок));
		ЗТ.Закрыть();
	Исключение
		ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
	
		//теперь просто в первую строку дерева сохраним в колонку обработки дерево доступные обработки
	//первая строка всегда есть
	//СохраненноеДерево=ДеревоЗапросов.Скопировать();
	//СохраненноеДерево.Строки[0].Обработки=?(ДоступныеОбработки.Строки.Количество()=0,ДеревоЗапросов.Строки[0].Обработки,ДоступныеОбработки);

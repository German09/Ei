&НаСервере
Функция  ДобавитьРеквизитыДС(ДеревоЗапросовИД)
	сИмяРеквизитаДинСписка 	= ПолучитьИмяРеквизитаДинСписка(ДеревоЗапросовИД);
	эл_Список 				= Элементы.Найти(сИмяРеквизитаДинСписка); 
	Если эл_Список = Неопределено Тогда
		ДобавляемыеРеквизиты	= Новый Массив;
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(сИмяРеквизитаДинСписка, Новый ОписаниеТипов("ДинамическийСписок")));
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		эл_Страница = Элементы.Добавить(Элементы.ГруппаДинСписков.Имя + сИмяРеквизитаДинСписка, Тип("ГруппаФормы"), Элементы.ГруппаДинСписков);//добавляем страницу и все на нее
		эл_Список = Элементы.Добавить(сИмяРеквизитаДинСписка, Тип("ТаблицаФормы"), эл_Страница);
	    эл_Список.ПутьКДанным         	= сИмяРеквизитаДинСписка;
	    эл_Список.Отображение         	= ОтображениеТаблицы.ИерархическийСписок;
		эл_Список.МаксимальнаяВысота 	= 8;
		эл_Список.Высота 				= 8;
		эл_Список.УстановитьДействие("Выбор","РезультатЗапросаВыбор");
		//Кнопка
		Кнопка = Элементы.Добавить("ДСВКоллекцию_"+ДеревоЗапросовИД, Тип("КнопкаФормы"), эл_Список.КоманднаяПанель);
   		Кнопка.ИмяКоманды = "ДСВКоллекцию";
	КонецЕсли;
	эл_Список.Видимость =  Истина;
	Возврат эл_Список;
КонецФункции


//Формирует дополнительную структуру параметров для формы выбора типа
//
Функция вСформироватьСтруктуруДляФормыВыбораТипа(ТД) Экспорт
	ТДЗапросов 				= Элементы.ДеревоЗапросов.ТекущиеДанные; //Иногда может совпадать с ТД, мжет быть строка параметра
	СтруктураДопПараметров	= Новый Структура();
	СтруктураДопПараметров.Вставить("ТекущиеДанные",ОбщийМодульКлиент_Ei.ПолучитьСтруктуруДанных(ТД,"ИмяПараметра,ЗначениеПараметра,ЭтоВыражение"));
	СтруктураДопПараметров.Вставить("ДоступныеСтруктуры",Новый Структура);
	//СтруктураПараметров = ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСтруктуруПараметров(Элементы.ДеревоЗапросов.ТекущиеДанные.ПараметрыЗапроса,УникальныйИдентификатор);
	//СтруктураДопПараметров.ДоступныеСтруктуры.Вставить("Параметры",СтруктураПараметров);
		ДополнениеПредставления = "ПолучитьИзВременногоХранилища("+ПеречисленияКлиентСерверПовторноеИспользование_Ei.Подмена()+".Ссылка)"; 
		СтруктураЭтаФорма = Новый Структура("РезультатВыполнения",Новый ФиксированнаяСтруктура("ЭтоКоллекция,ДополнениеПредставления,Ссылка",Истина,ДополнениеПредставления,ПолучитьАдресСохраненногоРезультата(ТДЗапросов))); //ТД тут не приминимо поскольку в след функции сразу будет ошибка при Ctrl+Space
		стрЗапросов =  Новый Структура;
		СформироватьСтруктуруЗапросов(стрЗапросов,ДеревоЗапросов.ПолучитьЭлементы());
	СтруктураЭтаФорма.Вставить("Запросы",стрЗапросов);
	Если Не ТДЗапросов = Неопределено И стрЗапросов.Свойство(ТДЗапросов.Запрос) Тогда
		СтруктураДопПараметров.ДоступныеСтруктуры.Вставить("Параметры",стрЗапросов[ТДЗапросов.Запрос].Параметры);		
	КонецЕсли;	
	СтруктураДопПараметров.ДоступныеСтруктуры.Вставить("ЭтаФорма",СтруктураЭтаФорма);
	СтруктураЭтаФорма.Вставить("История",ПолучитьМассивИстории());
	//Добавим идентификатор строки для того чтобы именно в него вернуть выбранный тип или выражение на встроенном языке
	СтруктураДопПараметров.ТекущиеДанные.Вставить("Идентификатор",Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущаяСтрока);	
	Возврат СтруктураДопПараметров; 	
КонецФункции


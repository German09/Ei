&НаКлиенте
Процедура Excel_Выбор(Загрузка)
	Длг 					= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Длг.Заголовок 			= "Выберите файл для импорта данных";
	Длг.Расширение 			= "xls";
	Длг.МножественныйВыбор	= Ложь;
	Длг.Фильтр 				= "Книга Excel (*.xls)|*.xls?|Табличный документ (*.mxl)|*.mxl|OpenOffice Calc ( *.ods)|*.ods|Все файлы (*.*)|*.*";
	Если Загрузка Тогда
		ОО = Новый ОписаниеОповещения("ШаблонExcel_Загрузка",ЭтаФорма);	
	Иначе
		ОО = Новый ОписаниеОповещения("ШаблонExcel_ФормированиеТекста",ЭтаФорма);	
	КонецЕсли;	
	Длг.Показать(ОО);
КонецПроцедуры

&НаКлиенте
Процедура ШаблонExcel_Загрузка(ВыбранныеФайлы, ДопПараметры) Экспорт
	Если Не ВыбранныеФайлы = Неопределено Тогда
		Для Каждого сИмяФайла ИЗ ВыбранныеФайлы	Цикл
			ДвоичныеДанные 	= Новый ДвоичныеДанные(сИмяФайла);
			ВыбранныйФайл	= Новый Файл(сИмяФайла);
			врФайл 			= ПолучитьИмяВременногоФайла(ВыбранныйФайл.Расширение);
			ДвоичныеДанные.Записать(врФайл);
			ЧтениеТДизФайла(РезультатЗапросаТД,врФайл);
			НачатьУдалениеФайлов(,врФайл);
			РезультатЗапросаТДПриИзменении(Элементы.РезультатЗапросаТД);
			ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
			Если Не ТД = Неопределено Тогда
				ОбщийМодульКлиентСервер_Ei.ПроверитьПоказателиРезультата(ТД.ПоказателиРезультата);
				ТД.ПоказателиРезультата.сооПометок.Вставить(ТД.ПоказателиВыполнения.ВидРезультата,Новый Структура("Истина,Ложь",0,РезультатЗапросаТД.ВысотаТаблицы));
				ТД.ПоказателиРезультата.сооВремя.Вставить(ТД.ПоказателиВыполнения.ВидРезультата,0);
				ОО_ОбновитьЗаголовкиЗакладок();
			КонецЕсли;	
			Прервать;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура  ЧтениеТДизФайла(ТД,сИмяФайла) 
	ТД.Прочитать(сИмяФайла,СпособЧтенияЗначенийТабличногоДокумента.Значение);	
КонецПроцедуры	

&НаКлиенте
Процедура ШаблонExcel_ФормированиеТекста(ВыбранныеФайлы, ДопПараметры) Экспорт
	Если Не ВыбранныеФайлы = Неопределено Тогда
		Для Каждого сИмяФайла ИЗ ВыбранныеФайлы	Цикл
			вВставитьПараметр(Элементы.ДеревоЗапросов.ТекущаяСтрока,"ИмяФайла",сИмяФайла);
			//параметр строка с имнем колонок если ложь тогда имена колонок есть тоже на что ссылаются формулы в Excel тоесть 
			//теперь собственно текст  с учетом параметров
			Текст	= "ВыбранныйФайл		= Новый Файл(Параметры.ИмяФайла);
			|ТД 					= Новый ТабличныйДокумент();
			|ПостроительЗапроса 	= Новый ПостроительЗапроса;
			|ДвоичныеДанные 		= Новый ДвоичныеДанные(ВыбранныйФайл.ПолноеИмя);
			|врФайл 				= ПолучитьИмяВременногоФайла(ВыбранныйФайл.Расширение);
			|ДвоичныеДанные.Записать(врФайл);
			|ТД.Прочитать(врФайл,СпособЧтенияЗначенийТабличногоДокумента.Значение);
			|ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТД.Область(""T""));//Вся таблица  
			|ПостроительЗапроса.Выполнить();
			|Результат  			= ПостроительЗапроса.Результат.Выгрузить();";
			Элементы.ДеревоЗапросов.ТекущиеДанные.Язык = Текст;
			Прервать;
		КонецЦикла;	
    КонецЕсли;
КонецПроцедуры


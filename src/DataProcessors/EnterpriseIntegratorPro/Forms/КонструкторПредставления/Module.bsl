&НаКлиенте
//Устанавливает показатели результата, адреса результата, кол-во отмеченный флажком строк
//
Процедура  вИзменитьПоказателиРезультата(ДеревоЗапросовТД, сооАдресРезультата = Неопределено)
	ПроверитьПоказателиРезультата(ДеревоЗапросовТД.ПоказателиРезультата);
	Если Не сооАдресРезультата = Неопределено Тогда
		ДеревоЗапросовТД.ПоказателиРезультата.сооАдресовРезультатов = сооАдресРезультата;
	КонецЕсли;	
		сПараметры = ОбщийМодульКлиент_Ei.ПолучитьСтруктуруДанных(ДеревоЗапросовТД,"РезультатЗапроса,ПоказателиРезультата,ПоказателиВыполнения");
	стрПометок = Новый Структура;	
	стрПометок.Вставить("Ложь",		ОбщийМодульВызовСервера_Ei.ПолучитьКолВоСтрокРезультата(сПараметры,Ложь));
	стрПометок.Вставить("Истина",	ОбщийМодульВызовСервера_Ei.ПолучитьКолВоСтрокРезультата(сПараметры,Истина));
	стрПометок.Вставить("Ложь", 	стрПометок.Ложь + стрПометок.Истина);
	ДеревоЗапросовТД.ПоказателиРезультата.сооПометок.Вставить(ДеревоЗапросовТД.ПоказателиВыполнения.чСпособВыгрузки,стрПометок);

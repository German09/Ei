&НаКлиенте
Процедура ОО_ВыборПериодаЗавершение(Период,ДополнительныеПараметры) Экспорт
	Если Не Период = Неопределено Тогда
		ДополнительныеПараметры.ДатаНачала.ЗначениеПараметра 	= Период.ДатаНачала;	
		ДополнительныеПараметры.ДатаОкончания.ЗначениеПараметра = Период.ДатаОкончания;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОО_ПолучениеВремениИзмененияСохраненногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат   >  ДопПараметры.ДатаИзменения Тогда
		//файл запросов свяжее, загрузим результат из него или из временного
		вОткрытьЗапросыИзФайла(ДопПараметры.ИмяФайла,Новый Структура("ДатаИзмененияФайлаНастройки",Результат));
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОО_ПолучениеРезультатаСуществованияВременногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат Тогда
		Файл = Новый Файл(ДопПараметры.ИмяФайла);
		Файл.НачатьПолучениеВремениИзменения(Новый ОписаниеОповещения("ОО_ПолучениеВремениИзмененияВременногоФайла",ЭтаФорма,ДопПараметры));
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ОО_ПолучениеВремениИзмененияВременногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат   >  ДопПараметры.ДатаИзмененияФайлаНастройки Тогда
		//файл запросов свяжее, загрузим результат из него
		вОткрытьЗапросыИзФайла(ДопПараметры.ИмяФайла,Неопределено);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОО_вУстановитьЗаголовокФормы(Результат,ДопПараметры) Экспорт
	Если Результат Тогда
		Заголовок 			= мЗаголовокФормы + " : " + ?(ДопПараметры.ЭтоВременныйФайл,"~","")+ДопПараметры.ИмяБезРасширения;
		СохраненныйОбраз 	= вПолучитьСохраненныйОбраз();  
		// тут не очень понятно насколько данные в файле свежее тех что мы видим
		Если ДопПараметры.ПроверятьДатыФайла Тогда
			Файл = Новый Файл(ИмяФайлаНастройки);
			Файл.НачатьПолучениеВремениИзменения(Новый ОписаниеОповещения("ОО_ПолучениеВремениИзмененияСохраненногоФайла",ЭтаФорма,Новый Структура("ДатаИзменения,ИмяФайла",ДатаИзменения,ИмяФайлаНастройки)));
		КонецЕсли;
		ВычислитьМодифицированность(Ложь); 
	КонецЕсли;	
Конецпроцедуры	


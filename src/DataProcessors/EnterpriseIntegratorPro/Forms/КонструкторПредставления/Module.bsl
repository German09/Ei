&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИмяОсновногоРеквизитаРезультата(ДеревоЗапросовТД)
	сооИменРеквизитов =  Новый Соответствие;
	сооИменРеквизитов.Вставить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ДинамическийСписок,ПеречисленияКлиентСерверПовторноеИспользование_Ei.сРезультатДС());	
	сооИменРеквизитов.Вставить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТаблицаЗначений,"РезультатЗапросаТЗ");
	сооИменРеквизитов.Вставить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ДеревоЗначений,"РезультатЗапросаДЗ");
	сооИменРеквизитов.Вставить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТабличныйДокумент,"РезультатЗапросаТД");
	Результат = сооИменРеквизитов.Получить(ДеревоЗапросовТД.ПоказателиВыполнения.ВидРезультата);
	Результат = ?(Результат = Неопределено,ПеречисленияКлиентСерверПовторноеИспользование_Ei.сРезультатДС(),Результат); //если вдруг! случайно ничего не нашли
	Возврат Результат;
КонецФункции	

// Функция - Преобразовывает результируюший (со всякими отборами) динамический список в макет компановки с последющим выполнением
//
// Параметры:
//  ДеревоЗапросовИД - Число	 - Идентификатор строки дерева варианктов
// 
// Возвращаемое значение:
//   -  Структура описание значения макета компановки
//
&НаСервере
Функция СохранитьМакетКомпановкиданныхДС(ДеревоЗапросовИД)
	сИмяДинСписка 		= ПолучитьИмяРеквизитаДинСписка(ДеревоЗапросовИД);
	Если Не Элементы.Найти(сИмяДинСписка) = Неопределено Тогда
		Схема 				= Элементы[сИмяДинСписка].ПолучитьИсполняемуюСхемуКомпоновкиДанных();
		Настройки 			= Элементы[сИмяДинСписка].ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
		КомпоновщикМакета 	= Новый КомпоновщикМакетаКомпоновкиДанных();
		Значение		 	= КомпоновщикМакета.Выполнить(Схема, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		Результат 			= ОбщийМодульВызовСервера_Ei.ПодготовитьОписаниеЗначенияВызовСервера(Значение,УникальныйИдентификатор);
		Возврат Результат;
	КонецЕсли;	
КонецФункции	

//Обертка серверной функции для проверки того что результирующие данные могут отображаться на клиенте
//
&НаКлиенте
Функция вЗагрузитьРезультатНаКлиенте(ДеревоЗапросовИД,ПараметрыЗапроса = Неопределено)
	Результат = Ложь;
	Попытка
		мКолонокРезультата = Неопределено;
		Результат = вЗагрузитьРезультат(ДеревоЗапросовИД,ПараметрыЗапроса);//,мКолонокРезультата);
		//ПроцессыКлиент_Ei.СоздатьТочкиСтарта(Процессы_ГрафСхема, мКолонокРезультата, Новый ОписаниеОповещения("ОО_СохранитьИзмененияГрафСхемы",ЭтаФорма));	
	Исключение
		//не смоги показать результат на клиенте, очистим его
		ПоказатьПредупреждение(,"Невозможно отобразить результат на клиенте"+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),20,"Отображение результата");
		ОчиститьРезультат(ДеревоЗапросовИД);
	КонецПопытки;
	Возврат Результат
КонецФункции	

// Загружает результат запроса в таблицу(Дерево), сводную таблицу или OLAP  перед вызовом данной процедуры нужно объязательно вызвать ПроверитьПоказателиВыполнения
//
// Параметры:
//  ДеревоЗапросовИД - Число	 - Идентифкатор текущей строки дерева запросов
//  ПараметрыЗапроса - Структура - Парметры запроса дял динамического списка
// 
// Возвращаемое значение:
//   -  Булево. Был ли успешно загружен результат или требуется повторное выполнение
//
&НаСервере
Функция вЗагрузитьРезультат(ДеревоЗапросовИД,ПараметрыЗапроса = Неопределено)//,мКолонокРезультата = Неопределено) //убрали переменную а то в неё могут вернуться колонки с типом таблица значений
	ДеревоЗапросовТД = ДеревоЗапросов.НайтиПоИдентификатору(ДеревоЗапросовИД);
	Если Не ДеревоЗапросовТД = Неопределено Тогда
		Результат 				= ОбщийМодульВызовСервера_Ei.ПолучитьСохраненныйРезультат(ДеревоЗапросовТД.ПоказателиРезультата,ДеревоЗапросовТД.ПоказателиВыполнения.ВидРезультата);
		сИмяЭлДинСписка 		= ПолучитьИмяРеквизитаДинСписка(ДеревоЗапросовИД); 
		ИмяОсновногоРеквизита 	= ПолучитьИмяОсновногоРеквизитаРезультата(ДеревоЗапросовТД);
		мКолонокРезультата 		= Новый Массив;

		Если ИмяОсновногоРеквизита = ПеречисленияКлиентСерверПовторноеИспользование_Ei.сРезультатДС()  Тогда
			Если ЗначениеЗаполнено(ДеревоЗапросовТД.ТекстВыполняемогоЗапроса) Тогда
				ЗапросДС 				= ДеревоЗапросовТД.ТекстВыполняемогоЗапроса;
				стрДанныхТекстаЗапроса 	= ОбщийМодульЗакрытыйВызовСервера_Ei.ПолучитьКолонкиИОсновнуюТаблицу(ЗапросДС);
			Иначе
				//в этом случает через ДС прогоняем любую таблицу значений
				//проверим есть что то в таблице значений
				//врТаблица = ОбщийМодульВызовСервера_Ei.ПолучитьСохраненныйРезультат(Новый Структура("ПоказателиВыполнения,ПоказателиРезультата",Новый Структура("ВидРезультата",1),ДеревоЗапросовТД.ПоказателиРезультата));
				//Если врТаблица.Количество() Тогда
				//	ЗапросДС =  "ВЫБРАТЬ
				//	|	таб1.Колонка1 КАК Колонка1
				//	|ПОМЕСТИТЬ Таб2
				//	|ИЗ
				//	|	&таб1__ КАК таб1
				//	|;
				//	|ВЫБРАТЬ
				//	|	Таб2.Колонка1 КАК Колонка1
				//	|ИЗ
				//	|	Таб2 КАК Таб2";
				//	Если Не ТипЗнч(ПараметрыЗапроса) =  Тип("Структура") Тогда
				//		ПараметрыЗапроса = Новый Структура;		
				//	КонецЕсли;	
				//	ПараметрыЗапроса.Вставить("таб1__",врТаблица);
				//	//Увы не получилоь? при получении параметров такого дин. списка ЭтаФорма[ИмяОсновногоРеквизита].Параметры.ДоступныеПараметры.Элементы выскакивает ошибка {(5, 2)}: Неверные параметры "таб1__" <<?>>&таб1__ КАК таб1
				//КонецЕсли;	
			КонецЕсли;
			Если ЗначениеЗаполнено(ЗапросДС) Тогда
				Если Элементы.Найти(сИмяЭлДинСписка) = Неопределено И ПараметрыЗапроса = Неопределено Тогда
					//реквизита нет, инициализации из смены закладок или активизации первой строки при открытии
					Возврат Истина; //нужно нажать кнопку выполнить, только после этого покажем
				КонецЕсли;
				ИмяОсновногоРеквизита   						= сИмяЭлДинСписка;
				ДеревоЗапросовТД.КлючПользовательскихНастроекДС = ?(ЗначениеЗаполнено(ДеревоЗапросовТД.КлючПользовательскихНастроекДС),ДеревоЗапросовТД.КлючПользовательскихНастроекДС, Новый УникальныйИдентификатор);	
				эл_Список 										= ДобавитьРеквизитыДС(ДеревоЗапросовИД);
				РеквизитДС 										= ЭтаФорма[ИмяОсновногоРеквизита];	
				РеквизитДС.ПроизвольныйЗапрос   				= Истина;
				РеквизитДС.ТекстЗапроса							= ЗапросДС;
				РеквизитДС.КлючТекущихПользовательскихНастроек	= ДеревоЗапросовТД.КлючПользовательскихНастроекДС;
				
				Если ПараметрыЗапроса = Неопределено Тогда
					//Проверим нужен ли расчет прааметров если они не пришли вместе с вызовом (обычно возникат при запуске уже существующего в дереве запроса)
					Запрос				= Новый Запрос(РеквизитДС.ТекстЗапроса);
					Если  Запрос.НайтиПараметры().Количество() Тогда
						//ПараметрыЗапроса		= ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСтруктуруПараметров(ДеревоЗапросовТД.ПараметрыЗапроса);	
					КонецЕсли;	
				КонецЕсли;
				ПараметрыЗапроса = ОбщийМодульКлиентСервер_Ei.ПолучитьМодифицирПараметрыДляЗапроса(ПараметрыЗапроса); //#СпецОбработкаТипа
				Попытка
					//Установим переданные параметры
					Если ТипЗнч(ПараметрыЗапроса) = Тип("Структура") Тогда
						Для Каждого ДоступныйПараметр ИЗ ЭтаФорма[ИмяОсновногоРеквизита].Параметры.ДоступныеПараметры.Элементы Цикл
							УстЗначение =  Неопределено; 
							Если ПараметрыЗапроса.Свойство(ДоступныйПараметр.Параметр,УстЗначение) Тогда 
								Если ТипЗнч(УстЗначение) = Тип("Строка") И ЭтоАдресВременногоХранилища(УстЗначение) Тогда
									УстЗначение = ПолучитьИзВременногоХранилища(УстЗначение);
								КонецЕсли;
								УстЗначение = ?(ТипЗнч(УстЗначение) = Тип("СписокЗначений"),УстЗначение.ВыгрузитьЗначения(),УстЗначение); //Динамический список не понимает параметров в виде списка, только массив	
								РеквизитДС.Параметры.УстановитьЗначениеПараметра(ДоступныйПараметр.Параметр, УстЗначение);
							КонецЕсли;	
						КонецЦикла;	
					КонецЕсли;
					
					//Установим другие свойства дин. списка
					мКолонокРезультата								= стрДанныхТекстаЗапроса.мКолонки;
					РеквизитДС.ОсновнаяТаблица						= стрДанныхТекстаЗапроса.ОсновнаяТаблица;
					Если Не ЗначениеЗаполнено(РеквизитДС.ОсновнаяТаблица) И ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ПараметрыЗапроса,"ОсновнаяТаблица") Тогда
						Если ТипЗнч(ПараметрыЗапроса.ОсновнаяТаблица) = Тип("Строка") Тогда
							РеквизитДС.ОсновнаяТаблица = ПараметрыЗапроса.ОсновнаяТаблица;		
						КонецЕсли;	
					КонецЕсли;
					Элементы.Логотип.Видимость 	= Ложь;
					эл_Список.Видимость 		= Истина;
				Исключение
					Элементы.Логотип.Видимость 	= Истина;
					эл_Список.Видимость 		= Ложь;
					Если ТипЗнч(ИнформацияОбОшибке().Причина) 			=  Тип("ИнформацияОбОшибке") И
						 ТипЗнч(ИнформацияОбОшибке().Причина.Причина) 	=  Тип("ИнформацияОбОшибке") Тогда
						//это ошибка в запросе, остальное не интересно
						сДополнениеОшибки = ИнформацияОбОшибке().Причина.Причина.Описание;
					Иначе
						сДополнениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());	
					КонецЕсли;	
					ВызватьИсключение сДополнениеОшибки;
				КонецПопытки;
			КонецЕсли;	
		Иначе
			Если Результат = Неопределено Тогда
				Если Не Элементы.DynamicList.ПодчиненныеЭлементы.Найти(сИмяЭлДинСписка) = Неопределено Тогда
					//получается что выполняли дин. список и теперь нужно выполнить настоящий запрос
					Возврат Ложь;
				КонецЕсли;	
			Иначе
				//теперь покажем результат на форме
				Если ТипЗнч(Результат) =  Тип("ТабличныйДокумент") Тогда
					РезультатЗапросаТД.Очистить();
					РезультатЗапросаТД.Вывести(Результат);	
				Иначе	
					ТаблицаОткрытьВызовСервера_Ei.ДобавитьРеквизитыТЗ(ЭтаФорма,ИмяОсновногоРеквизита,Результат);				
					ЗначениеВРеквизитФормы(Результат,ИмяОсновногоРеквизита); // переставил сюда, был в самом конце процедуры
					мКолонокРезультата 	= ОбщийМодульСервер_Ei.ПолучитьКолонкиРезультата(Результат);
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
		ТаблицаОткрытьВызовСервера_Ei.ДобавитьКолонкиВЭлемент(ЭтаФорма,ДеревоЗапросовИД,ИмяОсновногоРеквизита,ИмяОсновногоРеквизита,мКолонокРезультата);
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Процедура - Сохраняет измененную колленцию в показателях результата
//
// Параметры:
//  ТД	 - ДанныеФормыЭлементДерева	 - Строка дерева вариантов
//
&НаКлиенте
Процедура ВставитьКоллекциюРезультата(ТД)
	ИмяОсновногоРеквизита = ПолучитьИмяОсновногоРеквизитаРезультата(ТД);
	ОбщийМодульКлиентСервер_Ei.ПроверитьПоказателиРезультата(ТД.ПоказателиРезультата);
 	ОписаниеЗначенияСохраненное = ТД.ПоказателиРезультата.сооАдресовРезультатов.Получить(ТД.ПоказателиВыполнения.ВидРезультата);
	АдресКоллекции 				= ?(ОписаниеЗначенияСохраненное = Неопределено, УникальныйИдентификатор,ОписаниеЗначенияСохраненное.Ссылка);
	ОписаниеЗначения 			= СохранитьКоллекциюРезультата(ИмяОсновногоРеквизита,АдресКоллекции);
	ТД.ПоказателиРезультата.сооАдресовРезультатов.Вставить(ТД.ПоказателиВыполнения.ВидРезультата,ОписаниеЗначения);
КонецПроцедуры 

// Функция - Сохранить коллекцию результата
//
// Параметры:
//  ИмяОсновногоРеквизита	 - Строка	 - Имя реквизита формы 
//  АдресКоллекции			 - УникальныйИдентификатор, Строка	 - Уникальный идентифкатор формы или ранее полученный адрес во временном хранилище
// 
// Возвращаемое значение:
//   - Структура описания значения
//
&НаСервере
Функция СохранитьКоллекциюРезультата(ИмяОсновногоРеквизита,АдресКоллекции)
	//Результат 		= Неопределено;
	Если ТипЗнч(Этаформа[ИмяОсновногоРеквизита]) = Тип("ТабличныйДокумент") Тогда
		Значение = Новый ТабличныйДокумент;
		Значение.Вывести(Этаформа[ИмяОсновногоРеквизита]); //именно так если просто взять табличный документ то это быдет ссылка на адрес формы и ее сохранять бесполезно, нужно делать новый объект
	Иначе
		Значение = РеквизитФормыВЗначение(ИмяОсновногоРеквизита);
	КонецЕсли;
	Возврат ОписаниеЗначенияВызовСервера_Ei.Подготовить(Значение,АдресКоллекции);	
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Функция ОсновныеСвойствОтображенияТД()
	Возврат Новый Структура("Редактирование,ОтображатьЗаголовки,ОтображатьСетку,ОтображатьИменаЯчеек,ОтображатьИменаСтрокИКолонок",Истина,Истина,Истина,Истина,Истина,Истина);
КОНЕЦфУНКЦИИ

&НаСервере
Процедура ТДвТЗНаСервере(ДеревоЗапросовИД,сИмяВыделеннойОбласти)
	ТД = ДеревоЗапросов.НайтиПоИдентификатору(ДеревоЗапросовИД);
	Если Не ТД = Неопределено Тогда
		ПостроительЗапроса 		= Новый ПостроительЗапроса;
		ИмяОсновногоРеквизита	= "РезультатЗапросаТЗ";
		ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(РезультатЗапросаТД.Область(сИмяВыделеннойОбласти));  
		ПостроительЗапроса.Выполнить();
		Результат  								= ПостроительЗапроса.Результат.Выгрузить();
		ОбщийМодульКлиентСервер_Ei.ПроверитьПоказателиРезультата(ТД.ПоказателиРезультата);
		ТД.ПоказателиВыполнения.ВидРезультата	= ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТаблицаЗначений;
	 	АдресКоллекции 							= ТД.ПоказателиРезультата.сооАдресовРезультатов.Получить(ТД.ПоказателиВыполнения.ВидРезультата);
		АдресКоллекции 							= ?(АдресКоллекции = Неопределено, УникальныйИдентификатор,АдресКоллекции);
		ТД.ПоказателиРезультата.сооАдресовРезультатов.Вставить(ТД.ПоказателиВыполнения.ВидРезультата,ПоместитьВоВременноеХранилище(Результат,АдресКоллекции));
	КонецЕсли;
	//мКолонокРезультата 	= ПолучитьКолонкиРезультата(Результат);
	//ДобавитьРеквизитыТЗ(ИмяОсновногоРеквизита,Результат);				
	//ЗначениеВРеквизитФормы(Результат,ИмяОсновногоРеквизита);
	//ДобавитьКолонкиВЭлемент(ДеревоЗапросовИД,ИмяОсновногоРеквизита,ИмяОсновногоРеквизита,мКолонокРезультата);
	
КонецПроцедуры

//Изменяет существующий способ выгрузки, возможно вариант выгрузки в дин. список, дерево значений, таблицу, табличный документ
//Так же в случае дерева необходимо обработать 3 состояния флажка.
//Параметры:
//	НовоеЗначение	- <Число>. Новое выриант выгрузки  0 - таблица, 1 - дерево, 2 - табличный документ  
//
&НаКлиенте
Процедура вИзменеиеСпособаВыгрузки(ВидРезультата)
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		ПроверитьПоказателиВыполнения(ТД.ПоказателиВыполнения);
		ТД.ПоказателиВыполнения.ВидРезультата = ВидРезультата;
		//пытаемся понять нужно ли нам вычислять параметры запроса
		ИмяОсновногоРеквизита 	= ПолучитьИмяОсновногоРеквизитаРезультата(ТД);
		ПараметрыЗапроса		= Неопределено;  //если параметры останутся неопределено то дин. список не будет выполнен
		Если ИмяОсновногоРеквизита = ПеречисленияКлиентСерверПовторноеИспользование_Ei.сРезультатДС() Тогда
			Если ЗапросуНеобходимыПараметры(ТД.ТекстВыполняемогоЗапроса) И ТД.ПоказателиРезультата.сооАдресовРезультатов.Количество() Тогда 
				//нужны параметры и уже выполняли эту строку, чтобы не запускался дин список при открытии консоли
				ПараметрыЗапроса = ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСтруктуруПараметров(ТД.ПараметрыЗапроса,УникальныйИдентификатор);	
			КонецЕсли;
		КонецЕсли;
		Если вЗагрузитьРезультатНаКлиенте(Элементы.ДеревоЗапросов.ТекущаяСтрока,ПараметрыЗапроса) = Ложь Тогда
			//Вероятнее всего был выполнен вывод динамический список поробуем заново выполнить запрос
			ВыполнитьЗапросНаКлиенте(ТД);
		КонецЕсли;
		//КонецЕсли;	
		////Разбираемся с тремя состоянимя флажка
		//ЭлементыФормы.КонтМеню.Кнопки.МенюРезультататЗапроса.Кнопки.Флажки.Кнопки.ТриСостояния.Доступность=?(НовоеЗначение=1,Ложь,Истина);
		//Если Не ЭлементыФормы.КонтМеню.Кнопки.МенюРезультататЗапроса.Кнопки.Флажки.Кнопки.ТриСостояния.Доступность
		//	и ЭлементыФормы.КонтМеню.Кнопки.МенюРезультататЗапроса.Кнопки.Флажки.Кнопки.ТриСостояния.Пометка Тогда 
		//	КонтМенюИзменитьСостояниеФлажков(ЭлементыФормы.КонтМеню.Кнопки.МенюРезультататЗапроса.Кнопки.Флажки.Кнопки.ТриСостояния);
		//КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура вАктуализироватьТекСтраницуРезультата(ТД)
	ВидРезультата = ТД.ПоказателиВыполнения.ВидРезультата;
	Если ЗначениеЗаполнено(ВидРезультата) Тогда
		НайденаяСтраница = Элементы.ПанельРезультата.ПодчиненныеЭлементы.Найти(ВидРезультата);
		Если Не НайденаяСтраница = Неопределено Тогда
			Элементы.ПанельРезультата.ТекущаяСтраница = НайденаяСтраница;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область Параметры

&НаСервере
Процедура вПолучитьПараметрыТекстаЗапроса(ДеревоЗапросовИД)
	ТД = ДеревоЗапросов.НайтиПоИдентификатору(ДеревоЗапросовИД);
	Если Не ТД = Неопределено Тогда	
		ТекстЗапроса = ТД.ТекстЗапроса;
		Если ПустаяСтрока(ТекстЗапроса) Тогда
			Возврат;
		КонецЕсли;
		//СобытиеОтладки=Формы.Отладка.ДобавитьСобытие("Получение типов параметров из текста запроса","Конструктор");
		Попытка
			Запрос				= Новый Запрос(ТекстЗапроса);
			ПараметрыЗапроса 	= Запрос.НайтиПараметры(); 
			Для Каждого ПараметрЗапроса Из ПараметрыЗапроса Цикл
				вДобавитьПараметр(ПараметрЗапроса,ТД);
			КонецЦикла;
			//СобытиеОтладки_Сортировка = Формы.Отладка.ДобавитьСобытие("Сортировка параметров","Конструктор",СобытиеОтладки);
			Попытка
				ТабСортировки = Новый ТаблицаЗначений;
				ТабСортировки.Колонки.Добавить("Имя",Новый ОписаниеТипов("Строка"));
				ТабСортировки.Колонки.Добавить("Порядок",Новый ОписаниеТипов("Число"));
				Для Каждого ПараметрЗапроса Из ПараметрыЗапроса Цикл
					НоваяСтрока = ТабСортировки.Добавить();	
					НоваяСтрока.Имя 	= ПараметрЗапроса.Имя;
					НоваяСтрока.Порядок = Найти(ТекстЗапроса,"&"+НоваяСтрока.Имя);
				КонецЦикла;
				ТабСортировки.Сортировать("Порядок Возр");
				Для Каждого Строка  ИЗ ТабСортировки Цикл
					Для Каждого СтрокаПараметров ИЗ ТД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",Строка.Имя)) Цикл
						Пока ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров)> ТабСортировки.Индекс(Строка) Цикл
							ТД.ПараметрыЗапроса.Сдвинуть(ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров),-1);	
						КонецЦикла;
						Пока ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров)< ТабСортировки.Индекс(Строка) Цикл
							ТД.ПараметрыЗапроса.Сдвинуть(ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров),1);	
						КонецЦикла;
						Прервать;
					КонецЦикла;	
				КонецЦикла;	
				//Формы.Отладка.ЗавершитьСобытие(СобытиеОтладки_Сортировка);
			Исключение 
				//Формы.Отладка.ЗавершитьСобытие(СобытиеОтладки_Сортировка,"Информация",ИнформацияОбОшибке().Описание);
				ВызватьИсключение "Не удалось выполнить сортировку";
			КонецПопытки;	
			//Формы.Отладка.ЗавершитьСобытие(СобытиеОтладки);
		Исключение
			//Формы.Отладка.ЗавершитьСобытие(СобытиеОтладки,"Информация",ИнформацияОбОшибке().Описание);
			//ВызватьИсключение "Не удалось выполнить сравнение";
		КонецПопытки;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура вДобавитьПараметр(ПараметрЗапроса,ТД)
	СтрокиПараметров = ТД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",ПараметрЗапроса.Имя));
	Если Не СтрокиПараметров.Количество() Тогда
		СтрокаПараметров = ТД.ПараметрыЗапроса.Добавить();
		СтрокаПараметров.ИмяПараметра = ПараметрЗапроса.Имя;
	//Иначе
	//	СтрокаПараметров = СтрокиПараметров[0];	
	//КонецЕсли;	
		Если Не СтрокаПараметров.ЭтоВыражение Тогда
			ТипЗначения = ПараметрЗапроса.ТипЗначения; 
			Если ТипЗначения.СодержитТип(Тип("Тип")) Тогда //#СпецОбработкаТипа
				ТипЗначения =  Новый ОписаниеТипов("ОписаниеТипов");		
			КонецЕсли;	
			СтрокаПараметров.ЗначениеПараметра = ТипЗначения.ПривестиЗначение(СтрокаПараметров.ЗначениеПараметра);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьОписаниеЗначенияСохраненногоРезультата(ТД)
	Результат 		= Неопределено;
	Если Не ТД.ПоказателиРезультата = Неопределено Тогда
		ОписаниеЗначенияТаблицаДерево 	= ТД.ПоказателиРезультата.сооАдресовРезультатов.Получить(ТД.ПоказателиВыполнения.ВидРезультата);
		Если ОписаниеЗначенияТаблицаДерево = Неопределено Тогда
			ОписаниеЗначенияРезультатаЗапроса = ТД.ПоказателиРезультата.сооАдресовРезультатов.Получить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().РезультатЗапроса); //РезультатЗапроса
			Если Не ОписаниеЗначенияРезультатаЗапроса = Неопределено Тогда
				Результат	= ОписаниеЗначенияРезультатаЗапроса;
			КонецЕсли;	
		Иначе
			Результат 	= ОписаниеЗначенияТаблицаДерево;
		КонецЕсли;	
	КонецЕсли;
	Возврат Результат; 
КонецФункции	

&НаКлиенте
//Определяет дату начали и окончания в зависмости от положения строк относительно друг друга
//Параметры:
//	ТекущиеДанные - <СтрокаТаблицыЗначений>. Выделенная строка	
Функция вПолучитьСтруктуруПериода(ТекущиеДанные)
	СтрукПериода 	= Новый Структура("ДатаНачала,ДатаОкончания");
	ПЗ 				= Элементы.ДеревоЗапросов.ТекущиеДанные.ПараметрыЗапроса;
	Если ТипЗнч(ТекущиеДанные.ЗначениеПараметра) = Тип("Дата") Тогда
		ТекИндекс = ПЗ.Индекс(ТекущиеДанные);
		Если ТекИндекс > 0 И  ТипЗнч(ПЗ.Получить(ТекИндекс-1).ЗначениеПараметра) = Тип("Дата") Тогда
			СтрукПериода.ДатаНачала 	= ПЗ.Получить(ТекИндекс-1);
			СтрукПериода.ДатаОкончания	= ТекущиеДанные;
			Возврат СтрукПериода;
		ИначеЕсли ТекИндекс < ПЗ.Количество()-1 И  ТипЗнч(ПЗ.Получить(ТекИндекс+1).ЗначениеПараметра) = Тип("Дата") Тогда
			СтрукПериода.ДатаНачала 	= ТекущиеДанные;
			СтрукПериода.ДатаОкончания	= ПЗ.Получить(ТекИндекс+1);
			Возврат СтрукПериода;
		КонецЕсли;	
	КонецЕсли;	
КонецФункции

#КонецОбласти

#Область ДоступныеПеременные

// Формирует дополнительную структуру параметров для формы выбора типа
//
// Параметры:
//  ТД	 - ДанныеФормыЭлементДерева	 - или ДанныеФормыЭлементКоллекции  в зависимости от того откуда происходит вызов 
// 
// Возвращаемое значение:
//   - Структура данных
//		ТекущиеДанные
//			ИмяПараметра
//			ЗначениеПараметра
//			ЭтоВыражение
//			Идентификатор
//		ДоступныеСтруктуры
//			Параметры
//			ЭтаФорма - Структура
//				РезультатВыполнения
//				Варианты
//					<ИмяВарианта>
//						РезультатВыполнения - Фиксированная стрктура
//							ЭтоКоллекция -  Булево
//							ДополнениеПредставления - Строка
//							Ссылка - Строка - Адрес результата
//						Инструкции - Структура
//							Запрос - Строка
//							Алгоритм - Строка
//							СКД - Строка
//							Процессы - Строка
//						Параметры - Структура
//				История	- Массив-
//
&НаКлиенте
Функция ПолучитьСтруктуруПеременных(ТД) 
	СтруктураПеременных	= Новый Структура();
	СтруктураПеременных.Вставить("ТекущиеДанные",ОбщийМодульКлиент_Ei.ПолучитьСтруктуруДанных(ТД,"ИмяПараметра,ЗначениеПараметра,ЭтоВыражение"));
	СтруктураПеременных.Вставить("ДоступныеСтруктуры",ПолучитьСтруктуруДоступныхПеременных(Элементы.ДеревоЗапросов.ТекущиеДанные));
	//Добавим идентификатор строки для того чтобы именно в него вернуть выбранный тип или выражение на встроенном языке
	СтруктураПеременных.ТекущиеДанные.Вставить("Идентификатор",Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущаяСтрока);	
	Возврат СтруктураПеременных; 	
КонецФункции

// Функция - Получает структуру доступных переменных
//
// Параметры:
//  ТДЗапросов	 - ДанныеФормыЭлементДерева	 - Текущие данные дерева запросов
// 
// Возвращаемое значение:
//   - Структура данных
//			Параметры
//			ЭтаФорма - Структура
//				РезультатВыполнения
//				Варианты
//					<ИмяВарианта>
//						РезультатВыполнения - Фиксированная стрктура
//							ЭтоКоллекция -  Булево
//							ДополнениеПредставления - Строка
//							Ссылка - Строка - Адрес результата
//						Инструкции - Структура
//							Запрос - Строка
//							Алгоритм - Строка
//							СКД - Строка
//							Процессы - Строка
//					Параметры - Структура
//				История	- Массив-
//
&НаКлиенте
Функция ПолучитьСтруктуруДоступныхПеременных(ТДЗапросов)
	ДоступныеПеременные = Новый Структура;
	//СтруктураПараметров = ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСтруктуруПараметров(Элементы.ДеревоЗапросов.ТекущиеДанные.ПараметрыЗапроса,УникальныйИдентификатор);
	//СтруктураДопПараметров.ДоступныеПеременные.Вставить("Параметры",СтруктураПараметров);
		СтруктураЭтаФорма = Новый Структура("РезультатВыполнения",ПолучитьОписаниеЗначенияСохраненногоРезультата(ТДЗапросов)); 
		стрЗапросов =  Новый Структура;
		СформироватьСтруктуруЗапросов(стрЗапросов,ДеревоЗапросов.ПолучитьЭлементы());
	СтруктураЭтаФорма.Вставить("Варианты",стрЗапросов);
	Если Не ТДЗапросов = Неопределено И стрЗапросов.Свойство(ТДЗапросов.Запрос) Тогда
		ДоступныеПеременные.Вставить("Параметры",стрЗапросов[ТДЗапросов.Запрос].Параметры);		
	КонецЕсли;	
	ДоступныеПеременные.Вставить("ЭтаФорма",СтруктураЭтаФорма);
	СтруктураЭтаФорма.Вставить("История",ОбщийМодульКлиент_Ei.ПолучитьМассивИстории());
	Возврат ДоступныеПеременные; 
КонецФункции	

// Рекурсивная процедура заполняюущая вложенную! структуру дерева запросов 
//   - Структура данных
//			<ИмяВарианта>
//				РезультатВыполнения - Фиксированная стрктура
//					ЭтоКоллекция -  Булево
//					ДополнениеПредставления - Строка
//					Ссылка - Строка - Адрес результата
//				Инструкции - Структура
//					Запрос - Строка
//					Алгоритм - Строка
//					СКД - Строка
//					Процессы - Строка
//				Параметры - Структура
//
// Параметры:
//	стрЗапросов		- Структура	- Заполняемая структура
//  ТДЗапросов		- КоллекцяДанныхФормыЭлементДерева	 - Строки дерева запросов текущего уровня
//
&НаКлиенте
Процедура СформироватьСтруктуруЗапросов(стрЗапросов,ЭлементыДереваЗапросов)
	Для Каждого Строка ИЗ ЭлементыДереваЗапросов Цикл
		стрЗапроса = Новый Структура;
		стрЗапроса.Вставить("Инструкции",Новый Структура("Запрос,Алгоритм,СКД,Процессы",Строка.ТекстЗапроса,Строка.Язык,Строка.ТекстСКД,Строка.ГрафСхемаXDTO));
		Переменные = Новый Структура("ЭтаФорма",Новый Структура("Варинаты",стрЗапросов));
		стрЗапроса.Вставить("Параметры",ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСтруктуруПараметров(Строка.ПараметрыЗапроса,УникальныйИдентификатор,,Переменные.ЭтаФорма));
		стрЗапроса.Вставить("РезультатВыполнения",ПолучитьОписаниеЗначенияСохраненногоРезультата(Строка));
		стрЗапросов.Вставить(Строка.Запрос,стрЗапроса);
		СформироватьСтруктуруЗапросов(стрЗапросов,Строка.ПолучитьЭлементы());
	КонецЦикла;	
КонецПроцедуры

#КонецОбласти

#Область СКД

// Установить схему компоновки данных для текущей строки.
//
// Параметры:
//  Схема - СхемаКомпоновкиДанных - схема, которую нужно установить текущей строке.
&НаКлиенте
Процедура УстановитьСКД(Схема)
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		ТД.ТекстСКД = ОбщийМодульКлиентСервер_Ei.Сериализовать(Схема);
		ДеревоЗапросовТекстСКДПриИзменении(Элементы.ТекстСКД);
	КонецЕсли;	
КонецПроцедуры

//Получает параметры текущей компановки в конструкторе
&НаСервере
Процедура ПолучитьПараметрыСКД(ТС)
	ТД = ДеревоЗапросов.НайтиПоИдентификатору(ТС);
	Если Не ТД = Неопределено Тогда
		СКД = ОбщийМодульКлиентСервер_Ei.Структурировать(ТД.ТекстСКД,Новый СхемаКомпоновкиДанных);
		Для Каждого ПараметрКомпановки из СКД.Параметры Цикл
			вДобавитьПараметр(ПараметрКомпановки,ТД);
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСКД(Команда)
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		ВыполнитьСКДНаКлиенте(ТД);
	КонецЕсли;
КонецПроцедуры

//Выполяняет СКД 
//В случае фонового выпонения возврашает структуру параметров которая будет отпрвлена на сервер
//Параметры:
//  ПрефиксЗапроса		-<Строка>. Для выполненения запроса толь к истонику данных. Например "Выбрать * ИЗ"+ВыделеннаяЧасть.
//	ПроверятьСелект		-<Булево>. Провереять или нет перед выполенением запроса. Наличие инструкции SELECT
//  Пакет				-<Булево>. Признак выполнения пакета с последующей возможностью. выбрать один из нескольких результатов выполнения пакетов запроса.
//	ФоновоеВыполнение   -<Булево>. Признак выполнения в фоне
//
&НаКлиенте 
Функция ВыполнитьСКДНаКлиенте(ДеревоЗапросовТД, СтрРасшифровки = Неопределено, ФоновоеВыполнение =  Ложь)
									
		СтрокаСообщения	= "Выполнение СКД";							
		СобытиеОтладки 	= ОтладкаКлиент_Ei.ДобавитьСобытие(СтрокаСообщения+?(ФоновоеВыполнение," в фоновом режиме",""),"Конструктор");
		Если ЗначениеЗаполнено(ДеревоЗапросовТД.ТекстСКД) Тогда 
			Попытка								
				ПараметрыЗапроса		= ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСтруктуруПараметров(ДеревоЗапросовТД.ПараметрыЗапроса,УникальныйИдентификатор);
				ДатаДо 					= ТекущаяУниверсальнаяДатаВМиллисекундах();
				ПроверитьПоказателиВыполнения(ДеревоЗапросовТД.ПоказателиВыполнения);
				ИмяОсновногоРеквизита 	= ПолучитьИмяОсновногоРеквизитаРезультата(ДеревоЗапросовТД);
				сооАдресРезультата 		= ДеревоЗапросовТД.ПоказателиРезультата.сооАдресовРезультатов;//Новый Соответствие; если поставить новый то после выполнения ДС все отальные результаты в строке обнулялись
				Если  Не ИмяОсновногоРеквизита = ПеречисленияКлиентСерверПовторноеИспользование_Ei.сРезультатДС()  Тогда
					ТипГенератора 		= ?(ДеревоЗапросовТД.ПоказателиВыполнения.ВидРезультата = ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТабличныйДокумент,"ГенераторМакетаКомпоновкиДанных","ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
					ОписаниеЗначения	= ОбщийМодульКлиент_Ei.вВыполнитьСКД(ДеревоЗапросовТД.ТекстСКД,ПараметрыЗапроса,УникальныйИдентификатор,ТипГенератора,СтрРасшифровки);
					сооАдресРезультата.Вставить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().РезультатЗапроса, ОписаниеЗначения);
					сооАдресРезультата.Удалить(ДеревоЗапросовТД.ПоказателиВыполнения.ВидРезультата); //чтобы результат обновился если он был ранее сохранен непосредственно
				КонецЕсли;
				ДатаКонцаВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
				вИзменитьПоказателиРезультата(ДеревоЗапросовТД,сооАдресРезультата);
				вИзменитьВремяВыполнения(ДеревоЗапросовТД,ДатаКонцаВыполнения-ДатаДо);
				
				ДатаДо_ 					= ТекущаяУниверсальнаяДатаВМиллисекундах();
					//серверный вызов после всех изменений в ДеревоЗапросовТД, а то будут различатся данные с Элементы.ДеревоЗапросов.ТекущиеДанные
					вЗагрузитьРезультатНаКлиенте(ДеревоЗапросовТД.ПолучитьИдентификатор(),ПараметрыЗапроса);
				ДеревоЗапросовТД.ПоказателиРезультата.сооВремя.Вставить(ДеревоЗапросовТД.ПоказателиВыполнения.ВидРезультата,ТекущаяУниверсальнаяДатаВМиллисекундах() - ДатаДо_);	
					
				ПодключитьОбработчикОжидания("ОО_ОбновитьЗаголовкиЗакладок",0.1,Истина);	
				Если ТекущаяУниверсальнаяДатаВМиллисекундах()-ДатаДо>15*1000 Тогда 
					Сигнал();
				КонецЕсли;
				Если ИмяОсновногоРеквизита = "РезультатЗапросаТЗ" Тогда
					ТекущийЭлемент = Элементы[ИмяОсновногоРеквизита];//.ОтборСтрок = Неопределено;//Новый ФиксированнаяСтруктура;
					ПодключитьОбработчикОжидания("ОО_ОтключитьПоиск",0.1,Истина);
				КонецЕсли;	
			Исключение
				Если Найти(ОписаниеОшибки(),"Не задано значение параметра")>0 Тогда
					//Параметры();
					ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное","Не все параметры запроса продекларированы, выполните заполнение по тексту запроса");
					//ЭлементыФормы.ПанельОшибок.ТекущаяСтраница 	= ЭлементыФормы.ПанельОшибок.Страницы.Параметры;
					//ЭлементыФормы.ПанельОшибок.Видимость 		= Истина;
					ОчиститьСообщения();
					Возврат Неопределено;
				ИначеЕсли Найти(ОписаниеОшибки(),"Временная таблица уже существует")>0 Тогда
					//ЭлементыФормы.ПанельОшибок.ТекущаяСтраница 	= ЭлементыФормы.ПанельОшибок.Страницы.ВремТаблицы;
					//ЭлементыФормы.ПанельОшибок.Видимость 		= Истина;
					////попробуем определить имя проблеменой временной таблицы
					//мСтр = СтрЗаменить(СтрЗаменить(ОписаниеОшибки(),Символы.ПС,""),"""",Символы.ПС);
					//Если СтрЧислоСтрок(мСтр)=3 Тогда
					//	ЭлементыФормы.ИмяВремТаблицы.Заголовок = СтрПолучитьСтроку(мСтр,2);
					//Иначе
					//	ЭлементыФормы.ИмяВремТаблицы.Заголовок = "";	
					//КонецЕсли;
					ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
					ОчиститьСообщения();
					Возврат Неопределено;
				Иначе
					Оповестить("ЗавершениеВыполнения",,ЭтаФорма);
					ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнформацияОбОшибке());
					//Формы.ОбщаяФорма.вПоказатьПроизвольнуюОшибку(ЭтаФорма,ИнформацияОбОшибке(),СобытиеОтладки,3);
					Возврат Неопределено;
				КонецЕсли;	
			КонецПопытки;
		    ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
		КонецЕсли;	
КонецФункции

#КонецОбласти

#Область УникальностиИменПоСтруктуреЗапросаИПараметров

&НаКлиенте
Функция вПолучитьУникальноеИмяПараметра(ИмяКандидат,Приращение = 1)
	Результат = "";
	Если Не ЗначениеЗаполнено(ИмяКандидат) Тогда
		ИмяКандидат = "Параметр" //и пустую строку можем передать случайно
	КонецЕсли;	
	СтрокиПараметров = Элементы.ДеревоЗапросов.ТекущиеДанные.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",ИмяКандидат));
	Если Не СтрокиПараметров.Количество() Тогда
		Результат = ИмяКандидат;
	Иначе
		//имя не уникально
		чОкончание = ОбщийМодульКлиент_Ei.ВыделитьЧисловоеОкончание(ИмяКандидат);
		Если ЗначениеЗаполнено(чОкончание) Тогда
			ИмяКандидат = СтрЗаменить(ИмяКандидат,Формат(чОкончание,"ЧН=0; ЧГ="),Формат(чОкончание+Приращение,"ЧН=0; ЧГ="));	
		Иначе
			ИмяКандидат = ИмяКандидат+Формат(Приращение,"ЧН=0; ЧГ=");
		КонецЕсли;
		Результат 	= вПолучитьУникальноеИмяПараметра(ИмяКандидат,Приращение+1);
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область РаботаСДинСписком

&НаКлиенте
Процедура УстановитьВидимостьДинСписков(ДеревоЗапросовИД)
	Если Не ДеревоЗапросовИД = Неопределено Тогда
		ПоказалиДС = Ложь;
		ИмяОсновногоРеквизита = ПолучитьИмяРеквизитаДинСписка(ДеревоЗапросовИД);
		Для Каждого элФормы ИЗ Элементы.ГруппаДинСписков.ПодчиненныеЭлементы Цикл                                    
			Если элФормы.Имя = Элементы.ГруппаДинСписков.Имя+ИмяОсновногоРеквизита Тогда
				элФормы.Видимость 							= Истина;
				ПоказалиДС									= Истина;
				Элементы.ГруппаДинСписков.ТекущаяСтраница 	= элФормы;
			Иначе
				элФормы.Видимость 	= Ложь;
			КонецЕсли;
		КонецЦикла;
		Элементы.Логотип.Видимость = Не ПоказалиДС;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура УдалитьРеквизитыДС(ДеревоЗапросовИД)
	сИмяРеквизитаДинСписка 	= ПолучитьИмяРеквизитаДинСписка(ДеревоЗапросовИД);
	ЭлДинСписка				= Элементы.Найти(сИмяРеквизитаДинСписка);
	Если Не ЭлДинСписка = Неопределено Тогда
		УдаляемыеРеквизиты	= Новый Массив;
		УдаляемыеРеквизиты.Добавить(сИмяРеквизитаДинСписка);
		ИзменитьРеквизиты(,УдаляемыеРеквизиты);
	    Элементы.Удалить(ЭлДинСписка);
	КонецЕСли;	
КонецПроцедуры

&НаСервере
Функция  ДобавитьРеквизитыДС(ДеревоЗапросовИД)
	сИмяРеквизитаДинСписка 	= ПолучитьИмяРеквизитаДинСписка(ДеревоЗапросовИД);
	эл_Список 				= Элементы.Найти(сИмяРеквизитаДинСписка); 
	Если эл_Список = Неопределено Тогда
		ДобавляемыеРеквизиты	= Новый Массив;
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(сИмяРеквизитаДинСписка, Новый ОписаниеТипов("ДинамическийСписок")));
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		эл_Страница = Элементы.Добавить(Элементы.ГруппаДинСписков.Имя + сИмяРеквизитаДинСписка, Тип("ГруппаФормы"), Элементы.ГруппаДинСписков);//добавляем страницу и все на нее
		эл_Список = Элементы.Добавить(сИмяРеквизитаДинСписка, Тип("ТаблицаФормы"), эл_Страница);
	    эл_Список.ПутьКДанным         	= сИмяРеквизитаДинСписка;
	    эл_Список.Отображение         	= ОтображениеТаблицы.ИерархическийСписок;
		эл_Список.МаксимальнаяВысота 	= 8;
		эл_Список.Высота 				= 8;
		эл_Список.УстановитьДействие("Выбор","РезультатЗапросаВыбор");
		эл_Список.РазрешитьНачалоПеретаскивания = Ложь;  //перетаскивание из ДС слишком сложное, лучше передать данные в коллекцию
		//эл_Список.УстановитьДействие("НачалоПеретаскивания","РезультатЗапросаДСНачалоПеретаскивания");
		//Кнопка
		Кнопка = Элементы.Добавить("ДСВКоллекцию_"+ДеревоЗапросовИД, Тип("КнопкаФормы"), эл_Список.КоманднаяПанель);
   		Кнопка.ИмяКоманды = "ДСВКоллекцию";
	КонецЕсли;
	эл_Список.Видимость =  Истина;
	Возврат эл_Список;
КонецФункции


&НаКлиентеНаСерверебезКонтекста
Функция ПолучитьИмяРеквизитаДинСписка(ДеревоЗапросовИД)
	Возврат ПеречисленияКлиентСерверПовторноеИспользование_Ei.сРезультатДС()+"_"+Формат(ДеревоЗапросовИД,"ЧН=0; ЧГ=");	
КонецФункции	

#КонецОбласти

#Область ПодписиКВкладкам

&НаКлиенте
//Устанавливает время в заголовки сстраницы для которой выполнялось действие
//Параметры:
//	ДеревоЗапросовТД	- Текущая строка дерева
//	Значение			- <Число>. Число секунд затраченного времени
//	ЗначениеДоп			- <Число>. Число доп. секунд затраченного времени (для дополнительной временной детализации)
Процедура вИзменитьВремяВыполнения(ДеревоЗапросовТД,Значение,ЗначениеДоп=0) Экспорт 
	ТекущаяСтраница = Элементы.ПанельТекстаЗапроса.ТекущаяСтраница;
    ПроверитьПоказателиВыполнения(ДеревоЗапросовТД.ПоказателиВыполнения);
	ДеревоЗапросовТД.ПоказателиВыполнения.сооВремя.Вставить(ТекущаяСтраница.Имя,Значение);
КонецПроцедуры 

&НаКлиенте
//Устанавливает показатели результата, адреса результата, кол-во отмеченный флажком строк
//
Процедура  вИзменитьПоказателиРезультата(ДеревоЗапросовТД, сооАдресРезультата = Неопределено)
	ОбщийМодульКлиентСервер_Ei.ПроверитьПоказателиРезультата(ДеревоЗапросовТД.ПоказателиРезультата);
	Если Не сооАдресРезультата = Неопределено Тогда
		ДеревоЗапросовТД.ПоказателиРезультата.сооАдресовРезультатов = сооАдресРезультата;
	КонецЕсли;	
		сПараметры = ОбщийМодульКлиент_Ei.ПолучитьСтруктуруДанных(ДеревоЗапросовТД,"РезультатЗапроса,ПоказателиРезультата,ПоказателиВыполнения");
	стрПометок = Новый Структура;	
	стрПометок.Вставить("Ложь",		ОбщийМодульВызовСервера_Ei.ПолучитьКолВоСтрокРезультата(сПараметры,Ложь));
	стрПометок.Вставить("Истина",	ОбщийМодульВызовСервера_Ei.ПолучитьКолВоСтрокРезультата(сПараметры,Истина));
	стрПометок.Вставить("Ложь", 	стрПометок.Ложь + стрПометок.Истина);
	ДеревоЗапросовТД.ПоказателиРезультата.сооПометок.Вставить(ДеревоЗапросовТД.ПоказателиВыполнения.ВидРезультата,стрПометок);
КонецПроцедуры

#КонецОбласти

#Область СохранениеИВостановлениеНастроекВФайл

#Область Сохранение

&НаКлиенте
Процедура вСохранитьЗапросыВФайл_Начало(ЗапрашиватьСохранение = Ложь, ЗапрашиватьИмяФайла = Ложь, ОО_Завершения = Неопределено)
	//вСохранитьЗапросТекущейСтроки();
	ДопПараметры = Новый Структура("ЗапрашиватьИмяФайла,ОО_Завершения",ЗапрашиватьИмяФайла,ОО_Завершения);
	Если Не ЗапрашиватьИмяФайла И ЗапрашиватьСохранение Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("вСохранитьЗапросыВФайл_Выбор",ЭтаФорма,ДопПараметры),"Сохранить текущие варианты?", РежимДиалогаВопрос.ДаНетОтмена);
	Иначе
		вСохранитьЗапросыВФайл_Выбор(КодВозвратаДиалога.Да, ДопПараметры);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
// Начинает сохранение дерево запросов в файл запросов
//
// Параметры:
//  ЗапрашиватьСохранение	 - Булево 	 - признак необходимости предупрежедния перед сохранением
//  ЗапрашиватьИмяФайла		 - Булево	 - признак необходимости запроса имени файла
//   - 
//           
Процедура вСохранитьЗапросыВФайл_Выбор(РезультатВопроса, ДопПараметры) Экспорт
	ФайлНастройки = Новый Файл(ИмяФайлаНастройки);
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Если ДопПараметры.ЗапрашиватьИмяФайла ИЛИ ПустаяСтрока(ИмяФайлаНастройки) Тогда
			Длг 				= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
			Длг.ПолноеИмяФайла 	= ФайлНастройки.ПолноеИмя;
			Длг.Каталог 		= ФайлНастройки.Путь;
			Длг.Заголовок 		= "Укажите файл для списка запросов";
			Длг.Расширение 		= ПеречисленияКлиентСерверПовторноеИспользование_Ei.РасширениеФайл();
			Длг.Фильтр 			= "Файлы запросов (*."+Длг.Расширение+")|*."+Длг.Расширение+"|Файлы консоли отчётов (*.rcf)|*.rcf|Все файлы (*.*)|*.*";
			Длг.Показать(Новый ОписаниеОповещения("вСохранитьЗапросыВФайл_Завершение",ЭтаФорма));
		Иначе	
			вСохранитьЗапросыВФайл(ФайлНастройки.ПолноеИмя,ДопПараметры);
		КонецЕсли;
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		//отказались от продолжения операции
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет И Не ДопПараметры.ОО_Завершения = Неопределено Тогда	
		ВыполнитьОбработкуОповещения(ДопПараметры.ОО_Завершения);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура вСохранитьЗапросыВФайл_Завершение(ВыбранныеФайлы, ДопПараметры) Экспорт
	Если Не ВыбранныеФайлы = Неопределено Тогда
		Для Каждого сИмяФайла ИЗ ВыбранныеФайлы	Цикл
			вСохранитьЗапросыВФайл(сИмяФайла,ДопПараметры);
			Прервать;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура вСохранитьЗапросыВФайл(сИмяФайла,ДопПараметры)
	СобытиеОтладки 	= ОтладкаКлиент_Ei.ДобавитьСобытие("Сохранение списка запросов в файл "+сИмяФайла,"Конструктор");
	АктуализироватьДинамическиеПоказатели(Ложь); //Актуализируем динамические показатели, могли и не бегать по строкам
	Попытка
		ЗТ = Новый ЗаписьТекста(сИмяФайла);
		ЗТ.ЗаписатьСтроку(ОбщийМодульВызовСервера_Ei.Сериализовать(ПолучитьСписокВариантов(ДеревоЗапросов.ПолучитьЭлементы())));//ПолучитьПредставлениеДереваЗапросов(мПолучитьВспомогательныеКолонки()));
		ЗТ.Закрыть();
	Исключение
		ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
	
	Файл 				= Новый Файл(сИмяФайла);
	ЭтоВременныйФайл 	= (Файл.Расширение = "."+ПеречисленияКлиентСерверПовторноеИспользование_Ei.РасширениеВременныйФайл());
	Если Не ЭтоВременныйФайл Тогда  
		Модифицированность 	= Ложь;
		ИмяФайлаНастройки 	= сИмяФайла;//вСохранитьИмяФайла();
		вУстановитьЗаголовокФормы(Ложь);
	КонецЕсли;
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,"ОО_Завершения") И Не ДопПараметры.ОО_Завершения = Неопределено Тогда	
		ВыполнитьОбработкуОповещения(ДопПараметры.ОО_Завершения);
	КонецЕсли;
КонецПроцедуры


// Функция - Получаетить список вариантов из дерева значений
// обратно перобразуется функцией ЗагрзитьПредставлениеВДеревоЗапросов()
//
// Параметры:
//  Коллекция	 - ДанныеФормыКоллекцияЭлементовДерева  	-  Строки дерева варинатов	 - 
// 
// Возвращаемое значение:
//   - Список значений
//
&НаКлиенте
Функция ПолучитьСписокВариантов(Коллекция)
	сзВариантов = Новый СписокЗначений;
	Для Каждого Строка ИЗ Коллекция Цикл
		Значение = Новый Соответствие;
		Значение.Вставить("Query.bsl",			Строка.ТекстЗапроса);
		Значение.Вставить("Algoritm.bsl",		Строка.Язык);
		Значение.Вставить("DataComposition.xml",Строка.ТекстСКД);
		Значение.Вставить("Comment.xml",		Строка.КомментарийXDTO);

			ЗначенияПараметров = Новый СписокЗначений;
			Для Каждого Параметр ИЗ Строка.ПараметрыЗапроса Цикл
				Если Параметр.ЭтоВыражение Тогда
	        		ЗначенияПараметров.Добавить(Параметр.ЗначениеПараметра, Параметр.ИмяПараметра+".bsl");
				Иначе
					ЗначенияПараметров.Добавить(Параметр.ЗначениеПараметра, Параметр.ИмяПараметра+".xml"); //ОбщийМодульКлиентСервер_Ei.Сериализовать(Параметр.ЗначениеПараметра)
				КонецЕСли;	
			КонецЦикла;	
		Значение.Вставить("Params", 			ЗначенияПараметров);
		Значение.Вставить("Settings.xml",		ОбщийМодульКлиент_Ei.ПолучитьСтруктуруДанных(Строка,"КлючПользовательскихНастроекДС,ПоказателиСтроки"));
		Значение.Вставить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ИмяФайлаСтатистики(), ОбщийМодульКлиент_Ei.ПолучитьСтруктуруДанных(Строка,"ПоказателиРезультата,ПоказателиВыполнения"));
		Значение.Вставить("Process",			ПроцессыКлиент_Ei.ПолучитьСоотвествиеПроцесса(Строка));
		Значение.Вставить("",					ПолучитьСписокВариантов(Строка.ПолучитьЭлементы())); //теперь вложенные
		сзВариантов.Добавить(Значение,Строка.Запрос);
	КонецЦикла;
	Возврат сзВариантов;
КонецФункции

#КонецОбласти

#Область Открытие

&НаКлиенте
// Начинает сохранение дерево запросов в файл запросов
//
// Параметры:
//  ЗапрашиватьСохранение	 - Булево 	 - признак необходимости предупрежедния перед сохранением
//  ЗапрашиватьИмяФайла		 - Булево	 - признак необходимости запроса имени файла
//   - 
//           
Процедура вОткрытьЗапросыИзФайла_Выбор(РезультатВопроса, ДопПараметры) Экспорт
	ФайлНастройки = Новый Файл(ИмяФайлаНастройки);
	Длг 				= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Длг.ПолноеИмяФайла 	= ФайлНастройки.ПолноеИмя;
	Длг.Каталог 		= ФайлНастройки.Путь;
	Длг.Заголовок 		= "Выберите файл со списком запросов";
	Длг.Расширение 		= ПеречисленияКлиентСерверПовторноеИспользование_Ei.РасширениеФайл();
	Длг.Фильтр 			= "Файлы запросов (*."+Длг.Расширение+")|*."+Длг.Расширение+"|Все файлы (*.*)|*.*";
	Длг.Показать(Новый ОписаниеОповещения("вОткрытьЗапросыИзФайла_Завершение",ЭтаФорма));
КонецПроцедуры

&НаКлиенте
Процедура вОткрытьЗапросыИзФайла_Завершение(ВыбранныеФайлы, ДопПараметры) Экспорт
	Если Не ВыбранныеФайлы = Неопределено Тогда
		Для Каждого сИмяФайла ИЗ ВыбранныеФайлы	Цикл
			вОткрытьЗапросыИзФайла(сИмяФайла,ДопПараметры);
			Прервать;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

// Загружает дерево запросов, текстов модулей и других данных из файла
//
&НаКлиенте
Процедура вОткрытьЗапросыИзФайла(сИмяФайла,ДопПараметры)
	СобытиеОтладки 	= ОтладкаКлиент_Ei.ДобавитьСобытие("Чтение списка запросов из файла "+сИмяФайла,"Конструктор");
	Попытка
		Результат = вПрочитатьТекстИзФайла(сИмяФайла);
		Если ЗначениеЗаполнено(Результат) Тогда
			ЗагрзитьПредставлениеВДеревоЗапросов(Результат);
		КонецЕсли;	
	Исключение
		ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
	Файл 				= Новый Файл(сИмяФайла);
	ЭтоВременныйФайл 	= (Файл.Расширение = "."+ПеречисленияКлиентСерверПовторноеИспользование_Ei.РасширениеВременныйФайл());
	Если Не ЭтоВременныйФайл Тогда  
		Модифицированность 	= Ложь;
		ИмяФайлаНастройки 	= сИмяФайла;//вСохранитьИмяФайла();
	КонецЕсли;
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,"ДатаИзмененияФайлаНастройки") Тогда
		ДатаИзменения = ДопПараметры.ДатаИзмененияФайлаНастройки; //обновим дату а то пойжет бесконечный цикл, буде каждый раз перечитывайть файл настроек
	КонецЕсли;	
	вУстановитьЗаголовокФормы(,ЭтоВременныйФайл);
	Если Не ЭтоВременныйФайл Тогда	
		Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,"ДатаИзмененияФайлаНастройки") Тогда
			//проверим а нет ли сохраненного врменного файла с датой больше чем дата сохраненного запроса, если есть то данные прочитаем из него
			Файл = Новый Файл(ПолучитьИмяВременногоФайлаНастройки(сИмяФайла));
			Файл.НачатьПроверкуСуществования(Новый ОписаниеОповещения("ОО_ПолучениеРезультатаСуществованияВременногоФайла",ЭтаФорма,Новый Структура("ДатаИзмененияФайлаНастройки,ИмяФайла",ДопПараметры.ДатаИзмененияФайлаНастройки,Файл.ПолноеИмя)));
		КонецЕсли;
	Иначе
		Модифицированность 	= Истина; //покажем модифицированность чтобы кто бы чего не думал
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Функция вПрочитатьТекстИзФайла(сИмяФайла)
	Результат = "";
	ЧТ = Новый ЧтениеТекста(сИмяФайла);
	Результат = ЧТ.Прочитать();
	ЧТ.Закрыть();
	Возврат Результат;
КонецФункции	

// Процедура - загружает дерево вариантов из сохраненной строки
//
// Параметры:
//  сДеревоЗапросов	 - Строка	- Сериализованное процедурой  ПолучитьСписокВариантов() список значений вариантов
//
&НаКлиенте
Процедура ЗагрзитьПредставлениеВДеревоЗапросов(сДеревоЗапросов)
	ДеревоЗапросов.ПолучитьЭлементы().Очистить();
	сзВариантов = ОбщийМодульВызовСервера_Ei.Структурировать(сДеревоЗапросов,Новый СписокЗначений);
	ДобавитьВариантыВКоллекцию(ДеревоЗапросов.ПолучитьЭлементы(),сзВариантов)
КонецПроцедуры

// Процедура - Добавляет варианты 
//
// Параметры:
//  Коллекция	 - ДанныеФормыКоллекцияЭлементовДерева  	-  Строки дерева варинатов
//  сзВариантов	 - СписокЗначений	 - список значений сформированный ранее функцией вПолучитьСохраняемыйОбраз()
//
&НаКлиенте
Процедура ДобавитьВариантыВКоллекцию(Коллекция,сзВариантов)
	Если ТипЗнч(сзВариантов) = Тип("СписокЗначений") Тогда
		Для Каждого Элемент ИЗ сзВариантов Цикл
			Вариант = Коллекция.Добавить();
			Вариант.Запрос 			= Элемент.Представление;
			Вариант.ТекстЗапроса	= Элемент.Значение.Получить("Query.bsl");
			Вариант.Язык			= Элемент.Значение.Получить("Algoritm.bsl");
			Вариант.ТекстСКД		= Элемент.Значение.Получить("DataComposition.xml");
			Вариант.КомментарийXDTO	= Элемент.Значение.Получить("Comment.xml");
			сзПараметры 			= Элемент.Значение.Получить("Params");
			Если ТипЗнч(сзПараметры) =  Тип("СписокЗначений") Тогда
				Для Каждого ЭлПараметра ИЗ сзПараметры Цикл
					Параметр 					= Вариант.ПараметрыЗапроса.Добавить();
					Параметр.ЭтоВыражение		= СтрЗаканчиваетсяНа(ЭлПараметра.Представление,нРег("bsl"));
					Параметр.ИмяПараметра		= Лев(ЭлПараметра.Представление,Найти(ЭлПараметра.Представление,".")-1);
					//Если Параметр.ЭтоВыражение Тогда
						Параметр.ЗначениеПараметра  = ЭлПараметра.Значение;
					//Иначе
					//	Параметр.ЗначениеПараметра  = ОбщийМодульКлиентСервер_Ei.Структурировать(ЭлПараметра.Значение,Неопределено);   //ОбщийМодульВызовСервера_Ei  ОбщийМодульКлиентСервер_Ei
					//КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;
			стрНастройки 			= Элемент.Значение.Получить("Settings.xml");
			Если ТипЗнч(стрНастройки) =  Тип("Структура") Тогда
				ЗаполнитьЗначенияСвойств(Вариант,стрНастройки);	
			КонецЕсли;
			стрСтатистика 			= Элемент.Значение.Получить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ИмяФайлаСтатистики());
			Если ТипЗнч(стрСтатистика) =  Тип("Структура") Тогда
				Если стрСтатистика.Свойство("ПоказателиРезультата") Тогда
					//обнулим адреса в большинстве случаев они уже не действительны
					стрСтатистика.ПоказателиРезультата.Вставить("сооАдресовРезультатов",Новый Соответствие);
				КонецЕсли;	
				ЗаполнитьЗначенияСвойств(Вариант,стрСтатистика);	
			КонецЕсли;
			сооПроцессы 			= Элемент.Значение.Получить("Process");
			Если ТипЗнч(сооПроцессы) =  Тип("Соответствие") Тогда
				Вариант.ГрафСхемаXDTO	= сооПроцессы.Получить("GraphicalSchema.xml");
				ДобавитьОбработкиВКоллекцию(Вариант.ДоступныеОбработки.ПолучитьЭлементы(),сооПроцессы.Получить(""))
			КонецЕсли;	
			//Теперь вложенные
			ДобавитьВариантыВКоллекцию(Вариант.ПолучитьЭлементы(),Элемент.Значение.Получить(""));
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

// Процедура - Добавить обработки в коллекцию
//
// Параметры:
//  Коллекция	 - ДанныеФормыКоллекцияЭлементовДерева  	-  Строки дерева доступный обработок
//  сзОбработки	 - СписокЗначений	 - Список значений доступных обработок формируется функцией ПолучитьСписокОбработок()
//
&НаКлиенте
Процедура ДобавитьОбработкиВКоллекцию(Коллекция,сзОбработки)
	Если ТипЗнч(сзОбработки) = Тип("СписокЗначений") Тогда
		Для Каждого Элемент ИЗ сзОбработки Цикл
			Обработка	= Коллекция.Добавить();
			Обработка.Имя					= Элемент.Представление;
			Обработка.ИспользоватьНастройки = Истина;
			стрНастройки 			= Элемент.Значение.Получить("Settings.xml");
			Если ТипЗнч(стрНастройки) =  Тип("Структура") Тогда
				ЗаполнитьЗначенияСвойств(Обработка,стрНастройки);	
			КонецЕсли;
			//Теперь вложенные
			ДобавитьОбработкиВКоллекцию(Обработка.ПолучитьЭлементы(),Элемент.Значение.Получить(""));
		КонецЦикла;
	КонецЕсли;	
Конецпроцедуры	

#КонецОбласти

#Область ВычислениеМодифицироанности

&НаКлиенте
Функция ВычислитьМодифицированность(Сохранять = Истина)
	Модифицированность 	= Не (СохраненныйОбраз = вПолучитьСохраняемыйОбраз());
	Если Модифицированность И Не ПустаяСтрока(ИмяФайлаНастройки) Тогда
		//сохраним данные консоли во временный файл
		Если Сохранять Тогда
			вСохранитьЗапросыВФайл(ПолучитьИмяВременногоФайлаНастройки(ИмяФайлаНастройки),Неопределено);
			ДатаИзменения		= ТекущаяДата(); //перенес сюда а то без условия постоянно менялась дата изменения
		КонецЕсли;	
	КонецЕсли;	
	//ДатаИзменения		= ТекущаяДата();
КонецФункции	

// Функция - Получает сохраненняемое прдставление текущего состояния дерева вариантов 
// 
// Возвращаемое значение:
//   - Строка. Сереализованное представление структурированного списка значений вариантов
//
&НаКлиенте
Функция вПолучитьСохраняемыйОбраз()
	сзВариантов = ПолучитьСписокВариантов(ДеревоЗапросов.ПолучитьЭлементы());
	Возврат ПолучитьПредставлениеСохраенногоОбраза(сзВариантов); //
КонецФункции

&НаКлиенте
Функция вПолучитьСохраненныйОбраз()
	Результат = вПрочитатьТекстИзФайла(ИмяФайлаНастройки);
	Если ЗначениеЗаполнено(Результат) Тогда
		Результат =  ПолучитьПредставлениеСохраенногоОбраза(Результат)	
	КонецЕсли;	
	Возврат Результат;
КонецФункции

// Функция - Получает представление сохраенного образа настройки который планируется сравнивать с текущим.
// ОБЪЯЗАТЕЛЬНО на сервере
//
// Параметры:
//  сВариантов	 - Строка или СписокЗначений	 -  Сериализованная строка списка или сам список
// 
// Возвращаемое значение:
//   -  Строка. Обработанное представление 
//
&НаСервереБезКонтекста
Функция ПолучитьПредставлениеСохраенногоОбраза(сВариантов)
	Если Не ТипЗнч(сВариантов) =  Тип("Строка") Тогда
		//передали объект его прогоним через сериализацию поскольку результат может меняться (сортировка в соотвесвии)
		сВариантов = ОбщийМодульВызовСервера_Ei.Сериализовать(сВариантов);
	КонецЕсли;	
	сзВариантов = ОбщийМодульВызовСервера_Ei.Структурировать(сВариантов,Новый СписокЗначений);
	УдалитьДанныеСтатистикиИзОбраза(сзВариантов);
	Возврат ОбщийМодульВызовСервера_Ei.Сериализовать(сзВариантов); 
КонецФункции

// Процедура - Удаляет данные статистики из образа, для более правильного вычисления модифицированности
//
// Параметры:
//  Коллекция	 - СписокЗначений	 -  Список вариантов
&НаСервереБезКонтекста
Процедура УдалитьДанныеСтатистикиИзОбраза(Коллекция)
	Если Не Коллекция = Неопределено Тогда
		Для Каждого Элемент Из Коллекция Цикл
			Элемент.Значение.Удалить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ИмяФайлаСтатистики());
			УдалитьДанныеСтатистикиИзОбраза(Элемент.Значение.Получить(""));
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры	


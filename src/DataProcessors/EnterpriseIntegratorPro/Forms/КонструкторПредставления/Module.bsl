// Начинает сохранение дерево запросов в файл запросов
//
// Параметры:
//  ЗапрашиватьСохранение	 - Булево 	 - признак необходимости предупрежедния перед сохранением
//  ЗапрашиватьИмяФайла		 - Булево	 - признак необходимости запроса имени файла
//   - 
//           
Процедура вОткрытьЗапросыИзФайла_Выбор(РезультатВопроса, ДопПараметры) Экспорт
	ФайлНастройки = Новый Файл(ИмяФайлаНастройки);
	Длг 				= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Длг.ПолноеИмяФайла 	= ФайлНастройки.ПолноеИмя;
	Длг.Каталог 		= ФайлНастройки.Путь;
	Длг.Заголовок 		= "Выберите файл со списком запросов";
	Длг.Расширение 		= ПеречисленияКлиентСерверПовторноеИспользование_Ei.РасширениеФайл();
	Длг.Фильтр 			= "Файлы запросов (*."+Длг.Расширение+")|*."+Длг.Расширение+"|Все файлы (*.*)|*.*";
	Длг.Показать(Новый ОписаниеОповещения("вОткрытьЗапросыИзФайла_Завершение",ЭтаФорма));
КонецПроцедуры

&НаКлиенте
Процедура вОткрытьЗапросыИзФайла_Завершение(ВыбранныеФайлы, ДопПараметры) Экспорт
	Если Не ВыбранныеФайлы = Неопределено Тогда
		Для Каждого сИмяФайла ИЗ ВыбранныеФайлы	Цикл
			вОткрытьЗапросыИзФайла(сИмяФайла,ДопПараметры);
			Прервать;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

// Загружает дерево запросов, текстов модулей и других данных из файла
//
&НаКлиенте
Процедура вОткрытьЗапросыИзФайла(сИмяФайла,ДопПараметры)
	СобытиеОтладки 	= ОбщийМодульКлиент_Ei.ДобавитьСобытие("Чтение списка запросов из файла "+сИмяФайла,"Конструктор");
	Попытка
		Результат = вПрочитатьТекстИзФайла(сИмяФайла);
		Если ЗначениеЗаполнено(Результат) Тогда
			ЗагрзитьПредставлениеВДеревоЗапросов(Результат,мИменВспомКолонок);
		КонецЕсли;	
	Исключение
		ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
	Файл 				= Новый Файл(сИмяФайла);
	ЭтоВременныйФайл 	= (Файл.Расширение = "."+ПеречисленияКлиентСерверПовторноеИспользование_Ei.РасширениеВременныйФайл());
	Если Не ЭтоВременныйФайл Тогда  
		Модифицированность 	= Ложь;
		ИмяФайлаНастройки 	= сИмяФайла;//вСохранитьИмяФайла();
	КонецЕсли;
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,"ДатаИзмененияФайлаНастройки") Тогда
		ДатаИзменения = ДопПараметры.ДатаИзмененияФайлаНастройки; //обновим дату а то пойжет бесконечный цикл, буде каждый раз перечитывайть файл настроек
	КонецЕсли;	
	вУстановитьЗаголовокФормы(,ЭтоВременныйФайл);
	Если Не ЭтоВременныйФайл Тогда	
		Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,"ДатаИзмененияФайлаНастройки") Тогда
			//проверим а нет ли сохраненного врменного файла с датой больше чем дата сохраненного запроса, если есть то данные прочитаем из него
			Файл = Новый Файл(ПолучитьИмяВременногоФайлаНастройки(сИмяФайла));
			Файл.НачатьПроверкуСуществования(Новый ОписаниеОповещения("ОО_ПолучениеРезультатаСуществованияВременногоФайла",ЭтаФорма,Новый Структура("ДатаИзмененияФайлаНастройки,ИмяФайла",ДопПараметры.ДатаИзмененияФайлаНастройки,Файл.ПолноеИмя)));
		КонецЕсли;
	Иначе
		Модифицированность 	= Истина; //покажем модифицированность чтобы кто бы чего не думал
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Функция вПрочитатьТекстИзФайла(сИмяФайла)
	Результат = "";
	ЧТ = Новый ЧтениеТекста(сИмяФайла);
	Результат = ЧТ.Прочитать();
	ЧТ.Закрыть();
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ЗагрзитьПредставлениеВДеревоЗапросов(сДеревоЗапросов,мИменДобКолонок)
	Результат = ЗагрзитьПредставлениеВДеревоЗначений(сДеревоЗапросов,мИменДобКолонок);

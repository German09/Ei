#Область ЗаполнениеПоказателей

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьПоказателиВыполнения(ПоказателиВыполнения)
	Если Не ТипЗнч(ПоказателиВыполнения) = Тип("Структура") Тогда
		ПоказателиВыполнения = Новый Структура("чСпособВыгрузки,сооВремя",0,Новый Соответствие);
	КонецЕсли;
Конецпроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьПоказателиРезультата(ПоказателиРезультата)
	Если Не ТипЗнч(ПоказателиРезультата) = Тип("Структура") 
		//Далее показатели которые добавлялись не сразу, чтобы работали 
		ИЛИ НЕ ПоказателиРезультата.Свойство("сооВремя")
		ИЛИ НЕ ПоказателиРезультата.Свойство("сооСвойства")
		Тогда
		ПоказателиРезультата = Новый Структура("сооПометок,сооАдресовРезультатов,сооВремя,сооСвойства",Новый Соответствие,Новый Соответствие,Новый Соответствие,Новый Соответствие);
	КонецЕсли;
Конецпроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьПоказателиСтроки(ПоказателиСтроки)
	Если 	Не ТипЗнч(ПоказателиСтроки) = Тип("Структура") 
			ИЛИ Не ПоказателиСтроки.Свойство("стрОтображенияТД")  Тогда //тут всегда указываем последнее добавленное свойство чтобы гарантировать целостность структуры
		ПоказателиСтроки = Новый Структура("стрФД,стрОтображенияТД",
											Новый Структура("Текст,Вложения","",Новый Структура),
											Новый Структура("Редактирование,ОтображатьЗаголовки,ОтображатьСетку,ОтображатьИменаЯчеек,ОтображатьИменаСтрокИКолонок",Истина,Истина,Истина,Истина,Истина,Истина));
	КонецЕсли;
Конецпроцедуры


#КонецОбласти

#Область КонструкторЗапроса

&НаКлиенте
Процедура ОткрытьКонструкторЗапросаНачало()
	Перем НачалоСтрока,КолонкаНач,СтрокаКон,КолонкаКон;
	Если Не Элементы.ДеревоЗапросов.ТекущиеДанные = Неопределено Тогда
		Если ПустаяСтрока(ТекущийЭлемент.ВыделенныйТекст) Тогда
			лТекстДляКонструктора = Элементы.ДеревоЗапросов.ТекущиеДанные.ТекстЗапроса;
		Иначе
			лТекстДляКонструктора = ТекущийЭлемент.ВыделенныйТекст;
		КонецЕсли;
		
		ПараметрыОповещения = Новый Структура("СтруктураГраницВыделения, Модифицированность");
		ПараметрыОповещения.Модифицированность = Модифицированность;
		Если Не ПустаяСтрока(ТекущийЭлемент.ВыделенныйТекст) Тогда 
			ТекущийЭлемент.ПолучитьГраницыВыделения(НачалоСтрока,КолонкаНач,СтрокаКон,КолонкаКон);
			ПараметрыОповещения.СтруктураГраницВыделения = Новый Структура("НачалоСтрока,КолонкаНач,СтрокаКон,КолонкаКон", НачалоСтрока,КолонкаНач,СтрокаКон,КолонкаКон);
		КонецЕсли;
		
		Конструктор = Новый КонструкторЗапроса; 
		Если ЗначениеЗаполнено(лТекстДляКонструктора) Тогда 
			Конструктор.Текст = СокрЛП(лТекстДляКонструктора); 
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ОткрытьКонструкторЗапросаЗавершение", ЭтаФорма, ПараметрыОповещения); 
		Конструктор.Показать(Оповещение);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте 
Процедура ОткрытьКонструкторЗапросаЗавершение(Текст, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.СтруктураГраницВыделения <> Неопределено Тогда 
		лГраницыВыделения = ДополнительныеПараметры.СтруктураГраницВыделения;
		ТекущийЭлемент.УстановитьГраницыВыделения(лГраницыВыделения.НачалоСтрока,лГраницыВыделения.КолонкаНач,лГраницыВыделения.СтрокаКон,лГраницыВыделения.КолонкаКон);
	КонецЕсли;
	
	Если Текст <> Неопределено Тогда 
		Если ДополнительныеПараметры.СтруктураГраницВыделения = Неопределено Тогда 
			Элементы.ТекстЗапроса.УстановитьГраницыВыделения(1,СтрДлина(Элементы.ДеревоЗапросов.ТекущиеДанные.ТекстЗапроса) + 1);
			Элементы.ТекстЗапроса.ВыделенныйТекст = Текст
		Иначе
			ТекущийЭлемент.ВыделенныйТекст = Текст;
		КонецЕсли;
	Иначе
		Модифицированность = ДополнительныеПараметры.Модифицированность;
	КонецЕсли; 
	
	Если ДополнительныеПараметры.СтруктураГраницВыделения <> Неопределено Тогда 
		ТекущийЭлемент.УстановитьГраницыВыделения(лГраницыВыделения.НачалоСтрока,лГраницыВыделения.КолонкаНач, лГраницыВыделения.НачалоСтрока + СтрЧислоСтрок(Текст) - 1, СтрДлина(СтрПолучитьСтроку(Текст,СтрЧислоСтрок(Текст))) + 1);
	КонецЕсли;
	
	ТекстЗапросаПриИзменении(Элементы.ТекстЗапроса);
КонецПроцедуры

#КонецОбласти

#Область ВыполнениеЗапроса

// Получаем текст выполняемого запроса/выражения на встроенном языке
//
// Параметры:
//  ТД			 - ЭлементКоллекциДереваФомы	 - Строка дерева значений 
//  сИмяЭлемента - Строка	 -  Имя элемента формы и реквизита коллекции (должны свлпадать)
// 
// Возвращаемое значение:
//   - Строка. Выджеленое значение или выражение
//
&НаКлиенте
Функция cПолучитьТекстДляВыполнения(ТД,сИмяЭлемента,Проверять = Истина)
	Результат 		= ТД[сИмяЭлемента];	
	ВыделенныйТекст = Элементы[сИмяЭлемента].ВыделенныйТекст; 
	Если 	ЗначениеЗаполнено(ВыделенныйТекст) Тогда
		Если сИмяЭлемента = "ТекстЗапроса" И Проверять Тогда
			Если (Найти(Нрег(ВыделенныйТекст),"выбрать") ИЛИ Найти(Нрег(ВыделенныйТекст),"select")) Тогда
				//запрос проверим что есть слово выбрать это явный признак того что есть какой то смысл выполнять	
				Результат = ВыделенныйТекст;
			КонецЕсли;				
		Иначе	
			Результат = ВыделенныйТекст;
		КонецЕсли;	
	КонецЕсли;
	Возврат Результат;
КонецФункции	

//Выполяняет запрос , Если выделен верно тогда выделенную часть
//В случае фонового выпонения возврашает структуру параметров которая будет отпрвлена на сервер
//Параметры:
//  ПрефиксЗапроса		-<Строка>. Для выполненения запроса толь к истонику данных. Например "Выбрать * ИЗ"+ВыделеннаяЧасть.
//	ПроверятьСелект		-<Булево>. Провереять или нет перед выполенением запроса. Наличие инструкции SELECT
//  Пакет				-<Булево>. Признак выполнения пакета с последующей возможностью. выбрать один из нескольких результатов выполнения пакетов запроса.
//	ФоновоеВыполнение   -<Булево>. Признак выполнения в фоне
//
&НаКлиенте 
Функция ВыполнитьЗапросНаКлиенте(ДеревоЗапросовТД,
									ПрефиксЗапроса	= "",
									ПроверятьСелект		= Истина,
									Пакет				= Истина,
									ФоновоеВыполнение	= Ложь)
									
		СтрокаСообщения	= "Выполнение запроса";							
		СобытиеОтладки 	= ОбщийМодульКлиент_Ei.ДобавитьСобытие(СтрокаСообщения+?(ФоновоеВыполнение," в фоновом режиме",""),"Конструктор");
		ДеревоЗапросовТД.ТекстВыполняемогоЗапроса = ПрефиксЗапроса+cПолучитьТекстДляВыполнения(ДеревоЗапросовТД,"ТекстЗапроса",Не ЗначениеЗаполнено(ПрефиксЗапроса));
		Если ЗначениеЗаполнено(ДеревоЗапросовТД.ТекстВыполняемогоЗапроса) Тогда 
			Попытка								
				ПараметрыЗапроса		= ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСтруктуруПараметров(ДеревоЗапросовТД.ПараметрыЗапроса,УникальныйИдентификатор);
				ДатаДо 					= ТекущаяУниверсальнаяДатаВМиллисекундах();
				ПроверитьПоказателиВыполнения(ДеревоЗапросовТД.ПоказателиВыполнения);
				ИмяОсновногоРеквизита 	= ПолучитьИмяОсновногоРеквизитаРезультата(ДеревоЗапросовТД);
				ПроверитьПоказателиРезультата(ДеревоЗапросовТД.ПоказателиРезультата); //добавил, без нее возникала ошибка в новой строке запроса если е пытаться сразу выполнить в динамическом списке
				сооАдресРезультата 		= ДеревоЗапросовТД.ПоказателиРезультата.сооАдресовРезультатов;//Новый Соответствие; если поставить новый то после выполнения ДС все отальные результаты в строке обнулялись
				Если  ИмяОсновногоРеквизита = ПеречисленияКлиентСерверПовторноеИспользование_Ei.сРезультатДС()  Тогда
					//для Дин. списка не выполняем он выполнится на форме
					ДатаКонцаВыполнения 	= ДатаДо;
					СобытиеОтладки.Действие = "Выполнение запроса дин. списка";
				Иначе
					сооАдресРезультата.Вставить(-1, ОбщийМодульКлиент_Ei.вВыполнитьЗапрос(ДеревоЗапросовТД.ТекстВыполняемогоЗапроса,ПараметрыЗапроса,УникальныйИдентификатор));
					ДатаКонцаВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
					сооАдресРезультата.Удалить(ДеревоЗапросовТД.ПоказателиВыполнения.чСпособВыгрузки); //чтобы результат обновился если он был ранее сохранен непосредственно
				КонецЕсли;	
				вИзменитьПоказателиРезультата(ДеревоЗапросовТД,сооАдресРезультата);
				вИзменитьВремяВыполнения(ДеревоЗапросовТД,ДатаКонцаВыполнения-ДатаДо);
				
				ДатаДо_ 					= ТекущаяУниверсальнаяДатаВМиллисекундах();
					//серверный вызов после всех изменений в ДеревоЗапросовТД, а то будут различатся данные с Элементы.ДеревоЗапросов.ТекущиеДанные
					вЗагрузитьРезультатНаКлиенте(ДеревоЗапросовТД.ПолучитьИдентификатор(),ПараметрыЗапроса);
				ДеревоЗапросовТД.ПоказателиРезультата.сооВремя.Вставить(ДеревоЗапросовТД.ПоказателиВыполнения.чСпособВыгрузки,ТекущаяУниверсальнаяДатаВМиллисекундах() - ДатаДо_);	
					
				ПодключитьОбработчикОжидания("ОО_ОбновитьЗаголовкиЗакладок",0.1,Истина);	
				Если ТекущаяУниверсальнаяДатаВМиллисекундах()-ДатаДо>15*1000 Тогда 
					Сигнал();
				КонецЕсли;
				Если ИмяОсновногоРеквизита = "РезультатЗапросаТЗ" Тогда
					ТекущийЭлемент = Элементы[ИмяОсновногоРеквизита];//.ОтборСтрок = Неопределено;//Новый ФиксированнаяСтруктура;
					ПодключитьОбработчикОжидания("ОО_ОтключитьПоиск",0.1,Истина);
				КонецЕсли;	
			Исключение
				Если Найти(ОписаниеОшибки(),"Не задано значение параметра")>0 Тогда
					//Параметры();
					ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,"Информация","Не все параметры запроса продекларированы, выполните заполнение по тексту запроса"+"#debug_only");
					//ЭлементыФормы.ПанельОшибок.ТекущаяСтраница 	= ЭлементыФормы.ПанельОшибок.Страницы.Параметры;
					//ЭлементыФормы.ПанельОшибок.Видимость 		= Истина;
					ОчиститьСообщения();
					Возврат Неопределено;
				ИначеЕсли Найти(ОписаниеОшибки(),"Временная таблица уже существует")>0 Тогда
					//ЭлементыФормы.ПанельОшибок.ТекущаяСтраница 	= ЭлементыФормы.ПанельОшибок.Страницы.ВремТаблицы;
					//ЭлементыФормы.ПанельОшибок.Видимость 		= Истина;
					////попробуем определить имя проблеменой временной таблицы
					//мСтр = СтрЗаменить(СтрЗаменить(ОписаниеОшибки(),Символы.ПС,""),"""",Символы.ПС);
					//Если СтрЧислоСтрок(мСтр)=3 Тогда
					//	ЭлементыФормы.ИмяВремТаблицы.Заголовок = СтрПолучитьСтроку(мСтр,2);
					//Иначе
					//	ЭлементыФормы.ИмяВремТаблицы.Заголовок = "";	
					//КонецЕсли;
					ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
					ОчиститьСообщения();
					Возврат Неопределено;
				Иначе
					Оповестить("ЗавершениеВыполнения",,ЭтаФорма);
					ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнформацияОбОшибке());
					//Формы.ОбщаяФорма.вПоказатьПроизвольнуюОшибку(ЭтаФорма,ИнформацияОбОшибке(),СобытиеОтладки,3);
					Возврат Неопределено;
				КонецЕсли;	
			КонецПопытки;
		    ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
		КонецЕсли;	
КонецФункции

// Функция - выполняет встроенный язык на клиенте
//
// Параметры:
//  ДеревоЗапросовТД	 - ЭлементКоллекцииДереваФормы	 - Текущая строка дерева запросов
//  ФоновоеВыполнение	 - Булево	 -  Признак выполнения в фоне
//  ВозможностьОтладки	 - Булево	 -  Признак выполненя как внешней формы.
// 
// Возвращаемое значение:
//   - 
//
&НаКлиенте 
Функция ВыполнитьВстроенныйЯзыкНаКлиенте(ДеревоЗапросовТД,ФоновоеВыполнение = Ложь, ВозможностьОтладки = Ложь)
	СтрокаСообщения			= "Выполнение/вычисление выражения на втроенном языке";							
	СобытиеОтладки 			= ОбщийМодульКлиент_Ei.ДобавитьСобытие(СтрокаСообщения+?(ФоновоеВыполнение," в фоновом режиме",""),"Конструктор");
	ТекстВыполняемогоКода 	= cПолучитьТекстДляВыполнения(ДеревоЗапросовТД,"Язык");
	Если ЗначениеЗаполнено(ТекстВыполняемогоКода) Тогда 
		Попытка								
			//ПараметрыЗапроса		= ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСтруктуруПараметров(ДеревоЗапросовТД.ПараметрыЗапроса,УникальныйИдентификатор);
				Переменные			= Новый Структура("Параметры,ЭтаФорма,Объект,ТекущиеДанные,СтрокаТЧ",Неопределено,Неопределено,Неопределено,Неопределено,Неопределено,);
				ЗаполнитьЗначенияСвойств(Переменные,вСформироватьСтруктуруДляФормыВыбораТипа(ДеревоЗапросовТД).ДоступныеСтруктуры);
			ДатаДо 					= ТекущаяУниверсальнаяДатаВМиллисекундах();
			ПроверитьПоказателиВыполнения(ДеревоЗапросовТД.ПоказателиВыполнения);
			//ДеревоЗапросовТД.ПоказателиВыполнения.чСпособВыгрузки = МАКС(1,ДеревоЗапросовТД.ПоказателиВыполнения.чСпособВыгрузки); //дин. список никогда не используем
			мсТипов 				= Новый Массив;
			мсТипов.Добавить("QueryResult");
			мсТипов.Добавить("ValueTable");
			мсТипов.Добавить("ValueTree");
			СлужебныеДанные 			= Новый Структура("Выражение,ОписаниеТипов,УникальныйИдентификатор",ТекстВыполняемогоКода,мсТипов,УникальныйИдентификатор);
			//АдресРезультата			= ОбщийМодульКлиент_Ei.__ВычислитьЗначение(СлужебныеДанные,ПараметрыЗапроса);
			АдресРезультата			= ОбщийМодульКлиент_Ei.__ВычислитьЗначение(СлужебныеДанные,Переменные.Параметры,Переменные.ЭтаФорма,Переменные.Объект,Переменные.ТекущиеДанные,Переменные.СтрокаТЧ);
			ДатаКонцаВыполнения 	= ТекущаяУниверсальнаяДатаВМиллисекундах();
			сооАдресРезультата 		= Новый Соответствие;
			НовыйчСпособВыгрузки	= мсТипов.Найти(АдресРезультата.ОписаниеТипов);
			Если Не НовыйчСпособВыгрузки = Неопределено Тогда
				НовыйчСпособВыгрузки = ?(НовыйчСпособВыгрузки = 0,-1,НовыйчСпособВыгрузки); //результат запроса имеет индекс - 1
				сооАдресРезультата.Вставить(НовыйчСпособВыгрузки, АдресРезультата.Значение);
				ДеревоЗапросовТД.ПоказателиВыполнения.чСпособВыгрузки = НовыйчСпособВыгрузки; //выровняем либо таблицу, либо дерево если найдено, чтобы автоматом переключится на нужную закладку
			КонецЕсли;
			ДеревоЗапросовТД.ПоказателиВыполнения.чСпособВыгрузки = МАКС(1,ДеревоЗапросовТД.ПоказателиВыполнения.чСпособВыгрузки); //дин. список никогда не используем	
			вАктуализироватьТекСтраницуРезультата(ДеревоЗапросовТД);
			вИзменитьПоказателиРезультата(ДеревоЗапросовТД,сооАдресРезультата);
			вИзменитьВремяВыполнения(ДеревоЗапросовТД,ДатаКонцаВыполнения-ДатаДо);		
			//серверный вызов после всех изменений в ДеревоЗапросовТД, а то будут различатся данные с Элементы.ДеревоЗапросов.ТекущиеДанные
			ДеревоЗапросовТД.ТекстВыполняемогоЗапроса = ""; //обунулим текст если он выполнялся до этого используется при выводе произвольной таблицы в динамический список
			ДатаДо_ 					= ТекущаяУниверсальнаяДатаВМиллисекундах();
				вЗагрузитьРезультатНаКлиенте(ДеревоЗапросовТД.ПолучитьИдентификатор(),Переменные.Параметры);//ПараметрыЗапроса);
			ДеревоЗапросовТД.ПоказателиРезультата.сооВремя.Вставить(ДеревоЗапросовТД.ПоказателиВыполнения.чСпособВыгрузки,ТекущаяУниверсальнаяДатаВМиллисекундах() - ДатаДо_);	
			
			ПодключитьОбработчикОжидания("ОО_ОбновитьЗаголовкиЗакладок",0.1,Истина);
			Если ТекущаяУниверсальнаяДатаВМиллисекундах()-ДатаДо>15*1000 Тогда 
				Сигнал();
			КонецЕсли;
		Исключение
			Оповестить("ЗавершениеВыполнения",,ЭтаФорма);
			ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнформацияОбОшибке());
			Возврат Неопределено;
		КонецПопытки;
	    ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
	КонецЕсли;	
КонецФункции

	

&НаСервере
Функция СохранитьМакетКомпановкиданныхДС(ДеревоЗапросовИД)
	сИмяДинСписка 		= ПолучитьИмяРеквизитаДинСписка(ДеревоЗапросовИД);
	Если Не Элементы.Найти(сИмяДинСписка) = Неопределено Тогда
		Схема 				= Элементы[сИмяДинСписка].ПолучитьИсполняемуюСхемуКомпоновкиДанных();
		Настройки 			= Элементы[сИмяДинСписка].ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
		КомпоновщикМакета 	= Новый КомпоновщикМакетаКомпоновкиДанных();
		МакетКомпоновки 	= КомпоновщикМакета.Выполнить(Схема, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		Возврат ПоместитьВоВременноеХранилище(МакетКомпоновки, УникальныйИдентификатор);
	КонецЕсли;	
КонецФункции	

//Обертка серверной функции для проверки того что результирующие данные могут отображаться на клиенте
//
&НаКлиенте
Функция вЗагрузитьРезультатНаКлиенте(ДеревоЗапросовИД,ПараметрыЗапроса = Неопределено)
	Попытка
		Возврат вЗагрузитьРезультат(ДеревоЗапросовИД,ПараметрыЗапроса);	
	Исключение
		//не смоги показать результат на клиенте, очистим его
		ПоказатьПредупреждение(,"Невозможно отобразить результат на клиенте"+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),20,"Отображение результата");
		ОчиститьРезультат(ДеревоЗапросовИД);
	КонецПопытки;
КонецФункции	

// Загружает результат запроса в таблицу(Дерево), сводную таблицу или OLAP  перед вызовом данной процедуры нужно объязательно вызвать ПроверитьПоказателиВыполнения
//
// Параметры:
//  ДеревоЗапросовИД - Число	 - Идентифкатор текущей строки дерева запросов
//  ПараметрыЗапроса - Структура - Парметры запроса дял динамического списка
// 
// Возвращаемое значение:
//   -  Булево. Был ли успешно загружен результат или требуется повторное выполнение
//
&НаСервере
Функция вЗагрузитьРезультат(ДеревоЗапросовИД,ПараметрыЗапроса = Неопределено)
	ДеревоЗапросовТД = ДеревоЗапросов.НайтиПоИдентификатору(ДеревоЗапросовИД);
	Если Не ДеревоЗапросовТД = Неопределено Тогда
		Результат 				= ОбщийМодульВызовСервера_Ei.ПолучитьСохраненныйРезультат(ДеревоЗапросовТД);
		сИмяЭлДинСписка 		= ПолучитьИмяРеквизитаДинСписка(ДеревоЗапросовИД); 
		ИмяОсновногоРеквизита 	= ПолучитьИмяОсновногоРеквизитаРезультата(ДеревоЗапросовТД);
		мКолонокРезультата 		= Новый Массив;

		Если ИмяОсновногоРеквизита = ПеречисленияКлиентСерверПовторноеИспользование_Ei.сРезультатДС()  Тогда
			Если ЗначениеЗаполнено(ДеревоЗапросовТД.ТекстВыполняемогоЗапроса) Тогда
				ЗапросДС 				= ДеревоЗапросовТД.ТекстВыполняемогоЗапроса;
				стрДанныхТекстаЗапроса 	= ОбщийМодульЗакрытыйВызовСервера_Ei.ПолучитьКолонкиИОсновнуюТаблицу(ЗапросДС);
			Иначе
				//в этом случает через ДС прогоняем любую таблицу значений
				//проверим есть что то в таблице значений
				//врТаблица = ОбщийМодульВызовСервера_Ei.ПолучитьСохраненныйРезультат(Новый Структура("ПоказателиВыполнения,ПоказателиРезультата",Новый Структура("чСпособВыгрузки",1),ДеревоЗапросовТД.ПоказателиРезультата));
				//Если врТаблица.Количество() Тогда
				//	ЗапросДС =  "ВЫБРАТЬ
				//	|	таб1.Колонка1 КАК Колонка1
				//	|ПОМЕСТИТЬ Таб2
				//	|ИЗ
				//	|	&таб1__ КАК таб1
				//	|;
				//	|ВЫБРАТЬ
				//	|	Таб2.Колонка1 КАК Колонка1
				//	|ИЗ
				//	|	Таб2 КАК Таб2";
				//	Если Не ТипЗнч(ПараметрыЗапроса) =  Тип("Структура") Тогда
				//		ПараметрыЗапроса = Новый Структура;		
				//	КонецЕсли;	
				//	ПараметрыЗапроса.Вставить("таб1__",врТаблица);
				//	//Увы не получилоь? при получении параметров такого дин. списка ЭтаФорма[ИмяОсновногоРеквизита].Параметры.ДоступныеПараметры.Элементы выскакивает ошибка {(5, 2)}: Неверные параметры "таб1__" <<?>>&таб1__ КАК таб1
				//КонецЕсли;	
			КонецЕсли;
			Если ЗначениеЗаполнено(ЗапросДС) Тогда
				Если Элементы.Найти(сИмяЭлДинСписка) = Неопределено И ПараметрыЗапроса = Неопределено Тогда
					//реквизита нет, инициализации из смены закладок или активизации первой строки при открытии
					Возврат Истина; //нужно нажать кнопку выполнить, только после этого покажем
				КонецЕсли;
				ИмяОсновногоРеквизита   						= сИмяЭлДинСписка;
				ДеревоЗапросовТД.КлючПользовательскихНастроекДС = ?(ЗначениеЗаполнено(ДеревоЗапросовТД.КлючПользовательскихНастроекДС),ДеревоЗапросовТД.КлючПользовательскихНастроекДС, Новый УникальныйИдентификатор);	
				эл_Список 										= ДобавитьРеквизитыДС(ДеревоЗапросовИД);
				РеквизитДС 										= ЭтаФорма[ИмяОсновногоРеквизита];	
				РеквизитДС.ПроизвольныйЗапрос   				= Истина;
				РеквизитДС.ТекстЗапроса							= ЗапросДС;
				РеквизитДС.КлючТекущихПользовательскихНастроек	= ДеревоЗапросовТД.КлючПользовательскихНастроекДС;
				
				Если ПараметрыЗапроса = Неопределено Тогда
					//Проверим нужен ли расчет прааметров если они не пришли вместе с вызовом (обычно возникат при запуске уже существующего в дереве запроса)
					Запрос				= Новый Запрос(РеквизитДС.ТекстЗапроса);
					Если  Запрос.НайтиПараметры().Количество() Тогда
						//ПараметрыЗапроса		= ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСтруктуруПараметров(ДеревоЗапросовТД.ПараметрыЗапроса);	
					КонецЕсли;	
				КонецЕсли;
				ПараметрыЗапроса = ОбщийМодульКлиентСервер_Ei.ПолучитьМодифицирПараметрыДляЗапроса(ПараметрыЗапроса); //#СпецОбработкаТипа
				Попытка
					//Установим переданные параметры
					Если ТипЗнч(ПараметрыЗапроса) = Тип("Структура") Тогда
						Для Каждого ДоступныйПараметр ИЗ ЭтаФорма[ИмяОсновногоРеквизита].Параметры.ДоступныеПараметры.Элементы Цикл
							УстЗначение =  Неопределено; 
							Если ПараметрыЗапроса.Свойство(ДоступныйПараметр.Параметр,УстЗначение) Тогда 
								Если ТипЗнч(УстЗначение) = Тип("Строка") И ЭтоАдресВременногоХранилища(УстЗначение) Тогда
									УстЗначение = ПолучитьИзВременногоХранилища(УстЗначение);
								КонецЕсли;
								УстЗначение = ?(ТипЗнч(УстЗначение) = Тип("СписокЗначений"),УстЗначение.ВыгрузитьЗначения(),УстЗначение); //Динамический список не понимает параметров в виде списка, только массив	
								РеквизитДС.Параметры.УстановитьЗначениеПараметра(ДоступныйПараметр.Параметр, УстЗначение);
							КонецЕсли;	
						КонецЦикла;	
					КонецЕсли;
					
					//Установим другие свойства дин. списка
					мКолонокРезультата								= стрДанныхТекстаЗапроса.мКолонки;
					РеквизитДС.ОсновнаяТаблица						= стрДанныхТекстаЗапроса.ОсновнаяТаблица;
					Если Не ЗначениеЗаполнено(РеквизитДС.ОсновнаяТаблица) И ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ПараметрыЗапроса,"ОсновнаяТаблица") Тогда
						Если ТипЗнч(ПараметрыЗапроса.ОсновнаяТаблица) = Тип("Строка") Тогда
							РеквизитДС.ОсновнаяТаблица = ПараметрыЗапроса.ОсновнаяТаблица;		
						КонецЕсли;	
					КонецЕсли;
					Элементы.Логотип.Видимость 	= Ложь;
					эл_Список.Видимость 		= Истина;
				Исключение
					Элементы.Логотип.Видимость 	= Истина;
					эл_Список.Видимость 		= Ложь;
					Если ТипЗнч(ИнформацияОбОшибке().Причина) 			=  Тип("ИнформацияОбОшибке") И
						 ТипЗнч(ИнформацияОбОшибке().Причина.Причина) 	=  Тип("ИнформацияОбОшибке") Тогда
						//это ошибка в запросе, остальное не интересно
						сДополнениеОшибки = ИнформацияОбОшибке().Причина.Причина.Описание;
					Иначе
						сДополнениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());	
					КонецЕсли;	
					ВызватьИсключение сДополнениеОшибки;
				КонецПопытки;
			КонецЕсли;	
		Иначе
			Если Результат = Неопределено Тогда
				Если Не Элементы.ДинСписок.ПодчиненныеЭлементы.Найти(сИмяЭлДинСписка) = Неопределено Тогда
					//получается что выполняли дин. список и теперь нужно выполнить настоящий запрос
					Возврат Ложь;
				КонецЕсли;	
			Иначе
				//теперь покажем результат на форме
				Если ТипЗнч(Результат) =  Тип("ТабличныйДокумент") Тогда
					РезультатЗапросаТД.Очистить();
					РезультатЗапросаТД.Вывести(Результат);	
				Иначе	
					ДобавитьРеквизитыТЗ(ИмяОсновногоРеквизита,Результат);				
					ЗначениеВРеквизитФормы(Результат,ИмяОсновногоРеквизита); // переставил сюда, был в самом конце процедуры
					мКолонокРезультата 	= ПолучитьКолонкиРезультата(Результат);
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
		ДобавитьКолонкиВЭлемент(ДеревоЗапросовИД,ИмяОсновногоРеквизита,ИмяОсновногоРеквизита,мКолонокРезультата);
		КонецЕсли;
	Возврат Истина;
КонецФункции

&НаСервере
Функция ПолучитьКолонкиРезультата(Набор)
	Результат = Новый Массив;
	ТекущийНабор = ?(ТипЗнч(Набор) = Тип("ТаблицаЗначений"),Набор,Набор.Строки);
	Для Каждого Колонка ИЗ Набор.Колонки Цикл
		мВложенныхКолонок =  Новый Массив;
		Если Колонка.ТипЗначения =  Новый ОписаниеТипов("ТаблицаЗначений") Тогда
			//Если ТекущийНабор.Количество() Тогда
				Для Каждого Подстрока ИЗ ТекущийНабор Цикл
					Если Подстрока[Колонка.Имя].Количество() Тогда
						мВложенныхКолонок = ПолучитьКолонкиРезультата(Подстрока[Колонка.Имя]);
						Прервать;
					КонецЕсли;	
				КонецЦикла;	
			//КонецЕсли;
		КонецЕсли;	
		Результат.Добавить(Новый Структура("Колонка,мКолонкиРезультата",Колонка,мВложенныхКолонок));
	КонецЦикла;	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ДобавитьКолонкиВЭлемент(ДеревоЗапросовИД,ИмяОсновногоРеквизита,ПутьКДанным,мКолонокРезультата)
	Ном 			= мКолонокРезультата.Количество()-1;
	ПредКолонка 	= Неопределено;
	Пока Ном>=0 Цикл  //обязательно обходим с конца чтобы можно было вставлять колонки
		Колонка 			= мКолонокРезультата.Получить(Ном).Колонка;
		мВложенныхКолонок   = мКолонокРезультата.Получить(Ном).мКолонкиРезультата;
		стрИмя 				= ИмяОсновногоРеквизита+Колонка.Имя;
		НовыйЭлемент 		= Элементы[ИмяОсновногоРеквизита].ПодчиненныеЭлементы.Найти(стрИмя);
		Если НовыйЭлемент = Неопределено Тогда
			Если Колонка.ТипЗначения.СодержитТип(Тип("ТаблицаЗначений")) Тогда //=  Новый ОписаниеТипов("ТаблицаЗначений") Тогда
				Если мВложенныхКолонок.Количество() Тогда
					Эл_СтраницыИмя 	= ИмяОсновногоРеквизита+"_"+Формат(ДеревоЗапросовИД,"ЧН=0; ЧГ=")+"_ВложенныеТаблицы";
					Эл_Страницы 	= Элементы[ИмяОсновногоРеквизита].Родитель.ПодчиненныеЭлементы.Найти(Эл_СтраницыИмя);//Элементы[ИмяОсновногоРеквизита].Родитель.Имя);
					Если Эл_Страницы = Неопределено Тогда
						Элементы[ИмяОсновногоРеквизита].Родитель.Группировка =  ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
						Эл_Страницы 					= Элементы.Добавить(Эл_СтраницыИмя, Тип("ГруппаФормы"), Элементы[ИмяОсновногоРеквизита].Родитель);
						Эл_Страницы.Вид					= ВидГруппыФормы.Страницы;
						Эл_Страницы.ОтображениеСтраниц 	= ОтображениеСтраницФормы.ЗакладкиСнизу;
					КонецЕсли;
					Эл_СтраницаИмя	= Эл_СтраницыИмя+"_"+Колонка.Имя;
					Эл_Страница 	= Эл_Страницы.ПодчиненныеЭлементы.Найти(Эл_СтраницаИмя);//Элементы[ИмяОсновногоРеквизита].Родитель.Имя);
					Если Эл_Страница = Неопределено Тогда
						Эл_Страница = Элементы.Добавить(Эл_СтраницаИмя, Тип("ГруппаФормы"), Эл_Страницы);
						Эл_Страница.Вид			= ВидГруппыФормы.Страница;
						Эл_Страница.Заголовок 	= Колонка.Имя;//+?(ВложеннаяТЗ.Количество()," ("+ВложеннаяТЗ.Количество()+")",""); Кол-во нужно считать при активизации строки
					КонецЕсли;
					ИмяВложенногоРеквизита         	= ИмяОсновногоРеквизита+"_"+Формат(ДеревоЗапросовИД,"ЧН=0; ЧГ=")+"_"+Колонка.Имя;
					ПутьКДаннымВложенногоРеквизита 	= "Элементы."+ИмяОсновногоРеквизита+".ТекущиеДанные."+Колонка.Имя;
					эл_Таблица 	= Эл_Страница.ПодчиненныеЭлементы.Найти(ИмяВложенногоРеквизита);
					Если эл_Таблица = Неопределено Тогда
						эл_Таблица 							= Элементы.Добавить(ИмяВложенногоРеквизита, Тип("ТаблицаФормы"), Эл_Страница);
						Попытка
				    		эл_Таблица.ПутьКДанным      		= ПутьКДаннымВложенногоРеквизита;
						Исключение
							Прервать;
						КонецПопытки;	
						эл_Таблица.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
					КонецЕсли;	
					ДобавитьКолонкиВЭлемент(ДеревоЗапросовИД,ИмяВложенногоРеквизита,ПутьКДаннымВложенногоРеквизита,мВложенныхКолонок);
				КонецЕсли;	
			Иначе	
				НовыйЭлемент 				= Элементы.Вставить(стрИмя, Тип("ПолеФормы"),Элементы[ИмяОсновногоРеквизита],ПредКолонка);       
				НовыйЭлемент.Вид 			= ВидПоляФормы.ПолеВвода;
				НовыйЭлемент.Заголовок 		= Колонка.Имя; //имя используется при адресации при выборе
				НовыйЭлемент.ПутьКДанным 	= ПутьКДанным +"."+ Колонка.Имя;
				//Колонка Пометка_Ei тут не добавлется она расположена на форме таблиц и дерева по умолчанию, закрепил ее там с левой фиксацией
				НовыйЭлемент.Ширина 		= 10;
			КонецЕсли;	
		КонецЕсли;
		ПредКолонка = НовыйЭлемент;
		Ном = Ном-1;
	КонецЦикла;
Конецпроцедуры	


&НаСервереБезКонтекста
// Функция - Определяет необходимы ли параметры переданному запросу
//
// Параметры:
//  ТекстЗапроса - Стркоа	 - Текста запроса
// 
// Возвращаемое значение:
//   - Булево
//
Функция ЗапросуНеобходимыПараметры(ТекстЗапроса)
	Результат = Ложь;
	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
		Запрос		= Новый Запрос(ТекстЗапроса);
		Результат	= Запрос.НайтиПараметры().Количество();
	КонецЕсли;
	Возврат Результат;
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИмяОсновногоРеквизитаРезультата(ДеревоЗапросовТД)
	сооИменРеквизитов =  Новый Соответствие;
	сооИменРеквизитов.Вставить(0,ПеречисленияКлиентСерверПовторноеИспользование_Ei.сРезультатДС());	
	сооИменРеквизитов.Вставить(1,"РезультатЗапросаТЗ");
	сооИменРеквизитов.Вставить(2,"РезультатЗапросаДЗ");
	сооИменРеквизитов.Вставить(3,"РезультатЗапросаТД");
	Возврат сооИменРеквизитов.Получить(ДеревоЗапросовТД.ПоказателиВыполнения.чСпособВыгрузки);
КонецФункции	

#КонецОбласти

#Область Параметры

&НаСервере
Процедура вПолучитьПараметрыТекстаЗапроса(ДеревоЗапросовИД)
	ТД = ДеревоЗапросов.НайтиПоИдентификатору(ДеревоЗапросовИД);
	Если Не ТД = Неопределено Тогда	
		ТекстЗапроса = ТД.ТекстЗапроса;
		Если ПустаяСтрока(ТекстЗапроса) Тогда
			Возврат;
		КонецЕсли;
		//СобытиеОтладки=Формы.Отладка.ДобавитьСобытие("Получение типов параметров из текста запроса","Конструктор");
		Попытка
			Запрос				= Новый Запрос(ТекстЗапроса);
			ПараметрыЗапроса 	= Запрос.НайтиПараметры(); 
			Для Каждого ПараметрЗапроса Из ПараметрыЗапроса Цикл
				вДобавитьПараметр(ПараметрЗапроса,ТД);
			КонецЦикла;
			//СобытиеОтладки_Сортировка = Формы.Отладка.ДобавитьСобытие("Сортировка параметров","Конструктор",СобытиеОтладки);
			Попытка
				ТабСортировки = Новый ТаблицаЗначений;
				ТабСортировки.Колонки.Добавить("Имя",Новый ОписаниеТипов("Строка"));
				ТабСортировки.Колонки.Добавить("Порядок",Новый ОписаниеТипов("Число"));
				Для Каждого ПараметрЗапроса Из ПараметрыЗапроса Цикл
					НоваяСтрока = ТабСортировки.Добавить();	
					НоваяСтрока.Имя 	= ПараметрЗапроса.Имя;
					НоваяСтрока.Порядок = Найти(ТекстЗапроса,"&"+НоваяСтрока.Имя);
				КонецЦикла;
				ТабСортировки.Сортировать("Порядок Возр");
				Для Каждого Строка  ИЗ ТабСортировки Цикл
					Для Каждого СтрокаПараметров ИЗ ТД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",Строка.Имя)) Цикл
						Пока ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров)> ТабСортировки.Индекс(Строка) Цикл
							ТД.ПараметрыЗапроса.Сдвинуть(ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров),-1);	
						КонецЦикла;
						Пока ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров)< ТабСортировки.Индекс(Строка) Цикл
							ТД.ПараметрыЗапроса.Сдвинуть(ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров),1);	
						КонецЦикла;
						Прервать;
					КонецЦикла;	
				КонецЦикла;	
				//Формы.Отладка.ЗавершитьСобытие(СобытиеОтладки_Сортировка);
			Исключение 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	чТекущаяСтрока = Неопределено;
	ОбщийМодульКлиент_Ei.ИнициализацияОтладки(); //ПовтороноеИспользование_Ei.Формы().Вставить("Отладка",	ПолучитьФорму(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеФормы().Отладка,,Этаформа));
	ОбщийМодульКлиент_Ei.__ПриОткрытии(ЭтаФорма);
	вУстановитьЗаголовокФормы();
	Если Не ДеревоЗапросов.ПолучитьЭлементы().Количество() Тогда
		вСоздатьНовыйФайлЗапросов(Неопределено, Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ТипЗнч(ИсточникВыбора) = Тип("УправляемаяФорма") Тогда
		Если ИсточникВыбора.ИмяФормы = ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеФормы().ВыборТипа Тогда
			//это выбор параметра в форме выбора типа
			Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ВыбранноеЗначение,"Идентификатор") Тогда 
				ЗаполнитьЗначенияСвойств(Элементы.ДеревоЗапросов.ТекущиеДанные.ПараметрыЗапроса.НайтиПоИдентификатору(ВыбранноеЗначение.Идентификатор),ВыбранноеЗначение,,"ИмяПараметра");
			ИначеЕсли ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ВыбранноеЗначение,"СтруктураГраницВыделения") Тогда
				Если ЗначениеЗаполнено(ВыбранноеЗначение.СтруктураГраницВыделения) Тогда
					Элементы.Язык.УстановитьГраницыВыделения(ВыбранноеЗначение.СтруктураГраницВыделения.НачалоСтрока,ВыбранноеЗначение.СтруктураГраницВыделения.КолонкаНач,ВыбранноеЗначение.СтруктураГраницВыделения.СтрокаКон,ВыбранноеЗначение.СтруктураГраницВыделения.КолонкаКон);
				КонецЕсли;
				Элементы.Язык.ВыделенныйТекст = ВыбранноеЗначение.ЗначениеПараметра;
				ДеревоЗапросовЯзыкПриИзменении(Элементы.Язык);
				Если ЗначениеЗаполнено(ВыбранноеЗначение.СтруктураГраницВыделения) Тогда
					Элементы.Язык.УстановитьГраницыВыделения(ВыбранноеЗначение.СтруктураГраницВыделения.НачалоСтрока,ВыбранноеЗначение.СтруктураГраницВыделения.КолонкаНач,ВыбранноеЗначение.СтруктураГраницВыделения.СтрокаКон,ВыбранноеЗначение.СтруктураГраницВыделения.КолонкаКон);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
	
	ИначеЕсли ТипЗнч(ИсточникВыбора) = Тип("КонструкторСхемыКомпоновкиДанных") Тогда
		
		УстановитьСКД(ВыбранноеЗначение);	
	
	#КонецЕсли
	КонецЕсли;	
КонецПроцедуры


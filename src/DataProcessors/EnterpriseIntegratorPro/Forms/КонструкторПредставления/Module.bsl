		стрЗапроса = Новый Структура("ТекстЗапроса");
		ЗаполнитьЗначенияСвойств(стрЗапроса,Строка);
		Переменные = Новый Структура("ЭтаФорма",Новый Структура("Запросы",стрЗапросов));
		стрЗапроса.Вставить("Параметры",ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСтруктуруПараметров(Строка.ПараметрыЗапроса,УникальныйИдентификатор,,Переменные.ЭтаФорма));
		ДополнениеПредставления = "ПолучитьИзВременногоХранилища("+ПеречисленияКлиентСерверПовторноеИспользование_Ei.Подмена()+".Ссылка)"; 
		стрЗапроса.Вставить("РезультатВыполнения",Новый ФиксированнаяСтруктура("ЭтоКоллекция,ДополнениеПредставления,Ссылка",Истина,ДополнениеПредставления,ПолучитьАдресСохраненногоРезультата(Строка)));
		стрЗапросов.Вставить(Строка.Запрос,стрЗапроса);
		СформироватьСтруктуруЗапросов(стрЗапросов,Строка.ПолучитьЭлементы());
	КонецЦикла;	
КонецФункции


&НаКлиенте
Процедура ОО_ПриАктивизацииСтроки()
	ИзменеиеСпособаВыгрузки();
	ОО_ОбновитьЗаголовкиЗакладок();
	АктуализироватьДинамическиеПоказатели();
	ТД__ = Элементы.ДеревоЗапросов.ТекущиеДанные;
КонецПроцедуры	

&НаКлиенте
Процедура ИзменеиеСпособаВыгрузки()
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда 
		Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ТД.ПоказателиВыполнения,"чСпособВыгрузки") Тогда
			вИзменеиеСпособаВыгрузки(ТД.ПоказателиВыполнения.чСпособВыгрузки);
		Иначе
			//возможно новая строка
			вИзменеиеСпособаВыгрузки(0);
		КонецЕсли;
		вАктуализироватьТекСтраницуРезультата(ТД)
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОО_ОбновитьЗаголовкиЗакладок()
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		Для Каждого	СтраницаПанели ИЗ Элементы.ПанельТекстаЗапроса.ПодчиненныеЭлементы Цикл
			стрОкнчание = "";
			Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ТД.ПоказателиВыполнения,"сооВремя") Тогда
				Время 		= ТД.ПоказателиВыполнения.сооВремя.Получить(СтраницаПанели.Имя);
				стрОкнчание = ?(Не ЗначениеЗаполнено(Время),"",""+ОбщийМодульЗакрытыйКлиент_Ei.вФорматироватьВремя(Время));  // 0 не выводим поскольку может использоваться динмичский список
			КонецЕсли;	
			СтраницаПанели.Заголовок = СокрЛП(СтраницаПанели.Подсказка+" "+стрОкнчание);
		КонецЦикла;
		Для Каждого СтраницаПанели ИЗ Элементы.ПанельРезультата.ПодчиненныеЭлементы Цикл
			стрОкнчание = "";
			Если Не СтраницаПанели = Элементы.ДинСписок Тогда
				Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ТД.ПоказателиРезультата,"сооПометок") Тогда
					стрПометок 	= ТД.ПоказателиРезультата.сооПометок.Получить(Элементы.ПанельРезультата.ПодчиненныеЭлементы.Индекс(СтраницаПанели));
					Если Не стрПометок = Неопределено И стрПометок.Ложь>0  Тогда
						стрОкнчание = ""+стрПометок.Ложь+?(Не стрПометок.Истина>0,""," ("+стрПометок.Истина+")");
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;	
			Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ТД.ПоказателиРезультата,"сооВремя") Тогда
				Время 		= ТД.ПоказателиРезультата.сооВремя.Получить(Элементы.ПанельРезультата.ПодчиненныеЭлементы.Индекс(СтраницаПанели));
				стрОкнчание = стрОкнчание+?(Не ЗначениеЗаполнено(Время),""," / "+ОбщийМодульЗакрытыйКлиент_Ei.вФорматироватьВремя(Время));  // 0 не выводим поскольку может использоваться динмичский список
			КонецЕсли;	
			СтраницаПанели.Заголовок = СокрЛП(СтраницаПанели.Подсказка+" "+стрОкнчание);
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОО_ВыборПериодаЗавершение(Период,ДополнительныеПараметры) Экспорт
	Если Не Период = Неопределено Тогда
		ДополнительныеПараметры.ДатаНачала.ЗначениеПараметра 	= Период.ДатаНачала;	
		ДополнительныеПараметры.ДатаОкончания.ЗначениеПараметра = Период.ДатаОкончания;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОО_ОтключитьПоиск()
	//сбросим установленные поиски
	Если ОбщийМодульКлиент_Ei.ОтключитьПоиск(ЭтаФорма) Тогда
		ОтключитьОбработчикОжидания("ОО_ОтключитьПоиск");
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОО_ПолучениеВремениИзмененияСохраненногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат   >  ДопПараметры.ДатаИзменения Тогда
		//файл запросов свяжее, загрузим результат из него или из временного
		вОткрытьЗапросыИзФайла(ДопПараметры.ИмяФайла,Новый Структура("ДатаИзмененияФайлаНастройки",Результат));
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОО_ПолучениеРезультатаСуществованияВременногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат Тогда
		Файл = Новый Файл(ДопПараметры.ИмяФайла);
		Файл.НачатьПолучениеВремениИзменения(Новый ОписаниеОповещения("ОО_ПолучениеВремениИзмененияВременногоФайла",ЭтаФорма,ДопПараметры));
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ОО_ПолучениеВремениИзмененияВременногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат   >  ДопПараметры.ДатаИзмененияФайлаНастройки Тогда
		//файл запросов свяжее, загрузим результат из него
		вОткрытьЗапросыИзФайла(ДопПараметры.ИмяФайла,Неопределено);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОО_вУстановитьЗаголовокФормы(Результат,ДопПараметры) Экспорт
	Если Результат Тогда
		Заголовок 			= мЗаголовокФормы + " : " + ?(ДопПараметры.ЭтоВременныйФайл,"~","")+ДопПараметры.ИмяБезРасширения;
		СохраненныйОбраз 	= вПолучитьСохраненныйОбраз();  
		// тут не очень понятно насколько данные в файле свежее тех что мы видим
		Если ДопПараметры.ПроверятьДатыФайла Тогда
			Файл = Новый Файл(ИмяФайлаНастройки);
			Файл.НачатьПолучениеВремениИзменения(Новый ОписаниеОповещения("ОО_ПолучениеВремениИзмененияСохраненногоФайла",ЭтаФорма,Новый Структура("ДатаИзменения,ИмяФайла",ДатаИзменения,ИмяФайлаНастройки)));
		КонецЕсли;
		ВычислитьМодифицированность(Ложь); 
	КонецЕсли;	
Конецпроцедуры	


#КонецОбласти



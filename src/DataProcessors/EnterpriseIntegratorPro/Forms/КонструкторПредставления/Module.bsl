	ТипЗначения =  Колонка.Колонка.ТипЗначения;
	Если ТипЗначения.СодержитТип(Тип("Тип")) Тогда
		ТипЗначения =  Новый ОписаниеТипов(); //пустой тип это произвольный, не все типы можно добавлять на форму, к таким например относится Тип, на форму можно добавлять описание типов  #СпецОбработкаТипа
	КонецЕсли;	
	мРеквизитовДобавление.Добавить(Новый РеквизитФормы(Колонка.Колонка.Имя, ТипЗначения,ИмяОсновногоРеквизита));
	Для Каждого ВложеннаяКолонка ИЗ Колонка.мКолонкиРезультата Цикл
		ДобавитьРеквизитТЗ(мРеквизитовДобавление,ВложеннаяКолонка,ИмяОсновногоРеквизита+"."+Колонка.Колонка.Имя);
		//мРеквизитовДобавление.Добавить(Новый РеквизитФормы(ВложеннаяКолонка.Колонка.Имя, ВложеннаяКолонка.Колонка.ТипЗначения,ИмяОсновногоРеквизита+"."+Колонка.Колонка.Имя));	
	КонецЦикла;	

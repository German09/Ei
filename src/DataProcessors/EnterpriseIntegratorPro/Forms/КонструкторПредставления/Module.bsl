&НаСервере
Процедура ПолучитьПараметрыСКД(ТС)
	ТД = ДеревоЗапросов.НайтиПоИдентификатору(ТС);
	Если Не ТД = Неопределено Тогда
		СКД = ОбщийМодульВызовСервера_Ei.ПолучитьСКД(ТД.ТекстСКД);
		Для Каждого ПараметрКомпановки из СКД.Параметры Цикл
			вДобавитьПараметр(ПараметрКомпановки,ТД);
		КонецЦикла;
	КонецЕсли;	

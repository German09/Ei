	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда  //СериализаторXDTO.ЗаписатьXDTO(Элементы[ПолучитьИмяРеквизитаДинСписка(Элементы.ДеревоЗапросов.ТекущаяСтрока)])
		ОбщийМодульКлиентСервер_Ei.ПроверитьПоказателиРезультата(ТД.ПоказателиРезультата);
		ДатаДо 					= ТекущаяУниверсальнаяДатаВМиллисекундах();
			ОписаниеЗначения = СохранитьМакетКомпановкиданныхДС(Элементы.ДеревоЗапросов.ТекущаяСтрока);
			ТД.ПоказателиРезультата.сооАдресовРезультатов.Вставить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().РезультатЗапроса, ОписаниеЗначения);
		ДатаКонцаВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
		вИзменитьВремяВыполнения(ТД,ДатаКонцаВыполнения-ДатаДо); //вы этот момент компановка полностью выполняется
		Элементы.ПанельРезультата.ТекущаяСтраница = Элементы.ValueTable;
		ПанельРезультатаПриСменеСтраницы(Неопределено, Элементы.ПанельРезультата.ТекущаяСтраница);

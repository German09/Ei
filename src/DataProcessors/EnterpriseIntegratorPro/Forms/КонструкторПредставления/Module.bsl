#Область ДеревоЗапросов

&НаКлиенте
Процедура ДеревоЗапросовПриАктивизацииСтроки(Элемент)
	Если Не чТекущаяСтрока = Элемент.ТекущаяСтрока Тогда
		чТекущаяСтрока = Элемент.ТекущаяСтрока;
		ПодключитьОбработчикОжидания("ОО_ПриАктивизацииСтроки",0.1,Истина);
		УстановитьВидимостьДинСписков(Элементы.ДеревоЗапросов.ТекущаяСтрока);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗапросовПередУдалением(Элемент, Отказ) 
	ПоказатьВопрос(Новый ОписаниеОповещения("ОО_ДеревоЗапросовПередУдалением",ЭтаФорма,Элемент),"Удалить строку дерева?",РежимДиалогаВопрос.ОКОтмена,15);
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОО_ДеревоЗапросовПередУдалением(Результат,Элемент) Экспорт
	Если Результат = КодВозвратаДиалога.ОК Тогда
		Родитель = Элемент.ТекущиеДанные.ПолучитьРодителя();
		Если Родитель = Неопределено Тогда
			//Это строка верхнего уровня
			Если ДеревоЗапросов.ПолучитьЭлементы().Количество() = 1 Тогда
				ПоказатьПредупреждение(,"Невозможно удалить последнюю строку",10);
				Возврат;
			Иначе	
				Родитель = ДеревоЗапросов;
			КонецЕсли;	
		КонецЕсли; 
		УдалитьРеквизитыДС(Элемент.ТекущаяСтрока);
		Родитель.ПолучитьЭлементы().Удалить(Элемент.ТекущиеДанные);
	КонецЕсли;	
КонецПроцедуры	


&НаКлиенте
Процедура ДеревоЗапросовПриИзменении(Элемент)
	ВычислитьМодифицированность();
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗапросовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		Если Не Копирование Тогда
			ИмяКадидат = "Вариант";
		Иначе
			ИмяКадидат = Элемент.ТекущиеДанные.Запрос;
		КонецЕсли;
		Элемент.ТекущиеДанные.Запрос = ОбщийМодульКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("Запрос",СокрЛП(ИмяКадидат)),ДеревоЗапросов.ПолучитьЭлементы());
	КонецЕсли;
	сДоИзмененияИмяЗапроса = Элемент.ТекущиеДанные.Запрос
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗапросовЗапросПриИзменении(Элемент)
	сПричина 		= "";
	сИмяЗапроса		= СтрЗаменить(Элементы.ДеревоЗапросов.ТекущиеДанные.Запрос," ","");
	Попытка 
		вр = Новый Структура;
		вр.Вставить(сИмяЗапроса);
	Исключение
		сПричина = "Имя '"+сИмяЗапроса+"' не соответствует правилу именования ключа структуры";
	КонецПопытки;
	Если Не ЗначениеЗаполнено(сПричина) Тогда
		ДублиСтрок = ОбщийМодульКлиент_Ei.НайтиВКоллекцииДерева(Новый Структура("Запрос",сИмяЗапроса),ДеревоЗапросов.ПолучитьЭлементы());
		Если ДублиСтрок.Количество()> 1 Тогда
			сПричина = "Варинат с именем '"+сИмяЗапроса+"' уже существует";	
		КонецЕсли;	
	КонецЕсли;	
	Если ЗначениеЗаполнено(сПричина) Тогда
		Элементы.ДеревоЗапросов.ТекущиеДанные.Запрос = сДоИзмененияИмяЗапроса;
		ПоказатьПредупреждение(,сПричина,20,"Ошибка в имени варината");
	Иначе
		//без лишних пробелов
		Элементы.ДеревоЗапросов.ТекущиеДанные.Запрос = сИмяЗапроса;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ РЕКВИЗИТОВ ТАБЛИЧНОГО ПОЛЯ РезультатЗапроса
#Область РезультатЗапроса

&НаКлиенте
Процедура РезультатЗапросаПриИзменении(Элемент)
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		ВставитьКоллекциюРезультата(ТД);
		вИзменитьПоказателиРезультата(ТД);
		ПодключитьОбработчикОжидания("ОО_ОбновитьЗаголовкиЗакладок",0.1,Истина);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура РезультатЗапросаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка 	= Ложь;
	ВыделенныеСтроки		= Новый Массив; //сформируем массив выделенных туда передаим только одну выбранную, конструкция еще используется в перетаскивании
	ВыделенныеСтроки.Добавить(ВыбраннаяСтрока);
	ЗначенияЯчеек 			= РезультатЗапросаТЗилиДЗПолучитьВыделенныеЯчейки(Элемент, ВыделенныеСтроки, Поле);   
	Если  ЗначенияЯчеек.Количество() Тогда
		ПоказатьЗначение(,ЗначенияЯчеек[0].Значение); //пока зываем всегда первое, список нет смысла показывать, поскольку из него всеравно ничегоне выборать
 	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РезультатЗапросаТЗилиДЗНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	ЗначенияЯчеек = РезультатЗапросаТЗилиДЗПолучитьВыделенныеЯчейки(Элемент, Элемент.ВыделенныеСтроки, Элемент.ТекущийЭлемент); 
	ПеретаскиваниеКлиент_Ei.НачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение, ЗначенияЯчеек)
КонецПроцедуры

&НаКлиенте
Функция РезультатЗапросаТЗилиДЗПолучитьВыделенныеЯчейки(Элемент, ВыделенныеСтроки, Поле)
	ВыделенноеСодержимое =  Новый СписокЗначений;
	Если ЗначениеЗаполнено(Поле.Заголовок) Тогда
		Для Каждого ИдСтроки ИЗ ВыделенныеСтроки Цикл
			Строка = ЭтаФорма[Элемент.Имя].НайтиПоИдентификатору(ИдСтроки);
			Если Не Строка = Неопределено Тогда
			    ВыделенноеСодержимое.Добавить(Строка[Поле.Заголовок]);		
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	Возврат ВыделенноеСодержимое; 
КонецФункции	

&НаКлиенте
Процедура ПанельРезультатаПриСменеСтраницы(Элемент, ТекущаяСтраница)
	// Вставить содержимое обработчика.
	вИзменеиеСпособаВыгрузки(ТекущаяСтраница.Имя);
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	//подсчитаем число строк сразу при переходе на закладку
	Если Не ТД = Неопределено Тогда
		вИзменитьПоказателиРезультата(ТД);
		ПодключитьОбработчикОжидания("ОО_ОбновитьЗаголовкиЗакладок",0.1,Истина);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ОчиститьРезультат(ДеревоЗапросовИД)
	ДеревоЗапросовТД = ДеревоЗапросов.НайтиПоИдентификатору(ДеревоЗапросовИД);
	Если Не ДеревоЗапросовТД = Неопределено Тогда
		ДеревоЗапросовТД.ПоказателиРезультата.сооАдресовРезультатов = Новый Соответствие;
		вЗагрузитьРезультат(ДеревоЗапросовИД);
	КонецЕсли;	
КонецПроцедуры	

#КонецОбласти

// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ РЕКВИЗИТОВ ТАБЛИЧНОГО Документа РезультатЗапроса
#Область РезультатЗапросаТД

&НаКлиенте
Процедура РезультатЗапросаТДПриИзменении(Элемент)
	ВставитьКоллекциюРезультата(Элементы.ДеревоЗапросов.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура РезультатЗапросаТДОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	ТДОбработкаРасшифровки(Ложь,	Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры);
КонецПроцедуры

&НаКлиенте
Процедура РезультатЗапросаТДОбработкаДополнительнойРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	ТДОбработкаРасшифровки(Истина,	Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры);
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСохраненныйРезультатСКД()
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
    	ОбщийМодульКлиентСервер_Ei.ПроверитьПоказателиРезультата(ТД.ПоказателиРезультата);
		ОписаниеЗначенияРезультатаСКД = ТД.ПоказателиРезультата.сооАдресовРезультатов.Получить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().РезультатЗапроса); //РезультатЗапроса
		Если Не ОписаниеЗначенияРезультатаСКД = Неопределено Тогда
			Попытка
				СохраненныйРезультат	= ПолучитьИзВременногоХранилища(ОписаниеЗначенияРезультатаСКД.Ссылка);
			Исключение
				Возврат Неопределено
			КонецПопытки;	
			Если ТипЗнч(СохраненныйРезультат) = Тип("Структура") И СохраненныйРезультат.Свойство("АдресСхемыКомпоновкиДанных") Тогда
				Возврат СохраненныйРезультат;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
КонецФункции	

&НаКлиенте
Процедура ТДОбработкаРасшифровки(ДополнительнаяРасшифровка,Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	СохраненныйРезультат = ПолучитьСохраненныйРезультатСКД();
	Если Не СохраненныйРезультат = Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(СохраненныйРезультат.АдресДанныхРасшифровки, Новый ИсточникДоступныхНастроекКомпоновкиДанных(СохраненныйРезультат.АдресСхемыКомпоновкиДанных));
		Если ДополнительнаяРасшифровка Тогда
			ОбработкаРасшифровки.ПоказатьВыборДействия(Новый ОписаниеОповещения("РезультатТабличныйДокументОбработкаРасшифровкиЗавершение", ЭтаФорма, Новый Структура("Расшифровка,АдресДанныхРасшифровки", Расшифровка,СохраненныйРезультат.АдресДанныхРасшифровки)), Расшифровка,,,,Элементы.РезультатЗапросаТД);
        Иначе
			ОбработкаРасшифровки.ПоказатьВыборДействия(Новый ОписаниеОповещения("РезультатТабличныйДокументОбработкаРасшифровкиЗавершение", ЭтаФорма, Новый Структура("Расшифровка,АдресДанныхРасшифровки", Расшифровка,СохраненныйРезультат.АдресДанныхРасшифровки)), Расшифровка,,,Истина,);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

// Отработка выбора действия расшифровки.
&НаКлиенте
Процедура РезультатТабличныйДокументОбработкаРасшифровкиЗавершение(ВыполненноеДействие, ПараметрВыполненногоДействия, ДополнительныеПараметры) Экспорт
	Расшифровка 			= ДополнительныеПараметры.Расшифровка;
	АдресДанныхРасшифровки	= ДополнительныеПараметры.АдресДанныхРасшифровки;
	
	Если ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.Нет Тогда
	ИначеЕсли ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
		ПоказатьЗначение(, ПараметрВыполненногоДействия);
	Иначе
		ОписаниеОбработкиРасшифровки 	= Новый ОписаниеОбработкиРасшифровкиКомпоновкиДанных(АдресДанныхРасшифровки, Расшифровка, ПараметрВыполненногоДействия);
		ТД 								= Элементы.ДеревоЗапросов.ТекущиеДанные;
		СтрРасшифровки			= Новый Структура("АдресДанныхРасшифровки,ОписаниеОбработкиРасшифровки",АдресДанныхРасшифровки,ОписаниеОбработкиРасшифровки);
		Если Не ТД = Неопределено Тогда
			ВыполнитьСКДНаКлиенте(ТД,СтрРасшифровки);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


#КонецОбласти

// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ РЕКВИЗИТОВ ТАБЛИЧНОГО ПОЛЯ Параметры
#Область РезультатЗапроса

&НаКлиенте
Процедура ДеревоЗапросовПараметрыЗапросаЗначениеПараметраНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТД 						= Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущиеДанные;
	СтруктураПеременных 	= ПолучитьСтруктуруПеременных(ТД);
	ВыборКлиент_Ei.НачалоВыбора(ЭтаФорма,Элемент,СтруктураПеременных,СтандартнаяОбработка,"ДеревоВыбора");
	Если ТипЗнч(ТД.ЗначениеПараметра) = Тип("СписокЗначений") И ТД.ЗначениеПараметра.Количество()>0 Тогда
		ТД.ЗначениеПараметра.ТипЗначения =  ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(ТипЗнч(ТД.ЗначениеПараметра[0].Значение));
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗапросовПараметрыЗапросаЗначениеПараметраОчистка(Элемент, СтандартнаяОбработка)
	Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущиеДанные.ЗначениеПараметра =  Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗапросовПараметрыЗапросаЭтоВыражениеПриИзменении(Элемент)
	ТД = Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущиеДанные;
	Если ТД.ЭтоВыражение Тогда
		сНовыйАлгоритм = ОбщийМодульЗакрытыйКлиент_Ei.ПреобразоватьЗначениеКВыражению(ТД.ЗначениеПараметра);
		Если ТипЗнч(сНовыйАлгоритм) = Тип("Строка") Тогда
			ТД.ЗначениеПараметра = сНовыйАлгоритм;
		Иначе
			//может вернуться неопределено, тогда мы просто ничего не посчитали
			ТД.ЭтоВыражение = Ложь;
		КонецЕсли;	
	Иначе
		КонтекстВыполнения 		= ПолучитьСтруктуруДоступныхПеременных(Элементы.ДеревоЗапросов.ТекущиеДанные);
        ТД.ЗначениеПараметра 	= ОбщийМодульКлиент_Ei.__ВычислитьЗначение(ТД.ЗначениеПараметра,,,КонтекстВыполнения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗапросовПараметрыЗапросаИмяПараметраПриИзменении(Элемент)
	сПричина 		= "";
	сИмяПараметра	= СтрЗаменить(Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущиеДанные.ИмяПараметра," ","");
	Попытка 
		вр = Новый Структура;
		вр.Вставить(сИмяПараметра);
	Исключение
		сПричина = "Имя '"+сИмяПараметра+"' не соответствует правилу именования ключа структуры";
	КонецПопытки;
	Если Не ЗначениеЗаполнено(сПричина) Тогда
		ДублиСтрок =  Новый Массив;//Элементы.ДеревоЗапросов.ПолучитьЭлементы()
		Если ДублиСтрок.Количество()> 1 Тогда
			сПричина = "Параметр с именем '"+сИмяПараметра+"' уже существует";	
		КонецЕсли;	
	КонецЕсли;	
	Если ЗначениеЗаполнено(сПричина) Тогда
		Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущиеДанные.ИмяПараметра = сДоИзмененияИмяПараметра;
		ПоказатьПредупреждение(,сПричина,20,"Ошибка в имени параметра");
	Иначе
		//без лишних пробелов
		Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущиеДанные.ИмяПараметра = сИмяПараметра;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗапросовПараметрыЗапросаПриИзменении(Элемент)
	ВычислитьМодифицированность();
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗапросовПараметрыЗапросаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		Если Не Копирование Тогда
			ИмяКадидат = "Параметр";
		Иначе
			ИмяКадидат = Элемент.ТекущиеДанные.ИмяПараметра;
		КонецЕсли;
		Элемент.ТекущиеДанные.ИмяПараметра = вПолучитьУникальноеИмяПараметра(СокрЛП(ИмяКадидат));
	КонецЕсли;
	сДоИзмененияИмяПараметра = Элемент.ТекущиеДанные.ИмяПараметра
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗапросовПараметрыЗапросаПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)

&НаКлиенте
Процедура ВыполнитьВКонтексте(Команда)
	Если Элементы.ПанельТекстаЗапроса.ТекущаяСтраница = Элементы.Предприятие Тогда
		ВыполнитьЗапрос(Неопределено);
	ИначеЕсли Элементы.ПанельТекстаЗапроса.ТекущаяСтраница = Элементы.СКД Тогда
		ВыполнитьСКД(Неопределено);	
	ИначеЕсли Элементы.ПанельТекстаЗапроса.ТекущаяСтраница = Элементы.ВстроенныйЯзык Тогда
 		ВыполнитьВстроенныйЯзык(Неопределено);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗапрос(Команда)
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		ВыполнитьЗапросНаКлиенте(ТД);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВстроенныйЯзык(Команда)
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		ВыполнитьВстроенныйЯзыкНаКлиенте(ТД);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИЗ(Команда)
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		ПроверитьПоказателиВыполнения(ТД.ПоказателиВыполнения);
		ТД.ПоказателиВыполнения.чСпособВыгрузки = 0; //переключаемся на ДС
		ВыполнитьЗапросНаКлиенте(ТД,,"Выбрать * Из ");
		вАктуализироватьТекСтраницуРезультата(ТД)
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДоступныеПеременные(Команда)
	Перем НачалоСтрока,КолонкаНач,СтрокаКон,КолонкаКон;
	
	ПараметрыФормы 	= вСформироватьСтруктуруДляФормыВыбораТипа(Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущиеДанные);
	ПараметрыФормы.Вставить("ЗапретитьВстроенныйЯзык");
	ПараметрыФормы.ТекущиеДанные.ЭтоВыражение 		= Истина; 		//для того чтоб не заполнялось дерево типов
	ПараметрыФормы.ТекущиеДанные.ЗначениеПараметра 	= ?(ЗначениеЗаполнено(Элементы.Язык.ВыделенныйТекст),Элементы.Язык.ВыделенныйТекст,Неопределено); //в вСформироватьСтруктуруДляФормыВыбораТипа заполняется текущей строкой
	ПараметрыФормы.ТекущиеДанные.Удалить("Идентификатор"); //Удаляем идентифкатор, для того чтобы в ОбработкеВыбора могли пройти до условия СтруктураГраницВыделения
	ПараметрыФормы.ТекущиеДанные.Вставить("СтруктураГраницВыделения");
	Элементы.Язык.ПолучитьГраницыВыделения(НачалоСтрока,КолонкаНач,СтрокаКон,КолонкаКон);
	ПараметрыФормы.ТекущиеДанные.СтруктураГраницВыделения = Новый Структура("НачалоСтрока,КолонкаНач,СтрокаКон,КолонкаКон", НачалоСтрока,КолонкаНач,СтрокаКон,КолонкаКон);
	ФормаВыбораТипа	= ПолучитьФорму(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеФормы().ВыборТипа,ПараметрыФормы,ЭтаФорма);
	ФормаВыбораТипа.НачалоВыбора(Элементы.Язык, Ложь);
КонецПроцедуры

#Область Шаблоны

&НаСервере
//Добавляет параметр к текущему запросу,
//используется в основнм в шаблонах
Процедура вВставитьПараметр(ДеревоЗапросовИД,Имя,Значение) Экспорт
	ТД = ДеревоЗапросов.НайтиПоИдентификатору(ДеревоЗапросовИД);
	Если Не ТД = Неопределено Тогда
		СтрокиПараметров = ТД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",Имя));
		Если Не СтрокиПараметров.Количество() Тогда
			СтрокаПараметров = ТД.ПараметрыЗапроса.Добавить();
			СтрокаПараметров.ИмяПараметра		= Имя;
			СтрокаПараметров.ЗначениеПараметра	= Значение;
		Иначе
			Для Каждого СтрокаПараметров ИЗ СтрокиПараметров Цикл
				СтрокаПараметров.ЗначениеПараметра	= Значение;
			КонецЦикла	
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


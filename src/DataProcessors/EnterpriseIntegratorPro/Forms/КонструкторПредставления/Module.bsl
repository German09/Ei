//Выполяняет СКД 
//В случае фонового выпонения возврашает структуру параметров которая будет отпрвлена на сервер
//Параметры:
//  ПрефиксЗапроса		-<Строка>. Для выполненения запроса толь к истонику данных. Например "Выбрать * ИЗ"+ВыделеннаяЧасть.
//	ПроверятьСелект		-<Булево>. Провереять или нет перед выполенением запроса. Наличие инструкции SELECT
//  Пакет				-<Булево>. Признак выполнения пакета с последующей возможностью. выбрать один из нескольких результатов выполнения пакетов запроса.
//	ФоновоеВыполнение   -<Булево>. Признак выполнения в фоне
//
&НаКлиенте 
Функция ВыполнитьСКДНаКлиенте(ДеревоЗапросовТД, СтрРасшифровки = Неопределено, ФоновоеВыполнение =  Ложь)
									
		СтрокаСообщения	= "Выполнение СКД";							
		СобытиеОтладки 	= ОбщийМодульКлиент_Ei.ДобавитьСобытие(СтрокаСообщения+?(ФоновоеВыполнение," в фоновом режиме",""),"Конструктор");
		Если ЗначениеЗаполнено(ДеревоЗапросовТД.ТекстСКД) Тогда 
			Попытка								
				ПараметрыЗапроса		= ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСтруктуруПараметров(ДеревоЗапросовТД.ПараметрыЗапроса,УникальныйИдентификатор);
				ДатаДо 					= ТекущаяУниверсальнаяДатаВМиллисекундах();
				ПроверитьПоказателиВыполнения(ДеревоЗапросовТД.ПоказателиВыполнения);
				ИмяОсновногоРеквизита 	= ПолучитьИмяОсновногоРеквизитаРезультата(ДеревоЗапросовТД);
				сооАдресРезультата 		= ДеревоЗапросовТД.ПоказателиРезультата.сооАдресовРезультатов;//Новый Соответствие; если поставить новый то после выполнения ДС все отальные результаты в строке обнулялись
				Если  Не ИмяОсновногоРеквизита = ПеречисленияКлиентСерверПовторноеИспользование_Ei.сРезультатДС()  Тогда
					ТипГенератора = ?(ДеревоЗапросовТД.ПоказателиВыполнения.чСпособВыгрузки = 3,"ГенераторМакетаКомпоновкиДанных","ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
					сооАдресРезультата.Вставить(-1, ОбщийМодульКлиент_Ei.вВыполнитьСКД(ДеревоЗапросовТД.ТекстСКД,ПараметрыЗапроса,УникальныйИдентификатор,ТипГенератора,СтрРасшифровки));
					ДатаКонцаВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
					сооАдресРезультата.Удалить(ДеревоЗапросовТД.ПоказателиВыполнения.чСпособВыгрузки); //чтобы результат обновился если он был ранее сохранен непосредственно
				КонецЕсли;	
				вИзменитьПоказателиРезультата(ДеревоЗапросовТД,сооАдресРезультата);
				вИзменитьВремяВыполнения(ДеревоЗапросовТД,ДатаКонцаВыполнения-ДатаДо);
				
				ДатаДо_ 					= ТекущаяУниверсальнаяДатаВМиллисекундах();
					//серверный вызов после всех изменений в ДеревоЗапросовТД, а то будут различатся данные с Элементы.ДеревоЗапросов.ТекущиеДанные
					вЗагрузитьРезультатНаКлиенте(ДеревоЗапросовТД.ПолучитьИдентификатор(),ПараметрыЗапроса);
				ДеревоЗапросовТД.ПоказателиРезультата.сооВремя.Вставить(ДеревоЗапросовТД.ПоказателиВыполнения.чСпособВыгрузки,ТекущаяУниверсальнаяДатаВМиллисекундах() - ДатаДо_);	
					
				ПодключитьОбработчикОжидания("ОО_ОбновитьЗаголовкиЗакладок",0.1,Истина);	
				Если ТекущаяУниверсальнаяДатаВМиллисекундах()-ДатаДо>15*1000 Тогда 
					Сигнал();
				КонецЕсли;
				Если ИмяОсновногоРеквизита = "РезультатЗапросаТЗ" Тогда
					ТекущийЭлемент = Элементы[ИмяОсновногоРеквизита];//.ОтборСтрок = Неопределено;//Новый ФиксированнаяСтруктура;
					ПодключитьОбработчикОжидания("ОО_ОтключитьПоиск",0.1,Истина);
				КонецЕсли;	
			Исключение
				Если Найти(ОписаниеОшибки(),"Не задано значение параметра")>0 Тогда
					//Параметры();
					ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное","Не все параметры запроса продекларированы, выполните заполнение по тексту запроса");
					//ЭлементыФормы.ПанельОшибок.ТекущаяСтраница 	= ЭлементыФормы.ПанельОшибок.Страницы.Параметры;
					//ЭлементыФормы.ПанельОшибок.Видимость 		= Истина;
					ОчиститьСообщения();
					Возврат Неопределено;
				ИначеЕсли Найти(ОписаниеОшибки(),"Временная таблица уже существует")>0 Тогда
					//ЭлементыФормы.ПанельОшибок.ТекущаяСтраница 	= ЭлементыФормы.ПанельОшибок.Страницы.ВремТаблицы;
					//ЭлементыФормы.ПанельОшибок.Видимость 		= Истина;
					////попробуем определить имя проблеменой временной таблицы
					//мСтр = СтрЗаменить(СтрЗаменить(ОписаниеОшибки(),Символы.ПС,""),"""",Символы.ПС);
					//Если СтрЧислоСтрок(мСтр)=3 Тогда
					//	ЭлементыФормы.ИмяВремТаблицы.Заголовок = СтрПолучитьСтроку(мСтр,2);
					//Иначе
					//	ЭлементыФормы.ИмяВремТаблицы.Заголовок = "";	
					//КонецЕсли;
					ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
					ОчиститьСообщения();
					Возврат Неопределено;
				Иначе
					Оповестить("ЗавершениеВыполнения",,ЭтаФорма);
					ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнформацияОбОшибке());
					//Формы.ОбщаяФорма.вПоказатьПроизвольнуюОшибку(ЭтаФорма,ИнформацияОбОшибке(),СобытиеОтладки,3);
					Возврат Неопределено;
				КонецЕсли;	
			КонецПопытки;
		    ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
		КонецЕсли;	
КонецФункции

#КонецОбласти

#Область УникальностиИменПоСтруктуреЗапросаИПараметров

&НаКлиенте
Функция вПолучитьУникальноеИмяПараметра(ИмяКандидат,Приращение=1)
	Результат = "";
	СтрокиПараметров = Элементы.ДеревоЗапросов.ТекущиеДанные.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",ИмяКандидат));
	Если Не СтрокиПараметров.Количество() Тогда
		Результат = ИмяКандидат;
	Иначе
		//имя не уникально
		чОкончание = ВыделитьЧисловоеОкончание(ИмяКандидат);
		Если ЗначениеЗаполнено(чОкончание) Тогда
			ИмяКандидат = СтрЗаменить(ИмяКандидат,Формат(чОкончание,"ЧН=0; ЧГ="),Формат(чОкончание+Приращение,"ЧН=0; ЧГ="));	
		Иначе
			ИмяКандидат = ИмяКандидат+Формат(Приращение,"ЧН=0; ЧГ=");
		КонецЕсли;
		Результат 	= вПолучитьУникальноеИмяПараметра(ИмяКандидат,Приращение+1);
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция вПолучитьУникальноеИмяЗапроса(ИмяКандидат,Приращение=1)
	Результат = "";
	СтрокиЗапросов = НайтиВДеревеЗапрос(ИмяКандидат,ДеревоЗапросов.ПолучитьЭлементы());
	Если Не СтрокиЗапросов.Количество() Тогда
		Результат = ИмяКандидат;
	Иначе
		//имя не уникально
		чОкончание = ВыделитьЧисловоеОкончание(ИмяКандидат);
		Если ЗначениеЗаполнено(чОкончание) Тогда
			ИмяКандидат = СтрЗаменить(ИмяКандидат,Формат(чОкончание,"ЧН=0; ЧГ="),Формат(чОкончание+Приращение,"ЧН=0; ЧГ="));	
		Иначе
			ИмяКандидат = ИмяКандидат+Формат(Приращение,"ЧН=0; ЧГ=");
		КонецЕсли;
		Результат 	= вПолучитьУникальноеИмяЗапроса(ИмяКандидат,Приращение+1);
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция НайтиВДеревеЗапрос(сЗапрос,КоллекцияСтрок)
	Результат = Новый Массив;
	Для Каждого Строка ИЗ КоллекцияСтрок Цикл
		Если нРег(Строка.Запрос) = нРег(сЗапрос) Тогда
			Результат.Добавить(Строка);
		КонецЕсли;
		Для Каждого ВложенныйРезультат ИЗ НайтиВДеревеЗапрос(сЗапрос,Строка.ПолучитьЭлементы()) Цикл
			Результат.Добавить(ВложенныйРезультат);		
		КонецЦикла;	
	КонецЦикла;
	Возврат Результат;
КонецФункции	

&НаКлиенте
Функция ВыделитьЧисловоеОкончание(Имя)
	Результат = 0;
	Для Ном = 1 По СтрДлина(Имя) Цикл
		Попытка
			вр = Число(Прав(Имя,Ном));
		Исключение
			Если ЗначениеЗаполнено(Прав(Имя,Ном-1)) Тогда
				Возврат Число(Прав(Имя,Ном-1));
			Иначе
				Прервать;
			КонецЕсли;	
		КонецПопытки;	
	КонецЦикла;	
	Возврат Результат; 
КонецФункции	

#КонецОбласти

#Область РаботаСДинСписком

&НаКлиенте
Процедура УстановитьВидимостьДинСписков(ДеревоЗапросовИД)
	Если Не ДеревоЗапросовИД = Неопределено Тогда
		ПоказалиДС = Ложь;
		ИмяОсновногоРеквизита = ПолучитьИмяРеквизитаДинСписка(ДеревоЗапросовИД);
		Для Каждого элФормы ИЗ Элементы.ГруппаДинСписков.ПодчиненныеЭлементы Цикл                                    
			Если элФормы.Имя = Элементы.ГруппаДинСписков.Имя+ИмяОсновногоРеквизита Тогда
				элФормы.Видимость 							= Истина;
				ПоказалиДС									= Истина;
				Элементы.ГруппаДинСписков.ТекущаяСтраница 	= элФормы;
			Иначе
				элФормы.Видимость 	= Ложь;
			КонецЕсли;
		КонецЦикла;
		Элементы.Логотип.Видимость = Не ПоказалиДС;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура УдалитьРеквизитыДС(ДеревоЗапросовИД)
	сИмяРеквизитаДинСписка 	= ПолучитьИмяРеквизитаДинСписка(ДеревоЗапросовИД);
	ЭлДинСписка				= Элементы.Найти(сИмяРеквизитаДинСписка);
	Если Не ЭлДинСписка = Неопределено Тогда
		УдаляемыеРеквизиты	= Новый Массив;
		УдаляемыеРеквизиты.Добавить(сИмяРеквизитаДинСписка);
		ИзменитьРеквизиты(,УдаляемыеРеквизиты);
	    Элементы.Удалить(ЭлДинСписка);
	КонецЕСли;	

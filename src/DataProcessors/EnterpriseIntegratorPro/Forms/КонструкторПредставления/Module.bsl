&НаКлиенте
Процедура ПриОткрытии(Отказ)
	чТекущаяСтрока = Неопределено;
	ОтладкаКлиент_Ei.ИнициализацияОтладки(); //ПовтороноеИспользование_Ei.Формы().Вставить("Отладка",	ПолучитьФорму(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеФормы().Отладка,,Этаформа));
	ОбщийМодульКлиент_Ei.__ПриОткрытии(ЭтаФорма);
	вУстановитьЗаголовокФормы();
	Если Не ДеревоЗапросов.ПолучитьЭлементы().Количество() Тогда
		вСоздатьНовыйФайлЗапросов(Неопределено, Неопределено);
	ИначеЕсли ДеревоЗапросов.ПолучитьЭлементы().Количество() = 1 Тогда	
		Элементы.ДеревоЗапросов.Развернуть(ДеревоЗапросов.ПолучитьЭлементы()[0].ПолучитьИдентификатор());	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ТипЗнч(ИсточникВыбора) = Тип("УправляемаяФорма") Тогда
		Если ИсточникВыбора.ИмяФормы = ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеФормы().ВыборТипа Тогда
			//это выбор параметра в форме выбора типа
			ОбработкаВыбора_ВыборТипа(ВыбранноеЗначение);
		КонецЕсли;
	#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
	
	ИначеЕсли ТипЗнч(ИсточникВыбора) = Тип("КонструкторСхемыКомпоновкиДанных") Тогда
		
		УстановитьСКД(ВыбранноеЗначение);	
	
	#КонецЕсли
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ОбновитьГрафическуюСхему" И ТипЗнч(Источник) = Тип("ДанныеФормыЭлементДерева") Тогда
		//этим событием отмечам факт необходимости обновления схемы процесса, покажем как она изменилась
		ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
		Если Не ТД = Неопределено  И Источник = ТД Тогда
			//ВосстановитьГрафСхему(ТД);
			Если Элементы.ОтобразитьПоказателиПроцесса.Пометка Тогда
				Процессы_ГрафСхема = ПроцессыКлиент_Ei.ПолучитьВыполненнуюСхему(ТД,Элементы.ОтобразитьПоказателиПроцесса.Пометка);
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры


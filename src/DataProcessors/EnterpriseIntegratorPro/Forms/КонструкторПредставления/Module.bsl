&НаКлиенте
Процедура УстановитьСКД(Схема)
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
			ЗаписьXML = Новый ЗаписьXML;
			ЗаписьXML.УстановитьСтроку();
			СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Схема, "dataCompositionSchema", "http://v8.1c.ru/8.1/data-composition-system/schema");
			ТД.ТекстСКД = ЗаписьXML.Закрыть();
			ДеревоЗапросовТекстСКДПриИзменении(Элементы.ТекстСКД);
		#КонецЕсли
	КонецЕсли;	

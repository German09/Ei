//	ЗначениеДоп			- <Число>. Число доп. секунд затраченного времени (для дополнительной временной детализации)
Процедура вИзменитьВремяВыполнения(ДеревоЗапросовТД,Значение,ЗначениеДоп=0) Экспорт 
	ТекущаяСтраница = Элементы.ПанельТекстаЗапроса.ТекущаяСтраница;
    ПроверитьПоказателиВыполнения(ДеревоЗапросовТД.ПоказателиВыполнения);
	ДеревоЗапросовТД.ПоказателиВыполнения.сооВремя.Вставить(ТекущаяСтраница.Имя,Значение);

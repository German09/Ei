		ПодключитьОбработчикОжидания("ОО_ОбновитьЗаголовкиЗакладок",0.1,Истина);
		Если ТекущаяУниверсальнаяДатаВМиллисекундах()-ДатаДо>15*1000 Тогда 
			Сигнал();
		КонецЕсли;
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
		ТекстМодуляКлиент_Ei.ПоказатьОшибкиКодов(Элементы.ОшибкаПроцессаТекст,ИнфоОбОшибке);
		Возврат;
	КонецПопытки;
    ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
КонецПроцедуры


&НаКлиенте
Процедура ДеревоЗапросовПараметрыЗапросаЗначениеПараметраНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТД 						= Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущиеДанные;
	СтруктураПеременных 	= ПолучитьСтруктуруПеременных(ТД);
	ФормаРодитель 			= НаследоватьВыбор();
	ОО_ВыбораПараметра 		= Новый ОписаниеОповещения("ВыборПараметра",ЭтаФорма);
	ВыборКлиент_Ei.НачалоВыбора(ОО_ВыбораПараметра,ФормаРодитель.Выбор,ЭтаФорма,Элемент,СтруктураПеременных,СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ВыборПараметра(ВыбранноеЗначение, ДопПараметры) Экспорт
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные.ПараметрыЗапроса.НайтиПоИдентификатору(ВыбранноеЗначение.Идентификатор);
	ЗаполнитьЗначенияСвойств(ТД,ВыбранноеЗначение,,"ИмяПараметра");
	Если ТипЗнч(ТД.ЗначениеПараметра) = Тип("СписокЗначений") И ТД.ЗначениеПараметра.Количество()>0 Тогда
		ТД.ЗначениеПараметра.ТипЗначения =  ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(ТипЗнч(ТД.ЗначениеПараметра[0].Значение));
	КонецЕсли;	
Конецпроцедуры

&НаКлиенте
Процедура ДеревоЗапросовПараметрыЗапросаЗначениеПараметраОчистка(Элемент, СтандартнаяОбработка)
	Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущиеДанные.ЗначениеПараметра =  Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗапросовПараметрыЗапросаЭтоВыражениеПриИзменении(Элемент)
	ТД = Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущиеДанные;
	Если ТД.ЭтоВыражение Тогда
		сНовыйАлгоритм = ОбщийМодульЗакрытыйКлиент_Ei.ПреобразоватьЗначениеКВыражению(ТД.ЗначениеПараметра);
		Если ТипЗнч(сНовыйАлгоритм) = Тип("Строка") Тогда
			ТД.ЗначениеПараметра = сНовыйАлгоритм;
		Иначе
			//может вернуться неопределено, тогда мы просто ничего не посчитали
			ТД.ЭтоВыражение = Ложь;
		КонецЕсли;	
	Иначе
		КонтекстВыполнения 		= ВариантыКлиент_Ei.ПолучитьСтруктуруДоступныхПеременных(ЭтаФорма,Элементы.ДеревоЗапросов.ТекущиеДанные,Ложь);
        ТД.ЗначениеПараметра 	= ОбщийМодульКлиентСервер_Ei.__ВычислитьЗначение(ТД.ЗначениеПараметра,,,КонтекстВыполнения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗапросовПараметрыЗапросаИмяПараметраПриИзменении(Элемент)
	сПричина 		= "";
	сИмяПараметра	= СтрЗаменить(Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущиеДанные.ИмяПараметра," ","");
	Попытка 
		вр = Новый Структура;
		вр.Вставить(сИмяПараметра);
	Исключение
		сПричина = "Имя '"+сИмяПараметра+"' не соответствует правилу именования ключа структуры";
	КонецПопытки;
	Если Не ЗначениеЗаполнено(сПричина) Тогда
		ДублиСтрок =  Новый Массив;//Элементы.ДеревоЗапросов.ПолучитьЭлементы()
		Если ДублиСтрок.Количество()> 1 Тогда
			сПричина = "Параметр с именем '"+сИмяПараметра+"' уже существует";	
		КонецЕсли;	
	КонецЕсли;	
	Если ЗначениеЗаполнено(сПричина) Тогда
		Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущиеДанные.ИмяПараметра = сДоИзмененияИмяПараметра;
		ПоказатьПредупреждение(,сПричина,20,"Ошибка в имени параметра");
	Иначе
		//без лишних пробелов
		Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущиеДанные.ИмяПараметра = сИмяПараметра;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗапросовПараметрыЗапросаПриИзменении(Элемент)
	ВычислитьМодифицированность();
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗапросовПараметрыЗапросаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		Если Не Копирование Тогда
			ИмяКадидат = "Параметр";
		Иначе
			ИмяКадидат = Элемент.ТекущиеДанные.ИмяПараметра;
		КонецЕсли;
		Элемент.ТекущиеДанные.ИмяПараметра = ОбщийМодульКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("ИмяПараметра",СокрЛП(ИмяКадидат)),Элементы.ДеревоЗапросов.ТекущиеДанные.ПараметрыЗапроса); //вПолучитьУникальноеИмяПараметра(СокрЛП(ИмяКадидат));
	КонецЕсли;
	сДоИзмененияИмяПараметра = Элемент.ТекущиеДанные.ИмяПараметра
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗапросовПараметрыЗапросаПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	Если Не Строка = Неопределено Тогда
		Строка 				= Элементы.ДеревоЗапросов.ТекущиеДанные.ПараметрыЗапроса.НайтиПоИдентификатору(Строка);
	КонецЕсли;	
	ПеретаскиваниеКлиент_Ei.ПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗапросовПараметрыЗапросаПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	ОО_ДобавлениеНового = Новый ОписаниеОповещения("ДеревоЗапросовПараметрыДобавлениеНового",ЭтаФорма);
	Если Не Строка = Неопределено Тогда
		Строка 				= Элементы.ДеревоЗапросов.ТекущиеДанные.ПараметрыЗапроса.НайтиПоИдентификатору(Строка);
	КонецЕсли;	
	ПеретаскиваниеКлиент_Ei.Перетаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле, ЭтаФорма, ОО_ДобавлениеНового);
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗапросовПараметрыДобавлениеНового(Результат, ДопПараметры) Экспорт
	НоваяСтрока 				= Элементы.ДеревоЗапросов.ТекущиеДанные.ПараметрыЗапроса.Добавить();
	НоваяСтрока.ИмяПараметра 	= ОбщийМодульКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("ИмяПараметра",СокрЛП(Результат.ИмяКадидат)),Элементы.ДеревоЗапросов.ТекущиеДанные.ПараметрыЗапроса);//вПолучитьУникальноеИмяПараметра(Результат.ИмяКандидат);
	ЗаполнитьЗначенияСвойств(НоваяСтрока,Результат);
КонецПроцедуры	


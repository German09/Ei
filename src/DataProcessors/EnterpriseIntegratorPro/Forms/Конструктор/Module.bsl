&НаКлиенте
Процедура ПараметрыВСписок(Команда)
	ТД = Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущиеДанные;
	Если НЕ ТД = Неопределено И Не ТД.ЭтоВыражение Тогда
		Если ТипЗнч(ТД.ЗначениеПараметра) = Тип("СписокЗначений") Тогда
			Для Каждого ЭлСЗ ИЗ ТД.ЗначениеПараметра Цикл
				ТД.ЗначениеПараметра = ЭлСЗ.Значение;
				Прервать;
			КонецЦикла;	
		Иначе	
			Список = Новый СписокЗначений;
			Список.Добавить(ТД.ЗначениеПараметра);
			ТД.ЗначениеПараметра = Список;
		КонецЕсли;
		ДеревоЗапросовПараметрыЗапросаПриИзменении(Неопределено);
	КонецЕсли;	
КонецПроцедуры


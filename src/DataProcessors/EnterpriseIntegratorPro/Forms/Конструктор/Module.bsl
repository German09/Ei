&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ОбновитьСтатистикуВыполнения" И ТипЗнч(Источник) = Тип("ДанныеФормыЭлементДерева") Тогда
		//этим событием пытаемся отобразить статистику выполнения обработок
		ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
		Если Не ТД = Неопределено  И Источник = ТД Тогда
			Если Элементы.ОтобразитьПоказателиПроцесса.Пометка Тогда
				Процессы_ГрафСхема = ПроцессыКлиент_Ei.ПолучитьВыполненнуюСхему(ТД,Элементы.ОтобразитьПоказателиПроцесса.Пометка);
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры


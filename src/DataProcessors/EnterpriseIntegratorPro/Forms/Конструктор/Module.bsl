&НаКлиенте
Процедура ОО_ДеревоЗапросовПередУдалением(Результат,Элемент) Экспорт
	Если Результат = КодВозвратаДиалога.ОК Тогда
		Родитель = Элемент.ТекущиеДанные.ПолучитьРодителя();
		Если Родитель = Неопределено Тогда
			//Это строка верхнего уровня
			Если ДеревоЗапросов.ПолучитьЭлементы().Количество() = 1 Тогда
				ПоказатьПредупреждение(,"Невозможно удалить последнюю строку",10);
				Возврат;
			Иначе	
				Родитель = ДеревоЗапросов;
			КонецЕсли;	
		КонецЕсли; 
		УдалитьРеквизитыДС(Элемент.ТекущаяСтрока);
		Родитель.ПолучитьЭлементы().Удалить(Элемент.ТекущиеДанные);
	КонецЕсли;	
КонецПроцедуры	


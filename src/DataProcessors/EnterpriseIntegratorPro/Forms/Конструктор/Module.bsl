		ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(РезультатЗапросаТД.Область(сИмяВыделеннойОбласти));  
		ПостроительЗапроса.Выполнить();
		Результат  								= ПостроительЗапроса.Результат.Выгрузить();

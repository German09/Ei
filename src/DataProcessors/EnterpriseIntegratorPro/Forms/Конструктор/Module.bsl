&НаСервере
Процедура ТДвТЗНаСервере(ДеревоЗапросовИД,сИмяВыделеннойОбласти)
	ТД = ДеревоЗапросов.НайтиПоИдентификатору(ДеревоЗапросовИД);
	Если Не ТД = Неопределено Тогда
		ПостроительЗапроса 		= Новый ПостроительЗапроса;
		ИмяОсновногоРеквизита	= "РезультатЗапросаТЗ";
		ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(РезультатЗапросаТД.Область(сИмяВыделеннойОбласти));  
		ПостроительЗапроса.Выполнить();
		Результат  								= ПостроительЗапроса.Результат.Выгрузить();
		ОбщийМодульКлиентСервер_Ei.ПроверитьПоказателиРезультата(ТД.ПоказателиРезультата);
		ТД.ПоказателиВыполнения.ВидРезультата	= ТипыКлиентСервер_Ei.Универсальные().ТаблицаЗначений;
	 	АдресКоллекции 							= ТД.ПоказателиРезультата.сооАдресовРезультатов.Получить(ТД.ПоказателиВыполнения.ВидРезультата);
		АдресКоллекции 							= ?(АдресКоллекции = Неопределено, УникальныйИдентификатор,АдресКоллекции);
		ТД.ПоказателиРезультата.сооАдресовРезультатов.Вставить(ТД.ПоказателиВыполнения.ВидРезультата,ПоместитьВоВременноеХранилище(Результат,АдресКоллекции));

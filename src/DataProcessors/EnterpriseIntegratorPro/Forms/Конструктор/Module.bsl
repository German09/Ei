Процедура ПриОткрытии(Отказ)
	чТекущаяСтрока = Неопределено;
	ОтладкаКлиент_Ei.Инициализировать(ЭтаФорма); 
	//ОбщийМодульКлиент_Ei.__ПриОткрытии(ЭтаФорма);
	вУстановитьЗаголовокФормы();
	ВариантыКлиент_Ei.Инициализировать(ЭтаФорма);
	РезультатыКлиент_Ei.Инициализировать(ЭтаФорма);
	Если Не ДеревоЗапросов.ПолучитьЭлементы().Количество() Тогда
		вСоздатьНовыйФайлЗапросов(Неопределено, Неопределено);
	ИначеЕсли ДеревоЗапросов.ПолучитьЭлементы().Количество() = 1 Тогда	
		Элементы.ДеревоЗапросов.Развернуть(ДеревоЗапросов.ПолучитьЭлементы()[0].ПолучитьИдентификатор());	
	КонецЕсли;
КонецПроцедуры


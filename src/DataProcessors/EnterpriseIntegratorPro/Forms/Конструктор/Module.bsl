&НаКлиенте
Функция ВычислитьМодифицированность(Сохранять = Истина) Экспорт
	ВариантыКлиент_Ei.ОбновитьВаринаты(ЭтаФорма,ДеревоЗапросов.ПолучитьЭлементы());
	Модифицированность 	= Не (СохраненныйОбраз = вПолучитьСохраняемыйОбраз());
	Если Модифицированность И Не ПустаяСтрока(ИмяФайлаНастройки) Тогда
		//сохраним данные консоли во временный файл
		Если Сохранять Тогда
			вСохранитьЗапросыВФайл(ПолучитьИмяВременногоФайлаНастройки(ИмяФайлаНастройки),Неопределено);
			ДатаИзменения		= ТекущаяДата(); //перенес сюда а то без условия постоянно менялась дата изменения
		КонецЕсли;	
	КонецЕсли;	
	//ДатаИзменения		= ТекущаяДата();
КонецФункции	

// Функция - Получает сохраненняемое прдставление текущего состояния дерева вариантов 
// 
// Возвращаемое значение:
//   - Строка. Сереализованное представление структурированного списка значений вариантов
//
&НаКлиенте
Функция вПолучитьСохраняемыйОбраз()
	сзВариантов = ПолучитьСписокВариантов(ДеревоЗапросов.ПолучитьЭлементы());
	Возврат ПолучитьПредставлениеСохраенногоОбраза(сзВариантов); //
КонецФункции

&НаКлиенте
Функция вПолучитьСохраненныйОбраз()
	Результат = вПрочитатьТекстИзФайла(ИмяФайлаНастройки);
	Если ЗначениеЗаполнено(Результат) Тогда
		Результат =  ПолучитьПредставлениеСохраенногоОбраза(Результат)	
	КонецЕсли;	
	Возврат Результат;
КонецФункции

// Функция - Получает представление сохраенного образа настройки который планируется сравнивать с текущим.
// ОБЪЯЗАТЕЛЬНО на сервере
//
// Параметры:
//  сВариантов	 - Строка или СписокЗначений	 -  Сериализованная строка списка или сам список
// 
// Возвращаемое значение:
//   -  Строка. Обработанное представление 
//
&НаСервереБезКонтекста
Функция ПолучитьПредставлениеСохраенногоОбраза(сВариантов)
	Если Не ТипЗнч(сВариантов) =  Тип("Строка") Тогда
		//передали объект его прогоним через сериализацию поскольку результат может меняться (сортировка в соотвесвии)
		сВариантов = ОбщийМодульВызовСервера_Ei.Сериализовать(сВариантов);
	КонецЕсли;	
	сзВариантов = ОбщийМодульВызовСервера_Ei.Структурировать(сВариантов,Новый СписокЗначений);
	УдалитьДанныеСтатистикиИзОбраза(сзВариантов);
	Возврат ОбщийМодульВызовСервера_Ei.Сериализовать(сзВариантов); 
КонецФункции

// Процедура - Удаляет данные статистики из образа, для более правильного вычисления модифицированности
//
// Параметры:
//  Коллекция	 - СписокЗначений	 -  Список вариантов
&НаСервереБезКонтекста
Процедура УдалитьДанныеСтатистикиИзОбраза(Коллекция)
	Если Не Коллекция = Неопределено Тогда
		Для Каждого Элемент Из Коллекция Цикл
			Элемент.Значение.Удалить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ИмяФайлаСтатистики());
			УдалитьДанныеСтатистикиИзОбраза(Элемент.Значение.Получить(""));
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры	


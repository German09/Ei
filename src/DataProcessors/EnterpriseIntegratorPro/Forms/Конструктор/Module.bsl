&НаКлиенте
Процедура ДеревоЗапросовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		Если Не Копирование Тогда
			ИмяКадидат = "Вариант";
		Иначе
			ИмяКадидат = Элемент.ТекущиеДанные.Запрос;
		КонецЕсли;
		Элемент.ТекущиеДанные.Запрос 		= ОбщийМодульКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("Запрос",СокрЛП(ИмяКадидат)),ДеревоЗапросов.ПолучитьЭлементы());
		Элемент.ТекущиеДанные.КлючНастроек	= Новый УникальныйИдентификатор;
	КонецЕсли;
	сДоИзмененияИмяЗапроса = Элемент.ТекущиеДанные.Запрос
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗапросовЗапросПриИзменении(Элемент)
	сПричина 		= "";
	сИмяЗапроса		= СтрЗаменить(Элементы.ДеревоЗапросов.ТекущиеДанные.Запрос," ","");
	Попытка 
		вр = Новый Структура;
		вр.Вставить(сИмяЗапроса);
	Исключение
		сПричина = "Имя '"+сИмяЗапроса+"' не соответствует правилу именования ключа структуры";
	КонецПопытки;
	Если Не ЗначениеЗаполнено(сПричина) Тогда
		ДублиСтрок = ОбщийМодульКлиентСервер_Ei.НайтиВКоллекцииДерева(Новый Структура("Запрос",сИмяЗапроса),ДеревоЗапросов.ПолучитьЭлементы());
		Если ДублиСтрок.Количество()> 1 Тогда
			сПричина = "Варинат с именем '"+сИмяЗапроса+"' уже существует";	
		КонецЕсли;	
	КонецЕсли;	
	Если ЗначениеЗаполнено(сПричина) Тогда
		Элементы.ДеревоЗапросов.ТекущиеДанные.Запрос = сДоИзмененияИмяЗапроса;
		ПоказатьПредупреждение(,сПричина,20,"Ошибка в имени варината");
	Иначе
		//без лишних пробелов
		Элементы.ДеревоЗапросов.ТекущиеДанные.Запрос = сИмяЗапроса;
	КонецЕсли;

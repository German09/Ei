// есть аналогичная только на клиенте ПараметрыКлиент_Ei.вДобавитьПараметр()
&НаСервере
Процедура вДобавитьПараметр(ПараметрЗапроса,ТД)
	СтрокиПараметров = ТД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",ПараметрЗапроса.Имя));
	Если Не СтрокиПараметров.Количество() Тогда
		СтрокаПараметров = ТД.ПараметрыЗапроса.Добавить();
		СтрокаПараметров.ИмяПараметра = ПараметрЗапроса.Имя;
	//Иначе
	//	СтрокаПараметров = СтрокиПараметров[0];	
	//КонецЕсли;	
		Если Не СтрокаПараметров.ЭтоВыражение Тогда
			ТипЗначения = ПараметрЗапроса.ТипЗначения; 
			Если ТипЗначения.СодержитТип(Тип("Тип")) Тогда //#СпецОбработкаТипа
				ТипЗначения =  Новый ОписаниеТипов("ОписаниеТипов");		
			КонецЕсли;	
			СтрокаПараметров.ЗначениеПараметра = ТипЗначения.ПривестиЗначение(СтрокаПараметров.ЗначениеПараметра);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
//Определяет дату начали и окончания в зависмости от положения строк относительно друг друга
//Параметры:
//	ТекущиеДанные - <СтрокаТаблицыЗначений>. Выделенная строка	
Функция вПолучитьСтруктуруПериода(ТекущиеДанные)
	СтрукПериода 	= Новый Структура("ДатаНачала,ДатаОкончания");
	ПЗ 				= Элементы.ДеревоЗапросов.ТекущиеДанные.ПараметрыЗапроса;
	Если ТипЗнч(ТекущиеДанные.ЗначениеПараметра) = Тип("Дата") Тогда
		ТекИндекс = ПЗ.Индекс(ТекущиеДанные);
		Если ТекИндекс > 0 И  ТипЗнч(ПЗ.Получить(ТекИндекс-1).ЗначениеПараметра) = Тип("Дата") Тогда
			СтрукПериода.ДатаНачала 	= ПЗ.Получить(ТекИндекс-1);
			СтрукПериода.ДатаОкончания	= ТекущиеДанные;
			Возврат СтрукПериода;
		ИначеЕсли ТекИндекс < ПЗ.Количество()-1 И  ТипЗнч(ПЗ.Получить(ТекИндекс+1).ЗначениеПараметра) = Тип("Дата") Тогда
			СтрукПериода.ДатаНачала 	= ТекущиеДанные;
			СтрукПериода.ДатаОкончания	= ПЗ.Получить(ТекИндекс+1);
			Возврат СтрукПериода;
		КонецЕсли;	
	КонецЕсли;	
КонецФункции


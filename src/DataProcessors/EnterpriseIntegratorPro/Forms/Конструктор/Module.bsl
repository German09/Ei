&НаКлиенте
Процедура РезультатЗапросаПриИзменении(Элемент)
	ТД = Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		ВставитьКоллекциюРезультата(ТД);
		ВариантыКлиент_Ei.ИзменитьПоказателиРезультата(ТД);
		ПодключитьОбработчикОжидания("ОО_ОбновитьЗаголовкиЗакладок",0.1,Истина);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура РезультатЗапросаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка 	= Ложь;
	ВыделенныеСтроки		= Новый Массив; //сформируем массив выделенных туда передаим только одну выбранную, конструкция еще используется в перетаскивании
	ВыделенныеСтроки.Добавить(ВыбраннаяСтрока);
	ЗначенияЯчеек 			= РезультатЗапросаТЗилиДЗПолучитьВыделенныеЯчейки(Элемент, ВыделенныеСтроки, Поле);   
	Если  ЗначенияЯчеек.Количество() Тогда
		ПоказатьЗначение(,ЗначенияЯчеек[0].Значение); //пока зываем всегда первое, список нет смысла показывать, поскольку из него всеравно ничегоне выборать
 	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РезультатЗапросаТЗилиДЗНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	ЗначенияЯчеек = РезультатЗапросаТЗилиДЗПолучитьВыделенныеЯчейки(Элемент, Элемент.ВыделенныеСтроки, Элемент.ТекущийЭлемент); 
	ПеретаскиваниеКлиент_Ei.НачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение, ЗначенияЯчеек)
КонецПроцедуры

&НаКлиенте
Функция РезультатЗапросаТЗилиДЗПолучитьВыделенныеЯчейки(Элемент, ВыделенныеСтроки, Поле)
	ВыделенноеСодержимое =  Новый СписокЗначений;
	Если ЗначениеЗаполнено(Поле.Заголовок) Тогда
		Для Каждого ИдСтроки ИЗ ВыделенныеСтроки Цикл
			Строка = ЭтаФорма[Элемент.Имя].НайтиПоИдентификатору(ИдСтроки);
			Если Не Строка = Неопределено Тогда
			    ВыделенноеСодержимое.Добавить(Строка[Поле.Заголовок]);		
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	Возврат ВыделенноеСодержимое; 
КонецФункции	


	ИмяФайлаНастройки 	= "";
	чТекущаяСтрока 		= Неопределено;
	вОчиститьЗначения();
	вУстановитьЗаголовокФормы();
	//мТекущаяСтрока = НеОпределено;
	//Если ТипЗнч(ВладелецФормы) = Тип("Форма") И ВладелецФормы.МетаданныеФормы = "Основная" И Не ВладелецФормы.МодальныйРежим Тогда
		//на режиме отладки не добавляем строку 
		//она добавляется позже при обновлени строки

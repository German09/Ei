#Область РаботаСДинСписком

&НаСервере
Процедура УдалитьРеквизитыДС(ДеревоЗапросовИД) Экспорт
	//TODO #10 переделать процедуру
	сИмяРеквизитаДинСписка 	= РезультатКлиентСервер_ДинСписок_Ei.ПолучитьИмяРеквизитаДинСписка(ДеревоЗапросовИД);
	ЭлДинСписка				= Элементы.Найти(сИмяРеквизитаДинСписка);
	Если Не ЭлДинСписка = Неопределено Тогда
		УдаляемыеРеквизиты	= Новый Массив;
		УдаляемыеРеквизиты.Добавить(сИмяРеквизитаДинСписка);
		ИзменитьРеквизиты(,УдаляемыеРеквизиты);
	    Элементы.Удалить(ЭлДинСписка);
	КонецЕСли;	
КонецПроцедуры


&НаСервереБезКонтекста
Процедура ДозаполнитьСтрокуДереваНаСервере(НоваяСтрока,Значение)
	НоваяСтрока.Имя		= НРег(НоваяСтрока.Представление);
	Если ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Значение,,"Значение");
		НовоеЗначение = Значение.Значение; 
	Иначе	
		НовоеЗначение = Значение;
	КонецЕсли;
	Попытка
		НоваяСтрока.Значение = НовоеЗначение;
	Исключение
		//этот тип недоступен на клиенте
		ОбщийМодульСерверПовтороноеИспользование_Ei.Значения().Вставить(НоваяСтрока.ПолучитьИдентификатор(),НовоеЗначение); 
		НоваяСтрока.КэшПредставление = Строка(ТипЗнч(НовоеЗначение));
	КонецПопытки;
Конецпроцедуры 

// Процедура - Добавляет специальные строки которые способствует дальнейшему разворачиванию дерева
//
// Параметры:
//  ПодСтрока	 - ЭлементКоллекцииДереваЗначений	 - Строка в которую планируеься добавлять специальные строки
//
&НаКлиенте
Процедура ПроверитьВозможностьСвойств(ПодСтрока)
	СвойстваВозможны = Ложь;
	Если вОписаниеТиповИмеетСвойства(ОписаниеТипов(ПодСтрока)) Тогда
		//добавим пустую строку чтобы можнобыло развернуть
		СвойстваВозможны = Истина;
	КонецЕсли;
	Если Не СвойстваВозможны Тогда
		Если ЗначениеЗаполнено(ПодСтрока.Ссылка) ИЛИ ЗначениеЗаполнено(ПодСтрока.КэшПредставление) Тогда
			//это ссылка на внутренее хранилищие посмотрим что там лежит
			ЗаполнитьСвойствамиСсылкиЗначения(ПодСтрока.ПолучитьИдентификатор(),СвойстваВозможны);
		КонецЕсли;	
	КонецЕсли;
	Если Не СвойстваВозможны Тогда
		СвойстваВозможны = ЭтоКоллекция(ПодСтрока);
	КонецЕсли;
	Если СвойстваВозможны Тогда
		Если Элементы.ДеревоЗначений.Развернут(ПодСтрока.ПолучитьИдентификатор()) Тогда
			Развернуть(ПодСтрока);
		Иначе	
			ПустаяПодСтрока	= ПодСтрока.ПолучитьЭлементы().Добавить();
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры


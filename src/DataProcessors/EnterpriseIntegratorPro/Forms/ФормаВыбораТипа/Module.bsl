//Функция получает список! типов которы возможно использовать в этой форме
//
Функция вПолучитСписокДоступныхТипов()
	СписокТипов	= Новый СписокЗначений;
	Если Параметры.ТекущиеДанные.ЭтоВыражение = Ложь Тогда
		//Значит нужно выбрать тип в противном случае только переменные
		СписокТипов.Добавить(Новый ОписаниеТипов("Число"),					"Число");
		СписокТипов.Добавить(Новый ОписаниеТипов("Строка"),					"Строка");
		СписокТипов.Добавить(Новый ОписаниеТипов("Дата"),					"Дата");
		СписокТипов.Добавить(Новый ОписаниеТипов("Булево"),					"Булево");
	    СписокТипов.Добавить(Новый ОписаниеТипов("СписокЗначений"),			"Список значений");
		СписокТипов.Добавить(Справочники.ТипВсеСсылки(),								"Справочники",				Истина);
		СписокТипов.Добавить(Перечисления.ТипВсеСсылки(),								"Перечисления",				Истина);
		СписокТипов.Добавить(Документы.ТипВсеСсылки(),									"Документы",				Истина);
		СписокТипов.Добавить(ПланыВидовХарактеристик.ТипВсеСсылки(),					"ПланыВидовХарактеристик",	Истина);
		СписокТипов.Добавить(ПланыСчетов.ТипВсеСсылки(),								"ПланыСчетов",				Истина);
		СписокТипов.Добавить(ПланыВидовРасчета.ТипВсеСсылки(),							"ПланыВидовРасчета",		Истина);
		СписокТипов.Добавить(ПланыОбмена.ТипВсеСсылки(),								"ПланыОбмена",				Истина);
		СписокТипов.Добавить(БизнесПроцессы.ТипВсеСсылки(),								"БизнесПроцессы",			Истина);
		отВнешнихИстоников = Новый ОписаниеТипов;
		Для Каждого ВнешнийИстоник ИЗ ВнешниеИсточникиДанных Цикл
			отВнешнихИстоников = Новый ОписаниеТипов(отВнешнихИстоников,ВнешнийИстоник.Таблицы.ТипВсеСсылки().Типы());		
		КонецЦикла;
		СписокТипов.Добавить(отВнешнихИстоников,										"ВнешниеИсточникиДанных",	Истина);
		//СписокТипов.Добавить(БизнесПроцессы.ТипВсеСсылкиТочекМаршрутаБизнесПроцессов(),	"ТочкиМаршрута",			Истина);
		СписокТипов.Добавить(Задачи.ТипВсеСсылки(),										"Задачи",					Истина);
	    СписокТипов.Добавить(Новый ОписаниеТипов("ОписаниеТипов"),			"Описание типов");
		СписокТипов.Добавить(Новый ОписаниеТипов("ВидДвиженияНакопления"),	"Вид движения накопления");
		СписокТипов.Добавить(Новый ОписаниеТипов("ВидДвиженияБухгалтерии"),	"Вид движения бухгалтерии");
		СписокТипов.Добавить(Новый ОписаниеТипов("ВидСчета"),				"Вид счета");
	Иначе
		Заголовок = "Выбор доступной переменной";
	КонецЕсли;	
	Возврат СписокТипов;
КонецФункции


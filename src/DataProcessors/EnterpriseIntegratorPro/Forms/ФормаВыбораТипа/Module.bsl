&НаКлиенте
Перем Переменные;
&НаКлиенте
Перем сооТипов;


//&НаКлиенте
//Перем СтруктураДопПараметров;   //Структура доп параметров (
//									//ТекущиеДанные				-<СтрокаТаблицыЗначений.Структура> Используется для определения значений - ЭтоВыражение,ИмяПараметра
//									//ДоступныеПеременные		-<Структура> Переменные, которые можно выбрать в текщем контексте
//									//ОграничениеТипа			-<ОписаниеТипов> Типы которые доступны для выбора в текущем контексте, учитываются и для переменных
//									//ЗапретитьВстроенныйЯзык   -<Неопределено> Если это свойство указано не открываем окно встроенного языка
									
////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбщийМодульСерверПовтороноеИспользование_Ei.Значения().Очистить();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодключитьОбработчикОжидания("ОО_ПослеОткрытия",0.1,Истина);
	Если Не ДеревоЗначений.ПолучитьЭлементы().Количество() Тогда
		вЗаполнитьДеревоДоступнымиПеременными();
		сооТипов.Очистить();
	КонецЕсли;	
	//Доступные типы 
	СписокТипов = вПолучитСписокДоступныхТипов();
	Для Каждого Тип  ИЗ СписокТипов Цикл
		Если вТипРазрешен(Тип.Значение) И Тип.Значение.типы().Количество() Тогда
			НоваяСтрока=ДеревоЗначений.ПолучитьЭлементы().Добавить();
			НоваяСтрока.Представление	= Тип.Представление;
			ОписаниеТипов(НоваяСтрока,Тип.Значение);
			Если  Тип.Пометка Тогда
				//добавлем подстроку чтобы можно было развернуть
				НоваяПодСтрока=НоваяСтрока.ПолучитьЭлементы().Добавить();
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	//ЭлементыФормы.Путь.КнопкаОткрытия	= Не  СтруктураДопПараметров.Свойство("ЗапретитьВстроенныйЯзык");
	//Если ЭлементыФормы.ДеревоЗначений.ТекущиеДанные = Неопределено Тогда
	//	//тут хорошобы активизировать единственный тип, но он известен только после разворота +	
	//КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОжиданий

&НаКлиенте
Процедура ОО_ПослеОткрытия()
	Если ОбщийМодульКлиент_Ei.ЗакрепитьФорму(ЭтаФорма,5) Тогда
		ОтключитьОбработчикОжидания("ОО_ПослеОткрытия");
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти
									
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ, ВЫЗЫВАЕМЫЕ ИЗ ЭЛЕМЕНТОВ РОДИТЕЛЯ ФОРМЫ

#Область ОбработчикиСобытийРодителя

&НаКлиенте
//Вызывается при начале выборе типа или значения
//Параметры:
//	Элемент					-<ЭлементУправления>. Элемент, в котором производим выбор
//	СтандартнаяОбработка    -<Булево>. признак испольлзования стандартной обработки
//
Процедура НачалоВыбора(Элемент, СтандартнаяОбработка, ИскатьВДоступныхПеременных = Истина) Экспорт
	Если ТипЗнч(Параметры.ТекущиеДанные.ЗначениеПараметра) = Тип("Неопределено") Тогда  // 
		СтандартнаяОбработка = Ложь;
		Открыть(); 
	Иначе
		Если Параметры.ТекущиеДанные.ЭтоВыражение Тогда
			СтандартнаяОбработка		= Ложь;
			//пытыемся найти выражение в окне выбора типа
			вОткрытьВыборВыражения(ИскатьВДоступныхПеременных);
		Иначе
			//ПРОВЕРКА НА ФАЙЛ
			Если ТипЗнч(Параметры.ТекущиеДанные.ЗначениеПараметра)=Тип("Строка") Тогда
				СтандартнаяОбработка	= Ложь;
				Длг 	= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
				Файл 	= Новый Файл(Параметры.ТекущиеДанные.ЗначениеПараметра);
				Если ЗначениеЗаполнено(Файл.ПолноеИмя) И Файл.Существует() Тогда
					Длг.ПолноеИмяФайла = Параметры.ТекущиеДанные.ЗначениеПараметра;
				Иначе
					//Длг.Каталог=ВосстановитьЗначение("КонсольЗапросов_ИмяПути");
				КонецЕсли;	
				Длг.Заголовок 	= "Выберите файл";
				Длг.Фильтр 		= "Все файлы (*.*)|*.*";
				Если Длг.Выбрать() Тогда
					Параметры.ТекущиеДанные.ЗначениеПараметра = Длг.ПолноеИмяФайла;
					ОповеститьОВыборе(Параметры.ТекущиеДанные);
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ДЕРЕВА ЗНАЧЕНИЙ

#Область ОбработчикиСобытийДерева

//Закрываем форму, а выбранное значение передаем в ТекущиеДанные
//
&НаКлиенте
Процедура ДеревоЗначенийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтрокаДЗ = ДеревоЗначений.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Не СтрокаДЗ = Неопределено Тогда
		Если Не Поле = Элементы.ДеревоЗначенийПредставление И ЗначениеЗаполнено(СтрокаДЗ.Значение) Тогда
			ПоказатьЗначение(,СтрокаДЗ.Значение);
		Иначе	
			Если вТипРазрешен(ОписаниеТипов(СтрокаДЗ)) Тогда
				Если Не СтрокаДЗ.Значение=Неопределено Тогда
					//выбрали доступную переменную
					Параметры.ТекущиеДанные.ЗначениеПараметра 	= вПолучитьПутьКПеременной(СтрокаДЗ);
					Параметры.ТекущиеДанные.ЭтоВыражение 		= Истина;
					ОповеститьОВыборе(Параметры.ТекущиеДанные);
				Иначе
					//просто выбрали тип
					Если ОписаниеТипов(СтрокаДЗ) <> Неопределено Тогда
						Если ОписаниеТипов(СтрокаДЗ).Типы().Количество() Тогда
							//ЭлементУправления.ОграничениеТипа 	= СтрокаДЗ.ОписаниеТипов;
							Параметры.ТекущиеДанные.ЗначениеПараметра 	= ОписаниеТипов(СтрокаДЗ).ПривестиЗначение();
							//ЭлементУправления.ВыбиратьТип 			= Ложь;
							Параметры.ТекущиеДанные.ЭтоВыражение		= Ложь;
							ОповеститьОВыборе(Параметры.ТекущиеДанные);
						КонецЕсли;	
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗначенийПередРазворачиванием(Элемент, Строка, Отказ)
	СтрокаДЗ = ДеревоЗначений.НайтиПоИдентификатору(Строка);
	Если Не СтрокаДЗ = Неопределено Тогда
		Развернуть(СтрокаДЗ);
	КонецЕсли;	
КонецПроцедуры

//Разрещаем копирование только введеных вручную,
//Создание новых только у тех и кого заполнено значение
&НаКлиенте
Процедура ДеревоЗначенийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если Копирование Тогда
		Отказ = Не Элемент.ТекущиеДанные.ВведенВручную;
	Иначе
		Отказ = (Элемент.ТекущиеДанные = Неопределено);
	КонецЕсли;	
КонецПроцедуры

//Разрешем редактирование только введенных вручную
&НаКлиенте
Процедура ДеревоЗначенийПередНачаломИзменения(Элемент, Отказ)
	Отказ = Не Элемент.ТекущиеДанные.ВведенВручную; 
КонецПроцедуры

//Устанавливаем признак ввода вручную
//
&НаКлиенте
Процедура ДеревоЗначенийПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.ВведенВручную = Истина;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗначенийПриАктивизацииСтроки(Элемент)
	Если ТипЗнч(Элемент.ТекущиеДанные) = Тип("ДанныеФормыЭлементДерева") Тогда
		//Если Не Элемент.ТекущиеДанные.Значение = Неопределено Тогда
			Путь	= вПолучитьПутьКПеременной(Элемент.ТекущиеДанные);
		//Иначе
		//	Путь	= "";
		//КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗначенийПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	Если Не ОтменаРедактирования Тогда
		Отказ = НеУдалосьВычислитьЗначениеСтроки(Элемент.ТекущиеДанные);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗначенийПредставлениеРегулирование(Элемент, Направление, СтандартнаяОбработка)
	СтандартнаяОбработка 	= Ложь;
	ТД  					= Элементы.ДеревоЗначений.ТекущиеДанные;
	Если Не ТД = Неопределено И Найти(ТД.Представление,"[") И ТД.ВведенВручную Тогда
		сПредставление  =  ТД.Представление;
		сЧисло 			=  СтрЗаменить(СтрЗаменить(сПредставление,"[",""),"]","");
		Попытка
			чЧисло = Макс(Число(сЧисло),0);	
		Исключение
			Возврат;
		КонецПопытки;	
		ТД.Представление = "["+Формат((чЧисло+Направление),"ЧН=0; ЧГ=")+"]";
		Если НеУдалосьВычислитьЗначениеСтроки(ТД) Тогда
			ТД.Представление = сПредставление;
		Иначе
			ДеревоЗначенийПриАктивизацииСтроки(Элементы.ДеревоЗначений);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры


#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

#Область ОбщегоНазначения

&НаКлиенте
//Производит заполнение дерева значений доступными переменными
//
Процедура вЗаполнитьДеревоДоступнымиПеременными()
	Если ТипЗнч(Параметры.ДоступныеСтруктуры) = Тип("Структура") Тогда
		Для Каждого ДоступнаяСтруктура Из  Параметры.ДоступныеСтруктуры Цикл
			НоваяСтрока = ДеревоЗначений.ПолучитьЭлементы().Добавить();
			НоваяСтрока.Представление	= ДоступнаяСтруктура.Ключ;
			ДозаполнитьСтрокуДерева(НоваяСтрока,ДоступнаяСтруктура.Значение);
			вРазвернутьСвойства(НоваяСтрока);
	 	КонецЦикла;	
	КонецЕсли;	
Конецпроцедуры

&НаКлиенте
//Процедура разворачивает свойства значения указанного в строке
//Параметры:
//	Строка 				-<СтрокаДереваЗначений>. Разворачиваемая строка
Процедура вРазвернутьСвойства(Строка)
	Если ЗначениеЗаполнено(Строка.Ссылка) ИЛИ ЗначениеЗаполнено(Строка.КэшПредставление) Тогда
		//это ссылка во внутренее хранилище
		//или
		//это значеие из Кеша сеанса, не все можно посместить во внутренее хранилище (не все сериализуетя)
		ЗаполнитьСвойствамиСсылкиЗначения(Строка.ПолучитьИдентификатор());
		Для Каждого ПодСтрока ИЗ Строка.ПолучитьЭлементы() Цикл
			ПроверитьВозможностьСвойств(ПодСтрока);	
		КонецЦикла;	
	ИначеЕсли 	ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки().СодержитТип(ТипЗнч(Строка.Значение)) И 
			Не ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки("Перечисления").СодержитТип(ТипЗнч(Строка.Значение))
		ИЛИ вЭтоТипОбъекта(ТипЗнч(Строка.Значение)) Тогда
		Для Каждого ЭлСписка ИЗ ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСвойстваОбъектаМетаданных(Строка.Значение,УникальныйИдентификатор) Цикл
			ПодСтрока=Строка.ПолучитьЭлементы().Добавить();
			ПодСтрока.Представление	= ЭлСписка.Представление;
			ДозаполнитьСтрокуДерева(ПодСтрока,ЭлСписка.Значение);
			ПроверитьВозможностьСвойств(ПодСтрока);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Строка.Значение) = Тип("Структура") Тогда
		Для Каждого Переменная ИЗ  Строка.Значение Цикл
			Если ТипЗнч(Переменная.Значение) = Тип("ФиксированнаяСтруктура") Тогда
				ЗначениеСвойства = Переменная.Значение;
			Иначе	
				ЗначениеСвойства = Новый ФиксированнаяСтруктура("ОписаниеТипов,Значение",ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(ТипЗнч(Переменная.Значение)),Переменная.Значение);
			КонецЕсли;	
			ПодСтрока = Строка.ПолучитьЭлементы().Добавить();
			ПодСтрока.Представление	= Переменная.Ключ;
			ДозаполнитьСтрокуДерева(ПодСтрока,ЗначениеСвойства);
			ПроверитьВозможностьСвойств(ПодСтрока);
		КонецЦикла;
	КонецЕсли;
	Если ЭтоКоллекция(Строка) Тогда
		СлужебныеДанные			= Новый Структура("Выражение",вПолучитьПутьКПеременной(Строка)+".Количество()");
		ЗаполнитьЗначенияСвойств(Переменные,Параметры.ДоступныеСтруктуры);
		Попытка
			МаксЭлКоллекции	= ОбщийМодульКлиент_Ei.__ВычислитьЗначение(СлужебныеДанные,Переменные.Параметры,Переменные.ЭтаФорма,Переменные.Объект,Переменные.ТекущиеДанные,Переменные.СтрокаТЧ);
		Исключение
			МаксЭлКоллекции = 0;
		КонецПопытки;
		Если МаксЭлКоллекции Тогда
			МаксЭлКоллекцииСтрока	= Строка.ПолучитьЭлементы().Добавить();
			МаксЭлКоллекцииСтрока.Представление = "["+Формат(МаксЭлКоллекции-1,"ЧН=0; ЧГ=")+"]";
			МаксЭлКоллекцииСтрока.ВведенВручную = Истина;
			Если НеУдалосьВычислитьЗначениеСтроки(МаксЭлКоллекцииСтрока) Тогда
				Строка.ПолучитьЭлементы().Удалить(МаксЭлКоллекцииСтрока);	
			Конецесли;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСвойствамиСсылкиЗначения(ДеревоТиповИД,СвойстваВозможны = Неопределено)
	ТД = ДеревоЗначений.НайтиПоИдентификатору(ДеревоТиповИД);
	Если Не ТД = Неопределено Тогда	
		Если ЭтоАдресВременногоХранилища(ТД.Ссылка) Тогда
			Значение 	= ПолучитьИзВременногоХранилища(ТД.Ссылка);
		Иначе
			Значение 	= ОбщийМодульСерверПовтороноеИспользование_Ei.Значения().Получить(ДеревоТиповИД);
		КонецЕсли;
		Если Не Значение =  Неопределено Тогда 
			cooСвойств	= ОбщийМодульКлиентСервер_Ei.ПолучитьСвойстваОбъекта(Значение,УникальныйИдентификатор);
			Если Не СвойстваВозможны = Неопределено Тогда
				Если ЭтоАдресВременногоХранилища(ТД.Ссылка) Тогда
					// это первое получение просто укажем тип и возможность свойств
					ТД.СсылкаПредставление = Строка(ТипЗнч(Значение));
				КонецЕсли;
			    СвойстваВозможны = Булево(cooСвойств.Количество());
			Иначе
				//это уже пытаемся развернуть ранее поименнованное представление ссылки
				Для каждого Свойство ИЗ cooСвойств Цикл
					ПодСтрока = ТД.ПолучитьЭлементы().Добавить();
					ПодСтрока.Представление	= Свойство.Ключ;
					ДозаполнитьСтрокуДереваНаСервере(ПодСтрока,Свойство.Значение);
				КонецЦикла;	
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ДозаполнитьСтрокуДерева(НоваяСтрока,Значение)
	НоваяСтрока.Имя		= НРег(НоваяСтрока.Представление);
	Если ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Значение);
		Если Значение.Свойство("ОписаниеТипов") Тогда
			ОписаниеТипов(НоваяСтрока,Значение.ОписаниеТипов);
		КонецЕсли;	
	Иначе	
		НоваяСтрока.Значение = Значение;
	КонецЕсли;

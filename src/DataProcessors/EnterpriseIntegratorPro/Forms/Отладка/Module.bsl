&НаКлиенте
//Функция добавляет событие в дерево отладки, и заполняет колонки
//Параметры:
//	Действие			- <Строка>. Действие которое вызвало отладку.
//	ТипСобытия			- <Строка>. Тип выполняемого действия.
//	Родитель			- <СтрокаДереваЗначений>. Родитель. если не указан определяем по пустому значению, дата окончания.
//Возвращаемое значение:
//	Добавленая строка ДЗ
Функция ДобавитьСобытие(Действие,ТипСобытия,Родитель,Сообщать=Истина) Экспорт
	//Если Не Объект.РежимОтладки И ВладелецФормы.Открыта() Тогда
	//	Если ТипЗнч(СобытиеБезОтладки) = Тип("ДанныеФормыЭлементДерева") Тогда
	//		НовоеСобытие = ?(СобытиеБезОтладки.Продолжительность,СобытиеБезОтладки,?(Родитель = Неопределено,СобытиеБезОтладки,Родитель).ПолучитьЭлементы().Добавить());
	//		НовоеСобытие.ПолучитьЭлементы().Очистить();
	//	Иначе
	//		НовоеСобытие = ?(Родитель = Неопределено,ДеревоСообщений,Родитель).ПолучитьЭлементы().Добавить();
	//		СобытиеБезОтладки 	= НовоеСобытие;
	//	КонецЕсли;	
	//Иначе	
		Если Не ТипЗнч(Родитель) = Тип("ДанныеФормыЭлементДерева") Тогда
			//определяем родителя в которого будем добавлять
			Если НеЗавершенныеСобытия.Количество() Тогда
				Родитель = НеЗавершенныеСобытия[0].Значение;
			Иначе
				Родитель = ДеревоСообщений;
			КонецЕсли;
		КонецЕсли;
		Если Родитель = ДеревоСообщений Тогда
			ВладелецОткрыт = ?(ВладелецФормы = Неопределено,Ложь,ВладелецФормы.Открыта()); //владельца может и не быть
			Если Не Объект.РежимОтладки И ВладелецОткрыт Тогда
				Родитель.ПолучитьЭлементы().Очистить();	
				//очистим все дерево отладки для того чтобы не путались другие сообщения, а то оно м,б. очень большим
			КонецЕсли;	
		КонецЕсли;	
		НовоеСобытие 				= Родитель.ПолучитьЭлементы().Добавить();
	//КонецЕсли;	
	НовоеСобытие.Действие			= Действие;
	НовоеСобытие.Тип				= ТипСобытия;
	НовоеСобытие.ДатаНачала			= ТекущаяУниверсальнаяДатаВМиллисекундах();
	НовоеСобытие.Продолжительность	= 0;
	НовоеСобытие.Сообщать			= Сообщать;
	НеЗавершенныеСобытия.Вставить(0,НовоеСобытие);
	
	//открываем форму 
	//ОбщийМодульКлиент_Ei.ОткрытьФормуОтладки(Неопределено);
	//ЭлементыФормы.ДеревоСообщений.ТекущаяСтрока=НовоеСобытие;
	Возврат НовоеСобытие;
КонецФункции	

&НаКлиенте
//Фиксирует факт завершения события
//Параметры:
//	Событие				-<СтрокаДереваЗначений>. Строка обозначающее событие
//  Статус				-<Строка>. Определяет как завершилось событие, Ошибка,Информация,БезСтатуса
//	СообщениеОбОшибке   -<Строка,ИнформацияОбОшибке>. Сообщение об ошибке или другая информация 
//
Процедура ЗавершитьСобытие(Событие,Статус, СообщениеОбОшибке) Экспорт
	//Событие = ?(Не Событие= Неопределено, Событие,СобытиеБезОтладки);
	//Если Не Событие = Неопределено Тогда //Объект.РежимОтладки ИЛИ НЕ ВладелецФормы.Открыта() Тогда
		Если ТипЗнч(СообщениеОбОшибке) = Тип("ИнформацияОбОшибке") Тогда
			стрСообщениеОбОшибке	= СообщениеОбОшибке.Описание;
			Статус					= ПеречисленияКлиентСерверПовторноеИспользование_Ei.ОтладкаСтатусСообщения().Ошибка;
			Если Не ТипЗнч(СоответствиеИнформацийОбОшибке) =  Тип("Соответствие") Тогда
				СоответствиеИнформацийОбОшибке = Новый Соответствие;
			КонецЕсли;	
			СоответствиеИнформацийОбОшибке.Вставить(Событие,СообщениеОбОшибке);
		Иначе
			стрСообщениеОбОшибке 	= СообщениеОбОшибке;
		КонецЕсли;
		Событие.Статус				= Статус;
		Событие.СообщениеОбОшибке	= СтрЗаменить(стрСообщениеОбОшибке,ПеречисленияКлиентСерверПовторноеИспользование_Ei.ОтладкаПризнакИсключения(),"");
		Событие.Продолжительность	= ТекущаяУниверсальнаяДатаВМиллисекундах()- Событие.ДатаНачала;
		
		НеЗавершенныеСобытие = НеЗавершенныеСобытия.НайтиПоЗначению(Событие);
		Если Не НеЗавершенныеСобытие = Неопределено Тогда 
			НеЗавершенныеСобытия.Удалить(НеЗавершенныеСобытие);
		КонецЕсли;	
		//ЭлементыФормы.ДеревоСообщений.Свернуть(Событие);
		//Если ФиксироватьВЖурнале 
		//	И Событие.Тип<>"Аутентификация" Тогда
		//	//определяем уровень
		//	УровеньЖурнала=УровеньЖурналаРегистрации.Информация;
		//	Если Статус="ОченьВажное" Тогда
		//		УровеньЖурнала=УровеньЖурналаРегистрации.Ошибка;		
		//	КонецЕсли;	
		//	//записываем событие.	
		//	ЗаписьЖурналаРегистрации("EI."+Событие.Тип,УровеньЖурнала, , ,
		//		Событие.Действие+?(ПустаяСтрока(СообщениеОбОшибке),"",Символы.ПС+СообщениеОбОшибке));
		//КонецЕсли;	
	//КонецЕсли;
	Если Событие.Сообщать И Не Найти(стрСообщениеОбОшибке,ПеречисленияКлиентСерверПовторноеИспользование_Ei.ОтладкаПризнакИсключения()) Тогда
		Если ТипЗнч(СообщениеОбОшибке) = Тип("ИнформацияОбОшибке") Тогда
			ОО 			= Новый ОписаниеОповещения("ОО_ОткрытьФормуОтладки",ОтладкаКлиент_Ei,Событие.ПолучитьИдентификатор());
			Пояснение 	= КраткоеПредставлениеОшибки(СообщениеОбОшибке);
			Если ЗначениеЗаполнено(Пояснение) Тогда
				ПоказатьОповещениеПользователя(СтрПолучитьСтроку(Событие.Действие,1),ОО,Пояснение,БиблиотекаКартинок.Отладка_Ei60);
			КонецЕсли;
		Иначе
			
		КонецЕсли;	
	КонецЕсли;	
Конецпроцедуры	


&НаКлиенте
Процедура ДеревоСообщенийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если ТипЗнч(СоответствиеИнформацийОбОшибке) =  Тип("Соответствие") Тогда
		ИнформацияОбошибке = СоответствиеИнформацийОбОшибке.Получить(Элемент.ТекущиеДанные);
		Если Не ИнформацияОбошибке = Неопределено Тогда
			ПоказатьИнформациюОбОшибке(ИнформацияОбошибке);
		Иначе
			Если Поле = Элементы.ДеревоСообщенийДействие Тогда
				ПоказатьЗначение(,Элемент.ТекущиеДанные.Действие);
			ИначеЕсли Поле = Элементы.ДеревоСообщенийСообщениеОбОшибке Тогда
				ПоказатьЗначение(,Элемент.ТекущиеДанные.СообщениеОбОшибке);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Перем СтрокаОбработки Экспорт; 		//Строка дерева доступных обработок, из которой открыта эта обработка (используется для сохранения)
&НаКлиенте
Перем СтруктураПеременных Экспорт;
//   - Структура данных возвращаемая процедурой ПолучитьСтруктуруПеременных из формы <Конструктор>
//		ТекущиеДанные
//			ИмяПараметра
//			ЗначениеПараметра
//			ЭтоВыражение
//			Идентификатор
//		ДоступныеСтруктуры
//			Параметры
//			ЭтаФорма - Структура
//				РезультатВыполнения
//				Варианты
//					<ИмяВарианта>
//						РезультатВыполнения - Фиксированная стрктура
//							ЭтоКоллекция -  Булево
//							ДополнениеПредставления - Строка
//							Ссылка - Строка - Адрес результата
//						Инструкции - Структура
//							Запрос - Строка
//							Алгоритм - Строка
//							СКД - Строка
//							Процессы - Строка
//						Параметры - Структура
//				История	- Массив-


#Область Обработки

&НаКлиенте
//Загружает текущую настройку
//
Процедура ЗагрузитьНастройку(Настройка,Интерактивно = Истина) Экспорт
	Если ТипЗнч(Настройка) = Тип("Структура") Тогда
		Если Настройка.Свойство("Вариант",Вариант) Тогда
				
		КонецЕсли;
		Если Настройка.Свойство("Тип",Тип) Тогда
			ОбновитьВозрЗначение();		
		КонецЕсли;
		Если Настройка.Свойство("ВозвращаемоеЗначение",ВозвращаемоеЗначение) Тогда
			
		КонецЕсли;
	КонецЕсли;
	Если Интерактивно И Не СтруктураПеременных =  Неопределено Тогда
		ДополнитьИменаВариантов(СтруктураПеременных.ДоступныеСтруктуры.ЭтаФорма.Варианты,Элементы.Варианты.СписокВыбора);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбработку(ОписаниеПотока,Настройка,ВозвращаемоеЗначение)
	Перем ПоказателиРезультата;
	ЗагрузитьНастройку(Настройка,Ложь);
	СтруктураВарианта = Неопределено;
	Если ОписаниеПотока.Контекст.ЭтаФорма.Варианты.Свойство(Вариант,СтруктураВарианта) Тогда
		ОбщийМодульКлиентСервер_Ei.ПроверитьПоказателиРезультата(ПоказателиРезультата);
		АдресРезультата = ВозвращаемоеЗначение.Ссылка;
		Если Тип =0 Тогда
			ОписаниеЗначения 	= ОбщийМодульКлиент_Ei.вВыполнитьЗапрос(СтруктураВарианта.Инструкции.Запрос,СтруктураВарианта.Параметры,АдресРезультата)
		ИначеЕсли Тип = 1 Тогда
			мсТипов 			= Новый Массив;
			мсТипов.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().РезультатЗапроса);
			мсТипов.Добавить(ВозвращаемоеЗначение);
			
			ОписаниеЗначения	= ОбщийМодульКлиент_Ei.__ВычислитьЗначение(СтруктураВарианта.Инструкции.Алгоритм,АдресРезультата,мсТипов,ОписаниеПотока.Контекст);
		ИначеЕсли Тип = 2 Тогда	
			ОбщийМодульКлиент_Ei.вВыполнитьСКД(СтруктураВарианта.Инструкции.СКД,СтруктураВарианта.Параметры,АдресРезультата,"ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений",Неопределено);
		ИначеЕсли Тип = 3 Тогда	
			
		КонецЕсли;	
		ПоказателиРезультата.сооАдресовРезультатов.Вставить(ОписаниеЗначения.ОписаниеТипов,ОписаниеЗначения.Ссылка);
		//получим теперь значение требуемого типа
		ОписаниеЗначения_Приведенное = ПоказателиРезультата.сооАдресовРезультатов.Получить(ВозвращаемоеЗначение);
		Если ОписаниеЗначения_Приведенное = Неопределено Тогда
			//значение не получаенно, попробуем привести то что есть
			ОписаниеЗначения_Приведенное = ПолучитьОписаниеРезультатаПриведенное(ПоказателиРезультата,ВозвращаемоеЗначение,АдресРезультата); //тут нужно передать ранее выданный адрес
		КонецЕсли;
		ВозвращаемоеЗначение = ОписаниеЗначения_Приведенное;
		//Контекст ЭтаФорма. остается прежним, обновляется только объект
		//ОписаниеПотока.Контекст.ЭтаФорма.Варианты[Вариант].РезультатВыполнения = ОписаниеЗначения_Приведенное;
	КонецЕсли;	
Конецпроцедуры

&НаКлиенте
Функция ПолучитьОписаниеВозврЗначения(Настройка,Контекст,ВозвращаемоеЗначение) Экспорт
	ЗагрузитьНастройку(Настройка,Ложь);
	Если ЗначениеЗаполнено(Вариант) Тогда
		СтруктураВарианта = Неопределено;
		Если Контекст.ЭтаФорма.Варианты.Свойство(Вариант,СтруктураВарианта) Тогда
			Возврат СтруктураВарианта.РезультатВыполнения;	
		КонецЕсли;
	КонецЕсли;	
КонецФункции 

&НаКлиенте
Функция СохранитьНастройкиОбработки()
	Настройка 				= ПолучитьНастройкуДляСохранения();
	Если Не Настройка = Неопределено Тогда	
		СтрокаОбработки.Настройка = Настройка;	
	КонецЕсли;
КонецФункции

#Область ОбработчикиОповещений

// Процедура - выполняющая обрботку, последовательный запуск производится из ПроцессыКлиент_Ei.ВыполнитьПереходКСледующейОбработке
//
// Параметры:
//  ОписаниеПотока	 - Структура 	- Структура формируемая процедурой "ВыполнитьПоток"
//										- сзВызовов 	- СписокЗначений 		- последовательность подготовленных ОписанийОповещений вызова обоработок, первой располагется следующая к запуску обработка
//										- ОО			- Описание оповещения   - обрабтный вызов из процедуры выполнения обработки, процедуры менеджера потоков
//										- Контекст  	- Структура  			- Аналог структуры "ДоступныеСтруктуры" из переменной формы СтруктураПеременных
//  ДопПараметры	- Структура		- Структура, доп. параметров
//										- Настройка 			- Структура - настройка экземпляра обработки получаемая функцией ПолучитьНастройкуДляСохранения()
//										- ВозвращаемоеЗначение 	- Структура - описание возврашаемого значения в который нужно поместить результат выполнения, своства структуры формируются функцией ОписаниеЗначенияВызовСервера_Ei.Получить()
//
&НаКлиенте
Процедура ОО_ВыполнитьОбработку(ОО_КСледующей,ДопПараметры) Экспорт
	Попытка
		ВыполнитьОбработку(ОО_КСледующей.ДополнительныеПараметры,ДопПараметры.Настройка,ДопПараметры.ВозвращаемоеЗначение);
	Исключение
		Инфо	=  ИнформацияОбОшибке();
		ВыполнитьОбработкуОповещения(ОО_КСледующей,Инфо); //Выполняется ПроцессыКлиент_Ei.ОО_ВыполнитьПереходКСледующейОбработке()	
		Возврат;
	КонецПопытки;
	ВыполнитьОбработкуОповещения(ОО_КСледующей); //Выполняется ПроцессыКлиент_Ei.ОО_ВыполнитьПереходКСледующейОбработке()	
Конецпроцедуры

#КонецОбласти


#КонецОбласти

// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	СтандартнаяОбработка 	= Ложь;
	СохранитьНастройкиОбработки();
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ТипПриИзменении(Элемент)
	ОбновитьВозрЗначение()
КонецПроцедуры

&НаКлиенте
Процедура ВариантыПриИзменении(Элемент)
	ОбновитьВозрЗначение()
КонецПроцедуры


#КонецОбласти

// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
#Область ВспомогательныеПроцедурыФункции

&НаКлиенте
Функция ПолучитьНастройкуДляСохранения()
	Результат = Новый Структура;
	Результат.Вставить("Вариант",				Вариант);
	Результат.Вставить("Тип",					Тип);
	Результат.Вставить("ВозвращаемоеЗначение",	ВозвращаемоеЗначение);
	Возврат Результат; 
КонецФункции

&НаКлиенте
Процедура ДополнитьИменаВариантов(Коллекция,СписокВыбора)
	Для Каждого Элемент ИЗ Коллекция Цикл
		СписокВыбора.Добавить(Элемент.Ключ);
	КонецЦикла;	
КонецПроцедуры	

Процедура ОбновитьВозрЗначение()
	Элементы.ВозвращаемоеЗначение.СписокВыбора.Очистить();
	Если Не Вариант = 3 Тогда
		Элементы.ВозвращаемоеЗначение.СписокВыбора.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТаблицаЗначений,"Таблица значений");		
		Элементы.ВозвращаемоеЗначение.СписокВыбора.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ДеревоЗначений,"Дерево значений");
	КонецЕсли;	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ПолучитьОписаниеРезультатаПриведенное(ПоказателиРезультата,СтрУниверсальныйТип,АдресКоллекции);
	Коллекция 			= ОбщийМодульВызовСервера_Ei.ПолучитьСохраненныйРезультат(ПоказателиРезультата,СтрУниверсальныйТип);
	Возврат  ОписаниеЗначенияВызовСервера_Ei.Подготовить(Коллекция,АдресКоллекции)
КонецФункции 


#КонецОбласти


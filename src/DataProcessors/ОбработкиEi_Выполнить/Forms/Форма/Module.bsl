// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
#Область ВспомогательныеПроцедурыФункции

#Область ВозвращаемоеЗначение

&НаКлиенте
Процедура ОбновитьПредставлениеВозврЗначения()
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ВозвращаемоеЗначение) Тогда
		Если ЗначениеЗаполнено(ВозвращаемоеЗначение.ПредставлениеЗначения) Тогда
			//значение сохранено в хранилище/кэше
			Описание = ВозвращаемоеЗначение.ПредставлениеЗначения;
		Иначе
			//это простое значение
			Описание = ТипЗнч(ВозвращаемоеЗначение.Значение);
		КонецЕсли;	
		Элементы.ВозвращаемоеЗначениеДекорация.Заголовок = "Возвр. значение: "+Описание;
	Иначе
		Элементы.ВозвращаемоеЗначениеДекорация.Заголовок = "Возвр. значение: "+ТипЗнч(ВозвращаемоеЗначение);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВозвращаемоеЗначениеДекорацияНажатие(Элемент)
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеНеопределенногоЗначения(ВозвращаемоеЗначение) Тогда
		стрТекДанных = Новый Структура("ИмяПараметра,ЗначениеПараметра,ЭтоВыражение",Неопределено,Неопределено,Ложь);
	Иначе	
		стрТекДанных = Новый Структура("ИмяПараметра,ЗначениеПараметра,ЭтоВыражение",Неопределено,"Результат",Истина);
		СтруктураПеременных.ДоступныеСтруктуры.Вставить("Результат",ВозвращаемоеЗначение);
	КонецЕсли;
	СтруктураПеременных.Вставить("ТекущиеДанные",стрТекДанных);
	
	ОО_ВыбораВозрЗначения = Новый ОписаниеОповещения("ВыборВозврЗначения",ЭтаФорма);
	ВыборКлиент_Ei.НачалоВыбора(ОО_ВыбораВозрЗначения,,ЭтаФорма,Элемент,СтруктураПеременных,Ложь,Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ВыборВозврЗначения(ВыбранноеЗначение, ДопПараметры) Экспорт
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ВыбранноеЗначение,"Значение") Тогда
		//параметр - значение
		//ожидаем возврата структуры текущих данных переданную в процедуре ВозвращаемоеЗначениеДекорацияНажатие() дополненную свойством "Значение" см. ВыборКлиент_Ei.ДеревоЗначенийВыбор()
	    ВозвращаемоеЗначение = ВыбранноеЗначение.Значение;
	Иначе
		//выбор типа
	    ВозвращаемоеЗначение = ОписаниеЗначенияВызовСервера_Ei.Подготовить(ВыбранноеЗначение.ЗначениеПараметра);
	КонецЕсли;
	ОбновитьПредставлениеВозврЗначения();
КонецПроцедуры	

&НаКлиенте
Процедура ВозвращаемоеЗначениеПоУмолчанию()
	ВозвращаемоеЗначение	= ОписаниеЗначенияВызовСервера_Ei.Подготовить(Неопределено,Новый УникальныйИдентификатор);	
КонецПроцедуры	

&НаКлиенте
Процедура ОчиститьВозрЗначение(Команда)
	ВозвращаемоеЗначениеПоУмолчанию();
	ОбновитьПредставлениеВозврЗначения();
	ВычислитьМодифицированность();
КонецПроцедуры

#КонецОбласти

// Рекурсивно дополняет имена вариантов, вствля их в поле выбора
// 
// Параметры:
//  Коллекция 		Коллекция вариантов 
//  СписокВыбора 	- СписокЗначений - Список выбора
&НаКлиенте
Процедура ДополнитьИменаВариантов(Коллекция,СписокВыбора)
	Для Каждого Элемент ИЗ Коллекция Цикл
		СписокВыбора.Добавить(Элемент.Ключ); // тут в качестве значения хорошо бы использовать Элемент.КлючНастроек но его нет в этой структуре
	КонецЦикла;	
КонецПроцедуры

// Дополнить тип варианта на основании возможных закладок их типов
&НаКлиенте
Процедура ДополнитьТипВарианта()
	Элементы.Тип.СписокВыбора.Очистить();
	Для Каждого ЭлВарианта ИЗ ВариантыКлиентПовторноеИспользование_Ei.ПолучитьВарианты() Цикл
		ОМ 	= ЭлВарианта.Значение;
		Элементы.Тип.СписокВыбора.Добавить(ЭлВарианта.Ключ,ОМ.Свойства().Синоним);	
	КонецЦикла;
КонецПроцедуры
	
&НаКлиенте
Процедура ДополнитьСписокТипаРезультата()
	Элементы.ВозвращаемоеЗначение.СписокВыбора.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТаблицаЗначений,"Таблица значений");		
	Элементы.ВозвращаемоеЗначение.СписокВыбора.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ДеревоЗначений,"Дерево значений");
	Элементы.ВозвращаемоеЗначение.СписокВыбора.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТабличныйДокумент,"Таб. док");	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ПолучитьОписаниеРезультатаПриведенное(ПоказателиРезультата,СтрУниверсальныйТип,АдресКоллекции);
	Коллекция 			= ОбщийМодульВызовСервера_Ei.ПолучитьСохраненныйРезультат(ПоказателиРезультата,СтрУниверсальныйТип);
	Возврат  ОписаниеЗначенияВызовСервера_Ei.Подготовить(Коллекция,АдресКоллекции)
КонецФункции 


#КонецОбласти



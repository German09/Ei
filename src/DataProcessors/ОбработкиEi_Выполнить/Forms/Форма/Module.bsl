		ИспВариант 		= ВариантыКлиентПовторноеИспользование_Ei.ПолучитьВарианты().Получить(Тип);
		АдресРезультата = ВозврЗначение.Ссылка;
		Если Не ИспВариант = Неопределено Тогда
			ДопПараметры =  Новый Структура("КонтекстВыполнения",ОписаниеПотока.Контекст);
			ДопПараметры.Вставить("ПоказателиРезультата",ПоказателиРезультата);
			ИспВариант.ВыполнитьВариант(Неопределено,АдресРезультата,СтруктураВарианта,СтруктураВарианта.Параметры,ДопПараметры);
		КонецЕсли;
			
//		
//		Если Тип = ВариантыКлиент_Ei.ИмяЭлементаЗапроса() Тогда
//			ОписаниеЗначения 	= ОбщийМодульКлиент_Ei.вВыполнитьЗапрос(СтруктураВарианта.Инструкции.Запрос,СтруктураВарианта.Параметры,АдресРезультата)
//		ИначеЕсли Тип = ВариантыКлиент_Ei.ИмяЭлементаАлгоритма() Тогда
//			мсТипов 			= Новый Массив;
//			мсТипов.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().РезультатЗапроса);
//			мсТипов.Добавить(РезультатТип);
//			
//			ОписаниеЗначения	= ОбщийМодульКлиентСервер_Ei.__ВычислитьЗначение(СтруктураВарианта.Инструкции.Алгоритм,АдресРезультата,мсТипов,ОписаниеПотока.Контекст);
//		ИначеЕсли Тип = ВариантыКлиент_Ei.ИмяЭлементаСКД() Тогда	
//			ОбщийМодульКлиент_Ei.вВыполнитьСКД(СтруктураВарианта.Инструкции.СКД,СтруктураВарианта.Параметры,АдресРезультата,"ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений",Неопределено);
//		ИначеЕсли Тип = ВариантыКлиент_Ei.ИмяЭлементаПроцесс() Тогда	
//			
//		КонецЕсли;	
//		ПоказателиРезультата.сооАдресовРезультатов.Вставить(ОписаниеЗначения.ОписаниеТипов,ОписаниеЗначения.Ссылка);
		//получим теперь значение требуемого типа
		ОписаниеЗначения_Приведенное = ПоказателиРезультата.сооАдресовРезультатов.Получить(РезультатТип);
		Если ОписаниеЗначения_Приведенное = Неопределено Тогда
			//значение не получаенно, попробуем привести то что есть
			ОписаниеЗначения_Приведенное = ПолучитьОписаниеРезультатаПриведенное(ПоказателиРезультата,РезультатТип,АдресРезультата); //тут нужно передать ранее выданный адрес
		КонецЕсли;

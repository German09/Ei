&НаКлиенте
Перем СтруктураПеременных Экспорт;
//   - Структура данных возвращаемая процедурой ПолучитьСтруктуруПеременных из формы <КонструкторПредставления>
//		ТекущиеДанные
//			ИмяПараметра
//			ЗначениеПараметра
//			ЭтоВыражение
//			Идентификатор
//		ДоступныеСтруктуры
//			Параметры
//			ЭтаФорма - Структура
//				РезультатВыполнения
//				Варианты
//					<ИмяВарианта>
//						РезультатВыполнения - Фиксированная стрктура
//							ЭтоКоллекция -  Булево
//							ДополнениеПредставления - Строка
//							Ссылка - Строка - Адрес результата
//						Инструкции - Структура
//							Запрос - Строка
//							Алгоритм - Строка
//							СКД - Строка
//							Процессы - Строка
//						Параметры - Структура
//				История	- Массив-


#Область Обработки

&НаКлиенте
//Загружает текущую настройку
//
Процедура ЗагрузитьНастройку(Настройка,ДополнятьИмена = Истина) Экспорт
	Если ТипЗнч(Настройка) = Тип("Структура") Тогда
		Если Настройка.Свойство("Вариант",Вариант) Тогда
			
		КонецЕсли;
		Если Настройка.Свойство("Тип",Тип) Тогда
			
		КонецЕсли;
		Если Настройка.Свойство("ВозвращаемоеЗначение",ВозвращаемоеЗначение) Тогда
			
		КонецЕсли;
	КонецЕсли;
	Если ДополнятьИмена Тогда
		ДополнитьИменаВариантов(СтруктураПеременных.ДоступныеСтруктуры.ЭтаФорма.Варианты,Элементы.Варианты.СписокВыбора);
	КонецЕсли;
КонецПроцедуры

// Процедура - выполняющая обрботку, последовательный запуск производится из ПроцессыКлиент_Ei.ВыполнитьПереходКСледующейОбработке
//
// Параметры:
//  ОписаниеПотока	 - Структура 	- Структура формируемая процедурой "ЗапуститьПотокВыполнения"
//										- мВызовов 	- Массив 				- последовательность подготовленных ОписанийОповещений вызова обоработок, первой располагется следующая к запуску обработка
//										- ОО		- Описание оповещения   - обрабтный вызов из процедуры выполнения обработки, процедуры менеджера потоков
//										- Контекст  - Структура  			-  Аналог структуры "ДоступныеСтруктуры" из переменной формы СтруктураПеременных
//  Настройка		 - Структура	- Структура настройки экземпляра обработки
//
&НаКлиенте
Процедура ВыполнитьОбработку(ОписаниеПотока,Настройка) Экспорт
	Перем ПоказателиРезультата;
	ЗагрузитьНастройку(Настройка,Ложь);
	СтруктураВарианта = Неопределено;
	Если ОписаниеПотока.Контекст.ЭтаФорма.Варианты.Свойство(Вариант,СтруктураВарианта) Тогда
		Если Тип =0 Тогда
			ОбщийМодульКлиентСервер_Ei.ПроверитьПоказателиРезультата(ПоказателиРезультата); 
			ПоказателиРезультата.сооАдресовРезультатов.Вставить(-1, ОбщийМодульКлиент_Ei.вВыполнитьЗапрос(СтруктураВарианта.Инструкции.Запрос,СтруктураВарианта.Параметры,УникальныйИдентификатор));
			СпособВыгрузки = 1;
			ВставитьАдресКоллекцииРезультата(ПоказателиРезультата,СпособВыгрузки,УникальныйИдентификатор);
			
			ОписаниеПотока.Контекст.ЭтаФорма.Варианты[Вариант].РезультатВыполнения = ОбщийМодульКлиентСервер_Ei.ПолучитьСтруктуруРезультата(ПоказателиРезультата.сооАдресовРезультатов.Получить(СпособВыгрузки));
		ИначеЕсли Тип = 1 Тогда
			Переменные			= Новый Структура("Параметры,ЭтаФорма,Объект,ТекущиеДанные,СтрокаТЧ",Неопределено,Неопределено,Неопределено,Неопределено,Неопределено,);
			ЗаполнитьЗначенияСвойств(Переменные,ОписаниеПотока.Контекст);

			мсТипов 		= Новый Массив;
			мсТипов.Добавить("QueryResult");
			мсТипов.Добавить("ValueTable");
			мсТипов.Добавить("ValueTree");
			СлужебныеДанные 		= Новый Структура("Выражение,ОписаниеТипов,УникальныйИдентификатор",СтруктураВарианта.Инструкции.Алгоритм,мсТипов,УникальныйИдентификатор);
			АдресРезультата			= ОбщийМодульКлиент_Ei.__ВычислитьЗначение(СлужебныеДанные,Переменные.Параметры,Переменные.ЭтаФорма,Переменные.Объект,Переменные.ТекущиеДанные,Переменные.СтрокаТЧ);
			
			ОписаниеПотока.Контекст.ЭтаФорма.Варианты[Вариант].РезультатВыполнения = ОбщийМодульКлиентСервер_Ei.ПолучитьСтруктуруРезультата(АдресРезультата.Значение);
		ИначеЕсли Тип = 2 Тогда	
			ОбщийМодульКлиент_Ei.вВыполнитьСКД(СтруктураВарианта.Инструкции.СКД,СтруктураВарианта.Параметры,УникальныйИдентификатор,"ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений",Неопределено);
		ИначеЕсли Тип = 3 Тогда	

		КонецЕсли;
	КонецЕсли;	
	//Объязательные условия перехода к следующей обработке
	ВыполнитьОбработкуОповещения(ОписаниеПотока.ОО,ОписаниеПотока);	
Конецпроцедуры

&НаКлиенте
Процедура ПолучитьОписаниеВозврЗначения(Настройка,Контекст) Экспорт
	ЗагрузитьНастройку(Настройка,Ложь);
	Если ЗначениеЗаполнено(Вариант) Тогда
		СтруктураВарианта = Неопределено;
		Если Контекст.ЭтаФорма.Варианты.Свойство(Вариант,СтруктураВарианта) Тогда
			
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры 

#КонецОбласти

// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	СтандартнаяОбработка 	= Ложь;
	ПараметрЗакрытия 		= ПолучитьНастройкуДляСохранения();
	Закрыть(ПараметрЗакрытия);
КонецПроцедуры

#КонецОбласти

// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
#Область ВспомогательныеПроцедурыФункции

&НаКлиенте
Функция ПолучитьНастройкуДляСохранения()
	Результат = Новый Структура;
	Результат.Вставить("Вариант",				Вариант);
	Результат.Вставить("Тип",					Тип);
	Результат.Вставить("ВозвращаемоеЗначение",	ВозвращаемоеЗначение);
	Возврат Результат; 
КонецФункции

&НаКлиенте
Процедура ДополнитьИменаВариантов(Коллекция,СписокВыбора)
	Для Каждого Элемент ИЗ Коллекция Цикл
		СписокВыбора.Добавить(Элемент.Ключ);
	КонецЦикла;	
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура ВставитьАдресКоллекцииРезультата(ПоказателиРезультата,СпособВыгрузки,АдресКоллекции);
	Коллекция = ОбщийМодульВызовСервера_Ei.ПолучитьСохраненныйРезультат(ПоказателиРезультата,СпособВыгрузки);
	ПоказателиРезультата.сооАдресовРезультатов.Вставить(СпособВыгрузки,ПоместитьВоВременноеХранилище(Коллекция,АдресКоллекции));
КонецПроцедуры 


#КонецОбласти



#Область Обработки

&НаКлиенте
//Загружает текущую настройку
//
Процедура ЗагрузитьНастройку(Настройка) Экспорт
	Если ТипЗнч(Настройка) = Тип("Структура") Тогда
		Если Настройка.Свойство("Вариант",Вариант) Тогда
			
		КонецЕсли;
		Если Настройка.Свойство("Тип",Тип) Тогда
			
		КонецЕсли;
		Если Настройка.Свойство("ВозвращаемоеЗначение",ВозвращаемоеЗначение) Тогда
			
		КонецЕсли;
	КонецЕсли;
	//СписокВыбора	= Новый СписокЗначений;
	//Пока через моджуль повтороного использования, потом конечно нужно будет переписать
	ДополнитьИменаВариантов(ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы().КонструкторПредставления.ДеревоЗапросов.ПолучитьЭлементы(),Элементы.Варианты.СписокВыбора);
	//Элементы.Варианты.СписокВыбора = СписокВыбора;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбработку(СтруктураВызова,Настройка) Экспорт
	
	Сообщить(Настройка.Вариант+" "+Настройка.Тип);
	
	//Объязательные условия перехода к следующей обработке
	ВыполнитьОбработкуОповещения(СтруктураВызова.ОО,СтруктураВызова);	
Конецпроцедуры
	

&НаКлиенте
Функция ПолучитьНастройкуДляСохранения()
	Результат = Новый Структура;
	Результат.Вставить("Вариант",				Вариант);
	Результат.Вставить("Тип",					Тип);
	Результат.Вставить("ВозвращаемоеЗначение",	ВозвращаемоеЗначение);
	Возврат Результат; 
КонецФункции

&НаКлиенте
Процедура ДополнитьИменаВариантов(Коллекция,СписокВыбора)
	Для Каждого Элемент ИЗ Коллекция Цикл
		СписокВыбора.Добавить(Элемент.Запрос);
		ДополнитьИменаВариантов(Элемент.ПолучитьЭлементы(),СписокВыбора)
	КонецЦикла;	
КонецПроцедуры	

#КонецОбласти

// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	СтандартнаяОбработка 	= Ложь;
	ПараметрЗакрытия 		= ПолучитьНастройкуДляСохранения();
	Закрыть(ПараметрЗакрытия);
КонецПроцедуры

#КонецОбласти

// Рекурсивно дополняет имена вариантов, вствля их в поле выбора
// 
// Параметры:
//  Коллекция 		Коллекция вариантов 
//  СписокВыбора 	- СписокЗначений - Список выбора
&НаКлиенте
Процедура ДополнитьИменаВариантов(Коллекция,СписокВыбора)
	Для Каждого Элемент ИЗ Коллекция Цикл
		СписокВыбора.Добавить(Элемент.Ключ); // тут в качестве значения хорошо бы использовать Элемент.КлючНастроек но его нет в этой структуре
	КонецЦикла;	
КонецПроцедуры

// Дополнить тип варианта на основании возможных закладок их типов
&НаКлиенте
Процедура ДополнитьТипВарианта()
	Элементы.Тип.СписокВыбора.Очистить();
	Для Каждого ЭлВарианта ИЗ ВариантыКлиентСерверПовторноеИспользование_Ei.ПолучитьВарианты() Цикл
		ОМ 	= ЭлВарианта.Значение;
		Элементы.Тип.СписокВыбора.Добавить(ЭлВарианта.Ключ,ОМ.Свойства().Синоним);	
	КонецЦикла;
КонецПроцедуры

#КонецОбласти



//ОБЪЯЗАТЕЛЬНЫЕ ЭКСПОРТНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
#Область ОбъязатленыеЭкспортныеПроцедуры

//Возврашает структуру, которая описывает,
//поведение обработки в рамках групповой обработки
Функция ПолучитьСвойстваОбработки() Экспорт
	СтруктураСвойств=Новый Структура;
	СтруктураСвойств.Вставить("Действие"				,1); 	//Действие при назначении обработки
		//0 	- обработку нельзя использовать в таблице выбраннх обработок те обработка не предназначена для пакетной обработки 
		//1  	- обработку необходимо настраивать 
		//2  	- обработка уже настроена ее нужнно просто добавить 
	//СтруктураСвойств.Вставить("сТипы"					,ПроводимыеДокументы());
	СтруктураСвойств.Вставить("Функция"					,Ложь); //обработка не возвращает значений
	//Капитан очевидность
	СтруктураСвойств.Вставить("Картинка18"				,Новый Картинка(ПолучитьМакет("Картинка18")));
	СтруктураСвойств.Вставить("ИспользоватьНастройки"	,(СтруктураСвойств.Действие=1));									
    СтруктураСвойств.Вставить("РекомендуемыеВложенные"	,Новый Массив);
	//СтруктураСвойств.Вставить("Настройка"				,ПолучитьСтруктуруНастроек());
	
	Возврат  СтруктураСвойств;
КонецФункции

Функция ОО_ВыполнитьОбработку(ОО_КСледующей, ДопПараметры) Экспорт
	ОписаниеПотока 	= ОО_КСледующей.ДополнительныеПараметры;
	Возврат ВыполнитьОбработку(ДопПараметры.Настройка,ОписаниеПотока,ДопПараметры.ВозвращаемоеЗначение);	
КонецФункции

#КонецОбласти

// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
#Область ВспомогательныеПроцедуры

Функция ВыполнитьОбработку(Настройка,ОписаниеПотока,ВозврЗначение)
	Перем ПоказателиРезультата;
	сооНастройка 	= ОбщийМодульВызовСервера_Ei.Структурировать(Настройка,Новый Соответствие);
	Вариант		 			= сооНастройка.Получить("Variant.xml");
	Тип		 				= сооНастройка.Получить("Type.xml");
	//ВозвращаемоеЗначение	= сооНастройка.Получить("Return.xml");
		
	//СтруктураВарианта = Неопределено;
	//Если ОписаниеПотока.Контекст.ЭтаФорма.Варианты.Свойство(Вариант,СтруктураВарианта) Тогда
	ОбщийМодульКлиентСервер_Ei.ПроверитьПоказателиРезультата(ПоказателиРезультата);
	//создать процедуру на сервере
	ИспВариант 		= ВариантыКлиентСерверПовторноеИспользование_Ei.ПолучитьВарианты().Получить(Тип);
	АдресРезультата = ВозврЗначение.Ссылка;
	Если Не ИспВариант = Неопределено Тогда
		ДопПараметры =  Новый Структура("КонтекстВыполнения",ОписаниеПотока.Контекст);
		ДопПараметры.Вставить("ПоказателиРезультата",ПоказателиРезультата);
		
		ИмяНабораДоВызова = НаборВариантовВызовСервера_Ei.ПолучитьТекущийНабор();
		Если Не ИмяНабораДоВызова = Вариант Тогда
			//обновим имя набора чтобы могли вычисляться вложенные параметры
			НаборВариантовВызовСервера_Ei.УстановитьТекущийНабор(Вариант);
		КонецЕсли;
			
		ОписаниеЗначения = ИспВариант.ВыполнитьВариант(Неопределено,АдресРезультата,Неопределено,ДопПараметры);
		
		Если Не ИмяНабораДоВызова = Вариант Тогда
			//Вернем обратно
			НаборВариантовВызовСервера_Ei.УстановитьТекущийНабор(ИмяНабораДоВызова);
		КонецЕсли;	
		
		Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ОписаниеЗначения) Тогда
			ДопПараметры.ПоказателиРезультата.сооАдресовРезультатов.Вставить(ОписаниеЗначения.ОписаниеТипов, ОписаниеЗначения);
		КонецЕсли;	
	КонецЕсли;
		
	Для Каждого Элемент ИЗ ПоказателиРезультата.сооАдресовРезультатов Цикл
		ВозврЗначение = Элемент.Значение;		
	КонецЦикла;	
	//КонецЕсли;			
КонецФункции


#КонецОбласти


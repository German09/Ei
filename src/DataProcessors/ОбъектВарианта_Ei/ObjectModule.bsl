
// Результат варианта: если его еще нет или он старше срока жизни, вариант выполняется сейчас.
//
// Параметры:
//  СрокЖизни - Число - сколько секунд результат считается актуальным, 0 - выполнить заново
//
Функция Результат(СрокЖизни = 1200) Экспорт
	Результат = ВариантыВызовСервера_Ei.Результат(ИмяНабора,ИмяВарианта,СрокЖизни);
	Возврат Результат;		
КонецФункции

Функция Данные() Экспорт
	Результат = ВариантыКлиентСервер_Ei.Данные(ИмяНабора,ИмяВарианта);
	Возврат Результат;	
КонецФункции

Функция Выполнить_(ЗаменПараметры = Неопределено) Экспорт 
	ОписаниеЗначения 	= ВариантыКлиентСервер_Ei.ВыполнитьВариант(ИмяНабора,ИмяВарианта,,,ЗаменПараметры);
	Результат 			= ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОписаниеЗначения);
	// Без идентификатора формы запрос кладет значение в кеш и возвращает его адрес, см. ВыполнитьКлиентСервер_Ei.ПослеВычисленияЗначения
	Если ОбщегоНазначенияВызовСервера_Ei.ЭтоАдресКешаЗначений(Результат) Тогда
		Результат = ОбщегоНазначенияВызовСервера_Ei.ПолучитьЗначениеИзКеша(Результат);
	КонецЕсли;
	Возврат Результат;	
КонецФункции			

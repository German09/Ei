// Заменитель результата запроса над его выгрузкой: результат запроса между сеансами не передается,
// поэтому запрос, выполненный в фоне, приходит таблицей значений. Чаще всего из результата берут таблицу,
// Выгрузить() отдает ее без преобразований, результат запроса собирается только для Выбрать().

#Область ОписаниеПеременных

Перем Выгрузка;
Перем Собранный;
// Как свойство Колонки у РезультатЗапроса: код вариантов обращается к нему так же
//@skip-check object-module-export-variable
Перем Колонки Экспорт;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Запоминает выгрузку результата запроса.
//
// Параметры:
//  Таблица - ТаблицаЗначений - выгрузка результата запроса
//
Процедура Заполнить_(Таблица) Экспорт
	Выгрузка 	= Таблица;
	Колонки 	= Таблица.Колонки;
КонецПроцедуры

// Аналог РезультатЗапроса.Выгрузить(). При прямом обходе отдает таблицу без преобразований.
//
// Параметры:
//  ТипОбхода - ОбходРезультатаЗапроса, Неопределено - по умолчанию прямой
//
// Возвращаемое значение:
//  ТаблицаЗначений, ДеревоЗначений - как у РезультатЗапроса.Выгрузить()
//
Функция Выгрузить(ТипОбхода = Неопределено) Экспорт
	Если ТипОбхода = Неопределено Или ТипОбхода = ОбходРезультатаЗапроса.Прямой Тогда
		Результат = Выгрузка;
	Иначе
		Результат = Собрать().Выгрузить(ТипОбхода);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Аналог РезультатЗапроса.Выбрать(). Результат запроса собирается из выгрузки при первом обращении, см. Собрать
//
// Параметры:
//  ТипОбхода - ОбходРезультатаЗапроса, Неопределено - по умолчанию прямой
//  Группировки - Строка, Неопределено - как у РезультатЗапроса.Выбрать()
//  ГруппировкиДляЗначенийГруппировок - Строка, Неопределено - как у РезультатЗапроса.Выбрать()
//
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса
//
Функция Выбрать(ТипОбхода = Неопределено, Группировки = Неопределено, ГруппировкиДляЗначенийГруппировок = Неопределено) Экспорт
	Обход = ?(ТипОбхода = Неопределено, ОбходРезультатаЗапроса.Прямой, ТипОбхода);
	Если Группировки = Неопределено Тогда
		Результат = Собрать().Выбрать(Обход);
	Иначе
		Результат = Собрать().Выбрать(Обход, Группировки, ГруппировкиДляЗначенийГруппировок);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Аналог РезультатЗапроса.Пустой().
//
// Возвращаемое значение:
//  Булево - Истина, если в выгрузке нет строк
//
Функция Пустой() Экспорт
	Возврат Выгрузка.Количество() = 0;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Собирает результат запроса через временную таблицу. Колонки без типа и только с типом Null в запрос из таблицы значений
// не попадают: "Тип не может быть выбран в запросе", их значения известны по типу, они добавляются константами.
// Вложенные таблицы так не собрать: остается ошибка платформы, Выгрузить() при этом работает.
//
Функция Собрать()
	Если Собранный = Неопределено Тогда
		ПоляТаблицы 	= Новый Массив;
		ПоляРезультата 	= Новый Массив;
		Для Каждого Колонка Из Выгрузка.Колонки Цикл
			ТипыКолонки = Колонка.ТипЗначения.Типы();
			Если ТипыКолонки.Количество() = 0 Тогда
				ПоляРезультата.Добавить("НЕОПРЕДЕЛЕНО КАК " + Колонка.Имя);
			ИначеЕсли ТипыКолонки.Количество() = 1 И ТипыКолонки.Найти(Тип("Null")) <> Неопределено Тогда
				ПоляРезультата.Добавить("NULL КАК " + Колонка.Имя);
			Иначе
				ПоляТаблицы.Добавить("Т." + Колонка.Имя + " КАК " + Колонка.Имя);
				ПоляРезультата.Добавить("Т." + Колонка.Имя + " КАК " + Колонка.Имя);
			КонецЕсли;
		КонецЦикла;
		ЗапросСборки 							= Новый Запрос;
		ЗапросСборки.МенеджерВременныхТаблиц 	= Новый МенеджерВременныхТаблиц;
		ЗапросСборки.Текст 						= "ВЫБРАТЬ " + СтрСоединить(ПоляТаблицы, ", ") + " ПОМЕСТИТЬ Т ИЗ &Выгрузка КАК Т;
			|ВЫБРАТЬ " + СтрСоединить(ПоляРезультата, ", ") + " ИЗ Т КАК Т";
		ЗапросСборки.УстановитьПараметр("Выгрузка", Выгрузка);
		Пакет 		= ЗапросСборки.ВыполнитьПакет();
		Собранный 	= Пакет[Пакет.ВГраница()];
		ЗапросСборки.МенеджерВременныхТаблиц.Закрыть();
	КонецЕсли;
	Возврат Собранный;
КонецФункции

#КонецОбласти

&НаКлиенте
Функция ПолучитьНастройкуДляСохранения()
	Результат = Новый Структура;
	Результат.Вставить("ТекстМодуля",	ТекстМодуля);
	Результат.Вставить("ВозвращаемоеЗначение",ВозвращаемоеЗначение);
	Возврат Результат; 
КонецФункции

&НаКлиенте
Процедура ОбновитьПредставлениеВозврЗначения()
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ВозвращаемоеЗначение) Тогда
		Элементы.ВозвращаемоеЗначениеДекорация.Заголовок = "Возвр. значение: "+ВозвращаемоеЗначение.ПредставлениеЗначения;	
	КонецЕсли;	
КонецПроцедуры	


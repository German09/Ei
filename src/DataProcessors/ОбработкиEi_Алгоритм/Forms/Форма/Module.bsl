#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	ВычислитьМодифицированность();
	Если Модифицированность Тогда
		Отказ = Истина;
		ПоказатьВопрос(Новый ОписаниеОповещения("вСохранить_Выбор",ЭтаФорма),"Сохранить текущие изменения?", РежимДиалогаВопрос.ДаНетОтмена);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ТипЗнч(ИсточникВыбора) = Тип("УправляемаяФорма") Тогда
		Если ИсточникВыбора.ИмяФормы = ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеФормы().ВыборТипа Тогда
			//это выбор параметра в форме выбора типа, Возникает при выборе возвращаемого значения или определенного типа
			Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ВыбранноеЗначение,"Значение") Тогда
				//параметр - значение
				//ожидаем возврата структуры текущих данных переданную в процедуре ВозвращаемоеЗначениеДекорацияНажатие() дополненную свойством "Значение" см. ВыборКлиент_Ei.ДеревоЗначенийВыбор()
			    ВозвращаемоеЗначение = ВыбранноеЗначение.Значение;
			Иначе
				//выбор типа
			    ВозвращаемоеЗначение = ОписаниеЗначенияВызовСервера_Ei.Подготовить(ВыбранноеЗначение.ЗначениеПараметра);
			КонецЕсли;
			ОбновитьПредставлениеВозврЗначения();
		КонецЕсли;		
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

// ПРОЦЕДУРЫ - ДЕЙСТВИЯ КОМАНДНЫХ ПАНЕЛЕЙ ФОРМЫ
#Область КомандныеПанелиФормы

&НаКлиенте
Процедура ДоступныеПеременные(Команда)
	ТекстМодуляКлиент_Ei.ПоказатьДоступныеПеременные(ЭтаФорма,Элементы.ПолеТекстМодуля,СтруктураПеременных);
КонецПроцедуры

#КонецОбласти

// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ПРОЧИХ РЕКВИЗИТОВ
#Область ПрочиеРеквизиты

&НаКлиенте
Процедура ПолеТекстМодуляПриИзменении(Элемент)
	ВычислитьМодифицированность();			
КонецПроцедуры

#КонецОбласти

// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
#Область ВспомогательныеПроцедурыФункции

#Область ВозвращаемоеЗначение

&НаКлиенте
Процедура ОбновитьПредставлениеВозврЗначения()
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ВозвращаемоеЗначение) Тогда
		Если ЗначениеЗаполнено(ВозвращаемоеЗначение.ПредставлениеЗначения) Тогда
			//значение сохранено в хранилище/кэше
			Описание = ВозвращаемоеЗначение.ПредставлениеЗначения;
		Иначе
			//это простое значение
			Описание = ТипЗнч(ВозвращаемоеЗначение.Значение);
		КонецЕсли;	
		Элементы.ВозвращаемоеЗначениеДекорация.Заголовок = "Возвр. значение: "+Описание;
	Иначе
		Элементы.ВозвращаемоеЗначениеДекорация.Заголовок = "Возвр. значение: "+ТипЗнч(ВозвращаемоеЗначение);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВозвращаемоеЗначениеДекорацияНажатие(Элемент)
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеНеопределенногоЗначения(ВозвращаемоеЗначение) Тогда
		стрТекДанных = Новый Структура("ИмяПараметра,ЗначениеПараметра,ЭтоВыражение",Неопределено,Неопределено,Ложь);
	Иначе	
		стрТекДанных = Новый Структура("ИмяПараметра,ЗначениеПараметра,ЭтоВыражение",Неопределено,"Результат",Истина);
		СтруктураПеременных.ДоступныеСтруктуры.Вставить("Результат",ВозвращаемоеЗначение);
	КонецЕсли;
	СтруктураПеременных.Вставить("ТекущиеДанные",стрТекДанных);
	ВыборКлиент_Ei.НачалоВыбора(ЭтаФорма,Элемент,СтруктураПеременных,Ложь,,Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ВозвращаемоеЗначениеПоУмолчанию()
	ВозвращаемоеЗначение	= ОписаниеЗначенияВызовСервера_Ei.Подготовить(Неопределено,Новый УникальныйИдентификатор);	
КонецПроцедуры	

&НаКлиенте
Процедура ОчиститьВозрЗначение(Команда)
	ВозвращаемоеЗначениеПоУмолчанию();
	ОбновитьПредставлениеВозврЗначения();
	ВычислитьМодифицированность();
КонецПроцедуры

#КонецОбласти

#КонецОбласти

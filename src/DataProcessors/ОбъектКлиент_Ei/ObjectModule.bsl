#Область ПрограммныйИнтерфейс

// История.
// 
// Параметры:
//  НавСсылка - Строка
// 
// Возвращаемое значение:
//  Неопределено, ЛюбаяСсылка - История
Функция История(НавСсылка) Экспорт
	Возврат БезопасноПолучитьСсылку(НавСсылка);
КонецФункции

// Избранное.
// 
// Параметры:
//  НавСсылка - Строка
// 
// Возвращаемое значение:
//  Неопределено, ЛюбаяСсылка - Избранное
Функция Избранное(НавСсылка) Экспорт
	Возврат БезопасноПолучитьСсылку(НавСсылка);
КонецФункции

// Формы.
// 
// Параметры:
//  УникальныйИдентификаторФормы - Строка
// 
// Возвращаемое значение:
//  ОбработкаОбъект.ОбъектКлиент_Ei - Формы
Функция Формы(УникальныйИдентификаторФормы) Экспорт
	УникальныйИдентификатор = УникальныйИдентификаторФормы;
	Возврат ЭтотОбъект;
КонецФункции

// Реквизиты.
// 
// Параметры:
//  ИмяРеквизита - Строка 
// 
// Возвращаемое значение:
// 	Произвольный 
Функция Реквизиты(ИмяРеквизита) Экспорт
	Перем Результат;
	Если Не ПустаяСтрока(УникальныйИдентификатор) Тогда //заполняется в см. Формы
		ОбщегоНазначенияВызовСервера_Ei.Реквизиты(УникальныйИдентификатор,Ложь).Свойство(ИмяРеквизита,Результат);	
	КонецЕсли;
	Возврат Результат;	
КонецФункции

#КонецОбласти


#Область СлужебныеПроцедурыИФункции
Функция БезопасноПолучитьСсылку(НавСсылка)
	Перем Результат;
	Попытка
		Результат = ОбщегоНазначенияПовтИсп_Ei.ПолучитьСсылкуИзНавСсылки(НавСсылка);;
	Исключение
		Результат = Неопределено
	КонецПопытки;		
	Возврат Результат;
КонецФункции
#КонецОбласти
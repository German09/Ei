#Область ОписаниеПеременных
&НаКлиенте
Перем НаследованиеФорм Экспорт; //см. НаследованиеФормКлиент_Ei.Инициализировать
#КонецОбласти 		//переменная используемая в фреймворке наследования форм, храняться формы от которых текущая форма заимствует поведение + форма в которую нужно передать далее свое поведение 

#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура ПриИзменении_ТаблицаФормы(Элемент) Экспорт
	ВариантКоллекцияКлиент_Ei.ПриИзменении(ПереопределитьФорму(), Элемент);
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Колонки(Команда)
	ВариантКоллекцияКлиент_Ei.ОткрытьСтруктуру(ПереопределитьФорму());
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	ВариантКоллекцияКлиент_Ei.Загрузить(ПереопределитьФорму()); //см. ВариантКоллекцияВызовСервера_Ei.ЗагрузитьКоллекцию
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьФайл(Команда)
	ВариантКоллекцияКлиент_Ei.ЗагрузитьФайл(ПереопределитьФорму());
КонецПроцедуры

&НаКлиенте
Процедура ТекущееЗначение(Команда)
	КоллекцияУстановитьКлиент_Ei.ТекущееЗначение(ПереопределитьФорму());
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьКолонку(Команда)
	ВариантКоллекцияКлиент_Ei.СкопироватьКолонку(ПереопределитьФорму());
КонецПроцедуры

&НаКлиенте
 Процедура ИзБуфера(Команда)
	ВариантКоллекцияКлиент_Ei.ИзБуфера(ПереопределитьФорму());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
#Область НаследованиеФорм

//@skip-check export-method-in-command-form-module
#Область Общие

&НаСервере
Функция СериализоватьФорму(ПутьРеквизитов) Экспорт 
	Возврат НаследованиеФормВызовСервера_Ei.Сериализовать(ЭтотОбъект,ПутьРеквизитов);	
КонецФункции

&НаСервере
Процедура ДополнитьФорму(ЭлементРодительИмя,АдресВоВременномХранилище,ЭлементКПИмя = Неопределено) Экспорт
	НаследованиеФормВызовСервера_Ei.Структурировать(ЭтотОбъект,ЭлементРодительИмя,АдресВоВременномХранилище,ЭлементКПИмя);		
КонецПроцедуры

&НаКлиенте
Функция ПереопределитьФорму()
	Возврат НаследованиеФормКлиент_Ei.Переопределить(НаследованиеФорм,ЭтотОбъект);	
Конецфункции	

#КонецОбласти

//@skip-check invocation-form-event-handler
#Область ПереопределениеСобытияФормыВызываемыхИзПотомка

&НаКлиенте
Процедура Команда(Команда) Экспорт
	Если СтрЗаканчиваетсяНа(нРег(Команда.Имя), нРег("Колонки")) Тогда
		Колонки(Команда);
	ИначеЕсли СтрЗаканчиваетсяНа(нРег(Команда.Имя), нРег("Загрузить")) Тогда
		Загрузить(Команда);
	ИначеЕсли СтрЗаканчиваетсяНа(нРег(Команда.Имя), нРег("ЗагрузитьФайл")) Тогда
		ЗагрузитьФайл(Команда);	
	ИначеЕсли СтрЗаканчиваетсяНа(нРег(Команда.Имя), нРег("ТекущееЗначение")) Тогда
		ТекущееЗначение(Команда);
	ИначеЕсли СтрЗаканчиваетсяНа(нРег(Команда.Имя), нРег("СкопироватьКолонку")) Тогда
		СкопироватьКолонку(Команда);
	ИначеЕсли СтрЗаканчиваетсяНа(нРег(Команда.Имя), нРег("ИзБуфера")) Тогда
		ИзБуфера(Команда);					
	КонецЕСли;	
КонецПроцедуры	

#КонецОбласти

#КонецОбласти
#КонецОбласти
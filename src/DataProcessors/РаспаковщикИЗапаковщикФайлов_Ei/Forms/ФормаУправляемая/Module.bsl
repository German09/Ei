
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьНаФорме();
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныйФайлПриИзменении(Элемент)
	ОбновитьНаФорме();
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныйФайлНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Фильтр = "Файлы 1C (*.epf;*.erf;*.cf;*.cfe;*.cfu;*.hbk;*.res;*.efd;*.dt;*.1CD;*.1CM)|*.epf;*.erf;*.cf;*.cfe;*.cfu;*.hbk;*.res;*.efd;*.dt;*.1CD;*.1CM";
	Диалог.ПредварительныйПросмотр = Ложь;
	Диалог.ПроверятьСуществованиеФайла = Истина;
	Если Диалог.Выбрать() Тогда
		Объект.ВыбранныйФайл = Диалог.ПолноеИмяФайла;
		п_Файл = Новый Файл(Объект.ВыбранныйФайл);
		Объект.КаталогРаспаковки = п_Файл.Путь + п_Файл.ИмяБезРасширения;
		Объект.НовыйФайл = п_Файл.Путь + п_Файл.ИмяБезРасширения + ?(Объект.НеСоздаватьКопию, "", "_зап") + п_Файл.Расширение;
	КонецЕсли;
	ОбновитьНаФорме();
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныйФайлОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	п_Файл = Новый Файл(Объект.ВыбранныйФайл);
	ЗапуститьПриложение(п_Файл.Путь);
КонецПроцедуры

&НаКлиенте
Процедура РаспаковатьФайл(Команда)
	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Файл = Новый Файл(Объект.ВыбранныйФайл);
	Если Не Файл.Существует() Тогда
		Сообщить("Файл """ + Объект.ВыбранныйФайл + """ не существует", СтатусСообщения.Внимание);
	Иначе
		РаспаковатьНаСервере();
	КонецЕсли;
	Если Объект.ЗамерВремени Тогда
		Сообщить(СтрШаблон("Файл распакован. Прошло времени: %1", ПолучитьПредставлениеВремени(ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт)));
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура РаспаковатьНаСервере()
	п_Объект = РеквизитФормыВЗначение("Объект");
	п_Объект.Распаковать();
	ЗначениеВРеквизитФормы(п_Объект, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВыбранныйФайл(Команда)
	АдресХранилища = "";
    Результат = ПоместитьФайл(АдресХранилища, Объект.ВыбранныйФайл, , Ложь);           
    ИмяОбработки = ПодключитьВнешнююОбработку(АдресХранилища);
    ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма");
КонецПроцедуры

&НаСервере
Функция ПодключитьВнешнююОбработку(АдресХранилища)
    Возврат ВнешниеОбработки.Подключить(АдресХранилища,,Ложь);
КонецФункции   

&НаКлиенте
Процедура ИзвлечьТекстовыйФорматПриИзменении(Элемент)
	ОбновитьНаФорме();
КонецПроцедуры

&НаКлиенте
Процедура КаталогРаспаковкиОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(Объект.КаталогРаспаковки);
КонецПроцедуры

&НаКлиенте
Процедура НовыйФайлОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	п_Файл = Новый Файл(Объект.НовыйФайл);
	ЗапуститьПриложение(п_Файл.Путь);
КонецПроцедуры

&НаКлиенте
Процедура СохранитьКонфигурациюИлиРасширениеКонфигурацииХранилищаПриИзменении(Элемент)
	ОбновитьНаФорме();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьОбъектыКонфигурацииИлиРасширенияКонфигурацииХранилищаПриИзменении(Элемент)
	ОбновитьНаФорме();
КонецПроцедуры

&НаКлиенте
Процедура ЗапаковатьФайл(Команда)
	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗапаковатьНаСервере();
	Если Объект.ЗамерВремени Тогда
		Сообщить(СтрШаблон("Файл запакован. Прошло времени: %1", ПолучитьПредставлениеВремени(ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт)));
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗапаковатьНаСервере()
	п_Объект = РеквизитФормыВЗначение("Объект");
	п_Объект.Запаковать();
	ЗначениеВРеквизитФормы(п_Объект, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНовыйФайл(Команда)
	АдресХранилища = "";
    Результат = ПоместитьФайл(АдресХранилища, Объект.НовыйФайл, , Ложь);           
    ИмяОбработки = ПодключитьВнешнююОбработку(АдресХранилища);
    ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма");
КонецПроцедуры

&НаКлиенте
Процедура НеСоздаватьКопиюПриИзменении(Элемент)
	п_Файл = Новый Файл(Объект.ВыбранныйФайл);
	Объект.НовыйФайл = п_Файл.Путь + п_Файл.ИмяБезРасширения + ?(Объект.НеСоздаватьКопию, "", "_зап") + п_Файл.Расширение;
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПредставлениеВремени(Миллисекунды) Экспорт
	ШестьДесят = 60;
	Тысяча = 1000;
	Часов = Цел(Миллисекунды / (ШестьДесят * ШестьДесят * Тысяча));
	Остаток = Миллисекунды - Часов * ШестьДесят * ШестьДесят * Тысяча;
	Минут = Цел(Остаток / (ШестьДесят * Тысяча));
	Остаток = Остаток - Минут * ШестьДесят * Тысяча;
	Секунд = Цел(Остаток / Тысяча);
	Миллисекунд = Остаток - Секунд * Тысяча;
	Возврат СтрШаблон("%1:%2:%3:%4" , Формат(Часов, "ЧЦ=3;ЧН=;ЧВН="), Формат(Минут, "ЧЦ=2;ЧН=;ЧВН="), Формат(Секунд, "ЧЦ=2;ЧН=;ЧВН="), Формат(Миллисекунд, "ЧЦ=3;ЧН=;ЧВН="));
КонецФункции

&НаСервере
Процедура ОбновитьНаФорме()
	п_Файл = Новый Файл(Объект.ВыбранныйФайл);
	Если п_Файл.Расширение = ".epf" ИЛИ п_Файл.Расширение = ".erf" Тогда
		Элементы.ОткрытьВыбранныйФайл.Видимость = Истина;
		Элементы.ОткрытьНовыйФайл.Видимость = Истина;
	Иначе
		Элементы.ОткрытьВыбранныйФайл.Видимость = Ложь;
		Элементы.ОткрытьНовыйФайл.Видимость = Ложь;
	КонецЕсли;
	Элементы.РаспаковатьФайл.Доступность = 
		п_Файл.Расширение = ".epf"
		ИЛИ п_Файл.Расширение = ".erf"
		ИЛИ п_Файл.Расширение = ".cf"
		ИЛИ п_Файл.Расширение = ".cfe"
		ИЛИ п_Файл.Расширение = ".cfu"
		ИЛИ п_Файл.Расширение = ".hbk"
		ИЛИ п_Файл.Расширение = ".res"
		ИЛИ п_Файл.Расширение = ".efd"
		ИЛИ п_Файл.Расширение = ".dt"
		ИЛИ п_Файл.Расширение = ".1CD"
		ИЛИ п_Файл.Расширение = ".1CM";
	Элементы.ИзвлечьТекстовыйФормат.Видимость = 
		п_Файл.Расширение = ".dt";
	Элементы.СохранитьКонфигурациюБазыДанных.Видимость = 
		п_Файл.Расширение = ".dt"
		ИЛИ п_Файл.Расширение = ".1CD"
		ИЛИ п_Файл.Расширение = ".1CM";
	Элементы.СохранитьОсновнуюКонфигурацию.Видимость = 
		п_Файл.Расширение = ".dt"
		ИЛИ п_Файл.Расширение = ".1CD"
		ИЛИ п_Файл.Расширение = ".1CM";
	Элементы.СохранитьКонфигурацииПоставщиковБазаДанных.Видимость = 
		п_Файл.Расширение = ".dt"
		ИЛИ п_Файл.Расширение = ".1CD"
		ИЛИ п_Файл.Расширение = ".1CM";
	Элементы.СохранитьКонфигурацииПоставщиковОсновная.Видимость = 
		п_Файл.Расширение = ".cf"
		ИЛИ п_Файл.Расширение = ".dt"
		ИЛИ п_Файл.Расширение = ".1CD"
		ИЛИ п_Файл.Расширение = ".1CM";
	Элементы.СохранитьРасширенияКонфигурацииБазаДанных.Видимость = 
		п_Файл.Расширение = ".1CD"
		ИЛИ п_Файл.Расширение = ".dt"
		ИЛИ п_Файл.Расширение = ".1CM";
	Элементы.СохранитьРасширенияКонфигурацииОсновная.Видимость = 
		п_Файл.Расширение = ".1CD"
		ИЛИ п_Файл.Расширение = ".dt"
		ИЛИ п_Файл.Расширение = ".1CM";
	Элементы.СохранитьКонфигурациюИлиРасширениеКонфигурацииХранилища.Видимость = 
		п_Файл.Расширение = ".1CD";
	Элементы.ВерсияВХранилище.Видимость =
		п_Файл.Расширение = ".1CD";
	Элементы.СохранитьОбъектыКонфигурацииИлиРасширенияКонфигурацииХранилища.Видимость = 
		НЕ Объект.СохранитьКонфигурациюИлиРасширениеКонфигурацииХранилища
		И п_Файл.Расширение = ".1CD";
	Элементы.ВерсияВХранилищеС.Видимость =
		НЕ Объект.СохранитьКонфигурациюИлиРасширениеКонфигурацииХранилища
		И п_Файл.Расширение = ".1CD";
	Элементы.ВерсияВХранилищеПо.Видимость =
		НЕ Объект.СохранитьКонфигурациюИлиРасширениеКонфигурацииХранилища
		И п_Файл.Расширение = ".1CD";
	Элементы.КонвертироватьВСтарыйФормат.Видимость = 
		п_Файл.Расширение = ".cf";
	Элементы.ЗапаковатьФайл.Доступность = 
		п_Файл.Расширение = ".epf"
		ИЛИ п_Файл.Расширение = ".erf"
		ИЛИ п_Файл.Расширение = ".cf"
		ИЛИ п_Файл.Расширение = ".cfe"
		ИЛИ п_Файл.Расширение = ".cfu"
		ИЛИ п_Файл.Расширение = ".hbk";
		
	п_Объект = РеквизитФормыВЗначение("Объект");
	Результат = п_Объект.СведенияОВнешнейОбработке();
	ЗначениеВРеквизитФормы(п_Объект, "Объект");
	
	п_СистемнаяИнформация = Новый СистемнаяИнформация;
	п_ВерсияПлатформы = п_СистемнаяИнформация.ВерсияПриложения;
	п_Разрядность = СтрРазделить(НРег(п_СистемнаяИнформация.ТипПлатформы), " ", Ложь);
	п_РазрядностьПлатформы = п_Разрядность[п_Разрядность.ВГраница()];
	Элементы.ДекорацияВерсия.Заголовок = СтрШаблон("инструмент: %1, платформа: %2 %3", Результат.Версия, п_ВерсияПлатформы, п_РазрядностьПлатформы);
	
КонецПроцедуры

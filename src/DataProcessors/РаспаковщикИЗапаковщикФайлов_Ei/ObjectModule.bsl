													Если СтрокаДерева.Строки[1].Тип = п_Тип_Строка И СтрокаДерева.Строки[2].Тип = п_Тип_Base64 Тогда
														п_ЧислоФайлов = Число(СтрокаДерева.Строки[0].Значение);
														Смещение = 1;
														Для Сч = 1 По п_ЧислоФайлов Цикл
															п_НовыйФайлОписания = п_НовыйКаталогРасширения + "\" + СтрокаДерева.Строки[Смещение].Значение;
															Смещение = Смещение + 1;
															п_ФайлОписания = п_Параметры.Каталог + "\" + "ConfigCASSave" + "\" + ПолучитьHexСтрокуИзДвоичныхДанных(Base64Значение(СтрокаДерева.Строки[Смещение].Значение));
															Смещение = Смещение + 1;
															Если ФайлСуществует(п_ФайлОписания) Тогда
																п_СжатыйФайлОписания = ДефлэйтИзФайлаВДвоичныеДанныеЧерезЗаписьZipФайла(п_ФайлОписания);
																п_ЧтениеПотока = Новый ЧтениеДанных(п_СжатыйФайлОписания, КодировкаТекста.ANSI, ПорядокБайтов.LittleEndian);
																п_БуферДД = п_ЧтениеПотока.ПрочитатьВБуферДвоичныхДанных();
																ПотокФайлаВПамяти = Новый ПотокВПамяти(п_БуферДД);
																п_ЧтениеПотока.Закрыть();
																ПотокФайла = Новый ФайловыйПоток(п_НовыйФайлОписания, РежимОткрытияФайла.Создать, ДоступКФайлу.Запись);
																ПотокФайлаВПамяти.КопироватьВ(ПотокФайла);
																ПотокФайла.Закрыть();
																ПотокФайлаВПамяти.Закрыть();
															КонецЕсли;
														КонецЦикла;
													КонецЕсли;
												КонецЕсли;
											КонецЦикла;
											п_НайденныеФайлы = НайтиФайлы(п_Параметры.Каталог + "\" + "ConfigCASSave", п_ИдентификаторСсылки + "__*");
											Для Каждого п_Файл Из п_НайденныеФайлы Цикл
												Если п_Файл.Имя <> п_ИдентификаторСсылки + "__configinfo" Тогда
													п_СжатыйФайлОписания = ДефлэйтИзФайлаВДвоичныеДанныеЧерезЗаписьZipФайла(п_Файл.ПолноеИмя);
													п_ЧтениеПотока = Новый ЧтениеДанных(п_СжатыйФайлОписания, КодировкаТекста.ANSI, ПорядокБайтов.LittleEndian);
													п_БуферДД = п_ЧтениеПотока.ПрочитатьВБуферДвоичныхДанных();
													ПотокФайлаВПамяти = Новый ПотокВПамяти(п_БуферДД);
													п_ЧтениеПотока.Закрыть();
													п_НовыйФайлОписания = п_НовыйКаталогРасширения + "\" + Сред(п_Файл.Имя, Найти(п_Файл.Имя, "__") + 2);
													ПотокФайла = Новый ФайловыйПоток(п_НовыйФайлОписания, РежимОткрытияФайла.Создать, ДоступКФайлу.Запись);
													ПотокФайлаВПамяти.КопироватьВ(ПотокФайла);
													ПотокФайла.Закрыть();
													ПотокФайлаВПамяти.Закрыть();
												КонецЕсли;
											КонецЦикла;
											п_ПараметрыСборки = НовыйПараметрыСборки();
											п_ПараметрыСборки.КаталогИсточник = п_НовыйКаталогРасширения;
											п_ПараметрыСборки.ИмяЦелевогоФайла = п_Параметры.ДополнительныйКаталог + "\" + "РасширениеКонфигурации" + п_ИмяРасширения + ".cfe";
											п_ПараметрыСборки.РасширениеЦелевогоФайла = ".cfe";
											п_ПараметрыСборки.Дефлэйт = Ложь;
											СформироватьКонтейнер(п_ПараметрыСборки);
										КонецЕсли;
									КонецЕсли;
									
								КонецЦикла;
								
								Прервать;
								
							Иначе
								
								Прервать;
								
							КонецЕсли;
							
						КонецЦикла;
						
					КонецЕсли;
					
					Прервать;
					
				Иначе
					
					Прервать;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		п_ЧтениеДанныхDT.Закрыть();
		
		УдалитьФайлы(п_ПолноеИмяДанныхФайлаDT);
		
	Иначе
		
		ВызватьИсключение "Эта версия БД не поддерживается: " + Символ(п_КодВерсии);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура РаспаковатьФайл1CD(п_Параметры)
	
	Перем Дерево2, Дерево3;
	
	ПотокКонтейнера = ФайловыеПотоки.ОткрытьДляЧтения(п_Параметры.Файл);
	
	п_СтруктураБазы = Новый Структура;
	п_СтруктураБазы.Вставить("РазмерФайлаВБайтах", п_Параметры.РазмерФайла);
	п_СтруктураБазы.Вставить("РазмерСтраницы", 4096);
	п_СтруктураБазы.Вставить("НулевойБлокДамп", ПолучитьСтраницыПоНомеру(п_СтруктураБазы, ПотокКонтейнера, 0));
	
	л_Структура = Новый Структура;
	л_Структура.Вставить("Сигнатура", ПолучитьДанныеИзБуфера(п_СтруктураБазы.НулевойБлокДамп, п_Тип_Строка, 0, 8));
	хБуфер = п_СтруктураБазы.НулевойБлокДамп.Прочитать(8, 4);
	л_Структура.Вставить("Версия1", Формат(хБуфер[0], "ЧН=0; ЧГ=0"));
	л_Структура.Вставить("Версия2", Формат(хБуфер[1], "ЧН=0; ЧГ=0"));
	л_Структура.Вставить("Версия3", Формат(хБуфер[2], "ЧН=0; ЧГ=0"));
	л_Структура.Вставить("Версия4", Формат(хБуфер[3], "ЧН=0; ЧГ=0"));
	п_СтруктураБазы.Вставить("Версия", СтрШаблон("%1.%2.%3.%4", л_Структура.Версия1, л_Структура.Версия2, л_Структура.Версия3, л_Структура.Версия4));
	
	Если п_СтруктураБазы.Версия <> "8.0.3.0"
		И п_СтруктураБазы.Версия <> "8.0.5.0"
		И п_СтруктураБазы.Версия <> "8.1.0.0"
		И п_СтруктураБазы.Версия <> "8.2.0.0"
		И п_СтруктураБазы.Версия <> "8.2.14.0"
		И п_СтруктураБазы.Версия <> "8.3.8.0" Тогда
		ВызватьИсключение "Эта версия БД не поддерживается: " + п_СтруктураБазы.Версия;
	КонецЕсли;
	
	п_СтруктураБазы.Вставить("РазмерБазыВБлоках", п_СтруктураБазы.НулевойБлокДамп.ПрочитатьЦелое32(12));
	п_СтруктураБазы.Вставить("НулевойБлок", л_Структура);
	
	Если п_СтруктураБазы.Версия = "8.3.8.0" Тогда
		п_СтруктураБазы.Вставить("РазмерСтраницы", п_СтруктураБазы.НулевойБлокДамп.ПрочитатьЦелое32(20));
	КонецЕсли;
	
	//п_СтруктураБазы.Вставить("БлокСвободныхСтраниц", ПолучитьБлокСвободныхСтраниц());
	//ЗаполнитьСтруктурыБДПоБлокуСвободныхСтраниц();
	
	Если п_СтруктураБазы.Версия = "8.0.3.0"
		ИЛИ п_СтруктураБазы.Версия = "8.0.5.0"
		ИЛИ п_СтруктураБазы.Версия = "8.1.0.0"
		ИЛИ п_СтруктураБазы.Версия = "8.2.0.0"
		ИЛИ п_СтруктураБазы.Версия = "8.2.14.0" Тогда
		л_Структура = ПолучитьСтруктуруФайлаБазыПоНомеруСтраницыЗаголовка(п_СтруктураБазы, ПотокКонтейнера, 2);
	ИначеЕсли п_СтруктураБазы.Версия = "8.3.8.0" Тогда
		л_Структура = ПолучитьСтруктуруФайлаБазыПоНомеруСтраницыЗаголовкаТипТаблицыРазмещения1(п_СтруктураБазы, ПотокКонтейнера, 2);
	КонецЕсли;
	
	л_Структура.Данные = ПолучитьСодержимоеФайлаБазыПоСтруктуре(п_СтруктураБазы, ПотокКонтейнера, л_Структура);
	п_СтруктураБазы.Вставить("КорневойБлок", л_Структура);
	
	Если п_СтруктураБазы.Версия = "8.0.3.0"
		ИЛИ п_СтруктураБазы.Версия = "8.0.5.0" Тогда
		п_СтруктураБазы.Вставить("КодЯзыкаБазы", СокрЛП(ПолучитьДанныеИзБуфера(п_СтруктураБазы.КорневойБлок.Данные, п_Тип_Строка, 0, 8)));
		п_СтруктураБазы.Вставить("РазмерКодаЯзыкаБазы", 8);
		п_СтруктураБазы.Вставить("КоличествоТаблицВБазе", п_СтруктураБазы.КорневойБлок.Данные.ПрочитатьЦелое32(п_СтруктураБазы.РазмерКодаЯзыкаБазы));
	ИначеЕсли п_СтруктураБазы.Версия = "8.1.0.0"
		ИЛИ п_СтруктураБазы.Версия = "8.2.0.0"
		ИЛИ п_СтруктураБазы.Версия = "8.2.14.0" Тогда
		п_СтруктураБазы.Вставить("КодЯзыкаБазы", СокрЛП(ПолучитьДанныеИзБуфера(п_СтруктураБазы.КорневойБлок.Данные, п_Тип_Строка, 0, 32)));
		п_СтруктураБазы.Вставить("РазмерКодаЯзыкаБазы", 32);
		п_СтруктураБазы.Вставить("КоличествоТаблицВБазе", п_СтруктураБазы.КорневойБлок.Данные.ПрочитатьЦелое32(п_СтруктураБазы.РазмерКодаЯзыкаБазы));
	ИначеЕсли п_СтруктураБазы.Версия = "8.3.8.0" Тогда
		п_СтруктураБазы.Вставить("КодЯзыкаБазы", "");
		п_СтруктураБазы.Вставить("КоличествоТаблицВБазе", 0);
	КонецЕсли;
	
	п_СтруктураБазы.Вставить("МассивТаблиц", Новый Массив);
	п_СтруктураБазы.Вставить("МассивИменТаблиц", Новый Массив);
	
	Если п_СтруктураБазы.Версия = "8.3.8.0" Тогда
		// struct { 
		//	char lang[32];
		//	int numblocks;
		//	int tableblocks[numblocks]; // номера блоков в этом же потоке, в которых размещено описание таблиц
		// } 
		// таблицы используют однобайтовую кодировку (возможно UTF-8)
		лС1251 = " !""#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_`abcdefghijklmnopqrstuvwxyz{|}~ЂЃ‚ѓ„…†‡€‰Љ‹ЊЌЋЏђ‘’“”•–—™љ›њќћџ ЎўЈ¤Ґ¦§Ё©Є«¬®Ї°±Ііґµ¶·ё№є»јЅѕїАБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдежзийклмнопрстуфхцчшщъыьэюя";
		хБуферТаблиц = ПолучитьДанныеБлобИзБуфераПоНомеруБлока(п_СтруктураБазы.КорневойБлок.Данные, 1); // 1 - индекс данных блоб таблиц
		п_СтруктураБазы.Вставить("КоличествоТаблицВБазе", хБуферТаблиц.ПрочитатьЦелое32(32));
		п_СтруктураБазы.Вставить("КодЯзыкаБазы", СокрЛП(ПолучитьДанныеИзБуфера(хБуферТаблиц, п_Тип_Строка, 0, 32)));
		Для лЦикл1 = 0 По п_СтруктураБазы.КоличествоТаблицВБазе - 1 Цикл
			лТекНомерБлокаТаблицы = хБуферТаблиц.ПрочитатьЦелое32(36 + лЦикл1 * 4); // 32 + 4 = 36
			л_ИмяТаблицы = "";
			лФлагПрерывания = Ложь;
			лУказатель1 = лТекНомерБлокаТаблицы * 256;
			Для лЦикл2 = 6 По 255 Цикл
				лТекБайт = п_СтруктураБазы.КорневойБлок.Данные.Получить(лУказатель1 + лЦикл2);
				Если лТекБайт = 34 Тогда // кавычка
					Если Не лФлагПрерывания Тогда
						лФлагПрерывания = Истина;
					ИначеЕсли лФлагПрерывания Тогда
						Прервать;
					КонецЕсли;
				Иначе
					Если лФлагПрерывания Тогда
						Попытка
							л_ИмяТаблицы = л_ИмяТаблицы + Сред(лС1251, лТекБайт - 31, 1);
						Исключение
							ВызватьИсключение("Неверный код символа");
						КонецПопытки;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			л_Структура = Новый Структура;
			л_Структура.Вставить("ОписаниеТаблицы", Неопределено);
			л_Структура.Вставить("НомерБлока8380", лТекНомерБлокаТаблицы);
			л_Структура.Вставить("Имя", л_ИмяТаблицы);
			л_Структура.Вставить("Поля", Неопределено);
			л_Структура.Вставить("Индексы", Неопределено);
			л_Структура.Вставить("РекордЛок", Неопределено);
			л_Структура.Вставить("НомерСтраницыФайлаДанных", Неопределено);
			л_Структура.Вставить("НомерСтраницыФайлаИндексов", Неопределено);
			л_Структура.Вставить("НомерСтраницыФайлаБлоб", Неопределено);
			л_Структура.Вставить("ФайлДанных", Неопределено);
			л_Структура.Вставить("ФайлИндексов", Неопределено);
			л_Структура.Вставить("ФайлБлоб", Неопределено);
			л_Структура.Вставить("РазмерЗаписиВБайтах", Неопределено);
			л_Структура.Вставить("НомерСтраницыЗаголовка", Неопределено);
			л_Структура.Вставить("МассивНомеровСтраницДанных", Неопределено);
			л_Структура.Вставить("ТипТаблицыРазмещения", 0);
			л_Структура.Вставить("Данные", Неопределено);
			л_Структура.Вставить("СтраницаЗаголовкаДамп", Неопределено);
			л_Структура.Вставить("Сигнатура", Неопределено);
			л_Структура.Вставить("РазмерСодержимого", Неопределено);
			л_Структура.Вставить("Версия1", Неопределено);
			л_Структура.Вставить("Версия2", Неопределено);
			л_Структура.Вставить("Версия", Неопределено);
			л_Структура.Вставить("ТипОбъекта", Неопределено);
			л_Структура.Вставить("МассивСтраницРазмещения", Неопределено);
			п_СтруктураБазы.МассивТаблиц.Добавить(л_Структура);
			п_СтруктураБазы.МассивИменТаблиц.Добавить(ВРег(л_ИмяТаблицы));
		КонецЦикла;
	Иначе
		лСмещение1 = п_СтруктураБазы.РазмерКодаЯзыкаБазы + 4;
		Для лЦикл1 = 0 По п_СтруктураБазы.КоличествоТаблицВБазе - 1 Цикл
			лНомерСтраницыЗаголовка = п_СтруктураБазы.КорневойБлок.Данные.ПрочитатьЦелое32(лСмещение1 + лЦикл1 * 4);
			л_Структура = ПолучитьСтруктуруФайлаБазыПоНомеруСтраницыЗаголовка(п_СтруктураБазы, ПотокКонтейнера, лНомерСтраницыЗаголовка);
			л_Структура.Вставить("ОписаниеТаблицы", Неопределено);
			лРазмерСодержимого = л_Структура.РазмерСодержимого;
			лФлагПрерывания = Ложь;
			лСтрокаОписанияКраткая = "";
			л_ИмяТаблицы = "";
			Для Каждого лТекущаяСтраницаРазмещения Из л_Структура.МассивСтраницРазмещения Цикл
				Для Каждого лТекущийНомерСтраницыДанных Из лТекущаяСтраницаРазмещения.МассивНомеровСтраницДанных Цикл
					хБуфер = ПолучитьСтраницыПоНомеру(п_СтруктураБазы, ПотокКонтейнера, лТекущийНомерСтраницыДанных);
					лКурсор = 0;
					Для лЦикл4 = 0 По хБуфер.Размер / 2 - 1 Цикл
						лКодСимвола = хБуфер.ПрочитатьЦелое16(лКурсор);
						Если лКодСимвола = 34 Тогда // кавычка
							Если Не лФлагПрерывания Тогда
								лФлагПрерывания = Истина;
								лКурсор = лКурсор + 2;
								Продолжить;
							ИначеЕсли лФлагПрерывания Тогда
								Прервать;
							КонецЕсли;
						КонецЕсли;
						Если лФлагПрерывания Тогда
							л_ИмяТаблицы = л_ИмяТаблицы + Символ(лКодСимвола);
						КонецЕсли;
						лКурсор = лКурсор + 2;
					КонецЦикла;
					хБуфер = Неопределено;
					Если лФлагПрерывания Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если лФлагПрерывания Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			л_Структура.Вставить("Имя", л_ИмяТаблицы);
			л_Структура.Вставить("НомерБлока8380", Неопределено); // для совместимости с 8.3.8.0
			п_СтруктураБазы.МассивТаблиц.Добавить(л_Структура);

#Область ОбработкаИнформация

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Наименование", "Распаковщик и запаковщик файлов");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Версия", "1.3.4.0"); 
	ПараметрыРегистрации.Вставить("Информация", "Распаковщик и запаковщик"); 
	
	Возврат ПараметрыРегистрации;	

КонецФункции

#КонецОбласти

#Область РаспаковкаФайла

Процедура Распаковать() Экспорт
	
	п_Файл = Новый Файл(ВыбранныйФайл);
	п_Параметры = Новый Структура;
	п_Параметры.Вставить("Файл", п_Файл.ПолноеИмя);
	п_Параметры.Вставить("ИмяФайла", п_Файл.Имя);
	п_Параметры.Вставить("РасширениеФайла", НРег(п_Файл.Расширение));
	п_Параметры.Вставить("РазмерФайла", п_Файл.Размер());
	п_Параметры.Вставить("Каталог", КаталогРаспаковки + "\" + "Расп");
	п_Параметры.Вставить("ДополнительныйКаталог", КаталогРаспаковки + "\" + "Доп");
	
	УдалитьФайлы(п_Параметры.Каталог);
	ПроверитьИСоздатьКаталог(п_Параметры.Каталог);
	УдалитьФайлы(п_Параметры.ДополнительныйКаталог);
	ПроверитьИСоздатьКаталог(п_Параметры.ДополнительныйКаталог);
	
	Если п_Параметры.РасширениеФайла = ".epf"
		ИЛИ п_Параметры.РасширениеФайла = ".erf"
		ИЛИ п_Параметры.РасширениеФайла = ".cf"
		ИЛИ п_Параметры.РасширениеФайла = ".cfe"
		ИЛИ п_Параметры.РасширениеФайла = ".cfu"
		ИЛИ п_Параметры.РасширениеФайла = ".hbk" Тогда
		РаспаковатьФайлCF(п_Параметры);
	ИначеЕсли п_Параметры.РасширениеФайла = ".dt" Тогда
		РаспаковатьФайлDT(п_Параметры);
	ИначеЕсли п_Параметры.РасширениеФайла = ".1cd"
		ИЛИ п_Параметры.РасширениеФайла = ".1cm" Тогда
		РаспаковатьФайл1CD(п_Параметры);
	ИначеЕсли п_Параметры.РасширениеФайла = ".res" Тогда
		РаспаковатьФайлRES(п_Параметры);
	ИначеЕсли п_Параметры.РасширениеФайла = ".efd" Тогда
		РаспаковатьФайлEFD(п_Параметры);
	КонецЕсли;
	
КонецПроцедуры

Процедура РаспаковатьФайлCF(п_Параметры)
	
	ПолноеИмя = п_Параметры.Файл;
	
	Если п_Параметры.РасширениеФайла = ".cfu" Тогда
		п_ДанныеФайлаCFU = Новый ДвоичныеДанные(ПолноеИмя);
		Если НЕ НачинаетсяСBOMИзБуфера(п_ДанныеФайлаCFU) Тогда
			п_ДанныеФайлаCFU = ИнфлэйтВПамятиИзДвоичныхДанныхВДвоичныеДанныеЧерезХранилищеЗначения(п_ДанныеФайлаCFU);
		КонецЕсли;
		п_ВременныйФайлCFU = ПолучитьИмяВременногоФайла();
		п_ДанныеФайлаCFU.Записать(п_ВременныйФайлCFU);
		ПолноеИмя = п_ВременныйФайлCFU;
	КонецЕсли;
	
	Если п_Параметры.РасширениеФайла = ".hbk"
		ИЛИ п_Параметры.РасширениеФайла = ".cfu" Тогда
		Инфлэйт = Ложь;
	Иначе
		Инфлэйт = Истина;
	КонецЕсли;
	
	ПараметрыВерсии = ПараметрыВерсииКонтейнера(ПолноеИмя);
	
	ПроверитьИСоздатьКаталог(п_Параметры.Каталог);
	
	ПотокКонтейнера = ФайловыеПотоки.ОткрытьДляЧтения(ПолноеИмя);
	
	Если ПараметрыВерсии.Представление = "64_bit_offset_0x1359" Тогда
		ПотокКонтейнера.Перейти(ПараметрыВерсии.Смещение, ПозицияВПотоке.Начало);
		РаспаковатьПотокВКаталог(ПотокКонтейнера, п_Параметры.Каталог, Инфлэйт, п_Параметры.РасширениеФайла, Ложь);
	Иначе
		РаспаковатьПотокВКаталог(ПотокКонтейнера, п_Параметры.Каталог, Инфлэйт, п_Параметры.РасширениеФайла);
	КонецЕсли;
	
	ПотокКонтейнера.Закрыть();
	
	Если п_Параметры.РасширениеФайла = ".cf" И СохранитьКонфигурацииПоставщиковОсновная Тогда
		
		//СтруктураФайлаVersion(ИсходныйКаталог) + СохранитьКонфигурацииПоставщиков(Каталог, Инфлэйт = Ложь, СтарыйФормат = Ложь)
		
		п_ФайлRoot = п_Параметры.Каталог + "\" + "root";
		
		Если ФайлСуществует(п_ФайлRoot) Тогда
			
			п_ДанныеФайлаRoot = Новый ДвоичныеДанные(п_ФайлRoot);
			
			//Если НЕ НачинаетсяСBOMИзБуфера(п_ДанныеФайлаRoot) Тогда // Уже был распакован, инфлэйт не нужен.
			//	п_ДанныеФайлаRoot = ИнфлэйтВПамятиИзДвоичныхДанныхВДвоичныеДанныеЧерезХранилищеЗначения(п_ДанныеФайлаRoot);
			//КонецЕсли;
			
			п_ВременныйФайлRoot = ПолучитьИмяВременногоФайла();
			п_ДанныеФайлаRoot.Записать(п_ВременныйФайлRoot);
			
			п_ЧтениеДанныхRoot = Новый ЧтениеДанных(п_ВременныйФайлRoot, п_Кодировка);

			Пока Истина Цикл
				Р = п_ЧтениеДанныхRoot.ПропуститьДо(п_Маркеры_Список, п_Кодировка);
				Если Р = 0 Тогда
					Р = п_ЧтениеДанныхRoot.ПропуститьДо(",", п_Кодировка);
					Если Р = 0  Тогда
						Р = п_ЧтениеДанныхRoot.ПрочитатьДо(п_Маркеры_Закрытие, п_Кодировка);
						Если Р.ИндексМаркера = 0 ИЛИ Р.ИндексМаркера = 1 Тогда
							п_ФайлОписания = ПолучитьСтрокуИзБуфераДвоичныхДанных(Р.ПолучитьБуферДвоичныхДанных(), п_Кодировка);
							мсНайденныеФайлы = НайтиФайлы(п_Параметры.Каталог + "\", п_ФайлОписания + ".*");
							Если мсНайденныеФайлы.Количество() > 0 Тогда
								Для Каждого мсНайденныйФайл Из мсНайденныеФайлы Цикл
									Если мсНайденныйФайл.Расширение <> "" Тогда
										ДанныеФайла = Новый ДвоичныеДанные(мсНайденныйФайл.ПолноеИмя);
										ДанныеФайла = ИнфлэйтВПамятиИзДвоичныхДанныхВДвоичныеДанныеЧерезХранилищеЗначения(ДанныеФайла);
										п_Чтение = Новый ЧтениеДанных(ДанныеФайла, КодировкаТекста.ANSI, ПорядокБайтов.LittleEndian);
										п_Буфер = п_Чтение.ПрочитатьВБуферДвоичныхДанных();
										ПотокФайлаВПамяти = Новый ПотокВПамяти(п_Буфер);
										п_Чтение.Закрыть();
										Если НЕ ПотокЯвляетсяКонтейнером(ПотокФайлаВПамяти) Тогда
											ДанныеФайла = ИнфлэйтВПамятиИзДвоичныхДанныхВДвоичныеДанныеЧерезХранилищеЗначения(ДанныеФайла);
										КонецЕсли;
										ПотокФайлаВПамяти.Закрыть();
										ДанныеФайла.Записать(п_Параметры.ДополнительныйКаталог + "\" + "КонфигурацияПоставщика" + мсНайденныйФайл.Имя + ".cf");
									КонецЕсли;
								КонецЦикла;
							КонецЕсли;
							Прервать;
						КонецЕсли;
					КонецЕсли;
				ИначеЕсли Р = 1 Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
				
			п_ЧтениеДанныхRoot.Закрыть();
			УдалитьФайлы(п_ВременныйФайлRoot);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если п_Параметры.РасширениеФайла = ".cfu" Тогда
		УдалитьФайлы(ПолноеИмя);
	КонецЕсли;
	
КонецПроцедуры

Процедура РаспаковатьФайлDT(п_Параметры)
	
	Перем Дерево2, Дерево3;
	
	п_ЧтениеФайлаDT = Новый ЧтениеДанных(п_Параметры.Файл, КодировкаТекста.ANSI, ПорядокБайтов.LittleEndian);
	п_ЧтениеФайлаDT.Пропустить(8);
	п_КодВерсии = п_ЧтениеФайлаDT.ПрочитатьБайт();
	
	Если п_КодВерсии = 108 ИЛИ п_КодВерсии = 49 Тогда
		
		п_ДанныеФайлаDT = п_ЧтениеФайлаDT.Прочитать().ПолучитьДвоичныеДанные();
		
		Если НЕ НачинаетсяСBOMИзБуфера(п_ДанныеФайлаDT) Тогда
			п_ДанныеФайлаDT = ИнфлэйтВПамятиИзДвоичныхДанныхВДвоичныеДанныеЧерезХранилищеЗначения(п_ДанныеФайлаDT);
		КонецЕсли;
		
		Если ИзвлечьТекстовыйФормат Тогда
			п_ДанныеФайлаDT.Записать(п_Параметры.ДополнительныйКаталог + "\" + п_Параметры.ИмяФайла + ".txt");
		КонецЕсли;
		
		п_ПолноеИмяДанныхФайлаDT = ПолучитьИмяВременногоФайла("txt");
		п_ДанныеФайлаDT.Записать(п_ПолноеИмяДанныхФайлаDT);
		п_ЧтениеФайлаDT.Закрыть();
		п_ЧтениеДанныхDT = Новый ЧтениеДанных(п_ПолноеИмяДанныхФайлаDT, п_Кодировка);
		
		Пока Истина Цикл
			Р = п_ЧтениеДанныхDT.ПропуститьДо(п_Маркеры_Список, п_Кодировка);
			Если Р = 0 Тогда
				Р = п_ЧтениеДанныхDT.ПропуститьДо("""", п_Кодировка);
				Если Р = 0 Тогда
					Р = п_ЧтениеДанныхDT.ПрочитатьДо("""", п_Кодировка);
					Если Р.ИндексМаркера = 0 Тогда
						п_ИмяОбъекта = ПолучитьСтрокуИзБуфераДвоичныхДанных(Р.ПолучитьБуферДвоичныхДанных(), п_Кодировка);
						Если п_ИмяОбъекта = "Folder" Тогда
							Р = п_ЧтениеДанныхDT.ПропуститьДо("""", п_Кодировка);
							Если Р = 0 Тогда
								Р = п_ЧтениеДанныхDT.ПрочитатьДо("""", п_Кодировка);
								Если Р.ИндексМаркера = 0 Тогда
									л_ИмяТаблицы = ПолучитьСтрокуИзБуфераДвоичныхДанных(Р.ПолучитьБуферДвоичныхДанных(), п_Кодировка);
									Если л_ИмяТаблицы = "Config"
										ИЛИ л_ИмяТаблицы = "ConfigSave"
										ИЛИ л_ИмяТаблицы = "Params"
										ИЛИ л_ИмяТаблицы = "Files" Тогда
										ПолныйКаталог = п_Параметры.Каталог + "\" + л_ИмяТаблицы;
										ПроверитьИСоздатьКаталог(ПолныйКаталог);
										Пока Истина Цикл
											Р = п_ЧтениеДанныхDT.ПропуститьДо(п_Маркеры_Список, п_Кодировка);
											Если Р = 0 Тогда
												Р = п_ЧтениеДанныхDT.ПропуститьДо(п_Маркеры_Закрытие, п_Кодировка);
												Если Р = 0 Тогда // ","
													Если л_ИмяТаблицы = "ConfigSave" Тогда
														ФайлыConfig = НайтиФайлы(п_Параметры.Каталог + "\" + "Config", "*");
														Если ФайлыConfig.Количество() > 0 Тогда
															КопироватьСодержимоеКаталога(п_Параметры.Каталог + "\" + "Config", п_Параметры.Каталог + "\" + "ConfigSave");
														КонецЕсли;
													КонецЕсли;
													Пока Истина Цикл
														Р = п_ЧтениеДанныхDT.ПропуститьДо(п_Маркеры_Список, п_Кодировка);
														Если Р = 0 Тогда
															Р = п_ЧтениеДанныхDT.ПропуститьДо("""", п_Кодировка);
															Если Р = 0 Тогда
																Р = п_ЧтениеДанныхDT.ПрочитатьДо("""", п_Кодировка);
																Если Р.ИндексМаркера = 0 Тогда
																	л_ИмяФайла = ПолучитьСтрокуИзБуфераДвоичныхДанных(Р.ПолучитьБуферДвоичныхДанных(), п_Кодировка);
																	Пока Истина Цикл
																		Р = п_ЧтениеДанныхDT.ПропуститьДо(п_Маркеры_Список, п_Кодировка);
																		Если Р = 0 Тогда
																			//п_ЧтениеДанныхDT.ПропуститьДо("{", п_Кодировка);
																			Р = п_ЧтениеДанныхDT.ПрочитатьДо("}", п_Кодировка);
																			Если Р.ИндексМаркера = 0 Тогда
																				п_Текст = ПолучитьСтрокуИзБуфераДвоичныхДанных(Р.ПолучитьБуферДвоичныхДанных(), п_Кодировка);
																				п_ДанныеФайлаBase64 = ПолучитьДвоичныеДанныеИзBase64Строки(Сред(п_Текст, 9));
																				Если л_ИмяТаблицы <> "Config" И л_ИмяТаблицы <> "ConfigSave" Тогда
																					Если НЕ НачинаетсяСBOMИзБуфера(п_ДанныеФайлаBase64) Тогда
																						п_ДанныеФайлаBase64 = ИнфлэйтВПамятиИзДвоичныхДанныхВДвоичныеДанныеЧерезХранилищеЗначения(п_ДанныеФайлаBase64);
																					КонецЕсли;
																				КонецЕсли;
																				ИмяТекущегоФайла = ПолныйКаталог + "\" + л_ИмяФайла;
																				п_ДанныеФайлаBase64.Записать(ИмяТекущегоФайла);
																			КонецЕсли;
																			//п_ЧтениеДанныхDT.ПропуститьДо("}", п_Кодировка);
																		ИначеЕсли Р = 1 Тогда
																			Прервать;
																		КонецЕсли;
																	КонецЦикла;
																КонецЕсли;
															КонецЕсли;
														ИначеЕсли Р = 1 Тогда
															Прервать;
														КонецЕсли;
													КонецЦикла;
												//ИначеЕсли Р = 1 Тогда // пустой контейнер
												КонецЕсли;
											ИначеЕсли Р = 1 Тогда
												Прервать;
											КонецЕсли;
										КонецЦикла;
									Иначе // Лев(л_ИмяТаблицы, 1) = "_"
										Прервать;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
							Если л_ИмяТаблицы = "Config" ИЛИ л_ИмяТаблицы = "ConfigSave" Тогда
								Если СохранитьКонфигурациюБазыДанных ИЛИ СохранитьОсновнуюКонфигурацию Тогда
									ФайлыНаСервере = НайтиФайлы(ПолныйКаталог, "*");
									Если ФайлыНаСервере.Количество() > 0 Тогда
										п_ПараметрыСборки = НовыйПараметрыСборки();
										п_ПараметрыСборки.КаталогИсточник = ПолныйКаталог;
										п_ПараметрыСборки.ИмяЦелевогоФайла = п_Параметры.ДополнительныйКаталог + "\" + ?(л_ИмяТаблицы = "ConfigSave", "ОсновнаяКонфигурация", "КонфигурацияБазыДанных") + ".cf";
										п_ПараметрыСборки.РасширениеЦелевогоФайла = ".cf";
										п_ПараметрыСборки.Дефлэйт = Ложь;
										СформироватьКонтейнер(п_ПараметрыСборки);
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						ИначеЕсли п_ИмяОбъекта = "DataBase" Тогда
							Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли Р = 1 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
			
		п_ЧтениеДанныхDT.Закрыть();
		УдалитьФайлы(п_ПолноеИмяДанныхФайлаDT);
		
	ИначеЕсли п_КодВерсии = 50 ИЛИ п_КодВерсии = 51 Тогда
		
		п_ДанныеФайлаDT = п_ЧтениеФайлаDT.Прочитать().ПолучитьДвоичныеДанные();
		
		Если НЕ НачинаетсяСBOMИзБуфера(п_ДанныеФайлаDT) Тогда
			п_ДанныеФайлаDT = ИнфлэйтВПамятиИзДвоичныхДанныхВДвоичныеДанныеЧерезХранилищеЗначения(п_ДанныеФайлаDT);
		КонецЕсли;
		
		п_ПолноеИмяДанныхФайлаDT = ПолучитьИмяВременногоФайла("txt");
		п_ДанныеФайлаDT.Записать(п_ПолноеИмяДанныхФайлаDT);
		п_ЧтениеФайлаDT.Закрыть();
		
		Если ИзвлечьТекстовыйФормат Тогда
			
			п_ФайлTXT = п_Параметры.ДополнительныйКаталог + "\" + п_Параметры.ИмяФайла + ".txt";
			
			п_ЗаписьДанных = Новый ЗаписьДанных(п_ФайлTXT);

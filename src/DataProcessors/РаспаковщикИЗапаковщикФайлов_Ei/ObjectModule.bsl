	КонецЕсли;
	
	МассивФайлов = ПолучитьМассивФайлов(ПараметрыСборки.КаталогИсточник, "*", ПараметрыСборки.РасширениеЦелевогоФайла);
	КоличествоФайлов = МассивФайлов.Количество();
	
	Если КоличествоФайлов = 0 Тогда
		Сообщить("Не обнаружены файлы для запаковки.");
		Возврат;
	КонецЕсли;
	
	РазмерОглавления = КоличествоФайлов * ПараметрыВерсии.РазмерПоляАдресации * 3;
	
	Если ПараметрыСборки.УровеньВложенности > 0 Тогда
		// оглавление вложенных контейнеров записывается без добивки нулями. 
		ПараметрыВерсии.РазмерБлокаОглавления = РазмерОглавления;
	ИначеЕсли ПараметрыВерсии.РазмерБлокаОглавления < РазмерОглавления Тогда
		// если оглавление больше размера блока, пишется одним блоком.
		ПараметрыВерсии.РазмерБлокаОглавления = РазмерОглавления;
	КонецЕсли;
	
	// Заголовок контейнера
	БуферЗаголовкаКонтейнера = ПолучитьЗаголовокКонтейнера(ПараметрыВерсии, ПараметрыСборки, КоличествоФайлов);
	//ПотокЗаписи.Перейти(ПараметрыВерсии.Смещение, ПозицияВПотоке.Начало);
	ПотокЗаписи.Записать(БуферЗаголовкаКонтейнера, 0, БуферЗаголовкаКонтейнера.Размер);
	
	ПотокОглавления = Новый ПотокВПамяти(ПараметрыВерсии.РазмерБлокаОглавления);
	ПозицииОглавления = Новый Массив;
	МеткаВремениИзмененияКонтейнера = 0;
	Оглавление = Новый Массив;
	ШаблонАтрибутов = ПолучитьШаблонАтрибутов();
	
	Для Каждого ОписаниеФайла Из МассивФайлов Цикл
		
		ПолноеИмяФайлаДляЗаписи = ОписаниеФайла.ПолноеИмя;
		СтрокаОглавления = НовыйСтруктураОглавления();
		
		Если ОписаниеФайла.ЭтоКаталог() Тогда
			
			ПолноеИмяФайлаДляЗаписи = ПолучитьИмяВременногоФайла();
			НовыеПараметрыСборки = НовыйПараметрыСборки();
			НовыеПараметрыСборки.КаталогИсточник = ОписаниеФайла.ПолноеИмя;
			НовыеПараметрыСборки.ИмяЦелевогоФайла = ПолноеИмяФайлаДляЗаписи;
			НовыеПараметрыСборки.Дефлэйт = Ложь;
			НовыеПараметрыСборки.УровеньВложенности = ПараметрыСборки.УровеньВложенности + 1;
			СформироватьКонтейнер(НовыеПараметрыСборки);
			
		КонецЕсли;
		
		// Запись документа атрибутов файла
		// Запишем предварительно документ атрибутов, создав его самостоятельно
		ДокументАтрибутов = ПолучитьДокументАтрибутов(ШаблонАтрибутов, ОписаниеФайла.Имя, ПолноеИмяФайлаДляЗаписи);
		ДобавитьЗаписьВОглавление(ПотокОглавления, ПотокЗаписи, ПозицииОглавления, ПараметрыВерсии);
		РезультатЗаписи = ЗаписатьДокумент(ПотокЗаписи, ДокументАтрибутов, ПараметрыВерсии, ПараметрыСборки.Дефлэйт, Истина);
		СтрокаОглавления.АдресАтрибутов = РезультатЗаписи.Позиция;
		СтрокаОглавления.РазмерАтрибутов = РезультатЗаписи.РазмерДанных;
		ЗафиксироватьВремяИзмененияКонтейнера(МеткаВремениИзмененияКонтейнера, ДокументАтрибутов);
		
		// Запись документа содержимого файла
		ДобавитьЗаписьВОглавление(ПотокОглавления, ПотокЗаписи, ПозицииОглавления, ПараметрыВерсии);
		РезультатЗаписи = ЗаписатьДокумент(ПотокЗаписи, ПолноеИмяФайлаДляЗаписи, ПараметрыВерсии, ПараметрыСборки.Дефлэйт);
		
		СтрокаОглавления.ИмяФайла = ОписаниеФайла.Имя;
		СтрокаОглавления.АдресСодержимого = РезультатЗаписи.Позиция;
		СтрокаОглавления.РазмерСодержимого = РезультатЗаписи.РазмерДанных;
		СтрокаОглавления.ХешСумма = РезультатЗаписи.ХешСумма;
		СтрокаОглавления.ПолноеИмяФайла = ПолноеИмяФайлаДляЗаписи;
		Оглавление.Добавить(СтрокаОглавления);
		
		// Маркер конца записи оглавления
		ЗаписатьМаркерКонцаЗаписиОглавления(ПотокОглавления, ПотокЗаписи, ПозицииОглавления, ПараметрыВерсии);
		
	КонецЦикла;
	
	// Запись оглавления в зарезервированные позиции
	ЗаписатьОглавление(ПотокОглавления, ПотокЗаписи, ПозицииОглавления, ПараметрыВерсии);
	
	Если ПараметрыСборки.РасширениеЦелевогоФайла = ".cfe" Тогда
		// Для расширений необходимо перезаписать файл configinfo с новыми хеш-суммами
		ОбновитьФайлConfiginfo(ПотокЗаписи, Оглавление, ПараметрыВерсии);
	КонецЕсли;
	
	// Завершение записи
	ПотокЗаписи.Закрыть();
	
	//++
	//Если ПараметрыСборки.УровеньВложенности > 0 Тогда

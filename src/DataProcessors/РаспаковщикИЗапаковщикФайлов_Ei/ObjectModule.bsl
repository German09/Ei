		Возврат п_ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(п_ЧтениеДанных.ПрочитатьЦелое64());
	КонецЕсли;
	
КонецФункции

Функция ПолучитьЗначениеТэга(п_ЧтениеДанных, п_ПараметрыСписка)
	Если п_ПараметрыСписка.Тэг = 0 Тогда
	ИначеЕсли п_ПараметрыСписка.Тэг = 1 Тогда
		Возврат "0";
	ИначеЕсли п_ПараметрыСписка.Тэг = 2 Тогда
		Возврат "1";
	ИначеЕсли п_ПараметрыСписка.Тэг = 3 Тогда
		Возврат "2";
	ИначеЕсли п_ПараметрыСписка.Тэг = 4 Тогда
		Возврат "3";
	ИначеЕсли п_ПараметрыСписка.Тэг = 5 Тогда
		Возврат "4";
	ИначеЕсли п_ПараметрыСписка.Тэг = 6 Тогда
		Возврат "5";
	ИначеЕсли п_ПараметрыСписка.Тэг = 7 Тогда
		Возврат "6";
	ИначеЕсли п_ПараметрыСписка.Тэг = 8 Тогда
		Возврат "7";
	ИначеЕсли п_ПараметрыСписка.Тэг = 9 Тогда
		Возврат "8";
	ИначеЕсли п_ПараметрыСписка.Тэг = 10 Тогда
		Возврат "9";
	ИначеЕсли п_ПараметрыСписка.Тэг = 11 Тогда
		Возврат Строка(Формат(п_ЧтениеДанных.ПрочитатьБайт(), "ЧН=0; ЧГ=0"));
	ИначеЕсли п_ПараметрыСписка.Тэг = 12 Тогда
		Возврат "-" + Строка(Формат(п_ЧтениеДанных.ПрочитатьБайт(), "ЧН=0; ЧГ=0"));
	ИначеЕсли п_ПараметрыСписка.Тэг = 13 Тогда
		Возврат Строка(Формат(п_ЧтениеДанных.ПрочитатьЦелое16(), "ЧН=0; ЧГ=0"));
	ИначеЕсли п_ПараметрыСписка.Тэг = 14 Тогда
		Возврат "-" + Строка(Формат(п_ЧтениеДанных.ПрочитатьЦелое16(), "ЧН=0; ЧГ=0"));
	ИначеЕсли п_ПараметрыСписка.Тэг = 15 Тогда
		Возврат Строка(Формат(п_ЧтениеДанных.ПрочитатьЦелое32(), "ЧН=0; ЧГ=0"));
	ИначеЕсли п_ПараметрыСписка.Тэг = 16 Тогда
		Возврат "-" + Строка(Формат(п_ЧтениеДанных.ПрочитатьЦелое32(), "ЧН=0; ЧГ=0"));
	ИначеЕсли п_ПараметрыСписка.Тэг = 17 Тогда
		Возврат Строка(Формат(п_ЧтениеДанных.ПрочитатьЦелое64(), "ЧН=0; ЧГ=0"));
	ИначеЕсли п_ПараметрыСписка.Тэг = 21 Тогда
		п_Буфер = п_ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(4).Перевернуть();
		л_Строка1 = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(п_Буфер);
		п_Буфер = п_ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(2).Перевернуть();
		л_Строка2 = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(п_Буфер);
		п_Буфер = п_ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(2).Перевернуть();
		л_Строка3 = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(п_Буфер);
		п_Буфер = п_ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(2);
		л_Строка4 = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(п_Буфер);
		п_Буфер = п_ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(6);
		л_Строка5 = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(п_Буфер);
		Возврат СтрШаблон("%1-%2-%3-%4-%5", л_Строка1, л_Строка2, л_Строка3, л_Строка4, л_Строка5);
	ИначеЕсли п_ПараметрыСписка.Тэг = 22 Тогда
		п_ПараметрыСписка.Кавычки = Ложь;
	ИначеЕсли п_ПараметрыСписка.Тэг = 23 Тогда
		п_Буфер = п_ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(п_ЧтениеДанных.ПрочитатьБайт() * 2);
		п_Текст = ПолучитьСтрокуИзБуфераДвоичныхДанных(п_Буфер, "UTF-16LE");
		Если п_ПараметрыСписка.Кавычки Тогда
			//Возврат """" + СтрЗаменить(п_Текст, """", """""") + """";
			Возврат п_Текст;
		Иначе
			п_ПараметрыСписка.Кавычки = Истина;
			Возврат ВРег(п_Текст);
		КонецЕсли;
	ИначеЕсли п_ПараметрыСписка.Тэг = 24 Тогда
		п_Буфер = п_ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(п_ЧтениеДанных.ПрочитатьЦелое16() * 2);
		п_Текст = ПолучитьСтрокуИзБуфераДвоичныхДанных(п_Буфер, "UTF-16LE");
		Если п_ПараметрыСписка.Кавычки Тогда
			//Возврат """" + СтрЗаменить(п_Текст, """", """""") + """";
			Возврат п_Текст;
		Иначе
			п_ПараметрыСписка.Кавычки = Истина;
			Возврат ВРег(п_Текст);
		КонецЕсли;
	ИначеЕсли п_ПараметрыСписка.Тэг = 25 Тогда
		п_Буфер = п_ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(п_ЧтениеДанных.ПрочитатьЦелое64() * 2);
		п_Текст = ПолучитьСтрокуИзБуфераДвоичныхДанных(п_Буфер, "UTF-16LE");
		Если п_ПараметрыСписка.Кавычки Тогда
			//Возврат """" + СтрЗаменить(п_Текст, """", """""") + """";
			Возврат п_Текст;
		Иначе
			п_ПараметрыСписка.Кавычки = Истина;
			Возврат ВРег(п_Текст);
		КонецЕсли;
	ИначеЕсли п_ПараметрыСписка.Тэг = 26 Тогда
		п_Буфер = п_ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(п_ЧтениеДанных.ПрочитатьБайт());
		п_ЭтоANSIСтрока = Истина;
		Для Счётчик = 0 По п_Буфер.Размер - 1 Цикл
			Если п_Буфер[Счётчик] < 32 ИЛИ п_Буфер[Счётчик] > 127 Тогда
				п_ЭтоANSIСтрока = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если п_ЭтоANSIСтрока Тогда
			п_Текст = ПолучитьСтрокуИзБуфераДвоичныхДанных(п_Буфер);
			Если п_ПараметрыСписка.Кавычки Тогда
				//Возврат """" + СтрЗаменить(п_Текст, """", """""") + """";
				Возврат п_Текст;
			Иначе
				п_ПараметрыСписка.Кавычки = Истина;
				Возврат ВРег(п_Текст);
			КонецЕсли;
		Иначе
			п_Текст = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(п_Буфер);
			п_ПараметрыСписка.Кавычки = Истина;
			Возврат НРег(п_Текст);
		КонецЕсли;
	ИначеЕсли п_ПараметрыСписка.Тэг = 27 Тогда
		п_Буфер = п_ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(п_ЧтениеДанных.ПрочитатьЦелое16());
		п_ЭтоANSIСтрока = Истина;
		Для Счётчик = 0 По п_Буфер.Размер - 1 Цикл
			Если п_Буфер[Счётчик] < 32 ИЛИ п_Буфер[Счётчик] > 127 Тогда
				п_ЭтоANSIСтрока = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если п_ЭтоANSIСтрока Тогда
			п_Текст = ПолучитьСтрокуИзБуфераДвоичныхДанных(п_Буфер);
			Если п_ПараметрыСписка.Кавычки Тогда
				//Возврат """" + СтрЗаменить(п_Текст, """", """""") + """";
				Возврат п_Текст;
			Иначе
				п_ПараметрыСписка.Кавычки = Истина;
				Возврат ВРег(п_Текст);
			КонецЕсли;
		Иначе
			п_Текст = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(п_Буфер);
			п_ПараметрыСписка.Кавычки = Истина;
			Возврат НРег(п_Текст);
		КонецЕсли;
	ИначеЕсли п_ПараметрыСписка.Тэг = 28 Тогда
		п_Буфер = п_ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(п_ЧтениеДанных.ПрочитатьЦелое64());
		п_ЭтоANSIСтрока = Истина;
		Для Счётчик = 0 По п_Буфер.Размер - 1 Цикл
			Если п_Буфер[Счётчик] < 32 ИЛИ п_Буфер[Счётчик] > 127 Тогда
				п_ЭтоANSIСтрока = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если п_ЭтоANSIСтрока Тогда
			п_Текст = ПолучитьСтрокуИзБуфераДвоичныхДанных(п_Буфер);
			Если п_ПараметрыСписка.Кавычки Тогда
				//Возврат """" + СтрЗаменить(п_Текст, """", """""") + """";
				Возврат п_Текст;
			Иначе
				п_ПараметрыСписка.Кавычки = Истина;
				Возврат ВРег(п_Текст);
			КонецЕсли;
		Иначе
			п_Текст = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(п_Буфер);
			п_ПараметрыСписка.Кавычки = Истина;
			Возврат НРег(п_Текст);
		КонецЕсли;
	КонецЕсли;
	

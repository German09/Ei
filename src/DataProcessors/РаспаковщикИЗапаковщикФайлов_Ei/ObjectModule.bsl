Процедура РаспаковатьФайлRES(п_Параметры)
	
	п_Поток = ФайловыеПотоки.ОткрытьДляЧтения(п_Параметры.Файл);
	
	п_ЧтениеДанных = Новый ЧтениеДанных(п_Поток);
	
	п_РазмерЗаголовка = 32;
	
	п_ЧтениеДанных.Пропустить(п_РазмерЗаголовка);
	
	п_ОписаниеТаблицы0 = п_ЧтениеДанных.ПрочитатьБайт();
	п_ОписаниеТаблицы1 = п_ЧтениеДанных.ПрочитатьБайт();
	п_ОписаниеТаблицы2 = п_ЧтениеДанных.ПрочитатьБайт();
	п_ТипОсновнойТаблицы = п_ЧтениеДанных.ПрочитатьБайт();
	
	Если п_ТипОсновнойТаблицы <> 32 И п_ТипОсновнойТаблицы <> 64 И п_ТипОсновнойТаблицы <> 80 Тогда
		ВызватьИсключение "Неизвестный тип основной таблицы.";
	КонецЕсли;
	
	п_РазмерИлиСмещениеТаблицы = п_ОписаниеТаблицы2 * 65536 + п_ОписаниеТаблицы1 * 256 + п_ОписаниеТаблицы0;
	п_ЭтоТаблица64 = (п_ТипОсновнойТаблицы = 64);
	п_ЭтоУпрощеннаяТаблица = (п_ТипОсновнойТаблицы = 80);
	п_КоличествоИндексов = п_ЧтениеДанных.ПрочитатьЦелое32();
	п_ИндексНачалаСтрок = п_ЧтениеДанных.ПрочитатьЦелое32() * 4 + п_РазмерЗаголовка;
	п_ЧтениеДанных.Пропустить((п_КоличествоИндексов - 2) * 4);
	п_ВсегоУжеПрочитано = п_РазмерЗаголовка + 8 + (п_КоличествоИндексов - 1) * 4;
	п_ВсегоПрочитать = п_ИндексНачалаСтрок - п_ВсегоУжеПрочитано;
	п_РазмерБлока = 8192;
	п_ВсегоБлоков = п_ВсегоПрочитать / п_РазмерБлока;
	п_ВсегоБлоков = ?(Цел(п_ВсегоБлоков) = п_ВсегоБлоков, п_ВсегоБлоков, Цел(п_ВсегоБлоков) + 1);
	п_СтрокаИменРесурсов = "";
	
	Для НомерБлока = 1 По п_ВсегоБлоков Цикл
		
		п_Прочитать = Мин(п_ВсегоПрочитать, п_РазмерБлока);
		п_СтрокаИменРесурсов = п_СтрокаИменРесурсов + п_ЧтениеДанных.ПрочитатьСимволы(п_Прочитать);
		п_ВсегоПрочитать = п_ВсегоПрочитать - п_РазмерБлока;
		
	КонецЦикла;
	
	п_ЧтениеДанных.Закрыть();
	
	Если п_ЭтоУпрощеннаяТаблица Тогда
		п_СмещениеОсновнойТаблицы = п_РазмерИлиСмещениеТаблицы * 2 + п_ИндексНачалаСтрок;
	Иначе
		п_СмещениеОсновнойТаблицы = п_РазмерИлиСмещениеТаблицы * 4 + п_РазмерЗаголовка;
	КонецЕсли;
	
	п_Поток.Перейти(п_СмещениеОсновнойТаблицы, ПозицияВПотоке.Начало);
	
	п_ЧтениеДанных = Новый ЧтениеДанных(п_Поток);
	
	Если п_ЭтоТаблица64 Тогда
		п_ВсегоЭлементов = п_ЧтениеДанных.ПрочитатьЦелое32();
	Иначе
		п_ВсегоЭлементов = п_ЧтениеДанных.ПрочитатьЦелое16();
	КонецЕсли;
	
	п_СоответствиеРесурсов = Новый Соответствие;
	
	Для п_ИндексЭлемента = 0 По п_ВсегоЭлементов - 1 Цикл
		
		Если п_ЭтоТаблица64 Тогда
			п_Смещение = п_ЧтениеДанных.ПрочитатьЦелое32();
		Иначе
			п_Смещение = п_ЧтениеДанных.ПрочитатьЦелое16();
		КонецЕсли;
		
		п_ПозицияВСтроке = п_Смещение + п_РазмерЗаголовка - п_ВсегоУжеПрочитано + 1;
		п_Номер = СтрНайти(п_СтрокаИменРесурсов, Символ(0), , п_ПозицияВСтроке);
		п_ИмяРесурса = Сред(п_СтрокаИменРесурсов, п_ПозицияВСтроке, п_Номер - п_ПозицияВСтроке);
		
		п_НомерТочки = Найти(п_ИмяРесурса, ".");
		п_Расширение = ?(п_НомерТочки > 0, Сред(п_ИмяРесурса, п_НомерТочки + 1), "");
		
		п_СтрокаРесурса = Новый Структура("ЭтоДвоичныеДанные, СмещениеЗначения, ТипРесурса, Значение");
		п_СтрокаРесурса.Вставить("ПолноеИмяФайла", п_Параметры.Файл);
		п_СтрокаРесурса.Вставить("Имя", п_ИмяРесурса);
		п_СтрокаРесурса.Вставить("Расширение", п_Расширение);
		п_СтрокаРесурса.Вставить("СмещениеИмени", п_Смещение);
		
		п_СоответствиеРесурсов.Вставить(п_ИндексЭлемента, п_СтрокаРесурса);
		
	КонецЦикла;
	
	п_ТекущаяПозиция = п_Поток.ТекущаяПозиция();
	
	Для Номер = 1 По 20 Цикл
		
		п_КодСимвола1 = п_ЧтениеДанных.ПрочитатьБайт();
		п_КодСимвола2 = п_ЧтениеДанных.ПрочитатьБайт();
		
		Если п_КодСимвола1 = 170 И п_КодСимвола2 = 170 Тогда
			п_ТекущаяПозиция = п_ТекущаяПозиция + 2;
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	п_ЧтениеДанных.Закрыть();
	
	п_Поток.Перейти(п_ТекущаяПозиция, ПозицияВПотоке.Начало);
	
	п_ЧтениеДанных = Новый ЧтениеДанных(п_Поток);
	
	Для п_ИндексЭлемента = 0 По п_ВсегоЭлементов - 1 Цикл
		
		Если п_ЭтоУпрощеннаяТаблица Тогда
			п_ОписаниеРесурса0 = п_ЧтениеДанных.ПрочитатьБайт();
			п_ОписаниеРесурса1 = п_ЧтениеДанных.ПрочитатьБайт();
			п_ТипРесурса = 96;
			п_ЛокальноеСмещение = п_ОписаниеРесурса1 * 256 + п_ОписаниеРесурса0;
		Иначе
			п_ОписаниеРесурса0 = п_ЧтениеДанных.ПрочитатьБайт();
			п_ОписаниеРесурса1 = п_ЧтениеДанных.ПрочитатьБайт();
			п_ОписаниеРесурса2 = п_ЧтениеДанных.ПрочитатьБайт();
			п_ТипРесурса = п_ЧтениеДанных.ПрочитатьБайт();
			п_ЛокальноеСмещение = п_ОписаниеРесурса2 * 65536 + п_ОписаниеРесурса1 * 256 + п_ОписаниеРесурса0;
		КонецЕсли;
		
		Если п_ТипРесурса = 16 Тогда
			п_Смещение = п_ЛокальноеСмещение * 4 + п_РазмерЗаголовка;
		Иначе
			п_Смещение = п_ЛокальноеСмещение * 2 + п_ИндексНачалаСтрок;
		КонецЕсли;
		
		п_СтрокаРесурса = п_СоответствиеРесурсов.Получить(п_ИндексЭлемента);
		
		Если п_СтрокаРесурса <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		п_СтрокаРесурса.ТипРесурса = п_ТипРесурса;
		п_СтрокаРесурса.СмещениеЗначения = п_Смещение;
		п_СтрокаРесурса.ЭтоДвоичныеДанные = (п_ТипРесурса = 16);
		
		Если п_СтрокаРесурса.СмещениеЗначения > 0 Тогда
		
			пп_ЧтениеДанных = Новый ЧтениеДанных(п_СтрокаРесурса.ПолноеИмяФайла);
			пп_ЧтениеДанных.Пропустить(п_СтрокаРесурса.СмещениеЗначения);
			
			Если п_СтрокаРесурса.ЭтоДвоичныеДанные Тогда
				
				пп_РазмерДанных = пп_ЧтениеДанных.ПрочитатьЦелое32();
				
				Если пп_РазмерДанных <> Неопределено Тогда
					
					п_СтрокаРесурса.Значение = пп_ЧтениеДанных.Прочитать(пп_РазмерДанных).ПолучитьДвоичныеДанные();
						
					Попытка
						п_СтрокаРесурса.Значение.Записать(п_Параметры.Каталог + "\" + п_СтрокаРесурса.Имя);
					Исключение
						Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
					КонецПопытки;
					
				КонецЕсли;
				
			Иначе
				
				пп_Значение = "";
				пп_КодСимвола = пп_ЧтениеДанных.ПрочитатьЦелое16();
				
				Пока пп_КодСимвола <> 0 Цикл
					пп_Значение = пп_Значение + Символ(пп_КодСимвола);
					пп_КодСимвола = пп_ЧтениеДанных.ПрочитатьЦелое16();
				КонецЦикла;
				
				п_СтрокаРесурса.Значение = ?(СтрДлина(пп_Значение) > 40, Сред(пп_Значение, 2), пп_Значение);
				
			КонецЕсли;
			
			пп_ЧтениеДанных.Закрыть();
			
		КонецЕсли;
		
	КонецЦикла;
	
	п_ЧтениеДанных.Закрыть();
	
КонецПроцедуры

Процедура РаспаковатьФайлEFD(п_Параметры)
	
	Перем УдалятьФайлыПосле;
	
	ДанныеФайла = п_Параметры.Файл;
	
	Если НЕ НачинаетсяСBOMИзБуфера(ДанныеФайла) Тогда
		хВременныйФайл = ПолучитьИмяВременногоФайла();
		п_Файл = Новый Файл(хВременныйФайл);
		ИнфлэйтВФайлЧерезЧтениеZipФайла(ДанныеФайла, п_Файл.Имя, п_Файл.Путь);
		ДанныеФайла = п_Файл.ПолноеИмя;
		УдалятьФайлыПосле = Истина;
	КонецЕсли;
	
	пЧтение = Новый ЧтениеДанных(ДанныеФайла);
	пЧтение.Пропустить(4);
	
	КоличествоБлоков = пЧтение.ПрочитатьЦелое32();
	
	Для й = 1 По КоличествоБлоков Цикл
		ДлинаЗаголовкаБлока = пЧтение.ПрочитатьЦелое32();
		пЧтение.Пропустить(ДлинаЗаголовкаБлока - 4);
	КонецЦикла;
	
	КоличествоФайлов = пЧтение.ПрочитатьЦелое32();
	
	СмещениеЗаголовка = пЧтение.ИсходныйПоток().ТекущаяПозиция();
	
	ЧтениеЗаголовка = Новый ЧтениеДанных(ДанныеФайла);
	ЧтениеЗаголовка.Пропустить(СмещениеЗаголовка);
	
	Для й = 1 По КоличествоФайлов Цикл
		ДлинаБлокаИмениФайла = ЧтениеЗаголовка.ПрочитатьЦелое32();
		СмещениеЗаголовка = СмещениеЗаголовка + ДлинаБлокаИмениФайла;
		ЧтениеЗаголовка.Пропустить(ДлинаБлокаИмениФайла - 4);
	КонецЦикла;
	
	ЧтениеЗаголовка.Закрыть();
	
	Для й = 1 По КоличествоФайлов Цикл
		
		ДлинаБлокаИмениФайла = пЧтение.ПрочитатьЦелое32();
		ДлинаИмениФайла = пЧтение.ПрочитатьЦелое32();
		пБуфер = пЧтение.ПрочитатьВБуферДвоичныхДанных(ДлинаБлокаИмениФайла - 24);
		ПолноеИмяФайла = ПолучитьСтрокуИзБуфераДвоичныхДанных(пБуфер, "UTF-16LE");
		пБуфер = Неопределено;
			
		Если ДлинаИмениФайла <> СтрДлина(ПолноеИмяФайла) Тогда
			Сообщить("Ошибка чтения имени файла № " + й);
			Продолжить;
		КонецЕсли;
		
		Разделитель = ?(СтрНайти(ПолноеИмяФайла, "/") = 0, "\", "/");
		ЧастиПути = СтрРазделить(ПолноеИмяФайла, Разделитель);
		ИмяФайла = ЧастиПути[ЧастиПути.ВГраница()];
		ЧастиПути.Удалить(ЧастиПути.ВГраница());
		ПолныйКаталог = п_Параметры.Каталог + "\" + СтрСоединить(ЧастиПути, Разделитель);
		ПроверитьИСоздатьКаталог(ПолныйКаталог);
		ФайлДляСохранения = ПолныйКаталог + "\" + ИмяФайла;
		
		пЧтение.Пропустить(8);
		
		СмещениеФайла = пЧтение.ПрочитатьЦелое32();
		РазмерФайла = пЧтение.ПрочитатьЦелое32();
		
		Смещение = СмещениеЗаголовка + СмещениеФайла;
		
		пЧтениеДанных = Новый ЧтениеДанных(ДанныеФайла);
		пЧтениеДанных.Пропустить(Смещение);
		пБуферДанные = пЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(РазмерФайла);
		пЧтениеДанных.Закрыть();
		
		пЗаписьДанных = Новый ЗаписьДанных(ФайлДляСохранения);
		пЗаписьДанных.ЗаписатьБуферДвоичныхДанных(пБуферДанные);
		пЗаписьДанных.Закрыть();
		
		пБуферДанные = Неопределено;
		
	КонецЦикла;
	
	пЧтение.Закрыть();
	
	Если УдалятьФайлыПосле Тогда
		УдалитьФайлы(хВременныйФайл);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСФайлами

#Область Расширение_CF

Функция НовыйПараметрыВерсииКонтейнера()
	
	ПараметрыВерсии = Новый Структура;
	
	ПараметрыВерсии.Вставить("Представление", "");
	ПараметрыВерсии.Вставить("РазмерЗаголовкаКонтейнера", 0); // 16 или 20
	ПараметрыВерсии.Вставить("РазмерЗаголовкаБлока", 0); // 31 или 55
	ПараметрыВерсии.Вставить("РазмерПоляАдресации", 0); // 4 или 8
	ПараметрыВерсии.Вставить("РазделительОглавления", ""); // "FFFFFF7F" или "FFFFFFFFFFFFFFFF"
	ПараметрыВерсии.Вставить("Смещение", 0);
	ПараметрыВерсии.Вставить("МаксимальноеЦелоеЧисло", 0); // 0x7fffffff или 0xFFFFFFFFFFFFFFFF
	
	Возврат ПараметрыВерсии;
	
КонецФункции

Функция НовыйПараметрыСборки(Знач ИсходныеПараметры = Неопределено)
	
	ПараметрыСборки = Новый Структура;
	ПараметрыСборки.Вставить("КаталогИсточник", "");
	ПараметрыСборки.Вставить("ИмяЦелевогоФайла", "");
	ПараметрыСборки.Вставить("РасширениеЦелевогоФайла", "");
	ПараметрыСборки.Вставить("Дефлэйт", Ложь);
	ПараметрыСборки.Вставить("УровеньВложенности", 0);
	
	Если ИсходныеПараметры <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыСборки, ИсходныеПараметры);
	КонецЕсли;
	
	Возврат ПараметрыСборки;
	
КонецФункции

Функция НовыйСтруктураОглавления()
	
	Возврат Новый Структура("ИмяФайла, АдресАтрибутов, АдресСодержимого, РазмерАтрибутов, РазмерСодержимого, 
		|ВремяСоздания, ВремяИзменения, ХешСумма, ИмяОбъекта, ТипОбъекта, ПолноеИмяФайла");

КонецФункции

Функция ПараметрыВерсииКонтейнера(ПолноеИмяФайла)
	
	ПараметрыВерсии = Неопределено;
	
	// Версию контейнера можно определить по заголовку блока, расположенному после заголовка контейнера
	// [CRLF][Размер всего документа][Пробел][Размер текущего блока][Пробел][Адрес следующего блока][Пробел][CRLF]
	// Контейнер версии до 8.3.16 имеет заголовок блока размером 31 байт и каждое поле данных 
	// [Размер всего документа],[Размер текущего блока],[Адрес следующего блока] имеет размер 8 байт
	// Контейнер версии 8.3.16 имеет заголовок блока размером 55 байт, и размер полей данных - по 16 байт
	
	Поток = Новый ФайловыйПоток(ПолноеИмяФайла, РежимОткрытияФайла.Открыть, ДоступКФайлу.Чтение, 47);
	
	// Версия контейнера до 8.3.16 - адресация INT32
	
	Поток.Перейти(16, ПозицияВПотоке.Начало);
	БуферЗаголовокБлока = Новый БуферДвоичныхДанных(31);
	Поток.Прочитать(БуферЗаголовокБлока, 0, 31);
	
	Если ЗаголовокБлокаКорректен(БуферЗаголовокБлока, 8) Тогда
		ПараметрыВерсии = НовыйПараметрыВерсииКонтейнера();
		ПараметрыВерсии.Представление = "32_bit";
		ПараметрыВерсии.РазмерЗаголовкаКонтейнера = 16;
		ПараметрыВерсии.РазмерЗаголовкаБлока = 31;
		ПараметрыВерсии.РазмерПоляАдресации = 4;
		ПараметрыВерсии.РазделительОглавления = ПолучитьБуферДвоичныхДанныхИзHexСтроки("FFFFFF7F");
		ПараметрыВерсии.Смещение = 0;
		ПараметрыВерсии.МаксимальноеЦелоеЧисло = МаксимальноеЗнаковоеЦелоеЧисло32();
	КонецЕсли;
	
	// Версия контейнера с 8.3.16 - адресация INT64
	
	Поток.Перейти(20, ПозицияВПотоке.Начало); // контейнер нового формата без смещения
	БуферЗаголовокБлока = Новый БуферДвоичныхДанных(55);
	Поток.Прочитать(БуферЗаголовокБлока, 0, 55);
	
	Если ЗаголовокБлокаКорректен(БуферЗаголовокБлока, 16) Тогда
		ПараметрыВерсии = НовыйПараметрыВерсииКонтейнера();
		ПараметрыВерсии.Представление = "64_bit";
		ПараметрыВерсии.РазмерЗаголовкаКонтейнера = 20;
		ПараметрыВерсии.РазмерЗаголовкаБлока = 55;
		ПараметрыВерсии.РазмерПоляАдресации = 8;
		ПараметрыВерсии.РазделительОглавления = ПолучитьБуферДвоичныхДанныхИзHexСтроки("FFFFFFFFFFFFFFFF");
		ПараметрыВерсии.Смещение = 0;
		ПараметрыВерсии.МаксимальноеЦелоеЧисло = МаксимальноеБеззнаковоеЦелоеЧисло64();
	КонецЕсли;
	
	Поток.Перейти(4973, ПозицияВПотоке.Начало); // контейнер нового формата со смещением 0x1359
	БуферЗаголовокБлока = Новый БуферДвоичныхДанных(55);
	Поток.Прочитать(БуферЗаголовокБлока, 0, 55);
	
	Если ЗаголовокБлокаКорректен(БуферЗаголовокБлока, 16) Тогда
		ПараметрыВерсии = НовыйПараметрыВерсииКонтейнера();
		ПараметрыВерсии.Представление = "64_bit_offset_0x1359";
		ПараметрыВерсии.РазмерЗаголовкаКонтейнера = 20;
		ПараметрыВерсии.РазмерЗаголовкаБлока = 55;
		ПараметрыВерсии.РазмерПоляАдресации = 8;
		ПараметрыВерсии.РазделительОглавления = ПолучитьБуферДвоичныхДанныхИзHexСтроки("FFFFFFFFFFFFFFFF");
		ПараметрыВерсии.Смещение = 4953; // 0x1359
		ПараметрыВерсии.МаксимальноеЦелоеЧисло = МаксимальноеБеззнаковоеЦелоеЧисло64();
	КонецЕсли;
	
	Поток.Закрыть();
	
	Возврат ПараметрыВерсии;
	
КонецФункции

Функция ЗаголовокБлокаКорректен(БуферЗаголовокБлока, РазмерПоля = 8)
	
	ПоляЗаголовка = БуферЗаголовокБлока.Разделить(п_Разделители);
	
	Возврат ПоляЗаголовка.Количество() = 6 
		И ПоляЗаголовка[1].Размер = РазмерПоля 
		И ПоляЗаголовка[2].Размер = РазмерПоля
		И ПоляЗаголовка[3].Размер = РазмерПоля;
	
КонецФункции 

Функция ПолучитьЗаголовокБлока(ПараметрыВерсии, РазмерДокумента, РазмерТекБлока, АдресСледБлока = Неопределено)
	
	// [CRLF][Размер всего документа][Пробел][Размер текущего блока][Пробел][Адрес следующего блока][Пробел][CRLF]
	
	ЗаголовокБлока = ПараметрыВерсии.ШаблонЗаголовкаБлока.Скопировать();
	
	РазмерПоля = ПараметрыВерсии.РазмерПоляАдресации * 2;
	
	БайтыРазмерДокумента = БайтыИзЧисла(РазмерДокумента, ПараметрыВерсии.РазмерПоляАдресации);
	ЗаголовокБлока.Записать(2, БайтыРазмерДокумента);
	
	БайтыРазмерТекБлока = БайтыИзЧисла(РазмерТекБлока, ПараметрыВерсии.РазмерПоляАдресации);
	ЗаголовокБлока.Записать(3 + РазмерПоля, БайтыРазмерТекБлока);
	
	Если АдресСледБлока <> Неопределено Тогда
		БайтыАдресСледБлока = БайтыИзЧисла(АдресСледБлока, ПараметрыВерсии.РазмерПоляАдресации);
		ЗаголовокБлока.Записать(4 + РазмерПоля * 2, БайтыАдресСледБлока);
	КонецЕсли;
	
	Возврат ЗаголовокБлока;
	
КонецФункции

Процедура РаспаковатьПотокВКаталог(Поток, Каталог, Инфлэйт = Ложь, Расширение = Неопределено, СтарыйФормат = Истина)
	
	Если СтарыйФормат Тогда
		Поток.Перейти(16, ПозицияВПотоке.Текущая);
	Иначе
		Поток.Перейти(20, ПозицияВПотоке.Текущая);
	КонецЕсли;
	
	ПотокОглавления = ПолучитьПотокИзКонтейнера(Поток, , СтарыйФормат);
	
	Если СтарыйФормат Тогда
		Если ПотокОглавления.Размер() % 12 <> 0 Тогда // 4 4 4 (12 байтов)
			ВызватьИсключение "Ошибка чтения потока из контейнера. Размер потока оглавления контейнера не кратен 12.";
		КонецЕсли;
		КоличествоФайлов = Цел(ПотокОглавления.Размер() / 12);
	Иначе
		Если ПотокОглавления.Размер() % 24 <> 0 Тогда // 8 8 8 (24 байта)
			ВызватьИсключение "Ошибка чтения потока из контейнера. Размер потока оглавления контейнера не кратен 24.";
		КонецЕсли;
		КоличествоФайлов = Цел(ПотокОглавления.Размер() / 24);
	КонецЕсли;
	
	п_ДДПотокаОглавления = ПотокОглавления.ЗакрытьИПолучитьДвоичныеДанные();
	ЧтениеОглавления = Новый ЧтениеДанных(п_ДДПотокаОглавления, , ПорядокБайтов.LittleEndian);
	
	Для Ин = 1 По КоличествоФайлов Цикл
		Если СтарыйФормат Тогда
			АдресЗаголовкаФайла = ЧтениеОглавления.ПрочитатьЦелое32(); // 4 байта адрес документа атрибутов файла
			АдресТелаФайла = ЧтениеОглавления.ПрочитатьЦелое32(); // 4 байта адрес документа содержимого файлов (адрес начала тела файла в контейнере)
			ЧтениеОглавления.Пропустить(4); // 4 байта зарезервированное поле (7FFFFFFF)
		Иначе
			АдресЗаголовкаФайла = ЧтениеОглавления.ПрочитатьЦелое64(); // 8 байтов
			АдресЗаголовкаФайла = АдресЗаголовкаФайла + 4953;
			АдресТелаФайла = ЧтениеОглавления.ПрочитатьЦелое64(); // 8 байтов
			АдресТелаФайла = АдресТелаФайла + 4953;
			ЧтениеОглавления.Пропустить(8); // 8 байтов
		КонецЕсли;
		Поток.Перейти(АдресЗаголовкаФайла, ПозицияВПотоке.Начало);
		ПотокЗаголовка = ПолучитьПотокИзКонтейнера(Поток, , СтарыйФормат);
		п_ДДПотокаЗаголовка = ПотокЗаголовка.ЗакрытьИПолучитьДвоичныеДанные();
		ЧтениеЗаголовка = Новый ЧтениеДанных(п_ДДПотокаЗаголовка, КодировкаТекста.UTF16, ПорядокБайтов.LittleEndian);
		ЧтениеЗаголовка.Пропустить(20);
		ИмяФайла = СтрЗаменить(ЧтениеЗаголовка.ПрочитатьСтроку(), Символ(0), ""); // все оставшееся тело документа (за вычетом 2-х дат и резервного поля)
		ИмяТекущегоФайла = Каталог + "\" + ИмяФайла;
		ПотокФайлаВПамяти = Новый ПотокВПамяти;
		Поток.Перейти(АдресТелаФайла, ПозицияВПотоке.Начало);
		Если Инфлэйт Тогда
			ПотокДляРаспаковки = Новый ПотокВПамяти;
			ПолучитьПотокИзКонтейнера(Поток, ПотокДляРаспаковки, СтарыйФормат);
			п_ДанныеФайла = ПотокДляРаспаковки.ЗакрытьИПолучитьДвоичныеДанные();
			Если НЕ НачинаетсяСBOMИзБуфера(п_ДанныеФайла) Тогда
				п_ДанныеФайла = ИнфлэйтВПамятиИзДвоичныхДанныхВДвоичныеДанныеЧерезХранилищеЗначения(п_ДанныеФайла);
			КонецЕсли;
			п_ФайлTemp = ПолучитьИмяВременногоФайла();
			п_ДанныеФайла.Записать(п_ФайлTemp);
			п_ЧтениеПотока = Новый ЧтениеДанных(п_ФайлTemp, КодировкаТекста.ANSI, ПорядокБайтов.LittleEndian);
			п_БуферДД = п_ЧтениеПотока.ПрочитатьВБуферДвоичныхДанных();
			ПотокФайлаВПамяти = Новый ПотокВПамяти(п_БуферДД);
			п_ЧтениеПотока.Закрыть();
			УдалитьФайлы(п_ФайлTemp);
		Иначе
			ПолучитьПотокИзКонтейнера(Поток, ПотокФайлаВПамяти, СтарыйФормат);
		КонецЕсли;
		Если ПотокЯвляетсяКонтейнером(ПотокФайлаВПамяти) Тогда
			ПроверитьИСоздатьКаталог(ИмяТекущегоФайла);
			РаспаковатьПотокВКаталог(ПотокФайлаВПамяти, ИмяТекущегоФайла, , Расширение, Истина);
		Иначе
			ПотокФайла = Новый ФайловыйПоток(ИмяТекущегоФайла, РежимОткрытияФайла.Создать, ДоступКФайлу.Запись);
			ПотокФайлаВПамяти.КопироватьВ(ПотокФайла);
			ПотокФайла.Закрыть();
			Если Расширение = ".hbk" И ИмяФайла = "FileStorage" ИЛИ ИмяФайла = "PackBlock" ИЛИ ИмяФайла = "IndexPackBlock" Тогда
				ПереместитьФайл(ИмяТекущегоФайла, ИмяТекущегоФайла + ".zip");
			КонецЕсли;
		КонецЕсли;
		ПотокФайлаВПамяти.Закрыть();
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПотокИзКонтейнера(ПотокИз, Поток = Неопределено, СтарыйФормат)
	
	Чтение = Новый ЧтениеДанных(ПотокИз, КодировкаТекста.ANSI, ПорядокБайтов.LittleEndian);
	
	Если СтарыйФормат Тогда
		//заголовок блока представляет собой строку длиной 31 байт
		//[CRLF][Размер всего документа][Пробел][Размер текущего блока][Пробел][Адрес следующего блока][Пробел][CRLF]
		//CRLF – стандартный перевод строки Windows, пара символов \r\n (0x0D,0x0A)
		Чтение.Пропустить(2); // 0D 0A
		ДлинаФайла = ЧислоИзШестнадцатеричнойСтроки("0x" + Чтение.ПрочитатьСимволы(8));
		Чтение.Пропустить(1); // Пробел 20
		ДлинаБлока = ЧислоИзШестнадцатеричнойСтроки("0x" + Чтение.ПрочитатьСимволы(8));
		Чтение.Пропустить(1); // Пробел 20
		СледующийБлок = ЧислоИзШестнадцатеричнойСтроки("0x" + Чтение.ПрочитатьСимволы(8));
		Чтение.Пропустить(3); // 20 0D 0A
		МаксимальноеЦелоеЧисло = МаксимальноеЗнаковоеЦелоеЧисло32();
	Иначе
		//заголовок блока представляет собой строку длиной 55 байтов
		Чтение.Пропустить(2); // 0D 0A
		ДлинаФайла = ЧислоИзШестнадцатеричнойСтроки("0x" + Чтение.ПрочитатьСимволы(16));
		Чтение.Пропустить(1); // Пробел 20
		ДлинаБлока = ЧислоИзШестнадцатеричнойСтроки("0x" + Чтение.ПрочитатьСимволы(16));
		Чтение.Пропустить(1); // Пробел 20
		СледующийБлок = ЧислоИзШестнадцатеричнойСтроки("0x" + Чтение.ПрочитатьСимволы(16)) + 4953;
		Чтение.Пропустить(3); // 20 0D 0A
		МаксимальноеЦелоеЧисло = МаксимальноеБеззнаковоеЦелоеЧисло64();
	КонецЕсли;
	
	Если Поток = Неопределено Тогда
		Поток = Новый ПотокВПамяти(ДлинаФайла);
	КонецЕсли;
	
	Запись = Новый ЗаписьДанных(Поток); // собираем документ из нескольких блоков
	ОсталосьПрочитать = ДлинаФайла;
	Читаем = Мин(ДлинаБлока, ОсталосьПрочитать);
	Буфер = Чтение.ПрочитатьВБуферДвоичныхДанных(Читаем);
	Чтение.Закрыть();
	Запись.ЗаписатьБуферДвоичныхДанных(Буфер);
	ОсталосьПрочитать = ОсталосьПрочитать - Читаем;
	
	Пока СледующийБлок < МаксимальноеЦелоеЧисло Цикл
		Если ОсталосьПрочитать = 0 Тогда
			ВызватьИсключение "Ошибка чтения потока из контейнера. Все байты прочитаны, но цепочка блоков не кончилась.";
		КонецЕсли;
		ПотокИз.Перейти(СледующийБлок, ПозицияВПотоке.Начало);
		Чтение = Новый ЧтениеДанных(ПотокИз, КодировкаТекста.ANSI, ПорядокБайтов.LittleEndian);
		Если СтарыйФормат Тогда
			Чтение.Пропустить(11);
			ДлинаБлока = ЧислоИзШестнадцатеричнойСтроки("0x" + Чтение.ПрочитатьСимволы(8));
			Чтение.Пропустить(1);
			СледующийБлок = ЧислоИзШестнадцатеричнойСтроки("0x" + Чтение.ПрочитатьСимволы(8));
			Чтение.Пропустить(3);
		Иначе
			Чтение.Пропустить(19);
			ДлинаБлока = ЧислоИзШестнадцатеричнойСтроки("0x" + Чтение.ПрочитатьСимволы(16));
			Чтение.Пропустить(1);
			СледующийБлок = ЧислоИзШестнадцатеричнойСтроки("0x" + Чтение.ПрочитатьСимволы(16)) + 4953;
			Чтение.Пропустить(3);
		КонецЕсли;
		Если ДлинаБлока = 0 Тогда
			ВызватьИсключение "Ошибка чтения потока из контейнера. Длина блока = 0.";
		КонецЕсли;
		Читаем = Мин(ДлинаБлока, ОсталосьПрочитать);
		Буфер = Чтение.ПрочитатьВБуферДвоичныхДанных(Читаем);
		Чтение.Закрыть();
		Запись.ЗаписатьБуферДвоичныхДанных(Буфер);
		ОсталосьПрочитать = ОсталосьПрочитать - Читаем;
	КонецЦикла;
	
	Запись.Закрыть();
	
	Если ОсталосьПрочитать > 0 Тогда
		ВызватьИсключение "Ошибка чтения потока из контейнера. Поток не считан до конца, но цепочка блоков закончилась.";
	КонецЕсли;
	
	Поток.Перейти(0, ПозицияВПотоке.Начало);
	
	Возврат Поток;
	
КонецФункции

Функция ПотокЯвляетсяКонтейнером(Поток)
	
	Поток.Перейти(0, ПозицияВПотоке.Начало);
	Чтение = Новый ЧтениеДанных(Поток, , ПорядокБайтов.LittleEndian);
	РазмерПотока = Поток.Размер();
	
	Если РазмерПотока = 16 Тогда
		Если Чтение.ПрочитатьЦелое32() = МаксимальноеЗнаковоеЦелоеЧисло32()
			И Чтение.ПрочитатьЦелое32() = 512
			И Чтение.ПрочитатьЦелое32() = 0
			И Чтение.ПрочитатьЦелое32() = 0 Тогда
			Поток.Перейти(0, ПозицияВПотоке.Начало);
			Возврат Истина;
		КонецЕсли;
		Поток.Перейти(0, ПозицияВПотоке.Начало);
		Возврат Ложь;
	КонецЕсли;
	
	Если РазмерПотока < 47 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПервыйСвободныйБлок = Чтение.ПрочитатьЦелое32();
	
	Если ПервыйСвободныйБлок > МаксимальноеЗнаковоеЦелоеЧисло32() Тогда
		Поток.Перейти(0, ПозицияВПотоке.Начало);
		Возврат Ложь;
	ИначеЕсли ПервыйСвободныйБлок < МаксимальноеЗнаковоеЦелоеЧисло32() Тогда
		Если ПервыйСвободныйБлок + 31 >= РазмерПотока Тогда
			Поток.Перейти(0, ПозицияВПотоке.Начало);
			Возврат Ложь;
		КонецЕсли;
		Поток.Перейти(ПервыйСвободныйБлок, ПозицияВПотоке.Начало);
		Чтение = Новый ЧтениеДанных(Поток, , ПорядокБайтов.LittleEndian);
		Если Чтение.ПрочитатьБайт() <> 13 Тогда
			Поток.Перейти(0, ПозицияВПотоке.Начало);
			Возврат Ложь;
		КонецЕсли;
		Если Чтение.ПрочитатьБайт() <> 10 Тогда
			Поток.Перейти(0, ПозицияВПотоке.Начало);
			Возврат Ложь;
		КонецЕсли;
		Чтение.Пропустить(8);
		Если Чтение.ПрочитатьБайт() <> 32 Тогда
			Поток.Перейти(0, ПозицияВПотоке.Начало);
			Возврат Ложь;
		КонецЕсли;
		Чтение.Пропустить(8);
		Если Чтение.ПрочитатьБайт() <> 32 Тогда
			Поток.Перейти(0, ПозицияВПотоке.Начало);
			Возврат Ложь;
		КонецЕсли;
		Чтение.Пропустить(8);
		Если Чтение.ПрочитатьБайт() <> 32 Тогда
			Поток.Перейти(0, ПозицияВПотоке.Начало);
			Возврат Ложь;
		КонецЕсли;
		Если Чтение.ПрочитатьБайт() <> 13 Тогда
			Поток.Перейти(0, ПозицияВПотоке.Начало);
			Возврат Ложь;
		КонецЕсли;
		Если Чтение.ПрочитатьБайт() <> 10 Тогда
			Поток.Перейти(0, ПозицияВПотоке.Начало);
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Поток.Перейти(16, ПозицияВПотоке.Начало);
	Чтение = Новый ЧтениеДанных(Поток, , ПорядокБайтов.LittleEndian);
	
	Если Чтение.ПрочитатьБайт() <> 13 Тогда
		Поток.Перейти(0, ПозицияВПотоке.Начало);
		Возврат Ложь;
	КонецЕсли;
	
	Если Чтение.ПрочитатьБайт() <> 10 Тогда
		Поток.Перейти(0, ПозицияВПотоке.Начало);
		Возврат Ложь;
	КонецЕсли;
	
	Чтение.Пропустить(8);
	
	Если Чтение.ПрочитатьБайт() <> 32 Тогда
		Поток.Перейти(0, ПозицияВПотоке.Начало);
		Возврат Ложь;
	КонецЕсли;
	
	Чтение.Пропустить(8);
	
	Если Чтение.ПрочитатьБайт() <> 32 Тогда
		Поток.Перейти(0, ПозицияВПотоке.Начало);
		Возврат Ложь;
	КонецЕсли;
	
	Чтение.Пропустить(8);
	
	Если Чтение.ПрочитатьБайт() <> 32 Тогда
		Поток.Перейти(0, ПозицияВПотоке.Начало);
		Возврат Ложь;
	КонецЕсли;
	
	Если Чтение.ПрочитатьБайт() <> 13 Тогда
		Поток.Перейти(0, ПозицияВПотоке.Начало);
		Возврат Ложь;
	КонецЕсли;
	
	Если Чтение.ПрочитатьБайт() <> 10 Тогда
		Поток.Перейти(0, ПозицияВПотоке.Начало);
		Возврат Ложь;
	КонецЕсли;
	
	Поток.Перейти(0, ПозицияВПотоке.Начало);
	
	Возврат Истина;
	
КонецФункции

Процедура СформироватьКонтейнер(Знач ПараметрыСборки)
	
	ПотокЗаписи = Новый ФайловыйПоток(ПараметрыСборки.ИмяЦелевогоФайла, РежимОткрытияФайла.ОткрытьИлиСоздать, ДоступКФайлу.Запись);
	
	ПараметрыВерсии = ОпределитьПараметрыВерсииКонтейнера(ПараметрыСборки);
	
	Если ПараметрыВерсии.Представление = "64_bit_offset_0x1359" Тогда
		КонтейнерЗаглушкаБуфер = ПолучитьБуферДвоичныхДанныхИзBase64Строки(
			"////fwACAAAFAAAAAAAAAA0KMDAwMDAwM2MgMDAwMDAyMDAgN2ZmZmZmZmYgDQov
			|AgAArgIAAP///3+TCQAAEgoAAP///38xDAAAcAwAAP///3+PDgAA1A4AAP///3/z
			|EAAAOhEAAP///38AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
			|AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
			|AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
			|AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
			|AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
			|AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
			|AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
			|AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
			|AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
			|AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA0KMDAwMDAwNjAgMDAwMDAw
			|NjAgN2ZmZmZmZmYgDQrwUIddXUMCAPBQh11dQwIAAAAAADMAMABmAGYAZQA0AGMA
			|YwAtAGUAZQBmADIALQA0ADMANwAxAC0AOABiADIANgAtADAANAA2ADUAOQA3AGUA

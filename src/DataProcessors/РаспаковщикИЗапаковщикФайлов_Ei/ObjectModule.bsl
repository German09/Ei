Функция ДефлэйтИзДвоичныхДанныхВДвоичныеДанныеЧерезЗаписьZipФайла(ДвоичныеДанные)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	СжатыйФайл = ДефлэйтИзФайлаВДвоичныеДанныеЧерезЗаписьZipФайла(ИмяВременногоФайла);
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат СжатыйФайл;
	
КонецФункции 

Функция ДефлэйтИзФайлаВДвоичныеДанныеЧерезЗаписьZipФайла(ИмяФайлаДляСжатия)
	
	// Костыль для пустого файла с BOM. ЗаписьZip в этом случае не работает.
	Если ФайлСодержитТолькоBOM(ИмяФайлаДляСжатия) Тогда
		Возврат ПолучитьДвоичныеДанныеИзHexСтроки("7BBF7B3F00");
	КонецЕсли;
	
	ПотокДанных = Новый ПотокВПамяти;
	
	ЗаписьZip = Новый ЗаписьZipФайла(ПотокДанных, , , МетодСжатияZIP.Сжатие, УровеньСжатияZIP.Оптимальный);
	ЗаписьZip.Добавить(ИмяФайлаДляСжатия);
	ЗаписьZip.Записать();
	
	ПотокДанных.Перейти(18, ПозицияВПотоке.Начало);
	
	//ЧтениеПотока = Новый ЧтениеДанных(ПотокДанных);
	//РазмерСжатыхДанных = ЧтениеПотока.ПрочитатьЦелое32();
	//ЧтениеПотока.Пропустить(4);
	//РазмерИмениФайла = ЧтениеПотока.ПрочитатьЦелое16();
	//РазмерИмениДоп = ЧтениеПотока.ПрочитатьЦелое16();
	//ЧтениеПотока.Пропустить(РазмерИмениФайла + РазмерИмениДоп);
	//ДанныеПотока = ЧтениеПотока.Прочитать(РазмерСжатыхДанных).ПолучитьДвоичныеДанные();
	//ЧтениеПотока.Закрыть();
	//ПотокДанных.Закрыть();
	//
	//Возврат ДанныеПотока;
	
	Буфер = Новый БуферДвоичныхДанных(12, ПорядокБайтов.LittleEndian);
	ПотокДанных.Прочитать(Буфер, 0, 12);
	РазмерСжатыхДанных = Буфер.ПрочитатьЦелое32(0);
	РазмерИмениФайла = Буфер.ПрочитатьЦелое16(8);
	РазмерИмениДоп = Буфер.ПрочитатьЦелое16(10);
	
	ПотокДанных.Перейти(РазмерИмениФайла + РазмерИмениДоп, ПозицияВПотоке.Текущая);
	
	БуферСжатыеДанные = Новый БуферДвоичныхДанных(РазмерСжатыхДанных);
	ПотокДанных.Прочитать(БуферСжатыеДанные, 0, РазмерСжатыхДанных);
	ПотокДанных.Закрыть();
	
	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(БуферСжатыеДанные);
	
КонецФункции

Функция ИнфлэйтИзДвоичныхДанныхВДвоичныеДанныеЧерезЧтениеZipФайла(Знач ДвоичныеДанные)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	п_Файл = Новый Файл(ИмяВременногоФайла);
	
	ИнфлэйтВФайлЧерезЧтениеZipФайла(ДвоичныеДанные, п_Файл.Имя, п_Файл.Путь);
	
	п_ДвоичныеДанные = Новый ДвоичныеДанные(п_Файл.ПолноеИмя);
	
	УдалитьФайлы(п_Файл.ПолноеИмя);
	
	Возврат п_ДвоичныеДанные;
	
КонецФункции

Процедура ИнфлэйтВФайлЧерезЧтениеZipФайла(Знач ДанныеИсточник, Знач ИмяФайлаДляСохранения, Знач КаталогДляСохранения)
	
	Если ТипЗнч(ДанныеИсточник) = Тип(п_Тип_ДвоичныеДанные) Тогда
		ДанныеИсточник = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДанныеИсточник);
	ИначеЕсли ТипЗнч(ДанныеИсточник) = Тип(п_Тип_Строка) Тогда
		ЧтениеДанных = Новый ЧтениеДанных(ДанныеИсточник);
		ДанныеИсточник = ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных();
		ЧтениеДанных.Закрыть();
	КонецЕсли;
	
	п_ФайлTemp = ПолучитьИмяВременногоФайла();
	
	РазмерСжатыхДанных = ДанныеИсточник.Размер;
	БуферИмениФайла = ПолучитьБуферДвоичныхДанныхИзСтроки(ИмяФайлаДляСохранения);
	РазмерИмениФайла = БуферИмениФайла.Размер;
	РазмерРаспакованных = 4294967294;
	
	// Zip-архив из одного файла собирается в памяти по шаблонам заголовков (LFH, CDFH, EOCD)
	БуферШаблонЗаголовка = ПолучитьБуферДвоичныхДанныхИзBase64Строки(
		"UEsDBBQAAAgIAHVMRlNrSuSX/kQAACV6AAAKAAAA");
	БуферШаблонЗаголовкаДир = ПолучитьБуферДвоичныхДанныхИзBase64Строки(
		"UEsBAi4DFAAACAgAdUxGU2tK5Jf+RAAAJXoAAAoAAAAAAAAAAAAAALSBAAAAAA==");
	БуферШаблонДескриптораДир = ПолучитьБуферДвоичныхДанныхИзBase64Строки(
		"UEsFBgAAAAABAAEAXAAAACZFAAAAAA==");
	
	БуферШаблонЗаголовка.ЗаписатьЦелое32(18, РазмерСжатыхДанных, ПорядокБайтов.LittleEndian);
	БуферШаблонЗаголовка.ЗаписатьЦелое32(22, РазмерРаспакованных, ПорядокБайтов.LittleEndian);
	БуферШаблонЗаголовка.ЗаписатьЦелое16(26, РазмерИмениФайла, ПорядокБайтов.LittleEndian);
	БуферЗаголовкаАрхива = БуферШаблонЗаголовка.Соединить(БуферИмениФайла);
	
	БуферШаблонЗаголовкаДир.ЗаписатьЦелое32(20, РазмерСжатыхДанных, ПорядокБайтов.LittleEndian);
	БуферШаблонЗаголовкаДир.ЗаписатьЦелое32(24, РазмерРаспакованных, ПорядокБайтов.LittleEndian);
	БуферШаблонЗаголовкаДир.ЗаписатьЦелое16(28, РазмерИмениФайла, ПорядокБайтов.LittleEndian);
	БуферШаблонЗаголовкаДир = БуферШаблонЗаголовкаДир.Соединить(БуферИмениФайла);
	
	БуферШаблонДескриптораДир.ЗаписатьЦелое32(12, БуферШаблонЗаголовкаДир.Размер, ПорядокБайтов.LittleEndian);
	БуферШаблонДескриптораДир.ЗаписатьЦелое32(16, БуферЗаголовкаАрхива.Размер + РазмерСжатыхДанных, ПорядокБайтов.LittleEndian);
	
	БуферКонцаАрхива = БуферШаблонЗаголовкаДир.Соединить(БуферШаблонДескриптораДир);
	
	п_ФайловыйПоток = Новый ФайловыйПоток(п_ФайлTemp, РежимОткрытияФайла.Создать, ДоступКФайлу.ЧтениеИЗапись);
	п_ФайловыйПоток.Записать(БуферЗаголовкаАрхива, 0, БуферЗаголовкаАрхива.Размер);
	п_ФайловыйПоток.Записать(ДанныеИсточник, 0, ДанныеИсточник.Размер);
	п_ФайловыйПоток.Записать(БуферКонцаАрхива, 0, БуферКонцаАрхива.Размер);

	п_ЧтениеZip = Новый ЧтениеZipФайла(п_ФайловыйПоток);
	
	Попытка
		п_ЧтениеZip.Извлечь(п_ЧтениеZip.Элементы[0], КаталогДляСохранения);
	Исключение
	КонецПопытки;
	
	п_ЧтениеZip.Закрыть();
	
	п_ФайловыйПоток.Закрыть();
	
	УдалитьФайлы(п_ФайлTemp);
	
КонецПроцедуры

Функция ПолучитьХранилищеЗначенияИзДвоичныхДанныхЧерезЗаписьZipФайла(ДвоичныеДанные)
	
	БуферДанных = Новый БуферДвоичныхДанных(8);
	БуферДанных.ЗаписатьЦелое64(0,  ДвоичныеДанные.Размер());
	HexСтрока = ПолучитьHexСтрокуИзДвоичныхДанных(ДвоичныеДанные);
	HexСтрока = "3D00000000000000EFBBBF7B2223222C38373132363230302D336539382D343465302D623933312D6363623164376564633439372C0D0A7B312C0D0A7B307D0D0A7D0D0A7D00000000" + ПолучитьHexСтрокуИзБуфераДвоичныхДанных(БуферДанных) + HexСтрока;
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзHexСтроки(HexСтрока);
	HexСтрока = ПолучитьHexСтрокуИзДвоичныхДанных(ДефлэйтИзДвоичныхДанныхВДвоичныеДанныеЧерезЗаписьZipФайла(ДвоичныеДанные));
	СводныйФайл = ПолучитьДвоичныеДанныеИзHexСтроки("0201534B6FF4888DC14EA0D5EBB6BDA0A70D" + HexСтрока);
	
	Возврат XMLЗначение(Тип(п_Тип_ХранилищеЗначения), ПолучитьBase64СтрокуИзДвоичныхДанных(СводныйФайл));
	
КонецФункции 

Функция ПолучитьДвоичныеДанныеИзХранилищаЗначенияЧерезЧтениеZipФайла(Знач ХранилищеЗначения)
	
	HexСтрока = ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзBase64Строки(XmlСтрока(ХранилищеЗначения)));
	ДанныеФайла = ИнфлэйтИзДвоичныхДанныхВДвоичныеДанныеЧерезЧтениеZipФайла(ПолучитьДвоичныеДанныеИзHexСтроки(Сред(HexСтрока, 37)));
	
	Возврат ПолучитьДвоичныеДанныеИзHexСтроки(Сред(ПолучитьHexСтрокуИзДвоичныхДанных(ДанныеФайла), 163));
	
КонецФункции


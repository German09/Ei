КонецФункции

Функция ПолучитьДанныеБлобИзБуфераПоНомеруБлока(хБуферФайлаБлоб, НомерБлока)
	
	Если хБуферФайлаБлоб = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПотокДанных = Новый ПотокВПамяти;
	ЗаписьДанных = Новый ЗаписьДанных(ПотокДанных);
	лТекущийНомерБлока = НомерБлока;
	лОбщийРазмерДанных = 0;
	
	Пока Истина Цикл
		Если лТекущийНомерБлока = 0 Тогда
			Прервать;
		КонецЕсли;
		лСледующийНомерБлока = хБуферФайлаБлоб.ПрочитатьЦелое32(лТекущийНомерБлока * 256);
		лДлинаБлокаДанных = хБуферФайлаБлоб.ПрочитатьЦелое16(лТекущийНомерБлока * 256 + 4);
		хБуфер2 = хБуферФайлаБлоб.Прочитать(лТекущийНомерБлока * 256 + 6, лДлинаБлокаДанных);
		ЗаписьДанных.ЗаписатьБуферДвоичныхДанных(хБуфер2);
		лОбщийРазмерДанных = лОбщийРазмерДанных + лДлинаБлокаДанных;
		лТекущийНомерБлока = лСледующийНомерБлока;
	КонецЦикла;
	
	ЗаписьДанных.Закрыть();
	ПотокДанных.Перейти(0, ПозицияВПотоке.Начало);
	ЧтениеФайла = Новый ЧтениеДанных(ПотокДанных, КодировкаТекста.ANSI, ПорядокБайтов.LittleEndian);
	хБуферДанных = ЧтениеФайла.ПрочитатьВБуферДвоичныхДанных(лОбщийРазмерДанных);
	ЧтениеФайла.Закрыть();
	
	Возврат хБуферДанных;
	
КонецФункции

Функция ПолучитьДанныеИзБуфера(хБуфер, ТипДанных, НачалоДанных, КоличествоБайтов)
	
	Результат = Неопределено;
	
	Если ТипДанных = п_Тип_Строка ИЛИ ТипДанных = "Строка0_1251" Тогда
		лС1251 = " !""#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_`abcdefghijklmnopqrstuvwxyz{|}~ЂЃ‚ѓ„…†‡€‰Љ‹ЊЌЋЏђ‘’“”•–—™љ›њќћџ ЎўЈ¤Ґ¦§Ё©Є«¬®Ї°±Ііґµ¶·ё№є»јЅѕїАБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдежзийклмнопрстуфхцчшщъыьэюя";
		лСимволЗаменыСлужебныхСимволов = " ";
		лСтрока1 = "";
		Для лЦикл1 = НачалоДанных По НачалоДанных + КоличествоБайтов - 1 Цикл
			лТекБайт = хБуфер.Получить(лЦикл1);
			Если лТекБайт = 0 Тогда
				Результат = лСтрока1;
				Прервать;
			КонецЕсли;
			Если лТекБайт < 32 Тогда
				лСтрока1 = лСтрока1 + лСимволЗаменыСлужебныхСимволов;
				Продолжить;
			КонецЕсли;
			лТекСимвол = Сред(лС1251, лТекБайт - 31, 1);
			лСтрока1 = лСтрока1 + лТекСимвол;
		КонецЦикла;
		Результат = лСтрока1;
	Иначе
		Сообщить("Неизвестный тип данных");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЗаписиТаблицы(п_СтруктураБазы, ПотокКонтейнера, ИмяТаблицы, ПолучатьУдаленные = Ложь, ДляВременнойТаблицы = Ложь, п_ЧитатьПоля = Неопределено, п_НеЧитатьПоля = Неопределено, БлобПоляРежим = 0, Прогресс = 0)
	
	Если ЗначениеЗаполнено(п_ЧитатьПоля) Тогда
		п_ЧитатьПоля = "," + ВРег(СтрЗаменить(п_ЧитатьПоля, " ", "") + ",");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(п_НеЧитатьПоля) Тогда
		п_НеЧитатьПоля = "," + ВРег(СтрЗаменить(п_НеЧитатьПоля, " ", "") + ",");
	КонецЕсли;
	
	п_СтруктураТаблицы = ПолучитьСтруктуруТаблицыПоИмени(п_СтруктураБазы, ПотокКонтейнера, ИмяТаблицы);
	хБуферФайлаData = ПолучитьСодержимоеФайлаБазыПоСтруктуре(п_СтруктураБазы, ПотокКонтейнера, п_СтруктураТаблицы.ФайлДанных);
	лБуферФайлаБлоб = Неопределено;
	
	Если п_СтруктураТаблицы.НомерСтраницыФайлаБлоб <> 0 Тогда
		Если БлобПоляРежим = -1 Тогда
			лБуферФайлаБлоб = ПолучитьСодержимоеФайлаБазыПоСтруктуре(п_СтруктураБазы, ПотокКонтейнера, п_СтруктураТаблицы.ФайлБлоб);
		КонецЕсли;
	КонецЕсли;
	
	// проверка на версию 16 + 16
	л_ВерсияЗаписи32 = Ложь;
	
	Если п_СтруктураТаблицы.Поля.НайтиСтроки(Новый Структура("Имя, Тип, РазмерВБайтах", "_IDRREF", "B", 16)).Количество() > 0 Тогда
		Если п_СтруктураТаблицы.Поля.НайтиСтроки(Новый Структура("Имя, Тип, РазмерВБайтах", "_VERSION", "RV", 16)).Количество() > 0 Тогда
			л_ВерсияЗаписи32 = Истина;
		КонецЕсли;
	КонецЕсли;
	
	лЗаписиТаблицы = Новый ТаблицаЗначений;
	
	Для Каждого ЗначениеСтруктуры Из п_СтруктураТаблицы.Поля Цикл
		лЗаписиТаблицы.Колонки.Добавить(ЗначениеСтруктуры.Имя);
	КонецЦикла;
	
	лКоличествоЗаписей = п_СтруктураТаблицы.ФайлДанных.РазмерСодержимого / п_СтруктураТаблицы.РазмерЗаписиВБайтах;
	
	Для лЦикл1 = 1 По лКоличествоЗаписей - 1 Цикл // нулевую запись всегда пропускаем - она служебная
		
		лУказательНачалаЗаписи = п_СтруктураТаблицы.РазмерЗаписиВБайтах * лЦикл1;
		лУказательНачалаПоля = 0;
		лУдаленнаяЗапись = ?(хБуферФайлаData.Получить(лУказательНачалаЗаписи) = 0, Ложь, Истина);
		
		Если НЕ ПолучатьУдаленные И лУдаленнаяЗапись Тогда
			Продолжить;
		КонецЕсли;
		
		лЗапись = Новый Структура;
		лЗапись.Вставить("B1CD_Deleted", лУдаленнаяЗапись);
		
		Если л_ВерсияЗаписи32 Тогда
			лЗначениеДопПоля = ПолучитьЗначениеПоляИзБуфера(хБуферФайлаData, лБуферФайлаБлоб, п_СтруктураТаблицы.Поля[0], лУказательНачалаЗаписи + 1 + лУказательНачалаПоля, "B1CD_VER32");
			лЗапись.Вставить("_IDRREF", лЗначениеДопПоля._IDRREF);
			лЗапись.Вставить("_VERSION", лЗначениеДопПоля._VERSION);
			лУказательНачалаПоля = 32;
		КонецЕсли;
		
		Для Каждого лТекущееПоле Из п_СтруктураТаблицы.Поля Цикл
			Если лТекущееПоле.Имя = "_IDRREF" ИЛИ лТекущееПоле.Имя = "_VERSION" Тогда
				Продолжить;
			КонецЕсли;
			// проверяем по спискам, нужно ли читать
			Если ЗначениеЗаполнено(п_ЧитатьПоля) И Найти(п_ЧитатьПоля, "," + ВРЕГ(лТекущееПоле.Имя) + ",") = 0 Тогда
				Продолжить;
			ИначеЕсли ЗначениеЗаполнено(п_НеЧитатьПоля) И Найти(п_НеЧитатьПоля, "," + ВРЕГ(лТекущееПоле.Имя) + ",") > 0 Тогда
				Продолжить;
			КонецЕсли;
			// Это блоб тип
			Если лТекущееПоле.Тип = "I" ИЛИ лТекущееПоле.Тип = "T" ИЛИ лТекущееПоле.Тип = "NT" Тогда
				Если БлобПоляРежим = 0 Тогда
					лЗапись.Вставить(лТекущееПоле.Имя, Неопределено);
				ИначеЕсли БлобПоляРежим = 1 Тогда
					л_СтруктураИменДопПолей = Новый Структура;
					л_СтруктураИменДопПолей.Вставить("УдаленнаяЗапись", "B1CD_Deleted");
					л_СтруктураИменДопПолей.Вставить("НачалоДанныхБлоб", "B1CD_" + лТекущееПоле.Имя + "_StartDataIndex");
					л_СтруктураИменДопПолей.Вставить("РазмерДанныхБлоб", "B1CD_" + лТекущееПоле.Имя + "_Length");
					л_СтруктураИменДопПолей.Вставить("ТипПоляБлоб", "B1CD_" + лТекущееПоле.Имя + "_Type");
					л_СтруктураИменДопПолей.Вставить("Binary1616", "B1CD_" + лТекущееПоле.Имя);
					лЗапись.Вставить(лТекущееПоле.Имя, Неопределено);
					лЗапись.Вставить(л_СтруктураИменДопПолей.НачалоДанныхБлоб, Неопределено);
					лЗапись.Вставить(л_СтруктураИменДопПолей.РазмерДанныхБлоб, Неопределено);
					лЗапись.Вставить(л_СтруктураИменДопПолей.ТипПоляБлоб, Неопределено);
					лЗначениеДопПоля = ПолучитьЗначениеПоляИзБуфера(хБуферФайлаData, лБуферФайлаБлоб, лТекущееПоле, лУказательНачалаЗаписи + 1 + лУказательНачалаПоля, "B1CD_" + лТекущееПоле.Тип);
					Если НЕ (лЗначениеДопПоля = Неопределено) Тогда
						лЗапись.Вставить(л_СтруктураИменДопПолей.НачалоДанныхБлоб, лЗначениеДопПоля.НачалоДанных);
						лЗапись.Вставить(л_СтруктураИменДопПолей.РазмерДанныхБлоб, лЗначениеДопПоля.Размер);
						лЗапись.Вставить(л_СтруктураИменДопПолей.ТипПоляБлоб, лЗначениеДопПоля.Тип);
					КонецЕсли;
				ИначеЕсли БлобПоляРежим = 2 Тогда
					лЗначениеПоля = ПолучитьЗначениеПоляИзБуфера(хБуферФайлаData, лБуферФайлаБлоб, лТекущееПоле, лУказательНачалаЗаписи + 1 + лУказательНачалаПоля);
					лЗапись.Вставить(лТекущееПоле.Имя, лЗначениеПоля);
				ИначеЕсли БлобПоляРежим = 3 Тогда
					лЗначениеПоляБлоб = ПолучитьЗначениеПоляИзБуфера(хБуферФайлаData, лБуферФайлаБлоб, лТекущееПоле, лУказательНачалаЗаписи + 1 + лУказательНачалаПоля, "B1CD_" + лТекущееПоле.Тип);
					Если лЗначениеПоляБлоб <> Неопределено Тогда
						лСсылкаБлобСтрокой = "#BLOB," + лЗначениеПоляБлоб.Тип + "," + Формат(лЗначениеПоляБлоб.НачалоДанных, "ЧН=0; ЧГ=0") + "," + Формат(лЗначениеПоляБлоб.Размер, "ЧН=0; ЧГ=0");
					КонецЕсли;
					лЗапись.Вставить(лТекущееПоле.Имя, лСсылкаБлобСтрокой);
				КонецЕсли;
			Иначе	
				лЗначениеПоля = ПолучитьЗначениеПоляИзБуфера(хБуферФайлаData, лБуферФайлаБлоб, лТекущееПоле, лУказательНачалаЗаписи + 1 + лУказательНачалаПоля); // +1 - байт признака удаления записи
				лЗапись.Вставить(лТекущееПоле.Имя, лЗначениеПоля);
				Если лТекущееПоле.Тип = "B" И лТекущееПоле.Длина = 16 Тогда
					лЗначениеДопПоля = ПолучитьЗначениеПоляИзБуфера(хБуферФайлаData, лБуферФайлаБлоб, лТекущееПоле, лУказательНачалаЗаписи + 1 + лУказательНачалаПоля, "B1CD_SGUID");
					лЗапись.Вставить("B1CD_" + лТекущееПоле.Имя, лЗначениеДопПоля);
				ИначеЕсли лТекущееПоле.Тип = "B" Тогда
					лЗначениеДопПоля = ПолучитьЗначениеПоляИзБуфера(хБуферФайлаData, лБуферФайлаБлоб, лТекущееПоле, лУказательНачалаЗаписи + 1 + лУказательНачалаПоля, "B1CD_" + лТекущееПоле.Тип);
					лЗапись.Вставить("B1CD_" + лТекущееПоле.Имя, лЗначениеДопПоля);
				КонецЕсли;
			КонецЕсли;
			лУказательНачалаПоля = лУказательНачалаПоля + лТекущееПоле.РазмерВБайтах;
		КонецЦикла;
		
		Для Каждого ТекЭлем Из лЗапись Цикл
			Если лЗаписиТаблицы.Колонки.Найти(ТекЭлем.Ключ) = Неопределено Тогда
				лЗаписиТаблицы.Колонки.Добавить(ТекЭлем.Ключ, , Новый ОписаниеТипов(Строка(ТипЗнч(ТекЭлем.Значение))));
			КонецЕсли;
		КонецЦикла;
		
		ЗаполнитьЗначенияСвойств(лЗаписиТаблицы.Добавить(), лЗапись);
		
	КонецЦикла;
	
	Возврат лЗаписиТаблицы;
	
КонецФункции

Функция ПолучитьЗначениеПоляИзБуфера(хБуферФайлаData, лБуферФайлаБлоб, Поле, УказательНачалаПоля, ДопТип = Неопределено)
	
	Результат = Неопределено;
	лТипПоля = ВРег(Поле.Тип);
	
	Если ЗначениеЗаполнено(ДопТип) Тогда
		лТипПоля = ВРег(ДопТип);
	КонецЕсли;
	
	лУказатель = УказательНачалаПоля;
	лРазмерДанных = Поле.РазмерВБайтах;
	
	Если Поле.ФлагПустое = 1 Тогда
		лУказатель = лУказатель + 1;
		//лЗначПустое = хБуферФайлаData.Получить(лУказатель);
		//Если лЗначПустое = 1 Тогда
		//	//Возврат Неопределено;
		//КонецЕсли;
		лРазмерДанных = лРазмерДанных - 1;
	КонецЕсли;
	
	// обработка системных полей
	//	Если ВРЕГ(Поле.Имя) = "_IDRREF" Тогда
	//		хБуфер = хБуферФайлаData.Прочитать(лУказатель+16, лРазмерДанных);
	//		Возврат ПолучитьBase64СтрокуИзБуфераДвоичныхДанных(хБуфер);
	//	КонецЕсли;
	//	Если лТипПоля = "RV" И ВРЕГ(Поле.Имя)= "_VERSION" Тогда
	//		Возврат ПолучитьВерсиюИзБуфера(хБуферФайлаData, лУказатель - 16, лРазмерДанных);
	//	КонецЕсли;
	
	// обрабатываем обычные поля
	Если лТипПоля = "B" Тогда
		хБуфер = хБуферФайлаData.Прочитать(лУказатель, лРазмерДанных);
		Результат = ПолучитьBase64СтрокуИзБуфераДвоичныхДанных(хБуфер);
	ИначеЕсли лТипПоля = "L" Тогда
		Результат = ?(хБуферФайлаData.Получить(лУказатель) = 1, Истина, Ложь);
	ИначеЕсли лТипПоля = "N" Тогда
		хБуфер = хБуферФайлаData.Прочитать(лУказатель, лРазмерДанных);
		лСтрока = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(хБуфер);
		лСтрока1 = Сред(лСтрока, 2, Поле.Длина);
		Если Поле.Точность <> 0 Тогда
			лСтрока2 = Лев(лСтрока1, СтрДлина(лСтрока1) - Поле.Точность) + "." + Прав(лСтрока1, Поле.Точность);
		Иначе
			лСтрока2 = лСтрока1;
		КонецЕсли;
		Попытка
			Результат = Число(?(Лев(лСтрока, 1) = "1", "", "-") + лСтрока2);
		Исключение
			ВызватьИсключение "Ошибка при преобразовании в число: " + лСтрока2;
		КонецПопытки;
	ИначеЕсли лТипПоля = "NC" Тогда
		хБуфер = хБуферФайлаData.Прочитать(лУказатель, лРазмерДанных);
		Результат = ПолучитьСтрокуИзБуфераДвоичныхДанных(хБуфер, "UTF-16LE");
	ИначеЕсли лТипПоля = "NVC" Тогда
		лДлинаСтроки = хБуферФайлаData.ПрочитатьЦелое16(лУказатель);
		хБуфер = хБуферФайлаData.Прочитать(лУказатель + 2, лДлинаСтроки * 2);
		Результат = ПолучитьСтрокуИзБуфераДвоичныхДанных(хБуфер, "UTF-16LE");
	ИначеЕсли лТипПоля = "RV" Тогда
		// Размер - 8 версия создания и 8 версия модификации
		Результат = ПолучитьВерсиюИзБуфера(хБуферФайлаData, лУказатель, лРазмерДанных);
	ИначеЕсли лТипПоля = "NT" Тогда
		// лРазмерПоля = лРазмерПоля + 8;
	ИначеЕсли лТипПоля = "T" Тогда
		// лРазмерПоля = лРазмерПоля + 8;
	ИначеЕсли лТипПоля = "I" Тогда
		// лРазмерПоля = лРазмерПоля + 8;
	ИначеЕсли лТипПоля = "DT" Тогда
		хБуфер = хБуферФайлаData.Прочитать(лУказатель, 7);
		СтрокаДаты = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(хБуфер);
		Попытка
			Результат = Дата(СтрокаДаты);
		Исключение
			ВызватьИсключение "Ошибка при преобразовании строки в дату: " + СтрокаДаты;
		КонецПопытки;
	ИначеЕсли лТипПоля = "VB" Тогда
		лДлинаСтроки = хБуферФайлаData.ПрочитатьЦелое16(лУказатель);
		хБуфер = хБуферФайлаData.Прочитать(лУказатель + 2, лДлинаСтроки);
		Результат = НРег(ПолучитьHexСтрокуИзБуфераДвоичныхДанных(хБуфер));
	ИначеЕсли лТипПоля = "HV" Тогда
		хБуфер = хБуферФайлаData.Прочитать(лУказатель, 8);
		Результат = Формат(хБуфер[0], "ЧН=0; ЧГ=0") + ":" + Формат(хБуфер[1], "ЧН=0; ЧГ=0");
	ИначеЕсли лТипПоля = "B1CD_SGUID" Тогда
		Результат = ПолучитьGuidСтрокойИзБуфера(хБуферФайлаData, лУказатель, лРазмерДанных);
	ИначеЕсли лТипПоля = "B1CD_B" Тогда
		хБуфер = хБуферФайлаData.Прочитать(лУказатель, лРазмерДанных);
		Результат = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(хБуфер);
	ИначеЕсли лТипПоля = "B1CD_I" ИЛИ лТипПоля = "B1CD_T" ИЛИ лТипПоля = "B1CD_NT" Тогда
		Результат = Новый Структура;
		Результат.Вставить("НачалоДанных", хБуферФайлаData.ПрочитатьЦелое32(лУказатель));
		Результат.Вставить("Размер", хБуферФайлаData.ПрочитатьЦелое32(лУказатель + 4));
		Результат.Вставить("Тип", Поле.Тип);
	ИначеЕсли лТипПоля = "B1CD_VER32" Тогда
		Результат = Новый Структура;
		Результат.Вставить("_IDRREF", ПолучитьGuidСтрокойИзБуфера(хБуферФайлаData, лУказатель + 16, лРазмерДанных));
		Результат.Вставить("_VERSION", ПолучитьВерсиюИзБуфера(хБуферФайлаData, лУказатель, лРазмерДанных));
	Иначе
		Сообщить("Тип '" + лТипПоля + "' не поддерживается");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьВерсиюИзБуфера(хБуферФайлаData, Указатель, лРазмерДанных)
	
	л_Строка1 = Формат(хБуферФайлаData.ПрочитатьЦелое32(Указатель + 0), "ЧН=0; ЧГ=0");
	л_Строка2 = Формат(хБуферФайлаData.ПрочитатьЦелое32(Указатель + 4), "ЧН=0; ЧГ=0");
	л_Строка3 = Формат(хБуферФайлаData.ПрочитатьЦелое32(Указатель + 8), "ЧН=0; ЧГ=0");
	л_Строка4 = Формат(хБуферФайлаData.ПрочитатьЦелое32(Указатель + 12), "ЧН=0; ЧГ=0");
	
	Возврат СтрШаблон("%1.%2.%3.%4", л_Строка1, л_Строка2, л_Строка3, л_Строка4);
	
КонецФункции

Функция ПолучитьGuidСтрокойИзБуфера(хБуферФайлаData, Указатель, лРазмерДанных)
	
	л_Строка1 = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(хБуферФайлаData.Прочитать(Указатель + 0, 2));
	л_Строка2 = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(хБуферФайлаData.Прочитать(Указатель + 2, 6));
	л_Строка3 = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(хБуферФайлаData.Прочитать(Указатель + 8, 2));
	л_Строка4 = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(хБуферФайлаData.Прочитать(Указатель + 10, 2));
	л_Строка5 = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(хБуферФайлаData.Прочитать(Указатель + 12, 4));
	
	Возврат СтрШаблон("%5-%4-%3-%1-%2", л_Строка1, л_Строка2, л_Строка3, л_Строка4, л_Строка5);
	
КонецФункции

Функция ПолучитьСтруктуруТаблицыПоИмени(п_СтруктураБазы, ПотокКонтейнера, ИмяТаблицы, ЗаполнитьПриНеобходимостиСтруктурыТаблицы = Истина)
	
	Перем Дерево1;
	
	л_Индекс = п_СтруктураБазы.МассивИменТаблиц.Найти(ВРег(ИмяТаблицы));
	
	Если л_Индекс = Неопределено Тогда
		ВызватьИсключение "Таблица не найдена: " + ИмяТаблицы;
	КонецЕсли;
	
	л_СтруктураТаблицы = п_СтруктураБазы.МассивТаблиц[л_Индекс];
	
	Если ЗаполнитьПриНеобходимостиСтруктурыТаблицы Тогда
		
		Если л_СтруктураТаблицы.ОписаниеТаблицы = Неопределено Тогда
			
			Если п_СтруктураБазы.Версия = "8.3.8.0" Тогда
				
				хБуферДанных = ПолучитьДанныеБлобИзБуфераПоНомеруБлока(п_СтруктураБазы.КорневойБлок.Данные, л_СтруктураТаблицы.НомерБлока8380);
				
				л_СтруктураТаблицы.ОписаниеТаблицы = ПолучитьСтрокуИзБУфераДвоичныхДанных(хБуферДанных, "UTF-8");
				
			Иначе
				
				лРазмерСодержимого = л_СтруктураТаблицы.РазмерСодержимого;
				лФлагПрерывания = Ложь;
				лКурсорСодержимого = 0;
				ОсталосьЗаписать = лРазмерСодержимого;
				хБуферДанных = Новый БуферДвоичныхДанных(лРазмерСодержимого);
				
				Для Каждого лТекущаяСтраницаРазмещения Из л_СтруктураТаблицы.МассивСтраницРазмещения Цикл
					Для Каждого лТекущийНомерСтраницыДанных Из лТекущаяСтраницаРазмещения.МассивНомеровСтраницДанных Цикл
						хБуфер = ПолучитьСтраницыПоНомеру(п_СтруктураБазы, ПотокКонтейнера, лТекущийНомерСтраницыДанных);
						Записываем = Мин(хБуфер.Размер, ОсталосьЗаписать);
						хБуферДанных.Записать(лКурсорСодержимого, хБуфер, Записываем);
						лКурсорСодержимого = лКурсорСодержимого + Записываем;
						ОсталосьЗаписать = ОсталосьЗаписать - Записываем;
						хБуфер = Неопределено;
						Если ОсталосьЗаписать = 0 ИЛИ лКурсорСодержимого = лРазмерСодержимого Тогда
							лФлагПрерывания = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если лФлагПрерывания Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				л_СтруктураТаблицы.ОписаниеТаблицы = ПолучитьСтрокуИзБуфераДвоичныхДанных(хБуферДанных, "UTF-16LE");
				
			КонецЕсли;
			
			п_ТаблицаПолей = Новый ТаблицаЗначений;
			п_ТаблицаПолей.Колонки.Добавить("Имя");
			п_ТаблицаПолей.Колонки.Добавить("Тип");
			п_ТаблицаПолей.Колонки.Добавить("ФлагПустое");
			п_ТаблицаПолей.Колонки.Добавить("Длина");
			п_ТаблицаПолей.Колонки.Добавить("Точность");
			п_ТаблицаПолей.Колонки.Добавить("РазмерВБайтах");
			п_ТаблицаПолей.Колонки.Добавить("СмещениеВБайтах");
			п_ТаблицаПолей.Колонки.Добавить("ФлагРегистр");
			л_СтруктураТаблицы.Поля = п_ТаблицаПолей;
			л_СтруктураТаблицы.Индексы = Новый Массив;
			л_СтруктураТаблицы.РекордЛок = 0;
			л_СтруктураТаблицы.НомерСтраницыФайлаДанных = 0;
			л_СтруктураТаблицы.НомерСтраницыФайлаИндексов = 0;
			л_СтруктураТаблицы.НомерСтраницыФайлаБлоб = 0;
			ТекстВДерево(л_СтруктураТаблицы.ОписаниеТаблицы, Дерево1);
			
			Для Каждого СтрокаДерева Из Дерево1.Строки Цикл
				Если СтрокаДерева.Строки.Количество() > 2 Тогда
					Если СтрокаДерева.Строки[2].Тип = п_Тип_Список Тогда
						п_Блок = СтрокаДерева.Строки[2].Строки;
						ЧислоПолей = Число(п_Блок.Количество() - 1);
						Для Сч = 1 По ЧислоПолей Цикл
							п_Поля = п_Блок[Сч];
							НоваяСтрока = л_СтруктураТаблицы.Поля.Добавить();
							НоваяСтрока.Имя = СокрЛП(п_Поля.Строки[0].Значение);
							НоваяСтрока.Тип = СокрЛП(п_Поля.Строки[1].Значение);
							НоваяСтрока.ФлагПустое = Число(СокрЛП(п_Поля.Строки[2].Значение));
							НоваяСтрока.Длина = Число(СокрЛП(п_Поля.Строки[3].Значение));
							НоваяСтрока.Точность = Число(СокрЛП(п_Поля.Строки[4].Значение));
							НоваяСтрока.РазмерВБайтах = Неопределено;
							НоваяСтрока.СмещениеВБайтах = Неопределено;
							НоваяСтрока.ФлагРегистр = ?(Найти(СокрЛП(п_Поля.Строки[5].Значение), "CS") > 0, 1, 0);
						КонецЦикла;
					КонецЕсли;
					Если СтрокаДерева.Строки[3].Тип = п_Тип_Список Тогда
						п_Блок = СтрокаДерева.Строки[3].Строки;
						ЧислоИндексов = Число(п_Блок.Количество() - 1);
						Для Сч = 1 По ЧислоИндексов Цикл
							п_Индексы = п_Блок[Сч];
							л_СтруктураИндексы = Новый Структура;
							л_СтруктураИндексы.Вставить("Имя", СокрЛП(п_Индексы.Строки[0].Значение));
							л_СтруктураИндексы.Вставить("Точность", Число(СокрЛП(п_Индексы.Строки[1].Значение)));
							л_СтруктураИндексы.Вставить("Подиндексы", Новый Массив);
							ЧислоПодиндексов = Число(п_Индексы.Строки.Количество() - 1);
							Для СчП = 2 По ЧислоПодиндексов Цикл
								п_Подиндексы = п_Индексы.Строки[СчП];
								л_СтруктураПодиндексы = Новый Структура;
								л_СтруктураПодиндексы.Вставить("Имя", СокрЛП(п_Подиндексы.Строки[0].Значение));
								л_СтруктураПодиндексы.Вставить("Точность", Число(СокрЛП(п_Подиндексы.Строки[1].Значение)));
								л_СтруктураИндексы.Подиндексы.Добавить(л_СтруктураПодиндексы);
							КонецЦикла;
							л_СтруктураТаблицы.Индексы.Добавить(л_СтруктураИндексы);
						КонецЦикла;
					КонецЕсли;
					Если СтрокаДерева.Строки[4].Тип = п_Тип_Список Тогда
						п_Блок = СтрокаДерева.Строки[4].Строки;
						л_СтруктураТаблицы.РекордЛок = Число(СокрЛП(п_Блок[1].Значение));
						Если л_СтруктураТаблицы.РекордЛок = 1 И СтрокаДерева.Строки[2].Строки.Найти("VERSION", "Значение", Истина) = Неопределено Тогда
							// скрытое поле при recordlock = 1 и отсутствии поля типа VERSION
							НоваяСтрока = л_СтруктураТаблицы.Поля.Вставить(0); // нулевой индекс
							НоваяСтрока.Имя = "VERSION";
							НоваяСтрока.Тип = "HV";
							НоваяСтрока.ФлагПустое = 0;
							НоваяСтрока.Длина = 0;
							НоваяСтрока.Точность = 0;
							НоваяСтрока.РазмерВБайтах = Неопределено;
							НоваяСтрока.СмещениеВБайтах = Неопределено;
							НоваяСтрока.ФлагРегистр = 0;
						КонецЕсли;
					КонецЕсли;
					Если СтрокаДерева.Строки[5].Тип = п_Тип_Список Тогда
						п_Блок = СтрокаДерева.Строки[5].Строки;
						л_СтруктураТаблицы.НомерСтраницыФайлаДанных = Число(СокрЛП(п_Блок[1].Значение));
						л_СтруктураТаблицы.НомерСтраницыФайлаБлоб = Число(СокрЛП(п_Блок[2].Значение));
						л_СтруктураТаблицы.НомерСтраницыФайлаИндексов = Число(СокрЛП(п_Блок[3].Значение));
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			лРазмерЗаписи = 1; // 1 байт - признак удаления поля
			
			Для Каждого п_Поле Из л_СтруктураТаблицы.Поля Цикл
				лРазмерПоля = п_Поле.ФлагПустое;
				Если п_Поле.Тип = "B" Тогда
					лРазмерПоля = лРазмерПоля + п_Поле.Длина;
				ИначеЕсли п_Поле.Тип = "L" Тогда
					лРазмерПоля = лРазмерПоля + 1;
				ИначеЕсли п_Поле.Тип = "N" Тогда
					лРазмерПоля = лРазмерПоля + Цел((п_Поле.Длина + 2) / 2);
				ИначеЕсли п_Поле.Тип = "NC" Тогда
					лРазмерПоля = лРазмерПоля + п_Поле.Длина * 2;
				ИначеЕсли п_Поле.Тип = "NVC" Тогда
					лРазмерПоля = лРазмерПоля + п_Поле.Длина * 2 + 2;
				ИначеЕсли п_Поле.Тип = "RV" Тогда
					лРазмерПоля = лРазмерПоля + 16;
				ИначеЕсли п_Поле.Тип = "NT" Тогда
					лРазмерПоля = лРазмерПоля + 8;
				ИначеЕсли п_Поле.Тип = "T" Тогда
					лРазмерПоля = лРазмерПоля + 8;
				ИначеЕсли п_Поле.Тип = "I" Тогда
					лРазмерПоля = лРазмерПоля + 8;
				ИначеЕсли п_Поле.Тип = "DT" Тогда
					лРазмерПоля = лРазмерПоля + 7;
				ИначеЕсли п_Поле.Тип = "VB" Тогда
					лРазмерПоля = лРазмерПоля + п_Поле.Длина + 2;
				ИначеЕсли п_Поле.Тип = "HV" Тогда
					лРазмерПоля = лРазмерПоля + 8;
				Иначе
					ВызватьИсключение "Неизвестный тип поля: " + п_Поле.Тип;
				КонецЕсли;
				п_Поле.СмещениеВБайтах = лРазмерЗаписи;
				п_Поле.РазмерВБайтах = лРазмерПоля;
				лРазмерЗаписи = лРазмерЗаписи + лРазмерПоля;
			КонецЦикла;
			
			л_СтруктураТаблицы.РазмерЗаписиВБайтах = лРазмерЗаписи;
			
		КонецЕсли;
		
		Если л_СтруктураТаблицы.ФайлДанных = Неопределено Тогда
			лНачальнаяСтраница = л_СтруктураТаблицы.НомерСтраницыФайлаДанных;
			л_СтруктураТаблицы.ФайлДанных = ПолучитьСтруктуруФайлаБазыПоНомеруСтраницыЗаголовка(п_СтруктураБазы, ПотокКонтейнера, лНачальнаяСтраница, 1);
		КонецЕсли;
		
		Если л_СтруктураТаблицы.ФайлБлоб = Неопределено Тогда
			лНачальнаяСтраница = л_СтруктураТаблицы.НомерСтраницыФайлаБлоб;
			л_СтруктураТаблицы.ФайлБлоб = ПолучитьСтруктуруФайлаБазыПоНомеруСтраницыЗаголовка(п_СтруктураБазы, ПотокКонтейнера, лНачальнаяСтраница, 1);
		КонецЕсли;
		
		Если л_СтруктураТаблицы.ФайлИндексов = Неопределено Тогда
			лНачальнаяСтраница = л_СтруктураТаблицы.НомерСтраницыФайлаИндексов;
			л_СтруктураТаблицы.ФайлИндексов = ПолучитьСтруктуруФайлаБазыПоНомеруСтраницыЗаголовка(п_СтруктураБазы, ПотокКонтейнера, лНачальнаяСтраница, 1);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат л_СтруктураТаблицы;
	
КонецФункции

Функция ПолучитьСтруктуруБлобИзСтроки(БлобС)
	
	Если НЕ СтрНачинаетсяС(БлобС, "#BLOB") Тогда
		ВызватьИсключение ("ОШИБКА: Неверная строка BLOB" + Символы.ПС + БлобС);
	КонецЕсли;
	
	мсБлобСсылка = СтрРазделить(БлобС, ",");
	
	л_Структура = Новый Структура;
	л_Структура.Вставить("Тип", мсБлобСсылка[1]);
	л_Структура.Вставить("НомерБлока", Число(мсБлобСсылка[2]));
	л_Структура.Вставить("Размер", Число(мсБлобСсылка[3]));
	
	Возврат л_Структура;
	
КонецФункции

Функция ПолучитьДанныеБлоб(п_СтруктураБазы, ПотокКонтейнера, СтруктураТаблицыБлоб, НомерБлокаНачалаДанных, РазмерДанныхДляКонтроля = 0, ПрочитатьПервыхБайтов = 0)
	
	// struct {
	//unsigned int nextblock;
	//short int length;
	//char[250] data;
	//}	
	
	Если СтруктураТаблицыБлоб.МассивНомеровСтраницДанных = Неопределено Тогда
		мсМассивНомеровСтраницДанных = Новый Массив;
		Если СтруктураТаблицыБлоб.ТипТаблицыРазмещения = 0 Тогда
			Для Каждого лТекущаяСтраницаРазмещения Из СтруктураТаблицыБлоб.МассивСтраницРазмещения Цикл
				Для Каждого лТекущийНомерСтраницыДанных Из лТекущаяСтраницаРазмещения.МассивНомеровСтраницДанных Цикл
					мсМассивНомеровСтраницДанных.Добавить(лТекущийНомерСтраницыДанных);
				КонецЦикла;
			КонецЦикла;
		ИначеЕсли СтруктураТаблицыБлоб.ТипТаблицыРазмещения = 1 Тогда
			Для Каждого лТекущаяСтраницаРазмещения Из СтруктураТаблицыБлоб.МассивСтраницРазмещения Цикл
				мсМассивНомеровСтраницДанных.Добавить(лТекущаяСтраницаРазмещения.НомерСтраницыРазмещения);
			КонецЦикла;
		Иначе
			ВызватьИсключение "Неизвестный тип таблицы размещения";
		КонецЕсли;
		СтруктураТаблицыБлоб.МассивНомеровСтраницДанных = мсМассивНомеровСтраницДанных;
	КонецЕсли;
	
	лТекБлок = НомерБлокаНачалаДанных;
	лБайтовПрочитано = 0;
	
	ПотокДанных = Новый ПотокВПамяти;
	ЗаписьДанных = Новый ЗаписьДанных(ПотокДанных);
	
	Пока Истина Цикл
		лСмещениеБлоб = лТекБлок * 256;
		лНомерСтраницыВФайлеБлоб = Цел(лСмещениеБлоб / п_СтруктураБазы.РазмерСтраницы);
		лСмещениеВСтранице = лСмещениеБлоб - лНомерСтраницыВФайлеБлоб * п_СтруктураБазы.РазмерСтраницы;
		лНомерСтраницыВБазе1С = СтруктураТаблицыБлоб.МассивНомеровСтраницДанных[лНомерСтраницыВФайлеБлоб];
		ПотокКонтейнера.Перейти(лНомерСтраницыВБазе1С * п_СтруктураБазы.РазмерСтраницы + лСмещениеВСтранице, ПозицияВПотоке.Начало);
		п_Чтение = Новый ЧтениеДанных(ПотокКонтейнера, КодировкаТекста.ANSI, ПорядокБайтов.LittleEndian);
		хБуфер = п_Чтение.ПрочитатьВБуферДвоичныхДанных(256);
		п_Чтение.Закрыть();
		лСледующийБлок = хБуфер.ПрочитатьЦелое32(0);
		лТекРазмерДанныхБлока = хБуфер.ПрочитатьЦелое16(4);
		Если лТекРазмерДанныхБлока > 250 Тогда
			Сообщить("ОШИБКА BLOB:" + Символы.ПС + "Блок начала данных: " + НомерБлокаНачалаДанных);
			ВызватьИсключение "ОШИБКА: Размер блока BLOB не может быть больше 250 байт";
		КонецЕсли;
		хБуфер2 = хБуфер.Прочитать(6, лТекРазмерДанныхБлока);
		ЗаписьДанных.ЗаписатьБуферДвоичныхДанных(хБуфер2);
		лБайтовПрочитано = лБайтовПрочитано + лТекРазмерДанныхБлока;
		Если лСледующийБлок = 0 Тогда
			Прервать;
		КонецЕсли;
		Если ПрочитатьПервыхБайтов > 0 И лБайтовПрочитано > ПрочитатьПервыхБайтов Тогда
			// запрос на первые N байтов
			Прервать;
		КонецЕсли;
		Если РазмерДанныхДляКонтроля > 0 И лБайтовПрочитано > РазмерДанныхДляКонтроля Тогда
			ВызватьИсключение("ОШИБКА: Читаемый блок BLOB больше необходимого размера данных");
		КонецЕсли;
		лТекБлок = лСледующийБлок;
	КонецЦикла;
	
	ЗаписьДанных.Закрыть();
	
	ПотокДанных.Перейти(0, ПозицияВПотоке.Начало);
	
	ЧтениеФайла = Новый ЧтениеДанных(ПотокДанных, КодировкаТекста.ANSI, ПорядокБайтов.LittleEndian);
	
	Если ПрочитатьПервыхБайтов = 0 Тогда
		Если РазмерДанныхДляКонтроля > 0 И лБайтовПрочитано <> РазмерДанныхДляКонтроля Тогда
			ВызватьИсключение("ОШИБКА: Размер блока BLOB не равен необходимому размеру");
		КонецЕсли;
		хБуферДанных = ЧтениеФайла.ПрочитатьВБуферДвоичныхДанных(лБайтовПрочитано);
	Иначе
		хБуферДанных = ЧтениеФайла.ПрочитатьВБуферДвоичныхДанных(ПрочитатьПервыхБайтов);
	КонецЕсли;
	
	Возврат хБуферДанных;
	
КонецФункции

Функция СохранитьСнимок(п_СтрокаТаблицы, п_Версия, п_rootobj, п_ПутьКФайлу1CD, п_ФайлДляСохранения)
	
	п_ВерсияСнимка = GUIDВСтильMS(п_СтрокаТаблицы.B1CD_SNAPSHOTMAKER);
	
	Если п_ВерсияСнимка = п_ВерсияСнимка0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	п_ФайлСнимка = п_ПутьКФайлу1CD + "cache" + "\" + "ddb" + Формат(п_Версия, "ЧЦ=5; ЧВН=; ЧГ=0") + ".snp";
	
	Если НЕ ФайлСуществует(п_ФайлСнимка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	п_ХешФайлаCRC = 0;
	
	Если п_rootobj = п_ВерсияСнимка ИЛИ п_ВерсияСнимка = п_ВерсияСнимка1 Тогда
		Попытка
			п_ДвоичныеДанныеСнимка = Новый ДвоичныеДанные(п_ФайлСнимка);
			п_ДвоичныеДанныеСнимка = ИнфлэйтВПамятиИзДвоичныхДанныхВДвоичныеДанныеЧерезХранилищеЗначения(п_ДвоичныеДанныеСнимка);
			п_ДвоичныеДанныеСнимка.Записать(п_ФайлДляСохранения);
			п_ХешФайлаCRC = ПолучитьХешФайла(п_ДвоичныеДанныеСнимка, "CRC32");
		Исключение
			Сообщить("Не удалось распаковать файл снимка
				|Имя файла " + п_ФайлСнимка + "
				|Требуемая версия " + п_Версия);
			Возврат Ложь;
		КонецПопытки;
	ИначеЕсли п_ВерсияСнимка = п_ВерсияСнимка2 Тогда
		п_ДвоичныеДанныеСнимка = Новый ДвоичныеДанные(п_ФайлСнимка);
		п_ДвоичныеДанныеСнимка.Записать(п_ФайлДляСохранения);
		п_ХешФайлаCRC = ПолучитьХешФайла(п_ДвоичныеДанныеСнимка, "CRC32");
	Иначе
		Сообщить("Неизвестная версия снимка
			|Имя файла " + п_ФайлСнимка + "
			|Требуемая версия " + п_Версия + "
			|Версия снимка " + п_ВерсияСнимка);
		Возврат Ложь;
	КонецЕсли;
	                 
	п_СнимокCRC = ПолучитьБуферДвоичныхДанныхИзHexСтроки(п_СтрокаТаблицы.B1CD_SNAPSHOTCRC).ПрочитатьЦелое32(0);
	
	Если п_СнимокCRC = п_ХешФайлаCRC Тогда
		Возврат Истина;
	КонецЕсли;
	
	Сообщить("Файл снимка испорчен (не совпала контрольная сумма)
		|Имя файла " + п_ФайлСнимка + "
		|Требуемая версия " + п_Версия + "
		|Должен быть CRC32 " + Формат(п_СнимокCRC, "ЧГ=0") + "
		|Получился CRC32 " + Формат(п_ХешФайлаCRC, "ЧГ=0"));
	
	Возврат Ложь;
	
КонецФункции

Функция ПакетыДанных(п_КаталогПакетов)
	
	п_ПакетыДанных = Новый Массив;
    п_НайденныеФайлыИндексов = ПолучитьМассивФайлов(п_КаталогПакетов, "pack-*.ind", ".ind");
	
	Для Каждого п_ФайлИндекса Из п_НайденныеФайлыИндексов Цикл
		
		Попытка
			п_Файл = п_ФайлИндекса.ПолноеИмя;
			п_ПотокИндекса = ФайловыеПотоки.ОткрытьДляЧтения(п_Файл);
			п_ПотокИндекса.Перейти(8, ПозицияВПотоке.Начало);
			п_ЧтениеДанных = Новый ЧтениеДанных(п_ПотокИндекса);
			п_ХэшиДанных = п_ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(п_ЧтениеДанных.ПрочитатьЦелое32() * 28);
			п_ЧтениеДанных.Закрыть();
			п_ПотокИндекса.Закрыть();
			п_Файл = п_ФайлИндекса.Путь + п_ФайлИндекса.ИмяБезРасширения + ".pck";
			п_ПотокПакета = ФайловыеПотоки.ОткрытьДляЧтения(п_Файл);
		Исключение
			ВызватьИсключение "Ошибка открытия файла
				|Файл " + п_Файл;
		КонецПопытки;
		
		п_Структура = Новый Структура;
		п_Структура.Вставить("ХэшиДанных", п_ХэшиДанных);
		п_Структура.Вставить("Пакет", п_ПотокПакета);
		
		п_ПакетыДанных.Добавить(п_Структура);
		
	КонецЦикла;
	
	Возврат п_ПакетыДанных;
	
КонецФункции

Функция ИзвлечьДанныеОбъекта(п_СтруктураБазы, ПотокКонтейнера, п_ЗаписьТаблицы, п_ПолеОбъекта, п_СтруктураТаблицы, п_НадоРаспаковывать, п_ПолеХэша, п_КаталогОбъектов, п_ПакетыДанных, п_ДанныеСжатогоФайла)
	
	п_Найден = Ложь;
	
	п_СтруктураБлоб = ПолучитьСтруктуруБлобИзСтроки(п_ЗаписьТаблицы[п_ПолеОбъекта]);
	
	Если п_СтруктураБлоб.НомерБлока = 0 И п_СтруктураБлоб.Размер = 0 Тогда
		
		Если ЗначениеЗаполнено(п_ПолеХэша) Тогда
			
			п_ДанныеСжатогоФайла = ДостатьДанныеИзКаталогаВнешнихДанных(п_ЗаписьТаблицы[п_ПолеХэша], п_КаталогОбъектов, п_ПакетыДанных, п_Найден);
			
		КонецЕсли;
		
	Иначе
		
		п_Буфер = ПолучитьДанныеБлоб(п_СтруктураБазы, ПотокКонтейнера, п_СтруктураТаблицы.ФайлБлоб, п_СтруктураБлоб.НомерБлока, п_СтруктураБлоб.Размер);
		п_ПотокДанных = Новый ПотокВПамяти(п_Буфер);
		
		Если п_НадоРаспаковывать Тогда
			п_ДанныеФайла = п_ПотокДанных.ЗакрытьИПолучитьДвоичныеДанные();
			Попытка
				п_ДанныеСжатогоФайла = ИнфлэйтВПамятиИзДвоичныхДанныхВДвоичныеДанныеЧерезХранилищеЗначения(п_ДанныеФайла);
			Исключение
				п_ДанныеСжатогоФайла = п_ДанныеФайла;
			КонецПопытки;
		Иначе
			п_ДанныеСжатогоФайла = п_ПотокДанных.ЗакрытьИПолучитьДвоичныеДанные();
		КонецЕсли;
		
		п_Найден = Истина;
		
	КонецЕсли;
	
	Возврат п_Найден;
	
КонецФункции

Функция ДостатьДанныеИзКаталогаВнешнихДанных(п_ХексХэшаДанных, п_КаталогОбъектов, п_ПакетыДанных, п_Найден)
	
	Для Каждого п_ПакетДанных Из п_ПакетыДанных Цикл
		
		п_ПотокДанных = Новый ПотокВПамяти;
		п_ЗаписьДанных = Новый ЗаписьДанных(п_ПотокДанных);
		п_Размер = 28;
		
		Для Инд = 0 По п_ПакетДанных.ХэшиДанных.Размер / п_Размер - 1 Цикл
		    п_ХэшДанныхЗаписи = п_ПакетДанных.ХэшиДанных.Прочитать(Инд * п_Размер, 20);
			Если п_ХексХэшаДанных = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(п_ХэшДанныхЗаписи) Тогда
				п_Смещение = п_ПакетДанных.ХэшиДанных.ПрочитатьЦелое64(Инд * п_Размер + 20);
				п_ПакетДанных.Пакет.Перейти(п_Смещение, ПозицияВПотоке.Начало);
				п_ЧтениеДанных = Новый ЧтениеДанных(п_ПакетДанных.Пакет);
				п_Буфер = п_ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(п_ЧтениеДанных.ПрочитатьЦелое64());
				п_ЧтениеДанных.Закрыть();
				п_ЗаписьДанных.ЗаписатьБуферДвоичныхДанных(п_Буфер);
				п_Найден = Истина;
			КонецЕсли;
		КонецЦикла;
		
		п_ЗаписьДанных.Закрыть();
		
		Если п_Найден Тогда
			п_ПотокДанных.Перейти(0, ПозицияВПотоке.Начало);
			п_ДанныеСжатогоФайла = п_ПотокДанных.ЗакрытьИПолучитьДвоичныеДанные();
			Возврат п_ДанныеСжатогоФайла;
		КонецЕсли;
		
		п_ПотокДанных.Закрыть();
		
	КонецЦикла;
	
	п_ФайлОбъекта = п_КаталогОбъектов + "/" + Лев(п_ХексХэшаДанных, 2) + "/" + Сред(п_ХексХэшаДанных, 3, СтрДлина(п_ХексХэшаДанных) - 2);
	
	Если НЕ ФайлСуществует(п_ФайлОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	п_ДанныеСжатогоФайла = Новый ДвоичныеДанные(п_ФайлОбъекта);
	п_Найден = Истина;
	
	Возврат п_ДанныеСжатогоФайла;
	
КонецФункции

Функция GUIDВСтильMS(п_GUID)
	
	л_Строка1 = Сред(п_GUID, 27, 2) + Сред(п_GUID, 25, 2) + Сред(п_GUID, 22, 2) + Сред(п_GUID, 20, 2);
	л_Строка2 = Сред(п_GUID, 31, 2) + Сред(п_GUID, 29, 2);
	л_Строка3 = Сред(п_GUID, 35, 2) + Сред(п_GUID, 33, 2);
	л_Строка4 = Сред(п_GUID, 15, 4);
	л_Строка5 = Сред(п_GUID, 10, 4) + Сред(п_GUID, 1, 8);
	
	Возврат НРег(СтрШаблон("%1-%2-%3-%4-%5", л_Строка1, л_Строка2, л_Строка3, л_Строка4, л_Строка5));
	
КонецФункции


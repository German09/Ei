	п_Маркеры_Кавычки.Добавить(""""""); // {0,"""0"""}
	п_Маркеры_Кавычки.Добавить(""""); // {0,"0"}
	
	п_Маркеры_Значение = Новый Массив; // значение с кавычками или без
	п_Маркеры_Значение.Добавить("}"); // {0,0}
	п_Маркеры_Значение.Добавить(""""); // {0,"0"}
	
	п_РегулярноеВыражение_Число = "-?[0-9]+\.?[0-9]*";
	п_РегулярноеВыражение_GUID = "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}";
	п_РегулярноеВыражение_Ссылка = "[0-9]+:[0-9a-fA-F]{32}";
	п_РегулярноеВыражение_Base64 = "#base64:[0-9a-zA-Z\+=\r\n/]+";
	п_РегулярноеВыражение_ЧислоСПоказателемСтепени = "-?[0-9]+\.?[0-9]*e-?[0-9]+";
	п_РегулярноеВыражение_Base64_8_2 = "[0-9a-zA-Z\+=\r\n/]+";
	п_РегулярноеВыражение_Data = "#data:[0-9a-zA-Z\+=\r\n/]+";
	п_РегулярноеВыражение_Hex = "[0-9a-fA-F\r\n/]+";
	
	п_Тип_Число = "Число";
	п_Тип_Строка = "Строка";
	п_Тип_Дата = "Дата";
	п_Тип_Булево = "Булево";
	п_Тип_GUID = "GUID";
	п_Тип_Ссылка = "Ссылка";
	п_Тип_Base64 = "Base64";
	п_Тип_ЧислоСПоказателемСтепени = "ЧислоСПоказателемСтепени";
	п_Тип_Список = "Список";
	п_Тип_Пусто = "Пусто";
	п_Тип_ДвоичныеДанные = "ДвоичныеДанные";
	п_Тип_БуферДвоичныхДанных = "БуферДвоичныхДанных";
	п_Тип_Поток = "Поток";
	п_Тип_УникальныйИдентификатор = "УникальныйИдентификатор";
	п_Тип_ХранилищеЗначения = "ХранилищеЗначения";
	
КонецПроцедуры

Процедура КлассифицироватьЗначение(ТекущаяСтрока)
	
	Если СтрПодобнаПоРегулярномуВыражению(ТекущаяСтрока.Значение, п_РегулярноеВыражение_Число) Тогда 
		ТекущаяСтрока.Тип = п_Тип_Число;
		Возврат;
	КонецЕсли;
	
	Если СтрПодобнаПоРегулярномуВыражению(ТекущаяСтрока.Значение, п_РегулярноеВыражение_GUID) Тогда 
		ТекущаяСтрока.Тип = п_Тип_GUID;
		Возврат;
	КонецЕсли;
	
	Если СтрПодобнаПоРегулярномуВыражению(ТекущаяСтрока.Значение, п_РегулярноеВыражение_Ссылка) Тогда 
		ТекущаяСтрока.Тип = п_Тип_Ссылка;
		Возврат;
	КонецЕсли;
	
	Если СтрПодобнаПоРегулярномуВыражению(ТекущаяСтрока.Значение, п_РегулярноеВыражение_Base64) Тогда 
		ТекущаяСтрока.Тип = п_Тип_Base64;
		Возврат;
	КонецЕсли;
	
	Если СтрПодобнаПоРегулярномуВыражению(ТекущаяСтрока.Значение, п_РегулярноеВыражение_ЧислоСПоказателемСтепени) Тогда 
		ТекущаяСтрока.Тип = п_Тип_ЧислоСПоказателемСтепени;
		Возврат;
	КонецЕсли;
	
	Если СтрПодобнаПоРегулярномуВыражению(ТекущаяСтрока.Значение, п_РегулярноеВыражение_Base64_8_2) Тогда 
		ТекущаяСтрока.Тип = п_Тип_Base64;
		Возврат;
	КонецЕсли;
	
	Если СтрПодобнаПоРегулярномуВыражению(ТекущаяСтрока.Значение, п_РегулярноеВыражение_Data) Тогда 
		ТекущаяСтрока.Тип = п_Тип_Base64;
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока.Тип = "Неизвестно";
	Сообщить("Не удалось определить тип значения " + Символы.ПС + ТекущаяСтрока.Значение, СтатусСообщения.Внимание);
	
КонецПроцедуры

Процедура КопироватьСодержимоеКаталога(ОткудаКопируем, КудаКопируем)
	
	Файлы = НайтиФайлы(ОткудаКопируем, "*.*");
	
	Для Каждого Файл Из Файлы Цикл
		Если Файл.ЭтоКаталог() Тогда
			КопироватьСодержимоеКаталога(Файл.ПолноеИмя, КудаКопируем + "\" + Файл.Имя);
		Иначе
			КопироватьФайл(Файл.ПолноеИмя, КудаКопируем + "\" + Файл.Имя);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьИСоздатьКаталог(НужныйКаталог)
	
	Каталог = Новый Файл(НужныйКаталог);
	
	Если Каталог.Существует() И НЕ Каталог.ЭтоКаталог() Тогда
		ВызватьИсключение """" + НужныйКаталог + """ не является каталогом";
	КонецЕсли;
	
	Если НЕ Каталог.Существует() Тогда
		СоздатьКаталог(НужныйКаталог);
	КонецЕсли;
	
КонецПроцедуры

Процедура ТекстВДерево(п_Текст, п_Дерево = Неопределено) Экспорт
	
	// Режимы парсера
	Режим_ОжиданиеЗначения = 0;
	Режим_ВводСтроки = 1;
	Режим_ВводЗначения = 2;
	Режим_ОжиданиеРазделителя = 3;
	
	Если ТипЗнч(п_Дерево) = Тип("ДеревоЗначений") Тогда
		п_Дерево.Колонки.Очистить();
	Иначе
		п_Дерево = Новый ДеревоЗначений;
	КонецЕсли;
	
	п_Дерево.Колонки.Добавить("Тип");
	п_Дерево.Колонки.Добавить("Значение");
	//п_Дерево.Колонки.Добавить("Значение", Новый ОписаниеТипов("Число,Строка"));
	
	ТекущаяСтрока = п_Дерево.Строки.Добавить();
	//ТекущаяСтрока.Значение = "Корень";
	
	Режим = Режим_ОжиданиеЗначения;
	
	ВременноеЗначение = "";
	
	Если ТипЗнч(п_Текст) = Тип("ТекстовыйДокумент") Тогда
		Текст = п_Текст;
	Иначе
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст(п_Текст);
	КонецЕсли;
	
	Для НомерСтрокиВходнойСтроки = 1 По Текст.КоличествоСтрок() Цикл
		текВходнаяСтрока = Текст.ПолучитьСтроку(НомерСтрокиВходнойСтроки) + Символы.ПС;
		Пока НЕ ПустаяСтрока(текВходнаяСтрока) Цикл
			Если Режим = Режим_ОжиданиеЗначения Тогда
				текВходнаяСтрока = СокрЛ(текВходнаяСтрока);
				ОчереднойСимвол = Лев(текВходнаяСтрока, 1);
				текВходнаяСтрока = Сред(текВходнаяСтрока, 2);
				Если ОчереднойСимвол = "{" Тогда
					ТекущаяСтрока.Тип = п_Тип_Список;
					ТекущаяСтрока = ТекущаяСтрока.Строки.Добавить();
				ИначеЕсли ОчереднойСимвол = """" Тогда
					ТекущаяСтрока.Тип = п_Тип_Строка;
					ВременноеЗначение = "";
					Режим = Режим_ВводСтроки;
				ИначеЕсли ОчереднойСимвол = "," Тогда
					ТекущаяСтрока.Тип = п_Тип_Пусто;
					ТекущаяСтрока = ТекущаяСтрока.Родитель.Строки.Добавить();
					//ТекущаяСтрока.Индекс = ТекущаяСтрока.Родитель.Строки.Индекс(ТекущаяСтрока);
				ИначеЕсли ОчереднойСимвол = "}" Тогда
					ТекущаяСтрока.Тип = п_Тип_Пусто;
					ТекущаяСтрока = ТекущаяСтрока.Родитель;
					//Если ТекущаяСтрока.Строки.Количество() = 1 Тогда
					//	ТекущаяСтрока.Строки.Очистить();
					//КонецЕсли;
					Режим = Режим_ОжиданиеРазделителя;
				Иначе
					ВременноеЗначение = ОчереднойСимвол;
					Режим = Режим_ВводЗначения;
				КонецЕсли;
			ИначеЕсли Режим = Режим_ВводСтроки Тогда
				поз = Найти(текВходнаяСтрока, """");
				Если поз = 0 Тогда
					ВременноеЗначение = ВременноеЗначение + текВходнаяСтрока;
					текВходнаяСтрока = "";
				Иначе
					ВременноеЗначение = ВременноеЗначение + Лев(текВходнаяСтрока, поз - 1);
					текВходнаяСтрока = Сред(текВходнаяСтрока, поз + 1);
					Если Лев(текВходнаяСтрока, 1) = """" Тогда
						ВременноеЗначение = ВременноеЗначение + """";
						текВходнаяСтрока = Сред(текВходнаяСтрока, 2);
					Иначе
						ТекущаяСтрока.Значение = СокрЛП(ВременноеЗначение);
						Режим = Режим_ОжиданиеРазделителя;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли Режим = Режим_ВводЗначения Тогда
				поз1 = Найти(текВходнаяСтрока, ",");
				поз2 = Найти(текВходнаяСтрока, "}");
				Если поз1 = 0 Тогда
					Если поз2 = 0 Тогда
						ВременноеЗначение = ВременноеЗначение + текВходнаяСтрока;
						текВходнаяСтрока = "";
					Иначе
						ВременноеЗначение = ВременноеЗначение + Лев(текВходнаяСтрока, поз2 - 1);
						текВходнаяСтрока = Сред(текВходнаяСтрока, поз2 + 1);
						ТекущаяСтрока.Значение = СокрЛП(ВременноеЗначение);
						КлассифицироватьЗначение(ТекущаяСтрока);
						ТекущаяСтрока = ТекущаяСтрока.Родитель;
						Режим = Режим_ОжиданиеРазделителя;
					КонецЕсли;
				Иначе
					Если поз2 = 0 Тогда
						ВременноеЗначение = ВременноеЗначение + Лев(текВходнаяСтрока, поз1 - 1);
						текВходнаяСтрока = Сред(текВходнаяСтрока, поз1 + 1);
						ТекущаяСтрока.Значение = СокрЛП(ВременноеЗначение);
						КлассифицироватьЗначение(ТекущаяСтрока);
						ТекущаяСтрока = ТекущаяСтрока.Родитель.Строки.Добавить();
						//ТекущаяСтрока.Индекс = ТекущаяСтрока.Родитель.Строки.Индекс(ТекущаяСтрока);
						Режим = Режим_ОжиданиеЗначения;
					Иначе
						Если поз1 < поз2 Тогда
							ВременноеЗначение = ВременноеЗначение + Лев(текВходнаяСтрока, поз1 - 1);
							текВходнаяСтрока = Сред(текВходнаяСтрока, поз1 + 1);
							ТекущаяСтрока.Значение = СокрЛП(ВременноеЗначение);
							КлассифицироватьЗначение(ТекущаяСтрока);
							ТекущаяСтрока = ТекущаяСтрока.Родитель.Строки.Добавить();
							//ТекущаяСтрока.Индекс = ТекущаяСтрока.Родитель.Строки.Индекс(ТекущаяСтрока);
							Режим = Режим_ОжиданиеЗначения;
						Иначе
							ВременноеЗначение = ВременноеЗначение + Лев(текВходнаяСтрока, поз2 - 1);
							текВходнаяСтрока = Сред(текВходнаяСтрока, поз2 + 1);
							ТекущаяСтрока.Значение = СокрЛП(ВременноеЗначение);
							КлассифицироватьЗначение(ТекущаяСтрока);
							ТекущаяСтрока = ТекущаяСтрока.Родитель;
							Режим = Режим_ОжиданиеРазделителя;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли Режим = Режим_ОжиданиеРазделителя Тогда
				текВходнаяСтрока = СокрЛ(текВходнаяСтрока);
				ОчереднойСимвол = Лев(текВходнаяСтрока, 1);
				текВходнаяСтрока = Сред(текВходнаяСтрока, 2);
				Если ОчереднойСимвол = "," Тогда
					Если ТекущаяСтрока.Родитель = Неопределено Тогда
						ТекущаяСтрока = п_Дерево.Строки.Добавить();
					Иначе
						ТекущаяСтрока = ТекущаяСтрока.Родитель.Строки.Добавить();
					КонецЕсли;
					//ТекущаяСтрока.Индекс = ТекущаяСтрока.Родитель.Строки.Индекс(ТекущаяСтрока);
					Режим = Режим_ОжиданиеЗначения;
				ИначеЕсли ОчереднойСимвол = "}" Тогда
					ТекущаяСтрока = ТекущаяСтрока.Родитель;
					//Режим = Режим_ОжиданиеРазделителя;
				Иначе
					Сообщить("Недопустимый символ " + ОчереднойСимвол + " (Код символа " + КодСимвола(ОчереднойСимвол) + ") в режиме ожидания разделителя", СтатусСообщения.Внимание);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьФайлуВремяИзменения(ПолноеИмяФайла, Знач ВремяИзменения)
	
	Если ТипЗнч(ВремяИзменения) = Тип(п_Тип_Число) Тогда
		ВремяИзменения = ДатаИзЧисла(ВремяИзменения);
	КонецЕсли;
	
	п_Файл = Новый Файл(ПолноеИмяФайла);

	Если п_Файл.Существует() И п_Файл.ЭтоФайл() Тогда
		п_Файл.УстановитьВремяИзменения(ВремяИзменения);
	КонецЕсли;
	
КонецПроцедуры

Функция БайтыИзЧисла(Число, Размер)
	
	Буфер = Новый БуферДвоичныхДанных(Размер);
	
	Если Размер = 4 Тогда
		Буфер.ЗаписатьЦелое32(0, Число, ПорядокБайтов.BigEndian);
	Иначе
		Буфер.ЗаписатьЦелое64(0, Число, ПорядокБайтов.BigEndian);
	КонецЕсли;
	
	Хекс = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(Буфер);
	
	Возврат ПолучитьБуферДвоичныхДанныхИзСтроки(?(Размер = 4, НРег(Хекс), ВРег(Хекс)));
	
КонецФункции

Функция ДатаИзЧисла(Число)
	
	Возврат Дата(1, 1, 1) + Число / 10000;
	
КонецФункции 

Функция ДатаЧислом(ДатаВремя)
	
	Возврат (ДатаВремя - Дата(1, 1, 1)) * 10000;
	
КонецФункции

Функция КаталогСуществует(ИмяКаталога)
	
	п_Файл = Новый Файл(ИмяКаталога);
	
	Возврат п_Файл.Существует() И п_Файл.ЭтоКаталог();
	
КонецФункции

Функция МаксимальноеБеззнаковоеЦелоеЧисло64()
	
	Возврат 18446744073709551615;
	
КонецФункции

Функция МаксимальноеЗнаковоеЦелоеЧисло32()
	
	Возврат 2147483647;
	
КонецФункции

Функция НайтиФайл(ИсходныйКаталог, ИмяФайла)
	
	НайденныйФайл = Неопределено;
	
	НайденныеФайлы = НайтиФайлы(ИсходныйКаталог, ИмяФайла, Ложь);
	Если НайденныеФайлы.Количество() Тогда
		НайденныйФайл = НайденныеФайлы[0];
	КонецЕсли;
	
	Возврат НайденныйФайл;
	
КонецФункции

Функция НачинаетсяСBOMИзБуфера(Знач Данные)
	
	Если ТипЗнч(Данные) = Тип(п_Тип_ДвоичныеДанные) Тогда
		Данные = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
	ИначеЕсли ТипЗнч(Данные) = Тип(п_Тип_Строка) Тогда
		ЧтениеДанных = Новый ЧтениеДанных(Данные);
		Данные = ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(3);
		ЧтениеДанных.Закрыть();
	КонецЕсли;
	
	Возврат Данные[0] = 239 И Данные[1] = 187 И Данные[2] = 191; // EF(239) BB(187) BF(191)
	
КонецФункции

Функция ПолучитьХешФайла(Знач ДвоичныеДанные, ТипХешФункции)
	
	Хеш = Новый ХешированиеДанных(ХешФункция[ТипХешФункции]);
	Хеш.Добавить(ДвоичныеДанные);
	
	Возврат Хеш.ХешСумма;
	
КонецФункции

Функция ПрочитатьДанныеФайла(ИсходныйКаталог, ИскомыйФайл) Экспорт
	
	ДанныеФайлаТекст = НайтиФайл(ИсходныйКаталог, ИскомыйФайл);
	
	Если ДанныеФайлаТекст <> Неопределено Тогда
		ТекстОписания = Новый ТекстовыйДокумент;
		ТекстОписания.Прочитать(ДанныеФайлаТекст.ПолноеИмя);
		ДанныеФайлаТекст = ТекстОписания.ПолучитьТекст();
	КонецЕсли;
	
	Возврат ДанныеФайлаТекст;
	
КонецФункции

Функция СтрокаПробелов(Длина)
	ОписаниеТипов = Новый ОписаниеТипов(п_Тип_Строка, Новый КвалификаторыСтроки(Длина, ДопустимаяДлина.Фиксированная));
	Возврат ОписаниеТипов.ПривестиЗначение("");
КонецФункции

Функция ФайлСодержитТолькоBOM(ИмяФайла)
	
	ФайлДляСжатия = Новый Файл(ИмяФайла);
	
	Возврат ФайлДляСжатия.Размер() = 3 И НачинаетсяСBOMИзБуфера(ИмяФайла);
	
КонецФункции

Функция ФайлСуществует(ИмяФайла)
	
	п_Файл = Новый Файл(ИмяФайла);
	
	Возврат п_Файл.Существует() И п_Файл.ЭтоФайл();
	
КонецФункции


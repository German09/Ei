Процедура ПрочитатьТэг(п_ЧтениеДанных, п_ПараметрыСписка)
	
	ПрочитанныеДанные = п_ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(1);
	Если п_ЧтениеДанных.ЧтениеЗавершено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПроверитьБит(ПрочитанныеДанные[0], 5) Тогда
		п_ПараметрыСписка.УровеньСписка = п_ПараметрыСписка.УровеньСписка - 1;
	КонецЕсли;
	
	Если ПроверитьБит(ПрочитанныеДанные[0], 6) Тогда
		Если п_ПараметрыСписка.УровеньСписка = 0 Тогда
			п_ПараметрыСписка.ИндексСписка = п_ПараметрыСписка.ИндексСписка + 1;
		КонецЕсли;
		п_ПараметрыСписка.УровеньСписка = п_ПараметрыСписка.УровеньСписка + 1;
	КонецЕсли;
	
	п_ПараметрыСписка.Тэг = ПрочитанныеДанные[0] % 32;
	

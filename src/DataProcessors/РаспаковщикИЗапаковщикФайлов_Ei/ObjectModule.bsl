						п_ЗаписьДанных_version.ЗаписатьСимволы("{");
						п_ЗаписьДанных_version.ЗаписатьСимволы(Формат(п_ПервыйПараметр, "ЧРД=.; ЧН=0; ЧГ=0"));
						п_ЗаписьДанных_version.ЗаписатьСимволы(",");
						п_ЗаписьДанных_version.ЗаписатьСимволы(Формат(п_ВторойПараметр, "ЧРД=.; ЧН=0; ЧГ=0"));
						
						Если п_НайденнаяКолонкаРежимСовместимости <> Неопределено Тогда
							п_ЗаписьДанных_version.ЗаписатьСимволы(",");
							п_ЗаписьДанных_version.ЗаписатьСимволы(Символы.ПС);
							п_ЗаписьДанных_version.ЗаписатьСимволы("{");
							п_ЗаписьДанных_version.ЗаписатьСимволы(Формат(1, "ЧРД=.; ЧН=0; ЧГ=0"));
							п_ЗаписьДанных_version.ЗаписатьСимволы(",");
							п_ЗаписьДанных_version.ЗаписатьСимволы(Формат(0, "ЧРД=.; ЧН=0; ЧГ=0"));
							п_ЗаписьДанных_version.ЗаписатьСимволы("}");
							п_ЗаписьДанных_version.ЗаписатьСимволы(Символы.ПС);
						КонецЕсли;
						
						п_ЗаписьДанных_version.ЗаписатьСимволы("}");
						п_ЗаписьДанных_version.ЗаписатьСимволы(Символы.ПС);
						п_ЗаписьДанных_version.ЗаписатьСимволы("}");
						п_ЗаписьДанных_version.Закрыть();
						
						п_СжатыйФайл_version = ДефлэйтИзФайлаВДвоичныеДанныеЧерезЗаписьZipФайла(п_ИмяВременногоФайла_version);
						УдалитьФайлы(п_ИмяВременногоФайла_version);
						п_Соответствие_ext["version"] = п_СжатыйФайл_version;
						
						Если п_СтарыйФормат Тогда
							п_Соответствие_root["root"] = GUIDВСтильMS(Строка(Новый УникальныйИдентификатор));
							п_ИмяВременногоФайла_root = ПолучитьИмяВременногоФайла();
							п_ЗаписьДанных_root = Новый ЗаписьДанных(п_ИмяВременногоФайла_root);
							п_ЗаписьДанных_root.ЗаписатьСимволы("{");
							п_ЗаписьДанных_root.ЗаписатьСимволы(Формат(1, "ЧРД=.; ЧН=0; ЧГ=0"));
							п_ЗаписьДанных_root.ЗаписатьСимволы(",");
							п_ЗаписьДанных_root.ЗаписатьСимволы(п_rootobj);
							п_ЗаписьДанных_root.ЗаписатьСимволы(",");
							п_ЗаписьДанных_root.ЗаписатьСимволы(Формат(п_Соответствие_root.Количество(), "ЧРД=.; ЧН=0; ЧГ=0"));
							п_НаборХешСумм_root = Новый СписокЗначений;
							Для Каждого п_ЭлементСоответствия Из п_Соответствие_root Цикл
								п_НаборХешСумм_root.Добавить(п_ЭлементСоответствия.Значение, п_ЭлементСоответствия.Ключ);
							КонецЦикла;
							п_НаборХешСумм_root.СортироватьПоПредставлению();
							Для Каждого п_СтрокаХешСуммы Из п_НаборХешСумм_root Цикл
								п_ЗаписьДанных_root.ЗаписатьСимволы(",");
								п_ЗаписьДанных_root.ЗаписатьСимволы(СтрШаблон("""%1""", СтрЗаменить(п_СтрокаХешСуммы.Представление, """", """""")));
								п_ЗаписьДанных_root.ЗаписатьСимволы(",");
								п_ЗаписьДанных_root.ЗаписатьСимволы(п_СтрокаХешСуммы.Значение);
							КонецЦикла;
							п_ЗаписьДанных_root.ЗаписатьСимволы("}");
							п_ЗаписьДанных_root.Закрыть();
							п_Данныефайла_root = Новый ДвоичныеДанные(п_ИмяВременногоФайла_root);
							УдалитьФайлы(п_ИмяВременногоФайла_root);
							п_Соответствие_metadata["root"] = п_Данныефайла_root;
						Иначе
							п_Соответствие_versions["root"] = GUIDВСтильMS(Строка(Новый УникальныйИдентификатор));
							п_ИмяВременногоФайла_root = ПолучитьИмяВременногоФайла();
							п_ЗаписьДанных_root = Новый ЗаписьДанных(п_ИмяВременногоФайла_root);
							п_ЗаписьДанных_root.ЗаписатьСимволы("{");
							п_ЗаписьДанных_root.ЗаписатьСимволы(Формат(2, "ЧРД=.; ЧН=0; ЧГ=0"));
							п_ЗаписьДанных_root.ЗаписатьСимволы(",");
							п_ЗаписьДанных_root.ЗаписатьСимволы(п_rootobj);
							п_ЗаписьДанных_root.ЗаписатьСимволы(",");
							п_ЗаписьДанных_root.ЗаписатьСимволы("}");
							п_ЗаписьДанных_root.Закрыть();
							п_СжатыйФайл_root = ДефлэйтИзФайлаВДвоичныеДанныеЧерезЗаписьZipФайла(п_ИмяВременногоФайла_root);
							УдалитьФайлы(п_ИмяВременногоФайла_root);
							п_Соответствие_ext["root"] = п_СжатыйФайл_root;
						КонецЕсли;
						
						п_Соответствие_versions["versions"] = GUIDВСтильMS(Строка(Новый УникальныйИдентификатор));
						
						п_ИмяВременногоФайла_versions = ПолучитьИмяВременногоФайла();
						п_ЗаписьДанных_versions = Новый ЗаписьДанных(п_ИмяВременногоФайла_versions);
						п_ЗаписьДанных_versions.ЗаписатьСимволы("{");
						п_ЗаписьДанных_versions.ЗаписатьСимволы(Формат(1, "ЧРД=.; ЧН=0; ЧГ=0"));
						п_ЗаписьДанных_versions.ЗаписатьСимволы(",");
						п_ЗаписьДанных_versions.ЗаписатьСимволы(Формат(п_Соответствие_versions.Количество(), "ЧРД=.; ЧН=0; ЧГ=0"));
						п_НаборХешСумм_versions = Новый СписокЗначений;
						Для Каждого п_ЭлементСоответствия Из п_Соответствие_versions Цикл
							п_НаборХешСумм_versions.Добавить(п_ЭлементСоответствия.Значение, п_ЭлементСоответствия.Ключ);
						КонецЦикла;
						п_НаборХешСумм_versions.СортироватьПоПредставлению();
						Для Каждого п_СтрокаХешСуммы Из п_НаборХешСумм_versions Цикл
							п_ЗаписьДанных_versions.ЗаписатьСимволы(",");
							п_ЗаписьДанных_versions.ЗаписатьСимволы(СтрШаблон("""%1""", СтрЗаменить(п_СтрокаХешСуммы.Представление, """", """""")));
							п_ЗаписьДанных_versions.ЗаписатьСимволы(",");
							п_ЗаписьДанных_versions.ЗаписатьСимволы(п_СтрокаХешСуммы.Значение);
						КонецЦикла;
						п_ЗаписьДанных_versions.ЗаписатьСимволы("}");
						п_ЗаписьДанных_versions.Закрыть();
						
						п_СжатыйФайл_versions = ДефлэйтИзФайлаВДвоичныеДанныеЧерезЗаписьZipФайла(п_ИмяВременногоФайла_versions);
						УдалитьФайлы(п_ИмяВременногоФайла_versions);
						п_Соответствие_ext["versions"] = п_СжатыйФайл_versions;
						
						Если п_СтарыйФормат Тогда
							п_Каталог_metadata = п_Каталог_ext + "\" + "metadata";
							ПроверитьИСоздатьКаталог(п_Каталог_metadata);
							Для Каждого п_ЭлементСоответствия Из п_Соответствие_metadata Цикл
								п_ЭлементСоответствия.Значение.Записать(п_Каталог_metadata + "\" + п_ЭлементСоответствия.Ключ);
							КонецЦикла;
							ПолноеИмяФайлаДляЗаписи = ПолучитьИмяВременногоФайла();
							НовыеПараметрыСборки = НовыйПараметрыСборки();
							НовыеПараметрыСборки.КаталогИсточник = п_Каталог_metadata;
							НовыеПараметрыСборки.ИмяЦелевогоФайла = ПолноеИмяФайлаДляЗаписи;
							НовыеПараметрыСборки.Дефлэйт = Ложь;
							НовыеПараметрыСборки.УровеньВложенности = НовыеПараметрыСборки.УровеньВложенности + 1;
							СформироватьКонтейнер(НовыеПараметрыСборки);
							УдалитьФайлы(п_Каталог_metadata);
							п_СжатыйФайл_metadata = ДефлэйтИзФайлаВДвоичныеДанныеЧерезЗаписьZipФайла(ПолноеИмяФайлаДляЗаписи);
							УдалитьФайлы(ПолноеИмяФайлаДляЗаписи);
							п_СжатыйФайл_metadata.Записать(п_Каталог_metadata);
						КонецЕсли;
						Для Каждого п_ЭлементСоответствия Из п_Соответствие_ext Цикл
							п_ЭлементСоответствия.Значение.Записать(п_Каталог_ext + "\" + п_ЭлементСоответствия.Ключ);
						КонецЦикла;
						
						п_ПараметрыСборки = НовыйПараметрыСборки();
						п_ПараметрыСборки.КаталогИсточник = п_Каталог_ext;
						п_ПараметрыСборки.ИмяЦелевогоФайла = п_ФайлДляСохранения;
						п_ПараметрыСборки.РасширениеЦелевогоФайла = п_РасширениеФайлаДляСохранения;
						п_ПараметрыСборки.Дефлэйт = Ложь;
						СформироватьКонтейнер(п_ПараметрыСборки);
						
						Если СохранитьКонфигурацииПоставщиковОсновная Тогда
							
							//СтруктураФайлаVersion(ИсходныйКаталог) + СохранитьКонфигурацииПоставщиков(Каталог, Инфлэйт = Ложь, СтарыйФормат = Ложь)
							
							п_ФайлRoot = п_Каталог_ext + "\" + "root";
							
							Если ФайлСуществует(п_ФайлRoot) Тогда
								
								п_ДанныеФайлаRoot = Новый ДвоичныеДанные(п_ФайлRoot);
								
								Если НЕ НачинаетсяСBOMИзБуфера(п_ДанныеФайлаRoot) Тогда
									п_ДанныеФайлаRoot = ИнфлэйтВПамятиИзДвоичныхДанныхВДвоичныеДанныеЧерезХранилищеЗначения(п_ДанныеФайлаRoot);
								КонецЕсли;
								
								п_ВременныйФайлRoot = ПолучитьИмяВременногоФайла();
								п_ДанныеФайлаRoot.Записать(п_ВременныйФайлRoot);
								
								п_ЧтениеДанныхRoot = Новый ЧтениеДанных(п_ВременныйФайлRoot, п_Кодировка);

								Пока Истина Цикл
									Р = п_ЧтениеДанныхRoot.ПропуститьДо(п_Маркеры_Список, п_Кодировка);
									Если Р = 0 Тогда
										Р = п_ЧтениеДанныхRoot.ПропуститьДо(",", п_Кодировка);
										Если Р = 0  Тогда
											Р = п_ЧтениеДанныхRoot.ПрочитатьДо(п_Маркеры_Закрытие, п_Кодировка);
											Если Р.ИндексМаркера = 0 ИЛИ Р.ИндексМаркера = 1 Тогда
												п_ФайлОписания = ПолучитьСтрокуИзБуфераДвоичныхДанных(Р.ПолучитьБуферДвоичныхДанных(), п_Кодировка);
												мсНайденныеФайлы = НайтиФайлы(п_Каталог_Ext + "\", п_ФайлОписания + ".*");
												Если мсНайденныеФайлы.Количество() > 0 Тогда
													Для Каждого мсНайденныйФайл Из мсНайденныеФайлы Цикл
														Если мсНайденныйФайл.Расширение <> "" Тогда
															ДанныеФайла = Новый ДвоичныеДанные(мсНайденныйФайл.ПолноеИмя);
															ДанныеФайла = ИнфлэйтВПамятиИзДвоичныхДанныхВДвоичныеДанныеЧерезХранилищеЗначения(ДанныеФайла);
															п_Чтение = Новый ЧтениеДанных(ДанныеФайла, КодировкаТекста.ANSI, ПорядокБайтов.LittleEndian);
															п_Буфер = п_Чтение.ПрочитатьВБуферДвоичныхДанных();
															ПотокФайлаВПамяти = Новый ПотокВПамяти(п_Буфер);
															п_Чтение.Закрыть();
															Если НЕ ПотокЯвляетсяКонтейнером(ПотокФайлаВПамяти) Тогда
																ДанныеФайла = ИнфлэйтВПамятиИзДвоичныхДанныхВДвоичныеДанныеЧерезХранилищеЗначения(ДанныеФайла);
															КонецЕсли;
															ПотокФайлаВПамяти.Закрыть();
															ДанныеФайла.Записать(п_Параметры.ДополнительныйКаталог + "\" + "КонфигурацияПоставщика" + Формат(п_Версия, "ЧЦ=5; ЧВН=; ЧГ=0") + "_" + мсНайденныйФайл.Имя + ".cf");
														КонецЕсли;
													КонецЦикла;
												КонецЕсли;
												Прервать;
											КонецЕсли;
										КонецЕсли;
									ИначеЕсли Р = 1 Тогда
										Прервать;
									КонецЕсли;
								КонецЦикла;
									
								п_ЧтениеДанныхRoot.Закрыть();
								УдалитьФайлы(п_ВременныйФайлRoot);
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
					Прервать;
					
				КонецЦикла;
				
			ИначеЕсли СохранитьОбъектыКонфигурацииИлиРасширенияКонфигурацииХранилища Тогда
				
				Если ВерсияВХранилищеПо < ВерсияВХранилищеС Тогда
					п_ТекущаяВерсия = ВерсияВХранилищеС;
					ВерсияВХранилищеС = ВерсияВХранилищеПо;
					ВерсияВХранилищеПо = п_ТекущаяВерсия;
				КонецЕсли;
				
				п_НайденоВерсий = 0;
				
				Для Инд = 0 По п_ТаблицаВерсий.Количество() - 1 Цикл
					п_ЗаписьТаблицыВерсий = п_ТаблицаВерсий[Инд];
					п_Версия = п_ЗаписьТаблицыВерсий.VERNUM;
					Если п_Версия = ВерсияВХранилищеС Тогда
						п_НайденоВерсий = п_НайденоВерсий + 1;
					КонецЕсли;
					Если п_Версия = ВерсияВХранилищеПо Тогда
						п_НайденоВерсий = п_НайденоВерсий + 1;
					КонецЕсли;
					Если п_НайденоВерсий >= 2 Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если п_НайденоВерсий < 2 Тогда
					ВызватьИсключение "В хранилище не найдены версии
						|Версия с " + ВерсияВХранилищеС + "
						|Версия по " + ВерсияВХранилищеПо;
				КонецЕсли;
					
				п_Каталог_ext = п_Параметры.Каталог + "\" + "D_" + Формат(ВерсияВХранилищеС, "ЧЦ=5; ЧВН=; ЧГ=0") + "-" + Формат(ВерсияВХранилищеПо, "ЧЦ=5; ЧВН=; ЧГ=0");
				ПроверитьИСоздатьКаталог(п_Каталог_ext);
				
				Для Каждого п_ЗаписьТаблицыХранилища Из п_ТаблицаХранилища Цикл
					
					п_ВерсияХранилища = ПолучитьБуферДвоичныхДанныхИзBase64Строки(п_ЗаписьТаблицыХранилища.DEPOTVER).ПрочитатьЦелое64(0);
					
					Если п_ВерсияХранилища >= 5 Тогда
						п_БуферДанныхCVERSION = ПолучитьБуферДвоичныхДанныхИзBase64Строки(п_ЗаписьТаблицыВерсий.CVERSION);
						п_ПервыйПараметр = п_БуферДанныхCVERSION.ПрочитатьЦелое16(0, ПорядокБайтов.BigEndian);
						п_ВторойПараметр = п_БуферДанныхCVERSION.ПрочитатьЦелое16(2, ПорядокБайтов.BigEndian);
					Иначе
						Если п_СтруктураБазы.Версия = "8.0.3.0" ИЛИ п_СтруктураБазы.Версия = "8.0.5.0" Тогда
							п_ПервыйПараметр = 6;
						ИначеЕсли п_СтруктураБазы.Версия = "8.1.0.0" Тогда
							п_ПервыйПараметр = 106;
						Иначе
							п_ПервыйПараметр = 216;
						КонецЕсли;
						п_ВторойПараметр = 0;
					КонецЕсли;
					
					п_СтарыйФормат = ?(п_ПервыйПараметр < 100, Истина, Ложь);
					
					Если п_ВерсияХранилища >= 6 Тогда
						п_КаталогПакетов = п_Файл1CD.Путь + "/data/pack";
						Если Не КаталогСуществует(п_КаталогПакетов) Тогда
							Сообщить("Не найден каталог хранилища
								|Каталог " + п_КаталогПакетов);
						КонецЕсли;
						п_ПакетыДанных = ПакетыДанных(п_КаталогПакетов);
						п_КаталогОбъектов = п_Файл1CD.Путь + "/data/objects";
						Если Не КаталогСуществует(п_КаталогОбъектов) Тогда
							Сообщить("Не найден каталог хранилища
								|Каталог " + п_КаталогОбъектов);
						КонецЕсли;
						п_ХешДанныхHistory = "B1CD_DATAHASH";
						п_ХешДанныхExternals = "B1CD_DATAHASH";
					Иначе
						п_ХешДанныхHistory = Неопределено;
						п_ХешДанныхExternals = Неопределено;
					КонецЕсли;
					
					Если п_СтарыйФормат Тогда
						п_Каталог_ext = п_Каталог_ext + "\" + "metadata";
						ПроверитьИСоздатьКаталог(п_Каталог_ext);
					КонецЕсли;
					
					п_ПозапредыдущаяЗаписьТаблицыИстории = Неопределено;
					п_ПредыдущаяЗаписьТаблицыИстории = Неопределено;
					п_ЗаписьТаблицыИстории = Неопределено;
					п_ЗаписьТаблицыВнешнихДанных = Неопределено;
					п_ТекущийОбъект = Неопределено;
					п_Данные1 = Неопределено;
					п_Данные2 = Неопределено;
					п_ПоследняяВерсия = -1;
					п_ЕстьУдаленные = Ложь;
					п_ЕстьПредыдущаяЗаписьТаблицыИстории = Ложь;
					п_ЕстьПозапредыдущаяЗаписьТаблицыИстории = Ложь;
					
					ИндексВнешнихДанных = 0;
					Для ИндексИстории = 0 По п_ТаблицаИстории.Количество() Цикл
						Если ИндексИстории < п_ТаблицаИстории.Количество() Тогда
							п_ЗаписьТаблицыИстории = п_ТаблицаИстории[ИндексИстории];
						КонецЕсли;
						Если п_ЗаписьТаблицыИстории.B1CD_OBJID <> п_ТекущийОбъект ИЛИ ИндексИстории = п_ТаблицаИстории.Количество() Тогда
							Если ИндексИстории Тогда
								Если п_ЕстьПозапредыдущаяЗаписьТаблицыИстории Тогда
									п_ПоследняяВерсия = п_ПозапредыдущаяЗаписьТаблицыИстории.VERNUM;

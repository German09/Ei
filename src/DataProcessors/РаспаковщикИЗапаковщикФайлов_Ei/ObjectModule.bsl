#Область ЗапаковкаФайла

Процедура Запаковать() Экспорт
	
	п_Файл = Новый Файл(НовыйФайл);
	п_Параметры = Новый Структура;
	п_Параметры.Вставить("Каталог", КаталогРаспаковки + "\" + "Расп");
	п_Параметры.Вставить("Файл", п_Файл.ПолноеИмя);
	п_Параметры.Вставить("ИмяФайла", п_Файл.Имя);
	п_Параметры.Вставить("РасширениеФайла", НРег(п_Файл.Расширение));
		
	Если п_Параметры.РасширениеФайла = ".epf"
		ИЛИ п_Параметры.РасширениеФайла = ".erf"
		ИЛИ п_Параметры.РасширениеФайла = ".cf"
		ИЛИ п_Параметры.РасширениеФайла = ".cfe"
		ИЛИ п_Параметры.РасширениеФайла = ".cfu"
		ИЛИ п_Параметры.РасширениеФайла = ".hbk" Тогда
		ЗапаковатьФайлCF(п_Параметры);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗапаковатьФайлCF(п_Параметры)
	
	п_ПараметрыСборки = НовыйПараметрыСборки();
	п_ПараметрыСборки.КаталогИсточник = п_Параметры.Каталог;
	п_ПараметрыСборки.ИмяЦелевогоФайла = п_Параметры.Файл;
	п_ПараметрыСборки.РасширениеЦелевогоФайла = п_Параметры.РасширениеФайла;
	п_ПараметрыСборки.Дефлэйт = НЕ (п_Параметры.РасширениеФайла = ".cfu" ИЛИ п_Параметры.РасширениеФайла = ".hbk");
	СформироватьКонтейнер(п_ПараметрыСборки);
	Если п_Параметры.РасширениеФайла = ".cfu" Тогда
		ДвоичныеДанные = Новый ДвоичныеДанные(п_Параметры.Файл);
		СжатыйФайл = ДефлэйтИзДвоичныхДанныхВДвоичныеДанныеЧерезЗаписьZipФайла(ДвоичныеДанные);
		СжатыйФайл.Записать(п_Параметры.Файл);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область РазделОсновнойПрограммы

Инициализировать();

#КонецОбласти

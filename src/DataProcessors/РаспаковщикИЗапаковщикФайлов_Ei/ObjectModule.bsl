#КонецОбласти

#Область Расширение_1CD

Функция ПолучитьСтраницыПоНомеру(п_СтруктураБазы, Поток, НомерНачальнойСтраницы, КоличествоСтраниц = 1)
	
	Поток.Перейти(НомерНачальнойСтраницы * п_СтруктураБазы.РазмерСтраницы, ПозицияВПотоке.Начало);
	п_Чтение = Новый ЧтениеДанных(Поток, КодировкаТекста.ANSI, ПорядокБайтов.LittleEndian);
	п_Буфер = п_Чтение.ПрочитатьВБуферДвоичныхДанных(КоличествоСтраниц * п_СтруктураБазы.РазмерСтраницы);
	п_Чтение.Закрыть();
	
	Возврат п_Буфер;
	
КонецФункции

Функция ПолучитьСтруктуруФайлаБазыПоНомеруСтраницыЗаголовка(п_СтруктураБазы, ПотокКонтейнера, НомерСтраницыЗаголовка, ТипСтруктуры = 0)
	
	хБуферДамп = ПолучитьСтраницыПоНомеру(п_СтруктураБазы, ПотокКонтейнера, НомерСтраницыЗаголовка);
	
	Если п_СтруктураБазы.Версия = "8.3.8.0" Тогда
		лТипТаблицыРазмещения = хБуферДамп.ПрочитатьЦелое32(0);
		Если лТипТаблицыРазмещения = 64796 Тогда
			Возврат ПолучитьСтруктуруФайлаБазыПоНомеруСтраницыЗаголовкаТипТаблицыРазмещения1(п_СтруктураБазы, ПотокКонтейнера, НомерСтраницыЗаголовка, ТипСтруктуры = 0);
		КонецЕсли;
	КонецЕсли;
	
	л_Структура = Новый Структура;
	л_Структура.Вставить("НомерСтраницыЗаголовка", НомерСтраницыЗаголовка);
	л_Структура.Вставить("СтраницаЗаголовкаДамп", хБуферДамп);
	л_Структура.Вставить("МассивНомеровСтраницДанных", Неопределено);
	л_Структура.Вставить("ТипТаблицыРазмещения", 0);
	л_Структура.Вставить("Данные", Неопределено);
	
	Если ТипСтруктуры = 0 Тогда
		л_Структура.Вставить("Поля", Неопределено);
		л_Структура.Вставить("Индексы", Неопределено);
		л_Структура.Вставить("РекордЛок", Неопределено);
		л_Структура.Вставить("НомерСтраницыФайлаДанных", Неопределено);
		л_Структура.Вставить("НомерСтраницыФайлаИндексов", Неопределено);
		л_Структура.Вставить("НомерСтраницыФайлаБлоб", Неопределено);
		л_Структура.Вставить("ФайлДанных", Неопределено);
		л_Структура.Вставить("ФайлИндексов", Неопределено);
		л_Структура.Вставить("ФайлБлоб", Неопределено);
		л_Структура.Вставить("РазмерЗаписиВБайтах", Неопределено);
	КонецЕсли;
	
	л_СтруктураЗаголовочнойСтраницы = ПолучитьСтруктуруЗаголовочнойСтраницыФайлаИзБуфера(п_СтруктураБазы, л_Структура.СтраницаЗаголовкаДамп);
	л_Структура.Вставить("Сигнатура", л_СтруктураЗаголовочнойСтраницы.Сигнатура);
	л_Структура.Вставить("РазмерСодержимого", л_СтруктураЗаголовочнойСтраницы.ДлинаСодержимого);
	л_Структура.Вставить("Версия1", л_СтруктураЗаголовочнойСтраницы.Версия1);
	л_Структура.Вставить("Версия2", л_СтруктураЗаголовочнойСтраницы.Версия2);
	л_Структура.Вставить("Версия", л_СтруктураЗаголовочнойСтраницы.Версия);
	л_Структура.Вставить("ТипОбъекта", л_СтруктураЗаголовочнойСтраницы.ТипОбъекта);
	л_Структура.Вставить("МассивСтраницРазмещения", Новый Массив);
	
	Для Каждого лТекНомерСтраницыРазмещения Из л_СтруктураЗаголовочнойСтраницы.МассивНомеровСтраницРазмещения Цикл
		л_СтруктураСтраницыРазмещения = Новый Структура;
		л_СтруктураСтраницыРазмещения.Вставить("НомерСтраницыРазмещения", лТекНомерСтраницыРазмещения);
		л_СтруктураСтраницыРазмещения.Вставить("МассивНомеровСтраницДанных", Новый Массив);
		хБуферДамп = ПолучитьСтраницыПоНомеру(п_СтруктураБазы, ПотокКонтейнера, лТекНомерСтраницыРазмещения);
		л_СтруктураСтраницыРазмещения.Вставить("СтраницаРазмещенияДамп", хБуферДамп);
		
		// Получаем структуру страницы размещения из буфера
			
		// 8.2.14
		// struct {
		//	int numblocks;
		//	unsigned int datablocks[1023];
		//	}
		
		// 8.3.8.0
		// Содержимое страниц таблицы размещения для полного формата 
		// - теперь первое значение не используется для описания количества значений в странице,
		// и для 4К страницы могут использоваться все 1024 значения
		
		лТекущаяСтруктураСтраницыРазмещения = Новый Структура("КоличествоСтраницДанных");
		лТекущаяСтруктураСтраницыРазмещения.Вставить("МассивНомеровСтраницДанных", Новый Массив);
		ПотокФайлаВПамяти = Новый ПотокВПамяти(л_СтруктураСтраницыРазмещения.СтраницаРазмещенияДамп);
		ЧтениеРазмещенияДамп = Новый ЧтениеДанных(ПотокФайлаВПамяти, КодировкаТекста.ANSI, ПорядокБайтов.LittleEndian);
		
		Если п_СтруктураБазы.Версия = "8.0.3.0"
			ИЛИ п_СтруктураБазы.Версия = "8.0.5.0"
			ИЛИ п_СтруктураБазы.Версия = "8.1.0.0"
			ИЛИ п_СтруктураБазы.Версия = "8.2.0.0"
			ИЛИ п_СтруктураБазы.Версия = "8.2.14.0" Тогда
			лКоличествоСтраницДанных = ЧтениеРазмещенияДамп.ПрочитатьЦелое32(); // от 1 до 1023, в битой базе может быть любое
			лТекущаяСтруктураСтраницыРазмещения.КоличествоСтраницДанных = лКоличествоСтраницДанных;
			лКурсор = 4;
			Для лЦикл1 = 0 По лТекущаяСтруктураСтраницыРазмещения.КоличествоСтраницДанных - 1 Цикл
				лНомерСтраницы = ЧтениеРазмещенияДамп.ПрочитатьЦелое32();
				лТекущаяСтруктураСтраницыРазмещения.МассивНомеровСтраницДанных.Добавить(лНомерСтраницы);
				лКурсор = лКурсор + 4;
				Если лКурсор >= п_СтруктураБазы.РазмерСтраницы Тогда
					//ВызватьИсключение "ОШИБКА: страница закончилась (возможно, база повреждена)";
					Прервать;
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли п_СтруктураБазы.Версия = "8.3.8.0" Тогда
			// массив номеров страниц размещения начинается с 0 байта
			лКурсор = 0;
			Пока Истина Цикл
				лНомерСтраницы = ЧтениеРазмещенияДамп.ПрочитатьЦелое32();
				Если лНомерСтраницы = 0 Тогда
					Прервать;
				КонецЕсли;
				лТекущаяСтруктураСтраницыРазмещения.МассивНомеровСтраницДанных.Добавить(лНомерСтраницы);
				лКурсор = лКурсор + 4;
				Если лКурсор >= п_СтруктураБазы.РазмерСтраницы Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если ТипСтруктуры = 1 Тогда
			л_СтруктураСтраницыРазмещения.СтраницаРазмещенияДамп = Неопределено; // не сохраняем дамп для data, index, blob
		КонецЕсли;
		л_СтруктураСтраницыРазмещения.Вставить("КоличествоСтраницДанных", лТекущаяСтруктураСтраницыРазмещения.КоличествоСтраницДанных);
		Для Каждого лТекНомерСтраницыДанных Из лТекущаяСтруктураСтраницыРазмещения.МассивНомеровСтраницДанных Цикл
			л_СтруктураСтраницыРазмещения.МассивНомеровСтраницДанных.Добавить(лТекНомерСтраницыДанных);
		КонецЦикла;
		л_Структура.МассивСтраницРазмещения.Добавить(л_СтруктураСтраницыРазмещения);
	КонецЦикла;
	
	Возврат л_Структура;
	
КонецФункции

Функция ПолучитьСтруктуруЗаголовочнойСтраницыФайлаИзБуфера(п_СтруктураБазы, хБуфер)
	
	л_Структура = Новый Структура("Сигнатура, ДлинаСодержимого, Версия1, Версия2, Версия");
	л_Структура.Вставить("МассивНомеровСтраницРазмещения", Новый Массив);
	л_Структура.Вставить("ТипОбъекта", -1);
	
	Если п_СтруктураБазы.Версия = "8.0.3.0"
		ИЛИ п_СтруктураБазы.Версия = "8.0.5.0"
		ИЛИ п_СтруктураБазы.Версия = "8.1.0.0"
		ИЛИ п_СтруктураБазы.Версия = "8.2.0.0"
		ИЛИ п_СтруктураБазы.Версия = "8.2.14.0" Тогда
		// struct {
		// 	char sig[8]; // сигнатура “1CDBOBV8”
		// 	int length; // длина содержимого объекта
		// 	int version1;
		// 	int version2;
		// 	unsigned int version;
		// 	unsigned int blocks[1018];
		// }
		л_Структура.Сигнатура = ПолучитьДанныеИзБуфера(хБуфер, п_Тип_Строка, 0, 8);
		л_Структура.ДлинаСодержимого = хБуфер.ПрочитатьЦелое32(8);
		л_Структура.Версия1 = хБуфер.ПрочитатьЦелое32(12);
		л_Структура.Версия2 = хБуфер.ПрочитатьЦелое32(16);
		л_Структура.Версия = хБуфер.ПрочитатьЦелое32(20);
		лКурсор = 24;
		Пока Истина Цикл
			лНомерСтраницы = хБуфер.ПрочитатьЦелое32(лКурсор);
			Если лНомерСтраницы = 0 Тогда
				Прервать;
			КонецЕсли;
			л_Структура.МассивНомеровСтраницРазмещения.Добавить(лНомерСтраницы);
			лКурсор = лКурсор + 4;
			Если лКурсор >= п_СтруктураБазы.РазмерСтраницы Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли п_СтруктураБазы.Версия = "8.3.8.0" Тогда
		// struct { 
		//	unsigned int object_type; //0xFD1C или 0x01FD1C 
		//	unsigned int version1;
		//	unsigned int version2;
		//	unsigned int version3;
		//	unsigned long int length; //64-разрядное целое 
		//	unsigned int pages[];
		// }
		л_Структура.Сигнатура = "";
		л_Структура.ТипОбъекта = хБуфер.ПрочитатьЦелое32(0);
		л_Структура.Версия1 = хБуфер.ПрочитатьЦелое32(4);
		л_Структура.Версия2 = хБуфер.ПрочитатьЦелое32(8);
		л_Структура.Версия = хБуфер.ПрочитатьЦелое32(12);
		л_Структура.ДлинаСодержимого = хБуфер.ПрочитатьЦелое64(16);
		лКурсор = 24;
		Пока Истина Цикл // баг из-за количества страниц - его нет
			лНомерСтраницы = хБуфер.ПрочитатьЦелое32(лКурсор);
			Если лНомерСтраницы = 0 Тогда
				Прервать;
			КонецЕсли;
			л_Структура.МассивНомеровСтраницРазмещения.Добавить(лНомерСтраницы);
			лКурсор = лКурсор + 4;
			Если лКурсор >= п_СтруктураБазы.РазмерСтраницы Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат л_Структура;
	
КонецФункции

Функция ПолучитьСтруктуруФайлаБазыПоНомеруСтраницыЗаголовкаТипТаблицыРазмещения1(п_СтруктураБазы, ПотокКонтейнера, НомерСтраницыЗаголовка, ТипСтруктуры = 0)
	
	л_Структура = Новый Структура;
	
	Если ТипСтруктуры = 0 Тогда
		л_Структура.Вставить("Поля", Неопределено);
		л_Структура.Вставить("Индексы", Неопределено);
		л_Структура.Вставить("РекордЛок", Неопределено);
		л_Структура.Вставить("НомерСтраницыФайлаДанных", Неопределено);
		л_Структура.Вставить("НомерСтраницыФайлаИндексов", Неопределено);
		л_Структура.Вставить("НомерСтраницыФайлаБлоб", Неопределено);
		л_Структура.Вставить("ФайлДанных", Неопределено);
		л_Структура.Вставить("ФайлИндексов", Неопределено);
		л_Структура.Вставить("ФайлБлоб", Неопределено);
		л_Структура.Вставить("РазмерЗаписиВБайтах", Неопределено);
	КонецЕсли;
	
	л_Структура.Вставить("НомерСтраницыЗаголовка", НомерСтраницыЗаголовка);
	л_Структура.Вставить("МассивНомеровСтраницДанных", Неопределено);
	л_Структура.Вставить("ТипТаблицыРазмещения", 1);
	л_Структура.Вставить("Данные", Неопределено);
	хБуферДамп = ПолучитьСтраницыПоНомеру(п_СтруктураБазы, ПотокКонтейнера, л_Структура.НомерСтраницыЗаголовка);
	л_Структура.Вставить("СтраницаЗаголовкаДамп", хБуферДамп);
	л_СтруктураЗаголовочнойСтраницы = ПолучитьСтруктуруЗаголовочнойСтраницыФайлаИзБуфера(п_СтруктураБазы, л_Структура.СтраницаЗаголовкаДамп);
	л_Структура.Вставить("Сигнатура", л_СтруктураЗаголовочнойСтраницы.Сигнатура);
	л_Структура.Вставить("РазмерСодержимого", л_СтруктураЗаголовочнойСтраницы.ДлинаСодержимого);
	л_Структура.Вставить("Версия1", л_СтруктураЗаголовочнойСтраницы.Версия1);
	л_Структура.Вставить("Версия2", л_СтруктураЗаголовочнойСтраницы.Версия2);
	л_Структура.Вставить("Версия", л_СтруктураЗаголовочнойСтраницы.Версия);
	л_Структура.Вставить("ТипОбъекта", л_СтруктураЗаголовочнойСтраницы.ТипОбъекта);
	л_Структура.Вставить("МассивСтраницРазмещения", Новый Массив);
	
	Для Каждого лТекНомерСтраницыРазмещения Из л_СтруктураЗаголовочнойСтраницы.МассивНомеровСтраницРазмещения Цикл
		л_СтруктураСтраницыРазмещения = Новый Структура;
		л_СтруктураСтраницыРазмещения.Вставить("НомерСтраницыРазмещения", лТекНомерСтраницыРазмещения);
		л_СтруктураСтраницыРазмещения.Вставить("МассивНомеровСтраницДанных", Неопределено);
		л_СтруктураСтраницыРазмещения.Вставить("СтраницаРазмещенияДамп", Неопределено);
		л_Структура.МассивСтраницРазмещения.Добавить(л_СтруктураСтраницыРазмещения);
	КонецЦикла;
	
	Возврат л_Структура;
	
КонецФункции


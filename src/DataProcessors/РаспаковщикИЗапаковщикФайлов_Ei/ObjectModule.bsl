	//КонецЕсли;
	Если ПараметрыСборки.УровеньВложенности = 0 Тогда
		//УстановитьФайлуВремяИзменения(ПараметрыСборки.ИмяЦелевогоФайла, МеткаВремениИзмененияКонтейнера);
		ОбновитьВремяИзмененияФайла(ШаблонАтрибутов, ПараметрыСборки.ИмяЦелевогоФайла);
	Иначе
		УстановитьФайлуВремяИзменения(ПараметрыСборки.ИмяЦелевогоФайла, МеткаВремениИзмененияКонтейнера);
	КонецЕсли;
	//--
	
КонецПроцедуры

Функция ПолучитьЗаголовокКонтейнера(ПараметрыВерсии, ПараметрыСборки, КоличествоФайлов)
	
	ИсходныйКаталог = ПараметрыСборки.КаталогИсточник;
	
	Если ПараметрыВерсии.РазмерЗаголовкаКонтейнера = 16 Тогда
		// Создадим заголовок контейнера для 32-битной версии контейнера
		БуферЗаголовкаКонтейнера = Новый БуферДвоичныхДанных(16);
		БуферЗаголовкаКонтейнера.ЗаписатьЦелое32(0, МаксимальноеЗнаковоеЦелоеЧисло32());
		БуферЗаголовкаКонтейнера.ЗаписатьЦелое32(4, 512); // размер блока по умолчанию
		БуферЗаголовкаКонтейнера.ЗаписатьЦелое32(8, КоличествоФайлов);
		БуферЗаголовкаКонтейнера.ЗаписатьЦелое32(12, 0);
	ИначеЕсли ПараметрыВерсии.РазмерЗаголовкаКонтейнера = 20 Тогда
		// Создадим заголовок контейнера для 64-битной версии контейнера
		БуферЗаголовкаКонтейнера = Новый БуферДвоичныхДанных(20);
		БуферЗаголовкаКонтейнера.ЗаписатьЦелое64(0, МаксимальноеБеззнаковоеЦелоеЧисло64());
		БуферЗаголовкаКонтейнера.ЗаписатьЦелое32(8, 512); // размер блока по умолчанию
		БуферЗаголовкаКонтейнера.ЗаписатьЦелое32(12, 1);
		БуферЗаголовкаКонтейнера.ЗаписатьЦелое32(16, 0);
	КонецЕсли;
	
	Возврат БуферЗаголовкаКонтейнера;
	
КонецФункции

Функция ПолучитьШаблонАтрибутов()
	
	ВремяСоздания = ДатаЧислом(ТекущаяДата());
	
	БуферАтрибуты = Новый БуферДвоичныхДанных(20);
	БуферАтрибуты.ЗаписатьЦелое64(0, ВремяСоздания);
	БуферАтрибуты.ЗаписатьЦелое64(8, ВремяСоздания);
	БуферАтрибуты.ЗаписатьЦелое32(16, 0);
	
	Возврат БуферАтрибуты;
	
КонецФункции

Функция ПолучитьДокументАтрибутов(Знач ШаблонАтрибутов, ИмяДляФайла, ПолноеИмяФайла = "")
	
	БуферИмениФайла = ПолучитьБуферДвоичныхДанныхИзСтроки(ИмяДляФайла, КодировкаТекста.UTF16);
	
	ОбновитьВремяИзмененияФайла(ШаблонАтрибутов, ПолноеИмяФайла);
	
	Возврат ШаблонАтрибутов.Соединить(БуферИмениФайла).Соединить(Новый БуферДвоичныхДанных(4));
	
КонецФункции

Процедура ДобавитьЗаписьВОглавление(ПотокОглавления, ПотокЗаписи, ПозицииОглавления, ПараметрыВерсии)
	
	ЗарезервироватьПодОглавление(ПотокОглавления, ПотокЗаписи, ПозицииОглавления, ПараметрыВерсии);
	
	ЗаписьОглавления = Новый ЗаписьДанных(ПотокОглавления);
	
	Если ПараметрыВерсии.РазмерПоляАдресации = 4 Тогда
		ЗаписьОглавления.ЗаписатьЦелое32(ПотокЗаписи.ТекущаяПозиция() - ПараметрыВерсии.Смещение);
	Иначе
		ЗаписьОглавления.ЗаписатьЦелое64(ПотокЗаписи.ТекущаяПозиция() - ПараметрыВерсии.Смещение);
	КонецЕсли;
	
	ЗаписьОглавления.Закрыть();
	
КонецПроцедуры

Функция ЗаписатьДокумент(ПотокЗаписи, ИсточникДанных, ПараметрыВерсии, Дефлэйт = Ложь, ЭтоАтрибуты = Ложь)
	
	РезультатЗаписи = Новый Структура("ХешСумма", "");
	РезультатЗаписи.Вставить("Позиция", ПотокЗаписи.ТекущаяПозиция());
	
	Если Дефлэйт И ТипЗнч(ИсточникДанных) = Тип(п_Тип_Строка) Тогда
		ДанныеДокумента = ДефлэйтИзФайлаВДвоичныеДанныеЧерезЗаписьZipФайла(ИсточникДанных);
	ИначеЕсли ТипЗнч(ИсточникДанных) = Тип(п_Тип_Строка) Тогда
		ДанныеДокумента = Новый ДвоичныеДанные(ИсточникДанных);
	ИначеЕсли ТипЗнч(ИсточникДанных) = Тип(п_Тип_ДвоичныеДанные) Тогда
		ДанныеДокумента = ИсточникДанных;
	ИначеЕсли ТипЗнч(ИсточникДанных) = Тип(п_Тип_БуферДвоичныхДанных) Тогда
		ДанныеДокумента = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(ИсточникДанных);
	Иначе
		ВызватьИсключение("Неверный источник данных для документа");
	КонецЕсли;
	
	РазмерДанных = ДанныеДокумента.Размер();
	РезультатЗаписи.Вставить("РазмерДанных", РазмерДанных);
	РазмерБлока = ?(ЭтоАтрибуты, РазмерДанных, Макс(ПараметрыВерсии.РазмерБлокаСодержимого, РазмерДанных));
	
	ЗаписьДокумента = Новый ЗаписьДанных(ПотокЗаписи);
	
	ЗаголовокБлока = ПолучитьЗаголовокБлока(ПараметрыВерсии, РазмерДанных, РазмерБлока);
	ЗаписьДокумента.ЗаписатьБуферДвоичныхДанных(ЗаголовокБлока);
	ЗаписьДокумента.Записать(ДанныеДокумента);
	
	ТребуетсяДописать = РазмерБлока - РазмерДанных;
	
	Если ТребуетсяДописать > 0 Тогда
		ЗаписьДокумента.ЗаписатьБуферДвоичныхДанных(Новый БуферДвоичныхДанных(ТребуетсяДописать));
	КонецЕсли;
	
	ЗаписьДокумента.Закрыть();
	
	Если НЕ ЭтоАтрибуты И ПараметрыВерсии.РасширениеЦелевогоФайла = ".cfe" Тогда
		РезультатЗаписи.ХешСумма = ПолучитьBase64СтрокуИзДвоичныхДанных(ПолучитьХешФайла(ДанныеДокумента, "SHA1"));
	КонецЕсли;
	
	Возврат РезультатЗаписи;
	
КонецФункции

Процедура ЗарезервироватьПодОглавление(ПотокОглавления, ПотокЗаписи, ПозицииОглавления, ПараметрыВерсии)
	
	Если ПотокОглавления.Размер() % ПараметрыВерсии.РазмерБлокаОглавления = 0 Тогда
		// фиксируем текущую позицию в Потоке
		ПозицииОглавления.Добавить(ПотокЗаписи.ТекущаяПозиция());
		// резервируем место в Потоке под следующий блок оглавления 
		РезервируемыйРазмер = ПараметрыВерсии.РазмерБлокаОглавления + ПараметрыВерсии.РазмерЗаголовкаБлока;
		ПотокЗаписи.Записать(Новый БуферДвоичныхДанных(РезервируемыйРазмер), 0, РезервируемыйРазмер);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьМаркерКонцаЗаписиОглавления(ПотокОглавления, ПотокЗаписи, ПозицииОглавления, ПараметрыВерсии)
	
	ЗарезервироватьПодОглавление(ПотокОглавления, ПотокЗаписи, ПозицииОглавления, ПараметрыВерсии);
	
	ЗаписьОглавления = Новый ЗаписьДанных(ПотокОглавления);
	ЗаписьОглавления.ЗаписатьБуферДвоичныхДанных(ПараметрыВерсии.РазделительОглавления);
	ЗаписьОглавления.Закрыть();
	
КонецПроцедуры

Процедура ЗаписатьОглавление(ПотокОглавления, ПотокЗаписи, ПозицииОглавления, ПараметрыВерсии)
	
	ПотокОглавления.Перейти(0, ПозицияВПотоке.Начало);
	
	Для Индекс = 0 По ПозицииОглавления.Количество() - 1 Цикл
		
		// сформировать Заголовок: Размер всего Оглавления, размер блока, адрес след. блока
		
		АдресСледБлока = ?(Индекс < ПозицииОглавления.ВГраница(), ПозицииОглавления[Индекс + 1], Неопределено);
		РазмерДокумента = ?(Индекс = 0, ПотокОглавления.Размер(), 0);
		РазмерБлока = ПараметрыВерсии.РазмерБлокаОглавления;
		
		ЗаголовокБлока = ПолучитьЗаголовокБлока(ПараметрыВерсии, РазмерДокумента, РазмерБлока, АдресСледБлока);
		
		Позиция = ПозицииОглавления[Индекс];
		ПотокЗаписи.Перейти(Позиция, ПозицияВПотоке.Начало);
		ПотокЗаписи.Записать(ЗаголовокБлока, 0, ЗаголовокБлока.Размер);
		
		Скопировано = ПотокОглавления.КопироватьВ(ПотокЗаписи, РазмерБлока);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьФайлConfiginfo(ПотокЗаписи, Оглавление, ПараметрыВерсии)
	
	СтрокаФайлаConfiginfo = НайтиВОглавлении(Оглавление, "configinfo");
	
	Если СтрокаФайлаConfiginfo = Неопределено
		ИЛИ НЕ ЗначениеЗаполнено(СтрокаФайлаConfiginfo.ПолноеИмяФайла) Тогда
		Возврат;
	КонецЕсли;
	
	// Формируем новый файл на основе существующего
	НовыйФайлConfiginfo = СформироватьНовыйФайлConfiginfo(СтрокаФайлаConfiginfo, Оглавление);
	РазмерНового = НовыйФайлConfiginfo.Размер();
	РазмерИсходного = СтрокаФайлаConfiginfo.РазмерСодержимого;
	ПотокЗаписи.Перейти(СтрокаФайлаConfiginfo.АдресСодержимого, ПозицияВПотоке.Начало);
	РазмерДанных = Мин(РазмерИсходного, РазмерНового);
	Остаток = РазмерНового - РазмерИсходного;
	ЗаписьДокумента = Новый ЗаписьДанных(ПотокЗаписи);
	РазмерБлока = РазмерИсходного;
	//++ временное исправление
	//При запаковке файл cfe ошибка:
	//В процессе работы с объектом 'ЗаписьДанных' произошло изменение позиции нижележащего потока извне.
	//Это может привести к некорректной работе приложения.
	//Ошибка при вызове метода контекста (ЗаписатьБуферДвоичныхДанных)
	Остаток = 0;
	РазмерДанных = РазмерНового;
	РазмерБлока = Макс(ПараметрыВерсии.РазмерБлокаСодержимого, РазмерДанных);
	//--
	АдресСледующегоБлока = ?(Остаток <= 0, Неопределено, ПотокЗаписи.Размер());
	ЗаголовокБлока = ПолучитьЗаголовокБлока(ПараметрыВерсии, РазмерДанных, РазмерБлока, АдресСледующегоБлока);
	ЗаписьДокумента.ЗаписатьБуферДвоичныхДанных(ЗаголовокБлока);
	ЗаписьДокумента.Записать(НовыйФайлConfiginfo);
	ТребуетсяДописать = РазмерБлока - РазмерДанных;
	
	Если ТребуетсяДописать > 0 Тогда
		ЗаписьДокумента.ЗаписатьБуферДвоичныхДанных(Новый БуферДвоичныхДанных(ТребуетсяДописать));
	КонецЕсли;
	
	// Результирующий файл мог оказаться больше исходного. 
	// Остаток, не поместившийся в прежнее место, запишем в конец контейнера.
	
	Если Остаток > 0 Тогда
		
		// нужно дописать блок в конец контейнера
		РазмерДанных = Остаток;
		ПотокЗаписи.Перейти(АдресСледующегоБлока, ПозицияВПотоке.Начало);
		РазмерБлока = Макс(ПараметрыВерсии.РазмерБлокаСодержимого, РазмерДанных);
		ЗаголовокБлока = ПолучитьЗаголовокБлока(ПараметрыВерсии, РазмерДанных, РазмерБлока);
		ЗаписьДокумента.ЗаписатьБуферДвоичныхДанных(ЗаголовокБлока);
		ЗаписьДокумента.Записать(НовыйФайлConfiginfo);
		//Буфер = Новый БуферДвоичныхДанных(РазмерДанных);
		//ДД = НовыйФайлConfiginfo.ОткрытьПотокДляЧтения();
		//ДД.Перейти(РазмерИсходного, ПозицияВПотоке.Начало);
		//ДД.Прочитать(Буфер, 0, Остаток);
		//ЗаписьДокумента.ЗаписатьБуферДвоичныхДанных(Буфер);
		ТребуетсяДописать = РазмерБлока - РазмерДанных;
		
		Если ТребуетсяДописать > 0 Тогда
			ЗаписьДокумента.ЗаписатьБуферДвоичныхДанных(Новый БуферДвоичныхДанных(ТребуетсяДописать));
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаписьДокумента.Закрыть();
	
КонецПроцедуры

Функция СформироватьНовыйФайлConfiginfo(ПараметрыФайла, Оглавление)
	
	ДанныеФайла = Новый ДвоичныеДанные(ПараметрыФайла.ПолноеИмяФайла);
	
	Если НЕ НачинаетсяСBOMИзБуфера(ДанныеФайла) Тогда
		ДанныеФайла = ИнфлэйтВПамятиИзДвоичныхДанныхВДвоичныеДанныеЧерезХранилищеЗначения(ДанныеФайла);
	КонецЕсли;
	
	Чтение = Новый ЧтениеДанных(ДанныеФайла, п_Кодировка);
	
	МассивСтрок = Новый Массив;
	Для Каждого АтрибутыФайла Из Оглавление Цикл
		Если АтрибутыФайла.ИмяФайла = "configinfo" Тогда
			Продолжить;
		КонецЕсли;
		МассивСтрок.Добавить(СтрШаблон("""%1"",%2", АтрибутыФайла.ИмяФайла, АтрибутыФайла.ХешСумма));
	КонецЦикла;
	
	НоваяСтрокаХешСумм = СтрШаблон("{%1,%2}", Формат(МассивСтрок.Количество(), "ЧГ=0"), СтрСоединить(МассивСтрок, ","));
	
	// ++ неверно ищется начало строки хешсумм
	//НачалоСтрокиХешСумм = Лев(НоваяСтрокаХешСумм, СтрНайти(НоваяСтрокаХешСумм, ","));
	НачалоСтрокиХешСумм = Лев(НоваяСтрокаХешСумм, СтрНайти(НоваяСтрокаХешСумм, """"));
	// --
	
	СтрокиНовогоФайла = Новый Массив;
	
	Пока НЕ Чтение.ЧтениеЗавершено Цикл
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрНачинаетсяС(СтрокаФайла, НачалоСтрокиХешСумм) Тогда
			СтрокаФайла = НоваяСтрокаХешСумм;
		КонецЕсли;
		СтрокиНовогоФайла.Добавить(СтрокаФайла);
	КонецЦикла;
	
	Чтение.Закрыть();
	
	СтрокиФайла = СтрСоединить(СтрокиНовогоФайла, Символы.ВК + Символы.ПС);
	
	Возврат ДефлэйтИзДвоичныхДанныхВДвоичныеДанныеЧерезЗаписьZipФайла(ПолучитьДвоичныеДанныеИзСтроки(СтрокиФайла, п_Кодировка));
	
КонецФункции

Функция НайтиВОглавлении(Оглавление, ИмяФайла)
	
	Для Каждого СтрокаОглавления Из Оглавление Цикл
		Если СтрокаОглавления.ИмяФайла = ИмяФайла Тогда
			Возврат СтрокаОглавления;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции 

Функция ПолучитьМассивФайлов(КаталогИсточник, МаскаПоискаФайлов, РасширениеЦелевогоФайла)
	
	МассивФайлов = НайтиФайлы(КаталогИсточник, МаскаПоискаФайлов);
	
	 //Сортировать не обязательно, но без сортировки 1С обрабатывает файл на порядок дольше.
	 //Обычная сортировка строк, в т.ч. NNN,NNN.1,NNN.2,...
	
	// Необходимо отсортировать файлы по имени без расширения
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.ЗагрузитьЗначения(МассивФайлов);
	
	//++ временное исправление
	//Ошибка при открытии запакованного файла CFE конфигуратором.
	//Ошибка: Неклассифицированная ошибка документа
	Если РасширениеЦелевогоФайла = ".cfe" Тогда
		ПозицияФайлаConfigInfo = -1;
		Для Каждого ЭлементСписка Из СписокЗначений Цикл
			ЭлементСписка.Представление = ЭлементСписка.Значение.ИмяБезРасширения;
			Если ЭлементСписка.Значение.ИмяБезРасширения = "configinfo" Тогда
				ПозицияФайлаConfigInfo = ЭлементСписка.ПолучитьИдентификатор();
			КонецЕсли;
		КонецЦикла;
		СписокЗначений.СортироватьПоПредставлению();
		//сдвинем файл configinfo на конец списка, чтобы не было ошибки при открытии файла
		Если ПозицияФайлаConfigInfo <> -1 Тогда
			п_ЭлементСписка = СписокЗначений.НайтиПоИдентификатору(ПозицияФайлаConfigInfo);
			//ПозицияЭлемента = СписокЗначений.Индекс(п_ЭлементСписка);
			п_Смещение = СписокЗначений.Количество() - ПозицияФайлаConfigInfo - 1;
			СписокЗначений.Сдвинуть(п_ЭлементСписка, п_Смещение)
		КонецЕсли;
	Иначе
	//--
		Для Каждого ЭлементСписка Из СписокЗначений Цикл
			ЭлементСписка.Представление = ЭлементСписка.Значение.ИмяБезРасширения;
		КонецЦикла;
		
		СписокЗначений.СортироватьПоПредставлению();
	КонецЕсли;
	
	Возврат СписокЗначений.ВыгрузитьЗначения();
	
КонецФункции 

Функция ОпределитьПараметрыВерсииКонтейнера(ПараметрыСборки)
	
	ПараметрыВерсии = Новый Структура;
	ПараметрыВерсии.Вставить("РасширениеЦелевогоФайла", ПараметрыСборки.РасширениеЦелевогоФайла);
	ПараметрыВерсии.Вставить("Представление", "32_bit");
	ПараметрыВерсии.Вставить("РазмерЗаголовкаКонтейнера", 16);
	ПараметрыВерсии.Вставить("РазмерЗаголовкаБлока", 31);
	ПараметрыВерсии.Вставить("РазмерПоляАдресации", 4);
	ПараметрыВерсии.Вставить("РазделительОглавления", ПолучитьБуферДвоичныхДанныхИзHexСтроки("FFFFFF7F"));
	ПараметрыВерсии.Вставить("Смещение", 0);
	ПараметрыВерсии.Вставить("МаксимальноеЦелоеЧисло", МаксимальноеЗнаковоеЦелоеЧисло32());
	ПараметрыВерсии.Вставить("РазмерБлокаОглавления", 512);
	ПараметрыВерсии.Вставить("РазмерБлокаСодержимого", 512);
	ПараметрыВерсии.Вставить("ШаблонЗаголовкаБлока", ПолучитьБуферДвоичныхДанныхИзBase64Строки(
		"DQoAAAAAAAAAACAAAAAAAAAAACA3ZmZmZmZmZiANCg=="));
	
	Если ПараметрыСборки.РасширениеЦелевогоФайла = ".cf" И НЕ КонвертироватьВСтарыйФормат Тогда
		
		СтруктураФайла = СтруктураФайлаVersion(ПараметрыСборки.КаталогИсточник);
		
		Если СтруктураФайла.Версия2 >= 80316 ИЛИ СтруктураФайла.Версия2 = 1 Тогда
			
			ПараметрыВерсии.Представление = "64_bit_offset_0x1359";
			ПараметрыВерсии.РазмерЗаголовкаКонтейнера = 20;
			ПараметрыВерсии.РазмерЗаголовкаБлока = 55;
			ПараметрыВерсии.РазмерПоляАдресации = 8;
			ПараметрыВерсии.РазделительОглавления = ПолучитьБуферДвоичныхДанныхИзHexСтроки("FFFFFFFFFFFFFFFF");
			ПараметрыВерсии.Смещение = 4953;
			ПараметрыВерсии.МаксимальноеЦелоеЧисло = МаксимальноеБеззнаковоеЦелоеЧисло64();
			ПараметрыВерсии.РазмерБлокаОглавления = 65536;
			ПараметрыВерсии.РазмерБлокаСодержимого = 512;
			ПараметрыВерсии.ШаблонЗаголовкаБлока = ПолучитьБуферДвоичныхДанныхИзBase64Строки(
				"DQoAAAAAAAAAAAAAAAAAAAAAIAAAAAAAAAAAAAAAAAAAAAAgRkZGRkZGRkZGRkZGRkZGRiANCg==");
		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПараметрыВерсии;
	
КонецФункции

Функция СтруктураФайлаVersion(ИсходныйКаталог)
	
	п_Структура = Новый Структура("Версия1, Версия2", -1, -1);
	
	п_Файл = НайтиФайл(ИсходныйКаталог, "version");
	
	Если п_Файл <> Неопределено Тогда
		
		п_ПолноеИмяФайла = п_Файл.ПолноеИмя;
		
		п_ДанныеФайла = Новый ДвоичныеДанные(п_ПолноеИмяФайла);
		Если НЕ НачинаетсяСBOMИзБуфера(п_ДанныеФайла) Тогда
			п_ДанныеФайла = ИнфлэйтВПамятиИзДвоичныхДанныхВДвоичныеДанныеЧерезХранилищеЗначения(п_ДанныеФайла);
		КонецЕсли;
			
		п_ЧтениеДанных = Новый ЧтениеДанных(п_ДанныеФайла, п_Кодировка);
		Р = п_ЧтениеДанных.ПропуститьДо(п_Маркеры_Список, п_Кодировка);
		Если Р = 0 Тогда // {
			Р = п_ЧтениеДанных.ПропуститьДо(п_Маркеры_Список, п_Кодировка);
			Если Р = 0 Тогда // {
				Р = п_ЧтениеДанных.ПрочитатьДо(",", п_Кодировка);
				Если Р.ИндексМаркера = 0 Тогда // ,
					п_Структура.Версия1 = Число(ПолучитьСтрокуИзБуфераДвоичныхДанных(Р.ПолучитьБуферДвоичныхДанных(), п_Кодировка));
					Р = п_ЧтениеДанных.ПропуститьДо(п_Маркеры_Список, п_Кодировка);
					Если Р = 0 Тогда // {
						Р = п_ЧтениеДанных.ПрочитатьДо(",", п_Кодировка);
						Если Р.ИндексМаркера = 0 Тогда // ,
							п_Структура.Версия2 = Число(ПолучитьСтрокуИзБуфераДвоичныхДанных(Р.ПолучитьБуферДвоичныхДанных(), п_Кодировка));
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		п_ЧтениеДанных.Закрыть();
		
	КонецЕсли;
	
	Возврат п_Структура;
	
КонецФункции

Процедура ОбновитьВремяИзмененияФайла(ШаблонАтрибутов, ПолноеИмяФайла)
	
	Если ЗначениеЗаполнено(ПолноеИмяФайла) Тогда
		п_Файл = Новый Файл(ПолноеИмяФайла);
		Если п_Файл.Существует() Тогда
			ВремяИзменения = ДатаЧислом(п_Файл.ПолучитьВремяИзменения());
			ШаблонАтрибутов.ЗаписатьЦелое64(0, ВремяИзменения);
			ШаблонАтрибутов.ЗаписатьЦелое64(8, ВремяИзменения);
		КонецЕсли;

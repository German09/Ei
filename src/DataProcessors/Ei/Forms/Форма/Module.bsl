// Процедура - Сохраняет измененную колленцию в показателях результата
//
// Параметры:
//  СтрокаНабора - ДанныеФормыЭлементДерева - Строка дерева вариантов
//
&НаКлиенте
Процедура ВставитьКоллекциюРезультата(СтрокаНабора)
	Если Не СтрокаНабора = Неопределено Тогда
		ИмяОсновногоРеквизита = РезультатыКлиент_Ei.ПолучитьИмяОсновногоРеквизита(СтрокаНабора);
		ОбщегоНазначенияКлиентСервер_Ei.ПроверитьПоказателиРезультата(СтрокаНабора.ПоказателиРезультата);
		ОписаниеЗначения = СохранитьКоллекциюРезультата(ИмяОсновногоРеквизита);
		СтрокаНабора.ПоказателиРезультата.сооАдресовРезультатов.Вставить(СтрокаНабора.ПоказателиВыполнения.ВидРезультата,ОписаниеЗначения);
	КонецЕсли;	
КонецПроцедуры 

// Функция - Сохранить коллекцию результата
//
// Параметры:
//  ИмяОсновногоРеквизита	 - Строка	 - Имя реквизита формы 
// 
// Возвращаемое значение:
//  см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
&НаСервере
Функция СохранитьКоллекциюРезультата(ИмяОсновногоРеквизита)
	Если ТипЗнч(ЭтотОбъект[ИмяОсновногоРеквизита]) = Тип("ТабличныйДокумент") Тогда
		Значение = Новый ТабличныйДокумент;
		Значение.Вывести(ЭтотОбъект[ИмяОсновногоРеквизита]); //именно так если просто взять табличный документ то это быдет ссылка на адрес формы и ее сохранять бесполезно, нужно делать новый объект
	Иначе
		Значение = РеквизитФормыВЗначение(ИмяОсновногоРеквизита);
	КонецЕсли;
	Возврат ОписаниеЗначенияКлиентСервер_Ei.Подготовить(Значение,УникальныйИдентификатор);	
КонецФункции


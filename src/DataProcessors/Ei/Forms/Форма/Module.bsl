
#Область ОписаниеПеременных
&НаКлиенте
Перем НаследованиеФорм Экспорт; //переменная используемая в фреймворке наследования форм, храняться формы от которых текущая форма заимствует поведение + форма в которую нужно передать далее свое поведение
&НаКлиенте
Перем ВКОтслеживания Экспорт;  	//Неопределено - ВК еще не подключали; Ложь - подключить не удалось, больше не пытаемся;
								//иначе объект ВК. Получать через см. ФайлыКлиент_Ei.ПолучитьВКОтслеживания
&НаКлиенте
Перем СнимокСборкиEDT Экспорт; // см. ФормаНабораКлиент_Ei.ГотоваяСборка
&НаКлиенте
Перем ОбновляетсяСборкаEDT Экспорт;
&НаКлиенте
Перем ФайлыКНаборам Экспорт; 	//Соответствие из КлючЗначение:
								//	Ключ 		- Строка - полный путь файла в нижнем регистре
								//	Значение	- Структура:
								//		* ИмяНабора		- Строка - имя набора в дереве наборов
								//		* ВариантКлюч	- Строка - ключ файла в Файлы строки набора
								//		* ХэшОбработанного	- Строка - хэш версии файла, по которой уже было событие;
								//							  повторные события с тем же содержимым пропускаются
								//	Заполняется см. НаборВариантовКлиент_Ei.ЗапомнитьСсылкиНаФайлы
								//	Читается см. НаборВариантовКлиент_Ei.НайтиФайлНабора

#КонецОбласти 

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ВариантыКлиентСервер_Ei.Инициализировать(ЭтотОбъект);
	РезультатыКлиентСервер_Ei.Инициализировать(ЭтотОбъект);
	ФайлыКлиентСервер_Ei.СоздатьМенюПоследнихНаборов(ЭтотОбъект);
	Параметры.Свойство("КаталогНабораEi", КаталогНабораEi);
	Параметры.Свойство("ИмяНабораEi", ИмяНабораEi);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОткрытиеИзEDT = ЗначениеЗаполнено(ИмяНабораEi);
	Если ОткрытиеИзEDT Тогда
		ФормаEi = КонструкторКлиент_Ei.ОткрытаяФормаEi();
		Если ФормаEi <> Неопределено И ФормаEi <> ЭтотОбъект Тогда
			// Отказ устанавливается синхронно, пока платформа еще не открыла второй экземпляр.
			Отказ = Истина;
			ФормаEi.Активизировать();
			ФайлыКлиент_Ei.ОткрытьНабор(ФормаEi, КаталогНабораEi, ИмяНабораEi, Истина, Истина);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	КонструкторКлиент_Ei.ПриЗапуске(ЭтотОбъект, Отказ);
	Если Не Отказ И ОткрытиеИзEDT Тогда
		ФайлыКлиент_Ei.ОткрытьНабор(ЭтотОбъект, КаталогНабораEi, ИмяНабораEi, Ложь, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	КонструкторКлиент_Ei.ПриЗакрытии(ЭтотОбъект,ЗавершениеРаботы);	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	КонструкторКлиент_Ei.ПередЗакрытием(ЭтотОбъект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
КонецПроцедуры

// «Получить ссылку» дает ссылку на текущий набор и вариант, см. НавигационныеСсылкиКлиент_Ei
&НаКлиенте
Процедура ОбработкаПолученияНавигационнойСсылки(Ключ, Представление, НавигационнаяСсылка, СтандартнаяОбработка)
	НавигационныеСсылкиКлиент_Ei.ОбработкаПолученияНавигационнойСсылки(ЭтотОбъект, Представление, НавигационнаяСсылка, СтандартнаяОбработка);
КонецПроцедуры

// Щелчок по ссылке на набор, вариант или параметр Ei в форме (в комментарии) форма открывает сама
&НаКлиенте
Процедура ОбработкаНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	НавигационныеСсылкиКлиент_Ei.ОбработкаНавигационнойСсылки(ЭтотОбъект, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);
КонецПроцедуры

// Внешнее событие.
// 
// Параметры:
//  Источник - Строка - ожидаем "FileWatcher"; см. Файл
//  Событие  - Строка - папка слежения, ровно как передана в НачатьСлежение
//  Данные   - Строка 
&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	Если Источник = ФайлыКлиент_Ei.ИмяВкОтслеживания()
		И Не ВКОтслеживания = Неопределено И Не ВКОтслеживания = Ложь Тогда
		ДанныеСобытия = ПрочитатьЗначениеJSON(Данные);
		// Разрыв слежения приходит и после остановки наблюдения за папкой.
		Если ДанныеСобытия.type = "rescan" Или ВКОтслеживания.СлежениеАктивно(Событие) Тогда
			ФайлыКлиент_Ei.СобытиеОтслеживания(ЭтотОбъект, Событие, ДанныеСобытия);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


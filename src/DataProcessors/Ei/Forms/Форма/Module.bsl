&НаСервере
Процедура ТДвТЗНаСервере(ИдентификаторСтроки,ИмяВыделеннойОбласти)
	СтрокаНабора = ДеревоЗапросов.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если Не СтрокаНабора = Неопределено Тогда
		ПостроительЗапроса 		= Новый ПостроительЗапроса;
		ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(РезультатЗапросаТД.Область(ИмяВыделеннойОбласти));  
		ПостроительЗапроса.Выполнить();
		Результат  									= ПостроительЗапроса.Результат.Выгрузить();
		ОбщегоНазначенияКлиентСервер_Ei.ПроверитьПоказателиРезультата(СтрокаНабора.ПоказателиРезультата);
		СтрокаНабора.ПоказателиВыполнения.ВидРезультата	= ТипыКлиентСервер_Ei.Универсальные().ТаблицаЗначений;
	 	АдресКоллекции 								= СтрокаНабора.ПоказателиРезультата.сооАдресовРезультатов.Получить(СтрокаНабора.ПоказателиВыполнения.ВидРезультата);
		АдресКоллекции 								= ?(АдресКоллекции = Неопределено, УникальныйИдентификатор,АдресКоллекции);
		СтрокаНабора.ПоказателиРезультата.сооАдресовРезультатов.Вставить(СтрокаНабора.ПоказателиВыполнения.ВидРезультата,ПоместитьВоВременноеХранилище(Результат,АдресКоллекции));
	КонецЕсли;
КонецПроцедуры


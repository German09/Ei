Процедура ЗагрузитьРезультат(Форма,ТД) Экспорт
	//проверим подходит ли текущий обработчик, если нет то переключим на подходящий (разумеется если подходящий нашли)
	ОбработчикРезультата = ПодобратьОбработчикРезультата(Форма,ТД);
	Если Не ОбработчикРезультата = Неопределено Тогда
		ИмяОбработчика = ОбработчикРезультата.Свойства().Имя;
		СохранитьТекущийОбработчик(Форма,ТД,ИмяОбработчика);
		АктуализироватьОбработчик(Форма,ИмяОбработчика);
	Иначе
		ОбработчикРезультата = РезультатыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);			
	КонецЕсли;
	Если ОбработчикРезультата = Неопределено Тогда
		//не ожидаем такой ошибки, но предупреждение выведем на всякий случай
		ПоказатьПредупреждение(,"Не удалось определить обработчик результата, попробуйте изменить вариант представления результата");	
	Иначе	
		ОтладкаКлиент_Ei.СкрытьИсключение(Форма,РезультатыКлиентСервер_Ei);	
		СобытиеОтладки 	= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Отображение результата в представлении """+ОбработчикРезультата.Свойства().Синоним+"""","Конструктор");
		Попытка
			ДатаНачала 	= ТекущаяУниверсальнаяДатаВМиллисекундах();
			Форма.ЗагрузитьРезультат(ТД.ПолучитьИдентификатор());
			ОтметитьРезультатПоказанным(Форма,ТД);
			ОбработчикРезультата.ПослеЗагрузкиРезультата(Форма);
			НастройкиПользователяКлиентСервер_Ei.СохранитьЗатраченноеВремя(ТД,Форма.НастройкиПользователя,ОбработчикРезультата,ТекущаяУниверсальнаяДатаВМиллисекундах()-ДатаНачала);
		Исключение
			ОбработчикРезультата.ОбработкаОшибокЗагрузки(Форма,СобытиеОтладки,ИнформацияОбОшибке());
			ОчиститьРезультат(Форма,ТД);
			Возврат;
		КонецПопытки;
		УстановитьВидимостьЛоготипа(Форма,ТД,ОбработчикРезультата);
	    ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	 КонецЕсли;   				
КонецПроцедуры	

// Загружает результат текущего варианта строки, если он получен вложенным запуском и еще не показан.
// Вызывается при смене закладки варианта: при смене строки это делает см. ОбновитьРезультат
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  ТД - ДанныеФормыЭлементДерева - текущая строка набора
//
Процедура ЗагрузитьНепоказанныйРезультат(Форма,ТД) Экспорт
	Если РезультатНеПоказан(Форма,ТД) Тогда
		ЗагрузитьРезультат(Форма,ТД);
	КонецЕсли;
КонецПроцедуры

Функция РезультатНеПоказан(Форма,ТД)
	ОбработчикВарианта = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
	Возврат Не ОбработчикВарианта = Неопределено
		И КэшПользователяКлиентСервер_Ei.РезультатНеПоказан(ТД,Форма.КэшПользователя,ОбработчикВарианта.Свойства().Имя);
КонецФункции

Процедура ОтметитьРезультатПоказанным(Форма,ТД)
	Если РезультатНеПоказан(Форма,ТД) Тогда
		КэшПользователяКлиентСервер_Ei.СохранитьРезультатНеПоказан(ТД,Форма.КэшПользователя,
			ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД).Свойства().Имя,Ложь);
	КонецЕсли;
КонецПроцедуры

Процедура ОбновитьЗаголовки(Форма,ТД) Экспорт
	Для Каждого ЭлРезультата ИЗ РезультатыКлиентСерверПовтИсп_Ei.ПолучитьРезультаты() Цикл
		Обработчик 	= ЭлРезультата.Значение;	
		Страница 	= Форма.Элементы.Найти(ЭлРезультата.Ключ);
		Если Не Страница = Неопределено Тогда
			Время 				= НастройкиПользователяКлиентСервер_Ei.ПолучитьЗатраченноеВремя(ТД,Форма.НастройкиПользователя,Обработчик);
			Размерность			= НастройкиПользователяКлиентСервер_Ei.ПолучитьРазмерность(ТД,Форма.НастройкиПользователя,Обработчик);
			стрОкнчание 		= ?(Не ЗначениеЗаполнено(Размерность),"","("+Размерность+") "); 
			стрОкнчание 		= стрОкнчание + ?(Не ЗначениеЗаполнено(Время),"",""+ОбщегоНазначенияКлиент_Ei.ФорматироватьВремя(Время));  // 0 не выводим поскольку может использоваться динмичский список
			Заголовок 			= СокрЛП(Обработчик.Свойства().Синоним+" "+стрОкнчание);
			ИмяРеквизитаЗаголовка = НаборВариантовКлиентСервер_Ei.ИмяРеквизитаЗаголовка(Обработчик.Свойства().Имя);
			Если Не Форма[ИмяРеквизитаЗаголовка] = Заголовок Тогда //не Страница.Заголовок: его смена сбрасывает размеры областей
				Форма[ИмяРеквизитаЗаголовка] = Заголовок;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;			
КонецПроцедуры	

Процедура ПриОтображенииРезультата(Форма,РезультатИмя)
	ОбработчикРезультата = РезультатыКлиентСерверПовтИсп_Ei.ПолучитьРезультаты().Получить(РезультатИмя);
	Если Не ОбработчикРезультата = Неопределено Тогда
		КонструкторКлиент_Ei.АктивизироватьКП(Форма,ОбработчикРезультата);
		ОтладкаКлиент_Ei.ОбновитьДекорациюОшибки(Форма,РезультатыКлиентСервер_Ei,РезультатИмя);
		ОбработчикРезультата.ПриОтображении(Форма);	
	КонецЕсли;	
КонецПроцедуры		

Процедура ОчиститьРезультат(Форма,ТД)
	//Очищать нечего: серверный вызов меняет реквизиты формы и сбрасывает размеры областей, заданные пользователем.
	//Вызывается при каждом заходе в строку без результата, например с открытой коллекцией.
	//У ТД и JSON общий элемент на все строки, его очищаем всегда.
	ТекущийОбработчик = РезультатыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
	Если Не ТекущийОбработчик = Неопределено
		И КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,ТекущийОбработчик).Родитель.Имя = КонструкторКлиентСервер_Ei.ИмяПустойСтраницы(ТекущийОбработчик)
		И ВидимостьЛоготипа(Форма,ТД,ТекущийОбработчик) Тогда
		Возврат;
	КонецЕсли;
	Форма.ЗагрузитьРезультат(ТД.ПолучитьИдентификатор(),Истина);
	ОбработчикРезультата 	= РезультатыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
	Если Не ОбработчикРезультата = Неопределено Тогда
		ОбработчикРезультата.ПослеЗагрузкиРезультата(Форма);
	КонецЕсли;			
КонецПроцедуры


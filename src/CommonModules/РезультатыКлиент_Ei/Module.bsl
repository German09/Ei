//опредлеим на какой закладке результата нам нужно спозиционироваться нужно заменить функию УстановитьВидРезультата()
Функция ПодобратьОбработчикРезультата(Форма,ТД) Экспорт
	Перем Результат;
	//проверим вначале текущий
	ОбработчикРезультата 	= РезультатыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
	Если Не ОбработчикРезультата = Неопределено Тогда
		ОбработчикВарианта 		= ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
		Если Не ОбработчикВарианта = Неопределено Тогда 
			ОписаниеЗначения 		= КэшПользователяКлиентСервер_Ei.ПолучитьОписаниеРезультата(ТД,Форма.КэшПользователя,ОбработчикВарианта.Свойства().Имя);
			Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ОписаниеЗначения) Тогда
				Если ПроверитьОбработчикРезультата(ОбработчикРезультата,ОписаниеЗначения) Тогда
					Результат= ОбработчикРезультата;
				Иначе
					//Текущий не подошел преберем все остальные
					Для Каждого ЭлСоотв ИЗ РезультатыКлиентСерверПовторноеИспользование_Ei.ПолучитьРезультаты() Цикл
						ОбработчикРезультата =  ЭлСоотв.Значение;
						Если ПроверитьОбработчикРезультата(ОбработчикРезультата,ОписаниеЗначения) Тогда
							Результат = ОбработчикРезультата;
							Прервать;	
						КонецЕсли;	
					КонецЦикла;	
				КонецЕсли;
			КонецЕсли;			 
		КонецЕсли;
	КонецЕсли;
	Возврат Результат; 
КонецФункции

Функция ПроверитьОбработчикРезультата(ОбработчикРезультата,ОписаниеЗначения)
	Результат = Ложь;
	Если ОбработчикРезультата.Свойства().Имя = ОписаниеЗначения.ОписаниеТипов Тогда
		Результат = Истина; //доступно явное отображение
	ИначеЕсли Не ОбработчикРезультата.Свойства().Типы.Найти(ОписаниеЗначения.ОписаниеТипов) = Неопределено  Тогда	
		Результат = Истина; //доступно преобразование
	КонецЕсли;				
	Возврат Результат;	
КонецФункции

Процедура СохранитьТекущийОбработчик(Форма,ТД,КандидатИмя)
	НастройкиПользователяКлиентСервер_Ei.СохранитьИмяТекущегоОбработчика(ТД,Форма.НастройкиПользователя,РезультатыКлиентСервер_Ei.Ключ(),КандидатИмя);	
КонецПроцедуры

Процедура ОбновитьРезультат(Форма, ТД, КандидатИмя)
	Перем ПодобранныйКандидат;
	Перем Кандидат;
	ПодобранныйКандидат = ПодобратьОбработчикРезультата(Форма,ТД);
	Если ПодобранныйКандидат = Неопределено Тогда
		ОчиститьРезультат(Форма,ТД);	
	ИначеЕсли КандидатИмя = ПодобранныйКандидат.Свойства().Имя Тогда
		ЗагрузитьРезультат(Форма,ТД);
	Иначе
		//покажем что не можем отобразить результат в требуемом виде
		Кандидат = РезультатыКлиентСерверПовторноеИспользование_Ei.ПолучитьРезультаты().Получить(КандидатИмя);
		Если Не Кандидат = Неопределено ТОгда  
			ОтладкаКлиент_Ei.ПоказатьИсключение(Форма,"Не можем отобразить результат в данном представлении, используйте " + ПодобранныйКандидат.Свойства().Синоним,РезультатыКлиентСервер_Ei,Кандидат);
		КонецЕсли;	
		ОчиститьРезультат(Форма,ТД);
	КонецЕсли;
КонецПроцедуры

Процедура ВосстановитьНастройки(Форма,ТД) Экспорт
	Если Не ТД = Неопределено Тогда
		СохраненныйИлиВидимыйОбработчик 	= НастройкиПользователяКлиентСервер_Ei.ПолучитьИмяТекущегоОбработчика(ТД,Форма.НастройкиПользователя,РезультатыКлиентСервер_Ei.Ключ());
		Если СохраненныйИлиВидимыйОбработчик =  Неопределено Тогда
			//сохраненного нет, возьмем текущие отображаемые на форме, они могли быть наследованны при изменении строки
			СохраненныйИлиВидимыйОбработчик = ПолучитьКонтейнер(Форма).ТекущаяСтраница.Имя;  	
		КонецЕсли;
		Если Не СохраненныйИлиВидимыйОбработчик =  Неопределено Тогда
			СохранитьТекущийОбработчик(Форма,ТД,СохраненныйИлиВидимыйОбработчик);
			ОбновитьРезультат(Форма,ТД,СохраненныйИлиВидимыйОбработчик);
			АктуализироватьОбработчик(Форма,СохраненныйИлиВидимыйОбработчик);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Процедура ПриСменеОбработчика(Форма,НовыйОбработчикИмя) Экспорт
	ПриОтображенииРезультата(Форма,НовыйОбработчикИмя);
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		ОтладкаКлиент_Ei.ОбновитьДекорациюОшибки(Форма,РезультатыКлиентСервер_Ei,НовыйОбработчикИмя);
		СохранитьТекущийОбработчик(Форма,ТД,НовыйОбработчикИмя);
		ОбновитьРезультат(Форма,ТД,НовыйОбработчикИмя);
		ОбновитьЗаголовки(Форма,ТД);
		//ВариантыКлиент_Ei.ИзменитьПоказателиРезультата(ТД);
	КонецЕсли;
КонецПроцедуры 

Процедура РасшифровкаОшибки(ЭтаФорма,Элемент) Экспорт
	ОтладкаКлиент_Ei.СкрытьГруппуОшибок(Элемент);
Конецпроцедуры

//Если динамический элемент сткрыть, то может скрыться и закладка если на ней больше нет ничего видимого.
//Для отобраджения закладки в обработчиках в серверных функциях загрузки на основе наличия данных мы определяем нужно ли показывать Логотип.
// 
Процедура УстановитьВидимостьДинамичискихЭлементов(Форма,Обработчик,ТД) Экспорт
	Если Не ТД = Неопределено Тогда
		ИмяОсновногоРеквизита 	= РезультатыКлиентСервер_Ei.ПолучитьДинамическоеИмяРеквизита(Обработчик,ТД);
		ПодГруппа 				= РезультатыКлиентСервер_Ei.ПолучитьПодгруппу(Форма,Обработчик);
		Если Не ПодГруппа = Неопределено Тогда
			Для Каждого элФормы ИЗ ПодГруппа.ПодчиненныеЭлементы Цикл                                    
				Если элФормы.Имя = ПодГруппа.Имя+ИмяОсновногоРеквизита Тогда
					элФормы.Видимость 			= Истина;
					ПодГруппа.ТекущаяСтраница 	= элФормы;
				Иначе
					элФормы.Видимость 			= Ложь;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры		  	 		

Процедура Выбор(Форма,Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) Экспорт
	СтандартнаяОбработка 	= Ложь;
	ВыделенныеСтроки		= Новый Массив; //сформируем массив выделенных туда передаим только одну выбранную, конструкция еще используется в перетаскивании
	ВыделенныеСтроки.Добавить(ВыбраннаяСтрока);
	ЗначенияЯчеек 			= ПолучитьВыделенныеЯчейки(Форма, Элемент, ВыделенныеСтроки, Поле);   
	Если ЗначенияЯчеек.Количество() Тогда
		ПоказатьЗначение(,ЗначенияЯчеек[0].Значение); //пока зываем всегда первое, список нет смысла показывать, поскольку из него всеравно ничегоне выборать
 	КонецЕсли;
КонецПроцедуры

Функция ПолучитьВыделенныеЯчейки(Форма, Элемент, ВыделенныеСтроки, Поле) Экспорт
	ВыделенноеСодержимое =  Новый СписокЗначений;
	Если ЗначениеЗаполнено(Поле.Заголовок) Тогда
		Для Каждого ИдСтроки ИЗ ВыделенныеСтроки Цикл
			//TODO #10 для динамического списка совсем по другому получаем выделенные http://forum.infostart.ru/forum9/topic135629/message1445177/#message1445177
			Строка = Форма[Элемент.Имя].НайтиПоИдентификатору(ИдСтроки);
			Если Не Строка = Неопределено Тогда
			    ВыделенноеСодержимое.Добавить(Строка[Поле.Заголовок]);		
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	Возврат ВыделенноеСодержимое; 
КонецФункции	
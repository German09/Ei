Функция Загрузить(Форма,ИД,Параметры) Экспорт
	Результат = Ложь;
	Попытка
		ТД = Форма.ДеревоЗапросов.НайтиПоИдентификатору(ИД);
		Если Не ТД = Неопределено Тогда
			ИмяОсновногоРеквизита 	= ПолучитьИмяОсновногоРеквизита(ТД);
			Результат 				= Форма.вЗагрузитьРезультат(ИД,ИмяОсновногоРеквизита,Параметры);//,мКолонокРезультата);
		КонецЕсли;	
		//ПроцессыКлиент_Ei.СоздатьТочкиСтарта(Процессы_ГрафСхема, мКолонокРезультата, Новый ОписаниеОповещения("ОО_СохранитьИзмененияГрафСхемы",ЭтаФорма));	
	Исключение
		//не смоги показать результат на клиенте, очистим его
		ПоказатьПредупреждение(,"Невозможно отобразить результат на клиенте"+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),20,"Отображение результата");
		ОчиститьРезультат(Форма,ИД);
	КонецПопытки;
	Возврат Результат
КонецФункции	

Процедура ОчиститьРезультат(Форма,ИД)
	ТД = Форма.ДеревоЗапросов.НайтиПоИдентификатору(ИД);
	Если Не ТД = Неопределено Тогда
		ИмяОсновногоРеквизита 	= ПолучитьИмяОсновногоРеквизита(ТД);
		ТД.ПоказателиРезультата.сооАдресовРезультатов = Новый Соответствие;
		Форма.вЗагрузитьРезультат(ИД,ИмяОсновногоРеквизита);
	КонецЕсли;	
КонецПроцедуры

Функция ПолучитьИмяОсновногоРеквизита(ТД) Экспорт 
	сооИменРеквизитов =  Новый Соответствие;
	сооИменРеквизитов.Вставить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ДинамическийСписок,ПеречисленияКлиентСерверПовторноеИспользование_Ei.сРезультатДС());	
	сооИменРеквизитов.Вставить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТаблицаЗначений,"РезультатЗапросаТЗ");
	сооИменРеквизитов.Вставить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ДеревоЗначений,"РезультатЗапросаДЗ");
	сооИменРеквизитов.Вставить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТабличныйДокумент,"РезультатЗапросаТД");
	Результат = сооИменРеквизитов.Получить(ТД.ПоказателиВыполнения.ВидРезультата);
	Результат = ?(Результат = Неопределено,ПеречисленияКлиентСерверПовторноеИспользование_Ei.сРезультатДС(),Результат); //если вдруг! случайно ничего не нашли
	Возврат Результат;
КонецФункции

Функция ПолучитьОписаниеЗначенияСохраненногоРезультата(ТД) Экспорт
	Результат 		= Неопределено;
	Если Не ТД.ПоказателиРезультата = Неопределено Тогда
		ОписаниеЗначенияТаблицаДерево 	= ТД.ПоказателиРезультата.сооАдресовРезультатов.Получить(ТД.ПоказателиВыполнения.ВидРезультата);
		Если ОписаниеЗначенияТаблицаДерево = Неопределено Тогда
			ОписаниеЗначенияРезультатаЗапроса = ТД.ПоказателиРезультата.сооАдресовРезультатов.Получить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().РезультатЗапроса); //РезультатЗапроса
			Если Не ОписаниеЗначенияРезультатаЗапроса = Неопределено Тогда
				Результат	= ОписаниеЗначенияРезультатаЗапроса;
			КонецЕсли;	
		Иначе
			Результат 	= ОписаниеЗначенияТаблицаДерево;
		КонецЕсли;	
	КонецЕсли;
	Возврат Результат; 
КонецФункции

Процедура АктуализироватьСтраницуРезультата(Форма,ТД) Экспорт
	ВидРезультата = ТД.ПоказателиВыполнения.ВидРезультата;
	Если ЗначениеЗаполнено(ВидРезультата) Тогда
		НайденаяСтраница = Форма.Элементы.ПанельРезультата.ПодчиненныеЭлементы.Найти(ВидРезультата);
		Если Не НайденаяСтраница = Неопределено Тогда
			Форма.Элементы.ПанельРезультата.ТекущаяСтраница = НайденаяСтраница;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры


// Установить вид результата. Для позиционирования на определенной закладке результата #4
// 
// Параметры:
//  ВидРезультата Возвращаемый параметр содержащий Тип значения
//  мсТипов Массив Возвращаемый функцией РезультатыКлиентСервер_Ei.мТиповОжидаемыхРезультатов()
//  ОписаниеЗначения  Структура описания значения, формируемая ОбщийМодульКлиентСервер_Ei.ПолучитьОписаниеЗначения()
Процедура УстановитьВидРезультата(ВидРезультата,мсТипов,ОписаниеЗначения) Экспорт
	мсТипов.Удалить(0); 	//Уберем результат запроса, он может быть преобразован к типу/возвращен, но дальше нигде явно не учитываться и его нужно убрать
	Если Не мсТипов.Найти(ОписаниеЗначения.ОписаниеТипов) = Неопределено Тогда
			ВидРезультата = ОписаниеЗначения.ОписаниеТипов; //выровняем либо таблицу, либо дерево если найдено, чтобы автоматом переключится на нужную закладку
		ИначеЕсли мсТипов.Найти(ВидРезультата) = Неопределено Тогда	
			//тут вообще не поддерживаемый тип, установим = таблице
			ВидРезультата = ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТаблицаЗначений;
	КонецЕсли;
КонецПроцедуры		

//опредлеим на какой закладке результата нам нужно спозиционироваться нужно заменить функию УстановитьВидРезультата()
Функция ПодобратьОбработчикРезультата(ТД) Экспорт
	//проверим вначале текущий
	ТекущийОбработчикРезультата = РезультатыКлиентСерверПовторноеИспользование_Ei.ПолучитьРезультаты().Обработчики.Получить(ТД.ПоказателиВыполнения.ВидРезультата);
	Если Не ТекущийОбработчикРезультата = Неопределено И ПроверитьОбработчикРезультата(ТекущийОбработчикРезультата,ТД.ПоказателиРезультата.сооАдресовРезультатов) Тогда
		Результат = ТД.ПоказателиВыполнения.ВидРезультата;	
	Иначе
		//проверим все оставльные начиная с первого, за исключением текущего
		Для Каждого ЭлОбработчикРезультата ИЗ РезультатыКлиентСерверПовторноеИспользование_Ei.ПолучитьРезультаты().Обработчики Цикл
			Если Не ЭлОбработчикРезультата.Ключ = ТД.ПоказателиВыполнения.ВидРезультата Тогда
				Если ПроверитьОбработчикРезультата(ЭлОбработчикРезультата.Значение,ТД.ПоказателиРезультата.сооАдресовРезультатов) Тогда
					Результат = ЭлОбработчикРезультата.Значение.Свойства().Имя; 
					Прервать;
				КонецЕсли;	
			КонецЕсли;	 
		КонецЦикла;	
	КонецЕсли;
	Возврат Результат; 
КонецФункции

Функция ПроверитьОбработчикРезультата(ОбработчикРезультата,сооАдресовРезультатов)
	Результат = Ложь;
	Для каждого ЭлАдресРезультата ИЗ сооАдресовРезультатов Цикл
		Если ОбработчикРезультата.Свойства().Имя = ЭлАдресРезультата.Ключ Тогда
			Результат = Истина; //доступно явное отображение
			Прервать;		
		ИначеЕсли Не ОбработчикРезультата.Свойства().Типы.Найти(ЭлАдресРезультата.Ключ) = Неопределено  Тогда	
			Результат = Истина; //доступно преобразование
			Прервать;
		КонецЕсли;			
	КонецЦикла;	
	Возврат Результат;	
КонецФункции


&НаКлиенте
Процедура ПоменятьВидРезультата(Форма,ВидРезультата) Экспорт
	ДеревоВариантов = Форма.Элементы.ДеревоЗапросов;
	ТД = ДеревоВариантов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		ВариантыКлиент_Ei.ПроверитьПоказателиВыполнения(ТД.ПоказателиВыполнения);
		ТД.ПоказателиВыполнения.ВидРезультата = ВидРезультата;
		ВидРезультатаПодобранный = РезультатыКлиент_Ei.ПодобратьОбработчикРезультата(ТД);
		Если ТД.ПоказателиВыполнения.ВидРезультата = ВидРезультатаПодобранный Тогда
			РезультатыКлиент_Ei.Загрузить(Форма,ДеревоВариантов.ТекущаяСтрока);
		ИначеЕсли Не ВидРезультатаПодобранный = Неопределено Тогда
			//покажем что не можем отобразить результат в требуемом виде, без жанного отображения непонятно что происходит
			ПоказатьПредупреждение(,"Не можем отобразить требуемый результат в данном представлении");
			ОчиститьРезультат(Форма,ДеревоВариантов.ТекущаяСтрока);
		Иначе
			ОчиститьРезультат(Форма,ДеревоВариантов.ТекущаяСтрока);	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	  	 		

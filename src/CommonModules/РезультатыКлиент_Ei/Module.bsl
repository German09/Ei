Функция ПолучитьОписаниеЗначенияСохраненногоРезультата(ТД) Экспорт
	Результат 		= Неопределено;
	Если Не ТД.ПоказателиРезультата = Неопределено Тогда
		ОписаниеЗначенияТаблицаДерево 	= ТД.ПоказателиРезультата.сооАдресовРезультатов.Получить(ТД.ПоказателиВыполнения.ВидРезультата);
		Если ОписаниеЗначенияТаблицаДерево = Неопределено Тогда
			ОписаниеЗначенияРезультатаЗапроса = ТД.ПоказателиРезультата.сооАдресовРезультатов.Получить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().РезультатЗапроса); //РезультатЗапроса
			Если Не ОписаниеЗначенияРезультатаЗапроса = Неопределено Тогда
				Результат	= ОписаниеЗначенияРезультатаЗапроса;
			КонецЕсли;	
		Иначе
			Результат 	= ОписаниеЗначенияТаблицаДерево;
		КонецЕсли;	
	КонецЕсли;
	Возврат Результат; 
КонецФункции

Процедура АктуализироватьОбработчик(Форма,ОбработчикИмя)
	Контейнер 			= ПолучитьКонтейнер(Форма);
	ОбщийМодульКлиент_Ei.АктуализироватьСтраницу(Контейнер,ОбработчикИмя);
КонецПроцедуры


Функция Загрузить(Форма,ИД,Параметры) Экспорт
	Результат = Ложь;
	Попытка
		ТД = Форма.ДеревоЗапросов.НайтиПоИдентификатору(ИД);
		Если Не ТД = Неопределено Тогда
			ИмяОсновногоРеквизита 	= ПолучитьИмяОсновногоРеквизита(ТД);
			Результат 				= Форма.вЗагрузитьРезультат(ИД,ИмяОсновногоРеквизита,Параметры);//,мКолонокРезультата);
		КонецЕсли;	
		//ПроцессыКлиент_Ei.СоздатьТочкиСтарта(Процессы_ГрафСхема, мКолонокРезультата, Новый ОписаниеОповещения("ОО_СохранитьИзмененияГрафСхемы",ЭтаФорма));	
	Исключение
		//не смоги показать результат на клиенте, очистим его
		ПоказатьПредупреждение(,"Невозможно отобразить результат на клиенте"+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),20,"Отображение результата");
		ОчиститьРезультат(Форма,ИД);
	КонецПопытки;
	Возврат Результат
КонецФункции	

Процедура ОчиститьРезультат(Форма,ИД)
	ТД = Форма.ДеревоЗапросов.НайтиПоИдентификатору(ИД);
	Если Не ТД = Неопределено Тогда
		ИмяОсновногоРеквизита 	= ПолучитьИмяОсновногоРеквизита(ТД);
		ТД.ПоказателиРезультата.сооАдресовРезультатов = Новый Соответствие;
		Форма.вЗагрузитьРезультат(ИД,ИмяОсновногоРеквизита);
	КонецЕсли;	
КонецПроцедуры

Функция ПолучитьИмяОсновногоРеквизита(ТД) Экспорт 
	сооИменРеквизитов =  Новый Соответствие;
	сооИменРеквизитов.Вставить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ДинамическийСписок,ПеречисленияКлиентСерверПовторноеИспользование_Ei.сРезультатДС());	
	сооИменРеквизитов.Вставить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТаблицаЗначений,"РезультатЗапросаТЗ");
	сооИменРеквизитов.Вставить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ДеревоЗначений,"РезультатЗапросаДЗ");
	сооИменРеквизитов.Вставить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТабличныйДокумент,"РезультатЗапросаТД");
	Результат = сооИменРеквизитов.Получить(ТД.ПоказателиВыполнения.ВидРезультата);
	Результат = ?(Результат = Неопределено,ПеречисленияКлиентСерверПовторноеИспользование_Ei.сРезультатДС(),Результат); //если вдруг! случайно ничего не нашли
	Возврат Результат;
КонецФункции
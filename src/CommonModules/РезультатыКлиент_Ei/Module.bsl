//опредлеим на какой закладке результата нам нужно спозиционироваться нужно заменить функию УстановитьВидРезультата()
Функция ПодобратьОбработчикРезультата(Форма,ТД) Экспорт
	Перем Результат;
	//проверим вначале текущий
	ОбработчикРезультата 	= РезультатыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
	Если Не ОбработчикРезультата = Неопределено Тогда
		ОбработчикВарианта 		= ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
		Если Не ОбработчикВарианта = Неопределено Тогда 
			ОписаниеЗначения 		= КэшПользователяКлиентСервер_Ei.ПолучитьОписаниеРезультата(ТД,Форма.КэшПользователя,ОбработчикВарианта.Свойства().Имя);
			Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ОписаниеЗначения) Тогда
				Если ПроверитьОбработчикРезультата(ОбработчикРезультата,ОписаниеЗначения) Тогда
					Результат= ОбработчикРезультата;
				Иначе
					//Текущий не подошел преберем все остальные
					Для Каждого ЭлСоотв ИЗ РезультатыКлиентСерверПовтИсп_Ei.ПолучитьРезультаты() Цикл
						ОбработчикРезультата =  ЭлСоотв.Значение;
						Если ПроверитьОбработчикРезультата(ОбработчикРезультата,ОписаниеЗначения) Тогда
							Результат = ОбработчикРезультата;
							Прервать;	
						КонецЕсли;	
					КонецЦикла;	
				КонецЕсли;
				Если Результат = Неопределено Тогда
					//не нашли ниодного подходщего обработчика, будем использовать универсальный
					Результат = РезультатТаблицаКлиентСервер_Ei;	
				КонецЕсли;
			ИначеЕсли ОписаниеЗначения = Неопределено Тогда
				//тут нужно вернуть Неопределено для возможности очистки				
			КонецЕсли;			 
		КонецЕсли;
	КонецЕсли;
	Возврат Результат; 
КонецФункции

Функция ПроверитьОбработчикРезультата(ОбработчикРезультата,ОписаниеЗначения)
	Результат = Ложь;
	Если ОбработчикРезультата.Свойства().ТипРеквизита = ОписаниеЗначения.ОписаниеТипов Тогда
		Результат = Истина; //доступно явное отображение
	ИначеЕсли Не ОбработчикРезультата.Свойства().Типы.Найти(ОписаниеЗначения.ОписаниеТипов) = Неопределено  Тогда	
		Результат = Истина; //доступно преобразование
	КонецЕсли;				
	Возврат Результат;	
КонецФункции

Процедура СохранитьТекущийОбработчик(Форма,ТД,КандидатИмя)
	Перем ДопКлюч;
	ОбработчикВарианта 	= ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
	Если Не ОбработчикВарианта = Неопределено Тогда
		ДопКлюч = ОбработчикВарианта.Свойства().Имя;
	КонецЕсли;	
	НастройкиПользователяКлиентСервер_Ei.СохранитьИмяТекущегоОбработчика(ТД,Форма.НастройкиПользователя,РезультатыКлиентСервер_Ei.Ключ(),ДопКлюч,КандидатИмя);	
КонецПроцедуры

//Выводит результат если для данного обработчика и варианта мы его еще не выводили
//
Процедура ОбновитьРезультат(Форма, ТД, КандидатИмя)
	Перем ПодобранныйКандидат;
	Кандидат 			= РезультатыКлиентСерверПовтИсп_Ei.ПолучитьРезультаты().Получить(КандидатИмя);
	ПодобранныйКандидат = ПодобратьОбработчикРезультата(Форма,ТД);	
	Если ПодобранныйКандидат = Неопределено Тогда
		//Никого не подобрали, такие случаи возможны если нет данных
		ОчиститьРезультат(Форма,ТД);	
	ИначеЕсли КандидатИмя = ПодобранныйКандидат.Свойства().Имя Тогда
		//Подобрали = Кадидата
		ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Форма, ТД, ПодобранныйКандидат);
		элФормы 		= Форма.Элементы.Найти(ИмяРеквизита); 
		Если элФормы = Неопределено Или РезультатНеПоказан(Форма,ТД) Тогда
			//Нет такого реквизита или он показывает прежний результат: новый получен вложенным запуском
			ЗагрузитьРезультат(Форма,ТД);
		КонецЕсли;		
	Иначе
		//Подобрали Не кандидата
		//покажем что не можем отобразить результат в требуемом виде
		Если Не Кандидат = Неопределено Тогда  
			ОтладкаКлиент_Ei.ПоказатьИсключение(Форма,"Не можем отобразить результат в данном представлении, используйте " + ПодобранныйКандидат.Свойства().Синоним,РезультатыКлиентСервер_Ei,Кандидат);
		КонецЕсли;	
		ОчиститьРезультат(Форма,ТД);
	КонецЕсли;
КонецПроцедуры

Процедура ВосстановитьНастройки(Форма,ТД) Экспорт
	Если Не ТД = Неопределено Тогда
		СохраненныйИлиВидимыйОбработчикИмя 	= РезультатыКлиентСервер_Ei.ПолучитьИмяТекущегоОбработчика(Форма, ТД); 
		СохраненныйИлиВидимыйОбработчик 	= РезультатыКлиентСерверПовтИсп_Ei.ПолучитьРезультаты().Получить(СохраненныйИлиВидимыйОбработчикИмя);
		Если Не СохраненныйИлиВидимыйОбработчик =  Неопределено Тогда			
			СохранитьТекущийОбработчик(Форма,ТД,СохраненныйИлиВидимыйОбработчикИмя);
			ОбновитьРезультат(Форма,ТД,СохраненныйИлиВидимыйОбработчикИмя);
			АктуализироватьОбработчик(Форма,СохраненныйИлиВидимыйОбработчикИмя);
			УстановитьВидимостьЛоготипа(Форма,ТД,СохраненныйИлиВидимыйОбработчик);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Процедура ПриСменеОбработчика(Форма,НовыйОбработчикИмя) Экспорт
	ПриОтображенииРезультата(Форма,НовыйОбработчикИмя);
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		Обработчик 	= РезультатыКлиентСерверПовтИсп_Ei.ПолучитьРезультаты().Получить(НовыйОбработчикИмя);
		Если Не Обработчик =  Неопределено Тогда
			//ОтладкаКлиент_Ei.ОбновитьДекорациюОшибки(Форма,РезультатыКлиентСервер_Ei,НовыйОбработчикИмя);
			СохранитьТекущийОбработчик(Форма,ТД,НовыйОбработчикИмя);
			ОбновитьРезультат(Форма,ТД,НовыйОбработчикИмя);
			УстановитьВидимостьЛоготипа(Форма,ТД,Обработчик);
		КонецЕсли;	
		ОбновитьЗаголовки(Форма,ТД);
		//ВариантыКлиент_Ei.ИзменитьПоказателиРезультата(ТД);
	КонецЕсли;
КонецПроцедуры 

Процедура РасшифровкаОшибки(ЭтаФорма,Элемент) Экспорт
	ОтладкаКлиент_Ei.СкрытьГруппуОшибок(Элемент);
Конецпроцедуры

Функция УстановитьВидимостьЛоготипа(Форма,ТД, ОбработчикРезультата) Экспорт	
	Видимость 	= ВидимостьЛоготипа(Форма,ТД, ОбработчикРезультата);
	Логотип		= КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,ОбработчикРезультата);
	Если Не Логотип = Неопределено И Логотип.Родитель.Имя = КонструкторКлиентСервер_Ei.ИмяПустойСтраницы(ОбработчикРезультата) Тогда
		КонструкторКлиент_Ei.ВидимостьДинЭлементов(Форма,ОбработчикРезультата,ТД); //логотип на своей странице: видимость не меняем
	ИначеЕсли Не Логотип = Неопределено И Логотип.Доступность И Не Логотип.Видимость = Видимость Тогда //смена видимости перестраивает форму
		Логотип.Видимость = Видимость;
	КонецЕсли;	
	Возврат Видимость;
КонецФункции

Функция ВидимостьЛоготипа(Форма,ТД, ОбработчикРезультата) Экспорт	
	ИмяРеквизита	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Форма, ТД, ОбработчикРезультата);
	элФормы 	 	= Форма.Элементы.Найти(ИмяРеквизита); 
	ЕстьДанные 		= (Не элФормы = Неопределено И элФормы.ПодчиненныеЭлементы.Количество());
	Возврат НЕ ЕстьДанные;
КонецФункции			  	 			

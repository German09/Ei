Процедура Инициализировать(Форма) Экспорт
	Контейнер = ПолучитьКонтейнер(Форма);
	Для Каждого ЭлРезультата ИЗ РезультатыКлиентСерверПовторноеИспользование_Ei.ПолучитьРезультаты() Цикл
		ОбщийМодульКлиент_Ei.Инициализировать(Форма, Контейнер, ЭлРезультата);
	КонецЦикла;	
Конецпроцедуры

Функция ПолучитьКонтейнер(Форма)
	Возврат Форма.Элементы.ПанельРезультата;	
КонецФункции

Процедура ЗагрузитьРезультат(Форма,ТД) Экспорт
	//проверим подходит ли текущий обработчик, если нет то переключим на подходящий (разумеется если подходящий нашли)
	ОбработчикРезультата = ПодобратьОбработчикРезультата(Форма,ТД);
	Если Не ОбработчикРезультата = Неопределено Тогда
		ИмяОбработчика = ОбработчикРезультата.Свойства().Имя;
		СохранитьТекущийОбработчик(Форма,ТД,ИмяОбработчика);
		АктуализироватьОбработчик(Форма,ИмяОбработчика);
	Иначе
		ОбработчикРезультата = РезультатыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);			
	КонецЕсли;
	ОтладкаКлиент_Ei.СкрытьИсключение(Форма,РезультатыКлиентСервер_Ei);	
	СобытиеОтладки 	= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Отображение результата в представлении """+ОбработчикРезультата.Свойства().Синоним+"""","Конструктор");
	Попытка
		ДатаНачала 	= ТекущаяУниверсальнаяДатаВМиллисекундах();
		Форма.ЗагрузитьРезультат(ТД.ПолучитьИдентификатор());
		ОбработчикРезультата.ПослеЗагрузкиРезультата(Форма);
		НастройкиПользователяКлиентСервер_Ei.СохранитьЗатраченноеВремя(ТД,Форма.НастройкиПользователя,ОбработчикРезультата,ТекущаяУниверсальнаяДатаВМиллисекундах()-ДатаНачала);
	Исключение
		ОбработчикРезультата.ОбработкаОшибокЗагрузки(Форма,СобытиеОтладки,ИнформацияОбОшибке());
		ОчиститьРезультат(Форма,ТД);
		Возврат;
	КонецПопытки;
    ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);				
КонецПроцедуры	

Процедура ОбновитьЗаголовки(Форма,ТД) Экспорт
	Для Каждого ЭлРезультата ИЗ РезультатыКлиентСерверПовторноеИспользование_Ei.ПолучитьРезультаты() Цикл
		Обработчик 	= ЭлРезультата.Значение;	
		Страница 	= Форма.Элементы.Найти(ЭлРезультата.Ключ);
		Если Не Страница = Неопределено Тогда
			Время 				= НастройкиПользователяКлиентСервер_Ei.ПолучитьЗатраченноеВремя(ТД,Форма.НастройкиПользователя,Обработчик);
			Размерность			= НастройкиПользователяКлиентСервер_Ei.ПолучитьРазмерность(ТД,Форма.НастройкиПользователя,Обработчик);
			стрОкнчание 		= ?(Не ЗначениеЗаполнено(Размерность),"","("+Размерность+") "); 
			стрОкнчание 		= стрОкнчание + ?(Не ЗначениеЗаполнено(Время),"",""+ОбщийМодульКлиент_Ei.ФорматироватьВремя(Время));  // 0 не выводим поскольку может использоваться динмичский список
			Страница.Заголовок 	= СокрЛП(Обработчик.Свойства().Синоним+" "+стрОкнчание);		
		КонецЕсли;
	КонецЦикла;			
КонецПроцедуры	

Процедура ПриОтображенииРезультата(Форма,СтрРезультат)
	ОбработчикРезультата = РезультатыКлиентСерверПовторноеИспользование_Ei.ПолучитьРезультаты().Получить(СтрРезультат);
	Если Не ОбработчикРезультата = Неопределено Тогда
		ОбработчикРезультата.ПриОтображении(Форма);	
	КонецЕсли;	
КонецПроцедуры		

Процедура ОчиститьРезультат(Форма,ТД)
	Форма.ЗагрузитьРезультат(ТД.ПолучитьИдентификатор(),Истина);		
КонецПроцедуры


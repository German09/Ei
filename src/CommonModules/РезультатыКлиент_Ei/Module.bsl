//опредлеим на какой закладке результата нам нужно спозиционироваться нужно заменить функию УстановитьВидРезультата()
Функция ПодобратьОбработчикРезультата(ТД) Экспорт
	//проверим вначале текущий
	ТекущийОбработчикРезультата = РезультатыКлиентСерверПовторноеИспользование_Ei.ПолучитьРезультаты().Получить(ТД.ПоказателиВыполнения.ВидРезультата);
	Если Не ТекущийОбработчикРезультата = Неопределено И ПроверитьОбработчикРезультата(ТекущийОбработчикРезультата,ТД.ПоказателиРезультата.сооАдресовРезультатов) Тогда
		Результат = ТД.ПоказателиВыполнения.ВидРезультата;	
	Иначе
		//проверим все оставльные начиная с первого, за исключением текущего
		Для Каждого ЭлОбработчикРезультата ИЗ РезультатыКлиентСерверПовторноеИспользование_Ei.ПолучитьРезультаты() Цикл
			Если Не ЭлОбработчикРезультата.Ключ = ТД.ПоказателиВыполнения.ВидРезультата Тогда
				Если ПроверитьОбработчикРезультата(ЭлОбработчикРезультата.Значение,ТД.ПоказателиРезультата.сооАдресовРезультатов) Тогда
					Результат = ЭлОбработчикРезультата.Значение.Свойства().Имя; 
					Прервать;
				КонецЕсли;	
			КонецЕсли;	 
		КонецЦикла;	
	КонецЕсли;
	Возврат Результат; 
КонецФункции

Функция ПроверитьОбработчикРезультата(ОбработчикРезультата,сооАдресовРезультатов)
	Результат = Ложь;
	Для каждого ЭлАдресРезультата ИЗ сооАдресовРезультатов Цикл
		Если ОбработчикРезультата.Свойства().Имя = ЭлАдресРезультата.Ключ Тогда
			Результат = Истина; //доступно явное отображение
			Прервать;		
		ИначеЕсли Не ОбработчикРезультата.Свойства().Типы.Найти(ЭлАдресРезультата.Ключ) = Неопределено  Тогда	
			Результат = Истина; //доступно преобразование
			Прервать;
		КонецЕсли;			
	КонецЦикла;	
	Возврат Результат;	
КонецФункции

Процедура СохранитьТекущийОбработчик(Форма,ТД,Кандидат) Экспорт
	//ВариантыКлиент_Ei.ПроверитьПоказателиВыполнения(ТД.ПоказателиВыполнения);
	//ТД.ПоказателиВыполнения.ВидРезультата = ВидРезультата;
	НастройкиПользователяКлиентСервер_Ei.СохранитьИмяТекущегоОбработчика(ТД,Форма.НастройкиПользователя,РезультатыКлиентСерверПовторноеИспользование_Ei.Ключ(),Кандидат);
	ПодобранныйКандидат = РезультатыКлиент_Ei.ПодобратьОбработчикРезультата(ТД);
	Если Кандидат = ПодобранныйКандидат Тогда
		РезультатыКлиент_Ei.Загрузить(Форма,ТД.ПолучитьИдентификатор());
	ИначеЕсли Не ПодобранныйКандидат = Неопределено Тогда
		//покажем что не можем отобразить результат в требуемом виде, без данного отображения непонятно что происходит
		ПоказатьПредупреждение(,"Не можем отобразить требуемый результат в данном представлении");
		ОчиститьРезультат(Форма,ТД.ПолучитьИдентификатор());
	Иначе
		ОчиститьРезультат(Форма,ТД.ПолучитьИдентификатор());	
	КонецЕсли;	
КонецПроцедуры

Процедура ВосстановитьНастройки(Форма,ТД) Экспорт
	Если Не ТД = Неопределено Тогда
		КандидатВТекущий 	= НастройкиПользователяКлиентСервер_Ei.ПолучитьИмяТекущегоОбработчика(ТД,Форма.НастройкиПользователя,РезультатыКлиентСерверПовторноеИспользование_Ei.Ключ());
		СохранитьТекущийОбработчик(Форма,ТД,КандидатВТекущий);
		АктуализироватьОбработчик(Форма,КандидатВТекущий);
	КонецЕсли;	
КонецПроцедуры

Процедура ПриСменеОбработчика(Форма,НовыйОбработчикИмя) Экспорт
	ТД = Форма.Элементы.ДеревоЗапросов.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		СохранитьТекущийОбработчик(Форма,ТД,НовыйОбработчикИмя);
		//теперь тут какие то подсчеты
		ВариантыКлиент_Ei.ИзменитьПоказателиРезультата(ТД);
	КонецЕсли;
КонецПроцедуры 		  	 		


Процедура ИнициализироватьРезультаты(Форма,КонтейнерВариантов) Экспорт
	Для Каждого ЭлРезультата ИЗ РезультатыКлиентСерверПовторноеИспользование_Ei.ПолучитьРезультаты().Обработчики Цикл
		ОбщийМодульКлиент_Ei.Инициализировать(Форма, КонтейнерВариантов, ЭлРезультата);
	КонецЦикла;	
Конецпроцедуры

Процедура Загрузить(Форма,ИД) Экспорт
	ТД = Форма.ДеревоЗапросов.НайтиПоИдентификатору(ИД);
	Если Не ТД = Неопределено Тогда
		Попытка
			ТД.ПоказателиВыполнения.ВидРезультата = ПодобратьОбработчикРезультата(ТД);
			АктуализироватьСтраницуРезультата(Форма,ТД);
			Форма.ЗагрузитьРезультат(ИД);	
		Исключение
			//не смоги показать результат на клиенте, очистим его
			ПоказатьПредупреждение(,"Невозможно отобразить результат на клиенте"+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),20,"Отображение результата");
			ОчиститьРезультат(Форма,ИД);
		КонецПопытки;
	КонецЕсли;	
КонецПроцедуры	

Процедура ОчиститьРезультат(Форма,ИД)
	Форма.ЗагрузитьРезультат(ИД,Истина);		
КонецПроцедуры


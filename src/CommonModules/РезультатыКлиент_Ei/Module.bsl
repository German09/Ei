Процедура Инициализировать(Форма) Экспорт
	Контейнер = ПолучитьКонтейнер(Форма);
	Для Каждого ЭлРезультата ИЗ РезультатыКлиентСерверПовторноеИспользование_Ei.ПолучитьРезультаты() Цикл
		ОбщийМодульКлиент_Ei.Инициализировать(Форма, Контейнер, ЭлРезультата);
	КонецЦикла;	
Конецпроцедуры

Функция ПолучитьКонтейнер(Форма)
	Возврат Форма.Элементы.ПанельРезультата;	
КонецФункции	

Процедура Загрузить(Форма,ИД) Экспорт
	ТД = Форма.ДеревоЗапросов.НайтиПоИдентификатору(ИД);
	Если Не ТД = Неопределено Тогда
		Попытка
			ОбработчикРезультатаИмя = ПодобратьОбработчикРезультата(ТД);
			АктуализироватьОбработчик(Форма,ОбработчикРезультатаИмя);
			Форма.ЗагрузитьРезультат(ИД);	
		Исключение
			//не смоги показать результат на клиенте, очистим его
			ПоказатьПредупреждение(,"Невозможно отобразить результат на клиенте"+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),20,"Отображение результата");
			ОчиститьРезультат(Форма,ИД);
		КонецПопытки;
	КонецЕсли;	
КонецПроцедуры	

Процедура ОчиститьРезультат(Форма,ИД)
	Форма.ЗагрузитьРезультат(ИД,Истина);		
КонецПроцедуры


// Ссылки на набор, вариант и параметр Ei в форме Ei: получение («Получить ссылку», «Ссылка на параметр»)
// и открытие по ссылке командой Ei. Как устроена ссылка - см. НавигационныеСсылкиКлиентСервер_Ei

#Область ПрограммныйИнтерфейс

// Ссылка на текущий набор и вариант формы Ei вместо стандартной ссылки формы.
// Если текущего набора нет, остается стандартная ссылка формы
//
// Параметры:
//  Форма 					- см. Обработка.Ei.Форма.Форма
//  Представление 			- Строка - возвращается представление ссылки
//  НавигационнаяСсылка 	- Строка - возвращается ссылка
//  СтандартнаяОбработка 	- Булево - Ложь, если ссылка получена
//
Процедура ОбработкаПолученияНавигационнойСсылки(Форма, Представление, НавигационнаяСсылка, СтандартнаяОбработка) Экспорт
	
	СтрокаНабора = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не СтрокаНабора = Неопределено И ЗначениеЗаполнено(СтрокаНабора.КлючНастроек) Тогда
		Представление 			= "";
		Вариант 				= ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма, СтрокаНабора);
		НавигационнаяСсылка 	= СсылкаНаСтроку(СтрокаНабора, Вариант, Представление);
		СтандартнаяОбработка 	= Ложь;
	КонецЕсли;
	
КонецПроцедуры

// Команда «Ссылка на параметр» контекстного меню параметров: ссылка на текущий параметр - в буфер обмена.
// Вставка такой ссылки из буфера в параметры другой строки дает выражение получения параметра,
// см. ПараметрыКлиент_Ei.ИзБуфера
//
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
//
Асинх Процедура СкопироватьСсылкуНаПараметр(Форма) Экспорт
	
	СтрокаНабора 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Параметр 		= ПараметрыКлиент_Ei.КоллекцияПараметров(Форма).ТекущиеДанные;
	Если СтрокаНабора = Неопределено Или Параметр = Неопределено Или Не ЗначениеЗаполнено(Параметр.ИмяПараметра) Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Выберите параметр строки набора.'"));
	Иначе
		Если Не ЗначениеЗаполнено(Параметр.Ключ) Тогда
			// только этому параметру: ПараметрыКлиент_Ei.ОбновитьКлючи перевыдает ключи всем и ломает выданные ссылки
			Параметр.Ключ = ПараметрыКлиентСервер_Ei.ПолучитьНовыйКлюч();
		КонецЕсли;
		Представление 	= "";
		Ссылка 			= СсылкаНаПараметр(СтрокаНабора, Параметр, Представление);
		Скопирована 	= Ложь;
		Если СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
			// ПоместитьДанныеАсинх принимает ЭлементБуфераОбмена или массив таких элементов, строку - нет
			ЭлементБуфера = Новый ЭлементБуфераОбмена(СтандартныйФорматДанныхБуфераОбмена.Текст, Ссылка);
			Попытка
				Скопирована = Ждать СредстваБуфераОбмена.ПоместитьДанныеАсинх(ЭлементБуфера);
			Исключение
				Скопирована = Ложь; // буфер недоступен: ссылку покажем для копирования
			КонецПопытки;
		КонецЕсли;
		Если Скопирована = Истина Тогда
			ПоказатьОповещениеПользователя(НСтр("ru = 'Ссылка на параметр скопирована'"), Ссылка, Представление,
				ОбщегоНазначенияКлиент_Ei.КартинкаОповещения());
		Иначе
			Ждать ВвестиСтрокуАсинх(Ссылка, Представление, , Ложь);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Ссылка на строку дерева наборов и вариант
//
// Параметры:
//  СтрокаНабора 	- ДанныеФормыЭлементДерева
//  Вариант 		- ОбщийМодуль, Неопределено - вид варианта; Неопределено - закладка при открытии не меняется
//  Представление 	- Строка - представление ссылки; пустое заполняется: «Ei: <строка> <вариант>»
//
// Возвращаемое значение:
//  Строка - e1cib/command/ОбщаяКоманда.Ei?extdata=...
//
Функция СсылкаНаСтроку(СтрокаНабора, Вариант, Представление = "") Экспорт
	
	КодВарианта 		= "";
	СинонимВарианта 	= "";
	Если Не Вариант = Неопределено Тогда
		КодВарианта 		= Вариант.Свойства().Код;
		СинонимВарианта 	= Вариант.Свойства().Синоним;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Представление) Тогда
		Представление = СокрЛП(СтрШаблон("Ei: %1 %2", СтрокаНабора.ИмяНабора, СинонимВарианта));
	КонецЕсли;
	
	Возврат НавигационныеСсылкиВызовСервера_Ei.Ссылка(
		НавигационныеСсылкиКлиентСервер_Ei.Идентификатор(СтрокаНабора.КлючНастроек, КодВарианта), Представление);
	
КонецФункции

// Ссылка на параметр строки дерева наборов
//
// Параметры:
//  СтрокаНабора 	- ДанныеФормыЭлементДерева
//  Параметр 		- ДанныеФормыЭлементКоллекции - строка ПараметрыЗапроса с заполненным Ключ
//  Представление 	- Строка - представление ссылки; пустое заполняется: «Ei: <строка> &<параметр>»
//
// Возвращаемое значение:
//  Строка - e1cib/command/ОбщаяКоманда.Ei?extdata=...
//
Функция СсылкаНаПараметр(СтрокаНабора, Параметр, Представление = "") Экспорт
	
	Если Не ЗначениеЗаполнено(Представление) Тогда
		Представление = СтрШаблон("Ei: %1 &%2", СтрокаНабора.ИмяНабора, Параметр.ИмяПараметра);
	КонецЕсли;
	
	Возврат НавигационныеСсылкиВызовСервера_Ei.Ссылка(
		НавигационныеСсылкиКлиентСервер_Ei.Идентификатор(СтрокаНабора.КлючНастроек, "", Параметр.Ключ), Представление);
	
КонецФункции

// Строка и параметр из ссылки на параметр, если они есть в открытой форме Ei
//
// Параметры:
//  Форма 	- см. Обработка.Ei.Форма.Форма
//  Данные 	- см. НавигационныеСсылкиКлиентСервер_Ei.ДанныеСсылки
//
// Возвращаемое значение:
//  - Структура:
//   * СтрокаНабора - ДанныеФормыЭлементДерева
//   * Параметр - ДанныеФормыЭлементКоллекции - строка ПараметрыЗапроса
//  - Неопределено - строки или параметра нет в форме
//
Функция ПараметрПоСсылке(Форма, Данные) Экспорт
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(Данные.Параметр) Тогда
		СтрокаНабора = НайтиНабор(НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма), Данные.Набор);
		Если Не СтрокаНабора = Неопределено Тогда
			Параметр = НайтиПараметр(СтрокаНабора, Данные.Параметр);
			Если Не Параметр = Неопределено Тогда
				Результат = Новый Структура("СтрокаНабора, Параметр", СтрокаНабора, Параметр);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Событие формы Ei ОбработкаНавигационнойСсылки: ссылку на набор, вариант или параметр Ei, по которой щелкнули
// в форме (в комментарии), форма открывает сама, не отдавая платформе; так открывается и ссылка с одним ei=
//
// Параметры:
//  Форма 					- см. Обработка.Ei.Форма.Форма
//  НавигационнаяСсылка 	- Строка
//  СтандартнаяОбработка 	- Булево - Ложь, если это ссылка Ei
//
Процедура ОбработкаНавигационнойСсылки(Форма, НавигационнаяСсылка, СтандартнаяОбработка) Экспорт
	
	Данные = НавигационныеСсылкиКлиентСервер_Ei.ДанныеСсылки(НавигационнаяСсылка);
	Если Не Данные = Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьПоСсылке(Форма, Данные);
	КонецЕсли;
	
КонецПроцедуры

// Данные ссылки на набор и вариант, по которой выполняется команда Ei
//
// Параметры:
//  ПараметрыВыполненияКоманды - ПараметрыВыполненияКоманды
//
// Возвращаемое значение:
//  - см. НавигационныеСсылкиКлиентСервер_Ei.ДанныеСсылки
//  - Неопределено - команду открыли не по ссылке на набор
//
Функция ДанныеСсылкиКоманды(ПараметрыВыполненияКоманды) Экспорт
	
	Результат 		= Неопределено;
	ИмяПараметра 	= НавигационныеСсылкиКлиентСервер_Ei.ИмяПараметраИдентификатора();
	Свойства 		= Новый Структура("НавигационнаяСсылка, Параметры");
	ЗаполнитьЗначенияСвойств(Свойства, ПараметрыВыполненияКоманды);
	Если ТипЗнч(Свойства.Параметры) = Тип("Структура") И Свойства.Параметры.Свойство(ИмяПараметра) Тогда
		// идентификатор из хранилища внешних данных ссылки, см. НавигационныеСсылкиВызовСервера_Ei.Ссылка
		Результат = НавигационныеСсылкиКлиентСервер_Ei.ДанныеИдентификатора(Свойства.Параметры[ИмяПараметра]);
	ИначеЕсли ТипЗнч(Свойства.Параметры) = Тип("Структура")
		И Свойства.Параметры.Свойство("Набор")
		И ЗначениеЗаполнено(Свойства.Параметры.Набор) Тогда
		// ссылки первой версии 3.2.5.1: в хранилище ключ строки и код варианта
		Результат = НавигационныеСсылкиКлиентСервер_Ei.ДанныеИдентификатора(НавигационныеСсылкиКлиентСервер_Ei.Идентификатор(
			Свойства.Параметры.Набор, ?(Свойства.Параметры.Свойство("Вариант"), Свойства.Параметры.Вариант, "")));
	ИначеЕсли ТипЗнч(Свойства.НавигационнаяСсылка) = Тип("Строка") Тогда
		Результат = НавигационныеСсылкиКлиентСервер_Ei.ДанныеСсылки(Свойства.НавигационнаяСсылка);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Открыть в форме Ei набор и вариант или параметр по данным ссылки.
// Набор, который уже есть в форме, просто становится текущим. Иначе обработка с набором ищется в папке открытого набора
// и в папках последних наборов, ее состав читается, и только если в прочитанном есть набор из ссылки, спрашивается
// о сохранении изменений формы и набор загружается: несохраненные варианты не теряются из-за ссылки, которая не откроется
//
// Параметры:
//  Форма 	- см. Обработка.Ei.Форма.Форма
//  Данные 	- см. НавигационныеСсылкиКлиентСервер_Ei.ДанныеСсылки
//
Асинх Процедура ОткрытьПоСсылке(Форма, Данные) Экспорт
	
	СтрокаНабора = НайтиНабор(НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма), Данные.Набор);
	Если Не СтрокаНабора = Неопределено Тогда
		ПерейтиПоСсылке(Форма, СтрокаНабора, Данные);
	Иначе
		Открыли = Ждать ОткрытьИзПапок(Форма, Данные);
		Если Не Открыли Тогда
			ПоказатьПредупреждение( , НСтр("ru = 'Набора из ссылки нет в форме Ei, в папке открытого набора и в папках последних наборов.'"));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Строка дерева наборов по префиксу ключа из ссылки, на любом уровне
//
// Параметры:
//  Строки 			- ДанныеФормыКоллекцияЭлементовДерева
//  ПрефиксНабора 	- Строка - Набор из данных ссылки, см. НавигационныеСсылкиКлиентСервер_Ei.ДанныеСсылки
//
// Возвращаемое значение:
//  ДанныеФормыЭлементДерева, Неопределено - Неопределено, если набора нет
//
Функция НайтиНабор(Строки, ПрефиксНабора) Экспорт
	
	Результат = Неопределено;
	Для Каждого СтрокаНабора Из Строки Цикл
		Если НавигационныеСсылкиКлиентСервер_Ei.ЭтоНаборСсылки(СтрокаНабора.КлючНастроек, ПрефиксНабора) Тогда
			Результат = СтрокаНабора;
		Иначе
			Результат = НайтиНабор(СтрокаНабора.ПолучитьЭлементы(), ПрефиксНабора);
		КонецЕсли;
		Если Не Результат = Неопределено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Найти обработку с набором в папке открытого набора и в папках последних наборов и открыть ее.
// Обработка находится по uuid строки в .mdo: элементы строки в файлах набора начинаются с первых 24 символов ее ключа
//
// Параметры:
//  Форма 	- см. Обработка.Ei.Форма.Форма
//  Данные 	- см. НавигационныеСсылкиКлиентСервер_Ei.ДанныеСсылки
//
// Возвращаемое значение:
//  Булево - обработка с набором найдена
//
Асинх Функция ОткрытьИзПапок(Форма, Данные)
	
	Найдена 		= Ложь;
	ПрефиксВФайле 	= НавигационныеСсылкиКлиентСервер_Ei.НачалоИдентификатораВФайлах(Данные.Набор);
	Для Каждого Каталог Из КаталогиПоиска(Форма) Цикл
		Обработки = Ждать ФайлыКлиент_Ei.ОбработкиПроекта(Каталог);
		Для Каждого КлючИЗначение Из Обработки Цикл
			Если СтрНайти(НРег(ФайлыКлиент_Ei.ПрочитатьТекст(КлючИЗначение.Значение.Файл)), ПрефиксВФайле) > 0 Тогда
				Найдена = Истина;
				Ждать ОткрытьИзОбработки(Форма, Каталог, КлючИЗначение.Значение.Имя, Данные);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Найдена Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Найдена;
	
КонецФункции

// Папки, где искать набор: папка открытого набора, затем папки последних наборов
//
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция КаталогиПоиска(Форма)
	
	Результат 	= Новый Массив;
	Добавленные = Новый Соответствие;
	Каталоги 	= Новый Массив;
	Каталоги.Добавить(Форма.ИмяФайлаНастройки);
	Для Каждого Последний Из НастройкиПользователяКлиентСервер_Ei.ПолучитьПоследниеНаборы(Форма.НастройкиПользователя) Цикл
		Каталоги.Добавить(Последний.Каталог);
	КонецЦикла;
	Для Каждого Каталог Из Каталоги Цикл
		Если ЗначениеЗаполнено(Каталог) И Добавленные.Получить(НРег(Каталог)) = Неопределено Тогда
			Добавленные.Вставить(НРег(Каталог), Истина);
			Результат.Добавить(Каталог);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Прочитать обработку набора, проверить набор и загрузить в форму.
//
// Параметры:
//  Форма 			- см. Обработка.Ei.Форма.Форма
//  Каталог 		- Строка - папка проекта EDT
//  ИмяОбработки 	- Строка
//  Данные 			- см. НавигационныеСсылкиКлиентСервер_Ei.ДанныеСсылки
//
// Возвращаемое значение:
//  Булево - набор загружен
//
Асинх Функция ОткрытьИзОбработки(Форма, Каталог, ИмяОбработки, Данные)
	
	Загружен 		= Ложь;
	СсылкиНаФайлы 	= Новый Структура;
	Набор 			= Ждать EDTКлиент_Ei.ПрочитатьСоставОбработки(Каталог, ИмяОбработки, СсылкиНаФайлы);
	Если Не ЕстьНабор(Набор, Данные.Набор) Тогда
		ПоказатьПредупреждение( , СтрШаблон(НСтр("ru = 'В сохраненной обработке %1 (%2) нет набора из ссылки.'"),
			ИмяОбработки, Каталог));
	Иначе
		ЗафиксироватьИзменения(Форма);
		Определились = Истина;
		Если Форма.Модифицированность Тогда
			Определились = Ждать ФайлыКлиент_Ei.Сохранить(Форма, Истина);
		КонецЕсли;
		Если Определились Тогда
			ФайлыКлиент_Ei.ЗагрузитьПрочитанныйНабор(Форма, Набор, Каталог, ИмяОбработки, СсылкиНаФайлы);
			Загружен 		= Истина;
			СтрокаНабора 	= НайтиНабор(НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма), Данные.Набор);
			Если Не СтрокаНабора = Неопределено Тогда
				ПерейтиПоСсылке(Форма, СтрокаНабора, Данные);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Загружен;
	
КонецФункции

// Передать в строку набора правки текущего варианта и пересчитать модифицированность формы.
// Правку редактора вариант забирает в строку только при ПриИзменении поля: кнопка «Открыть» до него доходит
// (поле теряет фокус), а щелчок по ссылке в комментарии или переход по ссылке из другого окна - нет,
// и без этого форма считала себя несохраненной без изменений: набор из ссылки загружался без вопроса,
// и правки терялись
//
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
//
Процедура ЗафиксироватьИзменения(Форма)
	
	СтрокаНабора = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не СтрокаНабора = Неопределено Тогда
		Вариант = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма, СтрокаНабора);
		Если Не Вариант = Неопределено Тогда
			Попытка
				Вариант.ЗапомнитьДанные(Форма, СтрокаНабора);
			Исключение
				// редактор варианта недоступен: в строке остаются уже переданные правки
				Вариант = Неопределено;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
	
КонецПроцедуры

// Есть ли набор в составе обработки, прочитанном с диска
//
// Параметры:
//  Набор 			- см. EDTКлиент_Ei.ПрочитатьСоставОбработки
//  ПрефиксНабора 	- Строка - Набор из данных ссылки
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьНабор(Набор, ПрефиксНабора)
	
	Результат = Ложь;
	Если ТипЗнч(Набор) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из Набор Цикл
			Если НавигационныеСсылкиКлиентСервер_Ei.ЭтоНаборСсылки(КлючИЗначение.Значение.КлючНастроек, ПрефиксНабора) Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Параметр строки набора по ключу
//
// Параметры:
//  СтрокаНабора 	- ДанныеФормыЭлементДерева
//  КлючПараметра 	- Строка - Параметр из данных ссылки
//
// Возвращаемое значение:
//  ДанныеФормыЭлементКоллекции, Неопределено - Неопределено, если параметра нет
//
Функция НайтиПараметр(СтрокаНабора, КлючПараметра)
	
	Результат = Неопределено;
	Для Каждого Параметр Из СтрокаНабора.ПараметрыЗапроса Цикл
		Если НРег(СокрЛП(Строка(Параметр.Ключ))) = КлючПараметра Тогда
			Результат = Параметр;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Сделать набор текущим в дереве наборов, открыть закладку варианта или параметр из ссылки.
// Сохраненная закладка строки подменяется до показа строки: ее показывает НаборВариантовКлиент_Ei.ВосстановитьВариант.
// ВосстановитьВариант вызывается сразу, потому что активизация уже текущей строки ничего не делает
//
// Параметры:
//  Форма 			- см. Обработка.Ei.Форма.Форма
//  СтрокаНабора 	- ДанныеФормыЭлементДерева
//  Данные 			- см. НавигационныеСсылкиКлиентСервер_Ei.ДанныеСсылки
//
Процедура ПерейтиПоСсылке(Форма, СтрокаНабора, Данные)
	
	ИмяВарианта = НавигационныеСсылкиКлиентСервер_Ei.ИмяВариантаПоКоду(Данные.Вариант);
	Если ЗначениеЗаполнено(ИмяВарианта) Тогда
		ВариантыКлиент_Ei.СохранитьТекущийОбработчик(Форма, СтрокаНабора, ИмяВарианта);
	КонецЕсли;
	ЭлементДерева = Форма.Элементы.Найти(КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента());
	Если Не ЭлементДерева = Неопределено Тогда
		Родитель = СтрокаНабора.ПолучитьРодителя();
		Пока Не Родитель = Неопределено Цикл
			ЭлементДерева.Развернуть(Родитель.ПолучитьИдентификатор());
			Родитель = Родитель.ПолучитьРодителя();
		КонецЦикла;
		ЭлементДерева.ТекущаяСтрока = СтрокаНабора.ПолучитьИдентификатор();
	КонецЕсли;
	НаборВариантовКлиент_Ei.ВосстановитьВариант(Форма, СтрокаНабора);
	Форма.Активизировать();
	
	Параметр = ?(ЗначениеЗаполнено(Данные.Параметр), НайтиПараметр(СтрокаНабора, Данные.Параметр), Неопределено);
	Если Не Параметр = Неопределено Тогда
		АктивизироватьПараметр(Форма, Параметр);
	КонецЕсли;
	
КонецПроцедуры

// Показать таблицу параметров и сделать параметр текущим
//
// Параметры:
//  Форма 		- см. Обработка.Ei.Форма.Форма
//  Параметр 	- ДанныеФормыЭлементКоллекции - строка ПараметрыЗапроса текущей строки набора
//
Процедура АктивизироватьПараметр(Форма, Параметр)
	
	ТаблицаПараметров = ПараметрыКлиент_Ei.КоллекцияПараметров(Форма);
	Если ТаблицаПараметров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ТаблицаПараметров.Видимость Тогда
		КонструкторКлиент_Ei.ИзменитьВидимостьТаблицыПараметры(Форма);
	КонецЕсли;
	Страницы = Форма.Элементы.Найти("СтраницыПараметры");
	Страница = Форма.Элементы.Найти("СтраницаПараметры");
	Если Не Страницы = Неопределено И Не Страница = Неопределено Тогда
		Страницы.ТекущаяСтраница = Страница;
	КонецЕсли;
	ТаблицаПараметров.ТекущаяСтрока = Параметр.ПолучитьИдентификатор();
	Форма.ТекущийЭлемент 			= ТаблицаПараметров;
	
КонецПроцедуры

#КонецОбласти

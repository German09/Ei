Функция ПолучитьДанныеНабора(ИмяНабора = Неопределено) Экспорт
	Перем Результат;
	ИмяНабора = ?(ИмяНабора = Неопределено,НаборВариантовВызовСервера_Ei.ПолучитьТекущийНабор(),ИмяНабора);
	Если ЗначениеЗаполнено(ИмяНабора) Тогда
		НаборВариантовВызовСервера_Ei.Получить().Свойство(ИмяНабора,Результат);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура ДобавитьКолонкиВаринта(Форма, Обработчик) Экспорт
	Имя = Обработчик.Свойства().Имя;
	Эл_Группы = Форма.Элементы.Найти("ВариантыИмяГруппа");
	Если Эл_Группы = Неопределено Тогда
		//единой нет, добавим для каждого варианта свою
		Эл_Группы = Форма.Элементы.Добавить(Имя+"_Группа", Тип("ГруппаФормы"), Форма.Элементы[КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента()]);
		Эл_Группы.Вид = ВидГруппыФормы.ГруппаКолонок;
		Эл_Группы.Группировка = ГруппировкаКолонок.ВЯчейке;
	КонецЕсли;	
	//Добавим картинку
	Окончание		= "_Картинка";
	Эл 		= Форма.Элементы.Добавить(Имя+Окончание, Тип("ПолеФормы"),Эл_Группы);
	Эл.Вид 	= ВидПоляФормы.ПолеКартинки;	
	Эл.ПутьКДанным = КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента()+"."+Имя+Окончание;
	
	//Добавим текст
	Окончание		= "_Текст";
	Эл 			= Форма.Элементы.Добавить(Имя+Окончание, Тип("ПолеФормы"),Эл_Группы);
	Эл.Вид 		= ВидПоляФормы.ПолеНадписи;	
	Эл.Ширина	= 2; 
	Эл.ПутьКДанным = КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента()+"."+Имя+Окончание;
	Эл.Видимость= Ложь; //Скорем а то не очень наглядно
КонецПроцедуры

// Получить имя набора, имя варианта основного родителя
// 
// Параметры:
//  СтрВариантов см. ВариантыКлиент_Ei.Получить
// 
// Возвращаемое значение:
// 	Строка 
Функция ПолучитьИмяНабора(СтрВариантов) Экспорт
	Для Каждого СтрНабор ИЗ СтрВариантов Цикл
		Набор 		= СтрНабор.Значение;
		Если Набор.Родитель =  Неопределено Тогда		
			Возврат СтрНабор.Ключ;		
		КонецЕсли;
	КонецЦикла;	
КонецФункции			
Функция ПолучитьДанныеНабора(ИмяНабора = Неопределено) Экспорт
	Перем Результат;
	ИмяНабора = ?(ИмяНабора = Неопределено,НаборВариантовВызовСервера_Ei.ПолучитьТекущийНабор(),ИмяНабора);
	Если ЗначениеЗаполнено(ИмяНабора) Тогда
		НаборВариантовВызовСервера_Ei.Получить().Свойство(ИмяНабора,Результат);
	КонецЕсли;
	Возврат Результат;
КонецФункции	
#Область ПрограммныйИнтерфейс
Функция ПолучитьДанныеНабора(ИмяНабора = Неопределено) Экспорт
	Перем Результат;
	ИмяНабора = ?(ИмяНабора = Неопределено,НаборВариантовВызовСервера_Ei.ПолучитьТекущийНабор(),ИмяНабора);
	Если ЗначениеЗаполнено(ИмяНабора) Тогда
		НаборВариантовВызовСервера_Ei.Получить().Свойство(ИмяНабора,Результат);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Добавляет в дерево наборов значки вариантов строки: заполненные варианты - символами,
// см. ВариантыКлиент_Ei.СимволыВариантов
// Значки стоят в одной ячейке с именем строки, подсказка поля расшифровывает символы.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//
Процедура ДобавитьКолонкуСимволов(Форма) Экспорт
	ИмяДерева 	= КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента();
	Родитель 	= Форма.Элементы[ИмяДерева];
	ПолеИмени 	= Форма.Элементы.Найти(ИмяДерева+"Запрос"); //колонка ИмяНабора
	Если Не ПолеИмени = Неопределено Тогда
		Родитель = Форма.Элементы.Вставить(ИмяДерева+"ИмяИВарианты", Тип("ГруппаФормы"), Форма.Элементы[ИмяДерева], ПолеИмени);
		Родитель.Вид 				= ВидГруппыФормы.ГруппаКолонок;
		Родитель.Группировка 		= ГруппировкаКолонок.ВЯчейке;
		Родитель.ФиксацияВТаблице 	= ФиксацияВТаблице.Нет; //закрепленная колонка не растягивается на ширину дерева
		Форма.Элементы.Переместить(ПолеИмени, Родитель);
		ПолеИмени.ФиксацияВТаблице 	= ФиксацияВТаблице.Нет;
	КонецЕсли;
	Эл 			= Форма.Элементы.Добавить(ИмяДерева+ИмяКолонкиСимволов(), Тип("ПолеФормы"), Родитель);
	Эл.Вид 		= ВидПоляФормы.ПолеНадписи;
	Эл.ПутьКДанным	= ИмяДерева+"."+ИмяКолонкиСимволов();
	Эл.Ширина 	= 10; //с временем фонового выполнения за песочными часами, см. ФоновоеВыполнениеКлиент_Ei.ОтметкаВарианта
	Эл.РастягиватьПоГоризонтали = Ложь;
	
	Расшифровка = Новый Массив; // Массив из Строка
	Для Каждого Обработчик ИЗ ВариантыКлиентСерверПовтИсп_Ei.ПолучитьМассивВариантов() Цикл
		Если ТипЗнч(Обработчик) = Тип("ОбщийМодуль") Тогда
			Свойства = Обработчик.Свойства();
			Значок = "";
			Если Свойства.Свойство("Символ", Значок) Тогда
				Расшифровка.Добавить(СтрШаблон("%1 %2", Значок, НРег(Свойства.Синоним)));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Расшифровка.Добавить(НСтр("ru = 'в скобках за символом - размер результата варианта'"));
	Расшифровка.Добавить(НСтр("ru = '⏳ выполняется в фоне (за часами - сколько идет), ✓ готов результат из фона, ✗ ошибка в фоне'"));
	Эл.Подсказка = СтрСоединить(Расшифровка, ", ");
КонецПроцедуры

// Имя колонки дерева наборов со значками вариантов строки, см. ДобавитьКолонкуСимволов
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяКолонкиСимволов() Экспорт
	Возврат "СимволыВариантов";
КонецФункции

// Имя реквизита формы с заголовком закладки варианта или результата: закладка берет его через ПутьКДаннымЗаголовка.
// Смена свойства Заголовок перестраивает форму и сбрасывает размеры областей, заданные пользователем.
//
// Параметры:
//  ИмяЗакладки - Строка - имя варианта или результата
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяРеквизитаЗаголовка(ИмяЗакладки) Экспорт
	Возврат "ЗаголовокЗакладки_"+ИмяЗакладки;
КонецФункции

// Получить имя набора, имя варианта основного родителя
// 
// Параметры:
//  СтрВариантов см. ВариантыКлиент_Ei.Получить
// 
// Возвращаемое значение:
// 	Строка 
Функция ПолучитьИмяНабора(СтрВариантов) Экспорт
	Для Каждого СтрНабор ИЗ СтрВариантов Цикл
		Набор 		= СтрНабор.Значение;
		Если Набор.Родитель =  Неопределено Тогда		
			Возврат СтрНабор.Ключ;		
		КонецЕсли;
	КонецЦикла;	
КонецФункции

#КонецОбласти
				

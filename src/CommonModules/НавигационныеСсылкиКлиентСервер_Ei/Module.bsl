// Ссылки на набор, вариант и параметр Ei: e1cib/command/ОбщаяКоманда.Ei?extdata=<ключ>&ei=<идентификатор>.
// Идентификатор Ei составляет сам - uuid варианта, как в файлах набора EDT: первые 24 символа строкового вида
// ключа строки (КлючНастроек, с дефисами - это 20 шестнадцатеричных цифр) и 12 цифр кода вида варианта
// (Код из Свойства()), см. ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор и ВариантыКлиент_Ei.ПрочитатьОбъект.
// Так же устроен uuid параметра строки: начало ключа строки и ключ параметра (Ключ строки параметров,
// ПараметрыКлиентСервер_Ei.ПолучитьНовыйКлюч), поэтому ссылка бывает и на параметр. Ссылка на строку без варианта
// и параметра - начало ключа строки и 12 нулей.
// Ссылку, по которой переходит платформа, строит сервер (НавигационныеСсылкиВызовСервера_Ei.Ссылка): идентификатор
// кладется в хранилище внешних данных ссылок, и команда Ei получает его в ПараметрыВыполненияКоманды.Параметры;
// свой extdata, которого нет в хранилище, платформа отбрасывает (проверено 2026-11-11). Параметр ei повторяет
// идентификатор: по нему ссылку разбирают без базы (ДанныеСсылки), а форма Ei открывает щелчок в комментарии сама.
// Открытие по ссылке - НавигационныеСсылкиКлиент_Ei, чтение строки по ссылке агентом MCP - get_variants с nav_link.

#Область ПрограммныйИнтерфейс

// Идентификатор ссылки на строку набора, ее вариант или параметр
//
// Параметры:
//  КлючНабора 		- УникальныйИдентификатор, Строка - КлючНастроек строки дерева наборов
//  КодВарианта 	- Строка - Код из Свойства() вида варианта, пустой - без варианта
//  КлючПараметра 	- Строка - Ключ параметра строки; заполненный - ссылка на параметр, КодВарианта не учитывается
//
// Возвращаемое значение:
//  Строка - uuid с дефисами в нижнем регистре
//
Функция Идентификатор(КлючНабора, КодВарианта, КлючПараметра = "") Экспорт
	
	Если ЗначениеЗаполнено(КлючПараметра) Тогда
		Окончание = НРег(КлючПараметра);
	ИначеЕсли ЗначениеЗаполнено(КодВарианта) Тогда
		Окончание = НРег(КодВарианта);
	Иначе
		Окончание = ОкончаниеСтроки();
	КонецЕсли;
	
	Возврат ВидУникальногоИдентификатора(ПрефиксНабора(КлючНабора) + Окончание);
	
КонецФункции

// Имя параметра ссылки и свойства внешних данных ссылки с идентификатором
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПараметраИдентификатора() Экспорт
	Возврат "ei";
КонецФункции

// Данные ссылки на набор, вариант или параметр
//
// Параметры:
//  НавигационнаяСсылка - Строка - ссылка на общую команду Ei с ei=<идентификатор>, можно и адрес из браузера;
//                        ссылки 3.2.5.2-3.2.6.2 с идентификатором в extdata тоже разбираются
//
// Возвращаемое значение:
//  - см. ДанныеИдентификатора
//  - Неопределено - это не ссылка на набор Ei
//
Функция ДанныеСсылки(НавигационнаяСсылка) Экспорт
	
	Результат 	= Неопределено;
	Ссылка 		= НРег(Строка(НавигационнаяСсылка));
	// ОбщаяКоманда.Ei или CommonCommand.Ei; в адресе из браузера кириллица закодирована, поэтому - по окончанию имени
	Если СтрНайти(Ссылка, ".ei?") > 0 Тогда
		Значение = ЗначениеПараметраСсылки(Ссылка, ИмяПараметраИдентификатора());
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Значение = ЗначениеПараметраСсылки(Ссылка, "extdata");
		КонецЕсли;
		Результат = ДанныеИдентификатора(Значение);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Данные идентификатора ссылки
//
// Параметры:
//  Идентификатор - Строка - см. Идентификатор
//
// Возвращаемое значение:
//  - Структура:
//   * Набор 		- Строка - первые 20 шестнадцатеричных цифр ключа строки в нижнем регистре, см. ПрефиксНабора
//   * Вариант 		- Строка - Код вида варианта, пустой - ссылка не на вариант
//   * Параметр 	- Строка - ключ параметра строки, пустой - ссылка не на параметр
//  - Неопределено - это не идентификатор
//
Функция ДанныеИдентификатора(Идентификатор) Экспорт
	
	Результат 	= Неопределено;
	Цифры 		= Шестнадцатеричный(Идентификатор);
	Если ЭтоШестнадцатеричный(Цифры, 32) Тогда
		Окончание 	= Прав(Цифры, 12);
		Результат 	= Новый Структура("Набор, Вариант, Параметр", ПрефиксНабора(Цифры), "", "");
		Если ЗначениеЗаполнено(ИмяВариантаПоКоду(Окончание)) Тогда
			Результат.Вариант = Окончание;
		ИначеЕсли Окончание <> ОкончаниеСтроки() Тогда
			Результат.Параметр = Окончание;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Имя вида варианта по его коду
//
// Параметры:
//  КодВарианта - Строка - Код из Свойства() вида варианта
//
// Возвращаемое значение:
//  Строка - пустая, если вида с таким кодом нет
//
Функция ИмяВариантаПоКоду(КодВарианта) Экспорт
	
	Результат = "";
	Если ЗначениеЗаполнено(КодВарианта) Тогда
		Для Каждого КлючИЗначение Из ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
			Если НРег(КлючИЗначение.Значение.Свойства().Код) = НРег(КодВарианта) Тогда
				Результат = КлючИЗначение.Ключ;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Начинается ли ключ строки с префикса набора из ссылки
//
// Параметры:
//  КлючНабора 		- УникальныйИдентификатор, Строка - КлючНастроек строки дерева наборов
//  ПрефиксНабора 	- Строка - Набор из данных ссылки, см. ДанныеСсылки
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоНаборСсылки(КлючНабора, ПрефиксНабора) Экспорт
	Возврат ПрефиксНабора(КлючНабора) = ПрефиксНабора;
КонецФункции

// Начало uuid элементов строки в файлах набора EDT: по нему в .mdo находится обработка с набором
//
// Параметры:
//  ПрефиксНабора - Строка - Набор из данных ссылки, см. ДанныеСсылки
//
// Возвращаемое значение:
//  Строка - первые 24 символа uuid с дефисами, в нижнем регистре
//
Функция НачалоИдентификатораВФайлах(ПрефиксНабора) Экспорт
	Возврат Лев(ВидУникальногоИдентификатора(ПрефиксНабора + ОкончаниеСтроки()), 24);
КонецФункции

// Длина префикса набора в шестнадцатеричных цифрах: первые 24 символа строкового вида uuid с дефисами
//
// Возвращаемое значение:
//  Число
//
Функция ДлинаПрефиксаНабора() Экспорт
	Возврат 20;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Префикс набора: общее начало ключа строки и uuid ее элементов в файлах набора - первые 24 символа
// строкового вида с дефисами, см. ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор
//
// Параметры:
//  Значение - УникальныйИдентификатор, Строка - ключ строки или идентификатор ссылки
//
// Возвращаемое значение:
//  Строка - 20 шестнадцатеричных цифр в нижнем регистре
//
Функция ПрефиксНабора(Значение)
	Возврат Лев(Шестнадцатеричный(Значение), ДлинаПрефиксаНабора());
КонецФункции

// Значение параметра навигационной ссылки (после ? или &)
//
// Параметры:
//  Ссылка 		- Строка - ссылка в нижнем регистре
//  ИмяПараметра 	- Строка - имя в нижнем регистре
//
// Возвращаемое значение:
//  Строка - пустая, если параметра нет
//
Функция ЗначениеПараметраСсылки(Ссылка, ИмяПараметра)
	
	Результат = "";
	Для Каждого Начало Из СтрРазделить("?,&", ",") Цикл
		Признак = Начало + ИмяПараметра + "=";
		Позиция = СтрНайти(Ссылка, Признак);
		Если Позиция > 0 Тогда
			Результат = Сред(Ссылка, Позиция + СтрДлина(Признак));
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Разделитель Из СтрРазделить("&,#", ",") Цикл
		КонецЗначения = СтрНайти(Результат, Разделитель);
		Если КонецЗначения > 0 Тогда
			Результат = Лев(Результат, КонецЗначения - 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Окончание идентификатора ссылки на строку без варианта и параметра
//
// Возвращаемое значение:
//  Строка
//
Функция ОкончаниеСтроки()
	Возврат "000000000000";
КонецФункции

// Шестнадцатеричные цифры уникального идентификатора без дефисов, в нижнем регистре
//
// Параметры:
//  Значение - УникальныйИдентификатор, Строка - идентификатор
//
// Возвращаемое значение:
//  Строка
//
Функция Шестнадцатеричный(Значение)
	Возврат НРег(СтрЗаменить(СокрЛП(Строка(Значение)), "-", ""));
КонецФункции

// Строка из шестнадцатеричных цифр заданной длины
//
// Параметры:
//  Цифры 	- Строка
//  Длина 	- Число
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоШестнадцатеричный(Цифры, Длина)
	
	Результат = СтрДлина(Цифры) = Длина;
	Если Результат Тогда
		Для Номер = 1 По Длина Цикл
			Если СтрНайти("0123456789abcdef", Сред(Цифры, Номер, 1)) = 0 Тогда
				Результат = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Уникальный идентификатор строкой с дефисами из 32 шестнадцатеричных цифр
//
// Параметры:
//  Цифры - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ВидУникальногоИдентификатора(Цифры)
	Возврат СтрШаблон("%1-%2-%3-%4-%5", Сред(Цифры, 1, 8), Сред(Цифры, 9, 4), Сред(Цифры, 13, 4), Сред(Цифры, 17, 4), Сред(Цифры, 21, 12));
КонецФункции

#КонецОбласти

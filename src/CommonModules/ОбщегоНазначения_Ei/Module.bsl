// Хеш строки.
// 
// Параметры:
//  Строка - Строка - Строка
// 
// Возвращаемое значение:
//  Строка - Хеш строки
Функция ХешСтроки(Строка) Экспорт	
	ХешированиеДанных = Новый ХешированиеДанных(ХешФункция.MD5);
	ХешированиеДанных.Добавить(Строка);
	Возврат СтрЗаменить(ХешированиеДанных.ХешСумма, " ", "");			
КонецФункции

// Получить набор по ключу.
// 
// Параметры:
//  КлючЗаписи - РегистрСведенийКлючЗаписиИмяРегистраСведений, Строка - 
// 
// Возвращаемое значение:
// 	Неопределено, РегистрСведенийНаборЗаписейИмяРегистраСведений - 
Функция ПолучитьНаборПоКлючу(Знач КлючЗаписи) Экспорт
	Если ТипЗнч(КлючЗаписи) = Тип("Строка") Тогда
		//передали навигационную ссылку
		КлючЗаписи = ОбщегоНазначенияПовтИсп_Ei.ПолучитьСсылкуИзНавСсылки(КлючЗаписи); 	
	КонецЕсли;
	Признак 	= "КлючЗаписи";
	ОписаниеМД 	= ОбщегоНазначенияКлиентСервер_Ei.ПолучитьОписаниеМетаданных(ТипЗнч(КлючЗаписи));
	Если СтрЗаканчиваетсяНа(ОписаниеМД.Тип,Признак) Тогда
		МенеджерТипа = ВыполнитьКлиентСервер_Ei.ВычислитьБезопасно(СтрЗаменить(ОписаниеМД.Тип,Признак,""));
		Если Не МенеджерТипа = Неопределено Тогда
			Набор  = МенеджерТипа[ОписаниеМД.ПолноеИмя].СоздатьНаборЗаписей();
			Для Каждого Элемент ИЗ ОбщегоНазначенияКлиентСервер_Ei.ПолучитьСвойстваОбъектаМетаданных(КлючЗаписи) Цикл
				Набор.Отбор[Элемент.Представление].Установить(Элемент.Значение);
			КонецЦикла;
			Набор.Прочитать();
			Если Набор.Выбран() Тогда
				Возврат Набор;
			КонецЕсли;		
		КонецЕсли;				
	КонецЕсли;				
КонецФункции


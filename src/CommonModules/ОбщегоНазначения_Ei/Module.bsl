// Имя типа ссылки для Тип(), ОписаниеТипов и комментариев EDT.
//
// Параметры:
//  ТипЗначения - Тип
//
// Возвращаемое значение:
//  Строка - имя типа XDTO или пустая строка для нессылочного типа
//
Функция ИмяСсылочногоТипа(ТипЗначения) Экспорт
	ТипXML = XMLТип(ТипЗначения);
	Возврат ?(ТипXML <> Неопределено И СтрНайти(ТипXML.ИмяТипа, "Ref.") > 0, ТипXML.ИмяТипа, "");
КонецФункции

// Хеш строки.
// 
// Параметры:
//  Строка - Строка - Строка
// 
// Возвращаемое значение:
//  Строка - Хеш строки
Функция ХешСтроки(Строка) Экспорт	
	ХешированиеДанных = Новый ХешированиеДанных(ХешФункция.MD5);
	ХешированиеДанных.Добавить(Строка);
	Возврат СтрЗаменить(ХешированиеДанных.ХешСумма, " ", "");			
КонецФункции

// Получить набор по ключу.
// 
// Параметры:
//  КлючЗаписи - РегистрСведенийКлючЗаписиИмяРегистраСведений, Строка - 
// 
// Возвращаемое значение:
// 	Неопределено, РегистрСведенийНаборЗаписейИмяРегистраСведений - 
Функция ПолучитьНаборПоКлючу(Знач КлючЗаписи) Экспорт
	Если ТипЗнч(КлючЗаписи) = Тип("Строка") Тогда
		//передали навигационную ссылку
		КлючЗаписи = ОбщегоНазначенияПовтИсп_Ei.ПолучитьСсылкуИзНавСсылки(КлючЗаписи); 	
	КонецЕсли;
	Признак 	= "КлючЗаписи";
	ОписаниеМД 	= ОбщегоНазначенияКлиентСервер_Ei.ПолучитьОписаниеМетаданных(ТипЗнч(КлючЗаписи));
	Если СтрЗаканчиваетсяНа(ОписаниеМД.Тип,Признак) Тогда
		МенеджерТипа = ВыполнитьКлиентСервер_Ei.ВычислитьБезопасно(СтрЗаменить(ОписаниеМД.Тип,Признак,""));
		Если Не МенеджерТипа = Неопределено Тогда
			Набор  = МенеджерТипа[ОписаниеМД.ПолноеИмя].СоздатьНаборЗаписей();
			Для Каждого Элемент ИЗ ОбщегоНазначенияКлиентСервер_Ei.ПолучитьСвойстваОбъектаМетаданных(КлючЗаписи) Цикл
				Набор.Отбор[Элемент.Представление].Установить(Элемент.Значение);
			КонецЦикла;
			Набор.Прочитать();
			Если Набор.Выбран() Тогда
				Возврат Набор;
			КонецЕсли;		
		КонецЕсли;
	КонецЕсли;
КонецФункции

// Значение по навигационной ссылке на данные: ссылка, ключ записи регистра сведений или ссылка таблицы внешнего источника данных.
// Подходит и адрес из браузера (http://.../#e1cib/data/...): имя объекта и значения параметров раскодируются из кодировки URL,
// имена метаданных - на русском или английском.
//
// Параметры:
//  НавСсылка - Строка - e1cib/data/Справочник.Имя?ref=<32 шестнадцатеричные цифры>,
//                       e1cib/data/РегистрСведений.Имя?Период=20251017060000&Измерение=<значение>,
//                       e1cib/data/ВнешнийИсточникДанных.Имя.Таблица.ИмяТаблицы?ref=<значение ключа>
//
// Возвращаемое значение:
//  ЛюбаяСсылка, РегистрСведенийКлючЗаписи - если ссылку разобрать нельзя, вызывается исключение с причиной
//
Функция ЗначениеПоНавСсылке(Знач НавСсылка) Экспорт

	Признак = "";
	НачалоДанных = ОбщегоНазначенияКлиентСервер_Ei.ЭтоНавСсылкаНаСсылку(НавСсылка, Признак);
	Если НачалоДанных = 0 Тогда
		ВызватьИсключение "Ожидается навигационная ссылка на данные вида e1cib/data/...";
	КонецЕсли;

	НавСсылка = СокрЛП(Сред(НавСсылка, НачалоДанных + СтрДлина(Признак)));
	НачалоПараметров = СтрНайти(НавСсылка, "?");
	Если НачалоПараметров = 0 Тогда
		ВызватьИсключение "В навигационной ссылке нет параметров: ожидается ?ref=... или ?Измерение=...";
	КонецЕсли;

	ИмяОбъекта = РаскодироватьСтроку(Лев(НавСсылка, НачалоПараметров - 1), СпособКодированияСтроки.КодировкаURL);
	ПараметрыСсылки = ПараметрыНавСсылки(Сред(НавСсылка, НачалоПараметров + 1));

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение СтрШаблон("В конфигурации нет объекта %1", ИмяОбъекта);
	КонецЕсли;

	Если Метаданные.РегистрыСведений.Содержит(ОбъектМетаданных) Тогда
		Возврат КлючЗаписиПоНавСсылке(ОбъектМетаданных, ПараметрыСсылки);
	КонецЕсли;

	Идентификатор = ПараметрыСсылки.Получить("ref");
	Если Идентификатор = Неопределено Тогда
		ВызватьИсключение СтрШаблон("В навигационной ссылке на %1 нет параметра ref", ОбъектМетаданных.ПолноеИмя());
	КонецЕсли;

	Если СтрРазделить(ОбъектМетаданных.ПолноеИмя(), ".").Количество() = 4 Тогда
		// ВнешнийИсточникДанных.Имя.Таблица.ИмяТаблицы: ref - значение ключа таблицы, а не идентификатор
		МенеджерИсточника = ВнешниеИсточникиДанных[ОбъектМетаданных.Родитель().Имя];
		Возврат МенеджерИсточника.Таблицы[ОбъектМетаданных.Имя].ПолучитьСсылку(Идентификатор);
	КонецЕсли;

	Попытка
		ПустаяСсылка = ПредопределенноеЗначение(ОбъектМетаданных.ПолноеИмя() + ".ПустаяСсылка");
	Исключение
		ВызватьИсключение СтрШаблон("%1 - не ссылочный объект и не регистр сведений", ОбъектМетаданных.ПолноеИмя());
	КонецПопытки;

	Возврат СсылкаПоИдентификаторуНавСсылки(ПустаяСсылка, Идентификатор);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры навигационной ссылки после ?, раскодированные из кодировки URL:
// платформа кодирует строковые значения измерений, & и = внутри значения приходят как %26 и %3D.
//
// Параметры:
//  СтрокаПараметров - Строка - Имя1=Значение1&Имя2=Значение2
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - имя параметра
//   * Значение - Строка - значение параметра
//
Функция ПараметрыНавСсылки(СтрокаПараметров)

	Результат = Новый Соответствие;
	Для Каждого ИмяИЗначение Из СтрРазделить(СтрокаПараметров, "&", Ложь) Цикл
		ПозицияРавно = СтрНайти(ИмяИЗначение, "=");
		Если ПозицияРавно = 0 Тогда
			Продолжить;
		КонецЕсли;
		Имя			= РаскодироватьСтроку(Лев(ИмяИЗначение, ПозицияРавно - 1), СпособКодированияСтроки.КодировкаURL);
		Значение	= РаскодироватьСтроку(Сред(ИмяИЗначение, ПозицияРавно + 1), СпособКодированияСтроки.КодировкаURL);
		Результат.Вставить(Имя, Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ключ записи регистра сведений по параметрам навигационной ссылки,
// в том виде, как их пишет ПолучитьНавигационнуюСсылку, см. ОбщегоНазначенияКлиентСервер_Ei.ПолучитьНавСсылкуНаЗаписьРС
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданныхРегистрСведений
//  ПараметрыСсылки - см. ПараметрыНавСсылки
//
// Возвращаемое значение:
//  РегистрСведенийКлючЗаписи
//
Функция КлючЗаписиПоНавСсылке(ОбъектМетаданных, ПараметрыСсылки)

	ЗначенияКлюча = Новый Структура;
	Для Каждого ПараметрСсылки Из ПараметрыСсылки Цикл
		Измерение = ОбъектМетаданных.Измерения.Найти(ПараметрСсылки.Ключ);
		Если Измерение <> Неопределено Тогда
			ТипПоля = Измерение.Тип;
		ИначеЕсли ПараметрСсылки.Ключ = "Период" Тогда
			ТипПоля = Новый ОписаниеТипов("Дата");
		Иначе
			ВызватьИсключение СтрШаблон("У регистра %1 нет измерения %2", ОбъектМетаданных.ПолноеИмя(), ПараметрСсылки.Ключ);
		КонецЕсли;
		ЗначенияКлюча.Вставить(ПараметрСсылки.Ключ, ЗначениеПоляНавСсылки(ТипПоля, ПараметрСсылки.Значение, ПараметрСсылки.Ключ));
	КонецЦикла;

	Возврат РегистрыСведений[ОбъектМетаданных.Имя].СоздатьКлючЗаписи(ЗначенияКлюча);

КонецФункции

// Значение измерения или периода из навигационной ссылки на запись регистра:
// дата - ГГГГММДДччммсс, булево - 1 или 0, ссылка - 32 шестнадцатеричные цифры.
//
// Параметры:
//  ТипПоля - ОписаниеТипов
//  Значение - Строка
//  ИмяПоля - Строка - для текста ошибки
//
// Возвращаемое значение:
//  Произвольный
//
Функция ЗначениеПоляНавСсылки(ТипПоля, Значение, ИмяПоля)

	Типы = ТипПоля.Типы();
	Если Типы.Количество() <> 1 Тогда
		ВызватьИсключение СтрШаблон("Измерение %1 составного типа: по навигационной ссылке его значение не определить", ИмяПоля);
	КонецЕсли;

	ТипЗначения = Типы[0];
	Если ТипЗначения = Тип("Строка") Тогда
		Результат = Значение;
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Результат = Число(Значение);
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Результат = Дата(Значение);
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Результат = (Значение = "1" Или НРег(Значение) = "true");
	Иначе
		Результат = СсылкаПоИдентификаторуНавСсылки(ТипПоля.ПривестиЗначение(Неопределено), Значение);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Ссылка по идентификатору из навигационной ссылки: 32 шестнадцатеричные цифры в порядке хранения в базе
// подставляются во внутреннее представление пустой ссылки того же типа. Так разбираются ссылки любых ссылочных типов.
//
// Параметры:
//  ПустаяСсылка - ЛюбаяСсылка
//  Идентификатор - Строка
//
// Возвращаемое значение:
//  ЛюбаяСсылка
//
Функция СсылкаПоИдентификаторуНавСсылки(ПустаяСсылка, Знач Идентификатор)

	ПустойИдентификатор = "00000000000000000000000000000000";
	Идентификатор = НРег(СокрЛП(Идентификатор));
	Если Не ЭтоИдентификаторНавСсылки(Идентификатор) Тогда
		ВызватьИсключение СтрШаблон("Неверный идентификатор ""%1"": ожидается 32 шестнадцатеричные цифры", Идентификатор);
	КонецЕсли;

	ШаблонСсылки = ЗначениеВСтрокуВнутр(ПустаяСсылка);
	Если СтрНайти(ШаблонСсылки, ПустойИдентификатор) = 0 Тогда
		ВызватьИсключение СтрШаблон("Значение типа %1 по идентификатору из навигационной ссылки не получить", ТипЗнч(ПустаяСсылка));
	КонецЕсли;

	Возврат ЗначениеИзСтрокиВнутр(СтрЗаменить(ШаблонСсылки, ПустойИдентификатор, Идентификатор));

КонецФункции

// Проверка до подстановки во внутреннее представление: туда не должно попасть ничего, кроме идентификатора.
//
// Параметры:
//  Идентификатор - Строка - в нижнем регистре
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоИдентификаторНавСсылки(Идентификатор)

	Если СтрДлина(Идентификатор) <> 32 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для НомерСимвола = 1 По 32 Цикл
		Если СтрНайти("0123456789abcdef", Сред(Идентификатор, НомерСимвола, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти

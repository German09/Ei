// Фоновое выполнение вариантов Ei на клиенте. Команда «Выполнить в фоне» запускает текущий вариант строки набора
// в фоновом задании: вариант выполняется только на сервере, клиент тем временем свободен.
// Запрос и алгоритм одной строки могут выполняться в фоне одновременно, у каждого пользователя запуски свои.
// Пока задание идет, за символом варианта в дереве наборов стоит ⏳, а на закладке варианта идет время выполнения.
// О завершении сообщает уведомление клиента: оповещение пользователя, по нажатию - строка запуска в Ei.
// Результат показывается, когда строка и ее вариант становятся текущими, до этого за символом варианта - ✓,
// у ошибки - ✗. Запуски хранит сервер, см. ФоновоеВыполнениеСервер_Ei: после закрытия
// и открытия Ei, в том числе в новом сеансе, они снова видны в дереве. Запуск записывается в историю запусков варианта.
// Сообщения пользователю задания выводятся в окно сообщений Ei с пометкой «в фоне»: пока задание идет -
// при сверке с сервером, остальные - с итогом.
// Без @strict-types: модули вариантов вызываются динамически.

#Область ПрограммныйИнтерфейс

// Подписывает сеанс на уведомления о завершении фоновых запусков. Вызывается при начале работы системы.
//
Процедура ПодключитьОбработчики() Экспорт
	
	Попытка
		УведомленияКлиента.ПодключитьОбработчик(ФоновоеВыполнениеКлиентСервер_Ei.КлючУведомления(),
			Новый ОписаниеОповещения("ПриЗавершенииЗапуска", ФоновоеВыполнениеКлиент_Ei));
		УведомленияКлиента.ПодключитьОбработчик(ФоновоеВыполнениеКлиентСервер_Ei.КлючЗапросаЗначения(),
			Новый ОписаниеОповещения("ПриЗапросеЗначения", ФоновоеВыполнениеКлиент_Ei));
		УведомленияКлиента.ПодключитьОбработчик(ФоновоеВыполнениеКлиентСервер_Ei.КлючУведомленияХода(),
			Новый ОписаниеОповещения("ПриХодеЗапуска", ФоновоеВыполнениеКлиент_Ei));
	Исключение
		// Без уведомлений о завершении узнает только открытая форма Ei, см. ПроверитьВыполнение
		ПоказатьОповещениеПользователя(НСтр("ru = 'Ei: оповещения о фоновом выполнении недоступны'"), ,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), КартинкаОповещения());
	КонецПопытки;
	
КонецПроцедуры

// Выполняет в фоне текущий вариант текущей строки набора, команда формы Ei.
// Если в тексте варианта есть выделение, как и обычный запуск, спрашивает, выполнить ли только фрагмент,
// см. ВариантыКлиент_Ei.УточнитьРежимВыполнения
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//
Процедура ВыполнитьВФоне(Форма) Экспорт
	
	ТекД 		= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Вариант 	= ?(ТекД = Неопределено, Неопределено, ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма, ТекД));
	Если Вариант = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыделенныйТекст = "";
	Если ФоновоеВыполнениеКлиентСервер_Ei.ВариантВыполняетсяВФоне(Вариант.Свойства()) Тогда
		ЭлементИнструкции = Вариант.ЭлементИнструкции(Форма);
		Если ЭлементИнструкции <> Неопределено Тогда
			ВыделенныйТекст = ТекстМодуляКлиент_Ei.ПолучитьВыделенныйТекст(ЭлементИнструкции);
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВыделенныйТекст) Тогда
		Запустить(Форма, ТекД, Вариант, Неопределено);
		Возврат;
	КонецЕсли;
	
	// Вопрос блокирует форму Ei: строка и вариант до ответа не сменятся
	Фрагмент 	= "Фрагмент";
	Кнопки 		= Новый СписокЗначений;
	Кнопки.Добавить(Фрагмент, НСтр("ru = 'Только фрагмент'"));
	Кнопки.Добавить("Весь", 	НСтр("ru = 'Всё содержимое'"));
	Кнопки.Добавить("Отмена", 	НСтр("ru = 'Отмена'"));
	Вопрос 		= НСтр("ru = 'Выполнить в фоне только выделенный фрагмент?'");
	Оповещение 	= Новый ОписаниеОповещения("ПослеВыбораФрагмента", ФоновоеВыполнениеКлиент_Ei,
		Новый Структура("Форма,ВыделенныйТекст", Форма, ВыделенныйТекст));
	ВариантыКлиент_Ei.ОткрытьВыборФрагмента(Форма, Вариант, ВыделенныйТекст, Вопрос, Кнопки, Фрагмент, Оповещение);
	
КонецПроцедуры

// Останавливает фоновое выполнение варианта открытой закладки текущей строки, команда формы Ei.
// Если закладка открыта на другом варианте, а в фоне выполняется один вариант строки, останавливается он.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//
Процедура Остановить(Форма) Экспорт
	
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Вариант 		= ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма, ТекД);
	ИмяВарианта 	= ?(Вариант = Неопределено, "", Вариант.Свойства().Имя);
	Запись 			= Неопределено;
	Выполняющиеся 	= Новый Массив;
	Для Каждого Элемент Из Кэш().Записи Цикл
		Кандидат = Элемент.Значение;
		Если Кандидат.КлючСтроки = Строка(ТекД.КлючНастроек) И Кандидат.Состояние = Состояния().Выполняется Тогда
			Выполняющиеся.Добавить(Кандидат);
			Если Кандидат.ИмяВарианта = ИмяВарианта Тогда
				Запись = Кандидат;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Запись = Неопределено И Выполняющиеся.Количество() = 1 Тогда
		Запись = Выполняющиеся.Получить(0);
	КонецЕсли;
	
	Если Запись = Неопределено Тогда
		Пояснение = ?(Выполняющиеся.Количество() = 0, НСтр("ru = 'Варианты строки не выполняются в фоне'"),
			НСтр("ru = 'В фоне выполняется несколько вариантов строки: откройте закладку того, который остановить'"));
		ПоказатьОповещениеПользователя(НСтр("ru = 'Нечего останавливать'"), , Пояснение, КартинкаОповещения());
		Возврат;
	КонецЕсли;
	
	Остановленная = ФоновоеВыполнениеВызовСервера_Ei.Остановить(Запись.Ид);
	Если Остановленная <> Неопределено И Остановленная.Состояние <> Состояния().Остановлено Тогда
		// Задание успело завершиться: результат показывается как обычно
		ПрименитьЗапись(Остановленная);
	Иначе
		Если Остановленная <> Неопределено Тогда
			ПоказатьСообщения(Остановленная);
		КонецЕсли;
		Кэш().Записи.Удалить(Запись.Ид);
		ОбновитьСтроки(Форма, Запись);
		ПоказатьОповещениеПользователя(ПредставлениеЗапуска(Запись) + ОтметкаСостояния(Состояния().Остановлено), ,
			НСтр("ru = 'фоновое выполнение остановлено'"), КартинкаОповещения());
	КонецЕсли;
	
КонецПроцедуры

// Загружает фоновые запуски пользователя при открытии формы Ei, см. КонструкторКлиент_Ei.ПриЗапуске
// Значки в дереве расставляет см. ВариантыКлиент_Ei.ОбновитьСимволыВариантов
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//
Процедура ПриОткрытииФормы(Форма) Экспорт
	
	Попытка
		ОбновитьЗаписи();
	Исключение
		// Форма Ei должна открыться и без фоновых запусков
		ПоказатьОповещениеПользователя(НСтр("ru = 'Ei: фоновые запуски не загружены'"), ,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), КартинкаОповещения());
	КонецПопытки;
	Если ЕстьВыполняющиеся() Тогда
		ПодключитьПроверку(Форма);
	КонецЕсли;
	ОбновитьКоманды(Форма, Форма.ПолучитьПереопределяемыйОбъектОбработки());
	
КонецПроцедуры

// Показывает итог завершенного фонового запуска варианта, открытого в текущей строке:
// результат - как после выполнения, ошибку - в полосе ошибок варианта.
// Вызывается при смене текущей строки и закладки варианта, см. НаборВариантовКлиент_Ei.ВосстановитьВариант
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  ТекД - ДанныеФормыЭлементДерева - текущая строка набора
//
Процедура ПоказатьГотовыйРезультат(Форма, ТекД) Экспорт
	
	Вариант = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма, ТекД);
	Если Вариант = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Запись = ЗаписьВарианта(ТекД.КлючНастроек, Вариант.Свойства().Имя);
	Если Запись = Неопределено Или Запись.Состояние = Состояния().Выполняется Тогда
		Возврат;
	КонецЕсли;
	
	Итог = ФоновоеВыполнениеВызовСервера_Ei.ЗабратьРезультат(Запись.Ид, Форма.УникальныйИдентификатор);
	Кэш().Записи.Удалить(Запись.Ид);
	Кэш().Забранные.Вставить(Запись.Ид, Истина);
	
	Если Итог.Запись = Неопределено Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Результат фонового запуска уже показан'"), ,
			НСтр("ru = 'Он сохранен в истории запусков варианта'"), КартинкаОповещения());
	Иначе
		Запись = Итог.Запись;
		ПоказатьСообщения(Запись);
		ПоказатьВложенныеЗапуски(Форма, Запись);
		НастройкиПользователяКлиентСервер_Ei.СохранитьЗатраченноеВремя(ТекД, Форма.НастройкиПользователя, Вариант, Запись.Длительность);
		Если ЗначениеЗаполнено(Запись.Ошибка) Тогда
			ОтладкаКлиент_Ei.ПоказатьИсключение(Форма, Запись.Ошибка, ВариантыКлиентСервер_Ei, Вариант);
		ИначеЕсли Итог.ОписаниеЗначения <> Неопределено Тогда
			ОтладкаКлиент_Ei.СкрытьИсключение(Форма, ВариантыКлиентСервер_Ei);
			ВариантыКлиент_Ei.ПоказатьОписаниеРезультата(Форма, ТекД, Вариант, Итог.ОписаниеЗначения);
			Если Итог.СнимокУсечен Тогда
				ПоказатьОповещениеПользователя(НСтр("ru = 'Показана часть результата'"), , Запись.ПредставлениеРезультата,
					КартинкаОповещения());
			КонецЕсли;
		Иначе
			ПоказатьОповещениеПользователя(НСтр("ru = 'Результат фонового запуска не сохранен'"), , Запись.ПредставлениеРезультата,
				КартинкаОповещения());
		КонецЕсли;
		Если ЗначениеЗаполнено(Запись.Предупреждение) Тогда
			ПоказатьОповещениеПользователя(ПредставлениеЗапуска(Запись), , Запись.Предупреждение, КартинкаОповещения());
		КонецЕсли;
	КонецЕсли;
	ОбновитьСтроки(Форма, Запись);
	Если Вариант.Свойства().Имя = ВариантПроцессыКлиентСервер_Ei.Ключ() Тогда
		ПроцессыКлиент_Ei.ОбновитьВыполненнуюСхему(Форма, ТекД); // ход завершенного запуска со схемы убирается
	КонецЕсли;
	Форма.ПодключитьОбработчикОжидания("ОбновитьЗаголовкиЗакладок", 0.1, Истина);
	
КонецПроцедуры

// Обработчик ожидания формы Ei, пока в ней есть фоновые запуски: каждую секунду обновляет время
// в колонке значков дерева наборов у выполняющихся строк, а раз в несколько секунд сверяет запуски
// с сервером - так находятся прерванные задания и завершения, уведомление о которых не пришло.
// Время идет только в данных дерева: смена заголовка закладки раз в секунду перестраивала форму
// и сбрасывала размеры областей, заданные пользователем. Закладки меняются только при смене состояния
// запуска, см. ПрименитьЗапись
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//
Процедура ПроверитьВыполнение(Форма) Экспорт
	
	Если ТекущаяУниверсальнаяДатаВМиллисекундах() - Кэш().Проверено >= ИнтервалСверки() * 1000 Тогда
		Попытка
			ОбновитьЗаписи();
		Исключение
			// Сервер временно недоступен: время в дереве идет дальше, сверка повторится
			Кэш().Проверено = ТекущаяУниверсальнаяДатаВМиллисекундах();
		КонецПопытки;
	КонецЕсли;
	
	Если ЕстьВыполняющиеся() Тогда
		ОбновитьВремяВДереве(Форма);
	Иначе
		Форма.ОтключитьОбработчикОжидания("ПроверитьФоновоеВыполнение");
	КонецЕсли;
	
КонецПроцедуры

// Отметка фонового выполнения за символом варианта в дереве наборов, см. ВариантыКлиент_Ei.СимволыВариантов
// ⏳ и сколько уже идет - вариант выполняется в фоне, ✓ и ✗ - запуск завершен, а его результат или ошибка
// еще не показаны. Время обновляет каждую секунду см. ПроверитьВыполнение
//
// Параметры:
//  СтрокаНабора - ДанныеФормыЭлементДерева
//  ИмяВарианта - Строка
//
// Возвращаемое значение:
//  Строка - пустая, если у варианта нет фонового запуска
//
Функция ОтметкаВарианта(СтрокаНабора, ИмяВарианта) Экспорт
	
	Отметка 	= "";
	Запись 		= ЗаписьВарианта(СтрокаНабора.КлючНастроек, ИмяВарианта);
	Если Запись <> Неопределено Тогда
		Отметка = ОтметкаСостояния(Запись.Состояние);
		Если Запись.Состояние = Состояния().Выполняется Тогда
			Отметка = Отметка + ИдущееВремя(ТекущаяУниверсальнаяДатаВМиллисекундах() - Запись.НачалоНаКлиенте);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Отметка;
	
КонецФункции

// Отметка состояния фонового запуска для дерева наборов, сообщений и оповещений:
// ⏳ - выполняется, ✓ - выполнено, ■ - остановлено, ✗ - ошибка.
//
// Параметры:
//  Состояние - Строка - см. ФоновоеВыполнениеКлиентСервер_Ei.Состояния
//
// Возвращаемое значение:
//  Строка
//
Функция ОтметкаСостояния(Состояние) Экспорт
	
	Если Состояние = Состояния().Выполняется Тогда
		Отметка = Символ(9203); // ⏳
	ИначеЕсли Состояние = Состояния().Выполнено Тогда
		Отметка = "✓";
	ИначеЕсли Состояние = Состояния().Остановлено Тогда
		Отметка = "■";
	Иначе
		Отметка = "✗";
	КонецЕсли;
	
	Возврат Отметка;
	
КонецФункции

// Время выполнения варианта для закладки: пока вариант выполняется в фоне - не выводится, на закладке
// только песочные часы (см. ОтметкаЗаголовка), у завершенного запуска, итог которого еще не показан, - его длительность.
// Время, идущее на закладке, перестраивало форму каждую секунду, оно идет в дереве, см. ОтметкаВарианта
//
// Параметры:
//  СтрокаНабора - ДанныеФормыЭлементДерева
//  ИмяВарианта - Строка
//  Время - Число, Неопределено - сохраненное время выполнения варианта, миллисекунды
//
// Возвращаемое значение:
//  Число, Неопределено - миллисекунды
//
Функция ЗатраченноеВремя(СтрокаНабора, ИмяВарианта, Время) Экспорт
	
	Результат 	= Время;
	Запись 		= ЗаписьВарианта(СтрокаНабора.КлючНастроек, ИмяВарианта);
	Если Запись <> Неопределено И Запись.Состояние = Состояния().Выполняется Тогда
		Результат = Неопределено;
	ИначеЕсли Запись <> Неопределено Тогда
		Результат = Запись.Длительность;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Доступность команд фонового выполнения для текущей строки и закладки варианта: «Выполнить в фоне» -
// вариант можно выполнять в фоне и он еще не выполняется, «Остановить» - в строке что-то выполняется в фоне.
// Пока вариант выполняется в фоне, его нельзя запустить обычно и править его текст, а пока в строке
// что-то выполняется - править параметры: они общие для вариантов строки.
// Вызывается при обновлении закладок вариантов текущей строки, см. ВариантыКлиент_Ei.ОбновитьЗаголовки
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  ТекД - ДанныеФормыЭлементДерева, Неопределено - текущая строка набора
//
Процедура ОбновитьКоманды(Форма, ТекД) Экспорт
	
	МожноЗапустить 		= Ложь;
	МожноОстановить 	= Ложь;
	Если ТекД <> Неопределено Тогда
		Вариант = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма, ТекД);
		Если Вариант <> Неопределено Тогда
			Свойства 		= Вариант.Свойства();
			Выполняется 	= ВариантВыполняется(ТекД, Свойства.Имя);
			МожноЗапустить 	= ФоновоеВыполнениеКлиентСервер_Ei.ВариантВыполняетсяВФоне(Свойства) И Не Выполняется;
			УстановитьДоступность(Форма, "ИсполнитьВариант", Свойства.Исполнение И Не Выполняется);
		КонецЕсли;
		МожноОстановить = ВыполняетсяВСтроке(ТекД);
		Для Каждого Элемент Из ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
			ОбновитьБлокировкуРедактора(Форма, ТекД, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;
	
	УстановитьДоступность(Форма, "ФормаВыполнитьВФоне", МожноЗапустить);
	УстановитьДоступность(Форма, "ФормаОстановитьФоновоеВыполнение", МожноОстановить);
	ОбновитьБлокировкуПараметров(Форма, МожноОстановить);
	
КонецПроцедуры

// Текст варианта, выполняющегося в фоне, только для просмотра. Редактор один на все строки: вызывается
// и при смене текущей строки, и когда редактор загрузился, см. ВариантыКлиент_Ei.ПриИзмененииДанныхВариантаСРедактором
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  ТекД - ДанныеФормыЭлементДерева - текущая строка набора
//  Вариант - ОбщийМодуль - модуль варианта
//
Процедура ОбновитьБлокировкуРедактора(Форма, ТекД, Вариант) Экспорт
	
	Свойства = Вариант.Свойства();
	Если ФоновоеВыполнениеКлиентСервер_Ei.ВариантВыполняетсяВФоне(Свойства) Тогда
		Редактор = Вариант.ЭлементИнструкции(Форма);
		Если Редактор <> Неопределено И Редактор.Доступность Тогда // недоступен, пока не загрузился
			РедакторКодаКлиент_Ei.УстановитьТолькоПросмотр(Редактор, ВариантВыполняется(ТекД, Свойства.Имя));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Вариант строки выполняется в фоне.
//
// Параметры:
//  СтрокаНабора - ДанныеФормыЭлементДерева, Неопределено - строка набора; Неопределено - текущей строки нет
//  ИмяВарианта - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ВариантВыполняется(СтрокаНабора, ИмяВарианта) Экспорт
	
	Запись = ?(СтрокаНабора = Неопределено, Неопределено, ЗаписьВарианта(СтрокаНабора.КлючНастроек, ИмяВарианта));
	
	Возврат Запись <> Неопределено И Запись.Состояние = Состояния().Выполняется;
	
КонецФункции

// Параметры текущей строки нельзя менять: в ней что-то выполняется в фоне.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//
// Возвращаемое значение:
//  Булево
//
Функция ПараметрыЗаблокированы(Форма) Экспорт
	
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	
	Возврат ТекД <> Неопределено И ВыполняетсяВСтроке(ТекД);
	
КонецФункции

// Отказ в обычном запуске варианта, который уже выполняется в фоне: кнопка в это время недоступна,
// проверка - для запуска клавишей.
//
// Параметры:
//  СтрокаНабора - ДанныеФормыЭлементДерева
//  ИмяВарианта - Строка
//
// Возвращаемое значение:
//  Булево - Истина, если запускать нельзя
//
Функция ОтказатьВЗапуске(СтрокаНабора, ИмяВарианта) Экспорт
	
	Отказ = ВариантВыполняется(СтрокаНабора, ИмяВарианта);
	Если Отказ Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Вариант не запущен'"), ,
			СтрШаблон(НСтр("ru = '%1 уже выполняется в фоне'"), ПредставлениеЗапуска(ЗаписьВарианта(СтрокаНабора.КлючНастроек, ИмяВарианта))),
			КартинкаОповещения());
	КонецЕсли;
	
	Возврат Отказ;
	
КонецФункции

// Отметка в заголовке закладки варианта, пока он выполняется в фоне: песочные часы.
//
// Параметры:
//  СтрокаНабора - ДанныеФормыЭлементДерева
//  ИмяВарианта - Строка
//
// Возвращаемое значение:
//  Строка - пустая, если вариант не выполняется в фоне
//
Функция ОтметкаЗаголовка(СтрокаНабора, ИмяВарианта) Экспорт
	
	Отметка 	= "";
	Запись 		= ЗаписьВарианта(СтрокаНабора.КлючНастроек, ИмяВарианта);
	Если Запись <> Неопределено И Запись.Состояние = Состояния().Выполняется Тогда
		Отметка = " " + Символ(9203);
	КонецЕсли;
	
	Возврат Отметка;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик уведомления о том, что фоновому заданию нужно значение этого сеанса,
// см. ФоновоеВыполнениеСервер_Ei.ОписаниеИзСеансаЗапуска
//
// Параметры:
//  Данные - см. ФоновоеВыполнениеСервер_Ei.ПередатьЗначение.Данные
//  ДополнительныеПараметры - Неопределено
//
Процедура ПриЗапросеЗначения(Данные, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("Пользователь") И Данные.Пользователь = ИмяПользователя() Тогда
		Попытка
			ФоновоеВыполнениеВызовСервера_Ei.ПередатьЗначение(Данные);
		Исключение
			// Не дождавшись ответа, задание выполнит вариант само
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик уведомления о завершении фонового запуска, см. ФоновоеВыполнениеСервер_Ei.ВыполнитьЗадание
// Уведомление приходит во все клиентские сеансы пользователя.
//
// Параметры:
//  ДанныеЗапуска - Структура - запись фонового запуска, см. ФоновоеВыполнениеВызовСервера_Ei.Записи
//  ДополнительныеПараметры - Неопределено
//
Процедура ПриЗавершенииЗапуска(ДанныеЗапуска, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(ДанныеЗапуска) = Тип("Структура") И ДанныеЗапуска.Свойство("Пользователь")
		И ДанныеЗапуска.Пользователь = ИмяПользователя() Тогда
		ПрименитьЗапись(ДанныеЗапуска);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик уведомления о ходе фонового запуска: о шагах процесса и строке коллекции «Для Каждого»,
// см. ФоновоеВыполнениеСервер_Ei.УведомитьОХоде и ПроцессыКлиент_Ei.ПоказатьХод, и о выполненном варианте,
// вызванном из кода запуска, см. ФоновоеВыполнениеСервер_Ei.УведомитьОВложенном
// Ход запуска, итог которого уже показан, не показывается: уведомление о ходе может прийти позже итога.
//
// Параметры:
//  Данные - см. ПроцессыКлиент_Ei.ПоказатьХод.Данные
//  ДополнительныеПараметры - Неопределено
//
Процедура ПриХодеЗапуска(Данные, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("Пользователь") И Данные.Пользователь = ИмяПользователя()
		И Кэш().Забранные.Получить(Данные.Ид) = Неопределено Тогда
		Если Данные.Свойство("Вложенный") Тогда
			ПоказатьВложенныйЗапуск(ФормаEi(), Данные.Вложенный);
		Иначе
			ПроцессыКлиент_Ei.ПоказатьХод(ФормаEi(), Данные);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Открывает Ei на строке и варианте фонового запуска: по нажатию на оповещение о завершении.
// Итог, если он еще не показан, показывается при активизации строки, см. ПоказатьГотовыйРезультат
// Оповещений обработчик не показывает: клиент падал при нажатии на оповещение, когда обработчик
// показывал новое оповещение (8.3.27, 2026-10-29), - о ненайденной строке сообщает окно сообщений.
//
// Параметры:
//  Переход - Структура - строка и вариант запуска, см. ДанныеПерехода
//
Процедура ОткрытьЗапуск(Переход) Экспорт
	
	Форма = ОткрытьФормуEi();
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаНабора = Неопределено;
	Для Каждого Найденная Из СтрокиЗаписи(Форма, Переход) Цикл
		СтрокаНабора = Найденная;
		Прервать;
	КонецЦикла;
	
	Если СтрокаНабора = Неопределено Тогда
		Сообщение 							= Новый СообщениеПользователю;
		Сообщение.Текст 					= СтрШаблон(НСтр("ru = '%1: строки нет в открытом наборе. Откройте набор с ней - результат покажется в строке, он есть и в истории запусков'"),
			ПредставлениеЗапуска(Переход));
		Сообщение.ИдентификаторНазначения 	= Форма.УникальныйИдентификатор;
		Сообщение.Сообщить();
	Иначе
		Форма.Активизировать();
		ВариантыКлиент_Ei.СохранитьТекущийОбработчик(Форма, СтрокаНабора, Переход.ИмяВарианта);
		НаборВариантовКлиент_Ei.АктивизироватьСтроку(Форма, СтрокаНабора.ПолучитьИдентификатор());
	КонецЕсли;
	
КонецПроцедуры

// Запускает фоновое выполнение по ответу на вопрос о выделенном фрагменте, см. ВыполнитьВФоне
// и ВариантыКлиент_Ei.ПослеВыбораРежимаВыполнения
// По таймауту форма возвращает фрагмент - кнопку по умолчанию, отмена и закрытие формы - запуска нет.
//
// Параметры:
//  Ответ - Строка, Неопределено - значение нажатой кнопки
//  Контекст - Структура - форма Ei и выделенный текст:
//   * Форма - см. ОбщаяФорма.Ei
//   * ВыделенныйТекст - Строка
//
Процедура ПослеВыбораФрагмента(Ответ, Контекст) Экспорт
	
	Если Ответ = "Фрагмент" Тогда
		Фрагмент = Контекст.ВыделенныйТекст;
	ИначеЕсли Ответ = "Весь" Тогда
		Фрагмент = Неопределено;
	Иначе
		Возврат;
	КонецЕсли;
	
	Форма 		= Контекст.Форма;
	ТекД 		= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Вариант 	= ?(ТекД = Неопределено, Неопределено, ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма, ТекД));
	Если Вариант <> Неопределено Тогда
		Запустить(Форма, ТекД, Вариант, Фрагмент);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Записи

// Запускает фоновое задание варианта строки и отмечает запуск в дереве.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  ТекД - ДанныеФормыЭлементДерева - строка набора
//  Вариант - ОбщийМодуль - модуль варианта
//  Фрагмент - Строка - выделенный фрагмент текста варианта
//           - Неопределено - выполняется весь текст
//
Процедура Запустить(Форма, ТекД, Вариант, Фрагмент)
	
	Свойства 	= Вариант.Свойства();
	Инструкция 	= Фрагмент;
	Если Инструкция = Неопределено Тогда
		Инструкция = "";
		ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(Вариант.ПодготовитьДанные(ТекД), "Инструкция", Инструкция);
	КонецЕсли;
	Причина = ПричинаОтказа(ТекД, Вариант, Инструкция);
	Если ЗначениеЗаполнено(Причина) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Фоновое выполнение не запущено'"), , Причина, КартинкаОповещения());
		Возврат;
	КонецЕсли;
	
	// Снимок наборов в параметрах сеанса нужен заданию для параметров, Наборы() и Варианты().
	// Текущий запуск сеанса не меняется: фоновый запуск идет в другом сеансе
	ВариантыКлиент_Ei.ОбновитьВаринаты(Форма, НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма));
	Запуск 					= ИсторияКлиентСервер_Ei.НовыйЗапуск(Строка(Новый УникальныйИдентификатор),
		ИсторияКлиентСервер_Ei.КлючВарианта(ТекД.КлючНастроек, Свойства.Имя), Свойства.Имя, Инструкция);
	Запуск.РазмерВарианта 	= Вариант.ПолучитьРазмерность(Форма, ТекД);
	Описание 				= Новый Структура;
	Описание.Вставить("Запуск", 		Запуск);
	Описание.Вставить("КлючСтроки", 	Строка(ТекД.КлючНастроек));
	Описание.Вставить("ИмяНабора", 		ТекД.ИмяНабора);
	Описание.Вставить("Синоним", 		Свойства.Синоним);
	
	Итог = ФоновоеВыполнениеВызовСервера_Ei.Запустить(Описание);
	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Фоновое выполнение не запущено'"), , Итог.Ошибка, КартинкаОповещения());
	Иначе
		Запомнить(Итог.Запись);
		ОбновитьСтроки(Форма, Итог.Запись);
		ПодключитьПроверку(Форма);
		ПоказатьОповещениеПользователя(ПредставлениеЗапуска(Итог.Запись) + ОтметкаСостояния(Итог.Запись.Состояние), ,
			НСтр("ru = 'выполняется в фоне'"), КартинкаОповещения());
	КонецЕсли;
	
КонецПроцедуры

// Применяет новое состояние запуска из уведомления или сверки с сервером: значки в дереве,
// итог в текущей строке и оповещение о завершении. Уже известное состояние не применяется повторно:
// об одном завершении могут сообщить и уведомление, и сверка.
//
// Параметры:
//  Запись - Структура - запись фонового запуска, см. ФоновоеВыполнениеВызовСервера_Ei.Записи
//
Процедура ПрименитьЗапись(Запись)
	
	Кэш = Кэш();
	Если Кэш.Забранные.Получить(Запись.Ид) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Прежняя = Кэш.Записи.Получить(Запись.Ид);
	Запомнить(Запись);
	Если Прежняя <> Неопределено И Прежняя.Состояние = Запись.Состояние Тогда
		Возврат;
	КонецЕсли;
	
	Форма = ФормаEi();
	Если Форма <> Неопределено Тогда
		ОбновитьСтроки(Форма, Запись);
	КонецЕсли;
	
	Если Запись.Состояние = Состояния().Выполняется Тогда
		Если Форма <> Неопределено Тогда
			ПодключитьПроверку(Форма);
		КонецЕсли;
	Иначе
		ОповеститьОЗавершении(Запись);
		Если Форма <> Неопределено Тогда
			ПоказатьВложенныеЗапуски(Форма, Запись);
		КонецЕсли;
		ТекД = ?(Форма = Неопределено, Неопределено, Форма.ПолучитьПереопределяемыйОбъектОбработки());
		Если ТекД <> Неопределено И Строка(ТекД.КлючНастроек) = Запись.КлючСтроки Тогда
			ПоказатьГотовыйРезультат(Форма, ТекД);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Запоминает запись запуска на время сеанса и показывает пришедшие с ней сообщения задания.
// Начало выполняющегося запуска переводится в часы клиента: по нему в дереве наборов идет время выполнения,
// см. ОтметкаВарианта
//
// Параметры:
//  Запись - Структура - запись фонового запуска, см. ФоновоеВыполнениеВызовСервера_Ei.Записи
//
Процедура Запомнить(Запись)
	
	Запись.Вставить("НачалоНаКлиенте", ТекущаяУниверсальнаяДатаВМиллисекундах() - Запись.Прошло);
	Кэш().Записи.Вставить(Запись.Ид, Запись);
	ПоказатьСообщения(Запись);
	
КонецПроцедуры

// Показывает сообщения пользователю фонового задания, которые сеанс еще не показал: в окне сообщений
// формы Ei, если она открыта. В фоне платформа их не показывает; пока задание идет, они приходят
// при сверке с сервером, остальные - с итогом.
//
// Параметры:
//  Запись - Структура - запись фонового запуска, см. ФоновоеВыполнениеВызовСервера_Ei.Записи
//
Процедура ПоказатьСообщения(Запись)
	
	ПоказаноСообщений 	= Кэш().ПоказаноСообщений;
	Показано 			= ПоказаноСообщений.Получить(Запись.Ид);
	Показано 			= ?(Показано = Неопределено, 0, Показано);
	Форма 				= ФормаEi();
	
	Номер = Запись.ПервоеСообщение;
	Для Каждого ТекстСообщения Из Запись.Сообщения Цикл
		Если Номер >= Показано Тогда
			Сообщение 			= Новый СообщениеПользователю;
			// Значками, как в дереве наборов: Ei817 ✎⏳: текст
			Сообщение.Текст 	= СтрШаблон("%1%2: %3", ПредставлениеЗапуска(Запись), ОтметкаСостояния(Состояния().Выполняется),
				ТекстСообщения);
			Если Форма <> Неопределено Тогда
				Сообщение.ИдентификаторНазначения = Форма.УникальныйИдентификатор;
			КонецЕсли;
			Сообщение.Сообщить();
		КонецЕсли;
		Номер = Номер + 1;
	КонецЦикла;
	ПоказаноСообщений.Вставить(Запись.Ид, Макс(Показано, Номер));
	
КонецПроцедуры

// Передает строке набора итог варианта, вызванного из кода фонового запуска, не дожидаясь итога запуска,
// см. ФоновоеВыполнениеСервер_Ei.УведомитьОВложенном. С итогом запуска он второй раз не загружается.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  Вложенный - см. ВариантыВызовСервера_Ei.ВложенныеЗапуски
//
Процедура ПоказатьВложенныйЗапуск(Форма, Вложенный)
	
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Вложенные = Новый Массив;
	Вложенные.Добавить(Вложенный);
	Попытка
		ИсторияКлиент_Ei.ПоказатьВложенныеЗапуски(Форма,
			ФоновоеВыполнениеВызовСервера_Ei.ВложенныеЗапуски(Вложенные, Форма.УникальныйИдентификатор));
	Исключение
		Возврат; // его покажет итог запуска
	КонецПопытки;
	Если ЗначениеЗаполнено(Вложенный.Ид) Тогда
		Кэш().ПоказанныеВложенные.Вставить(Вложенный.Ид, Истина);
	КонецЕсли;
	
КонецПроцедуры

// Передает строкам набора итоги вариантов, вызванных из кода фонового запуска, и данные, заданные этим кодом:
// один раз за сеанс на запуск.
// Варианты, показанные во время запуска, см. ПоказатьВложенныйЗапуск, не загружаются второй раз.
// Сообщения этих вариантов приходят с сообщениями самого запуска: задание у них общее, см. ПоказатьСообщения
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  Запись - Структура - запись фонового запуска, см. ФоновоеВыполнениеВызовСервера_Ei.Записи
//
Процедура ПоказатьВложенныеЗапуски(Форма, Запись)
	
	ПоказанныеВложенные = Кэш().ПоказанныеВложенные;
	Если ПоказанныеВложенные.Получить(Запись.Ид) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЕстьДанные = Запись.Свойство("ЕстьЗаданныеДанные") И Запись.ЕстьЗаданныеДанные;
	Если Запись.Вложенные.Количество() > 0 Или ЕстьДанные Тогда
		ПоказанныеВложенные.Вставить(Запись.Ид, Истина);
	КонецЕсли;
	
	Если Запись.Вложенные.Количество() > 0 Тогда
		Вложенные = Новый Массив;
		Для Каждого Вложенный Из Запись.Вложенные Цикл
			Если Не ЗначениеЗаполнено(Вложенный.Ид) Или ПоказанныеВложенные.Получить(Вложенный.Ид) = Неопределено Тогда
				Вложенные.Добавить(Вложенный);
			КонецЕсли;
		КонецЦикла;
		Попытка
			ИсторияКлиент_Ei.ПоказатьВложенныеЗапуски(Форма,
				ФоновоеВыполнениеВызовСервера_Ei.ВложенныеЗапуски(Вложенные, Форма.УникальныйИдентификатор));
		Исключение
			// Итог самого запуска должен показаться и без вложенных: они остаются в истории своих строк
			ПоказатьОповещениеПользователя(НСтр("ru = 'Вложенные запуски не показаны'"), ,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), КартинкаОповещения());
		КонецПопытки;
	КонецЕсли;
	
	// После вложенных: модифицированность пересобирает снимок наборов из формы
	Если ЕстьДанные Тогда
		Попытка
			ЗаданныеДанные = Неопределено;
			Если Не Запись.Свойство("ЗаданныеДанные", ЗаданныеДанные) Тогда
				//в записях сверки и уведомлений таблиц нет, см. ФоновоеВыполнениеСервер_Ei.ДляКлиента
				ЗаданныеДанные = ФоновоеВыполнениеВызовСервера_Ei.ЗаданныеДанные(Запись.Ид);
			КонецЕсли;
			ВариантКоллекцияКлиент_Ei.ЗагрузитьЗаданныеДанные(Форма, ЗаданныеДанные);
		Исключение
			ПоказатьОповещениеПользователя(НСтр("ru = 'Данные, заданные кодом, не загружены'"), ,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), КартинкаОповещения());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Сверяет запуски клиента с сервером. При первой загрузке в сеансе об уже завершенных запусках
// не оповещает: их видно по значкам в дереве.
//
Процедура ОбновитьЗаписи()
	
	Кэш 			= Кэш();
	Кэш.Проверено 	= ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Актуальные = Новый Соответствие;
	Для Каждого Запись Из ФоновоеВыполнениеВызовСервера_Ei.Записи(Кэш.ПоказаноСообщений) Цикл
		Актуальные.Вставить(Запись.Ид, Истина);
		Если Кэш.Загружены Тогда
			ПрименитьЗапись(Запись);
		ИначеЕсли Кэш.Забранные.Получить(Запись.Ид) = Неопределено Тогда
			Запомнить(Запись);
		КонецЕсли;
	КонецЦикла;
	Кэш.Загружены = Истина;
	
	// Итог показан или запуск остановлен в другом сеансе пользователя
	Пропавшие = Новый Массив;
	Для Каждого Элемент Из Кэш.Записи Цикл
		Если Актуальные.Получить(Элемент.Ключ) = Неопределено Тогда
			Пропавшие.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	Форма = ФормаEi();
	Для Каждого Запись Из Пропавшие Цикл
		Кэш.Записи.Удалить(Запись.Ид);
		Если Форма <> Неопределено Тогда
			ОбновитьСтроки(Форма, Запись);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Запуск варианта строки, известный клиенту.
//
// Параметры:
//  КлючСтроки - УникальныйИдентификатор, Строка - КлючНастроек строки набора
//  ИмяВарианта - Строка
//
// Возвращаемое значение:
//  Структура, Неопределено - запись фонового запуска, см. ФоновоеВыполнениеВызовСервера_Ei.Записи
//
Функция ЗаписьВарианта(КлючСтроки, ИмяВарианта)
	
	Запись = Неопределено;
	Для Каждого Элемент Из Кэш().Записи Цикл
		Если Элемент.Значение.КлючСтроки = Строка(КлючСтроки) И Элемент.Значение.ИмяВарианта = ИмяВарианта Тогда
			Запись = Элемент.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Запись;
	
КонецФункции

Функция ЕстьВыполняющиеся()
	
	Есть = Ложь;
	Для Каждого Элемент Из Кэш().Записи Цикл
		Если Элемент.Значение.Состояние = Состояния().Выполняется Тогда
			Есть = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Есть;
	
КонецФункции

Функция ВыполняетсяВСтроке(СтрокаНабора)
	
	Есть = Ложь;
	Для Каждого Элемент Из Кэш().Записи Цикл
		Если Элемент.Значение.КлючСтроки = Строка(СтрокаНабора.КлючНастроек)
			И Элемент.Значение.Состояние = Состояния().Выполняется Тогда
			Есть = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Есть;
	
КонецФункции

// Почему вариант нельзя запустить в фоне.
//
// Параметры:
//  ТекД - ДанныеФормыЭлементДерева - строка набора
//  Вариант - ОбщийМодуль - модуль варианта
//  Инструкция - Строка - текст варианта или выделенный фрагмент
//
// Возвращаемое значение:
//  Строка - пустая, если запустить можно
//
Функция ПричинаОтказа(ТекД, Вариант, Инструкция)
	
	Причина 	= "";
	Свойства 	= Вариант.Свойства();
	Запись 		= ЗаписьВарианта(ТекД.КлючНастроек, Свойства.Имя);
	Если Не ФоновоеВыполнениеКлиентСервер_Ei.ВариантВыполняетсяВФоне(Свойства) Тогда
		Причина = СтрШаблон(НСтр("ru = 'Вариант %1 не выполняется в фоне: в фоне выполняются запрос, алгоритм и процессы'"), Свойства.Синоним);
	ИначеЕсли ЗапросыMCPКлиент_Ei.ИдентификаторЗапуска(ТекД, Вариант) <> Неопределено Тогда
		Причина = НСтр("ru = 'Строка ждет ответа MCP: выполните ее обычным запуском, чтобы результат ушел в MCP'");
	ИначеЕсли Не ЗначениеЗаполнено(Инструкция) Тогда
		Причина = СтрШаблон(НСтр("ru = 'Текст варианта %1 пуст'"), Свойства.Синоним);
	ИначеЕсли Запись <> Неопределено И Запись.Состояние = Состояния().Выполняется Тогда
		Причина = СтрШаблон(НСтр("ru = '%1 уже выполняется в фоне'"), ПредставлениеЗапуска(Запись));
	КонецЕсли;
	
	Возврат Причина;
	
КонецФункции

#КонецОбласти

#Область Отображение

// Обновляет значки вариантов в строках с ключом запуска, у текущей строки - и закладки вариантов.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  Запись - Структура - запись фонового запуска, см. ФоновоеВыполнениеВызовСервера_Ei.Записи
//
Процедура ОбновитьСтроки(Форма, Запись)
	
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Для Каждого СтрокаНабора Из СтрокиЗаписи(Форма, Запись) Цикл
		Если ТекД <> Неопределено И СтрокаНабора.ПолучитьИдентификатор() = ТекД.ПолучитьИдентификатор() Тогда
			ВариантыКлиент_Ei.ОбновитьЗаголовки(Форма, ТекД);
		Иначе
			СтрокаНабора[НаборВариантовКлиентСервер_Ei.ИмяКолонкиСимволов()] = ВариантыКлиент_Ei.СимволыВариантов(Форма, СтрокаНабора);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Обновляет время выполнения в колонке значков дерева наборов у строк с выполняющимися запусками.
// Меняет только данные дерева и только при изменении значения: элементы формы не трогает, см. ПроверитьВыполнение
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//
Процедура ОбновитьВремяВДереве(Форма)
	
	ИмяКолонки = НаборВариантовКлиентСервер_Ei.ИмяКолонкиСимволов();
	Для Каждого Элемент Из Кэш().Записи Цикл
		Если Элемент.Значение.Состояние <> Состояния().Выполняется Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаНабора Из СтрокиЗаписи(Форма, Элемент.Значение) Цикл
			Значки = ВариантыКлиент_Ei.СимволыВариантов(Форма, СтрокаНабора);
			Если СтрокаНабора[ИмяКолонки] <> Значки Тогда
				СтрокаНабора[ИмяКолонки] = Значки;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Время выполнения для колонки значков дерева наборов: с точностью до секунды, М:СС, с часа - Ч:ММ:СС.
//
// Параметры:
//  Миллисекунды - Число
//
// Возвращаемое значение:
//  Строка
//
Функция ИдущееВремя(Миллисекунды)
	
	Секунды 		= Цел(Макс(0, Миллисекунды) / 1000);
	Минуты 			= Цел(Секунды / 60);
	Часы 			= Цел(Минуты / 60);
	ФорматДвухЦифр 	= "ЧЦ=2; ЧН=00; ЧВН=";
	Если Часы > 0 Тогда
		Время = СтрШаблон("%1:%2:%3", Формат(Часы, "ЧГ="), Формат(Минуты - Часы * 60, ФорматДвухЦифр),
			Формат(Секунды - Минуты * 60, ФорматДвухЦифр));
	Иначе
		Время = СтрШаблон("%1:%2", Формат(Минуты, "ЧН=0; ЧГ="), Формат(Секунды - Минуты * 60, ФорматДвухЦифр));
	КонецЕсли;
	
	Возврат Время;
	
КонецФункции

// Оповещение о завершении запуска, по нажатию - строка запуска в Ei, см. ОткрытьЗапуск
//
// Параметры:
//  Запись - Структура - запись фонового запуска, см. ФоновоеВыполнениеВызовСервера_Ei.Записи
//
Процедура ОповеститьОЗавершении(Запись)
	
	// Заголовок значками, как в дереве наборов: строка, символ варианта и состояние, например Ei817 ✎✓
	Заголовок 		= ПредставлениеЗапуска(Запись) + ОтметкаСостояния(Запись.Состояние);
	Длительность 	= ОбщегоНазначенияКлиент_Ei.ФорматироватьВремя(Запись.Длительность);
	Если Запись.Состояние = Состояния().Выполнено Тогда
		Пояснение = СтрШаблон(НСтр("ru = 'за %1: %2'"), Длительность, Запись.ПредставлениеРезультата);
	ИначеЕсли Запись.Состояние = Состояния().Остановлено Тогда
		Пояснение = СтрШаблон(НСтр("ru = 'остановлено через %1'"), Длительность);
	Иначе
		Пояснение = СокрЛП(СтрПолучитьСтроку(Запись.Ошибка, 1));
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(Заголовок, Новый ОписаниеОповещения("ОткрытьЗапуск", ФоновоеВыполнениеКлиент_Ei, ДанныеПерехода(Запись)),
		Лев(Пояснение, 200), КартинкаОповещения(), СтатусОповещенияПользователя.Информация, Запись.Ид);
	
КонецПроцедуры

// Строка и вариант запуска для перехода по нажатию на оповещение: запись к нажатию может быть уже удалена,
// когда ее итог показан, а перейти к строке нужно все равно, см. ОткрытьЗапуск
//
// Параметры:
//  Запись - Структура - запись фонового запуска, см. ФоновоеВыполнениеВызовСервера_Ei.Записи
//
// Возвращаемое значение:
//  Структура:
//   * КлючСтроки - Строка
//   * ИмяВарианта - Строка
//   * ИмяНабора - Строка
//
Функция ДанныеПерехода(Запись)
	
	Переход = Новый Структура;
	Переход.Вставить("КлючСтроки", 		Строка(Запись.КлючСтроки));
	Переход.Вставить("ИмяВарианта", 	Строка(Запись.ИмяВарианта));
	Переход.Вставить("ИмяНабора", 		Строка(Запись.ИмяНабора));
	
	Возврат Переход;
	
КонецФункции

// Строка и вариант запуска значками, как в дереве наборов: Ei817 ✎
//
// Параметры:
//  Запись - Структура - запись фонового запуска, см. ФоновоеВыполнениеВызовСервера_Ei.Записи
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеЗапуска(Запись)
	
	Возврат СтрШаблон("%1 %2", Запись.ИмяНабора, ВариантыКлиент_Ei.СимволВарианта(Запись.ИмяВарианта));
	
КонецФункции

// Строки открытого набора с ключом строки запуска: строка с тем же ключом может встречаться и в подстроках.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  Запись - Структура - запись фонового запуска, см. ФоновоеВыполнениеВызовСервера_Ei.Записи
//
// Возвращаемое значение:
//  Массив из ДанныеФормыЭлементДерева
//
Функция СтрокиЗаписи(Форма, Запись)
	
	Возврат ОбщегоНазначенияКлиентСервер_Ei.НайтиВКоллекцииДерева(Новый Структура("КлючНастроек", Запись.КлючСтроки),
		НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма));
	
КонецФункции

#КонецОбласти

#Область Форма

Процедура УстановитьДоступность(Форма, ИмяЭлемента, Доступность)
	
	Элемент = Форма.Элементы.Найти(ИмяЭлемента);
	Если Элемент <> Неопределено И Элемент.Доступность <> Доступность Тогда
		Элемент.Доступность = Доступность;
	КонецЕсли;
	
КонецПроцедуры

// Таблица параметров только для просмотра и недоступные команды, меняющие параметры.
// Только свойства, не влияющие на раскладку: смена видимости сбрасывает размеры областей, заданные пользователем.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  Заблокировать - Булево
//
Процедура ОбновитьБлокировкуПараметров(Форма, Заблокировать)
	
	Таблица = ПараметрыКлиент_Ei.КоллекцияПараметров(Форма);
	Если Таблица <> Неопределено И Таблица.ТолькоПросмотр <> Заблокировать Тогда
		Таблица.ТолькоПросмотр = Заблокировать;
	КонецЕсли;
	
	Кнопки = СтрРазделить("КППолучитьПараметрыТекстаЗапроса,КППараметрыУстановитьПериод,КППараметрыВСписок,КПППараметрыИзБуфера,"
		+ "КМПолучитьПараметрыТекстаЗапроса,КМПараметрыВСписок,КМПараметрыУстановитьПериод,ДеревоЗапросовПараметрыЗапросаИсторияПараметра", ",");
	Для Каждого ИмяКнопки Из Кнопки Цикл
		УстановитьДоступность(Форма, ИмяКнопки, Не Заблокировать);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПодключитьПроверку(Форма)
	
	Форма.ПодключитьОбработчикОжидания("ПроверитьФоновоеВыполнение", 1, Ложь);
	
КонецПроцедуры

Функция ФормаEi()
	
	Возврат КонструкторКлиент_Ei.ОткрытаяФормаEi();
	
КонецФункции

// Открытая форма Ei, закрытая открывается так же, как ее открывает клиентский агент MCP.
// Открытую форму находит см. ФормаEi
//
// Возвращаемое значение:
//  ФормаКлиентскогоПриложения, Неопределено - Неопределено, если форма не открылась
//
Функция ОткрытьФормуEi()
	
	Форма = ФормаEi();
	Если Форма = Неопределено Тогда
		Форма = ОткрытьФорму("ОбщаяФорма.Ei");
		Если Форма <> Неопределено И Форма.Открыта() Тогда
			ОбщийМодульКлиентПовтИсп_Ei.Формы().Вставить("Ei", Форма);
		Иначе
			Форма = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Форма;
	
КонецФункции

#КонецОбласти

#Область Константы

Функция Кэш()
	Возврат ОбщийМодульКлиентПовтИсп_Ei.ФоновоеВыполнение();
КонецФункции

Функция КартинкаОповещения()
	Возврат ОбщегоНазначенияКлиент_Ei.КартинкаОповещения();
КонецФункции

Функция Состояния()
	Возврат ФоновоеВыполнениеКлиентСервер_Ei.Состояния();
КонецФункции

// Раз во сколько секунд открытая форма Ei сверяет фоновые запуски с сервером.
Функция ИнтервалСверки()
	Возврат 10;
КонецФункции

#КонецОбласти


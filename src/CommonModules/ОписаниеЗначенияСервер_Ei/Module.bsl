// Функция - Переопределить значение, производит распаковку значения из кеша или из хранилища, при вызове с клиента безопасно только приводить результирующеее значение к Типу доступному на клиенте
//
// Параметры:
//  Значение		 - Произвольное	 - Искомое значение, которое 
//  ТипПриведения	 - Описание типов - Описание типов в которому преобразовывается значение
// 
// Возвращаемое значение:
//   - Произволное, преобразованное - распакованное значение
//
Функция ПереопределитьЗначение(Значение,ТипПриведения =  Неопределено) Экспорт
	Перем Ссылка;
	Результат = Значение;
	Если ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") И Значение.Свойство("Ссылка",Ссылка) Тогда
		Если Ссылка = Неопределено Тогда
			Результат = Значение.Значение; //это обычное значение, так могут использоваться в серверном потоке
		ИначеЕсли ЭтоАдресВременногоХранилища(Ссылка) Тогда 
			Результат = ПолучитьИзВременногоХранилища(Ссылка);
		ИначеЕсли ОбщийМодульВызовСервера_Ei.ЭтоАдресКешаЗначений(Ссылка)  Тогда
			Результат = ОбщийМодульВызовСервера_Ei.ПолучитьЗначениеИзКеша(Ссылка);
		КонецЕсли;	
	КонецЕсли;		
	Если Не ТипПриведения = Неопределено Тогда 
		Результат = ТипПриведения.ПривестиЗначение(Результат)	
	КонецЕсли;	
	Возврат Результат;	
КонецФункции

// Функция - Формирует струтуру описание значения, на основе переданных аргументов, некоторые аргументы доуточняются
//
// Параметры:
//  Значение				 - Произвольный	 			-  Искомое значение, которое необходимо описать или адрес значения в кеше
//  УникальныйИдентификатор	 - УникальныйИдентивикатор	-  Адрес по которому необходимо сохранить значние, в дальнешем на клиент передается уже сам адрес, а не значение
//  ОписаниеТипов			 - ОписаниеТипов	 		-  Описание типов. Исползуется для определения какой тип значения получен, если значение сохранено во временном хранилище, иногда получить его на клиенте будет невозможно
// 
// Возвращаемое значение:
//   - Фиксированная структура, именно ФИКСИРОВАННАЯ важна для совместимости с формой выбора типа.
//			
//
Функция Подготовить(ЗначениеИлиАдрес,УникальныйИдентификатор = Неопределено,Знач ОписаниеТипов = Неопределено) Экспорт
	Перем ОбъемКоллекции,ПредставлениеЗначения;
	Если ОбщийМодульКлиентСервер_Ei.ЭтоАдресКешаЗначений(ЗначениеИлиАдрес) Тогда 
		Значение 	= ПеречисленияКлиентСерверПовторноеИспользование_Ei.Значения().Получить(ЗначениеИлиАдрес);	
		Ссылка 		= ЗначениеИлиАдрес;
	Иначе
		Значение 	= ЗначениеИлиАдрес;
		Если УникальныйИдентификатор = Неопределено Тогда
			Ссылка 		= Неопределено;
		КонецЕсли;	
	КонецЕсли;	
	Если ОписаниеТипов = Неопределено Тогда
		//сформируем строковое универсальное представление типа, не все типы доступны на клиенте 
		ОписаниеТипов 	= ОбщийМодульКлиентСервер_Ei.ПолучитьИмяТипЗнч(ТипЗнч(Значение));
	КонецЕсли;
	ОбъемКоллекции(Значение,ОбъемКоллекции);
	Если Не УникальныйИдентификатор = Неопределено Тогда
		Если ТипыКлиентСерверПовтИсп_Ei.ОписаниеПримитивных().СодержитТип(ТипЗнч(Значение)) Тогда
			//тут ничего неделаем этот типо доступен везде, на клиенте на сервере и в параметрах сеанса
		ИначеЕсли ТипыКлиентСерверПовтИсп_Ei.ВсеСсылки().СодержитТип(ТипЗнч(Значение)) Тогда
			//тут ничего неделаем этот тип доступен везде, на клиенте на сервере и в параметрах сеанса		
		Иначе				
			//требуется поместить значение во временное хранилище или кэш вероятно будет использовано на клиенте
			Попытка
				//для более прогнозируемой жизни объекта попробуем поместить по указанному адресу
				Ссылка 		= ПоместитьВоВременноеХранилище(Значение, УникальныйИдентификатор);
			Исключение
				//вероятно значение мутабельное поэтому просто помещаем его в КЭШ
				Ссылка		= Новый УникальныйИдентификатор; //переданный уникальный идентифкато не используем поскольку там м.б. НЕ уникальный идентифкатор формы
				ПеречисленияКлиентСерверПовторноеИспользование_Ei.Значения().Вставить(Ссылка,Значение);
			КонецПопытки;
			ПредставлениеЗначения		= ПолучитьПредставление(Значение);	
			Значение					= Неопределено;
		КонецЕсли;	
	КонецЕсли;	
	Результат = Новый ФиксированнаяСтруктура("ОписаниеТипов,Значение,Ссылка,ПредставлениеЗначения,ОбъемКоллекции",ОписаниеТипов,Значение,Ссылка,ПредставлениеЗначения,ОбъемКоллекции);
	Возврат Результат;
КонецФункции

Функция ПолучитьПредставление(Значение)
	Перем Представление;
	Тип						= ТипЗнч(Значение);
	ОбработчикРезультата 	= РезультатыКлиентСерверПовтИсп_Ei.ПолучитьРезультаты().Получить(ОбщийМодульКлиентСервер_Ei.ПолучитьИмяТипЗнч(Тип));
	Если Не ОбработчикРезультата = Неопределено Тогда
		Размерность  = ОбработчикРезультата.ОпределитьРазмерность(Значение);
		Если ЗначениеЗаполнено(Размерность) Тогда
			Представление = Строка(Тип)+Символы.НПП+"("+Размерность+")";
		Иначе
			Представление = Строка(Тип);
		КонецЕсли;		
	ИначеЕсли Тип = Тип("РезультатЗапроса") Тогда
		Выборка = Значение.Выбрать();
		Представление = Строка(Тип)+Символы.НПП+"("+Выборка.Количество()+"/"+Значение.Колонки.Количество()+")";			
	Иначе	
		Попытка
			Представление    	= Строка(Значение);
			Если ПустаяСтрока(Представление) Тогда
				//Иногда значение не имеет представления (например результат запроса),
				//или вызывает ошибку при попытке преобразования (например пустая, выборка результата запроса)
				//тогда просто возьмем представление его типа
				//ВызватьИсключение ""; // чтобы лишний раз не останавливаться "по ошибке" закоментировал
				Представление  	= Строка(Тип)
			КонецЕсли;	
		Исключение		
			Представление  	= Строка(Тип);
		КонецПопытки;
	КонецЕсли;	
	Возврат Представление; 
КонецФункции

// Процедура - Рассчитываем объем коллекции для значения
//
// Параметры:
//  Значение		 - Произвольное значение	 - Значение для которого нужно получить объем 
//  ОбъемКоллекции	 - Число,Неопределено	 - Возвращаемый параметр
//
Процедура ОбъемКоллекции(Значение,ОбъемКоллекции) Экспорт
	Попытка 
		ОбъемКоллекции = Значение.Количество();
	Исключение
	КонецПопытки;	
КонецПроцедуры	

Функция ЗначениеСуществует(ОписаниеЗначения) Экспорт
	Результат = Ложь;
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ОписаниеЗначения) Тогда
		Если ЭтоАдресВременногоХранилища(ОписаниеЗначения.Ссылка) Тогда 
			//пока проверить адрес только можно достав из него значени и поместив снова
			Попытка
				ПоместитьВоВременноеХранилище(ПолучитьИзВременногоХранилища(ОписаниеЗначения.Ссылка),ОписаниеЗначения.Ссылка);
				Результат =  Истина;
			Исключение
			КонецПопытки;		
		ИначеЕсли ОбщийМодульВызовСервера_Ei.ЭтоАдресКешаЗначений(ОписаниеЗначения.Ссылка)  Тогда
			Результат = Не (ОбщийМодульВызовСервера_Ei.ПолучитьЗначениеИзКеша(ОписаниеЗначения.Ссылка) = Неопределено);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции	
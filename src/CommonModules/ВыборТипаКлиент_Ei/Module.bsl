//Вызывается при начале выборе типа или значения
//Параметры:
//	Элемент					-<ЭлементУправления>. Элемент, в котором производим выбор
//	СтандартнаяОбработка    -<Булево>. признак испольлзования стандартной обработки
//
Процедура НачалоВыбора(ВладелецФормы,Элемент,Параметры,СтандартнаяОбработка) Экспорт
	РежимОткрытияОкна = ?(ОбщийМодульКлиентСервер_Ei.Версия8315иСтарше(),РежимОткрытияОкнаФормы.БлокироватьОкноВладельца,РежимОткрытияОкнаФормы.Независимый);
	Если ТипЗнч(Параметры.ТекущиеДанные.ЗначениеПараметра) = Тип("Неопределено") Тогда  // 
		СтандартнаяОбработка = Ложь;
		ОткрытьФорму(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеФормы().ВыборТипа,Параметры,ВладелецФормы,,,,,РежимОткрытияОкна);
	Иначе
		Если Параметры.ТекущиеДанные.ЭтоВыражение Тогда
			СтандартнаяОбработка		= Ложь;
			//пытыемся найти выражение в окне выбора типа
			ОткрытьФорму(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеФормы().ВыборТипа,Параметры,ВладелецФормы,,,,,РежимОткрытияОкна);
			//ПодключитьОбработчикОжидания("OO_ВыборВыражения",0.2,Истина);
		Иначе
			//ПРОВЕРКА НА ФАЙЛ
			Если ТипЗнч(Параметры.ТекущиеДанные.ЗначениеПараметра)=Тип("Строка") Тогда
				СтандартнаяОбработка	= Ложь;
				Файл 	= Новый Файл(Параметры.ТекущиеДанные.ЗначениеПараметра);
				Если ЗначениеЗаполнено(Файл.ПолноеИмя) Тогда 	
					Файл.НачатьПроверкуСуществования(Новый ОписаниеОповещения("ОО_ПроверкаСуществованияФайла",ВыборТипаКлиент_Ei,Новый Структура("ПолноеИмя,ВладелецФормы",Файл.ПолноеИмя,ВладелецФормы)));
				Иначе		
					ПоказатьДиалог(,ВладелецФормы);
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

Процедура ОО_ПроверкаСуществованияФайла(Результат,ДопПараметры) Экспорт
	ПолноеИмя = ?(Результат,ДопПараметры.ПолноеИмя,"");
	ПоказатьДиалог(ПолноеИмя,ДопПараметры.ВладелецФормы); 	
КонецПроцедуры

Процедура ОО_ЗавершениеВыбораФайла(ВыбранныеФайлы,ДопПараметры) Экспорт
	Если Не ВыбранныеФайлы = Неопределено Тогда
		Если ВыбранныеФайлы.Количество() > 1 Тогда
			сзНовый = Новый СписокЗначений;
			сзНовый.ЗагрузитьЗначения(ВыбранныеФайлы);
			ВыбранноеЗначение = сзНовый;
		КонецЕсли;	
		Для Каждого сИмяФайла ИЗ ВыбранныеФайлы	Цикл
			ВыбранноеЗначение = сИмяФайла;
		КонецЦикла;
		ДопПараметры.ВладелецФормы.ОбработкаВыбора_ВыборТипа(ВыбранноеЗначение)
	КонецЕсли;	
КонецПроцедуры	

Процедура ПоказатьДиалог(ПолноеИмя="",ВладелецФормы)
	Длг 				= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Длг.ПолноеИмяФайла 	= ПолноеИмя;
	Длг.Заголовок 		= "Укажите путь к файлу или папке";
	Длг.Фильтр 			= "Все файлы (*.*)|*.*";;
	Длг.Показать(Новый ОписаниеОповещения("ОО_ЗавершениеВыбораФайла",ВыборТипаКлиент_Ei,Новый Структура("ВладелецФормы",ВладелецФормы)));
КонецПроцедуры


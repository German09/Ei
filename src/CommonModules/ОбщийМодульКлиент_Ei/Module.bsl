//Функция расчтывает значение на встроенном языке
//Параметры:
//	СлужебныеДанные		- <Структура>. Данные определяюшие вычсление(выполнение) значения:(Выражение,ОписаниеТипов)
//	Параметры			- <Структура>. Структура достпных параметров.		
//	ЭтаФорма			- <Форма>. Обычно конструктор запроса. Достпуны другие переменные(РезультатЗапроса,ИндексСтроки,КоличествоСтрок)
///////////////		Групповая обработка
//	Объект 				- <Произвольный объект>. Обрабатываемый объект, в контексте групповой обработки
//	ТекущиеДанные 		- <Строка таблицы(дерева) значений>. Текущие данные строки результатов запроса, в контексте групповой обработки
//	СтрокаТЧ 			- <СтрокаТабличнойЧасти>. Строка табличной части объекта в случае обработки ТЧ документа,
//	Запись				- <ЗаписьРегистра>. Элемент коллекции набора записей в случае обработки набора записей
//	ЗагружаемыйОбъект	- <СсылочныйОбъект>. Загружаемый текущей обработкой ссылочный элемент  http://code.google.com/p/enterprise-integrator/issues/detail?id=42
//
Функция __ВычислитьЗначение(СлужебныеДанные,Параметры=Неопределено,ЭтаФорма=Неопределено,Объект=Неопределено,ТекущиеДанные=Неопределено,СтрокаТЧ=Неопределено, Запись=Неопределено,__Сообщать = Истина, ЗагружаемыйОбъект = Неопределено) Экспорт
	СообщениеОтладки	= ОбщийМодульВызовСервера_Ei.вПолучитьОписаниеВыражения(СлужебныеДанные,Новый Структура("Параметры,ЭтаФорма,Объект,ТекущиеДанные,СтрокаТЧ,Запись,ЗагружаемыйОбъект",Параметры,ЭтаФорма,Объект,ТекущиеДанные,СтрокаТЧ,Запись,ЗагружаемыйОбъект));
	СобытиеОтладкиВыч	= ДобавитьСобытие("Вычисление "+СообщениеОтладки,"Встроенный язык",,Ложь); //вычисление некогда не сообщаем поскольку придет сообщение о выполнении елси будет ошибка
	ОшибкаВычисления	= Неопределено;
	Попытка
		Если Не ПустаяСтрока(СлужебныеДанные.Выражение) Тогда
			Значение = ОбщийМодульВызовСервера_Ei.__ВычислитьЗначение(СлужебныеДанные,Параметры,ЭтаФорма,Объект,ТекущиеДанные,СтрокаТЧ, Запись, ЗагружаемыйОбъект);	
		Иначе
			Значение = Неопределено;
		КонецЕсли;	
	Исключение
		Если ТипЗнч(ИнформацияОбОшибке().Причина) =  Тип("ИнформацияОбОшибке") Тогда
			ОшибкаВычисления = ИнформацияОбОшибке().Причина;
		Иначе	
			ОшибкаВычисления = ИнформацияОбОшибке();
		КонецЕсли;	
	КонецПопытки;
	Если ОшибкаВычисления	= Неопределено Тогда
		СобытиеОтладки = СобытиеОтладкиВыч;	
	Иначе	
		ЗавершитьСобытие(СобытиеОтладкиВыч,"ОченьВажное",ОшибкаВычисления);
		//попробуем выполнить
		СобытиеОтладки		= ДобавитьСобытие("Выполнение "+СообщениеОтладки,"Встроенный язык",СобытиеОтладкиВыч,__Сообщать);
		Попытка
			Значение	= ОбщийМодульВызовСервера_Ei.__ВыполнитьЗначение(СлужебныеДанные,ЭтаФорма,Параметры,Объект,ТекущиеДанные,СтрокаТЧ,Запись);
		Исключение
			Если ТипЗнч(ИнформацияОбОшибке().Причина) 			=  Тип("ИнформацияОбОшибке") Тогда
				//это ошибка в запросе, остальное не интересно
				сДополнениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке().Причина);
				ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке().Причина);
			Иначе
				сДополнениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке());
			КонецЕсли;	
			ВызватьИсключение сДополнениеОшибки;
			//ВызватьИсключение "Не удалось вычислить и выполнить выражение на встроенном языке";
		КонецПопытки;	
	КонецЕсли;
	ЗавершитьСобытие(СобытиеОтладки,"Информация","Результат = "+Строка(Значение)+ПеречисленияКлиентСерверПовторноеИспользование_Ei.ОтладкаПризнакИсключения());
	Возврат  Значение;
КонецФункции

Процедура __ПриОткрытии(Форма) Экспорт
	//Регистрируем открытую форму в объязательном порядке регистрируются интерактивные(не прикрепленные) формы и формы с динамическими табличными частями
	ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы().Вставить(СтрРазделить(Форма.ИмяФормы,".")[3],Форма);	
КонецПроцедуры

Функция ДобавитьСобытие(Действие,ТипСобытия = Неопределено,Родитель = Неопределено,Сообщать = Истина) Экспорт 
	ТипСобытия = ?(Не ТипСобытия = Неопределено, ТипСобытия, ПеречисленияКлиентСерверПовторноеИспользование_Ei.ОтладкаТипыСобытий().Общие);
	Если Не ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы(),"Отладка") Тогда
		ИнициализацияОтладки();		
	КонецЕсли;	
	Возврат ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы().Отладка.ДобавитьСобытие(Действие,ТипСобытия,Родитель,Сообщать);
КонецФункции

Процедура ЗавершитьСобытие(Событие,Статус = Неопределено,Знач СообщениеОбОшибке="") Экспорт
	Статус 	= ?(Не Статус = Неопределено, Статус, ПеречисленияКлиентСерверПовторноеИспользование_Ei.ОтладкаСтатусСообщения().БезСтатуса);
	Если Не ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы(),"Отладка") Тогда
		ИнициализацияОтладки();		
	КонецЕсли;
	ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы().Отладка.ЗавершитьСобытие(Событие,Статус,СообщениеОбОшибке);	
КонецПроцедуры


Процедура ИнициализацияОтладки() Экспорт
	ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы().Вставить("Отладка",	ПолучитьФорму(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеФормы().Отладка));	//была указана форма констркутора, убрал, когда перенес во ОМ	
КонецПроцедуры	


Процедура ОткрытьФормуОтладки(ДопПараметр) Экспорт
	ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы().Отладка.Открыть();
	Если ТипЗнч(ДопПараметр) = Тип("Число") Тогда
		ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы().Отладка.Элементы.ДеревоСообщений.ТекущаяСтрока = ДопПараметр; 	
	КонецЕсли;	
КонецПроцедуры	

// Функция - Закрепляет форму относительно экрана
//
// Параметры:
//  Форма			 - Форма - Закрепляемая форма
//  РежимЗакрепления - Число - Определяет режим закрепления 3 - Снизу, 5 - справа
// 
// Возвращаемое значение:
//   - Булево. Признак того что форма ожидаемо закреплена
//
Процедура ЗакрепитьФорму(Форма,РежимЗакрепления) Экспорт 
    WSHShell = Новый COMОбъект("WScript.Shell");
    WSHShell.SendKeys("%");
	Если ОбщийМодульКлиентСервер_Ei.Версия8315иСтарше() Тогда
	    WSHShell.SendKeys("{UP 6}");
	Иначе	
		WSHShell.SendKeys("{DOWN 5}");
	КонецЕсли;	
	WSHShell.SendKeys("{RIGHT}");
	WSHShell.SendKeys("{UP "+РежимЗакрепления+"}"); 
	WSHShell.SendKeys("{ENTER}");
КонецПроцедуры

// Функция - Отключает поиск на форме
//
// Параметры:
//  Форма			 - Форма - Форма где отключаем поиск
// 
// Возвращаемое значение:
//   - Булево. Признак того что отбор отключен
//
Функция ОтключитьПоиск(Форма) Экспорт
	Результат = Форма.ВводДоступен(); 
	Если Результат Тогда
	    WSHShell = Новый COMОбъект("WScript.Shell");
	    WSHShell.SendKeys("^+й");
		WSHShell.SendKeys("^+q");
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Функция - Получить часть данных в виде структуры
//
// Параметры:
//  ПолныеДанные - Произвольные	 - Даныне содержашие свойства
//  сИменаПолей	 - Строка	 	 - Перечень свойств разделенных ","
// 
// Возвращаемое значение:
//   - Структура . Выделенные данные собранные в структуру
//
Функция ПолучитьСтруктуруДанных(ПолныеДанные,сИменаПолей) Экспорт
	ЧастьПолныхДанных = Новый Структура(сИменаПолей);
	ЗаполнитьЗначенияСвойств(ЧастьПолныхДанных,ПолныеДанные);
	Возврат ЧастьПолныхДанных;
КонецФункции	

// Выполняет запрос или пакет запросов
//
// Параметры:
//  ТекстЗапроса	 - Строка	 - Сам текст запроса
//  ПараметрыЗапроса - Структура - Параметры запроса
//  ВыполнитьПакет	 - Булево	 - Признак выполнение пакета.
//  ВключатьТекст	 - Булев0	 - Необходимость в отладке фиксирорвать текст
// 
// Возвращаемое значение:
//  Строка - Адрес в котором схоранен результат запроса
//
Функция вВыполнитьЗапрос(ТекстЗапроса,ПараметрыЗапроса,УникальныйИдентификатор,ВыполнитьПакет=Ложь,ВключатьТекст= Истина) Экспорт
	РезультатЗапроса 	= Неопределено;
	СобытиеОтладки 		= ОбщийМодульКлиент_Ei.ДобавитьСобытие("Выполнение запроса 1С"+?(ВключатьТекст,Символы.ПС+ТекстЗапроса,""),"Запрос");
    Попытка
		//Если ВыполнитьПакет Тогда
			РезультатЗапроса = ОбщийМодульВызовСервера_Ei.ВыполнитьЗапросНаСервере(ТекстЗапроса,ПараметрыЗапроса,УникальныйИдентификатор);
		//Иначе
		//	РезультатЗапроса=Запрос.Выполнить();
		//КонецЕсли;
	Исключение
		Если ТипЗнч(ИнформацияОбОшибке().Причина) 			=  Тип("ИнформацияОбОшибке") И
			 ТипЗнч(ИнформацияОбОшибке().Причина.Причина) 	=  Тип("ИнформацияОбОшибке") Тогда
			//это ошибка в запросе, остальное не интересно
			сДополнениеОшибки = ИнформацияОбОшибке().Причина.Причина.Описание;
		Иначе
			сДополнениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());	
		КонецЕсли;
		ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке());
		ВызватьИсключение "";
	КонецПопытки;
	ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
	Возврат РезультатЗапроса;
КонецФункции

// Выполняет запрос или пакет запросов
//
// Параметры:
//  ТекстЗапроса	 			- Строка	 					- Сам текст СКД
//  ПараметрыЗапроса 			- Структура 					- Параметры запроса
//  УникальныйИдентификатор	 	- Уникальный идентифкатор	 	- Уникальный идентифкатор адреса.
//  ТипГенератора	 			- Строка	 					- Тип генератора
// 
// Возвращаемое значение:
//  Строка - Адрес в котором схоранен результат запроса
//
Функция вВыполнитьСКД(ТекстСКД,ПараметрыЗапроса,УникальныйИдентификатор,ТипГенератора) Экспорт
	РезультатЗапроса 	= Неопределено;
	СобытиеОтладки 		= ОбщийМодульКлиент_Ei.ДобавитьСобытие("Выполнение СКД","Запрос");
    Попытка
		РезультатЗапроса = ОбщийМодульВызовСервера_Ei.ВыполнитьСКДНаСервере(ТекстСКД,ПараметрыЗапроса,УникальныйИдентификатор,ТипГенератора);
	Исключение
		Если ТипЗнч(ИнформацияОбОшибке().Причина) 			=  Тип("ИнформацияОбОшибке") И
			 ТипЗнч(ИнформацияОбОшибке().Причина.Причина) 	=  Тип("ИнформацияОбОшибке") Тогда
			//это ошибка в запросе, остальное не интересно
			сДополнениеОшибки = ИнформацияОбОшибке().Причина.Причина.Описание;
		Иначе
			сДополнениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());	
		КонецЕсли;
		ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке());
		ВызватьИсключение "";
	КонецПопытки;
	ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
	Возврат РезультатЗапроса;
КонецФункции
// Функция - Получить часть данных в виде структуры
//
// Параметры:
//  ПолныеДанные - Произвольные	 - Даныне содержашие свойства
//  сИменаПолей	 - Строка	 	 - Перечень свойств разделенных ","
// 
// Возвращаемое значение:
//   - Структура . Выделенные данные собранные в структуру
//
Функция ПолучитьСтруктуруДанных(ПолныеДанные,сИменаПолей) Экспорт
	ЧастьПолныхДанных = Новый Структура(сИменаПолей);
	Если Не ПолныеДанные = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ЧастьПолныхДанных,ПолныеДанные);
	КонецЕсли;	
	Возврат ЧастьПолныхДанных;
КонецФункции	

#Область УникальностьИмен

Функция вПолучитьУникальноеИмяВКоллекции(СтрПоиска,Коллекция,сРазделитель = "", Знач Приращение = 1, Вложенные = Истина) Экспорт
	Результат 	= "";
	Найденные	= Новый Массив;
	Если ТипЗнч(Коллекция) = Тип("ДанныеФормыКоллекцияЭлементовДерева") Тогда
		Найденные = ОбщийМодульКлиентСервер_Ei.НайтиВКоллекцииДерева(СтрПоиска,Коллекция,Вложенные);
	ИначеЕсли ТипЗнч(Коллекция) = Тип("ЭлементыГрафическойСхемы") Тогда
		Найденные = Новый Массив;
		Для Каждого ЭлПоиска ИЗ СтрПоиска Цикл
			РезультатПоиска = Коллекция.Найти(ЭлПоиска.Значение);
			Если Не РезультатПоиска = Неопределено Тогда
				Найденные.Добавить(РезультатПоиска);
			КонецЕсли;
			Прервать;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Коллекция) = Тип("ДанныеФормыКоллекция") Тогда
		Найденные = Коллекция.НайтиСтроки(СтрПоиска);
	КонецЕсли;
	Для Каждого ЭлПоиска ИЗ СтрПоиска Цикл
		Если Не Найденные.Количество() Тогда
			Результат = ЭлПоиска.Значение;
		Иначе
			//имя не уникально
			чОкончание = ВыделитьЧисловоеОкончание(ЭлПоиска.Значение,сРазделитель);
			Если ЗначениеЗаполнено(чОкончание) Тогда
				СтрПоиска[ЭлПоиска.Ключ] = СтрЗаменить(ЭлПоиска.Значение,сРазделитель+Формат(чОкончание,"ЧН=0; ЧГ="),сРазделитель+Формат(чОкончание+Приращение,"ЧН=0; ЧГ="));	
			Иначе
				СтрПоиска[ЭлПоиска.Ключ] = ЭлПоиска.Значение+сРазделитель+Формат(Приращение,"ЧН=0; ЧГ=");
			КонецЕсли;
			Результат 	= вПолучитьУникальноеИмяВКоллекции(СтрПоиска,Коллекция,сРазделитель,Приращение,Вложенные);	
		КонецЕсли;
		Прервать;
	КонецЦикла;	
	Возврат Результат;
КонецФункции

Функция ВыделитьЧисловоеОкончание(Имя,сРазделитель = "")
	Результат = 0;
	Если ПустаяСтрока(сРазделитель) Тогда
		Для Ном = 1 По СтрДлина(Имя) Цикл
			Попытка
				вр = Число(Прав(Имя,Ном));
			Исключение
				Если ЗначениеЗаполнено(Прав(Имя,Ном-1)) Тогда
					Возврат Число(Прав(Имя,Ном-1));
				Иначе
					Прервать;
				КонецЕсли;	
			КонецПопытки;	
		КонецЦикла;
	Иначе
		НачалоРазделителя = СтрНайти(Имя,сРазделитель,НаправлениеПоиска.СКонца);
		Если НачалоРазделителя Тогда
			Возврат Число(Сред(Имя,НачалоРазделителя+СтрДлина(сРазделитель)));
		КонецЕсли;	
	КонецЕсли;	
	Возврат Результат; 
КонецФункции

#КонецОбласти

// Функция - получает уникальный массив объектов открытых пользователем за последние 24 часа, удобно использовать в анализе
// 
// Возвращаемое значение:
//   - Массив ссылок на объекты истории пользователя
//
Функция ПолучитьМассивИстории() Экспорт
	Результат 		= Новый Массив;
	ПоследняяДата  	= Неопределено;
	Для Каждого ЭлИстории ИЗ ИсторияРаботыПользователя.Получить() Цикл
		Если Не ПоследняяДата = Неопределено Тогда
			Если Не ЭлИстории.Дата > (ПоследняяДата-24*60*60) Тогда  // за полседние 24 часа
				Прервать;
			КонецЕсли;
		КонецЕсли;
		Попытка
			Ссылка = ОбщийМодульВызовСервера_Ei.ПолучитьСсылкуИзНавСсылки(ЭлИстории.НавигационнаяСсылка);
			Если ЗначениеЗаполнено(Ссылка) И Результат.Найти(Ссылка) = Неопределено Тогда
				Результат.Добавить(Ссылка);
				ПоследняяДата = ?(ПоследняяДата = Неопределено,ЭлИстории.Дата,ПоследняяДата);
			КонецЕсли;
		Исключение
			//могут навигационные сссылки типа http:\\
		КонецПопытки;	
	КонецЦикла;
	Возврат Результат; 
КонецФункции	

Процедура АктуализироватьСтраницу(Контейнер,ИмяСтраницы) Экспорт
	Если ЗначениеЗаполнено(ИмяСтраницы) Тогда
		НайденаяСтраница = Контейнер.ПодчиненныеЭлементы.Найти(ИмяСтраницы);
		Если Не НайденаяСтраница = Неопределено Тогда
			Контейнер.ТекущаяСтраница = НайденаяСтраница;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	

// Формирует дополнительную структуру параметров для формы выбора типа
//
// Параметры:
//  ТД	 - ДанныеФормыЭлементДерева	 - или ДанныеФормыЭлементКоллекции  в зависимости от того откуда происходит вызов 
// 
// Возвращаемое значение:
//   - Структура
//		*ТекущиеДанные - Структура
//			ИмяПараметра
//			ЗначениеПараметра
//			ЭтоВыражение
//			Идентификатор
//		*ДоступныеСтруктуры 
//			Параметры
Функция ПолучитьСтруктуруПеременных(Форма,ТД, ЗначениеПараметра = Неопределено, ИспИсторию = Истина, ИспНаборы = Истина, ИспПараметры = Истина) Экспорт 
	СтрТекущиеДанные	= Новый Структура("ЭтоВыражение,ЗначениеПараметра,ИмяПараметра",Истина,ЗначениеПараметра);
	Если Не ТД = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(СтрТекущиеДанные,ТД); 
	КонецЕсли;
	СтруктураПеременных	= Новый Структура();
	СтруктураПеременных.Вставить("ТекущиеДанные",СтрТекущиеДанные);
	СтруктураПеременных.Вставить("ДоступныеСтруктуры",ВариантыКлиент_Ei.ПолучитьСтруктуруДоступныхПеременных(Форма,Форма.ПолучитьПереопределяемыйОбъектОбработки(),ИспИсторию,ИспНаборы,ИспПараметры));	
	Возврат СтруктураПеременных; 	
КонецФункции

// Получаем все свойства объекта данных на основе таблицы результатов запроса
//
// Параметры:
//  Объект	 					- Произвольный	- 	Объект данных, свойства которого необходимо получить
//  УникальныйИдентификатор	 	- УникальныйИдентифкатор	 - Уникальный идентифкатор формы, используется для формирования описания значения, если не указан то табличные части и таблицы значений в объекте игнорируются
//
// 
// Возвращаемое значение:
//   - СписокЗначений Список значений со структурой  ОписаниеТипов,Значение
//
Функция вПолучитьСвойстваОбъектаМетаданных(Объект,УникальныйИдентификатор = Неопределено) Экспорт
	СписокСвойств	= Новый СписокЗначений;
	Если Не Объект = Неопределено Тогда
		ОписаниеЗначения 	= ОбщийМодульКлиентСервер_Ei.ПолучитьОписаниеМетаданных(Объект);
		ПолноеИмяДляЗапроса	= ОписаниеЗначения.ТипДляЗапроса+"."+ОписаниеЗначения.ПолноеИмя;
		СобытиеОтладки 	= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Получение свойств объекта метаданных "+ПолноеИмяДляЗапроса,"Объекты БД");
		Попытка
			ТекстЗапроса 		= "ВЫБРАТЬ ПЕРВЫЕ 0 _Т.* ИЗ "+ПолноеИмяДляЗапроса+" КАК _Т";    //Кудяков Г.А.  28 февраля 2013 г. 11:30:18 Issue 40
			АдресКеша			= ВыполнитьКлиентСервер_Ei.Запрос(ТекстЗапроса,Неопределено); // тут уникальный идентификатор не передаем, потому что расчитываем на возврат именно адреса Кеша					
			СписокСвойств		= ОбщийМодульВызовСервера_Ei.вСформироватьСписокПоСтруктуреКолонок(АдресКеша,Объект,УникальныйИдентификатор);
		Исключение
			ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке());
			//ВызватьИсключение "Не удалось получить свойства";
		КонецПопытки;
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	КонецЕсли;	
	Возврат СписокСвойств
КонецФункции

//возврашает форматированное время 00:00:00
//Параметры
//	Значение	- <число> Число мили.секунд, которые нужно показать пользователю	
Функция ФорматироватьВремя(Значение) Экспорт
	Если Значение>3600*24*1000 Тогда
		//переведем в дни секунды в даноом случае никчему
		Значение	= Окр(Значение);
		Минуты		= Цел(Значение/60);
		Часы		= Цел(Минуты/60);
		Дни			= Цел(Часы/24);
		Результат	= ""+Дни+"д. "+Формат(Часы-Дни*24,"ЧЦ=2; ЧН=00; ЧВН=")+":"+Формат(Минуты-Часы*60,"ЧЦ=2; ЧН=00; ЧВН=");
	ИначеЕсли Значение>3600*1000 Тогда
		//переведем  в часы и  минуты 		
		//десятый секунды в данном случае никчему 
		Значение	= Окр(Значение);
		Минуты		= Цел(Значение/60);
		Часы		= Цел(Минуты/60);
		Результат	= ""+Формат(Часы,"ЧЦ=2; ЧН=00; ЧВН=")+":"+Формат(Минуты-Часы*60,"ЧЦ=2; ЧН=00; ЧВН=")+":"+Формат(Значение-Минуты*60,"ЧЦ=2; ЧН=00; ЧВН=");
	ИначеЕсли Значение>60*1000 Тогда 
		//переведем только в минуты 		
		//десятый секунды в данном случае никчему
		Значение	= Окр(Значение);
		Минуты		= Цел(Значение/60);
		Результат	= ""+Формат(Минуты,"ЧЦ=2; ЧН=00; ЧВН=")+":"+Формат(Значение-Минуты*60,"ЧЦ=2; ЧН=00; ЧВН=");
	Иначе 
	    Результат   = ""+Значение/1000+" сек.";
	КонецЕсли;
	Возврат Результат 
КонецФункции

// Удаляет пустые строки из под строки дерева значений, необходимо для динамического формирования дерева
// 
// Параметры:
//  СтрокаДЗ 	- ДанныеФормыЭлементДерева - Строка родитель
//  ИмяКолонки 	- Строка - Имя колонки
// 
// Возвращаемое значение:
//  Число - Коло-во удаленных строк
Функция УдалитьПустыеСтроки(СтрокаДЗ,ИмяКолонки = "Представление") Экспорт
	УдалилиСтрок	= 0; 
	мУдаления 		= Новый Массив;
	Для Каждого ПодСтрока ИЗ СтрокаДЗ.ПолучитьЭлементы() Цикл
		Если Не ЗначениеЗаполнено(ПодСтрока[ИмяКолонки]) Тогда
			мУдаления.Добавить(ПодСтрока);
		КонецЕсли;
	КонецЦикла;
	УдалилиСтрок 	= мУдаления.Количество();
	Для Каждого Подстрока ИЗ мУдаления Цикл
		СтрокаДЗ.ПолучитьЭлементы().Удалить(Подстрока);		
	КонецЦикла;	
	Возврат УдалилиСтрок;
КонецФункции


// Формирует дополнительную структуру параметров для формы выбора типа
//
// Параметры:
//  ТД	 - ДанныеФормыЭлементДерева	 - или ДанныеФормыЭлементКоллекции  в зависимости от того откуда происходит вызов 
// 
// Возвращаемое значение:
//   - Структура
//		*ТекущиеДанные - Структура
//			ИмяПараметра
//			ЗначениеПараметра
//			ЭтоВыражение
//			Идентификатор
//		*ДоступныеСтруктуры 
//			Параметры
Функция ПолучитьСтруктуруПеременных(Форма,ТД, ЗначениеПараметра = Неопределено, ИспИсторию = Истина, ИспНаборы = Истина, ИспПараметры = Истина) Экспорт 
	СтрТекущиеДанные	= Новый Структура("ЭтоВыражение,ЗначениеПараметра,ИмяПараметра",Истина,ЗначениеПараметра);
	Если Не ТД = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(СтрТекущиеДанные,ТД); 
	КонецЕсли;
	СтруктураПеременных	= Новый Структура();
	СтруктураПеременных.Вставить("ТекущиеДанные",СтрТекущиеДанные);
	СтруктураПеременных.Вставить("ДоступныеСтруктуры",ВариантыКлиент_Ei.ПолучитьСтруктуруДоступныхПеременных(Форма,Форма.ПолучитьПереопределяемыйОбъектОбработки(),ИспИсторию,ИспНаборы,ИспПараметры));	
	Возврат СтруктураПеременных; 	
КонецФункции

// Получаем все свойства объекта данных на основе таблицы результатов запроса
//
// Параметры:
//  Объект	 					- Произвольный	- 	Объект данных, свойства которого необходимо получить
//  УникальныйИдентификатор	 	- УникальныйИдентифкатор	 - Уникальный идентифкатор формы, используется для формирования описания значения, если не указан то табличные части и таблицы значений в объекте игнорируются
//
// 
// Возвращаемое значение:
//   - СписокЗначений Список значений со структурой  ОписаниеТипов,Значение
//
Функция вПолучитьСвойстваОбъектаМетаданных(Объект,УникальныйИдентификатор = Неопределено) Экспорт
	СписокСвойств	= Новый СписокЗначений;
	Если Не Объект = Неопределено Тогда
		ОписаниеЗначения 	= ОбщийМодульКлиентСервер_Ei.ПолучитьОписаниеМетаданных(ТипЗнч(Объект));
		ПолноеИмяДляЗапроса	= ОписаниеЗначения.ТипДляЗапроса+"."+ОписаниеЗначения.ПолноеИмя;
		СобытиеОтладки 	= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Получение свойств объекта метаданных "+ПолноеИмяДляЗапроса,"Объекты БД");
		Попытка
			ТекстЗапроса 		= "ВЫБРАТЬ ПЕРВЫЕ 0 _Т.* ИЗ "+ПолноеИмяДляЗапроса+" КАК _Т";    //Кудяков Г.А.  28 февраля 2013 г. 11:30:18 Issue 40
			АдресКеша			= ВыполнитьКлиентСервер_Ei.Запрос(ТекстЗапроса,Неопределено); // тут уникальный идентификатор не передаем, потому что расчитываем на возврат именно адреса Кеша					
			СписокСвойств		= ОбщийМодульВызовСервера_Ei.вСформироватьСписокПоСтруктуреКолонок(АдресКеша,Объект,УникальныйИдентификатор);
		Исключение
			ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке());
			//ВызватьИсключение "Не удалось получить свойства";
		КонецПопытки;
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	КонецЕсли;	
	Возврат СписокСвойств
КонецФункции

// Получает форматированное время 00:00:00
// 
// Параметры:
//  Значение - Число - Число мили.секунд, которые нужно показать пользователю
// 
// Возвращаемое значение:
//  Строка 
Функция ФорматироватьВремя(Значение) Экспорт
	Множитель 	= 1000;
	стрФормата	= "ЧЦ=2; ЧН=00; ЧВН=";
	Если Значение>3600*24*Множитель Тогда
		//переведем в дни секунды в даноом случае ни к чему
		Значение	= Окр(Значение);
		Минуты		= Цел(Значение/60/Множитель);
		Часы		= Цел(Минуты/60/Множитель);
		Дни			= Цел(Часы/24/Множитель);
		Результат	= ""+Дни+"д. "+Формат(Часы-Дни*24,стрФормата)+":"+Формат(Минуты-Часы*60/Множитель,стрФормата);
	ИначеЕсли Значение>3600*Множитель Тогда
		//переведем  в часы и  минуты 		
		//десятый секунды в данном случае ни к чему 
		Значение	= Окр(Значение);
		Минуты		= Цел(Значение/60/Множитель);
		Часы		= Цел(Минуты/60/Множитель);
		Результат	= ""+Формат(Часы,стрФормата)+":"+Формат(Минуты-Часы*60,стрФормата)+":"+Формат(Значение-Минуты*60/Множитель,стрФормата);
	ИначеЕсли Значение>60*Множитель Тогда 
		//переведем только в минуты 		
		//десятый секунды в данном случае ни к чему
		Значение	= Окр(Значение);
		Минуты		= Цел(Значение/60/Множитель);
		Результат	= ""+Формат(Минуты,стрФормата)+":"+Формат(Значение-Минуты*60/Множитель,стрФормата);
	Иначе 
	    Результат   = ""+Значение/Множитель+" сек.";
	КонецЕсли;
	Возврат Результат 
КонецФункции

// Удаляет пустые строки из под строки дерева значений, необходимо для динамического формирования дерева
// 
// Параметры:
//  СтрокаДЗ 	- ДанныеФормыЭлементДерева - Строка родитель
//  ИмяКолонки 	- Строка - Имя колонки
// 
// Возвращаемое значение:
//  Число - Коло-во удаленных строк
Функция УдалитьПустыеСтроки(СтрокаДЗ,ИмяКолонки = "Представление") Экспорт
	УдалилиСтрок	= 0; 
	мУдаления 		= Новый Массив;
	Для Каждого ПодСтрока ИЗ СтрокаДЗ.ПолучитьЭлементы() Цикл
		Если Не ЗначениеЗаполнено(ПодСтрока[ИмяКолонки]) Тогда
			мУдаления.Добавить(ПодСтрока);
		КонецЕсли;
	КонецЦикла;
	УдалилиСтрок 	= мУдаления.Количество();
	Для Каждого Подстрока ИЗ мУдаления Цикл
		СтрокаДЗ.ПолучитьЭлементы().Удалить(Подстрока);		
	КонецЦикла;	
	Возврат УдалилиСтрок;
КонецФункции

Функция ИмяКлючаКартинки() Экспорт
	Возврат "КартинкаСсылка_Ei";	
КонецФункции
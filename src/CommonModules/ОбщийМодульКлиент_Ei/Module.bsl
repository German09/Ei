#Область ФункцииВыполненияВычисления

// Выполняет запрос или пакет запросов
//
// Параметры:
//  ТекстЗапроса	 			- Строка	 - Сам текст запроса
//  ПараметрыЗапроса 			- Структура - Параметры запроса
//  УникальныйИдентификатор	 	- УникальныйИдентифкатор	- Уникальный идентифкатор формы
// 
// Возвращаемое значение:
//   -  Структура описания значения, формируемая СтруктурыЗначенийКлиентСервер_Ei.ПолучитьОписаниеЗначения()
//
Функция вВыполнитьЗапрос(ТекстЗапроса,ПараметрыЗапроса,УникальныйИдентификатор) Экспорт
	РезультатЗапроса 	= Неопределено;
	СобытиеОтладки 		= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Выполнение запроса 1С"+Символы.ПС+ТекстЗапроса,"Запрос");
    Попытка
		//Если ВыполнитьПакет Тогда
			РезультатЗапроса = ОбщийМодульВызовСервера_Ei.__ВыполнитьЗапрос(ТекстЗапроса,ПараметрыЗапроса,УникальныйИдентификатор);
		//Иначе
		//	РезультатЗапроса=Запрос.Выполнить();
		//КонецЕсли;
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		Если ТипЗнч(ИнфоОбОшибке.Причина) 			=  Тип("ИнформацияОбОшибке") И
			 ТипЗнч(ИнфоОбОшибке.Причина.Причина) 	=  Тип("ИнформацияОбОшибке") Тогда
			//это ошибка в запросе, остальное не интересно
			ИнфоОбОшибке = ИнфоОбОшибке.Причина.Причина;
		ИначеЕсли ТипЗнч(ИнфоОбОшибке.Причина) 			=  Тип("ИнформацияОбОшибке") ТОгда
			ИнфоОбОшибке = ИнфоОбОшибке.Причина;
		КонецЕсли;
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнфоОбОшибке);
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнфоОбОшибке);
	КонецПопытки;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	Возврат РезультатЗапроса;
КонецФункции

// Выполняет запрос или пакет запросов
//
// Параметры:
//  ТекстЗапроса	 			- Строка	 					- Сам текст СКД
//  ПараметрыЗапроса 			- Структура 					- Параметры запроса
//  УникальныйИдентификатор	 	- Уникальный идентифкатор	 	- Уникальный идентифкатор адреса.
//  ТипГенератора	 			- Строка	 					- Тип генератора
// 
// Возвращаемое значение:
//  Строка - Адрес в котором схоранен результат запроса
//
Функция вВыполнитьСКД(ТекстСКД,ПараметрыЗапроса,УникальныйИдентификатор,ТипГенератора,СтрРасшифровки) Экспорт
	РезультатЗапроса 	= Неопределено;
	СобытиеОтладки 		= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Выполнение СКД","Запрос");
    Попытка
		РезультатЗапроса = ОбщийМодульВызовСервера_Ei.__ВыполнитьСКД(ТекстСКД,ПараметрыЗапроса,УникальныйИдентификатор,ТипГенератора,СтрРасшифровки);
	Исключение
		Если ТипЗнч(ИнформацияОбОшибке().Причина) 			=  Тип("ИнформацияОбОшибке") И
			 ТипЗнч(ИнформацияОбОшибке().Причина.Причина) 	=  Тип("ИнформацияОбОшибке") Тогда
			//это ошибка в запросе, остальное не интересно
			сДополнениеОшибки = ИнформацияОбОшибке().Причина.Причина.Описание;
		Иначе
			сДополнениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());	
		КонецЕсли;
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке());
		ВызватьИсключение "";
	КонецПопытки;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	Возврат РезультатЗапроса;
КонецФункции

#КонецОбласти

Процедура __ПриОткрытии(Форма) Экспорт
	//Регистрируем открытую форму в объязательном порядке регистрируются интерактивные(не прикрепленные) формы и формы с динамическими табличными частями
	ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы().Вставить(СтрРазделить(Форма.ИмяФормы,".")[3],Форма);	
КонецПроцедуры

// Функция - Отключает поиск на форме
//
// Параметры:
//  Форма			 - Форма - Форма где отключаем поиск
// 
// Возвращаемое значение:
//   - Булево. Признак того что отбор отключен
//
Функция ОтключитьПоиск(Форма) Экспорт
	Результат = Форма.ВводДоступен(); 
	Если Результат Тогда
	    WSHShell = Новый COMОбъект("WScript.Shell");
	    WSHShell.SendKeys("^+й");
		WSHShell.SendKeys("^+q");
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Функция - Получить часть данных в виде структуры
//
// Параметры:
//  ПолныеДанные - Произвольные	 - Даныне содержашие свойства
//  сИменаПолей	 - Строка	 	 - Перечень свойств разделенных ","
// 
// Возвращаемое значение:
//   - Структура . Выделенные данные собранные в структуру
//
Функция ПолучитьСтруктуруДанных(ПолныеДанные,сИменаПолей) Экспорт
	ЧастьПолныхДанных = Новый Структура(сИменаПолей);
	Если Не ПолныеДанные = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ЧастьПолныхДанных,ПолныеДанные);
	КонецЕсли;	
	Возврат ЧастьПолныхДанных;
КонецФункции	

#Область УникальностьИмен

&НаКлиенте
Функция вПолучитьУникальноеИмяВКоллекции(СтрПоиска,Коллекция,сРазделитель = "", Знач Приращение = 1) Экспорт
	Результат 	= "";
	Если ТипЗнч(Коллекция) = Тип("ДанныеФормыКоллекцияЭлементовДерева") Тогда
		Найденные = НайтиВКоллекцииДерева(СтрПоиска,Коллекция);
	ИначеЕсли ТипЗнч(Коллекция) = Тип("ЭлементыГрафическойСхемы") Тогда
		Найденные = Новый Массив;
		Для Каждого ЭлПоиска ИЗ СтрПоиска Цикл
			РезультатПоиска = Коллекция.Найти(ЭлПоиска.Значение);
			Если Не РезультатПоиска = Неопределено Тогда
				Найденные.Добавить(РезультатПоиска);
			КонецЕсли;
			Прервать;
		КонецЦикла;		
	КонецЕсли;
	Для Каждого ЭлПоиска ИЗ СтрПоиска Цикл
		Если Не Найденные.Количество() Тогда
			Результат = ЭлПоиска.Значение;
		Иначе
			//имя не уникально
			чОкончание = ВыделитьЧисловоеОкончание(ЭлПоиска.Значение,сРазделитель);
			Если ЗначениеЗаполнено(чОкончание) Тогда
				СтрПоиска[ЭлПоиска.Ключ] = СтрЗаменить(ЭлПоиска.Значение,сРазделитель+Формат(чОкончание,"ЧН=0; ЧГ="),сРазделитель+Формат(чОкончание+Приращение,"ЧН=0; ЧГ="));	
			Иначе
				СтрПоиска[ЭлПоиска.Ключ] = ЭлПоиска.Значение+сРазделитель+Формат(Приращение,"ЧН=0; ЧГ=");
			КонецЕсли;
			Результат 	= вПолучитьУникальноеИмяВКоллекции(СтрПоиска,Коллекция,сРазделитель,Приращение);
		КонецЕсли;
		Прервать;
	КонецЦикла;	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция НайтиВКоллекцииДерева(СтрПоиска,КоллекцияСтрок) Экспорт
	Результат 	= Новый Массив;
	Для Каждого ЭлПоиска ИЗ СтрПоиска Цикл
		Для Каждого Строка ИЗ КоллекцияСтрок Цикл
			Если нРег(Строка[ЭлПоиска.Ключ]) = нРег(ЭлПоиска.Значение) Тогда
				Результат.Добавить(Строка);
			КонецЕсли;
			Для Каждого ВложенныйРезультат ИЗ НайтиВКоллекцииДерева(СтрПоиска,Строка.ПолучитьЭлементы()) Цикл
				Результат.Добавить(ВложенныйРезультат);		
			КонецЦикла;	
		КонецЦикла;
		Прервать;
	КонецЦикла;	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ВыделитьЧисловоеОкончание(Имя,сРазделитель = "") Экспорт
	Результат = 0;
	Если ПустаяСтрока(сРазделитель) Тогда
		Для Ном = 1 По СтрДлина(Имя) Цикл
			Попытка
				вр = Число(Прав(Имя,Ном));
			Исключение
				Если ЗначениеЗаполнено(Прав(Имя,Ном-1)) Тогда
					Возврат Число(Прав(Имя,Ном-1));
				Иначе
					Прервать;
				КонецЕсли;	
			КонецПопытки;	
		КонецЦикла;
	Иначе
		НачалоРазделителя = СтрНайти(Имя,сРазделитель,НаправлениеПоиска.СКонца);
		Если НачалоРазделителя Тогда
			Возврат Число(Сред(Имя,НачалоРазделителя+СтрДлина(сРазделитель)));
		КонецЕсли;	
	КонецЕсли;	
	Возврат Результат; 
КонецФункции


#КонецОбласти

// Функция - получает уникальный массив объектов открытых пользователем за последние 24 часа, удобно использовать в анализе
// 
// Возвращаемое значение:
//   - Массив ссылок на объекты истории пользователя
//
&НаКлиенте
Функция ПолучитьМассивИстории() Экспорт
	Результат 		= Новый Массив;
	ПоследняяДата  	= Неопределено;
	Для Каждого ЭлИстории ИЗ ИсторияРаботыПользователя.Получить() Цикл
		Если Не ПоследняяДата = Неопределено Тогда
			Если Не ЭлИстории.Дата > (ПоследняяДата-24*60*60) Тогда  // за полседние 24 часа
				Прервать;
			КонецЕсли;
		КонецЕсли;
		Попытка
			Ссылка = ОбщийМодульВызовСервера_Ei.ПолучитьСсылкуИзНавСсылки(ЭлИстории.НавигационнаяСсылка);
			Если ЗначениеЗаполнено(Ссылка) И Результат.Найти(Ссылка) = Неопределено Тогда
				Результат.Добавить(Ссылка);
				ПоследняяДата = ?(ПоследняяДата = Неопределено,ЭлИстории.Дата,ПоследняяДата);
			КонецЕсли;
		Исключение
			//могут навигационные сссылки типа http:\\
		КонецПопытки;	
	КонецЦикла;
	Возврат Результат; 
КонецФункции	

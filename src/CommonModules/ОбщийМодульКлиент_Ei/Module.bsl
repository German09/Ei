// Функция - Вычисляет/выполняет выражение на встроенном языке
//
// Параметры:
//  Выражение				 - Строка - Вычисляемое выражение
//  УникальныйИдентификатор	 - УникальныйИдентификатор	 -  Идентификатор адреса, в который нужно поместить результат вычисления
//  ОписаниеТипов			 - ОписаниеТипов - Типы, к которым будет приводится вычисленное значение
//  КонтекстВыполнения		 - Структура -
//
// Возвращаемое значение:
//   -  Структура описания значения, формируемая ОбщийМодульКлиентСервер_Ei.ПолучитьОписаниеЗначения()
//	ИЛИ
//	 - 	Уникальный идентификатор значения в Кеше сервера
//  ИЛИ
//	 -  Неопределено, если не заполнено выражение
//
Функция __ВычислитьЗначение(Выражение,УникальныйИдентификатор = Неопределено,ОписаниеТипов = Неопределено,Знач КонтекстВыполнения = Неопределено,СообщатьОбОшибке = Истина) Экспорт
	КонтекстВыполнения	= ?(КонтекстВыполнения = Неопределено, Новый Структура,КонтекстВыполнения);
	СообщениеОтладки	= ОбщийМодульВызовСервера_Ei.вПолучитьОписаниеВыражения(Выражение,ОписаниеТипов,КонтекстВыполнения);
	СобытиеОтладкиВыч	= ДобавитьСобытие("Вычисление "+СообщениеОтладки,"Встроенный язык",,Ложь); //вычисление некогда не сообщаем поскольку придет сообщение о выполнении елси будет ошибка
	ОшибкаВычисления	= Неопределено;

	Попытка
		Если Не ПустаяСтрока(Выражение) Тогда
			Значение = ОбщийМодульВызовСервера_Ei.__ВычислитьЗначение(Выражение,УникальныйИдентификатор,ОписаниеТипов,КонтекстВыполнения);
		Иначе
			Значение = Неопределено;
		КонецЕсли;	
	Исключение
		Если ТипЗнч(ИнформацияОбОшибке().Причина) =  Тип("ИнформацияОбОшибке") Тогда
			ОшибкаВычисления = ИнформацияОбОшибке().Причина;
		Иначе	
			ОшибкаВычисления = ИнформацияОбОшибке();
		КонецЕсли;	
	КонецПопытки;
	Если ОшибкаВычисления	= Неопределено Тогда
		СобытиеОтладки = СобытиеОтладкиВыч;	
	Иначе	
		ЗавершитьСобытие(СобытиеОтладкиВыч,"ОченьВажное",ОшибкаВычисления);
		//попробуем выполнить
		СобытиеОтладки		= ДобавитьСобытие("Выполнение "+СообщениеОтладки,"Встроенный язык",СобытиеОтладкиВыч,СообщатьОбОшибке);
		Попытка
			Значение = ОбщийМодульВызовСервера_Ei.__ВыполнитьВыражение(Выражение,УникальныйИдентификатор,ОписаниеТипов,КонтекстВыполнения);
		Исключение
			Если ТипЗнч(ИнформацияОбОшибке().Причина) 			=  Тип("ИнформацияОбОшибке") Тогда
				//это ошибка в запросе, остальное не интересно
				сДополнениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке().Причина);
				ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке().Причина);
			Иначе
				сДополнениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке());
			КонецЕсли;	
			ВызватьИсключение сДополнениеОшибки;
			//ВызватьИсключение "Не удалось вычислить и выполнить выражение на встроенном языке";
		КонецПопытки;	
	КонецЕсли;
	Если ОбщийМодульВызовСервера_Ei.ЭтоАдресКешаЗначений(Значение)  Тогда
		//если получен адрес кеша значений, тоесть процедуры выполнения/вычисления вернули явное значение попробуем получить это значение на клиент
		Попытка
			Результат =  ОбщийМодульВызовСервера_Ei.ПолучитьЗначениеИзКеша(Значение);
		Исключение
			//если получить его нельзя нужно формировать специальную фиксированную стрктуру описания и дальше на кленете оперировать уже только с ней
			//объязательно в параметрах указываем уникальный идентифкатор иначе попытка бессмысленна ожидать его в служебных данных не стоит. если бы он был там указан мы бы не оказались в этой обработке исключений 
			Результат =  ОбщийМодульВызовСервера_Ei.ПодготовитьОписаниеЗначенияВызовСервера(Значение,Новый УникальныйИдентификатор);
		КонецПопытки	
	Иначе
		Результат = Значение;
	КонецЕсли;	
	ЗавершитьСобытие(СобытиеОтладки,"Информация","Результат = "+Строка(Результат)+ПеречисленияКлиентСерверПовторноеИспользование_Ei.ОтладкаПризнакИсключения());
	Возврат  Результат;
КонецФункции

Процедура __ПриОткрытии(Форма) Экспорт
	//Регистрируем открытую форму в объязательном порядке регистрируются интерактивные(не прикрепленные) формы и формы с динамическими табличными частями
	ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы().Вставить(СтрРазделить(Форма.ИмяФормы,".")[3],Форма);	
КонецПроцедуры

Функция ДобавитьСобытие(Действие,ТипСобытия = Неопределено,Родитель = Неопределено,Сообщать = Истина) Экспорт 
	ТипСобытия = ?(Не ТипСобытия = Неопределено, ТипСобытия, ПеречисленияКлиентСерверПовторноеИспользование_Ei.ОтладкаТипыСобытий().Общие);
	Если Не ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы(),"Отладка") Тогда
		ИнициализацияОтладки();		
	КонецЕсли;	
	Возврат ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы().Отладка.ДобавитьСобытие(Действие,ТипСобытия,Родитель,Сообщать);
КонецФункции

Процедура ЗавершитьСобытие(Событие,Статус = Неопределено,Знач СообщениеОбОшибке="") Экспорт
	Статус 	= ?(Не Статус = Неопределено, Статус, ПеречисленияКлиентСерверПовторноеИспользование_Ei.ОтладкаСтатусСообщения().БезСтатуса);
	Если Не ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы(),"Отладка") Тогда
		ИнициализацияОтладки();		
	КонецЕсли;
	ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы().Отладка.ЗавершитьСобытие(Событие,Статус,СообщениеОбОшибке);	
КонецПроцедуры

Процедура ИнициализацияОтладки() Экспорт
	ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы().Вставить("Отладка",	ПолучитьФорму(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеФормы().Отладка));	//была указана форма констркутора, убрал, когда перенес во ОМ	
КонецПроцедуры	

Процедура ОткрытьФормуОтладки(ДопПараметр) Экспорт
	ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы().Отладка.Открыть();
	Если ТипЗнч(ДопПараметр) = Тип("Число") Тогда
		ОбщийМодульКлиентПовтороноеИспользование_Ei.Формы().Отладка.Элементы.ДеревоСообщений.ТекущаяСтрока = ДопПараметр; 	
	КонецЕсли;	
КонецПроцедуры	

// Функция - Отключает поиск на форме
//
// Параметры:
//  Форма			 - Форма - Форма где отключаем поиск
// 
// Возвращаемое значение:
//   - Булево. Признак того что отбор отключен
//
Функция ОтключитьПоиск(Форма) Экспорт
	Результат = Форма.ВводДоступен(); 
	Если Результат Тогда
	    WSHShell = Новый COMОбъект("WScript.Shell");
	    WSHShell.SendKeys("^+й");
		WSHShell.SendKeys("^+q");
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Функция - Получить часть данных в виде структуры
//
// Параметры:
//  ПолныеДанные - Произвольные	 - Даныне содержашие свойства
//  сИменаПолей	 - Строка	 	 - Перечень свойств разделенных ","
// 
// Возвращаемое значение:
//   - Структура . Выделенные данные собранные в структуру
//
Функция ПолучитьСтруктуруДанных(ПолныеДанные,сИменаПолей) Экспорт
	ЧастьПолныхДанных = Новый Структура(сИменаПолей);
	Если Не ПолныеДанные = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ЧастьПолныхДанных,ПолныеДанные);
	КонецЕсли;	
	Возврат ЧастьПолныхДанных;
КонецФункции	

// Выполняет запрос или пакет запросов
//
// Параметры:
//  ТекстЗапроса	 - Строка	 - Сам текст запроса
//  ПараметрыЗапроса - Структура - Параметры запроса
//  ВыполнитьПакет	 - Булево	 - Признак выполнение пакета.
//  ВключатьТекст	 - Булев0	 - Необходимость в отладке фиксирорвать текст
// 
// Возвращаемое значение:
//   -  Структура описания значения, формируемая СтруктурыЗначенийКлиентСервер_Ei.ПолучитьОписаниеЗначения()
//
Функция вВыполнитьЗапрос(ТекстЗапроса,ПараметрыЗапроса,УникальныйИдентификатор,ВыполнитьПакет=Ложь,ВключатьТекст= Истина) Экспорт
	РезультатЗапроса 	= Неопределено;
	СобытиеОтладки 		= ОбщийМодульКлиент_Ei.ДобавитьСобытие("Выполнение запроса 1С"+?(ВключатьТекст,Символы.ПС+ТекстЗапроса,""),"Запрос");
    Попытка
		//Если ВыполнитьПакет Тогда
			РезультатЗапроса = ОбщийМодульВызовСервера_Ei.__ВыполнитьЗапрос(ТекстЗапроса,ПараметрыЗапроса,УникальныйИдентификатор);
		//Иначе
		//	РезультатЗапроса=Запрос.Выполнить();
		//КонецЕсли;
	Исключение
		Если ТипЗнч(ИнформацияОбОшибке().Причина) 			=  Тип("ИнформацияОбОшибке") И
			 ТипЗнч(ИнформацияОбОшибке().Причина.Причина) 	=  Тип("ИнформацияОбОшибке") Тогда
			//это ошибка в запросе, остальное не интересно
			сДополнениеОшибки = ИнформацияОбОшибке().Причина.Причина.Описание;
		Иначе
			сДополнениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());	
		КонецЕсли;
		ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке());
		ВызватьИсключение "";
	КонецПопытки;
	ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
	Возврат РезультатЗапроса;
КонецФункции

// Выполняет запрос или пакет запросов
//
// Параметры:
//  ТекстЗапроса	 			- Строка	 					- Сам текст СКД
//  ПараметрыЗапроса 			- Структура 					- Параметры запроса
//  УникальныйИдентификатор	 	- Уникальный идентифкатор	 	- Уникальный идентифкатор адреса.
//  ТипГенератора	 			- Строка	 					- Тип генератора
// 
// Возвращаемое значение:
//  Строка - Адрес в котором схоранен результат запроса
//
Функция вВыполнитьСКД(ТекстСКД,ПараметрыЗапроса,УникальныйИдентификатор,ТипГенератора,СтрРасшифровки) Экспорт
	РезультатЗапроса 	= Неопределено;
	СобытиеОтладки 		= ОбщийМодульКлиент_Ei.ДобавитьСобытие("Выполнение СКД","Запрос");
    Попытка
		РезультатЗапроса = ОбщийМодульВызовСервера_Ei.__ВыполнитьСКД(ТекстСКД,ПараметрыЗапроса,УникальныйИдентификатор,ТипГенератора,СтрРасшифровки);
	Исключение
		Если ТипЗнч(ИнформацияОбОшибке().Причина) 			=  Тип("ИнформацияОбОшибке") И
			 ТипЗнч(ИнформацияОбОшибке().Причина.Причина) 	=  Тип("ИнформацияОбОшибке") Тогда
			//это ошибка в запросе, остальное не интересно
			сДополнениеОшибки = ИнформацияОбОшибке().Причина.Причина.Описание;
		Иначе
			сДополнениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());	
		КонецЕсли;
		ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке());
		ВызватьИсключение "";
	КонецПопытки;
	ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
	Возврат РезультатЗапроса;
КонецФункции

#Область УникальностьИмен

&НаКлиенте
Функция вПолучитьУникальноеИмяВКоллекции(СтрПоиска,Коллекция,сРазделитель = "", Знач Приращение = 1) Экспорт
	Результат 	= "";
	Если ТипЗнч(Коллекция) = Тип("ДанныеФормыКоллекцияЭлементовДерева") Тогда
		Найденные = НайтиВКоллекцииДерева(СтрПоиска,Коллекция);
	ИначеЕсли ТипЗнч(Коллекция) = Тип("ЭлементыГрафическойСхемы") Тогда
		Найденные = Новый Массив;
		Для Каждого ЭлПоиска ИЗ СтрПоиска Цикл
			РезультатПоиска = Коллекция.Найти(ЭлПоиска.Значение);
			Если Не РезультатПоиска = Неопределено Тогда
				Найденные.Добавить(РезультатПоиска);
			КонецЕсли;
			Прервать;
		КонецЦикла;		
	КонецЕсли;
	Для Каждого ЭлПоиска ИЗ СтрПоиска Цикл
		Если Не Найденные.Количество() Тогда
			Результат = ЭлПоиска.Значение;
		Иначе
			//имя не уникально
			чОкончание = ВыделитьЧисловоеОкончание(ЭлПоиска.Значение,сРазделитель);
			Если ЗначениеЗаполнено(чОкончание) Тогда
				СтрПоиска[ЭлПоиска.Ключ] = СтрЗаменить(ЭлПоиска.Значение,сРазделитель+Формат(чОкончание,"ЧН=0; ЧГ="),сРазделитель+Формат(чОкончание+Приращение,"ЧН=0; ЧГ="));	
			Иначе
				СтрПоиска[ЭлПоиска.Ключ] = ЭлПоиска.Значение+сРазделитель+Формат(Приращение,"ЧН=0; ЧГ=");
			КонецЕсли;
			Результат 	= вПолучитьУникальноеИмяВКоллекции(СтрПоиска,Коллекция,сРазделитель,Приращение);
		КонецЕсли;
		Прервать;
	КонецЦикла;	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция НайтиВКоллекцииДерева(СтрПоиска,КоллекцияСтрок) Экспорт
	Результат 	= Новый Массив;
	Для Каждого ЭлПоиска ИЗ СтрПоиска Цикл
		Для Каждого Строка ИЗ КоллекцияСтрок Цикл
			Если нРег(Строка[ЭлПоиска.Ключ]) = нРег(ЭлПоиска.Значение) Тогда
				Результат.Добавить(Строка);
			КонецЕсли;
			Для Каждого ВложенныйРезультат ИЗ НайтиВКоллекцииДерева(СтрПоиска,Строка.ПолучитьЭлементы()) Цикл
				Результат.Добавить(ВложенныйРезультат);		
			КонецЦикла;	
		КонецЦикла;
		Прервать;
	КонецЦикла;	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ВыделитьЧисловоеОкончание(Имя,сРазделитель = "") Экспорт
	Результат = 0;
	Если ПустаяСтрока(сРазделитель) Тогда
		Для Ном = 1 По СтрДлина(Имя) Цикл
			Попытка
				вр = Число(Прав(Имя,Ном));
			Исключение
				Если ЗначениеЗаполнено(Прав(Имя,Ном-1)) Тогда
					Возврат Число(Прав(Имя,Ном-1));
				Иначе
					Прервать;
				КонецЕсли;	
			КонецПопытки;	
		КонецЦикла;
	Иначе
		НачалоРазделителя = СтрНайти(Имя,сРазделитель,НаправлениеПоиска.СКонца);
		Если НачалоРазделителя Тогда
			Возврат Число(Сред(Имя,НачалоРазделителя+СтрДлина(сРазделитель)));
		КонецЕсли;	
	КонецЕсли;	
	Возврат Результат; 
КонецФункции


#КонецОбласти

// Функция - получает уникальный массив объектов открытых пользователем за последние 24 часа, удобно использовать в анализе
// 
// Возвращаемое значение:
//   - Массив ссылок на объекты истории пользователя
//
&НаКлиенте
Функция ПолучитьМассивИстории() Экспорт
	Результат 		= Новый Массив;
	ПоследняяДата  	= Неопределено;
	Для Каждого ЭлИстории ИЗ ИсторияРаботыПользователя.Получить() Цикл
		Если Не ПоследняяДата = Неопределено Тогда
			Если Не ЭлИстории.Дата > (ПоследняяДата-24*60*60) Тогда  // за полседние 24 часа
				Прервать;
			КонецЕсли;
		КонецЕсли;

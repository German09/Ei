КонецПроцедуры



// Функция - ссылок открытых пользователем за последние 24 часа, удобно использовать в анализе
// 
// Возвращаемое значение:
//   Соответствие из КлючИЗначение
//   	*Ключ 		- Строка - Нав ссылка
//   	*Значение	- Произвольный 
Функция ПолучитьИсторию() Экспорт
	Результат 		= Новый Соответствие();
	ПоследняяДата  	= Неопределено;
	Для Каждого ЭлИстории ИЗ ИсторияРаботыПользователя.Получить() Цикл
		Если Не ПоследняяДата = Неопределено Тогда
			Если Не ЭлИстории.Дата > (ПоследняяДата-24*60*60) Тогда  // за полседние 24 часа
				Прервать;
			КонецЕсли;
		КонецЕсли;
		Попытка
			Ссылка = ОбщийМодульВызовСервера_Ei.ПолучитьСсылкуИзНавСсылки(ЭлИстории.НавигационнаяСсылка);
			Если ЗначениеЗаполнено(Ссылка) Тогда
				Результат.Вставить(ЭлИстории.НавигационнаяСсылка,Ссылка);
				ПоследняяДата = ?(ПоследняяДата = Неопределено,ЭлИстории.Дата,ПоследняяДата);
			КонецЕсли;
		Исключение
			//могут навигационные сссылки типа http:\\
			Продолжить;
		КонецПопытки;	
	КонецЦикла;
	Возврат Результат; 
КонецФункции


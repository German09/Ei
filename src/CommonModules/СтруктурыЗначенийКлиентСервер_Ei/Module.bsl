#Область ОписаниеЗначения

// Функция, обёртка - формирует фиксированную структуру на основе переданных параметров, консолидация мест описания сложных значений
//
// Параметры:
//  ОписаниеТипов			 - 	 - 
//  Значение				 - 	 - 
//  Ссылка					 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция ПолучитьОписаниеЗначения(ОписаниеТипов = Неопределено,Значение = Неопределено,Ссылка,ПредставлениеЗначения = Неопределено,ОбъемКоллекции) Экспорт
	Возврат Новый ФиксированнаяСтруктура("ОписаниеТипов,Значение,Ссылка,ПредставлениеЗначения,ОбъемКоллекции",ОписаниеТипов,Значение,Ссылка,ПредставлениеЗначения,ОбъемКоллекции);
КонецФункции	

Функция ЭтоОписаниеЗначения(Кандидат) Экспорт
	Результат = Ложь;
	Если ТипЗнч(Кандидат) = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Кандидат.Свойство("ОбъемКоллекции");	
	КонецЕсли;	
	Возврат Результат;
КонецФункции

#КонецОбласти

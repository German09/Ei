Функция ЗапросSQL(Command, ИмяПоляИД = Неопределено) Экспорт
    Перем Результат;
    Recordset = Command.Execute();
    Результат = РезультатТаблицаВызовСервера_Ei.RecordSetвТЗ(Recordset,ИмяПоляИД);
    Возврат Результат;
КонецФункции

// Формирует представление выражения на встроенном языке и его параметров, для вывода отладочных сообщений 
// Функция должна находится именно на сервере!! для проверки возвр типов
//
// Параметры:
//  Выражение				 - Строка - Выражение котрое нужно описать
//  ОписаниеТипов			 - ОписаниеТипов - Типы, к которым будет приводится вычисленное выражением значение
//  КонтекстВыполнения		 - Структура -
// 
// Возвращаемое значение:
//   -  Строка, представление выражения и описание его парамемтров
//
Функция вПолучитьОписаниеВыражения(Выражение,ОписаниеТипов,КонтекстВыполнения) Экспорт
	СообщениеОтладки	= "выражения на встроенном языке: "+Символы.ПС+Символы.Таб+Выражение;
	СообщениеОтладки    = СообщениеОтладки+Символы.ПС+"Доступные переменные:";	
	Для Каждого Переменная Из КонтекстВыполнения Цикл
		Если Не Переменная.Значение = КонтекстВыполнения Тогда
			СообщениеОтладки	= СообщениеОтладки+Символы.ПС+Символы.Таб+Переменная.Ключ+"		-	"+Переменная.Значение;		
		КонецЕсли;
	КонецЦикла;
	Если Не ОписаниеТипов =  Неопределено Тогда
		СообщениеОтладки	= СообщениеОтладки+Символы.ПС+"Результат, вычисление преобразуется к типу: "+ТипыКлиентСервер_Ei.ПроверитьОписание(ОписаниеТипов);
	КонецЕсли;
	Возврат СообщениеОтладки; 
КонецФункции

// Получить модуль.
// см. https://regexr.com/8bhdn
// 
// Параметры:
//  Выражение - Строка -
// 
// Возвращаемое значение:
//  Структура:
//		*ПроцедурыФункции - Строка,Неопределено
//		*СодержимоеГлавнойФункции - Строка,Неопределено	- Отсутвует если есть функция Результат
Функция ПолучитьМодуль(Знач Выражение) Экспорт
	Перем ОписаниеГлавнойФункции;
	Результат		= Новый Структура("ПроцедурыФункции,СодержимоеГлавнойФункции");
	Описание 		= ПолучитьОписаниеФункции();
	Шаблон 			= СтрШаблон("(%1%2%3\s*%4%5\s+%6\(%7\)(?:.|\n)*?%8%9%10\s*)"
						,Описание.Предпроцессор1
						,Описание.Комментарий
						,Описание.Предпроцессор2
						,Описание.Асинхр
						,Описание.ТипНачало
						,Описание.Имя
						,Описание.Аргументы
						,Описание.Экспорт
						,Описание.Содержание
						,Описание.ТипКонец);
	Совпадения  = СтрНайтиВсеПоРегулярномуВыражению(Выражение, Шаблон, Истина, Истина);
	СтруктураМодуля = Новый Структура();
	ОписанияФункций = Новый Массив;
	Для каждого Совпадение Из Совпадения Цикл
	    ГруппыПоиска 	= Совпадение.ПолучитьГруппы();
	    Описание 		= ПолучитьОписаниеФункции();
	    СтруктураМодуля.Вставить(ГруппыПоиска.Получить(6),Описание);
	    ОписанияФункций.Добавить(Описание); //для сохранения порядка 
	    
	    Описание.Целиком 		= ГруппыПоиска.Получить(0);
	    Описание.Предпроцессор1 = ГруппыПоиска.Получить(1);
	    Описание.Комментарий 	= ГруппыПоиска.Получить(2);
	    Описание.Предпроцессор2 = ГруппыПоиска.Получить(3);
	    Описание.Асинхр 		= ГруппыПоиска.Получить(4);
	    Описание.ТипНачало 		= ГруппыПоиска.Получить(5);
	    Описание.Имя 			= ГруппыПоиска.Получить(6);
	    Описание.Аргументы 		= ГруппыПоиска.Получить(7);
	    Описание.Экспорт 		= ПустаяСтрока(ГруппыПоиска.Получить(8));
	    Описание.Содержание 	= ГруппыПоиска.Получить(9);
	    Описание.ТипКонец 		= ГруппыПоиска.Получить(10)	    
	КонецЦикла;
	Если СтруктураМодуля.Количество() Тогда	
		//есть функции
		ИмяГлавнойФункции = ВыполнитьКлиентСервер_Ei.ИмяГлавнойФункции(); 
		//проверим есть ли функция результат 
		Если СтруктураМодуля.Свойство(ИмяГлавнойФункции,ОписаниеГлавнойФункции) Тогда
			Если ОписаниеГлавнойФункции.Экспорт Тогда
				Если ПустаяСтрока(ОписаниеГлавнойФункции.Аргументы) Тогда
					Результат.Вставить("ПроцедурыФункции",Выражение);			
				Иначе
					ВызватьИсключение СтрШаблон("Функция '%1' не должна содержать аргументов",ИмяГлавнойФункции);		
				КонецЕсли;			
			Иначе
				ВызватьИсключение СтрШаблон("Функция '%1' должна быть экспортной",ИмяГлавнойФункции);
			КонецЕсли;				
		Иначе
			//Текст модуля нужно сформировать
			
			//Уберем все процедуры и функции
			ПроцедурыФункции =  Новый Массив;

			Для Каждого Описание ИЗ  ОписанияФункций Цикл
				ПроцедураИлиФункция = СокрЛП(Описание.Целиком.Значение);
				ПроцедурыФункции.Добавить(ПроцедураИлиФункция); 
				Выражение = СтрЗаменить(Выражение,ПроцедураИлиФункция,"");	
			КонецЦикла;
			//в результате остается только содержимое основной функции
			Результат.Вставить("ПроцедурыФункции",			СтрСоединить(ПроцедурыФункции,Символы.ПС));
			Результат.Вставить("СодержимоеГлавнойФункции",	СокрЛП(Выражение));			
		КонецЕсли;				           
	КонецЕсли;	
	Возврат Результат;
КонецФункции

// Это вычисляемое выражение.
// 
// Параметры:
//  Выражение - Строка
// 
// Возвращаемое значение:
//  Булево - Истина Выражение Вычисляемое, Ложь - Выражение выполняемое
Функция ЭтоВычисляемоеВыражение(Знач Выражение) Экспорт
	//Вначале уберем строки и комментарии
	Для Каждого Найденное ИЗ СтрНайтиВсеПоРегулярномуВыражению(Выражение,"(?<=[""\|]).+(?=[""\|])") Цикл //(?<=""|(?<=\n\s*\|)).+(?=""|(?=\n\s*\|))
		Выражение =  СтрЗаменить(Выражение,Найденное.Значение,"");		
	КонецЦикла;	 
	Для Каждого Найденное ИЗ СтрНайтиВсеПоРегулярномуВыражению(Выражение,"(?://[^\n]*(?:\n|$))*") Цикл
		Выражение =  СтрЗаменить(Выражение,Найденное.Значение,"");		
	КонецЦикла;	 	
	Возврат ПустаяСтрока(СтрНайтиПоРегулярномуВыражению(Выражение,СтрШаблон("%1\s*=",нрег(ВыполнитьКлиентСервер_Ei.ИмяГлавнойФункции())),,,,Истина,Истина).Значение);	
КонецФункции


#КонецОбласти	

#Область СлужебныеПроцедурыИФункции

Функция СоздатьФайлОбработки(ТекстМодуля, ВремКаталог, Хеш)		
	ДвоичныеДанные		= ПолучитьОбщийМакет("АрхивВнешнейОбработки_Ei");		
	ФайлZip				= Новый ЧтениеZipФайла(ДвоичныеДанные.ОткрытьПотокДляЧтения());
	КаталогОбработки 	= СтрШаблон("%1\%2",ВремКаталог,Хеш);
	ФайлZip.ИзвлечьВсе(КаталогОбработки);
	ФайлыКлиентСервер_Ei.ЗаписатьСтроку(СтрШаблон("%1\Расп\8f7bd650-f9be-4e87-bc8a-e752c2b84bd4.0\text",КаталогОбработки),ТекстМодуля);
	Запаковщик = Обработки.РаспаковщикИЗапаковщикФайлов_Ei.Создать();
	Запаковщик.КаталогРаспаковки = КаталогОбработки;
	Запаковщик.НовыйФайл = СтрШаблон("%1\%2.epf",КаталогОбработки,Хеш);
	Запаковщик.Запаковать();
	Возврат Новый Файл(Запаковщик.НовыйФайл);
КонецФункции

//см. https://regexr.com/8bhdn
Функция ПолучитьОписаниеФункции()	
	Результат = Новый Структура();
	Результат.Вставить("Целиком",			"");																	//0
	Результат.Вставить("Предпроцессор1",	"(&\S+\s*\n+)?");														//1
	Результат.Вставить("Комментарий",		"((?://[^\n]*\n)*)");													//2  ((?://[^\n]*(?:\n|$))*)((?://[^\n]*\n)*)
	Результат.Вставить("Предпроцессор2", 	Результат.Предпроцессор1);												//3
	Результат.Вставить("Асинхр",			"(?:(Асинх|Async)?\s+)?");												//4
	Результат.Вставить("ТипНачало",			"(Процедура|Procedure|Функция|Funсtion)+");								//5
	Результат.Вставить("Имя",				"(\S+)");																//6
	Результат.Вставить("Аргументы",			"((?:.|\n)*?)");														//7
	Результат.Вставить("Экспорт",			"(?:\s*(Экспорт|Export)?\s+)?");										//8						
	Результат.Вставить("Содержание",		Результат.Аргументы);													//9
	Результат.Вставить("ТипКонец",			СтрШаблон("(%1)+",ВыполнитьКлиентСервер_Ei.ОсновныеПризнакиМодуля()));	//10	
	Возврат Результат;	
КонецФункции

#КонецОбласти


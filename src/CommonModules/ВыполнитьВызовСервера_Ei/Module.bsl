КонецФункции

// Формирует представление выражения на встроенном языке для журнала выполнения,
// операцию из него собирает см. ВыполнитьКлиентСервер_Ei.Выражение.
// Первая строка - начало выражения, она видна в дереве журнала. Переменные контекста не выводятся:
// они вычисляются вложенными функциями и попадают в журнал своими замерами.
// Функция должна находится именно на сервере!! для проверки возвр типов
//
// Параметры:
//  Выражение				 - Строка - Выражение котрое нужно описать
//  ОписаниеТипов			 - ОписаниеТипов - Типы, к которым будет приводится вычисленное выражением значение
//  КонтекстВыполнения		 - Структура - не используется, оставлен для совместимости вызовов
// 
// Возвращаемое значение:
//  Строка - представление выражения
//
Функция вПолучитьОписаниеВыражения(Выражение,ОписаниеТипов,КонтекстВыполнения) Экспорт
	СообщениеОтладки	= СокрЛ(Выражение);
	Если Не ОписаниеТипов =  Неопределено Тогда
		СообщениеОтладки	= СообщениеОтладки+Символы.ПС+"Результат, вычисление преобразуется к типу: "+ТипыКлиентСервер_Ei.ПроверитьОписание(ОписаниеТипов);
	КонецЕсли;
	Возврат СообщениеОтладки; 
КонецФункции

// Получить модуль.
// см. https://regexr.com/8bhdn
// 
// Параметры:
//  Выражение - Строка -
// 
// Возвращаемое значение:
//  Структура:
//		*ПроцедурыФункции - Строка,Неопределено
//		*СодержимоеГлавнойФункции - Строка,Неопределено	- Отсутвует если есть функция Результат
Функция ПолучитьМодуль(Знач Выражение) Экспорт
	Перем ОписаниеГлавнойФункции;
	Результат		= Новый Структура("ПроцедурыФункции,СодержимоеГлавнойФункции");
	Описание 		= ПолучитьОписаниеФункции();
	Шаблон 			= СтрШаблон("(%1%2%3\s*%4%5\s+%6\(%7\)(?:.|\n)*?%8%9%10\s*)"
						,Описание.Предпроцессор1
						,Описание.Комментарий
						,Описание.Предпроцессор2
						,Описание.Асинхр
						,Описание.ТипНачало
						,Описание.Имя
						,Описание.Аргументы
						,Описание.Экспорт
						,Описание.Содержание
						,Описание.ТипКонец);
	Совпадения  = СтрНайтиВсеПоРегулярномуВыражению(Выражение, Шаблон, Истина, Истина);
	СтруктураМодуля = Новый Структура();
	ОписанияФункций = Новый Массив;
	Для каждого Совпадение Из Совпадения Цикл
	    ГруппыПоиска 	= Совпадение.ПолучитьГруппы();
	    Описание 		= ПолучитьОписаниеФункции();
	    СтруктураМодуля.Вставить(ГруппыПоиска.Получить(6),Описание);
	    ОписанияФункций.Добавить(Описание); //для сохранения порядка 
	    
	    Описание.Целиком 		= ГруппыПоиска.Получить(0);
	    Описание.Предпроцессор1 = ГруппыПоиска.Получить(1);
	    Описание.Комментарий 	= ГруппыПоиска.Получить(2);
	    Описание.Предпроцессор2 = ГруппыПоиска.Получить(3);
	    Описание.Асинхр 		= ГруппыПоиска.Получить(4);
	    Описание.ТипНачало 		= ГруппыПоиска.Получить(5);
	    Описание.Имя 			= ГруппыПоиска.Получить(6);
	    Описание.Аргументы 		= ГруппыПоиска.Получить(7);
	    Описание.Экспорт 		= ПустаяСтрока(ГруппыПоиска.Получить(8));
	    Описание.Содержание 	= ГруппыПоиска.Получить(9);
	    Описание.ТипКонец 		= ГруппыПоиска.Получить(10)	    
	КонецЦикла;
	Если СтруктураМодуля.Количество() Тогда	
		//есть функции
		ИмяГлавнойФункции = ВыполнитьКлиентСервер_Ei.ИмяГлавнойФункции(); 
		//проверим есть ли функция результат 
		Если СтруктураМодуля.Свойство(ИмяГлавнойФункции,ОписаниеГлавнойФункции) Тогда
			Если ОписаниеГлавнойФункции.Экспорт Тогда
				Если ПустаяСтрока(ОписаниеГлавнойФункции.Аргументы) Тогда
					Результат.Вставить("ПроцедурыФункции",Выражение);			
				Иначе
					ВызватьИсключение СтрШаблон("Функция '%1' не должна содержать аргументов",ИмяГлавнойФункции);		
				КонецЕсли;			
			Иначе
				ВызватьИсключение СтрШаблон("Функция '%1' должна быть экспортной",ИмяГлавнойФункции);
			КонецЕсли;				
		Иначе
			//Текст модуля нужно сформировать
			
			//Уберем все процедуры и функции
			ПроцедурыФункции =  Новый Массив;

			Для Каждого Описание ИЗ  ОписанияФункций Цикл
				ПроцедураИлиФункция = СокрЛП(Описание.Целиком.Значение);
				ПроцедурыФункции.Добавить(ПроцедураИлиФункция); 
				Выражение = СтрЗаменить(Выражение,ПроцедураИлиФункция,"");	
			КонецЦикла;
			//в результате остается только содержимое основной функции
			Результат.Вставить("ПроцедурыФункции",			СтрСоединить(ПроцедурыФункции,Символы.ПС));
			Результат.Вставить("СодержимоеГлавнойФункции",	СокрЛП(Выражение));			
		КонецЕсли;				           
	КонецЕсли;	
	Возврат Результат;
КонецФункции

// Определяет вид кода без содержимого строк и комментариев.
//
// Параметры:
//  Выражение - Строка - код Ei
//
// Возвращаемое значение:
//  см. ВариантАлгоритмКлиентСервер_Ei.ВидКодаБезСтрок
Функция ВидКода(Выражение) Экспорт
	Возврат ВариантАлгоритмКлиентСервер_Ei.ВидКодаБезСтрок(
		ВариантАлгоритмКлиентСервер_Ei.КодБезСтрокИКомментариев(Выражение));
КонецФункции

// Возвращает XML свойств и посторонних объектов обработки, исключая прежние объекты Ei.
// DOM обрабатывается на сервере: клиент получает только строки XML без узлов документа.
//
// Параметры:
//  Текст - Строка - прежний XML обработки
//  КлючиОбъектовEi - Массив из Строка - uuid объектов под управлением Ei
//
// Возвращаемое значение:
//  Массив из Строка - самостоятельные XML-элементы с необходимыми пространствами имен
Функция МетаданныеБезОбъектовEi(Текст, КлючиОбъектовEi) Экспорт
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(Текст);
	Построитель	= Новый ПостроительDOM;
	Документ	= Построитель.Прочитать(Чтение);
	Чтение.Закрыть();
	СохраняемыеЭлементы	= Новый Массив;
	ЗаписьDOM			= Новый ЗаписьDOM;
	Для Каждого Узел Из Документ.ЭлементДокумента.ДочерниеУзлы Цикл
		Если Узел.ТипУзла <> ТипУзлаDOM.Элемент И Узел.ТипУзла <> ТипУзлаDOM.Комментарий Тогда
			Продолжить;
		КонецЕсли;
		Если Узел.ТипУзла = ТипУзлаDOM.Элемент Тогда
			Если Узел.ИмяУзла = "name" Или Узел.ИмяУзла = "synonym" Тогда
				Продолжить;
			КонецЕсли;
			Если (Узел.ИмяУзла = "forms" Или Узел.ИмяУзла = "templates")
				И КлючиОбъектовEi.Найти(НРег(Узел.ПолучитьАтрибут("uuid"))) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Запись = Новый ЗаписьXML;
		Запись.УстановитьСтроку();
		ЗаписьDOM.Записать(Узел, Запись);
		СохраняемыеЭлементы.Добавить(Запись.Закрыть());
	КонецЦикла;
	Возврат СохраняемыеЭлементы;
КонецФункции



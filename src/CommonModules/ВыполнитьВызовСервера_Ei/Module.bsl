// Функция - Вычисляет выражение на встроенном языке
//
// Параметры:
//  Выражение				 - Строка - Вычисляемое выражение
//  УникальныйИдентификатор	 - УникальныйИдентификатор	 -  Идентификатор адреса, в который нужно поместить результат вычисления
//  ОписаниеТипов			 - ОписаниеТипов - Типы, к которым будет приводится вычисленное значение
//  КонтекстВыполнения		 - Структура -
//
// Возвращаемое значение:
//  - Структура - см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//	- УникальныйИдентификатор - значения в Кеше сервера
//
Функция ВыражениеВычислить(Выражение,Знач УникальныйИдентификатор,Знач ОписаниеТипов, Знач КонтекстВыполнения) Экспорт 
//	Для Каждого Эл ИЗ ОбщегоНазначенияПовтИсп_Ei.Формы() Цикл
//		Сообщить(Эл.Значение.УникальныйИдентификатор);	
//	КонецЦикла;	
	Возврат ВыполнитьКлиентСервер_Ei.ВыражениеВычислить(Выражение,УникальныйИдентификатор,ОписаниеТипов,КонтекстВыполнения);
КонецФункции

// Функция - выполняет выражение на встроенном языке ожидающее возвращаемое занчение в переменной "Результат"
//
// Параметры:
//  Выражение				 - Строка - Вычисляемое выражение
//  УникальныйИдентификатор	 - УникальныйИдентификатор	 -  Идентификатор адреса, в который нужно поместить результат вычисления
//  ОписаниеТипов			 - ОписаниеТипов - Типы, к которым будет приводится вычисленное значение
//  КонтекстВыполнения		 - Структура -
//
// Возвращаемое значение:
//  - Структура 				- см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//	- УникальныйИдентификатор 	- значения в Кеше сервера
//
Функция ВыражениеВыполнить(Выражение,Знач УникальныйИдентификатор,Знач ОписаниеТипов,Знач КонтекстВыполнения) Экспорт 
	Возврат ВыполнитьКлиентСервер_Ei.ВыражениеВыполнить(Выражение,УникальныйИдентификатор,ОписаниеТипов,КонтекстВыполнения);
КонецФункции

// Функция - выполняет выражение на встроенном языке ожидающее возвращаемое занчение в переменной "Результат"
//
// Параметры:
//  ТекстМодуля				 - Строка - Текст модуля
//  УникальныйИдентификатор	 - УникальныйИдентификатор	 -  Идентификатор адреса, в который нужно поместить результат вычисления
//  ОписаниеТипов			 - ОписаниеТипов - Типы, к которым будет приводится вычисленное значение
//
//
// Возвращаемое значение:
//  см. ВыполнитьКлиентСервер_Ei.ПослеВычисленияЗначения
//
Функция ВыполнитьМодуль(ТекстМодуля,УникальныйИдентификатор,ОписаниеТипов) Экспорт
	ВремКаталог = СтрШаблон("%1%2",КаталогВременныхФайлов(),ОбщегоНазначенияКлиентСервер_Ei.Постфикс());
	Хеш 		= Лев(ОбщегоНазначения_Ei.ХешСтроки(ТекстМодуля),32);
	Файлы 		= НайтиФайлы(ВремКаталог,СтрШаблон("%1.epf",Хеш),Истина);
	Если Не Файлы.Количество() Тогда
		Файлы.Добавить(СоздатьФайлОбработки(ТекстМодуля, ВремКаталог, Хеш));
	КонецЕсли;
	Для Каждого Файл ИЗ Файлы Цикл
		Обработка 	= ВнешниеОбработки.Создать(Файл.ПолноеИмя);
		Значение	= Обработка.Результат(); //см. ВыполнитьКлиентСервер_Ei.ИмяГлавнойФункции
		Результат 	= ВыполнитьКлиентСервер_Ei.ПослеВычисленияЗначения(Значение,ОписаниеТипов,УникальныйИдентификатор);
		Возврат Результат;
	КонецЦикла;			
КонецФункции		



// Запрос.
// 
// Параметры:
//  ТекстЗапроса			 - Строка 			 
//  УникальныйИдентификатор	 - УникальныйИдентификатор	
// 
// Возвращаемое значение:
//  см. ВыполнитьКлиентСервер_Ei.ПослеВычисленияЗначения
Функция Запрос(ТекстЗапроса,УникальныйИдентификатор) Экспорт
	ОбъектЗапрос = ОбщегоНазначенияВызовСервера_Ei.СоздатьЗапрос(ТекстЗапроса);
	Массив = ОбъектЗапрос.ВыполнитьПакетСПромежуточнымиДанными();
	Если Массив.Количество() = 1 Тогда
		Значение =  Массив.Получить(0); 
	Иначе
		Значение =  Массив	
	КонецЕсли;	
	Результат = ВыполнитьКлиентСервер_Ei.ПослеВычисленияЗначения(Значение,,УникальныйИдентификатор);
	Возврат Результат;	
КонецФункции

Функция СКД(ТекстСКД, УникальныйИдентификатор = Неопределено,сТипГенератора,СтрРасшифровки) Экспорт
	КомпоновщикМакета 		= Новый КомпоновщикМакетаКомпоновкиДанных;
	СхемаКомпоновкиДанных 	= ОбщегоНазначенияКлиентСервер_Ei.Структурировать(ТекстСКД,Новый СхемаКомпоновкиДанных);
	//Для Каждого Свойство ИЗ ОбщегоНазначенияКлиентСервер_Ei.ПолучитьМодифицирПараметрыДляЗапроса(СтруктурыЗначенийВызовСервера_Ei.ПереопределитьПараметры(ПараметрыЗапроса)) Цикл
	//	Значение = Свойство.Значение;
	//	ОбъектЗапрос.УстановитьПараметр(Свойство.Ключ,Значение);
	//КонецЦикла;
	ДанныеРасшифровки 		= Неопределено;
	тТипГенератора          = Тип(сТипГенератора);
	Если СтрРасшифровки = Неопределено Тогда
		ИсполняемыеНастройки 	= СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	Иначе
		//вызываем расшифровку
		ОбработкаРасшифровки =  Новый ОбработкаРасшифровкиКомпоновкиДанных(СтрРасшифровки.АдресДанныхРасшифровки, Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
        ИсполняемыеНастройки = ОбработкаРасшифровки.ПрименитьНастройки(СтрРасшифровки.ОписаниеОбработкиРасшифровки.Идентификатор, СтрРасшифровки.ОписаниеОбработкиРасшифровки.ПрименяемыеНастройки);
	КонецЕсли;
	ИмяНабора 				= НаборВариантовВызовСервера_Ei.ПолучитьТекущийНабор();
	Для Каждого ПараметрКомпановки ИЗ ИсполняемыеНастройки.ПараметрыДанных.Элементы Цикл
		ИмяПараметра 	= Строка(ПараметрКомпановки.Параметр); 	 
		Значение 		= ПараметрыВызовСервера_Ei.ВычислитьПараметры(ИмяНабора,ИмяПараметра);
		Если Не Значение = Неопределено Тогда
			ПараметрКомпановки.Значение 		= ОбщегоНазначенияКлиентСервер_Ei.АдаптироватьЗначениеПараметраЗапроса(Значение);	
			ПараметрКомпановки.Использование	= Истина;
		КонецЕсли;	
	КонецЦикла;
	Компоновка 	= КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, ИсполняемыеНастройки,ДанныеРасшифровки,,тТипГенератора);
	//Заполним Внешние наборы
	ВнешниеНаборыДанныхСКД = Новый Структура();
	//Для Каждого Параметр Из ПараметрыЗапроса Цикл
	//	Если ТипЗнч(Параметр.Значение) = Тип("ТаблицаЗначений") Тогда
	//		ВнешниеНаборыДанныхСКД.Вставить(Параметр.Ключ,Параметр.Значение);			
	//	КонецЕсли;	
	//КонецЦикла;
	ПроцессорКомпоновки 	= Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Компоновка,ВнешниеНаборыДанныхСКД,ДанныеРасшифровки);
	Значение = Отчеты.ПроцессорВывода_Ei.Создать();
	Значение.ПроцессорКомпоновки 	= ПроцессорКомпоновки;
	Значение.АдресДанныхРасшифровки 		= ПоместитьВоВременноеХранилище(ДанныеРасшифровки, Новый УникальныйИдентификатор);
	Значение.АдресСхемыКомпоновкиДанных 	= ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, Новый УникальныйИдентификатор);
	
	#Область СтарыйСпособ
	//Устарел когда перешли с макета компановки на процессор, для того чтобы не таскать параметры расшифровки и другие данные
	//оставлен для совместимости перехода
	Если тТипГенератора = Тип("ГенераторМакетаКомпоновкиДанных") Тогда
		мАдресов 						= Новый Массив;
		мАдресов.Добавить(Значение.АдресДанныхРасшифровки);
		мАдресов.Добавить(Значение.АдресСхемыКомпоновкиДанных);		
		ПараметрРасшифровка 			= Компоновка.ЗначенияПараметров.Добавить();
		ПараметрРасшифровка.Имя			= ОбщегоНазначения_Ei.ИмяПараметраРасшифровкаСКД(); 
		ПараметрРасшифровка.Значение  	= мАдресов;
	КонецЕсли;
	#КонецОбласти
			
	Результат 	=  ВыполнитьКлиентСервер_Ei.ПослеВычисленияЗначения(Значение,,УникальныйИдентификатор);
	Возврат Результат;		
КонецФункции



// Функция - Вычисляет выражение на встроенном языке
//
// Параметры:
//  Выражение				 - Строка - Вычисляемое выражение
//  УникальныйИдентификатор	 - УникальныйИдентификатор	 -  Идентификатор адреса, в который нужно поместить результат вычисления
//  ОписаниеТипов			 - ОписаниеТипов - Типы, к которым будет приводится вычисленное значение
//  КонтекстВыполнения		 - Структура -
//
// Возвращаемое значение:
//   -  Структура описания значения, формируемая ОбщийМодульКлиентСервер_Ei.ПолучитьОписаниеЗначения()
//	ИЛИ
//	 - 	Уникальный идентификатор значения в Кеше сервера
//
Функция ВыражениеВычислить(Выражение,Знач УникальныйИдентификатор,Знач ОписаниеТипов, Знач КонтекстВыполнения) Экспорт 
	Перем Результат;
	//Перем Параметры, ЭтаФорма, Объект; //ТекущиеДанные,СтрокаТЧ, Запись, ЗагружаемыйОбъект
	//СтруктурыЗначенийВызовСервера_Ei.ПереопределеитьЗначенияКонтекста(КонтекстВыполнения,Параметры, ЭтаФорма, Объект, Результат); 
	
	Значение	= Вычислить(Выражение);
	
	Результат	= ПослеВычисленияЗначения(Значение,ОписаниеТипов,УникальныйИдентификатор);
	Возврат Результат;
КонецФункции

// Функция - выполняет выражение на встроенном языке ожидающее возвращаемое занчение в переменной "Результат"
//
// Параметры:
//  Выражение				 - Строка - Вычисляемое выражение
//  УникальныйИдентификатор	 - УникальныйИдентификатор	 -  Идентификатор адреса, в который нужно поместить результат вычисления
//  ОписаниеТипов			 - ОписаниеТипов - Типы, к которым будет приводится вычисленное значение
//  КонтекстВыполнения		 - Структура -
//
// Возвращаемое значение:
//   -  Структура описания значения, формируемая СтруктурыЗначенийКлиентСервер_Ei.ПолучитьОписаниеЗначения()
//	ИЛИ
//	 - 	Уникальный идентификатор значения в Кеше сервера
//
Функция ВыражениеВыполнить(Выражение,Знач УникальныйИдентификатор,Знач ОписаниеТипов,Знач КонтекстВыполнения) Экспорт 
	Перем Результат;
	//Перем Параметры, ЭтаФорма, Объект; //ТекущиеДанные,СтрокаТЧ, Запись, ЗагружаемыйОбъект
	//СтруктурыЗначенийВызовСервера_Ei.ПереопределеитьЗначенияКонтекста(КонтекстВыполнения,Параметры, ЭтаФорма, Объект, Результат); //Результат переопределяем для отображения возвращаемого значения
	
	Выполнить(Выражение);
	
	Значение 	= Результат;
	Результат	= ПослеВычисленияЗначения(Значение,ОписаниеТипов,УникальныйИдентификатор);
	Возврат Результат;
КонецФункции

Функция Запрос(ТекстЗапроса,УникальныйИдентификатор) Экспорт
	ОбъектЗапрос = ОбщийМодульВызовСервера_Ei.СоздатьЗапрос(ТекстЗапроса);
	Значение = ОбъектЗапрос.Выполнить();
	
	Результат = ПослеВычисленияЗначения(Значение,,УникальныйИдентификатор);
	Возврат Результат;	
КонецФункции

Функция СКД(ТекстСКД, УникальныйИдентификатор = Неопределено,сТипГенератора,СтрРасшифровки) Экспорт
	КомпоновщикМакета 		= Новый КомпоновщикМакетаКомпоновкиДанных;
	СхемаКомпоновкиДанных 	= ОбщийМодульКлиентСервер_Ei.Структурировать(ТекстСКД,Новый СхемаКомпоновкиДанных);
	//Для Каждого Свойство ИЗ ОбщийМодульКлиентСервер_Ei.ПолучитьМодифицирПараметрыДляЗапроса(СтруктурыЗначенийВызовСервера_Ei.ПереопределитьПараметры(ПараметрыЗапроса)) Цикл
	//	Значение = Свойство.Значение;
	//	ОбъектЗапрос.УстановитьПараметр(Свойство.Ключ,Значение);
	//КонецЦикла;
	ДанныеРасшифровки 		= Неопределено;
	тТипГенератора          = Тип(сТипГенератора);
	Если СтрРасшифровки = Неопределено Тогда
		ИсполняемыеНастройки 	= СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	Иначе
		//вызываем расшифровку
		ОбработкаРасшифровки =  Новый ОбработкаРасшифровкиКомпоновкиДанных(СтрРасшифровки.АдресДанныхРасшифровки, Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
        ИсполняемыеНастройки = ОбработкаРасшифровки.ПрименитьНастройки(СтрРасшифровки.ОписаниеОбработкиРасшифровки.Идентификатор, СтрРасшифровки.ОписаниеОбработкиРасшифровки.ПрименяемыеНастройки);
	КонецЕсли;
	ИмяНабора 				= НаборВариантовВызовСервера_Ei.ПолучитьТекущийНабор();
	Для Каждого ПараметрКомпановки ИЗ ИсполняемыеНастройки.ПараметрыДанных.Элементы Цикл
		ИмяПараметра 	= Строка(ПараметрКомпановки.Параметр); 	 
		Значение 		= ПараметрыВызовСервера_Ei.ВычислитьПараметры(ИмяНабора,ИмяПараметра);
		Если Не Значение = Неопределено Тогда
			ПараметрКомпановки.Значение 		= ОбщийМодульКлиентСервер_Ei.АдаптироватьЗначениеПараметраЗапроса(Значение);	
			ПараметрКомпановки.Использование	= Истина;
		КонецЕсли;	
	КонецЦикла;
	Значение 	= КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, ИсполняемыеНастройки,ДанныеРасшифровки,,тТипГенератора);
	Если тТипГенератора = Тип("ГенераторМакетаКомпоновкиДанных") Тогда
		мАдресов 						= Новый Массив;
		мАдресов.Добавить(ПоместитьВоВременноеХранилище(ДанныеРасшифровки,	Новый УникальныйИдентификатор));
		мАдресов.Добавить(ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных,	Новый УникальныйИдентификатор));		
		ПараметрРасшифровка 			= Значение.ЗначенияПараметров.Добавить();
		ПараметрРасшифровка.Имя			= ОбщийМодульСервер_Ei.ИмяПараметраРасшифровкаСКД(); 
		ПараметрРасшифровка.Значение  	= мАдресов;
	КонецЕсли;	
	Результат 	=  ПослеВычисленияЗначения(Значение,,УникальныйИдентификатор);
	Возврат Результат;		
КонецФункции

// Функция - После вычисления значения
//
// Параметры:
//  Значение				 - Произвольный	 				- Вычисленное значение 
//  ОписаниеТипов			 - Массив, Срока, ОписаниеТипов	- Тип к которому нужно привести значение
//  УникальныйИдентификатор	 - УникальныйИдентифкатор	 	- Индентифкатор формы, в случае его указания возвращается структура ОписанияЗначения
// 
// Возвращаемое значение:
//   -  Структура описания значения, формируемая ОбщийМодульКлиентСервер_Ei.ПолучитьОписаниеЗначения()
//	ИЛИ
//	 - 	Уникальный идентификатор значения в Кеше
//
Функция ПослеВычисленияЗначения(Значение, ОписаниеТипов, УникальныйИдентификатор)
	Если Не ОписаниеТипов = Неопределено Тогда
		ТипПриведения  	= ТипыКлиентСервер_Ei.ПроверитьОписание(ОписаниеТипов);
		Если НЕ ТипПриведения.СодержитТип(ТипЗнч(Значение)) Тогда
			//тут нужно подумать как приводить в сложные значение привести автоматом невсегда возможно
//			Если ТипПриведения.СодержитТип(Тип("ТаблицаЗначений")) Тогда
//				//приведем значение к таблице или дереву значений
//				Значение = КоллекцияВызовСервера_Ei.ПреобразоватьВТаблицуЗначений(Значение);
//			Иначе	
				Значение = ТипПриведения.ПривестиЗначение(Значение);			
//			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
	Если Не УникальныйИдентификатор = Неопределено Тогда
		//если уникальный идентификатор указан то сразу формируем описание значения без попытки передать в явном виде на клиент
	    Результат = ОписаниеЗначенияСервер_Ei.Подготовить(Значение,УникальныйИдентификатор);
	Иначе
		//мутабельные значения не получится поместить во внутренее хранилище поэтому просто поместим сохраним на сервере в КЭШе
		Результат = Новый УникальныйИдентификатор;
		КэшПользователяКлиентСерверПовтИсп_Ei.Значения().Вставить(Результат,Значение);
	КонецЕсли;	
	Возврат  Результат			
КонецФункции

//Выполняет запрос и возвращает ПОСЛЕДНИЙ результат в виде таблицы значений
//Параметры:
//    Command - ADODB.Command - команда для выполнения;
//    ИмяПоляИД - Строка - имя поля, которое является разделителем для строк второго уровня, все поля поторые идут после этого поля,
//        считаются данными строк второго уровня - строками, подчиненными строке первого уровня, значение в этом поле в них должно быть одинаковым,
//        и соответствовать строке первого уровня. В результирующей таблице будет созана колонка с именем Состав типа ТаблицаЗначений,
//        которая будет содержать данные строк второго уровня.
//
Функция ЗапросSQL(Command, ИмяПоляИД = Неопределено) Экспорт
    Перем Результат;
    Recordset = Command.Execute();
    Результат = РезультатВызовСервера_Таблица_Ei.RecordSetвТЗ(Recordset,ИмяПоляИД);
    Возврат Результат;
КонецФункции

// Формирует представление выражения на встроенном языке и его параметров, для вывода отладочных сообщений 
// Функция должна находится именно на сервере!! для проверки возвр типов
//
// Параметры:
//  Выражение				 - Строка - Выражение котрое нужно описать
//  ОписаниеТипов			 - ОписаниеТипов - Типы, к которым будет приводится вычисленное выражением значение
//  КонтекстВыполнения		 - Структура -
// 
// Возвращаемое значение:
//   -  Строка, представление выражения и описание его парамемтров
//
Функция вПолучитьОписаниеВыражения(Выражение,ОписаниеТипов,КонтекстВыполнения) Экспорт
	СообщениеОтладки	= "выражения на встроенном языке: "+Символы.ПС+Символы.Таб+Выражение;
	СообщениеОтладки    = СообщениеОтладки+Символы.ПС+"Доступные переменные:";	
	Для Каждого Переменная Из КонтекстВыполнения Цикл
		Если Не Переменная.Значение = КонтекстВыполнения Тогда
			СообщениеОтладки	= СообщениеОтладки+Символы.ПС+Символы.Таб+Переменная.Ключ+"		-	"+Переменная.Значение;		
		КонецЕсли;
	КонецЦикла;
	Если Не ОписаниеТипов =  Неопределено Тогда
		СообщениеОтладки	= СообщениеОтладки+Символы.ПС+"Результат, вычисление преобразуется к типу: "+ТипыКлиентСервер_Ei.ПроверитьОписание(ОписаниеТипов);
	КонецЕсли;
	Возврат СообщениеОтладки; 
КонецФункции


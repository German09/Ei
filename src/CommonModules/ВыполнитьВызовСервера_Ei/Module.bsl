Функция СоздатьФайлОбработки(ТекстМодуля, ВремКаталог, Хеш)		
	ДвоичныеДанные		= ПолучитьОбщийМакет("АрхивВнешнейОбработки_Ei");		
	ФайлZip				= Новый ЧтениеZipФайла(ДвоичныеДанные.ОткрытьПотокДляЧтения());
	КаталогОбработки 	= СтрШаблон("%1\%2",ВремКаталог,Хеш);
	ФайлZip.ИзвлечьВсе(КаталогОбработки);
	ФайлыКлиентСервер_Ei.ЗаписатьСтроку(СтрШаблон("%1\Расп\8f7bd650-f9be-4e87-bc8a-e752c2b84bd4.0\text",КаталогОбработки),ТекстМодуля);
	Запаковщик = Обработки.РаспаковщикИЗапаковщикФайлов_Ei.Создать();
	Запаковщик.КаталогРаспаковки = КаталогОбработки;
	Запаковщик.НовыйФайл = СтрШаблон("%1\%2.epf",КаталогОбработки,Хеш);
	Запаковщик.Запаковать();
	Возврат Новый Файл(Запаковщик.НовыйФайл);
КонецФункции

Функция СоздатьОбъектEPF(Путь)
	Защита = Новый ОписаниеЗащитыОтОпасныхДействий;
	Защита.ПредупреждатьОбОпасныхДействиях = Ложь;
	Возврат ВнешниеОбработки.Создать(Путь, Истина, Защита);
КонецФункции

Функция ПолучитьДанныеEPF(Путь)
	Данные = Неопределено;
	Если ЭтоАдресВременногоХранилища(Путь) Тогда
		Данные = ПолучитьИзВременногоХранилища(Путь);
	ИначеЕсли ЗначениеЗаполнено(Путь) Тогда
		Файл = Новый Файл(Путь);
		Если Файл.Существует() И НРег(Файл.Расширение) = ".epf" Тогда
			Данные = Новый ДвоичныеДанные(Файл.ПолноеИмя);
		КонецЕсли;
	КонецЕсли;
	Возврат Данные;
КонецФункции

Функция ПрочитатьИсходникиEPF(Обработка, ИмяОбработки, Каталог)
	МетаданныеОбработки = Обработка.Метаданные();
	Если МетаданныеОбработки.Имя <> ИмяОбработки Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'В выбранной EPF находится %1. Ожидался набор %2.'"), МетаданныеОбработки.Имя, ИмяОбработки);
	КонецЕсли;
	Корень = СтрРазделить(ПрочитатьТекстEPF(Каталог + "root"), ",");
	Если Корень.Количество() < 2 Тогда
		ВызватьИсключение НСтр("ru = 'В EPF нет ссылки на метаданные обработки'");
	КонецЕсли;
	Ключ = Строка(Новый УникальныйИдентификатор(СокрЛП(Корень[1])));
	Описание = ПрочитатьТекстEPF(Каталог + Ключ);
	// В контейнере 1С текст модуля объекта находится по идентификатору containedObjects, а не по UUID обработки.
	МодульОбъекта = ПрочитатьТекстEPF(Каталог + ИдентификаторОписанияEPF(Описание) + ".0"
		+ ПолучитьРазделительПути() + "text");
	Объекты = Новый Массив;
	Формы = КлючиМетаданныхEPF(Описание, "d5b0e5ed-256d-401c-9c36-f630cafd8a62");
	Для Каждого КлючФормы Из Формы Цикл
		Объекты.Добавить(ИсходникиОбъектаEPF(Обработка, Каталог, КлючФормы, Истина));
	КонецЦикла;
	Макеты = КлючиМетаданныхEPF(Описание, "3daea016-69b7-4ed4-9453-127911372fe6");
	Для Каждого КлючМакета Из Макеты Цикл
		Объекты.Добавить(ИсходникиОбъектаEPF(Обработка, Каталог, КлючМакета, Ложь));
	КонецЦикла;
	Если Формы.Количество() <> МетаданныеОбработки.Формы.Количество()
		Или Макеты.Количество() <> МетаданныеОбработки.Макеты.Количество() Тогда
		ВызватьИсключение НСтр("ru = 'Состав контейнера EPF не совпадает с метаданными обработки'");
	КонецЕсли;
	Возврат Новый Структура("Ключ,МодульОбъекта,Объекты", Ключ, МодульОбъекта, Объекты);
КонецФункции

Функция КлючиМетаданныхEPF(Описание, Класс)
	Ключи = Новый Массив;
	Маркер = "{" + Класс + ",";
	Начало = СтрНайти(Описание, Маркер);
	Если Начало > 0 Тогда
		Начало = Начало + СтрДлина(Маркер);
		Конец = СтрНайти(Описание, "}", НаправлениеПоиска.СНачала, Начало);
		Поля = СтрРазделить(Сред(Описание, Начало, Конец - Начало), ",");
		Если Число(СокрЛП(Поля[0])) <> Поля.Количество() - 1 Тогда
			ВызватьИсключение НСтр("ru = 'Нарушена структура списка метаданных EPF'");
		КонецЕсли;
		Для Индекс = 1 По Поля.Количество() - 1 Цикл
			Ключи.Добавить(Строка(Новый УникальныйИдентификатор(СокрЛП(Поля[Индекс]))));
		КонецЦикла;
	КонецЕсли;
	Возврат Ключи;
КонецФункции

Функция ИдентификаторОписанияEPF(Описание)
	Маркер = "{1,0,";
	Начало = СтрНайти(Описание, Маркер);
	Если Начало = 0 Тогда
		ВызватьИсключение НСтр("ru = 'В EPF не найдено описание объекта'");
	КонецЕсли;
	Возврат Строка(Новый УникальныйИдентификатор(Сред(Описание, Начало + СтрДлина(Маркер), 36)));
КонецФункции

// Извлечь описание и содержимое формы или макета. Макеты читает сама платформа,
// включая двоичное представление графических схем и СКД.
Функция ИсходникиОбъектаEPF(Обработка, Каталог, Ключ, ЭтоФорма)
	Описание = ПрочитатьТекстEPF(Каталог + Ключ);
	Маркер = "{1,0," + Ключ + "},";
	Позиция = СтрНайти(Описание, Маркер);
	Если Позиция = 0 Тогда
		ВызватьИсключение НСтр("ru = 'В EPF отсутствует описание формы или макета'");
	КонецЕсли;
	Начало = СтрНайти(Описание, """", НаправлениеПоиска.СНачала, Позиция + СтрДлина(Маркер));
	Имя = СтрокаКонтейнераEPF(Описание, Начало);
	МетаданныеОбработки = Обработка.Метаданные();
	МетаданныеОбъекта = ?(ЭтоФорма, МетаданныеОбработки.Формы.Найти(Имя), МетаданныеОбработки.Макеты.Найти(Имя));
	Если МетаданныеОбъекта = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'В метаданных EPF не найден объект %1'"), Имя);
	КонецЕсли;

	ТипМакета = "";
	Если ЭтоФорма Тогда
		ТекстФормы = ПрочитатьТекстEPF(Каталог + Ключ + ".0");
		Начало = СтрНайти(ТекстФормы, """//<EiСостав ");
		Текст = СтрокаКонтейнераEPF(ТекстФормы, Начало);
		Если КодНабораКлиентСервер_Ei.ПрочитатьСостав(Текст) = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'В форме EPF отсутствует описание состава набора Ei'");
		КонецЕсли;
	Иначе
		Макет = Обработка.ПолучитьМакет(Имя);
		Если ТипЗнч(Макет) = Тип("ТекстовыйДокумент") Тогда
			ТипМакета = "TextDocument";
			Текст = Макет.ПолучитьТекст();
		ИначеЕсли ТипЗнч(Макет) = Тип("СхемаКомпоновкиДанных") Тогда
			ТипМакета = "DataCompositionSchema";
			Текст = ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(Макет);
		ИначеЕсли ТипЗнч(Макет) = Тип("ГрафическаяСхема") Тогда
			ТипМакета = "GraphicalSchema";
			Текст = СхемаПроцессаEDTВызовСервера_Ei.ВФорматEDT(ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(Макет));
		Иначе
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Тип макета %1 в EPF не поддерживается'"), Имя);
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура("Имя,Ключ,Синоним,Комментарий,ТипМакета,Текст",
		Имя, Ключ, МетаданныеОбъекта.Синоним, МетаданныеОбъекта.Комментарий, ТипМакета, Текст);
КонецФункции

Функция ПрочитатьТекстEPF(Путь)
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Текст;
КонецФункции

// Строки контейнера обрамлены кавычками, кавычки внутри удвоены.
Функция СтрокаКонтейнераEPF(Текст, Начало)
	Если Начало < 1 Тогда
		ВызватьИсключение НСтр("ru = 'В контейнере EPF отсутствует ожидаемая строка'");
	КонецЕсли;
	Позиция = Начало + 1;
	КонецСтроки = 0;
	Пока Позиция <= СтрДлина(Текст) Цикл
		Кавычка = СтрНайти(Текст, """", НаправлениеПоиска.СНачала, Позиция);
		Если Кавычка = 0 Тогда
			Прервать;
		КонецЕсли;
		Если Сред(Текст, Кавычка + 1, 1) <> """" Тогда
			КонецСтроки = Кавычка;
			Прервать;
		КонецЕсли;
		Позиция = Кавычка + 2;
	КонецЦикла;
	Если КонецСтроки = 0 Тогда
		ВызватьИсключение НСтр("ru = 'В контейнере EPF найдена незакрытая строка'");
	КонецЕсли;
	Возврат СтрЗаменить(Сред(Текст, Начало + 1, КонецСтроки - Начало - 1), """""", """");
КонецФункции

//см. https://regexr.com/8bhdn
Функция ПолучитьОписаниеФункции()	
	Результат = Новый Структура();
	Результат.Вставить("Целиком",			"");																	//0
	Результат.Вставить("Предпроцессор1",	"(&\S+\s*\n+)?");														//1
	Результат.Вставить("Комментарий",		"((?://[^\n]*\n)*)");													//2  ((?://[^\n]*(?:\n|$))*)((?://[^\n]*\n)*)
	Результат.Вставить("Предпроцессор2", 	Результат.Предпроцессор1);												//3
	Результат.Вставить("Асинхр",			"(?:(Асинх|Async)?\s+)?");												//4
	Результат.Вставить("ТипНачало",			"(Процедура|Procedure|Функция|Funсtion)+");								//5
	Результат.Вставить("Имя",				"(\S+)");																//6
	Результат.Вставить("Аргументы",			"((?:.|\n)*?)");														//7
	Результат.Вставить("Экспорт",			"(?:\s*(Экспорт|Export)?\s+)?");										//8						
	Результат.Вставить("Содержание",		Результат.Аргументы);													//9
	Результат.Вставить("ТипКонец",			СтрШаблон("(%1)+",ВыполнитьКлиентСервер_Ei.ОсновныеПризнакиМодуля()));	//10	
	Возврат Результат;	
КонецФункции


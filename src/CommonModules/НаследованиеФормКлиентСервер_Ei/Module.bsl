// Получить свойства.
// 
// Параметры:
//  Элемент 	- ЭлементыФормы	-
//  Тип 		- Строка		- Возвращаемый параметр
//  Расширение 	- Строка		- Расширение
// 
// Возвращаемое значение:
//  см. НаследованиеФормСерверПовтИсп_Ei.ПолучитьСвойстваЭлемента
Функция ПолучитьСвойства(Элемент,Тип = Неопределено,Расширение = Неопределено) Экспорт
	Тип			= ОбщегоНазначенияКлиентСервер_Ei.ПолучитьИмяТипЗнч(ТипЗнч(Элемент));
	Расширение	= Неопределено;
	Если ТипЗнч(Элемент) = Тип("ГруппаФормы") Или ТипЗнч(Элемент) = Тип("ПолеФормы")
		Или ТипЗнч(Элемент) = Тип("ДекорацияФормы") Тогда
		Расширение = ТипыКлиентСерверПовтИсп_Ei.РасширенияЭлементов().Получить(Элемент.Вид);
	КонецЕсли;
	Возврат НаследованиеФормВызовСервера_Ei.ПолучитьСвойстваЭлемента(Тип, Расширение);
КонецФункции

Процедура ОбработкаОшибкиПолученияСвойства(Элемент,ИмяСвойства) Экспорт
	СтопСлова = Новый Соответствие;
	СтопСлова.Вставить("недоступно","");
	#Если Клиент Тогда
	СтопСлова.Вставить("непредвиденная","");	
	#КонецЕсли	
	Краткое = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	Если ОбщегоНазначенияКлиентСервер_Ei.СтрЗаменитьИзСписка(нРег(Краткое),СтопСлова) = Краткое Тогда
		Сообщить(СтрШаблон("Свойство %1 для %2 %3",ИмяСвойства,ТипЗнч(Элемент),Краткое),СтатусСообщения.Важное);
	КонецЕсли;
КонецПроцедуры		

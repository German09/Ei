// Получает все возможные типы отображение результатов
// 
// Возвращаемое значение:
//  Соответствие - Имя типа отображения результата и общий модуль в котором описана все необходимые процедуры данного типа варианта 
Функция ПолучитьРезультаты() Экспорт
	Результат 	= Новый Соответствие;
	СтрВарианты = ОбщийМодульВызовСервера_Ei.ПолучитьСоставПодсистемы("Результаты_Ei");
	Для Каждого СтрВариант ИЗ СтрВарианты Цикл
		Попытка
			Вариант = Вычислить(СтрВариант);
			Результат.Вставить(Вариант.Свойства().Имя,Вариант);
		Исключение
		КонецПопытки;	
	КонецЦикла;
	Возврат Результат;
КонецФункции


// Клиентская часть истории запусков Ei: запуск варианта, просмотр истории варианта и параметра,
// восстановление запуска в подстроку вместе с параметрами и результатом.
// Описание запуска см. ИсторияКлиентСервер_Ei, хранение см. ИсторияВызовСервера_Ei

#Область ПрограммныйИнтерфейс

// Идентификатор нового запуска варианта. Его нужно передать в параметры сеанса до выполнения,
// см. ВариантыКлиент_Ei.ОбновитьВаринаты
//
// Параметры:
//  Вариант - ОбщийМодуль - модуль варианта
//
// Возвращаемое значение:
//  Строка, Неопределено - Неопределено для вариантов, которые не выполняются
//
Функция НовыйИдентификаторЗапуска(Вариант) Экспорт
	
	Ид = Неопределено;
	Если Вариант.Свойства().Исполнение Тогда
		Ид = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	
	Возврат Ид;
	
КонецФункции

// Начинает запуск варианта строки набора.
//
// Параметры:
//  Ид - Строка, Неопределено - см. НовыйИдентификаторЗапуска
//  ТекД - ДанныеФормыЭлементДерева - строка набора
//  Вариант - ОбщийМодуль - модуль варианта
//  ДопПараметры - Структура - параметры выполнения; Инструкция в них - выполняемый фрагмент
//
// Возвращаемое значение:
//  Структура, Неопределено - запуск, см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//  или Неопределено, если запуск не ведется
//
Функция НачатьЗапуск(Ид, ТекД, Вариант, ДопПараметры) Экспорт
	
	Запуск = Неопределено;
	Если Ид <> Неопределено Тогда
		Инструкция = Неопределено;
		Если Не ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(ДопПараметры, "Инструкция", Инструкция) Тогда
			ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(Вариант.ПодготовитьДанные(ТекД), "Инструкция", Инструкция);
		КонецЕсли;
		ИмяВарианта = Вариант.Свойства().Имя;
		Запуск = ИсторияКлиентСервер_Ei.НовыйЗапуск(Ид, ИсторияКлиентСервер_Ei.КлючВарианта(ТекД.КлючНастроек, ИмяВарианта),
			ИмяВарианта, Инструкция);
	КонецЕсли;
	
	Возврат Запуск;
	
КонецФункции

// Завершает запуск варианта и записывает его в историю. Повторное завершение ничего не делает.
//
// Параметры:
//  Запуск - Структура, Неопределено - запуск, см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//  ОписаниеЗначения - Произвольный - результат варианта
//  ИнформацияОбОшибке - Неопределено, ИнформацияОбОшибке - ошибка выполнения
//
Процедура ЗавершитьЗапуск(Запуск, ОписаниеЗначения, ИнформацияОбОшибке = Неопределено) Экспорт
	
	Если Запуск = Неопределено Или Запуск.Завершен Тогда
		Возврат;
	КонецЕсли;
	
	Запуск.Завершен = Истина;
	Если Запуск.Длительность = 0 Тогда
		Запуск.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Запуск.Начало;
	КонецЕсли;
	Если ИнформацияОбОшибке <> Неопределено Тогда
		Запуск.Статус = ИсторияКлиентСервер_Ei.СтатусыЗапуска().Ошибка;
		Запуск.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	КонецЕсли;
	
	Попытка
		ИсторияВызовСервера_Ei.ЗавершитьЗапускВарианта(Запуск, ОписаниеЗначения);
	Исключение
		// История не должна мешать работе: запуск теряется, пользователь узнает об этом.
		ПоказатьОповещениеПользователя(НСтр("ru = 'История Ei: запуск не записан'"), ,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), БиблиотекаКартинок.Предупреждение);
	КонецПопытки;
	
КонецПроцедуры

// Заполняет в запуске метрики, которые форма Ei показывает на закладках варианта и результата.
// Вызывается после выполнения варианта и загрузки результата.
//
// Параметры:
//  Запуск - Структура, Неопределено - запуск, см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//  Форма - см. ОбщаяФорма.Ei
//  ТекД - ДанныеФормыЭлементДерева - строка набора
//  Вариант - ОбщийМодуль - модуль варианта
//  ВремяВыполнения - Число - миллисекунды выполнения варианта, как на его закладке
//  СРезультатом - Булево - результат загружен, его метрики тоже нужны
//
Процедура ЗаполнитьМетрики(Запуск, Форма, ТекД, Вариант, ВремяВыполнения, СРезультатом) Экспорт
	
	Если Запуск = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запуск.Длительность = ВремяВыполнения;
	Запуск.РазмерВарианта = Вариант.ПолучитьРазмерность(Форма, ТекД);
	
	Если СРезультатом Тогда
		ОбработчикРезультата = РезультатыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма, ТекД);
		Если ОбработчикРезультата <> Неопределено Тогда
			Запуск.СинонимРезультата = ОбработчикРезультата.Свойства().Синоним;
			Запуск.РазмерРезультата = НастройкиПользователяКлиентСервер_Ei.ПолучитьРазмерность(ТекД, Форма.НастройкиПользователя,
				ОбработчикРезультата);
			ВремяРезультата = НастройкиПользователяКлиентСервер_Ei.ПолучитьЗатраченноеВремя(ТекД, Форма.НастройкиПользователя,
				ОбработчикРезультата);
			Запуск.ВремяРезультата = ?(ЗначениеЗаполнено(ВремяРезультата), ВремяРезультата, 0);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Метрики запуска в формате закладок формы: размерность и время выполнения,
// после ▶ - вид, размерность и время результата или ошибка.
//
// Параметры:
//  Запуск - Структура, Неопределено - запуск, см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//  СВременем - Булево - выводить время; в журнале выполнения время показывает отдельная колонка
//
// Возвращаемое значение:
//  Строка
//
Функция МетрикиЗапуска(Запуск, СВременем) Экспорт
	
	Части = Новый Массив; // Массив из Строка
	Если Запуск <> Неопределено Тогда
		ДобавитьМетрику(Части, "", Запуск.РазмерВарианта, ?(СВременем, Запуск.Длительность, 0));
		Части.Добавить("▶");
		Если Запуск.Статус = ИсторияКлиентСервер_Ei.СтатусыЗапуска().Ошибка Тогда
			Части.Добавить(НСтр("ru = 'Ошибка:'"));
			Части.Добавить(Лев(СокрЛП(СтрПолучитьСтроку(Запуск.Ошибка, 1)), 80));
		ИначеЕсли ЗначениеЗаполнено(Запуск.СинонимРезультата) Тогда
			ДобавитьМетрику(Части, Запуск.СинонимРезультата, Запуск.РазмерРезультата, ?(СВременем, Запуск.ВремяРезультата, 0));
		Иначе
			Части.Добавить(Лев(Запуск.ПредставлениеРезультата, 80));
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтрСоединить(Части, " ");
	
КонецФункции

// Дописывает в корневой замер журнала выполнения метрики и инструкцию запуска варианта
// и данные, по которым запуск можно восстановить из журнала, см. ВосстановитьЗапускВарианта
//
// Параметры:
//  Замер - см. ЖурналКлиентСервер_Ei.НачатьЗамер
//  Запуск - Структура, Неопределено - запуск, см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//  ТекД - ДанныеФормыЭлементДерева - строка набора
//
Процедура ОписатьЗамерЗапуска(Замер, Запуск, ТекД) Экспорт
	
	Если Запуск = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Замер.Операция = СтрШаблон("%1 %2%3%4", СтрПолучитьСтроку(Замер.Операция, 1), МетрикиЗапуска(Запуск, Ложь),
		Символы.ПС, Строка(Запуск.Инструкция));
	Замер.Контекст = Новый Структура("КлючСтроки, Вариант, Запуск", Строка(ТекД.КлючНастроек), Запуск.Имя, Запуск.Ид);
	
КонецПроцедуры

// Восстанавливает запуск варианта в подстроку строки набора, как при выборе в истории.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  КлючСтроки - Строка - КлючНастроек строки набора
//  ИмяВарианта - Строка
//  ИдЗапуска - Строка
//
Процедура ВосстановитьЗапускВарианта(Форма, КлючСтроки, ИмяВарианта, ИдЗапуска) Экспорт
	
	Отбор = Новый Структура("КлючНастроек", Новый УникальныйИдентификатор(КлючСтроки));
	Строки = ОбщегоНазначенияКлиентСервер_Ei.НайтиВКоллекцииДерева(Отбор, НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма));
	Если Строки.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Строка запуска не найдена в открытом наборе'"));
		Возврат;
	КонецЕсли;
	СтрокаНабора = Строки.Получить(0);
	
	Запуск = Неопределено;
	Для Каждого ЭлементИстории Из ИсторияВызовСервера_Ei.Запуски(ИсторияКлиентСервер_Ei.КлючВарианта(КлючСтроки, ИмяВарианта)) Цикл
		Если ЭлементИстории.Ид = ИдЗапуска Тогда
			Запуск = ЭлементИстории;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Запуск = Неопределено Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Запуска уже нет в истории'"));
		Возврат;
	КонецЕсли;
	
	ВосстановитьЗапуск(Форма, СтрокаНабора, Запуск);
	
КонецПроцедуры

// Показывает историю запусков текущего варианта текущей строки. Выбранный запуск восстанавливается
// в новую подстроку вместе с параметрами и результатом или ошибкой.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//
Асинх Процедура ПоказатьИсторию(Форма) Экспорт
	
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Вариант = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма, ТекД);
	Если Вариант = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдСтроки = ТекД.ПолучитьИдентификатор();
	ЗаголовокИстории = СтрШаблон("%1 / %2", ТекД.ИмяНабора, Вариант.Свойства().Синоним);
	Запуски = ИсторияВызовСервера_Ei.Запуски(ИсторияКлиентСервер_Ei.КлючВарианта(ТекД.КлючНастроек, Вариант.Свойства().Имя));
	Запуск = Ждать ВыбратьЗапуск(Запуски, ЗаголовокИстории);
	Если Запуск = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаНабора = СтрокаНабораПоИдентификатору(Форма, ИдСтроки);
	Если СтрокаНабора <> Неопределено Тогда
		ВосстановитьЗапуск(Форма, СтрокаНабора, Запуск);
	КонецЕсли;
	
КонецПроцедуры

// Показывает историю вычислений текущего параметра текущей строки. Выбранное вычисление восстанавливается
// в новую подстроку: параметр с выражением из запуска, вызванные из него параметры и алгоритм,
// который возвращает значение параметра. Сохраненное значение сразу показывается как результат.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//
Асинх Процедура ПоказатьИсториюПараметра(Форма) Экспорт
	
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	ТекущийПараметр = Форма.Элементы.ДеревоЗапросовПараметрыЗапроса.ТекущиеДанные;
	Если ТекД = Неопределено Или ТекущийПараметр = Неопределено Или Не ЗначениеЗаполнено(ТекущийПараметр.ИмяПараметра) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Выберите параметр'"));
		Возврат;
	КонецЕсли;
	
	ИдСтроки = ТекД.ПолучитьИдентификатор();
	ИмяПараметра = ТекущийПараметр.ИмяПараметра;
	ЗаголовокИстории = СтрШаблон("%1 / %2", ТекД.ИмяНабора, ИмяПараметра);
	Запуски = ИсторияВызовСервера_Ei.Запуски(ИсторияКлиентСервер_Ei.КлючПараметра(ТекД.КлючНастроек, ИмяПараметра));
	Запуск = Ждать ВыбратьЗапуск(Запуски, ЗаголовокИстории);
	Если Запуск = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗапускиПараметров = ИсторияВызовСервера_Ei.ЗапускиПараметров(ТекД.КлючНастроек, ИменаПараметров(ТекД), Запуск.Ид);
	ЗапускиПараметров.Вставить(0, Запуск);
	ИмяВарианта = ВариантАлгоритмКлиентСервер_Ei.Свойства().Имя;
	Инструкция = СтрШаблон("Параметры(""%1"")", ИмяПараметра);
	НоваяСтрока = ВосстановитьВПодстроку(Форма, ИдСтроки, ИмяВарианта, Инструкция, Запуск.Дата, ЗапускиПараметров);
	Если НоваяСтрока <> Неопределено Тогда
		ПоказатьРезультатЗапуска(Форма, НоваяСтрока, Запуск, ИмяВарианта);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Восстанавливает запуск варианта в новую подстроку строки набора вместе с параметрами,
// вычисленными в запуске, и показывает его результат или ошибку.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  СтрокаНабора - ДанныеФормыЭлементДерева
//  Запуск - см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//
Процедура ВосстановитьЗапуск(Форма, СтрокаНабора, Запуск)
	
	ЗапускиПараметров = ИсторияВызовСервера_Ei.ЗапускиПараметров(СтрокаНабора.КлючНастроек, ИменаПараметров(СтрокаНабора), Запуск.Ид);
	НоваяСтрока = ВосстановитьВПодстроку(Форма, СтрокаНабора.ПолучитьИдентификатор(), Запуск.Имя, Запуск.Инструкция, Запуск.Дата,
		ЗапускиПараметров);
	Если НоваяСтрока <> Неопределено Тогда
		ПоказатьРезультатЗапуска(Форма, НоваяСтрока, Запуск, Запуск.Имя);
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  Запуски - Массив из см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//  ЗаголовокИстории - Строка
//
// Возвращаемое значение:
//  Обещание - выбранный запуск или Неопределено
//
Асинх Функция ВыбратьЗапуск(Запуски, ЗаголовокИстории)
	
	Запуск = Неопределено;
	Если Запуски.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'История пуста'"), , ЗаголовокИстории);
	Иначе
		СписокЗапусков = Новый СписокЗначений;
		Для Каждого ЭлементИстории Из Запуски Цикл
			СписокЗапусков.Добавить(ЭлементИстории, ПредставлениеЗапуска(ЭлементИстории));
		КонецЦикла;
		ВыбранныйЗапуск = Ждать СписокЗапусков.ВыбратьЭлементАсинх(ЗаголовокИстории);
		Если ВыбранныйЗапуск <> Неопределено Тогда
			Запуск = ВыбранныйЗапуск.Значение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Запуск;
	
КонецФункции

// Строка списка истории в формате закладок формы: дата, размерность и время выполнения,
// после ▶ - вид, размерность и время результата или ошибка.
//
// Параметры:
//  Запуск - см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеЗапуска(Запуск)
	
	Возврат Формат(Запуск.Дата, "ДФ='dd.MM.yy HH:mm:ss'") + " " + МетрикиЗапуска(Запуск, Истина);
	
КонецФункции

// Добавляет метрику так же, как она выводится в заголовке закладки: вид (размерность) время.
//
// Параметры:
//  Части - Массив из Строка
//  Вид - Строка
//  Размерность - Строка, Число
//  Время - Число - миллисекунды, 0 - не выводится
//
Процедура ДобавитьМетрику(Части, Вид, Размерность, Время)
	
	Если ЗначениеЗаполнено(Вид) Тогда
		Части.Добавить(Вид);
	КонецЕсли;
	Если ЗначениеЗаполнено(Размерность) Тогда
		Части.Добавить(СтрШаблон("(%1)", Размерность));
	КонецЕсли;
	Если ЗначениеЗаполнено(Время) Тогда
		Части.Добавить(ОбщегоНазначенияКлиент_Ei.ФорматироватьВремя(Время));
	КонецЕсли;
	
КонецПроцедуры

// Показывает в строке набора сохраненный результат запуска так же, как после выполнения,
// а для запуска с ошибкой - ошибку в полосе ошибок варианта.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  СтрокаНабора - ДанныеФормыЭлементДерева - текущая строка набора
//  Запуск - см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//  ИмяВарианта - Строка - вариант строки, в котором показать результат
//
Процедура ПоказатьРезультатЗапуска(Форма, СтрокаНабора, Запуск, ИмяВарианта)
	
	Вариант = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(ИмяВарианта);
	Если Вариант = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Время выполнения - на закладку варианта, метрики результата сохранит его загрузка.
	НастройкиПользователяКлиентСервер_Ei.СохранитьЗатраченноеВремя(СтрокаНабора, Форма.НастройкиПользователя, Вариант,
		Запуск.Длительность);
	Форма.ПодключитьОбработчикОжидания("ОбновитьЗаголовкиЗакладок", 0.1, Истина);
	
	Если ЗначениеЗаполнено(Запуск.Ошибка) Тогда
		ОтладкаКлиент_Ei.ПоказатьИсключение(Форма, Запуск.Ошибка, ВариантыКлиентСервер_Ei, Вариант);
	ИначеЕсли Запуск.ЕстьСнимок Тогда
		ОписаниеЗначения = ИсторияВызовСервера_Ei.ОписаниеРезультата(Запуск.Ид, Форма.УникальныйИдентификатор);
		Если ОписаниеЗначения <> Неопределено Тогда
			ВариантыКлиент_Ei.ПоказатьОписаниеРезультата(Форма, СтрокаНабора, Вариант, ОписаниеЗначения);
		КонецЕсли;
		Если Запуск.СнимокУсечен Тогда
			ПоказатьОповещениеПользователя(НСтр("ru = 'Показана часть результата'"), , Запуск.ПредставлениеРезультата,
				БиблиотекаКартинок.Информация);
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Запуск.ПредставлениеРезультата) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Результат запуска не сохранен'"), , Запуск.ПредставлениеРезультата,
			БиблиотекаКартинок.Предупреждение);
	КонецЕсли;
	
КонецПроцедуры

// Создает под строкой новую несохраненную подстроку с инструкцией варианта и параметрами из запуска.
// Исходная строка не меняется.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  ИдСтроки - Число - идентификатор строки набора
//  ИмяВарианта - Строка - вариант подстроки, в который положить инструкцию
//  Инструкция - Произвольный
//  ДатаЗапуска - Дата - для имени подстроки
//  ЗапускиПараметров - Массив из см. ИсторияКлиентСервер_Ei.НовыйЗапуск - параметры для переноса
//
// Возвращаемое значение:
//  ДанныеФормыЭлементДерева, Неопределено - новая подстрока, она становится текущей
//
Функция ВосстановитьВПодстроку(Форма, ИдСтроки, ИмяВарианта, Инструкция, ДатаЗапуска, ЗапускиПараметров)
	
	НоваяСтрока = Неопределено;
	Родитель = СтрокаНабораПоИдентификатору(Форма, ИдСтроки);
	Если Родитель = Неопределено Тогда
		Возврат НоваяСтрока;
	КонецЕсли;
	
	НоваяСтрока = Родитель.ПолучитьЭлементы().Добавить();
	ИмяКандидат = СтрШаблон("%1_%2", Родитель.ИмяНабора, Формат(ДатаЗапуска, "ДФ=ddMMyyHHmmss"));
	НоваяСтрока.ИмяНабора = ОбщегоНазначенияКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("ИмяНабора", ИмяКандидат),
		НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма));
	НоваяСтрока.КлючНастроек = ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(Новый УникальныйИдентификатор,
		НаборВариантовКлиент_Ei.Ключ(Форма));
	НоваяСтрока[ИмяВарианта] = Инструкция;
	ПеренестиПараметры(Родитель, НоваяСтрока, ЗапускиПараметров);
	ПараметрыКлиент_Ei.ОбновитьКлючи(НоваяСтрока);
	ВариантыКлиент_Ei.СохранитьТекущийОбработчик(Форма, НоваяСтрока, ИмяВарианта);
	КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
	
	НаборВариантовКлиент_Ei.АктивизироватьСтроку(Форма, НоваяСтрока.ПолучитьИдентификатор());
	
	Возврат НоваяСтрока;
	
КонецФункции

// Переносит в подстроку параметры, вычисленные в запуске: строку параметра берет из исходной строки,
// выражение - из запуска параметра.
//
// Параметры:
//  Родитель - ДанныеФормыЭлементДерева
//  НоваяСтрока - ДанныеФормыЭлементДерева
//  ЗапускиПараметров - Массив из см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//
Процедура ПеренестиПараметры(Родитель, НоваяСтрока, ЗапускиПараметров)
	
	Для Каждого ЗапускПараметра Из ЗапускиПараметров Цикл
		Отбор = Новый Структура("ИмяПараметра", ЗапускПараметра.Имя);
		Для Каждого Параметр Из Родитель.ПараметрыЗапроса.НайтиСтроки(Отбор) Цикл
			НовыйПараметр = НоваяСтрока.ПараметрыЗапроса.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйПараметр, Параметр);
			// Значение без выражения уже скопировано из строки, выражение берется то, что вычислялось в запуске.
			Если ЗапускПараметра.ЭтоВыражение Тогда
				НовыйПараметр.ЭтоВыражение = Истина;
				НовыйПараметр.ЗначениеПараметра = ЗапускПараметра.Инструкция;
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Параметры:
//  СтрокаНабора - ДанныеФормыЭлементДерева
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ИменаПараметров(СтрокаНабора)
	
	Имена = Новый Массив; // Массив из Строка
	Для Каждого Параметр Из СтрокаНабора.ПараметрыЗапроса Цикл
		Если ЗначениеЗаполнено(Параметр.ИмяПараметра) Тогда
			Имена.Добавить(Параметр.ИмяПараметра);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Имена;
	
КонецФункции

// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  ИдСтроки - Число
//
// Возвращаемое значение:
//  ДанныеФормыЭлементДерева, Неопределено
//
Функция СтрокаНабораПоИдентификатору(Форма, ИдСтроки)
	
	Возврат Форма[КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента()].НайтиПоИдентификатору(ИдСтроки);
	
КонецФункции

#КонецОбласти

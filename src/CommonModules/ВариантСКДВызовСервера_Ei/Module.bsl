// Функция - Получить параметры из CКД
//
// Параметры:
//  ТекстЗапроса - Строка	 - Текст СКД
// 
// Возвращаемое значение:
//   - Массив структур аналогичных описанию парамемтров 
//
Функция ПолучитьПараметры(ТекстСКД) Экспорт
	Попытка
		СКД				= ОбщийМодульКлиентСервер_Ei.Структурировать(ТекстСКД, Новый СхемаКомпоновкиДанных);
		Параметры 		= СКД.Параметры; 
	Исключение
		Возврат Новый Массив; //видимо ошибка в тексте запроса, по тихому закончим
	КонецПопытки;
	ТабСортировки 		= Новый ТаблицаЗначений;
	ТабСортировки.Колонки.Добавить("ОписаниеПараметра");
	ТабСортировки.Колонки.Добавить("Порядок",Новый ОписаниеТипов("Число"));
	Для Каждого Параметр Из Параметры Цикл
		НоваяСтрока = ТабСортировки.Добавить();	
		НоваяСтрока.ОписаниеПараметра 	= Новый Структура("Имя,ТипЗначения", Параметр.Имя,Параметр.ТипЗначения);
		НоваяСтрока.Порядок 			= Найти(ТекстСКД,"&"+Параметр.Имя);
	КонецЦикла;
	ТабСортировки.Сортировать("Порядок Возр");
	Возврат ТабСортировки.ВыгрузитьКолонку("ОписаниеПараметра");
КонецФункции
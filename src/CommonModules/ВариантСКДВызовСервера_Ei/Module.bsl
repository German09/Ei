// Функция - Получить параметры из CКД
//
// Параметры:
//  ТекстСКД - Строка- Текст СКД
// 
// Возвращаемое значение:
//   см. ПараметрыВызовСервера_Ei.ПолучитьПараметры
//
Функция ПолучитьПараметры(ТекстСКД) Экспорт
	Попытка
		СКД				= ОбщегоНазначенияКлиентСервер_Ei.Структурировать(ТекстСКД, Новый СхемаКомпоновкиДанных);
		Параметры 		= СКД.Параметры; 
	Исключение
		Возврат Новый Массив; //видимо ошибка в тексте запроса, по тихому закончим
	КонецПопытки;
	Возврат ПараметрыВызовСервера_Ei.ПолучитьПараметры(ТекстСКД, Параметры);
КонецФункции


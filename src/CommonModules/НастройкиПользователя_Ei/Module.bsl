#Область ПрограммныйИнтерфейс

Функция ПолучитьНастройки() Экспорт
	Возврат ХранилищеСистемныхНастроек.Загрузить(СтрШаблон("ОбщаяФорма.%1/ТекущиеДанные",ОбщегоНазначенияКлиентСервер_Ei.Постфикс()), "");
КонецФункции

// Запомнить настройки. По умолчанию запоминаются только при корректном закрытии формы
// 
// Параметры:
//  Форма - Форма - см. Обработка.Ei.Форма.Форма
Процедура ЗапомнитьНастройки(Форма) Экспорт
	Настройки = Новый Соответствие();
	Настройки.Вставить("ДеревоЗапросов", 			Форма.РеквизитФормыВЗначение("ДеревоЗапросов"));
	Настройки.Вставить("ИмяФайлаНастройки", 		Форма.ИмяФайлаНастройки);
	Настройки.Вставить("СохраненныйОбраз",			Форма.СохраненныйОбраз);
	Настройки.Вставить("СтрНастройкиПользователя",	Форма.СтрНастройкиПользователя);
	ХранилищеСистемныхНастроек.Сохранить(СтрШаблон("%1/ТекущиеДанные",Форма.ИмяФормы), "", Настройки);
КонецПроцедуры

#КонецОбласти
	
Функция Загрузить(Форма,ВариантИД,Результат,ИмяРеквизита,мКолонокРезультата) Экспорт
	Если Результат = Неопределено Тогда
		//это очистка значения
		Результат =  Новый ДеревоЗначений();
	КонецЕсли;	
	Возврат РезультатВызовСервера_Таблица_Ei.ЗагрузитьДляОбработчика(Форма,ВариантИД,Результат,ИмяРеквизита,мКолонокРезультата,РезультатКлиентСервер_Дерево_Ei);;
КонецФункции

// Привести результат к типу, который возможно показать
// 
// Параметры:
//  СохраненныйРезультат - Произвольное значение - значение которые мы птыемся показать данным обработчиком
// 
// Возвращаемое значение:
//	Произвольное значение - Значение приведенное к типу	который можно тут отобразить   
Функция ПривестиРезультат(СохраненныйРезультат) Экспорт
	ОписаниеТипаРезультата 	= Новый ОписаниеТипов(РезультатКлиентСервер_Дерево_Ei.Свойства().Имя);
	Результат 				= ОписаниеТипаРезультата.ПривестиЗначение(Неопределено);
	Если ТипЗнч(СохраненныйРезультат) = Тип("МакетКомпоновкиДанных") Тогда				
		РезультатыСервер_Ei.ВывестиВКоллекециюСКД(СохраненныйРезультат,Результат);
	ИначеЕсли ТипЗнч(СохраненныйРезультат) = Тип("РезультатЗапроса") Тогда
		Результат 	= СохраненныйРезультат.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);	
	ИначеЕсли Не СохраненныйРезультат = Неопределено Тогда
		ВызватьИсключение "Не удалось отобразить результат в данном представлении"; 			
	КонецЕсли;
	Возврат Результат;		
КонецФункции

Функция ОпределитьРазмерность(Результат) Экспорт
	Перем ОбъемКоллекции;
	Если ТипЗнч(Результат) = Тип("ДеревоЗначений") Тогда
		ВспомКолонка = Результат.Колонки.Добавить("Вспом"+СтрЗаменить(Новый УникальныйИдентификатор(),"-",""),Новый ОписаниеТипов("Булево"));
			ОбъемКоллекции = ""+ПолучитьСтрокиРезультата(Результат,Ложь,ВспомКолонка.Имя).Количество();
		Результат.Колонки.Удалить(ВспомКолонка);
		Если ЗначениеЗаполнено(ОбъемКоллекции) Тогда
			ОбъемКоллекции = ""+ОбъемКоллекции+"/"+Результат.Колонки.Количество();
		КонецЕсли;				
	КонецЕсли;
	Возврат ОбъемКоллекции;		
КонецФункции

//Полчает строки таблицы значений или дерева с определенным отбором.
//Параметры:
//	Источник				- <Произвольный>. Таблица или дерево значений
//	Значение				- <Булево,Число>. Значение колонки пометки
//	ВспомКолонка			- <Строка>. Имя колонки пометки
//	ИскатьПодчиненные   	- <Булево>. Искать подчиненые, только для источника с типом ДеревоЗначений
//	ДополнительноеУсловие   - <Структура>. Дополнительная структура отбора
//Возвращаемое значение
//Массив указателей на нужные строки
Функция ПолучитьСтрокиРезультата(Источник, Значение, ВспомКолонка, ИскатьПодчиненные = Истина, ДополнительноеУсловие = Неопределено)
	Строки			= Новый Массив;
	Если ТипЗнч(Источник) = Тип("ДеревоЗначений") ИЛИ ТипЗнч(Источник) = Тип("ТаблицаЗначений") Тогда
		Если Не Источник.Колонки[ВспомКолонка].ТипЗначения.СодержитТип(Тип("Булево")) Тогда
			Значение = Число(Значение);
		КонецЕсли;
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить(ВспомКолонка,Значение);
		Если ТипЗнч(ДополнительноеУсловие)= Тип("Структура") Тогда
			//пополняем структуру
			Для Каждого Элемент ИЗ ДополнительноеУсловие Цикл
				СтруктураОтбора.Вставить(Элемент.Ключ,Элемент.Значение);		
			КонецЦикла;	
		КонецЕсли;	
		Если Источник.Колонки.Количество() > 0 Тогда
			Если ТипЗнч(Источник)=Тип("ТаблицаЗначений") Тогда 
				Строки	= Источник.НайтиСтроки(СтруктураОтбора);		
			Иначе
				Строки	= Источник.Строки.НайтиСтроки(СтруктураОтбора, ИскатьПодчиненные);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Источник) = Тип("ТабличныйДокумент") Тогда
		Если Значение = Ложь И Источник.ВысотаТаблицы > 1 Тогда 
			Строки = Новый Массив(Источник.ВысотаТаблицы - 1); //Шапка выводится в таблицу убираем ее
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Строки;
КонецФункции

Функция ПолучитьДопустимыеСвойства(Значение, УникальныйИдентификатор) Экспорт
	Результат 				= Новый СписокЗначений;
	Результат.Добавить(ОписаниеЗначенияСервер_Ei.Подготовить(Значение.Строки,УникальныйИдентификатор),"Строки");
	Результат.Добавить(ОписаниеЗначенияСервер_Ei.Подготовить(Значение.Колонки,УникальныйИдентификатор),"Колонки");
	Возврат Результат;		
КонецФункции	
Процедура Инициализация(Форма, Отказ, СтандартнаяОбработка) Экспорт
	Результат 				= ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(Форма.Параметры.ОписаниеЗначения);
	ИмяОсновногоРеквизита   = "Коллекция";
	ИзменитьРеквизиты(Форма, ИмяОсновногоРеквизита, Результат);
	Форма.ЗначениеВРеквизитФормы(Результат, ИмяОсновногоРеквизита);
	мКолонокРезультата 	= ПолучитьКолонки(Результат);
	ДобавитьКолонкиВЭлемент(Форма, 0, ИмяОсновногоРеквизита, ИмяОсновногоРеквизита, мКолонокРезультата);
КонецПроцедуры

Процедура ИзменитьРеквизиты(Форма, ИмяОсновногоРеквизита, Результат) Экспорт
	мРеквизитовДобавление 		= Новый Массив;
	мРеквизитовУдаление 		= Новый Массив;
	мСуществующихРеквизитов 	= Новый Массив;
	Попытка
		мСуществующихРеквизитов     = Форма.ПолучитьРеквизиты(ИмяОсновногоРеквизита);
	Исключение
		//такого реквизита нет
		мРеквизитовДобавление.Добавить(Новый РеквизитФормы(ИмяОсновногоРеквизита, ТипыКлиентСервер_Ei.СоздатьОписаниеИзКолекции(ТипЗнч(Результат))));
	КонецПопытки;		
	мКолонкиРезультата			= ПолучитьКолонки(Результат);
	Для Каждого Колонка Из мКолонкиРезультата Цикл
		СушРеквизит = Ложь;
		Для Каждого рФормы Из мСуществующихРеквизитов Цикл
			Если рФормы.Имя = Колонка.Колонка.Имя Тогда
				Если рФормы.ТипЗначения = Колонка.Колонка.ТипЗначения Тогда
					СушРеквизит = Истина;
					Прервать;
				Иначе
					//расходятся по типу их нужно добавить в удаляемые, ниже их отловить не удастся
					мРеквизитовУдаление.Добавить(рФормы.Путь + "." + рФормы.Имя);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Не СушРеквизит Тогда
			ДобавитьРеквизит(мРеквизитовДобавление, Колонка, ИмяОсновногоРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	//Удалим ранее сущесвующие реквизиты, их по какой то причине не было на форме, возможно ошибка возникла раньше добавления на форму в момент загрузки данных
	Для Каждого Реквизит Из мСуществующихРеквизитов Цикл
		Если Результат.Колонки.Найти(Реквизит.Имя) = Неопределено Тогда
			ПолноеИмя = Реквизит.Путь + "." + Реквизит.Имя;
			Если мРеквизитовУдаление.Найти(ПолноеИмя) = Неопределено Тогда
				мРеквизитовУдаление.Добавить(ПолноеИмя);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ОсновнойЭлемент 	= Форма.Элементы.Найти(ИмяОсновногоРеквизита);
	Если Не ОсновнойЭлемент = Неопределено Тогда
		//Все остальные проверки имеют смысл если элемент был на Форме
		//
		//Удалим из реквизитов все те что есть на форме но нет в ТЗ (с большой долейвероятности они были раньше)
		Для Каждого КолонкаФормы Из ОсновнойЭлемент.ПодчиненныеЭлементы Цикл
			Если ТипЗнч(КолонкаФормы) = Тип("ПолеФормы") Тогда
				Если Результат.Колонки.Найти(СтрРазделить(КолонкаФормы.ПутьКДанным, ".")[1]) = Неопределено Тогда
					ПолноеИмя = КолонкаФормы.ПутьКданным;
					Если мРеквизитовУдаление.Найти(ПолноеИмя) = Неопределено Тогда
						мРеквизитовУдаление.Добавить(КолонкаФормы.ПутьКданным);
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;  
		
		//В том числе, вложенные ТЧ
		Для Каждого Эл_Страницы Из ОсновнойЭлемент.Родитель.ПодчиненныеЭлементы Цикл
			Если ТипЗнч(Эл_Страницы) = Тип("ГруппаФормы") Тогда
				Для Каждого Эл_Страница Из Эл_Страницы.ПодчиненныеЭлементы Цикл
					Если ТипЗнч(Эл_Страница) = Тип("ГруппаФормы") Тогда
						Для Каждого Эл_Таблица Из Эл_Страница.ПодчиненныеЭлементы Цикл
							Если ТипЗнч(Эл_Таблица) = Тип("ТаблицаФормы") Тогда
								ИмяКолонкиСВложеннойТаб = СтрРазделить(Эл_Таблица.ПутьКДанным, ".")[3];
								Если Результат.Колонки.Найти(ИмяКолонкиСВложеннойТаб) = Неопределено Тогда
									мРеквизитовУдаление.Добавить(ИмяОсновногоРеквизита + "." + ИмяКолонкиСВложеннойТаб);
									Форма.Элементы.Удалить(Эл_Таблица);
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Форма.ИзменитьРеквизиты(мРеквизитовДобавление, мРеквизитовУдаление);
КонецПроцедуры

Процедура ДобавитьРеквизит(мРеквизитовДобавление, Колонка, Путь)
	ТипЗначения =  Колонка.Колонка.ТипЗначения;
	Если ТипЗначения.СодержитТип(Тип("Тип")) Тогда
		ТипЗначения =  Новый ОписаниеТипов; //пустой тип это произвольный, не все типы можно добавлять на форму, к таким например относится Тип, на форму можно добавлять описание типов  #СпецОбработкаТипа
	КонецЕсли;
	мРеквизитовДобавление.Добавить(Новый РеквизитФормы(Колонка.Колонка.Имя, ТипЗначения, Путь));
	ВложенныйПуть = Путь + "." + Колонка.Колонка.Имя;
	Для Каждого ВложеннаяКолонка Из Колонка.мКолонки Цикл
		ДобавитьРеквизит(мРеквизитовДобавление, ВложеннаяКолонка, ВложенныйПуть);
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьКолонкиВЭлемент(Форма, ИдентификаторКолонок, ИмяОсновногоРеквизита, ПутьКДанным, мКолонокРезультата, МестоНахождение = Неопределено) Экспорт
	Если мКолонокРезультата.Количество() Тогда
		Ном 			= мКолонокРезультата.Количество() - 1;
		ПредКолонка 	= Неопределено;
		ОсновнойЭлемент = ПолучитьТаблицуФормы(Форма,ИмяОсновногоРеквизита,ПутьКДанным,МестоНахождение);
		Если НЕ ОсновнойЭлемент = Неопределено Тогда 
			Пока Ном >= 0 Цикл  //обязательно обходим с конца чтобы можно было вставлять колонки
				Колонка 			= мКолонокРезультата.Получить(Ном).Колонка;
				мВложенныхКолонок   = мКолонокРезультата.Получить(Ном).мКолонки;
				стрИмя 				= ИмяОсновногоРеквизита + Колонка.Имя;
				НовыйЭлемент 		= ОсновнойЭлемент.ПодчиненныеЭлементы.Найти(стрИмя);
				Если НовыйЭлемент = Неопределено Тогда
					Если ТипыВызовСервера_Ei.ОписаниеВложеннойКоллекции(Колонка.ТипЗначения) Тогда
						Если мВложенныхКолонок.Количество() Тогда
							Страница = ПолучитьСтраницу(Форма, ИдентификаторКолонок, ИмяОсновногоРеквизита, ОсновнойЭлемент, Колонка);
							ИмяВложенногоРеквизита         	= ИмяОсновногоРеквизита + "_" + Формат(ИдентификаторКолонок,"ЧН=0; ЧГ=") + "_" + Колонка.Имя;
							ПутьКДаннымВложенногоРеквизита 	= "Элементы." + ИмяОсновногоРеквизита + ".ТекущиеДанные." + Колонка.Имя;
							ДобавитьКолонкиВЭлемент(Форма, ИдентификаторКолонок, ИмяВложенногоРеквизита, ПутьКДаннымВложенногоРеквизита, мВложенныхКолонок, Страница);
						КонецЕсли;
					Иначе
						НовыйЭлемент 				= Форма.Элементы.Вставить(стрИмя, Тип("ПолеФормы"),	ОсновнойЭлемент, ПредКолонка);
						НовыйЭлемент.ПутьКДанным 	= ПутьКДанным + "." + Колонка.Имя;
						ЗаполнитьСвостваЭлемента(НовыйЭлемент,Колонка); 
					КонецЕсли;
				Иначе
					//проверим порядок этой колонки
					Форма.Элементы.Переместить(НовыйЭлемент,ОсновнойЭлемент,ПредКолонка);
					ЗаполнитьСвостваЭлемента(НовыйЭлемент,Колонка); 	
				КонецЕсли;
				ПредКолонка = НовыйЭлемент;
				Ном = Ном - 1;
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Функция ПолучитьСтраницу(Форма, ИдентификаторКолонок, ИмяОсновногоРеквизита, ОсновнойЭлемент, Колонка)
	Эл_Страницы = ПолучитьСтраницы(Форма, ИдентификаторКолонок, ИмяОсновногоРеквизита, ОсновнойЭлемент);
	Эл_СтраницаИмя	= Эл_Страницы.Имя + "_" + Колонка.Имя;
	Эл_Страница 	= Эл_Страницы.ПодчиненныеЭлементы.Найти(Эл_СтраницаИмя);//Элементы[ИмяОсновногоРеквизита].Родитель.Имя);
	Если Эл_Страница = Неопределено Тогда
		Эл_Страница = Форма.Элементы.Добавить(Эл_СтраницаИмя, Тип("ГруппаФормы"), Эл_Страницы);
		Эл_Страница.Вид			= ВидГруппыФормы.Страница;
		Эл_Страница.Заголовок 	= Колонка.Имя;//+?(ВложеннаяТЗ.Количество()," ("+ВложеннаяТЗ.Количество()+")",""); Кол-во нужно считать при активизации строки
	КонецЕсли;
	Возврат Эл_Страница;
КонецФункции

Функция ПолучитьСтраницы(Форма, ИдентификаторКолонок, ИмяОсновногоРеквизита, ОсновнойЭлемент)
	Эл_СтраницыИмя 	= ИмяОсновногоРеквизита + "_" + Формат(ИдентификаторКолонок, "ЧН=0; ЧГ=") + КоллекцияСтруктураКлиентСервер_Ei.ПризнакВложеннойГруппы();
	Эл_Страницы 	= ОсновнойЭлемент.Родитель.ПодчиненныеЭлементы.Найти(Эл_СтраницыИмя);//Элементы[ИмяОсновногоРеквизита].Родитель.Имя);
	Если Эл_Страницы = Неопределено Тогда
		ОсновнойЭлемент.Родитель.Группировка =  ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		Эл_Страницы 					= Форма.Элементы.Добавить(Эл_СтраницыИмя, Тип("ГруппаФормы"),ОсновнойЭлемент.Родитель);
		Эл_Страницы.Вид					= ВидГруппыФормы.Страницы;
		Эл_Страницы.ОтображениеСтраниц 	= ОтображениеСтраницФормы.ЗакладкиСнизу;
	КонецЕсли;
	Возврат Эл_Страницы;
КонецФункции

Процедура ЗаполнитьСвостваЭлемента(Элемент,Колонка)
	Если Колонка.ТипЗначения = Новый ОписаниеТипов("Булево") Тогда
		Элемент.Вид = ВидПоляФормы.ПолеФлажка;
	Иначе	 
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
	КонецЕсли;
	Элемент.Заголовок 	= Колонка.Имя; //имя используется при адресации при выборе
	Элемент.Ширина = 10;	 		
Конецпроцедуры	

Функция ПолучитьКолонки(Коллекция) Экспорт
	Результат 		= Новый Массив;
	ТекущийНабор 	= Неопределено;
	Если ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
		ТекущийНабор 	=  Коллекция
	ИначеЕсли ТипЗнч(Коллекция) = Тип("ДеревоЗначений") Тогда
		ТекущийНабор 	=  Коллекция.Строки;	
	КонецЕсли;	
	Для Каждого Колонка ИЗ Коллекция.Колонки Цикл
		мВложенныхКолонок =  Новый Массив;
		Если ТипыВызовСервера_Ei.ОписаниеВложеннойКоллекции(Колонка.ТипЗначения) Тогда
			Если Не ТекущийНабор = Неопределено Тогда
				Для Каждого Подстрока ИЗ ТекущийНабор Цикл
					Если Подстрока[Колонка.Имя].Количество() Тогда
						мВложенныхКолонок = ПолучитьКолонки(Подстрока[Колонка.Имя]);
						Прервать;
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Колонка,мКолонки",Новый Структура("Имя,ТипЗначения",Колонка.Имя,Колонка.ТипЗначения),мВложенныхКолонок)); //объект возвращается на клиент для создания граф схемы поэтому приводим к простому типу
	КонецЦикла;	
	Возврат Результат;
КонецФункции

Функция ПолучитьТаблицуФормы(Форма, ИмяРеквизита, ПутьКДанным, Страница) Экспорт
	Элемент 	= Форма.Элементы.Найти(ИмяРеквизита);
	Если Элемент = Неопределено Тогда
		Элемент 	= Форма.Элементы.Добавить(ИмяРеквизита, Тип("ТаблицаФормы"), Страница);
		Элемент.ПоложениеСтрокиПоиска			= ПоложениеСтрокиПоиска.КоманднаяПанель;
		Элемент.ПоложениеСостоянияПросмотра		= ПоложениеСостоянияПросмотра.Верх;
		Элемент.ПоложениеУправленияПоиском		= ПоложениеУправленияПоиском.КоманднаяПанель;	
		Если Найти(нРег(ПутьКДанным),"текущиеданные")  Тогда
			//Это вложенная таблица, для экономии места не показываем ком панель
			Элемент.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
		КонецЕсли;	
		Попытка
			Элемент.ПутьКДанным         		= ПутьКДанным;
		Исключение
			Возврат Неопределено;
		КонецПопытки;
		Элемент.УстановитьДействие("Выбор","КоллекцияВыбор");
		Элемент.УстановитьДействие("ПриАктивизацииЯчейки","КоллекцияПриАктивизацииЯчейки");
		Элемент.УстановитьДействие("ПриАктивизацииСтроки","КоллекцияПриАктивизацииСтроки");	
		Элемент.УстановитьДействие("НачалоПеретаскивания","КоллекцияНачалоПеретаскивания");				
	КонецЕсли;	
	Возврат Элемент;
КонецФункции
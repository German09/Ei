#Область ПрограммныйИнтерфейс

// Инициализация.
// 
// Параметры:
//  Форма 					- Форма
//  Отказ					- Булево
//  СтандартнаяОбработка 	- Булево
Процедура Инициализация(Форма, Отказ, СтандартнаяОбработка) Экспорт
	Результат 				= ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(Форма.Параметры.ОписаниеЗначения);
	Если Не РезультатТаблицаКлиентСервер_Ei.Свойства().Типы.Найти(ОбщегоНазначенияКлиентСервер_Ei.ПолучитьИмяТипЗнч(ТипЗнч(Результат))) = Неопределено	Тогда
		//Если находим в массиве преобразований то запускаем процедуру приведения
		Результат = РезультатТаблицаВызовСервера_Ei.ПривестиРезультат(Результат,Истина);			
	КонецЕсли;
	ИмяОсновногоРеквизита   = КоллекцияСтруктураКлиентСервер_Ei.РеквизитКоллекции();
	КоллекцияРеквизитыСервер_Ei.ИзменитьРеквизиты(Форма, ИмяОсновногоРеквизита, Результат);
	Форма.ЗначениеВРеквизитФормы(Результат, ИмяОсновногоРеквизита);
	КолонокиРезультата 	= ПолучитьКолонки(Результат);
	ДобавитьКолонкиВЭлемент(Форма, 0, ИмяОсновногоРеквизита, ИмяОсновногоРеквизита, КолонокиРезультата);
КонецПроцедуры


// Добавить колонки в элемент.
// 
// Параметры:
//  Форма 					- Форма
//  ИдентификаторКолонок 	- Число - Идентификатор колонок
//  ИмяОсновногоРеквизита 	- см. КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита
//  ПутьКДанным 			- Строка - Путь к данным
//  КолонокиРезультата  	- см. КоллекцияВызовСервера_Ei.ПолучитьКолонки
//  МестоНахождение 		- Неопределено,ГруппаФормы - Место нахождение
//  ИндексСтроки			- Неопределено,Число - Индекс строки в случае если вложенные колонки контекстно зависимы от строки пример выполнение ПакетаЗапросов
//		
Процедура ДобавитьКолонкиВЭлемент(Форма, ИдентификаторКолонок, ИмяОсновногоРеквизита, ПутьКДанным, КолонокиРезультата, МестоНахождение = Неопределено, ИндексСтроки = Неопределено) Экспорт
	Если КолонокиРезультата.Количество() Тогда
		Ном 			= КолонокиРезультата.Количество() - 1;
		ПредКолонка 	= Неопределено;
		ИмяИндексСтроки = ?(ИндексСтроки = Неопределено, "", Формат(ИндексСтроки, "ЧН=0; ЧГ="));
		ОсновнойЭлемент = ПолучитьТаблицуФормы(Форма,ИмяОсновногоРеквизита+ИмяИндексСтроки,ПутьКДанным,МестоНахождение);
		Если НЕ ОсновнойЭлемент = Неопределено Тогда 
			Пока Ном >= 0 Цикл  //обязательно обходим с конца чтобы можно было вставлять колонки
				Колонка 			= КолонокиРезультата.Получить(Ном).Колонка;
				Если Колонка.ИндексСтроки = ИндексСтроки Тогда
					ВложенныеКолоноки   = КолонокиРезультата.Получить(Ном).мКолонки;
					Имя 				= ИмяОсновногоРеквизита + ИмяИндексСтроки + Колонка.Имя;
					НовыйЭлемент 		= ОсновнойЭлемент.ПодчиненныеЭлементы.Найти(Имя);
					Если НовыйЭлемент = Неопределено Тогда
						//добавляем новый
						Если ТипыВызовСервера_Ei.ОписаниеВложеннойКоллекции(Колонка.ТипЗначения) Тогда
							ДобавитьПолеВложенных(Форма, ИдентификаторКолонок, ИмяОсновногоРеквизита+ИмяИндексСтроки, ОсновнойЭлемент, ВложенныеКолоноки, Колонка);
						Иначе
							НовыйЭлемент 				= Форма.Элементы.Вставить(Имя, Тип("ПолеФормы"),	ОсновнойЭлемент, ПредКолонка);
							НовыйЭлемент.ПутьКДанным 	= СтрШаблон("%1.%2",ПутьКДанным,Колонка.Имя);
							ЗаполнитьСвостваЭлемента(НовыйЭлемент,Колонка); 
						КонецЕсли;
					Иначе
						Если ТипыВызовСервера_Ei.ОписаниеВложеннойКоллекции(Колонка.ТипЗначения) Тогда
							//до этого была обычная колонка нужно ее удалить и добавить вложенную таблицу формы
							Форма.Элементы.Удалить(НовыйЭлемент);
							ДобавитьПолеВложенных(Форма, ИдентификаторКолонок, ИмяОсновногоРеквизита+ИмяИндексСтроки, ОсновнойЭлемент, ВложенныеКолоноки, Колонка);	
						Иначе	 
							//проверим порядок этой колонки
							Форма.Элементы.Переместить(НовыйЭлемент,ОсновнойЭлемент,ПредКолонка);
							ЗаполнитьСвостваЭлемента(НовыйЭлемент,Колонка);
						КонецЕсли;	 	
					КонецЕсли;
					ПредКолонка = НовыйЭлемент;
				КонецЕсли;	
				Ном = Ном - 1;
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

// Получить колонки
// возвращается на клиент для создания граф схемы? поэтому приводим к простому типу
// Элементы формы из них формируются см. КоллекцияВызовСервера_Ei.ДобавитьКолонкиВЭлемент
// 
// Параметры:
//  Коллекция 		- ТаблицаЗначений,ДеревоЗначений -
//  ИндексСтроки	- Число,Неопределено - Индекс строки для которой специфична вложенная колонка, если пустой значит нет специфики строк  
// 
// Возвращаемое значение:
//  Массив Из см. ПолучитьКолонку	 
Функция ПолучитьКолонки(Коллекция,ИндексСтроки = Неопределено) Экспорт
	Результат 		= Новый Массив;
	ТекущийНабор 	= Неопределено;
	Если ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
		ТекущийНабор 	=  Коллекция
	ИначеЕсли ТипЗнч(Коллекция) = Тип("ДеревоЗначений") Тогда
		ТекущийНабор 	=  Коллекция.Строки;
	Иначе
		Возврат Результат;		
	КонецЕсли;	
	Для Каждого Колонка ИЗ Коллекция.Колонки Цикл
		мВложенныхКолонок 	= Новый Массив;
		ОписаниеТипа		= Колонка.ТипЗначения;
		Если ТипыВызовСервера_Ei.ОписаниеВложеннойКоллекции(ОписаниеТипа) Тогда
			ОписаниеТипа = ТипыКлиентСервер_Ei.ПолучитьИмяОписанияТипов(ОписаниеТипа,Ложь); 
			//Для возможности передачи данного массива с серваера на клиент, 
			//сложные описания типов передать не получается, сохраним их как строку, 
			//а в остальных местах будем использовать обертку см. ТипыКлиентСервер_Ei.ПроверитьОписание
			ЗаполнитьВложенные(ТекущийНабор, Колонка, мВложенныхКолонок);	
		КонецЕсли;
		Результат.Добавить(ПолучитьКолонку(Колонка.Имя,ОписаниеТипа,мВложенныхКолонок,ИндексСтроки)); 
	КонецЦикла;	
	Возврат Результат;
КонецФункции



// Получить колонку.
// 
// Параметры:
//  Имя 				- Строка - Имя
//  ТипЗначения 		см. ТипыКлиентСервер_Ei.ПолучитьИмяОписанияТипов
//  ВложенныеКолонки 	см. ПолучитьКолонки
//  ИндексСтроки		- Число,Неопределено - Индекс строки для которой специфична данная колонка, если пустой значит нет специфики строк 
// 
// Возвращаемое значение:
//  Структура:
//		*Колонка - Структура:
//			**Имя - Строка -
//			**ТипЗначения 	см. ТипыКлиентСервер_Ei.ПолучитьИмяОписанияТипов
//			**ИндексСтроки 	- Неопределено,Число - Индекс строки верхнеуровневой коллекции для которой необходима данная колонка 
//		*мКолонки  см. ПолучитьКолонки
Функция ПолучитьКолонку(Имя,ТипЗначения,ВложенныеКолонки,ИндексСтроки = Неопределено) Экспорт
	Возврат Новый Структура("Колонка,мКолонки",Новый Структура("Имя,ТипЗначения,ИндексСтроки",Имя,ТипЗначения,ИндексСтроки),ВложенныеКолонки);	
КонецФункции	

// Получить таблицу формы.
// 
// Параметры:
//  Форма 			- Форма - Форма
//  ИмяРеквизита 	- Строка - Имя реквизита
//  ПутьКДанным 	- Строка - Путь к данным
//  Страница 		- Неопределено, ГруппаФормы - Страница
// 
// Возвращаемое значение:
//  ТаблицаФормы, Неопределено -
Функция ПолучитьТаблицуФормы(Форма, ИмяРеквизита, ПутьКДанным, Страница) Экспорт
	Элемент 	= Форма.Элементы.Найти(ИмяРеквизита);
	Если Элемент = Неопределено Тогда
		Элемент 	= Форма.Элементы.Добавить(ИмяРеквизита, Тип("ТаблицаФормы"), Страница);
		Элемент.ПоложениеСтрокиПоиска			= ПоложениеСтрокиПоиска.КоманднаяПанель;
		Элемент.ПоложениеСостоянияПросмотра		= ПоложениеСостоянияПросмотра.Верх;
		Элемент.ПоложениеУправленияПоиском		= ПоложениеУправленияПоиском.КоманднаяПанель;	
		Если СтрНайти(нРег(ПутьКДанным),"текущиеданные")  Тогда
			//Это вложенная таблица, для нее тоже показываем панель
			Элемент.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Низ;
		КонецЕсли;	
		Попытка
			Элемент.ПутьКДанным         		= ПутьКДанным;
		Исключение
			Возврат Неопределено;
		КонецПопытки;
		//Заполним действия
		Элемент.УстановитьДействие("Выбор",					"КоллекцияВыбор");					//см. КоллекцияКлиент_Ei.Выбор
		Элемент.УстановитьДействие("ПриАктивизацииЯчейки",	"КоллекцияПриАктивизацииЯчейки"); 	//см. КоллекцияКлиент_Ei.ПриАктивизацииЯчейки 
		Элемент.УстановитьДействие("ПриАктивизацииСтроки",	"КоллекцияПриАктивизацииСтроки");	//см. КоллекцияКлиент_Ei.ПриАктивизацииСтроки
		Элемент.УстановитьДействие("НачалоПеретаскивания",	"КоллекцияНачалоПеретаскивания");	
		Элемент.Заголовок	= ИмяРеквизита;	 //для простоты отладки		
	КонецЕсли;	
	Возврат Элемент;
КонецФункции

//Полчает строки таблицы значений или дерева с определенным отбором.
//Параметры:
//	Источник				- Произвольный - Таблица или дерево значений
//	Значение				- Булево,Число - Значение колонки пометки
//	ВспомКолонка			- Строка - Имя колонки пометки
//	ИскатьПодчиненные   	- Булево - Искать подчиненые, только для источника с типом ДеревоЗначений
//	ДополнительноеУсловие   - Структура - Дополнительная структура отбора
//Возвращаемое значение:
//	Массив из СтрокаТаблицыЗначений
Функция ПолучитьСтрокиКоллекции(Источник, Значение, ВспомКолонка, ИскатьПодчиненные = Истина, ДополнительноеУсловие = Неопределено) Экспорт
	Строки			= Новый Массив;
	Если ТипЗнч(Источник) = Тип("ДеревоЗначений") ИЛИ ТипЗнч(Источник) = Тип("ТаблицаЗначений") Тогда
		Если Не Источник.Колонки[ВспомКолонка].ТипЗначения.СодержитТип(Тип("Булево")) Тогда
			Значение = Число(Значение);
		КонецЕсли;
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить(ВспомКолонка,Значение);
		Если ТипЗнч(ДополнительноеУсловие)= Тип("Структура") Тогда
			//пополняем структуру
			Для Каждого Элемент ИЗ ДополнительноеУсловие Цикл
				СтруктураОтбора.Вставить(Элемент.Ключ,Элемент.Значение);		
			КонецЦикла;	
		КонецЕсли;	
		Если Источник.Колонки.Количество() > 0 Тогда
			Если ТипЗнч(Источник)=Тип("ТаблицаЗначений") Тогда 
				Строки	= Источник.НайтиСтроки(СтруктураОтбора);		
			Иначе
				Строки	= Источник.Строки.НайтиСтроки(СтруктураОтбора, ИскатьПодчиненные);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Источник) = Тип("ТабличныйДокумент") Тогда
		Если Значение = Ложь И Источник.ВысотаТаблицы > 1 Тогда 
			Строки = Новый Массив(Источник.ВысотаТаблицы - 1); //Шапка выводится в таблицу убираем ее
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Строки;
КонецФункции
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьВложенные(ТекущийНабор, Колонка, Вложенные)
	Если Не ТекущийНабор = Неопределено И  ТекущийНабор.Количество() Тогда
		//определяем существует ли посточная специфика - разный состав колонок
		Если ТекущийНабор.Количество()>1 Тогда
			КолонкиМаксГлубины = ПолучитьКолонкиМаксГлубины(ТекущийНабор,Колонка.Имя);			
			Если Не	КолонкиМаксГлубины = Неопределено Тогда
				Вложенные = КолонкиМаксГлубины;	
			Иначе
				//тут есть построчная специфика
				Для Каждого Подстрока ИЗ ТекущийНабор Цикл
					Для Каждого Вложенная ИЗ ПолучитьКолонки(Подстрока[Колонка.Имя],ТекущийНабор.Индекс(Подстрока)) Цикл
						Вложенные.Добавить(Вложенная);	
					КонецЦикла;
				КонецЦикла;						
			КонецЕсли;
		Иначе
			//тут одна специфика невозможна
			Вложенные = ПолучитьКолонки(ТекущийНабор.Получить(0)[Колонка.Имя]);									 
		КонецЕсли;
	КонецЕсли;			 	
КонецПроцедуры

//Получаем колонки для каждой строки и находим колонки с максимальной глубиной
//как только нам попадаются два одинаковых набора колонок с одинаковой глубиной возвращаем его
//игнорируем пустые значения
Функция ПолучитьКолонкиМаксГлубины(ТекущийНабор,ИмяКолонки)
	Перем КолонкиМаксГлубины;
	МаксГлубина = 0;
	Для Каждого Строка ИЗ ТекущийНабор Цикл
		Если Не Строка[ИмяКолонки] = Неопределено Тогда
			Колонки = ПолучитьКолонки(Строка[ИмяКолонки]); 
			//глубина колонок, которую мы можем просчитать напрямую зависит от заполненности строк таблиц
			Глубина = ПолучитьГлубину(Колонки);
			//@skip-check module-unused-local-variable
			Если КолонкиМаксГлубины = Неопределено ИЛИ Глубина > МаксГлубина Тогда
				КолонкиМаксГлубины 	= Колонки;
				МаксГлубина 		= Глубина;
			ИначеЕсли Глубина = МаксГлубина Тогда
				//пока можем сравнить только колонки одной глубины
				Если ЗначениеВСтрокуВнутр(КолонкиМаксГлубины) =	ЗначениеВСтрокуВнутр(Колонки) Тогда
					Возврат КолонкиМаксГлубины;	
				Иначе
					//колонки разные и специфичны для каждой строки
					Возврат Неопределено;					
				КонецЕсли;		
			Иначе
				//тут нужно сравнивать колонки до общией для обоих!! глубины
				//но как это сделать еще не придумал		
			КонецЕсли;		
		КонецЕсли;
	КонецЦикла;
КонецФункции

Функция ПолучитьГлубину(Колонки)
	Глубина = 0;
	Для Каждого Колонка ИЗ Колонки Цикл
		Глубина = Макс(Глубина,ПолучитьГлубину(Колонка.мКолонки)+1);
	КонецЦикла;
	Возврат Глубина;		
КонецФункции		

//Добавление табличного поля
//
Процедура ДобавитьПолеВложенных(Форма, ИдентификаторКолонок, ИмяОсновногоРеквизита, ОсновнойЭлемент, Вложенные, Колонка)
	Если Вложенные.Количество() Тогда	
		Страница = ПолучитьСтраницу(Форма, ИдентификаторКолонок, ИмяОсновногоРеквизита, ОсновнойЭлемент, Колонка);
		ИмяВложенногоРеквизита         	= СтрШаблон("%1_%2_%3",ИмяОсновногоРеквизита,Формат(ИдентификаторКолонок,"ЧН=0; ЧГ="),Колонка.Имя);
		ПутьКДаннымВложенногоРеквизита 	= СтрШаблон("Элементы.%1.ТекущиеДанные.%2",ИмяОсновногоРеквизита, Колонка.Имя);
		ИндексыСтрок = ПолучитьИндексыСтрок(Вложенные);
		Если ИндексыСтрок.Количество() Тогда
			Для Каждого ИндексСтроки ИЗ ИндексыСтрок Цикл
				СраницаИндексаСтроки = ПолучитьСтраницуИндексаСтрок(Форма, ИндексСтроки, Страница.Имя, Страница);
				ДобавитьКолонкиВЭлемент(Форма, ИдентификаторКолонок, ИмяВложенногоРеквизита, ПутьКДаннымВложенногоРеквизита, Вложенные, СраницаИндексаСтроки, ИндексСтроки);
			КонецЦикла;
 		Иначе
			ДобавитьКолонкиВЭлемент(Форма, ИдентификаторКолонок, ИмяВложенногоРеквизита, ПутьКДаннымВложенногоРеквизита, Вложенные, Страница);
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьИндексыСтрок(Вложенные)
	Индексы = Новый Массив;
	Для Каждого Вложенная ИЗ Вложенные Цикл
		Если 	Не Вложенная.Колонка.ИндексСтроки = Неопределено 
				И Индексы.Найти(Вложенная.Колонка.ИндексСтроки) = Неопределено Тогда
			Индексы.Добавить(Вложенная.Колонка.ИндексСтроки);
		КонецЕсли;	
	КонецЦикла;
	Возврат Индексы;
КонецФункции


Функция ПолучитьСтраницу(Форма, ИдентификаторКолонок, ИмяОсновногоРеквизита, ОсновнойЭлемент, Колонка)
	Эл_Страницы = ПолучитьСтраницы(Форма, ИдентификаторКолонок, ИмяОсновногоРеквизита, ОсновнойЭлемент);
	Эл_СтраницаИмя	= Эл_Страницы.Имя + "_" + Колонка.Имя;
	Эл_Страница 	= Эл_Страницы.ПодчиненныеЭлементы.Найти(Эл_СтраницаИмя);//Элементы[ИмяОсновногоРеквизита].Родитель.Имя);
	Если Эл_Страница = Неопределено Тогда
		Эл_Страница = Форма.Элементы.Добавить(Эл_СтраницаИмя, Тип("ГруппаФормы"), Эл_Страницы);
		Эл_Страница.Вид			= ВидГруппыФормы.Страница;
		Эл_Страница.Заголовок 	= Колонка.Имя; //Кол-во уточняется см. КоллекцияКлиент_Ei.ПриАктивизацииСтроки	
		Эл_Страница.Подсказка	= Эл_СтраницаИмя; //Для простоты отладки	
	КонецЕсли;	
	Возврат Эл_Страница;
КонецФункции

Функция ПолучитьСтраницы(Форма, ИдентификаторКолонок, ИмяОсновногоРеквизита, ОсновнойЭлемент)
	Эл_СтраницыИмя 	= ИмяОсновногоРеквизита + "_" + Формат(ИдентификаторКолонок, "ЧН=0; ЧГ=") + КоллекцияСтруктураКлиентСервер_Ei.ПризнакВложеннойГруппы();
	Эл_Страницы 	= ОсновнойЭлемент.Родитель.ПодчиненныеЭлементы.Найти(Эл_СтраницыИмя);//Элементы[ИмяОсновногоРеквизита].Родитель.Имя);
	Если Эл_Страницы = Неопределено Тогда
		ОсновнойЭлемент.Родитель.Группировка =  ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		Эл_Страницы 					= Форма.Элементы.Добавить(Эл_СтраницыИмя, Тип("ГруппаФормы"),ОсновнойЭлемент.Родитель);
		Эл_Страницы.Вид					= ВидГруппыФормы.Страницы;
		Эл_Страницы.ОтображениеСтраниц 	= ОтображениеСтраницФормы.ЗакладкиСнизу;
	КонецЕсли;
	Возврат Эл_Страницы;
КонецФункции

Функция ПолучитьСтраницыИндексовСтрок(Форма, ИмяОсновногоРеквизита, СтраницаЗначения)
	Эл_СтраницыИмя 	= СтрШаблон("%1_%2",ИмяОсновногоРеквизита,КоллекцияСтруктураКлиентСервер_Ei.ПризнакИндексаСтрок());
	Эл_Страницы 	= СтраницаЗначения.ПодчиненныеЭлементы.Найти(Эл_СтраницыИмя);
	Если Эл_Страницы = Неопределено Тогда
		Эл_Страницы 					= Форма.Элементы.Добавить(Эл_СтраницыИмя, Тип("ГруппаФормы"),СтраницаЗначения);
		Эл_Страницы.Вид					= ВидГруппыФормы.Страницы;
		//страницы не полказываем они переключается в зависимости от текущей строки
		Эл_Страницы.ОтображениеСтраниц 	= ОтображениеСтраницФормы.Нет;
	КонецЕсли;
	Возврат Эл_Страницы;
КонецФункции

Функция ПолучитьСтраницуИндексаСтрок(Форма, ИндексСтроки, ИмяОсновногоРеквизита, СтраницаЗначения)
	Эл_Страницы = ПолучитьСтраницыИндексовСтрок(Форма, ИмяОсновногоРеквизита, СтраницаЗначения);
	Эл_СтраницаИмя	= Эл_Страницы.Имя + "_" + Формат(ИндексСтроки, "ЧН=0; ЧГ=");
	Эл_Страница 	= Эл_Страницы.ПодчиненныеЭлементы.Найти(Эл_СтраницаИмя);//Элементы[ИмяОсновногоРеквизита].Родитель.Имя);
	Если Эл_Страница = Неопределено Тогда
		Эл_Страница = Форма.Элементы.Добавить(Эл_СтраницаИмя, Тип("ГруппаФормы"), Эл_Страницы);
		Эл_Страница.Вид			= ВидГруппыФормы.Страница;
	КонецЕсли;
	Возврат Эл_Страница;
КонецФункции

Процедура ЗаполнитьСвостваЭлемента(Элемент,Колонка)
	Если Колонка.ТипЗначения = Новый ОписаниеТипов("Булево") Тогда
		Элемент.Вид 	= ВидПоляФормы.ПолеФлажка;
	Иначе	 
		Элемент.Вид 	= ВидПоляФормы.ПолеВвода;
		Элемент.Ширина 	= 10;	
	КонецЕсли;
	Элемент.Заголовок 	= Колонка.Имя; //имя используется при адресации при выборе 		
Конецпроцедуры
#КонецОбласти	






Процедура ОбновитьПредставление(Форма) Экспорт
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(Форма.ВозвращаемоеЗначение) Тогда
		Если ЗначениеЗаполнено(Форма.ВозвращаемоеЗначение.ПредставлениеЗначения) Тогда
			//значение сохранено в хранилище/кэше
			Описание = Форма.ВозвращаемоеЗначение.ПредставлениеЗначения;
		Иначе
			//это простое значение
			Описание = ТипЗнч(Форма.ВозвращаемоеЗначение.Значение);
		КонецЕсли;	
		Форма.Элементы.ВозвращаемоеЗначениеДекорация.Заголовок = "Возвр. значение: "+Описание;
	Иначе
		Форма.Элементы.ВозвращаемоеЗначениеДекорация.Заголовок = "Возвр. значение: "+ТипЗнч(Форма.ВозвращаемоеЗначение);
	КонецЕсли;	
КонецПроцедуры

Процедура Нажатие(Форма,Элемент) Экспорт
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеНеопределенногоЗначения(Форма.ВозвращаемоеЗначение) Тогда
		стрТекДанных = Новый Структура("ИмяПараметра,ЗначениеПараметра,ЭтоВыражение",Неопределено,Неопределено,Ложь);
	Иначе	
		стрТекДанных = Новый Структура("ИмяПараметра,ЗначениеПараметра,ЭтоВыражение",Неопределено,"Результат",Истина);
		Форма.СтруктураПеременных.ДоступныеСтруктуры.Вставить("Результат",Форма.ВозвращаемоеЗначение);
	КонецЕсли;
	Форма.СтруктураПеременных.Вставить("ТекущиеДанные",стрТекДанных);
	
	ОО_ВыбораВозрЗначения = Новый ОписаниеОповещения("Выбор",ВозврЗначениеКлиент_Ei, Новый Структура("Форма",Форма));
	ВыборКлиент_Ei.НачалоВыбора(ОО_ВыбораВозрЗначения,,Форма,Элемент,Форма.СтруктураПеременных,Ложь,Ложь);
КонецПроцедуры

Процедура Выбор(ВыбранноеЗначение, ДопПараметры) Экспорт
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ВыбранноеЗначение,"Значение") Тогда
		//параметр - значение
		//ожидаем возврата структуры текущих данных переданную в процедуре ВозвращаемоеЗначениеДекорацияНажатие() дополненную свойством "Значение" см. ВыборКлиент_Ei.ДеревоЗначенийВыбор()
	    ДопПараметры.Форма.ВозвращаемоеЗначение = ВыбранноеЗначение.Значение;
	Иначе
		//выбор типа
	    ДопПараметры.Форма.ВозвращаемоеЗначение = ОписаниеЗначенияВызовСервера_Ei.Подготовить(ВыбранноеЗначение.ЗначениеПараметра);
	КонецЕсли;
	ОбновитьПредставление(ДопПараметры.Форма);
КонецПроцедуры	

Процедура ПоУмолчанию(Форма) Экспорт
	Форма.ВозвращаемоеЗначение	= ОписаниеЗначенияВызовСервера_Ei.Подготовить(Неопределено,Новый УникальныйИдентификатор);	
КонецПроцедуры	

Процедура Очистить(Форма) Экспорт
	ПоУмолчанию(Форма);
	ОбновитьПредставление(Форма);
	Форма.ВычислитьМодифицированность();
КонецПроцедуры

Функция ПолучитьОписание(ВозвращаемоеЗначение) Экспорт
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ВозвращаемоеЗначение) Тогда
		Если Не ОписаниеЗначенияВызовСервера_Ei.ЗначениеСуществует(ВозвращаемоеЗначение) Тогда
			врСтр 					= Новый Структура(ВозвращаемоеЗначение);
			врСтр.Ссылка 			= ПоместитьВоВременноеХранилище(Неопределено,Новый УникальныйИдентификатор);	
			ВозвращаемоеЗначение   	= Новый ФиксированнаяСтруктура(врСтр);
			//Настройка 				= ПолучитьНастройкуДляСохранения(); //Подозрения что нужно убрать эту строку
		КонецЕсли;
	КонецЕсли;	
	Возврат ВозвращаемоеЗначение;
КонецФункции 

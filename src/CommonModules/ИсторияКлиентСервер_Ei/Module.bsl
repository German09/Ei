// @strict-types

// История запусков вариантов и параметров Ei: ключи истории, лимиты, описание запуска.
// Единица истории одна для варианта строки и для параметра строки: ключ, инструкция, снимок результата.
// Хранение см. ИсторияВызовСервера_Ei, просмотр и восстановление см. ИсторияКлиент_Ei

#Область ПрограммныйИнтерфейс

// Ключ истории варианта строки набора.
//
// Параметры:
//  КлючСтроки - УникальныйИдентификатор, Строка - КлючНастроек строки набора
//  ИмяВарианта - Строка - имя варианта: Алгоритм, Запрос и т.п.
//
// Возвращаемое значение:
//  Строка
//
Функция КлючВарианта(КлючСтроки, ИмяВарианта) Экспорт
	
	Возврат СтрШаблон("Вариант.%1.%2", ИмяВарианта, Строка(КлючСтроки));
	
КонецФункции

// Ключ истории параметра строки набора.
//
// Параметры:
//  КлючСтроки - УникальныйИдентификатор, Строка - КлючНастроек строки набора
//  ИмяПараметра - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция КлючПараметра(КлючСтроки, ИмяПараметра) Экспорт
	
	Возврат СтрШаблон("Параметр.%1.%2", ИмяПараметра, Строка(КлючСтроки));
	
КонецФункции

// Новый запуск: вариант или вычисление параметра.
//
// Параметры:
//  Ид - Строка - идентификатор запуска
//  Ключ - Строка - ключ истории, см. КлючВарианта
//  Имя - Строка - имя варианта или параметра
//  Инструкция - Произвольный - текст алгоритма, запроса, выражение параметра
//
// Возвращаемое значение:
//  Структура:
//   * Ид - Строка
//   * Ключ - Строка
//   * Имя - Строка
//   * Инструкция - Произвольный - текст алгоритма, запроса, выражение параметра
//   * ЭтоВыражение - Булево - инструкция параметра - выражение на встроенном языке
//   * ЗапускВарианта - Строка - для параметра: запуск варианта, в котором он вычислен
//   * Дата - Дата - дата сеанса записи запуска
//   * Начало - Число - универсальное время начала в миллисекундах
//   * Длительность - Число - миллисекунды
//   * Статус - Строка - см. СтатусыЗапуска
//   * Ошибка - Строка
//   * ЕстьСнимок - Булево - результат сохранен и его можно показать
//   * СнимокУсечен - Булево - в снимке только часть результата
//   * ПредставлениеРезультата - Строка
//   * Завершен - Булево
//   Метрики как на закладках формы Ei: размерность и время варианта, вид, размерность и время результата
//   * РазмерВарианта - Строка, Число
//   * СинонимРезультата - Строка
//   * РазмерРезультата - Строка, Число
//   * ВремяРезультата - Число - миллисекунды отображения результата
//   * Параметры - Массив из Строка - имена параметров, переданных запуску вне строки набора: запуски MCP
//
Функция НовыйЗапуск(Ид, Ключ, Имя, Инструкция) Экспорт
	
	Запуск = Новый Структура;
	Запуск.Вставить("Ид", Ид);
	Запуск.Вставить("Ключ", Ключ);
	Запуск.Вставить("Имя", Имя);
	Запуск.Вставить("Инструкция", Инструкция);
	Запуск.Вставить("ЭтоВыражение", Ложь);
	Запуск.Вставить("ЗапускВарианта", "");
	Запуск.Вставить("Дата", Дата(1, 1, 1));
	Запуск.Вставить("Начало", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Запуск.Вставить("Длительность", 0);
	Запуск.Вставить("Статус", СтатусыЗапуска().Успех);
	Запуск.Вставить("Ошибка", "");
	Запуск.Вставить("ЕстьСнимок", Ложь);
	Запуск.Вставить("СнимокУсечен", Ложь);
	Запуск.Вставить("ПредставлениеРезультата", "");
	Запуск.Вставить("Завершен", Ложь);
	Запуск.Вставить("РазмерВарианта", "");
	Запуск.Вставить("СинонимРезультата", "");
	Запуск.Вставить("РазмерРезультата", "");
	Запуск.Вставить("ВремяРезультата", 0);
	Запуск.Вставить("Параметры", Новый Массив);
	
	Возврат Запуск;
	
КонецФункции

// Статусы запуска.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Строка
//   * Ошибка - Строка
//
Функция СтатусыЗапуска() Экспорт
	
	Возврат Новый Структура("Успех, Ошибка", "Успех", "Ошибка");
	
КонецФункции

// Сколько последних запусков хранится по одному ключу истории.
//
// Возвращаемое значение:
//  Число
//
Функция КоличествоЗапусков() Экспорт
	
	Возврат 20;
	
КонецФункции

// Предельный размер снимка результата после сжатия, байт. Больший результат хранится усеченным
// или только представлением.
//
// Возвращаемое значение:
//  Число
//
Функция РазмерСнимка() Экспорт
	
	Возврат 5 * 1024 * 1024;
	
КонецФункции

#КонецОбласти

// Клиентская часть агента MCP: запросы MCP на выполнение кода становятся строками набора MCP_
// с кодом в варианте Алгоритм. Выполнение строки - согласие, ответ MCP уходит после выполнения;
// удаление строки - отказ, текст варианта Комментарий уходит модели как причина.
// Безопасный клиентский код выполняется сразу, без строки.
// Протокол - docs/client-agent-protocol.md в репозитории 1c_mcp.

#Область ПрограммныйИнтерфейс

// Подписывает сеанс на запросы MCP. Вызывается при начале работы системы.
Процедура ПодключитьОбработчики() Экспорт
	
	Если Не УведомленияКлиентаПоддерживаются() Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		УведомленияКлиента.ПодключитьОбработчик(КлючУведомленияЗапрос(),
			Новый ОписаниеОповещения("ПриПолученииЗапроса", ЗапросыMCPКлиент_Ei, , "ПриОшибкеПолученияУведомления", ЗапросыMCPКлиент_Ei));
		УведомленияКлиента.ПодключитьОбработчик(КлючУведомленияЗакрыт(),
			Новый ОписаниеОповещения("ПриЗакрытииЗапроса", ЗапросыMCPКлиент_Ei, , "ПриОшибкеПолученияУведомления", ЗапросыMCPКлиент_Ei));
	Исключение
		// Платформа не дает подписаться: агент MCP в этом сеансе не работает, остальной Ei - работает.
		ПриОшибкеПолученияУведомления(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

// Добавляет в открытую форму Ei строки запросов, пришедших, пока она была закрыта.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//
Процедура ПриОткрытииФормы(Форма) Экспорт
	
	Очередь = ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Очередь;
	Последний = Неопределено;
	Для Каждого Запрос Из Очередь Цикл
		Если Не ЗапросИстек(Запрос) Тогда
			Последний = ДобавитьСтрокуЗапроса(Форма, Запрос);
		КонецЕсли;
	КонецЦикла;
	Очередь.Очистить();
	
	Если Последний <> Неопределено Тогда
		НаборВариантовКлиент_Ei.АктивизироватьСтроку(Форма, Последний.ПолучитьИдентификатор());
	КонецЕсли;
	
КонецПроцедуры

// Идентификатор запуска строки запроса MCP: совпадает с идентификатором запроса,
// по нему запуск находится в истории и журнале выполнения.
//
// Параметры:
//  ТекД - ДанныеФормыЭлементДерева - строка набора
//  Вариант - ОбщийМодуль - модуль варианта
//
// Возвращаемое значение:
//  Строка, Неопределено - Неопределено, если строка не ждет ответа MCP
//
Функция ИдентификаторЗапуска(ТекД, Вариант) Экспорт
	
	Идентификатор = Неопределено;
	Запрос = ЗапросВарианта(ТекД, Вариант);
	Если Запрос <> Неопределено Тогда
		Идентификатор = Запрос.Идентификатор;
	КонецЕсли;
	
	Возврат Идентификатор;
	
КонецФункции

// Задает для строки запроса MCP место выполнения из запроса:
// код выполняется один раз и только там, где его просили выполнить.
//
// Параметры:
//  ТекД - ДанныеФормыЭлементДерева - строка набора
//  Вариант - ОбщийМодуль - модуль варианта
//  ДопПараметры - Структура - параметры выполнения варианта
//
Процедура ДополнитьПараметрыВыполнения(ТекД, Вариант, ДопПараметры) Экспорт
	
	Запрос = ЗапросВарианта(ТекД, Вариант);
	Если Запрос <> Неопределено Тогда
		ДопПараметры.Вставить("МестоВыполнения", МестоВыполнения(Запрос));
	КонецЕсли;
	
КонецПроцедуры

// Отправляет MCP результат выполнения строки запроса и отвязывает строку от запроса:
// дальше это обычный вариант набора.
//
// Параметры:
//  ТекД - ДанныеФормыЭлементДерева - строка набора
//  Запуск - см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//  ОписаниеЗначения - Произвольный - результат варианта
//  ИнформацияОбОшибке - Неопределено, ИнформацияОбОшибке - ошибка выполнения
//
Процедура ПослеЗапуска(ТекД, Запуск, ОписаниеЗначения, ИнформацияОбОшибке = Неопределено) Экспорт
	
	Если Запуск = Неопределено Или Запуск.Имя <> ИмяВариантаКода() Тогда
		Возврат;
	КонецЕсли;
	Ключ = Строка(ТекД.КлючНастроек);
	Запрос = ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Запросы.Получить(Ключ);
	Если Запрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОтвязатьЗапрос(Ключ);
	
	Код = Строка(Запуск.Инструкция);
	РезультатВыполнения = НовыйРезультатВыполнения(Запрос, Код);
	РезультатВыполнения.Успех = ИнформацияОбОшибке = Неопределено;
	Если ИнформацияОбОшибке <> Неопределено Тогда
		РезультатВыполнения.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	КонецЕсли;
	
	ОтправитьРезультат(Запрос, РезультатВыполнения, ОписаниеЗначения);
	
КонецПроцедуры

// Удаление строки запроса MCP - отказ. Текст варианта Комментарий, дописанный пользователем,
// уходит модели как причина отказа.
//
// Параметры:
//  Строка - ДанныеФормыЭлементДерева - удаляемая строка набора
//
Процедура ПриУдаленииСтроки(Строка) Экспорт
	
	Ключ = Строка(Строка.КлючНастроек);
	Запрос = ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Запросы.Получить(Ключ);
	Если Запрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОтвязатьЗапрос(Ключ);
	
	Итог = ЗапросыMCPВызовСервера_Ei.ЗаписатьОтвет(Запрос, РешенияОтвета().Отклонено, Неопределено,
		ПричинаОтказа(Запрос, Строка[ИмяВариантаКомментария()]));
	Если Итог.Записан Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: выполнение кода отклонено'"), , КраткоеОписаниеКода(Запрос.Код),
			БиблиотекаКартинок.Информация);
	Иначе
		СообщитьОбОшибкеОтвета(Итог);
	КонецЕсли;
	
КонецПроцедуры

// Открывает форму Ei по оповещению о новом запросе.
//
// Параметры:
//  ДополнительныеПараметры - Неопределено
//
Процедура ОткрытьEi(ДополнительныеПараметры) Экспорт
	
	ОткрытьФорму("ОбщаяФорма.Ei");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик уведомления mcp_ЗапросВыполненияКода.
//
// Параметры:
//  Данные - Структура - см. docs/client-agent-protocol.md
//  ДополнительныеПараметры - Неопределено
//
Процедура ПриПолученииЗапроса(Данные, ДополнительныеПараметры) Экспорт
	
	Если Не ЭтоЗапросДляТекущегоПользователя(Данные) Тогда
		Возврат;
	КонецЕсли;
	
	Если Данные.Контекст = "client" Тогда
		// Полю ТребуетсяПодтверждение не доверяем: в копии базы уведомление может отправить любой код.
		ОпасныеКонструкции = ЗапросыMCPВызовСервера_Ei.ОпасныеКонструкции(Данные.Код, "client");
		Если ОпасныеКонструкции <> Неопределено И ОпасныеКонструкции.Количество() = 0 Тогда
			ВыполнитьСразу(Данные);
			Возврат;
		КонецЕсли;
		Если ОпасныеКонструкции <> Неопределено Тогда
			Данные.ОпасныеКонструкции = ОпасныеКонструкции;
		КонецЕсли;
	КонецЕсли;
	
	Форма = ФормаEi();
	Если Форма = Неопределено Тогда
		ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Очередь.Добавить(Данные);
		ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: код ждет выполнения в Ei'"),
			Новый ОписаниеОповещения("ОткрытьEi", ЗапросыMCPКлиент_Ei), ПояснениеЗапроса(Данные),
			БиблиотекаКартинок.Предупреждение);
	Иначе
		НоваяСтрока = ДобавитьСтрокуЗапроса(Форма, Данные);
		НаборВариантовКлиент_Ei.АктивизироватьСтроку(Форма, НоваяСтрока.ПолучитьИдентификатор());
		ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: код ждет выполнения'"), , ПояснениеЗапроса(Данные),
			БиблиотекаКартинок.Предупреждение);
	КонецЕсли;
	Сигнал();
	
КонецПроцедуры

// Обработчик уведомления mcp_ЗапросВыполненияКодаЗакрыт: на запрос ответили в другом сеансе
// или срок его действия истек. Строка остается обычным вариантом.
//
// Параметры:
//  Данные - Структура:
//   * Идентификатор - Строка
//   * Причина - Строка
//  ДополнительныеПараметры - Неопределено
//
Процедура ПриЗакрытииЗапроса(Данные, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("Идентификатор") Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеАгента = ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента();
	Закрыт = Ложь;
	Для Каждого ЭлементЗапроса Из ДанныеАгента.Запросы Цикл
		Если ЭлементЗапроса.Значение.Идентификатор = Данные.Идентификатор Тогда
			ОтвязатьЗапрос(ЭлементЗапроса.Ключ);
			Закрыт = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Для Индекс = -ДанныеАгента.Очередь.ВГраница() По 0 Цикл
		Если ДанныеАгента.Очередь.Получить(-Индекс).Идентификатор = Данные.Идентификатор Тогда
			ДанныеАгента.Очередь.Удалить(-Индекс);
			Закрыт = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Закрыт Тогда
		Причина = "";
		Данные.Свойство("Причина", Причина);
		ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: запрос закрыт'"), , Причина, БиблиотекаКартинок.Информация);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик ошибки получения уведомления.
//
// Параметры:
//  ИнформацияОбОшибке - ИнформацияОбОшибке
//  СтандартнаяОбработка - Булево
//  ДополнительныеПараметры - Неопределено
//
Процедура ПриОшибкеПолученияУведомления(ИнформацияОбОшибке, СтандартнаяОбработка = Истина, ДополнительныеПараметры = Неопределено) Экспорт
	
	СтандартнаяОбработка = Ложь;
	ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: запросы на выполнение кода недоступны'"), ,
		ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке), БиблиотекаКартинок.Предупреждение);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Строки

// Добавляет под корневую строку набора несохраненную строку MCP_ с кодом запроса в варианте Алгоритм
// и описанием запроса в варианте Комментарий и связывает ее с запросом.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  Запрос - Структура - данные уведомления mcp_ЗапросВыполненияКода
//
// Возвращаемое значение:
//  ДанныеФормыЭлементДерева
//
Функция ДобавитьСтрокуЗапроса(Форма, Запрос)
	
	Родитель = Неопределено;
	Для Каждого СтрокаВерхнегоУровня Из НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма) Цикл
		Родитель = СтрокаВерхнегоУровня;
		Прервать;
	КонецЦикла;
	
	НоваяСтрока = Родитель.ПолучитьЭлементы().Добавить();
	ИмяКандидат = СтрШаблон("MCP_%1_%2", Запрос.Контекст, Формат(Запрос.Создан, "ДФ=HHmmss"));
	НоваяСтрока.ИмяНабора = ОбщегоНазначенияКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("ИмяНабора", ИмяКандидат),
		НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма));
	НоваяСтрока.КлючНастроек = ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(Новый УникальныйИдентификатор,
		НаборВариантовКлиент_Ei.Ключ(Форма));
	НоваяСтрока[ИмяВариантаКода()] = Запрос.Код;
	//вариант Комментарий хранит сериализованный форматированный документ, см. ВариантКомментарийКлиентСервер_Ei.ЗапомнитьДанные
	Комментарий = Новый ФорматированныйДокумент;
	Комментарий.УстановитьФорматированнуюСтроку(Новый ФорматированнаяСтрока(ОписаниеЗапроса(Запрос)));
	НоваяСтрока[ИмяВариантаКомментария()] = ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(Комментарий);
	ПараметрыКлиент_Ei.ОбновитьКлючи(НоваяСтрока);
	ВариантыКлиент_Ei.СохранитьТекущийОбработчик(Форма, НоваяСтрока, ИмяВариантаКода());
	КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
	
	ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Запросы.Вставить(Строка(НоваяСтрока.КлючНастроек), Запрос);
	
	Возврат НоваяСтрока;
	
КонецФункции

// Запрос MCP строки, если выполняется ее вариант Алгоритм.
//
// Параметры:
//  ТекД - ДанныеФормыЭлементДерева
//  Вариант - ОбщийМодуль
//
// Возвращаемое значение:
//  Структура, Неопределено - данные уведомления mcp_ЗапросВыполненияКода; Неопределено, если строка не ждет ответа
//
Функция ЗапросВарианта(ТекД, Вариант)
	
	Запрос = Неопределено;
	Если ТекД <> Неопределено И Вариант <> Неопределено И Вариант.Свойства().Имя = ИмяВариантаКода() Тогда
		Запрос = ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Запросы.Получить(Строка(ТекД.КлючНастроек));
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

Процедура ОтвязатьЗапрос(Ключ)
	
	ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Запросы.Удалить(Ключ);
	
КонецПроцедуры

Функция ФормаEi()
	
	Форма = Неопределено;
	Формы = ОбщийМодульКлиентПовтИсп_Ei.Формы();
	Если ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(Формы, "Ei", Форма) И Не Форма.Открыта() Тогда
		Форма = Неопределено;
	КонецЕсли;
	
	Возврат Форма;
	
КонецФункции

#КонецОбласти

#Область Выполнение

// Выполняет клиентский код без опасных конструкций сразу, без строки набора, и отправляет результат.
//
// Параметры:
//  Запрос - Структура - данные уведомления mcp_ЗапросВыполненияКода
//
Процедура ВыполнитьСразу(Запрос)
	
	Замер = ЖурналКлиентСервер_Ei.НачатьЗамер(СтрШаблон(НСтр("ru = 'MCP: выполнение в клиенте%1%2'"), Символы.ПС, Запрос.Код),
		ЖурналКлиентСервер_Ei.ТипыОпераций().Конструктор, , , Запрос.Идентификатор);
	РезультатВыполнения = НовыйРезультатВыполнения(Запрос, Запрос.Код);
	ОписаниеЗначения = Неопределено;
	Попытка
		ОписаниеЗначения = ВыполнитьКлиентСервер_Ei.ВыражениеВМесте(Запрос.Код, Новый УникальныйИдентификатор,
			МестоВыполнения(Запрос));
		РезультатВыполнения.Успех = Истина;
		ЖурналКлиентСервер_Ei.ЗавершитьЗамер(Замер);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		РезультатВыполнения.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ЖурналКлиентСервер_Ei.ЗавершитьЗамер(Замер, , ИнформацияОбОшибке);
	КонецПопытки;
	
	ОтправитьРезультат(Запрос, РезультатВыполнения, ОписаниеЗначения);
	
КонецПроцедуры

// Параметры:
//  Запрос - Структура
//  Код - Строка - фактически выполненный код
//
// Возвращаемое значение:
//  Структура - см. ЗапросыMCPВызовСервера_Ei.ЗаписатьОтвет
//
Функция НовыйРезультатВыполнения(Запрос, Код)
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("Код", Код);
	РезультатВыполнения.Вставить("КодИзменен", Код <> Запрос.Код);
	РезультатВыполнения.Вставить("Успех", Ложь);
	РезультатВыполнения.Вставить("Ошибка", "");
	
	Возврат РезультатВыполнения;
	
КонецФункции

Процедура ОтправитьРезультат(Запрос, РезультатВыполнения, ОписаниеЗначения)
	
	Попытка
		Итог = ЗапросыMCPВызовСервера_Ei.ЗаписатьОтветЗапуска(Запрос, РезультатВыполнения, ОписаниеЗначения);
	Исключение
		Итог = Новый Структура("Записан, Ошибка", Ложь,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если Не Итог.Записан Тогда
		СообщитьОбОшибкеОтвета(Итог);
	ИначеЕсли РезультатВыполнения.Успех Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: результат отправлен'"), , КраткоеОписаниеКода(РезультатВыполнения.Код),
			БиблиотекаКартинок.Информация);
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: отправлена ошибка выполнения'"), ,
			КраткоеОписаниеКода(РезультатВыполнения.Код), БиблиотекаКартинок.Предупреждение);
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  Запрос - Структура
//
// Возвращаемое значение:
//  Строка - см. ВыполнитьКлиентСервер_Ei.МестаВыполнения
//
Функция МестоВыполнения(Запрос)
	
	Места = ВыполнитьКлиентСервер_Ei.МестаВыполнения();
	Возврат ?(Запрос.Контекст = "client", Места.Клиент, Места.Сервер);
	
КонецФункции

#КонецОбласти

#Область Описание

// Текст варианта Комментарий строки запроса. Все, что пользователь допишет после него,
// уйдет модели как причина отказа, см. ПричинаОтказа
//
// Параметры:
//  Запрос - Структура
//
// Возвращаемое значение:
//  Строка
//
Функция ОписаниеЗапроса(Запрос)
	
	Строки = Новый Массив; // Массив из Строка
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Запрос MCP на выполнение кода %1.'"), ПредставлениеМеста(Запрос)));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Создан %1, ответ принимается до %2 (UTC).'"),
		Формат(Запрос.Создан, "ДЛФ=T"), Формат(Запрос.СрокДействия, "ДЛФ=T")));
	Если Запрос.ОпасныеКонструкции.Количество() > 0 Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Опасные конструкции: %1'"), СтрСоединить(Запрос.ОпасныеКонструкции, ", ")));
	КонецЕсли;
	Строки.Добавить(НСтр("ru = 'Выполнить - выполнить код (его можно изменить) и отправить результат модели.'"));
	Строки.Добавить(ПоследняяСтрокаОписания());
	Строки.Добавить("");
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

Функция ПоследняяСтрокаОписания()
	
	Возврат НСтр("ru = 'Удалить строку - отказать. Текст, дописанный ниже, модель получит как причину отказа.'");
	
КонецФункции

// Текст, который пользователь дописал в вариант Комментарий после описания запроса.
// Если описание стерто, причиной считается весь текст.
//
// Параметры:
//  Запрос - Структура
//  Комментарий - Строка - сериализованный форматированный документ варианта Комментарий
//
// Возвращаемое значение:
//  Строка
//
Функция ПричинаОтказа(Запрос, Комментарий)
	
	Документ = ОбщегоНазначенияКлиентСервер_Ei.Структурировать(Комментарий, Новый ФорматированныйДокумент);
	Причина = Документ.ПолучитьТекст();
	Позиция = СтрНайти(Причина, ПоследняяСтрокаОписания(), НаправлениеПоиска.СКонца);
	Если Позиция > 0 Тогда
		Причина = Сред(Причина, Позиция + СтрДлина(ПоследняяСтрокаОписания()));
	КонецЕсли;
	
	Возврат СокрЛП(Причина);
	
КонецФункции

Функция ПояснениеЗапроса(Запрос)
	
	Пояснение = СтрШаблон(НСтр("ru = 'Код %1. Выполнить - согласиться, удалить строку - отказать.'"), ПредставлениеМеста(Запрос));
	Если Запрос.ОпасныеКонструкции.Количество() > 0 Тогда
		Пояснение = Пояснение + Символы.ПС + СтрСоединить(Запрос.ОпасныеКонструкции, ", ");
	КонецЕсли;
	
	Возврат Пояснение;
	
КонецФункции

Функция ПредставлениеМеста(Запрос)
	
	Возврат ?(Запрос.Контекст = "client", НСтр("ru = 'в клиенте'"), НСтр("ru = 'на сервере'"));
	
КонецФункции

Функция КраткоеОписаниеКода(Код)
	
	МаксимумСтрок = 3;
	Строки = СтрРазделить(Код, Символы.ПС, Ложь);
	Описание = Новый Массив; // Массив из Строка
	Для Каждого СтрокаКода Из Строки Цикл
		Если Описание.Количество() = МаксимумСтрок Тогда
			Описание.Добавить("...");
			Прервать;
		КонецЕсли;
		Описание.Добавить(СокрЛП(СтрокаКода));
	КонецЦикла;
	
	Возврат СтрСоединить(Описание, Символы.ПС);
	
КонецФункции

Процедура СообщитьОбОшибкеОтвета(Итог)
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: ответ не записан'"), , Итог.Ошибка,
		БиблиотекаКартинок.Предупреждение);
	
КонецПроцедуры


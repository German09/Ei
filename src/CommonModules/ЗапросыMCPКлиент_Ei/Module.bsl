Функция ЭтоЗапросДляТекущегоПользователя(Данные)
	
	Возврат ТипЗнч(Данные) = Тип("Структура")
		И Данные.Свойство("ВерсияПротокола") И (Данные.ВерсияПротокола = 1 Или Данные.ВерсияПротокола = ВерсияПротокола())
		И Данные.Свойство("Пользователь") И Данные.Пользователь = ИмяПользователя()
		И Данные.Свойство("Контекст") И (Данные.Контекст = "server" Или Данные.Контекст = "client");
	
КонецФункции

// Проверяет уведомление о наборах вариантов, см. ЗапросыMCPСервер_Ei.ОтправитьНаборы
//
// Параметры:
//  Данные - Произвольный
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоНаборыДляТекущегоПользователя(Данные)
	
	Возврат ТипЗнч(Данные) = Тип("Структура")
		И Данные.Свойство("ВерсияПротокола") И Данные.ВерсияПротокола = ВерсияПротокола()
		И Данные.Свойство("Пользователь") И Данные.Пользователь = ИмяПользователя()
		И Данные.Свойство("Идентификатор") И Данные.Свойство("СрокДействия") И Данные.Свойство("Описание")
		И Данные.Свойство("ОпасныеКонструкции") И ТипЗнч(Данные.ОпасныеКонструкции) = Тип("Массив")
		И ЭтоНаборы(Данные);
	
КонецФункции

// Проверяет уведомление о чтении наборов, см. ПриПолученииЧтенияНаборов
//
// Параметры:
//  Данные - Произвольный
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоЧтениеДляТекущегоПользователя(Данные)
	
	Возврат ТипЗнч(Данные) = Тип("Структура")
		И Данные.Свойство("ВерсияПротокола") И Данные.ВерсияПротокола = ВерсияПротокола()
		И Данные.Свойство("Пользователь") И Данные.Пользователь = ИмяПользователя()
		И Данные.Свойство("Контекст") И Данные.Контекст = КонтекстЧтенияНаборов()
		И Данные.Свойство("Идентификатор") И Данные.Свойство("ИдентификаторНаборов")
		И Данные.Свойство("Имена") И ТипЗнч(Данные.Имена) = Тип("Массив")
		И Данные.Свойство("КлючиСтрок") И ТипЗнч(Данные.КлючиСтрок) = Тип("Массив")
		И Данные.Свойство("СРезультатами") И ТипЗнч(Данные.СРезультатами) = Тип("Булево");
	
КонецФункции

// Ожидающий запрос - наборы вариантов, а не код для подтверждения или выполнения.

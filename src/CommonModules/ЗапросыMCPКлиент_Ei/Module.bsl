// Клиентская часть агента MCP: запрос MCP на выполнение кода показывается в форме подтверждения,
// см. ОбщаяФорма.ПараметрыАлгоритм_Ei
// Разрешить - код выполняется вариантом Алгоритм строки набора MCP_ (форма Ei открыта) или сразу (закрыта),
// результат уходит в MCP. Запретить, Отмена, закрытие формы, истечение времени - отказ с видом отказа.
// Безопасный клиентский код выполняется сразу, без формы.
// Протокол - docs/client-agent-protocol.md в репозитории 1c_mcp.
// Наборы вариантов MCP (инструмент create_variants) тоже приходят оповещением: по нажатию на него
// строки добавляются в Ei для отладки пользователем, ответ в MCP не отправляется.
// Запрос чтения этих строк (инструмент get_variants) агент выполняет сразу, без формы и оповещения о запросе.

#Область ПрограммныйИнтерфейс

// Подписывает сеанс на запросы MCP. Вызывается при начале работы системы.
Процедура ПодключитьОбработчики() Экспорт
	
	Если Не УведомленияКлиентаПоддерживаются() Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		УведомленияКлиента.ПодключитьОбработчик(КлючУведомленияЗапрос(),
			Новый ОписаниеОповещения("ПриПолученииЗапроса", ЗапросыMCPКлиент_Ei, , "ПриОшибкеПолученияУведомления", ЗапросыMCPКлиент_Ei));
		УведомленияКлиента.ПодключитьОбработчик(КлючУведомленияЗакрыт(),
			Новый ОписаниеОповещения("ПриЗакрытииЗапроса", ЗапросыMCPКлиент_Ei, , "ПриОшибкеПолученияУведомления", ЗапросыMCPКлиент_Ei));
		УведомленияКлиента.ПодключитьОбработчик(КлючУведомленияНаборы(),
			Новый ОписаниеОповещения("ПриПолученииНаборов", ЗапросыMCPКлиент_Ei, , "ПриОшибкеПолученияУведомления", ЗапросыMCPКлиент_Ei));
		УведомленияКлиента.ПодключитьОбработчик(КлючУведомленияЧтениеНаборов(),
			Новый ОписаниеОповещения("ПриПолученииЧтенияНаборов", ЗапросыMCPКлиент_Ei, , "ПриОшибкеПолученияУведомления", ЗапросыMCPКлиент_Ei));
	Исключение
		// Платформа не дает подписаться: агент MCP в этом сеансе не работает, остальной Ei - работает.
		ПриОшибкеПолученияУведомления(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

// Идентификатор запуска строки запроса MCP: совпадает с идентификатором запроса,
// по нему запуск находится в истории и журнале выполнения.
//
// Параметры:
//  ТекД - ДанныеФормыЭлементДерева - строка набора
//  Вариант - ОбщийМодуль - модуль варианта
//
// Возвращаемое значение:
//  Строка, Неопределено - Неопределено, если строка не ждет ответа MCP
//
Функция ИдентификаторЗапуска(ТекД, Вариант) Экспорт
	
	Идентификатор = Неопределено;
	Запрос = ЗапросВарианта(ТекД, Вариант);
	Если Запрос <> Неопределено Тогда
		Идентификатор = Запрос.Идентификатор;
	КонецЕсли;
	
	Возврат Идентификатор;
	
КонецФункции

// Задает для строки запроса MCP место и режим выполнения из запроса:
// код выполняется один раз и только там, где его просили выполнить.
//
// Параметры:
//  ТекД - ДанныеФормыЭлементДерева - строка набора
//  Вариант - ОбщийМодуль - модуль варианта
//  ДопПараметры - Структура - параметры выполнения варианта
//
Процедура ДополнитьПараметрыВыполнения(ТекД, Вариант, ДопПараметры) Экспорт
	
	Запрос = ЗапросВарианта(ТекД, Вариант);
	Если Запрос <> Неопределено Тогда
		ДопПараметры.Вставить("МестоВыполнения", МестоВыполнения(Запрос));
		ДопПараметры.Вставить("РежимВыражения", РежимВыражения(Запрос));
	КонецЕсли;
	
КонецПроцедуры

// Отправляет MCP результат выполнения строки запроса и отвязывает строку от запроса:
// дальше это обычный вариант набора.
//
// Параметры:
//  ТекД - ДанныеФормыЭлементДерева - строка набора
//  Запуск - см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//  ОписаниеЗначения - Произвольный - результат варианта
//  ИнформацияОбОшибке - Неопределено, ИнформацияОбОшибке - ошибка выполнения
//
Процедура ПослеЗапуска(ТекД, Запуск, ОписаниеЗначения, ИнформацияОбОшибке = Неопределено) Экспорт
	
	Если Запуск = Неопределено Или Запуск.Имя <> ИмяВариантаКода() Тогда
		Возврат;
	КонецЕсли;
	Ключ = Строка(ТекД.КлючНастроек);
	Запрос = ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Запросы.Получить(Ключ);
	Если Запрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОтвязатьЗапрос(Ключ);
	
	Код = Строка(Запуск.Инструкция);
	РезультатВыполнения = НовыйРезультатВыполнения(Запрос, Код);
	РезультатВыполнения.Успех = ИнформацияОбОшибке = Неопределено;
	Если ИнформацияОбОшибке <> Неопределено Тогда
		РезультатВыполнения.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	КонецЕсли;
	
	ОтправитьРезультат(Запрос, РезультатВыполнения, ОписаниеЗначения);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик уведомления mcp_ЗапросВыполненияКода.
//
// Параметры:
//  Данные - Структура - см. docs/client-agent-protocol.md
//  ДополнительныеПараметры - Неопределено
//
Процедура ПриПолученииЗапроса(Данные, ДополнительныеПараметры) Экспорт
	
	Если Не ЭтоЗапросДляТекущегоПользователя(Данные) Тогда
		Возврат;
	КонецЕсли;
	
	Если Данные.Контекст = "client" Тогда
		// Полю ТребуетсяПодтверждение не доверяем: уведомление может отправить любой код.
		ОпасныеКонструкции = ЗапросыMCPВызовСервера_Ei.ОпасныеКонструкции(ТекстДляПроверки(Данные), "client");
		Если ОпасныеКонструкции <> Неопределено И ОпасныеКонструкции.Количество() = 0 Тогда
			ВыполнитьСразу(Данные);
			Возврат;
		КонецЕсли;
		Если ОпасныеКонструкции <> Неопределено Тогда
			Данные.ОпасныеКонструкции = ОпасныеКонструкции;
		КонецЕсли;
	КонецЕсли;
	
	ОповеститьОЗапросе(Данные);
	
КонецПроцедуры

// Обработчик уведомления о наборах вариантов MCP для отладки: показывает оповещение,
// строки добавляются в Ei по нажатию на него, см. ОткрытьЗапрос
//
// Параметры:
//  Данные - Структура - данные уведомления, их формирует ЗапросыMCPСервер_Ei.ОтправитьНаборы
//  ДополнительныеПараметры - Неопределено
//
Процедура ПриПолученииНаборов(Данные, ДополнительныеПараметры) Экспорт
	
	Если Не ЭтоНаборыДляТекущегоПользователя(Данные) Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Ожидающие.Вставить(Данные.Идентификатор, Данные);
	ПоказатьОповещениеПользователя(ЗаголовокОповещенияНаборов(Данные),
		Новый ОписаниеОповещения("ОткрытьЗапрос", ЗапросыMCPКлиент_Ei, Данные.Идентификатор),
		ЗаголовокНаборов(Данные), ОбщегоНазначенияКлиент_Ei.КартинкаОповещения(), СтатусОповещенияПользователя.Важное, Данные.Идентификатор);
	
КонецПроцедуры

// Обработчик уведомления о чтении наборов MCP (get_variants): читает из формы Ei строки,
// добавленные create_variants, вместе с вложенными и результатами их выполнения, и сразу записывает ответ.
// Подтверждение не нужно: читаются только строки, которые прислала модель, и то, что пользователь добавил под них.
//
// Параметры:
//  Данные - Структура - данные уведомления, их формирует ЗапросыMCPСервер_Ei.ЗапроситьРешение
//  ДополнительныеПараметры - Неопределено
//
Процедура ПриПолученииЧтенияНаборов(Данные, ДополнительныеПараметры) Экспорт
	
	Если Не ЭтоЧтениеДляТекущегоПользователя(Данные) Тогда
		Возврат;
	КонецЕсли;
	
	// Поля как у ответа о выполнении кода: сервер проверяет ответ одними правилами
	РезультатЧтения = Новый Структура;
	РезультатЧтения.Вставить("Код", "");
	РезультатЧтения.Вставить("КодИзменен", Ложь);
	РезультатЧтения.Вставить("Успех", Ложь);
	РезультатЧтения.Вставить("Ошибка", "");
	РезультатЧтения.Вставить("ТипРезультата", "Структура");
	РезультатЧтения.Вставить("Результат", Неопределено);
	
	Попытка
		ПрочитатьНаборы(Данные, РезультатЧтения);
	Исключение
		РезультатЧтения.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Попытка
		Итог = ЗапросыMCPВызовСервера_Ei.ЗаписатьОтветЧтения(Данные, РезультатЧтения);
	Исключение
		// Например, результат не удалось получить: модель все равно должна узнать причину, а не ждать срока запроса
		РезультатЧтения.Успех = Ложь;
		РезультатЧтения.Результат = Неопределено;
		РезультатЧтения.Ошибка = "Не удалось записать ответ с результатами: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Итог = ЗапросыMCPВызовСервера_Ei.ЗаписатьОтвет(Данные, РешенияОтвета().Выполнено, РезультатЧтения);
	КонецПопытки;
	
	Если Не Итог.Записан Тогда
		СообщитьОбОшибкеОтвета(Итог);
	ИначеЕсли РезультатЧтения.Успех Тогда
		ПоказатьОповещениеПользователя(ЗаголовокОповещенияЧтения(РезультатЧтения.Результат.Строки), ,
			ТекстОповещенияЧтения(РезультатЧтения.Результат), ОбщегоНазначенияКлиент_Ei.КартинкаОповещения());
	КонецЕсли;
	
КонецПроцедуры

// Открывает запрос по нажатию на оповещение: форму Ei со строкой MCP_ и форму подтверждения поверх нее,
// для наборов вариантов - форму Ei с добавленными строками.
//
// Параметры:
//  Идентификатор - Строка - идентификатор запроса
//
Процедура ОткрытьЗапрос(Идентификатор) Экспорт
	
	Ожидающие = ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Ожидающие;
	Запрос = Ожидающие.Получить(Идентификатор);
	Если Запрос = Неопределено Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: запрос уже закрыт'"), , , ОбщегоНазначенияКлиент_Ei.КартинкаОповещения());
	ИначеЕсли ЗапросИстек(Запрос) Тогда
		Ожидающие.Удалить(Идентификатор);
		ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: срок действия запроса истек'"), , , ОбщегоНазначенияКлиент_Ei.КартинкаОповещения());
	ИначеЕсли ЭтоНаборы(Запрос) Тогда
		ДобавитьНаборы(Запрос);
	Иначе
		ПоказатьЗапрос(Запрос);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик закрытия формы подтверждения.
//
// Параметры:
//  Ответ - Строка, Неопределено - значение нажатой кнопки, см. КнопкиРешения
//  Запрос - Структура - данные уведомления mcp_ЗапросВыполненияКода
//
Процедура ПослеВыбораРешения(Ответ, Запрос) Экспорт
	
	ДанныеАгента = ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента();
	Если ДанныеАгента.Формы.Получить(Запрос.Идентификатор) = Неопределено Тогда
		Возврат; // запрос уже закрыт: на него ответили в другом сеансе или истек срок
	КонецЕсли;
	ДанныеАгента.Формы.Удалить(Запрос.Идентификатор);
	ДанныеАгента.Ожидающие.Удалить(Запрос.Идентификатор);
	
	Если Ответ = КнопкиРешения().Разрешить Тогда
		ВыполнитьРазрешенный(Запрос);
	Иначе
		Отказать(Запрос, ВидОтказа(Ответ));
	КонецЕсли;
	
КонецПроцедуры

// Обработчик уведомления mcp_ЗапросВыполненияКодаЗакрыт: на запрос ответили в другом сеансе
// или срок его действия истек. Форма подтверждения закрывается, строка остается обычным вариантом.
//
// Параметры:
//  Данные - Структура:
//   * Идентификатор - Строка
//   * Причина - Строка
//  ДополнительныеПараметры - Неопределено
//
Процедура ПриЗакрытииЗапроса(Данные, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("Идентификатор") Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеАгента = ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента();
	ОтвязатьЗапросПоИдентификатору(Данные.Идентификатор);
	БылОжидающим = ДанныеАгента.Ожидающие.Получить(Данные.Идентификатор) <> Неопределено;
	ДанныеАгента.Ожидающие.Удалить(Данные.Идентификатор);
	
	Форма = ДанныеАгента.Формы.Получить(Данные.Идентификатор);
	Если Форма <> Неопределено Тогда
		// Сначала отвязываем: закрытие формы не должно отправить отказ, см. ПослеВыбораРешения
		ДанныеАгента.Формы.Удалить(Данные.Идентификатор);
		Если Форма.Открыта() Тогда
			Форма.Закрыть();
		КонецЕсли;
	КонецЕсли;
	
	Если БылОжидающим Тогда
		Причина = "";
		Данные.Свойство("Причина", Причина);
		ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: запрос закрыт'"), , Причина, ОбщегоНазначенияКлиент_Ei.КартинкаОповещения(),
			СтатусОповещенияПользователя.Информация, Данные.Идентификатор);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик ошибки получения уведомления.
//
// Параметры:
//  ИнформацияОбОшибке - ИнформацияОбОшибке
//  СтандартнаяОбработка - Булево
//  ДополнительныеПараметры - Неопределено
//
Процедура ПриОшибкеПолученияУведомления(ИнформацияОбОшибке, СтандартнаяОбработка = Истина, ДополнительныеПараметры = Неопределено) Экспорт
	
	СтандартнаяОбработка = Ложь;
	ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: запросы на выполнение кода недоступны'"), ,
		ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке), ОбщегоНазначенияКлиент_Ei.КартинкаОповещения());
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Подтверждение

// Сообщает о запросе оповещением: Ei и форма подтверждения открываются только по нажатию на него,
// см. ОткрытьЗапрос
//
// Параметры:
//  Запрос - Структура - данные уведомления mcp_ЗапросВыполненияКода
//
Процедура ОповеститьОЗапросе(Запрос)
	
	ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Ожидающие.Вставить(Запрос.Идентификатор, Запрос);
	ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: подтвердите выполнение кода'"),
		Новый ОписаниеОповещения("ОткрытьЗапрос", ЗапросыMCPКлиент_Ei, Запрос.Идентификатор),
		ЗаголовокЗапроса(Запрос) + Символы.ПС + НСтр("ru = 'Нажмите, чтобы открыть в Ei'"),
		ОбщегоНазначенияКлиент_Ei.КартинкаОповещения(), СтатусОповещенияПользователя.Важное, Запрос.Идентификатор);
	Сигнал();
	
КонецПроцедуры

// Открывает форму Ei со строкой MCP_ запроса и форму подтверждения поверх нее. Кнопка по умолчанию - Запретить,
// она срабатывает по таймауту, пока MCP еще ждет ответ. Повторный вызов только активизирует открытую форму.
//
// Параметры:
//  Запрос - Структура - данные уведомления mcp_ЗапросВыполненияКода
//
Процедура ПоказатьЗапрос(Запрос)
	
	ОткрытаяФорма = ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Формы.Получить(Запрос.Идентификатор);
	Если ОткрытаяФорма <> Неопределено И ОткрытаяФорма.Открыта() Тогда
		ОткрытаяФорма.Активизировать();
		Возврат;
	КонецЕсли;
	
	Кнопки = КнопкиРешения();
	СписокКнопок = Новый СписокЗначений;
	СписокКнопок.Добавить(Кнопки.Разрешить, НСтр("ru = 'Разрешить'"), , БиблиотекаКартинок.Выполнить_Ei);
	СписокКнопок.Добавить(Кнопки.Запретить, НСтр("ru = 'Запретить'"), , БиблиотекаКартинок.Остановить);
	СписокКнопок.Добавить(Кнопки.Отмена, НСтр("ru = 'Отмена'"));
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекстМодуля", Запрос.Код);
	ПараметрыФормы.Вставить("Заголовок", ЗаголовокЗапроса(Запрос));
	ПараметрыФормы.Вставить("Кнопки", СписокКнопок);
	ПараметрыФормы.Вставить("КнопкаПоУмолчанию", Кнопки.Запретить);
	ПараметрыФормы.Вставить("Таймаут", ТаймаутРешения(Запрос));
	ПараметрыФормы.Вставить("ЗначениеТаймаута", Кнопки.Таймаут);
	
	// Код запроса становится строкой MCP_ набора: она видна за формой подтверждения
	// и остается вариантом при любом решении. Запрос всегда показывается в Ei: закрытая форма открывается.
	ФормаEi = ОткрытьФормуEi();
	Если ФормаEi <> Неопределено Тогда
		СтрокаЗапроса = СтрокаЗапроса(ФормаEi, Запрос);
		Если СтрокаЗапроса = Неопределено Тогда
			СтрокаЗапроса = ДобавитьСтрокуЗапроса(ФормаEi, Запрос);
		КонецЕсли;
		НаборВариантовКлиент_Ei.АктивизироватьСтроку(ФормаEi, СтрокаЗапроса.ПолучитьИдентификатор());
	КонецЕсли;
	РежимОткрытия = ?(ФормаEi = Неопределено, РежимОткрытияОкнаФормы.Независимый,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Форма = ОткрытьФорму("ОбщаяФорма.ПараметрыАлгоритм_Ei", ПараметрыФормы, ФормаEi, Запрос.Идентификатор, , ,
		Новый ОписаниеОповещения("ПослеВыбораРешения", ЗапросыMCPКлиент_Ei, Запрос), РежимОткрытия);
	ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Формы.Вставить(Запрос.Идентификатор, Форма);
	
КонецПроцедуры

// Значения кнопок формы подтверждения. Таймаут - значение, которое форма возвращает по истечении времени.
//
// Возвращаемое значение:
//  Структура:
//   * Разрешить - Строка
//   * Запретить - Строка
//   * Отмена - Строка
//   * Таймаут - Строка
//
Функция КнопкиРешения()
	
	Кнопки = Новый Структура;
	Кнопки.Вставить("Разрешить", "Разрешить");
	Кнопки.Вставить("Запретить", "Запретить");
	Кнопки.Вставить("Отмена", "Отмена");
	Кнопки.Вставить("Таймаут", "Таймаут");
	
	Возврат Кнопки;
	
КонецФункции

// Виды отказа в ответе MCP, см. docs/client-agent-protocol.md
//
// Возвращаемое значение:
//  Структура:
//   * Запрещено - Строка - пользователь явно запретил выполнение
//   * Отменено - Строка - пользователь отменил или закрыл форму: не уверен
//   * Таймаут - Строка - пользователь не ответил, сработала кнопка по умолчанию
//
Функция ВидыОтказа()
	
	Возврат Новый Структура("Запрещено, Отменено, Таймаут", "Запрещено", "Отменено", "Таймаут");
	
КонецФункции

Функция ВидОтказа(Ответ)
	
	Кнопки = КнопкиРешения();
	Виды = ВидыОтказа();
	Если Ответ = Кнопки.Запретить Тогда
		Вид = Виды.Запрещено;
	ИначеЕсли Ответ = Кнопки.Таймаут Тогда
		Вид = Виды.Таймаут;
	Иначе
		Вид = Виды.Отменено;
	КонецЕсли;
	
	Возврат Вид;
	
КонецФункции

// Время на решение после открытия формы: на несколько секунд меньше, чем MCP ждет ответ в одном вызове,
// чтобы отказ по таймауту успел вернуться модели в том же вызове, и не дольше оставшегося срока запроса.
//
// Параметры:
//  Запрос - Структура
//
// Возвращаемое значение:
//  Число - секунды
//
Функция ТаймаутРешения(Запрос)
	
	ВремяОжидания = 0;
	Если Не Запрос.Свойство("ВремяОжидания", ВремяОжидания) Или ТипЗнч(ВремяОжидания) <> Тип("Число") Тогда
		ВремяОжидания = ВремяОжиданияПоУмолчанию();
	КонецЕсли;
	ОсталосьДоСрока = Запрос.СрокДействия - ТекущаяДатаUTC() - ЗапасТаймаута();
	
	Возврат Макс(Мин(ВремяОжидания - ЗапасТаймаута(), ОсталосьДоСрока), МинимальныйТаймаут());
	
КонецФункции

// Проверка по часам клиента; окончательно срок проверяет сервер при записи ответа.
Функция ЗапросИстек(Запрос)
	
	Возврат ТекущаяДатаUTC() > Запрос.СрокДействия;
	
КонецФункции

Функция ТекущаяДатаUTC()
	
	Возврат Дата(1, 1, 1) + Цел(ТекущаяУниверсальнаяДатаВМиллисекундах() / 1000);
	
КонецФункции

Функция ЗаголовокЗапроса(Запрос)
	
	Заголовок = СтрШаблон(НСтр("ru = 'MCP: выполнить код %1?'"), ПредставлениеМеста(Запрос));
	Режим = РежимВыражения(Запрос);
	Если Режим <> ВыполнитьКлиентСервер_Ei.РежимыВыражения().Выполнить Тогда
		Заголовок = Заголовок + " " + СтрШаблон(НСтр("ru = 'Режим: %1.'"), Режим);
	КонецЕсли;
	Параметры = ПараметрыЗапроса(Запрос);
	Если Параметры.Количество() > 0 Тогда
		ИменаПараметров = Новый Массив; // Массив из Строка
		Для Каждого ЭлементПараметра Из Параметры Цикл
			ИменаПараметров.Добавить(ЭлементПараметра.Ключ);
		КонецЦикла;
		Заголовок = Заголовок + " " + СтрШаблон(НСтр("ru = 'Параметры: %1.'"), СтрСоединить(ИменаПараметров, ", "));
	КонецЕсли;
	Если Запрос.ОпасныеКонструкции.Количество() > 0 Тогда
		Заголовок = Заголовок + " " + СтрШаблон(НСтр("ru = 'Опасно: %1'"), СтрСоединить(Запрос.ОпасныеКонструкции, ", "));
	КонецЕсли;
	
	Возврат Заголовок;
	
КонецФункции

#КонецОбласти

#Область Выполнение

// Выполняет разрешенный код вариантом Алгоритм строки MCP_ запроса, с результатом в панели Ei
// и запуском в истории. Если строки нет (форма Ei закрыта или строку удалили) - выполняет сразу.
//
// Параметры:
//  Запрос - Структура - данные уведомления mcp_ЗапросВыполненияКода
//
Процедура ВыполнитьРазрешенный(Запрос)
	
	Форма = ФормаEi();
	СтрокаЗапроса = СтрокаЗапроса(Форма, Запрос);
	Если СтрокаЗапроса = Неопределено Тогда
		ОтвязатьЗапросПоИдентификатору(Запрос.Идентификатор);
		ВыполнитьСразу(Запрос);
	Иначе
		НаборВариантовКлиент_Ei.АктивизироватьСтроку(Форма, СтрокаЗапроса.ПолучитьИдентификатор());
		ВариантыКлиент_Ei.СохранитьТекущийОбработчик(Форма, СтрокаЗапроса, ИмяВариантаКода());
		// Инструкция передается явно: выполняется код запроса, вопрос о выделенном фрагменте не задается
		ВариантыКлиент_Ei.ВыполнитьВарианты(Форма, Новый Структура("Инструкция", Запрос.Код));
	КонецЕсли;
	
КонецПроцедуры

// Выполняет код сразу, без строки набора, и отправляет результат.
//
// Параметры:
//  Запрос - Структура - данные уведомления mcp_ЗапросВыполненияКода
//
Процедура ВыполнитьСразу(Запрос)
	
	Замер = ЖурналКлиентСервер_Ei.НачатьЗамер(СтрШаблон(НСтр("ru = 'MCP: выполнение %1%2%3'"), ПредставлениеМеста(Запрос),
		Символы.ПС, Запрос.Код), ЖурналКлиентСервер_Ei.ТипыОпераций().Конструктор, , , Запрос.Идентификатор);
	РезультатВыполнения = НовыйРезультатВыполнения(Запрос, Запрос.Код);
	ОписаниеЗначения = Неопределено;
	// Параметры запроса доступны коду через Параметры(), как параметры строки набора
	СостояниеНабора = ЗапросыMCPВызовСервера_Ei.НачатьНаборЗапроса(ПараметрыЗапроса(Запрос),
		Новый Структура(ИмяВариантаКода(), Запрос.Код));
	Попытка
		ОписаниеЗначения = ВыполнитьКлиентСервер_Ei.ВыражениеВМесте(Запрос.Код, Новый УникальныйИдентификатор,
			МестоВыполнения(Запрос), РежимВыражения(Запрос));
		РезультатВыполнения.Успех = Истина;
		ЖурналКлиентСервер_Ei.ЗавершитьЗамер(Замер);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		РезультатВыполнения.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ЖурналКлиентСервер_Ei.ЗавершитьЗамер(Замер, , ИнформацияОбОшибке);
	КонецПопытки;
	ЗапросыMCPВызовСервера_Ei.ЗавершитьНаборЗапроса(СостояниеНабора);
	
	ОтправитьРезультат(Запрос, РезультатВыполнения, ОписаниеЗначения);
	
КонецПроцедуры

// Параметры:
//  Запрос - Структура
//  Код - Строка - фактически выполненный код
//
// Возвращаемое значение:
//  Структура - см. ЗапросыMCPВызовСервера_Ei.ЗаписатьОтвет
//
Функция НовыйРезультатВыполнения(Запрос, Код)
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("Код", Код);
	РезультатВыполнения.Вставить("КодИзменен", Код <> Запрос.Код);
	РезультатВыполнения.Вставить("Успех", Ложь);
	РезультатВыполнения.Вставить("Ошибка", "");
	
	Возврат РезультатВыполнения;
	
КонецФункции

Процедура ОтправитьРезультат(Запрос, РезультатВыполнения, ОписаниеЗначения)
	
	Попытка
		Итог = ЗапросыMCPВызовСервера_Ei.ЗаписатьОтветЗапуска(Запрос, РезультатВыполнения, ОписаниеЗначения);
	Исключение
		Итог = Новый Структура("Записан, Ошибка", Ложь,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если Не Итог.Записан Тогда
		СообщитьОбОшибкеОтвета(Итог);
	ИначеЕсли Не РезультатВыполнения.Успех Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: отправлена ошибка выполнения'"), ,
			КраткоеОписаниеКода(РезультатВыполнения.Код), ОбщегоНазначенияКлиент_Ei.КартинкаОповещения());
	КонецЕсли;
	
КонецПроцедуры

// Строка MCP_ запроса остается обычным несохраненным вариантом.
Процедура Отказать(Запрос, ВидОтказа)
	
	ОтвязатьЗапросПоИдентификатору(Запрос.Идентификатор);
	Итог = ЗапросыMCPВызовСервера_Ei.ЗаписатьОтвет(Запрос, РешенияОтвета().Отклонено, Неопределено, ВидОтказа);
	Если Не Итог.Записан Тогда
		СообщитьОбОшибкеОтвета(Итог);
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  Запрос - Структура
//
// Возвращаемое значение:
//  Строка - см. ВыполнитьКлиентСервер_Ei.МестаВыполнения
//
Функция МестоВыполнения(Запрос)
	
	Места = ВыполнитьКлиентСервер_Ei.МестаВыполнения();
	Возврат ?(Запрос.Контекст = "client", Места.Клиент, Места.Сервер);
	
КонецФункции

// Параметры:
//  Запрос - Структура
//
// Возвращаемое значение:
//  Строка - см. ВыполнитьКлиентСервер_Ei.РежимыВыражения; запросы протокола 1 - всегда блок операторов
//
Функция РежимВыражения(Запрос)
	
	Режим = Неопределено;
	Если Не Запрос.Свойство("Режим", Режим) Или Не ЗначениеЗаполнено(Режим) Тогда
		Режим = ВыполнитьКлиентСервер_Ei.РежимыВыражения().Выполнить;
	КонецЕсли;
	
	Возврат Режим;
	
КонецФункции

// Параметры:
//  Запрос - Структура
//
// Возвращаемое значение:
//  Структура - параметры по имени, см. ЗапросыMCPВызовСервера_Ei.НачатьНаборЗапроса; пустая для запросов протокола 1
//
Функция ПараметрыЗапроса(Запрос)
	
	Параметры = Неопределено;
	Если Не Запрос.Свойство("Параметры", Параметры) Или ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Возврат Параметры;
	
КонецФункции

// Код вместе с выражениями параметров: выражения выполняются так же, как код, и проверяются вместе с ним.
//
// Параметры:
//  Запрос - Структура
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстДляПроверки(Запрос)
	
	Тексты = Новый Массив; // Массив из Строка
	Тексты.Добавить(Запрос.Код);
	Для Каждого ЭлементПараметра Из ПараметрыЗапроса(Запрос) Цикл
		Если ЭлементПараметра.Значение.ЭтоВыражение Тогда
			Тексты.Добавить(Строка(ЭлементПараметра.Значение.ЗначениеПараметра));
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(Тексты, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область Строки

// Добавляет под корневую строку набора несохраненную строку MCP_ с кодом запроса в варианте Алгоритм
// и связывает ее с запросом до отправки результата.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  Запрос - Структура - данные уведомления mcp_ЗапросВыполненияКода
//
// Возвращаемое значение:
//  ДанныеФормыЭлементДерева
//
Функция ДобавитьСтрокуЗапроса(Форма, Запрос)
	
	ИмяКандидат = СтрШаблон("MCP_%1_%2", Запрос.Контекст, Формат(Запрос.Создан, "ДФ=HHmmss"));
	НоваяСтрока = НоваяСтрокаНабора(Форма, ЭлементыКорневойСтроки(Форма), ИмяКандидат);
	НоваяСтрока[ИмяВариантаКода()] = Запрос.Код;
	// Параметры запроса становятся параметрами строки: их видно в Ei, код получает их через Параметры()
	ЗаполнитьПараметрыСтроки(НоваяСтрока, ПараметрыЗапроса(Запрос));
	ВариантыКлиент_Ei.СохранитьТекущийОбработчик(Форма, НоваяСтрока, ИмяВариантаКода());
	КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
	
	ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Запросы.Вставить(Строка(НоваяСтрока.КлючНастроек), Запрос);
	
	Возврат НоваяСтрока;
	
КонецФункции

// Добавляет строки наборов MCP в Ei несохраненными и активизирует первую, строки с теми же именами обновляет,
// см. ДобавитьСтрокуНабора. Закрытая форма Ei открывается.
// Ключи строк запоминает сервер для чтения обратно, см. ПриПолученииЧтенияНаборов
// Оповещение о наборах в остальных сеансах закрывается: строки уже добавлены здесь.
//
// Параметры:
//  Запрос - Структура - данные уведомления о наборах, см. ПриПолученииНаборов
//
Процедура ДобавитьНаборы(Запрос)
	
	ФормаEi = ОткрытьФормуEi();
	Если ФормаEi = Неопределено Тогда
		СообщитьНаборыНеДобавлены(Запрос);
		Возврат;
	КонецЕсли;
	
	ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Ожидающие.Удалить(Запрос.Идентификатор);
	
	Элементы = ЭлементыКорневойСтроки(ФормаEi);
	КлючиСтрок = Новый Массив; // Массив из Строка
	ПерваяСтрока = Неопределено;
	Для Каждого Набор Из Запрос.Наборы Цикл
		НоваяСтрока = ДобавитьСтрокуНабора(ФормаEi, Элементы, Набор, КлючиСтрок);
		Если ПерваяСтрока = Неопределено Тогда
			ПерваяСтрока = НоваяСтрока;
		КонецЕсли;
	КонецЦикла;
	КонструкторКлиент_Ei.ВычислитьМодифицированность(ФормаEi);
	
	// До показа: строки уже в дереве, и ошибка показа не должна мешать читать их, см. ПриПолученииЧтенияНаборов
	ЗапросыMCPВызовСервера_Ei.ПриДобавленииНаборов(Запрос.Идентификатор, КлючиСтрок);
	
	// Редактор и панель результата показывают текущую строку: обновленную нужно показать заново,
	// а при активизации уже текущей строки это не произойдет
	ТекД = ФормаEi.ПолучитьПереопределяемыйОбъектОбработки();
	Если ТекД <> Неопределено И КлючиСтрок.Найти(Строка(ТекД.КлючНастроек)) <> Неопределено Тогда
		НаборВариантовКлиент_Ei.ВосстановитьВариант(ФормаEi, ТекД);
	КонецЕсли;
	
	ФормаEi.Активизировать();
	Если ПерваяСтрока <> Неопределено Тогда
		НаборВариантовКлиент_Ei.АктивизироватьСтроку(ФормаEi, ПерваяСтрока.ПолучитьИдентификатор());
	КонецЕсли;
	
КонецПроцедуры

// Добавляет строку набора MCP с вариантами и параметрами, затем ее вложенные строки. Строка с тем же именем
// не добавляется, а обновляется на своем месте: присланные варианты и параметры заменяются, остальные остаются,
// результаты строки сбрасываются - они получены по прежнему тексту. Ключ настроек не меняется: остается история строки.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  Элементы - ДанныеФормыКоллекцияЭлементовДерева - куда добавить строку
//  Набор - Структура - строка набора, см. ЗапросыMCPСервер_Ei.ОтправитьНаборы
//  КлючиСтрок - Массив из Строка - дополняется КлючНастроек добавленных и обновленных строк
//
// Возвращаемое значение:
//  ДанныеФормыЭлементДерева
//
Функция ДобавитьСтрокуНабора(Форма, Элементы, Набор, КлючиСтрок)
	
	НоваяСтрока = Неопределено;
	Для Каждого Найденная Из ОбщегоНазначенияКлиентСервер_Ei.НайтиВКоллекцииДерева(Новый Структура("ИмяНабора", Набор.Имя),
		НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма)) Цикл
		НоваяСтрока = Найденная;
		Прервать;
	КонецЦикла;
	Если НоваяСтрока = Неопределено Тогда
		НоваяСтрока = НоваяСтрокаНабора(Форма, Элементы, Набор.Имя);
	Иначе
		// Строка, присланная только ради вложенных, не меняется: ее результаты остаются действительными
		Если Набор.Варианты.Количество() > 0 Или Набор.Параметры.Количество() > 0 Тогда
			СброситьРезультатыСтроки(Форма, НоваяСтрока);
		КонецЕсли;
	КонецЕсли;
	КлючиСтрок.Добавить(Строка(НоваяСтрока.КлючНастроек));
	
	ДоступныеВарианты = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты();
	ИмяКомментария = ВариантКомментарийКлиентСервер_Ei.Свойства().Имя;
	ИмяПроцессов = ВариантПроцессыКлиентСервер_Ei.Ключ();
	Для Каждого ЭлементВарианта Из Набор.Варианты Цикл
		Если ДоступныеВарианты.Получить(ЭлементВарианта.Ключ) = Неопределено Тогда
			Продолжить; // вариант отключен в этой поставке Ei
		ИначеЕсли ЭлементВарианта.Ключ = ИмяПроцессов Тогда
			// Процесс - не текст, а схема, объект и дерево обработок, как при загрузке набора из файла
			ВариантПроцессыКлиентСервер_Ei.ЗагрузитьДанные(НоваяСтрока, ЭлементВарианта.Значение);
		ИначеЕсли ЭлементВарианта.Ключ = ИмяКомментария Тогда
			НоваяСтрока[ЭлементВарианта.Ключ] = ТекстКомментария(ЭлементВарианта.Значение);
		Иначе
			НоваяСтрока[ЭлементВарианта.Ключ] = ЭлементВарианта.Значение;
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьПараметрыСтроки(НоваяСтрока, Набор.Параметры);
	Если ЗначениеЗаполнено(Набор.ТекущийВариант) И ДоступныеВарианты.Получить(Набор.ТекущийВариант) <> Неопределено Тогда
		ВариантыКлиент_Ei.СохранитьТекущийОбработчик(Форма, НоваяСтрока, Набор.ТекущийВариант);
	КонецЕсли;
	
	Для Каждого ВложенныйНабор Из Набор.Строки Цикл
		ДобавитьСтрокуНабора(Форма, НоваяСтрока.ПолучитьЭлементы(), ВложенныйНабор, КлючиСтрок);
	КонецЦикла;
	
	Возврат НоваяСтрока;
	
КонецФункции

// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  СтрокаНабора - ДанныеФормыЭлементДерева
//
Процедура СброситьРезультатыСтроки(Форма, СтрокаНабора)
	
	Для Каждого ЭлементВарианта Из ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
		ИмяВарианта = ЭлементВарианта.Ключ;
		КэшПользователяКлиентСервер_Ei.СохранитьОписаниеРезультата(СтрокаНабора, Форма.КэшПользователя, ИмяВарианта, Неопределено);
		КэшПользователяКлиентСервер_Ei.СохранитьОшибку(СтрокаНабора, Форма.КэшПользователя, ИмяВарианта, Неопределено);
		КэшПользователяКлиентСервер_Ei.СохранитьРезультатНеПоказан(СтрокаНабора, Форма.КэшПользователя, ИмяВарианта, Ложь);
		НастройкиПользователяКлиентСервер_Ei.СохранитьЗатраченноеВремя(СтрокаНабора, Форма.НастройкиПользователя, ЭлементВарианта.Значение, Неопределено);
	КонецЦикла;
	
КонецПроцедуры

// Добавляет пустую строку набора с уникальным во всем дереве именем и новым ключом настроек.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  Элементы - ДанныеФормыКоллекцияЭлементовДерева
//  ИмяКандидат - Строка - имя строки; если занято, к нему добавляется номер
//
// Возвращаемое значение:
//  ДанныеФормыЭлементДерева
//
Функция НоваяСтрокаНабора(Форма, Элементы, ИмяКандидат)
	
	НоваяСтрока = Элементы.Добавить();
	НоваяСтрока.ИмяНабора = ОбщегоНазначенияКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("ИмяНабора", ИмяКандидат),
		НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма));
	НоваяСтрока.КлючНастроек = ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(Новый УникальныйИдентификатор,
		НаборВариантовКлиент_Ei.Ключ(Форма));
	
	Возврат НоваяСтрока;
	
КонецФункции

// Куда добавляются строки MCP: под корневую строку набора, а в пустое дерево - на верхний уровень.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//
// Возвращаемое значение:
//  ДанныеФормыКоллекцияЭлементовДерева
//
Функция ЭлементыКорневойСтроки(Форма)
	
	ЭлементыДерева = НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма);
	Результат = ЭлементыДерева;
	Для Каждого СтрокаВерхнегоУровня Из ЭлементыДерева Цикл
		Результат = СтрокаВерхнегоУровня.ПолучитьЭлементы();
		Прервать;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Параметры строки набора из параметров MCP: их видно в Ei, варианты получают их через Параметры().
// Параметр с тем же именем заменяется: у обновляемой строки параметры уже есть, см. ДобавитьСтрокуНабора
//
// Параметры:
//  СтрокаНабора - ДанныеФормыЭлементДерева
//  Параметры - Структура - параметры по имени, см. ЗапросыMCPВызовСервера_Ei.НачатьНаборЗапроса
//
Процедура ЗаполнитьПараметрыСтроки(СтрокаНабора, Параметры)
	
	Для Каждого ЭлементПараметра Из Параметры Цикл
		Найденные = СтрокаНабора.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра", ЭлементПараметра.Ключ));
		НовыйПараметр = ?(Найденные.Количество() > 0, Найденные[0], СтрокаНабора.ПараметрыЗапроса.Добавить());
		НовыйПараметр.ИмяПараметра = ЭлементПараметра.Ключ;
		НовыйПараметр.ЭтоВыражение = ЭлементПараметра.Значение.ЭтоВыражение;
		НовыйПараметр.ЗначениеПараметра = ЗначениеПараметраСтроки(ЭлементПараметра.Значение);
	КонецЦикла;
	ПараметрыКлиент_Ei.ОбновитьКлючи(СтрокаНабора);
	
КонецПроцедуры

// Значение параметра для строки набора. Список значений восстанавливается из XML: форма Ei хранит его как есть,
// его видно и можно править. Остальные сложные значения остаются XML, Ei восстанавливает их при вычислении,
// см. ОбщегоНазначенияКлиентСервер_Ei.ПопыткаСтруктурировать
//
// Параметры:
//  Параметр - Структура - ЭтоВыражение и ЗначениеПараметра, см. ЗапросыMCPВызовСервера_Ei.НачатьНаборЗапроса
//
// Возвращаемое значение:
//  Произвольный
//
Функция ЗначениеПараметраСтроки(Параметр)
	
	Значение = Параметр.ЗначениеПараметра;
	Если Не Параметр.ЭтоВыражение И ТипЗнч(Значение) = Тип("Строка") И СтрНачинаетсяС(Значение, "<") Тогда
		Восстановленное = ОбщегоНазначенияКлиентСервер_Ei.ПопыткаСтруктурировать(Значение);
		Если ТипЗнч(Восстановленное) = Тип("СписокЗначений") Тогда
			Значение = Восстановленное;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Вариант Комментарий хранит в строке набора сериализованный форматированный документ,
// см. ВариантКомментарийКлиентСервер_Ei.ЗапомнитьДанные
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка - XML форматированного документа
//
Функция ТекстКомментария(Текст)
	
	Документ = Новый ФорматированныйДокумент;
	Документ.УстановитьФорматированнуюСтроку(Новый ФорматированнаяСтрока(Текст));
	
	Возврат ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(Документ);
	
КонецФункции

// Запрос MCP строки, если выполняется ее вариант Алгоритм.
//
// Параметры:
//  ТекД - ДанныеФормыЭлементДерева
//  Вариант - ОбщийМодуль
//
// Возвращаемое значение:
//  Структура, Неопределено - данные уведомления mcp_ЗапросВыполненияКода; Неопределено, если строка не ждет ответа
//
Функция ЗапросВарианта(ТекД, Вариант)
	
	Запрос = Неопределено;
	Если ТекД <> Неопределено И Вариант <> Неопределено И Вариант.Свойства().Имя = ИмяВариантаКода() Тогда
		Запрос = ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Запросы.Получить(Строка(ТекД.КлючНастроек));
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

Процедура ОтвязатьЗапрос(Ключ)
	
	ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Запросы.Удалить(Ключ);
	
КонецПроцедуры

Процедура ОтвязатьЗапросПоИдентификатору(Идентификатор)
	
	Ключ = КлючСтрокиЗапроса(Идентификатор);
	Если Ключ <> Неопределено Тогда
		ОтвязатьЗапрос(Ключ);
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  Идентификатор - Строка - идентификатор запроса
//
// Возвращаемое значение:
//  Строка, Неопределено - КлючНастроек строки MCP_ запроса
//
Функция КлючСтрокиЗапроса(Идентификатор)
	
	Ключ = Неопределено;
	Для Каждого ЭлементЗапроса Из ЗапросыMCPКлиентПовтИсп_Ei.ДанныеАгента().Запросы Цикл
		Если ЭлементЗапроса.Значение.Идентификатор = Идентификатор Тогда
			Ключ = ЭлементЗапроса.Ключ;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ключ;
	
КонецФункции

// Строка MCP_ запроса в открытой форме Ei.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения, Неопределено - см. ОбщаяФорма.Ei
//  Запрос - Структура
//
// Возвращаемое значение:
//  ДанныеФормыЭлементДерева, Неопределено - Неопределено, если формы или строки нет
//
Функция СтрокаЗапроса(Форма, Запрос)
	
	СтрокаНабора = Неопределено;
	Ключ = КлючСтрокиЗапроса(Запрос.Идентификатор);
	Если Форма <> Неопределено И Ключ <> Неопределено Тогда
		Отбор = Новый Структура("КлючНастроек", Новый УникальныйИдентификатор(Ключ));
		Строки = ОбщегоНазначенияКлиентСервер_Ei.НайтиВКоллекцииДерева(Отбор, НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма));
		Если Строки.Количество() > 0 Тогда
			СтрокаНабора = Строки.Получить(0);
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтрокаНабора;
	
КонецФункции

Функция ФормаEi()
	
	Возврат КонструкторКлиент_Ei.ОткрытаяФормаEi();
	
КонецФункции

// Возвращает открытую форму Ei, закрытую открывает. Ссылка на форму живет в повторно используемом значении
// и пропадает вместе с кешем, а уже открытую форму ОткрытьФорму только активизирует без ПриОткрытии,
// поэтому найденная так форма регистрируется заново, см. КонструкторКлиент_Ei.ПриЗапуске
//
// Возвращаемое значение:
//  ФормаКлиентскогоПриложения, Неопределено - Неопределено, если форма не открылась
//
Функция ОткрытьФормуEi()
	
	Форма = ФормаEi();
	Если Форма <> Неопределено Тогда
		Возврат Форма;
	КонецЕсли;
	
	Форма = ОткрытьФорму("ОбщаяФорма.Ei");
	Если Форма = Неопределено Или Не Форма.Открыта() Тогда
		Возврат Неопределено;
	КонецЕсли;
	ОбщийМодульКлиентПовтИсп_Ei.Формы().Вставить("Ei", Форма);
	
	Возврат Форма;
	
КонецФункции

// Сообщает, что строки наборов не добавлены в Ei. Оповещение быстро пропадает, поэтому причина
// остается в сообщениях и в журнале регистрации, событие Ei.ЗапросыMCP
//
// Параметры:
//  Запрос - Структура - данные уведомления о наборах, см. ПриПолученииНаборов
//
Процедура СообщитьНаборыНеДобавлены(Запрос)
	
	Текст = СтрШаблон(НСтр("ru = 'Строки не добавлены: форма Ei не открылась. %1, идентификатор отправки %2'"),
		ЗаголовокОповещенияНаборов(Запрос), Запрос.Идентификатор);
	ПоказатьОповещениеПользователя(НСтр("ru = 'Консоль: не удалось открыть Ei'"), , Текст,
		ОбщегоНазначенияКлиент_Ei.КартинкаОповещения(), СтатусОповещенияПользователя.Важное);
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();
	ЗапросыMCPВызовСервера_Ei.ЗаписатьОшибкуКлиента(Текст);
	
КонецПроцедуры

#КонецОбласти

#Область ЧтениеНаборов

// Читает строки наборов MCP из формы Ei в результат ответа. Строки ищутся по ключам настроек,
// которые сервер запомнил при добавлении наборов: ключ строки сохраняется в файлах набора,
// поэтому строки находятся и в наборе, открытом после перезапуска клиента.
//
// Параметры:
//  Данные - Структура - данные уведомления о чтении:
//   * КлючиСтрок - Массив из Строка - КлючНастроек строк наборов, родитель раньше вложенных
//   * Имена - Массив из Строка - имена строк; пустой - все строки наборов
//   * СРезультатами - Булево - добавить результаты последнего выполнения вариантов
//  РезультатЧтения - Структура - см. ПриПолученииЧтенияНаборов, Результат заполняется структурой:
//   * Строки - Массив из см. ОписаниеСтроки
//   * НеНайдены - Массив из Строка - имена из отбора, которых нет среди строк наборов
//   * Удалено - Число - сколько строк наборов нет в форме Ei; без отбора по именам
//
Процедура ПрочитатьНаборы(Данные, РезультатЧтения)
	
	Форма = ФормаEi();
	Если Форма = Неопределено Тогда
		РезультатЧтения.Ошибка = "Форма Ei закрыта: откройте Ei с набором, в котором есть эти строки";
		Возврат;
	КонецЕсли;
	
	ИменаОтбора = Новый Соответствие; // имя строки - Булево: найдена ли строка с таким именем
	Для Каждого Имя Из Данные.Имена Цикл
		ИменаОтбора.Вставить(Имя, Ложь);
	КонецЦикла;
	ИзвестныеКлючи = Новый Соответствие;
	Для Каждого Ключ Из Данные.КлючиСтрок Цикл
		ИзвестныеКлючи.Вставить(Ключ, Истина);
	КонецЦикла;
	
	Чтение = Новый Структура;
	Чтение.Вставить("Форма", Форма);
	Чтение.Вставить("ИменаОтбора", ИменаОтбора);
	Чтение.Вставить("ТекстыРедактора", ТекстыРедактора(Форма));
	Чтение.Вставить("СРезультатами", Данные.СРезультатами);
	Чтение.Вставить("Строки", Новый Массив);
	
	Найдено = 0;
	Для Каждого Ключ Из Данные.КлючиСтрок Цикл
		СтрокаНабора = СтрокаПоКлючу(Форма, Ключ);
		Если СтрокаНабора = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Найдено = Найдено + 1;
		Родитель = СтрокаНабора.ПолучитьРодителя();
		Если Родитель <> Неопределено И ИзвестныеКлючи.Получить(Строка(Родитель.КлючНастроек)) <> Неопределено Тогда
			Продолжить; // строку уже прочитали вместе с родителем
		КонецЕсли;
		ДобавитьОписанияСтрок(Чтение, СтрокаНабора, "", ИменаОтбора.Количество() = 0);
	КонецЦикла;
	
	Если Найдено = 0 Тогда
		РезультатЧтения.Ошибка = "В открытой форме Ei нет строк этих наборов: их удалили, набор не сохранили"
			+ " до закрытия Ei или сейчас открыт другой набор";
		Возврат;
	КонецЕсли;
	
	НеНайдены = Новый Массив; // Массив из Строка
	Для Каждого ЭлементОтбора Из ИменаОтбора Цикл
		Если Не ЭлементОтбора.Значение Тогда
			НеНайдены.Добавить(ЭлементОтбора.Ключ);
		КонецЕсли;
	КонецЦикла;
	// С отбором по именам ключи - от всех запомненных наборов, часть из них может быть в других файлах
	Удалено = ?(ИменаОтбора.Количество() = 0, Данные.КлючиСтрок.Количество() - Найдено, 0);
	
	РезультатЧтения.Результат = Новый Структура("Строки, НеНайдены, Удалено", Чтение.Строки, НеНайдены, Удалено);
	РезультатЧтения.Успех = Истина;
	
КонецПроцедуры

// Добавляет описание строки и ее вложенных строк, в том числе добавленных пользователем.
// Если задан отбор по именам, строка попадает в ответ, когда ее имя или имя родителя есть в отборе.
//
// Параметры:
//  Чтение - Структура - состояние чтения, см. ПрочитатьНаборы
//  СтрокаНабора - ДанныеФормыЭлементДерева
//  ПутьРодителя - Строка - путь родителя через /, пустой для первой прочитанной строки
//  РодительВключен - Булево - родитель попал в ответ
//
Процедура ДобавитьОписанияСтрок(Чтение, СтрокаНабора, ПутьРодителя, РодительВключен)
	
	Путь = ?(ЗначениеЗаполнено(ПутьРодителя), ПутьРодителя + "/", "") + СтрокаНабора.ИмяНабора;
	ИмяВОтборе = Чтение.ИменаОтбора.Получить(СтрокаНабора.ИмяНабора) <> Неопределено;
	Если ИмяВОтборе Тогда
		Чтение.ИменаОтбора.Вставить(СтрокаНабора.ИмяНабора, Истина);
	КонецЕсли;
	
	Включена = РодительВключен Или ИмяВОтборе;
	Если Включена Тогда
		Чтение.Строки.Добавить(ОписаниеСтроки(Чтение, СтрокаНабора, Путь));
	КонецЕсли;
	
	Для Каждого ВложеннаяСтрока Из СтрокаНабора.ПолучитьЭлементы() Цикл
		ДобавитьОписанияСтрок(Чтение, ВложеннаяСтрока, Путь, Включена);
	КонецЦикла;
	
КонецПроцедуры

// Тексты вариантов, параметры и результаты последнего выполнения строки набора.
//
// Параметры:
//  Чтение - Структура - состояние чтения, см. ПрочитатьНаборы
//  СтрокаНабора - ДанныеФормыЭлементДерева
//  Путь - Строка
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка
//   * Путь - Строка - путь от первой прочитанной строки через /
//   * Варианты - Структура - непустые тексты по имени варианта Ei, комментарий - простым текстом
//   * Параметры - Структура - по имени параметра: ЭтоВыражение и ЗначениеПараметра
//   * ТекущийВариант - Строка - имя варианта, открытого в строке
//   * Результаты - Структура - по имени выполненного варианта, см. РезультатВарианта
//
Функция ОписаниеСтроки(Чтение, СтрокаНабора, Путь)
	
	Описание = Новый Структура;
	Описание.Вставить("Имя", СтрокаНабора.ИмяНабора);
	Описание.Вставить("Путь", Путь);
	
	ТекстыРедактора = Неопределено;
	Если СтрокаНабора.ПолучитьИдентификатор() = Чтение.ТекстыРедактора.ИдентификаторСтроки Тогда
		ТекстыРедактора = Чтение.ТекстыРедактора.Тексты;
	КонецЕсли;
	
	ДоступныеВарианты = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты();
	ИмяКомментария = ВариантКомментарийКлиентСервер_Ei.Свойства().Имя;
	Варианты = Новый Структура;
	Результаты = Новый Структура;
	Для Каждого ИмяВарианта Из ЧитаемыеВарианты() Цикл
		Вариант = ДоступныеВарианты.Получить(ИмяВарианта);
		Если Вариант = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Текст = СтрокаНабора[ИмяВарианта];
		Если ТекстыРедактора <> Неопределено И ТекстыРедактора.Свойство(ИмяВарианта) Тогда
			Текст = ТекстыРедактора[ИмяВарианта];
		КонецЕсли;
		Если ИмяВарианта = ИмяКомментария Тогда
			Текст = ТекстИзКомментария(Текст);
		КонецЕсли;
		Если ЗначениеЗаполнено(Текст) Тогда
			Варианты.Вставить(ИмяВарианта, Текст);
		КонецЕсли;
		Если Чтение.СРезультатами И Вариант.Свойства().Исполнение Тогда
			РезультатВарианта = РезультатВарианта(Чтение.Форма, СтрокаНабора, ИмяВарианта);
			Если РезультатВарианта <> Неопределено Тогда
				Результаты.Вставить(ИмяВарианта, РезультатВарианта);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Описание.Вставить("Варианты", Варианты);
	Описание.Вставить("Результаты", Результаты);
	
	Параметры = Новый Структура;
	Для Каждого Параметр Из СтрокаНабора.ПараметрыЗапроса Цикл
		Параметры.Вставить(Параметр.ИмяПараметра,
			Новый Структура("ЭтоВыражение, ЗначениеПараметра", Параметр.ЭтоВыражение, Параметр.ЗначениеПараметра));
	КонецЦикла;
	Описание.Вставить("Параметры", Параметры);
	
	Обработчик = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Чтение.Форма, СтрокаНабора);
	Описание.Вставить("ТекущийВариант", ?(Обработчик = Неопределено, "", Обработчик.Свойства().Имя));
	
	Возврат Описание;
	
КонецФункции

// Результат последнего выполнения варианта строки из кеша формы Ei. Значение достает сервер в этом сеансе,
// см. ЗапросыMCPВызовСервера_Ei.ЗаписатьОтветЧтения
// Ei очищает ошибку перед выполнением, а результат при ошибке не меняет: при ошибке прежний результат не отдается.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  СтрокаНабора - ДанныеФормыЭлементДерева
//  ИмяВарианта - Строка
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если вариант не выполняли:
//   * ОписаниеЗначения - Произвольный - описание значения результата, Неопределено при ошибке
//   * Ошибка - Строка - ошибка последнего выполнения
//
Функция РезультатВарианта(Форма, СтрокаНабора, ИмяВарианта)
	
	Результат = Неопределено;
	ИнформацияОбОшибке = КэшПользователяКлиентСервер_Ei.ПолучитьОшибку(СтрокаНабора, Форма.КэшПользователя, ИмяВарианта);
	ОписаниеЗначения = КэшПользователяКлиентСервер_Ei.ПолучитьОписаниеРезультата(СтрокаНабора, Форма.КэшПользователя, ИмяВарианта);
	
	Если ИнформацияОбОшибке <> Неопределено Тогда
		ТекстОшибки = ?(ТипЗнч(ИнформацияОбОшибке) = Тип("ИнформацияОбОшибке"),
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке), Строка(ИнформацияОбОшибке));
		Результат = Новый Структура("ОписаниеЗначения, Ошибка", Неопределено, ТекстОшибки);
	ИначеЕсли ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ОписаниеЗначения) Тогда
		Результат = Новый Структура("ОписаниеЗначения, Ошибка", ОписаниеЗначения, "");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Текст из редактора текущей строки Ei: редактор мог еще не передать последние правки в строку набора.
// Строка набора не меняется: если редактор не готов и вернул пустой текст, берется текст строки.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//
// Возвращаемое значение:
//  Структура:
//   * ИдентификаторСтроки - Число, Неопределено - текущая строка дерева наборов
//   * Тексты - Структура - текст из редактора по имени варианта
//
Функция ТекстыРедактора(Форма)
	
	Результат = Новый Структура("ИдентификаторСтроки, Тексты", Неопределено, Новый Структура);
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Обработчик = Неопределено;
	Если ТекД <> Неопределено Тогда
		Обработчик = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма, ТекД);
	КонецЕсли;
	
	Если Обработчик <> Неопределено И ЧитаемыеВарианты().Найти(Обработчик.Свойства().Имя) <> Неопределено Тогда
		ИмяВарианта = Обработчик.Свойства().Имя;
		// ЗапомнитьДанные пишет текст редактора в переданный объект: передаем копию, а не строку набора
		Копия = Новый Структура(ИмяВарианта, ТекД[ИмяВарианта]);
		Попытка
			Обработчик.ЗапомнитьДанные(Форма, Копия);
		Исключение
			Копия.Вставить(ИмяВарианта, ТекД[ИмяВарианта]); // редактор недоступен - остается текст строки
		КонецПопытки;
		Если ЗначениеЗаполнено(Копия[ИмяВарианта]) Тогда
			Результат.ИдентификаторСтроки = ТекД.ПолучитьИдентификатор();
			Результат.Тексты.Вставить(ИмяВарианта, Копия[ИмяВарианта]);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Строка дерева наборов по ключу настроек.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  Ключ - Строка - КлючНастроек строки
//
// Возвращаемое значение:
//  ДанныеФормыЭлементДерева, Неопределено - Неопределено, если строку удалили
//
Функция СтрокаПоКлючу(Форма, Ключ)
	
	СтрокаНабора = Неопределено;
	Отбор = Новый Структура("КлючНастроек", Новый УникальныйИдентификатор(Ключ));
	Строки = ОбщегоНазначенияКлиентСервер_Ei.НайтиВКоллекцииДерева(Отбор, НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма));
	Если Строки.Количество() > 0 Тогда
		СтрокаНабора = Строки.Получить(0);
	КонецЕсли;
	
	Возврат СтрокаНабора;
	
КонецФункции

// Варианты, которые create_variants пишет в строки и get_variants читает из них.
//
// Возвращаемое значение:
//  Массив из Строка - имена вариантов Ei
//
Функция ЧитаемыеВарианты()
	
	Имена = Новый Массив; // Массив из Строка
	Имена.Добавить(ВариантЗапросКлиентСервер_Ei.Свойства().Имя);
	Имена.Добавить(ВариантАлгоритмКлиентСервер_Ei.Свойства().Имя);
	Имена.Добавить(ВариантСКДКлиентСервер_Ei.Свойства().Имя);
	Имена.Добавить(ВариантJSONКлиентСервер_Ei.Свойства().Имя);
	Имена.Добавить(ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя);
	Имена.Добавить(ВариантКомментарийКлиентСервер_Ei.Свойства().Имя);
	
	Возврат Имена;
	
КонецФункции

// Простой текст варианта Комментарий из сериализованного форматированного документа, см. ТекстКомментария
//
// Параметры:
//  Значение - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстИзКомментария(Значение)
	
	Попытка
		Документ = ОбщегоНазначенияКлиентСервер_Ei.Структурировать(Значение, Новый ФорматированныйДокумент);
		Текст = Документ.ПолучитьТекст();
	Исключение
		Текст = Строка(Значение); // не XML документа - пользователь мог сохранить комментарий иначе
	КонецПопытки;
	
	Возврат Текст;
	
КонецФункции

#КонецОбласти

#Область Описание

Функция ПредставлениеМеста(Запрос)
	
	Возврат ?(Запрос.Контекст = "client", НСтр("ru = 'в клиенте'"), НСтр("ru = 'на сервере'"));
	
КонецФункции

Функция КраткоеОписаниеКода(Код)
	
	МаксимумСтрок = 3;
	Строки = СтрРазделить(Код, Символы.ПС, Ложь);
	Описание = Новый Массив; // Массив из Строка
	Для Каждого СтрокаКода Из Строки Цикл
		Если Описание.Количество() = МаксимумСтрок Тогда
			Описание.Добавить("...");
			Прервать;
		КонецЕсли;
		Описание.Добавить(СокрЛП(СтрокаКода));
	КонецЦикла;
	
	Возврат СтрСоединить(Описание, Символы.ПС);
	
КонецФункции

// Заголовок оповещения о наборах: имена строк верхнего уровня, подробности - в тексте, см. ЗаголовокНаборов
//
// Параметры:
//  Данные - Структура - данные уведомления о наборах, см. ПриПолученииНаборов
//
// Возвращаемое значение:
//  Строка
//
Функция ЗаголовокОповещенияНаборов(Данные)
	
	Имена = Новый Массив; // Массив из Строка
	Для Каждого Набор Из Данные.Наборы Цикл
		Имена.Добавить(Набор.Имя);
	КонецЦикла;
	
	//не Отладка: так будет называться отдельное оповещение об отладке запроса
	Возврат СтрШаблон(НСтр("ru = 'Консоль: %1'"), СтрСоединить(Имена, ", "));
	
КонецФункции

// Заголовок оповещения о прочитанных строках: имена строк верхнего уровня
//
// Параметры:
//  Строки - Массив из см. ОписаниеСтроки
//
// Возвращаемое значение:
//  Строка
//
Функция ЗаголовокОповещенияЧтения(Строки)
	
	Имена = Новый Массив; // Массив из Строка
	Для Каждого ОписаниеСтроки Из Строки Цикл
		Если СтрНайти(ОписаниеСтроки.Путь, "/") = 0 Тогда
			Имена.Добавить(ОписаниеСтроки.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрШаблон(НСтр("ru = 'Прочитано: %1'"), СтрСоединить(Имена, ", "));
	
КонецФункции

// Текст оповещения о прочитанных строках: сколько строк и выполненных вариантов передано
//
// Параметры:
//  Результат - Структура - результат чтения, см. ПрочитатьНаборы
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстОповещенияЧтения(Результат)
	
	Выполнено = 0;
	Для Каждого ОписаниеСтроки Из Результат.Строки Цикл
		Выполнено = Выполнено + ОписаниеСтроки.Результаты.Количество();
	КонецЦикла;
	
	Части = Новый Массив; // Массив из Строка
	Части.Добавить(СтрШаблон(НСтр("ru = 'Строк: %1, результатов вариантов: %2'"), Результат.Строки.Количество(), Выполнено));
	Если Результат.НеНайдены.Количество() > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'Не найдены: %1'"), СтрСоединить(Результат.НеНайдены, ", ")));
	КонецЕсли;
	
	Возврат СтрСоединить(Части, Символы.ПС);
	
КонецФункции

// Текст оповещения о наборах: описание от модели и опасные конструкции, имена строк - в заголовке,
// см. ЗаголовокОповещенияНаборов
//
// Параметры:
//  Данные - Структура - данные уведомления о наборах, см. ПриПолученииНаборов
//
// Возвращаемое значение:
//  Строка
//
Функция ЗаголовокНаборов(Данные)
	
	Части = Новый Массив; // Массив из Строка
	Если ЗначениеЗаполнено(Данные.Описание) Тогда
		Части.Добавить(Данные.Описание);
	КонецЕсли;
	
	Если Данные.ОпасныеКонструкции.Количество() > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'Опасно: %1'"), СтрСоединить(Данные.ОпасныеКонструкции, ", ")));
	КонецЕсли;
	
	Возврат СтрСоединить(Части, Символы.ПС);
	
КонецФункции

Процедура СообщитьОбОшибкеОтвета(Итог)
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: ответ не записан'"), , Итог.Ошибка,
		ОбщегоНазначенияКлиент_Ei.КартинкаОповещения());
	
КонецПроцедуры


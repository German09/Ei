Функция ЭтоЗапросДляТекущегоПользователя(Данные)
	
	Возврат ТипЗнч(Данные) = Тип("Структура")
		И Данные.Свойство("ВерсияПротокола") И Данные.ВерсияПротокола = ВерсияПротокола()
		И Данные.Свойство("Пользователь") И Данные.Пользователь = ИмяПользователя()
		И Данные.Свойство("Контекст") И (Данные.Контекст = "server" Или Данные.Контекст = "client");
	

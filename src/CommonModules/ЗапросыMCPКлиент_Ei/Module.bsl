// Клиентская часть агента MCP: получает запросы MCP через уведомления клиента,
// показывает код человеку и выполняет клиентский код.
// Протокол - docs/client-agent-protocol.md в репозитории 1c_mcp.

#Область ПрограммныйИнтерфейс

// Подписывает сеанс на запросы MCP. Вызывается при начале работы системы.
Процедура ПодключитьОбработчики() Экспорт
	
	Если Не УведомленияКлиентаПоддерживаются() Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Менеджер = МенеджерУведомленийКлиента();
		Менеджер.ПодключитьОбработчик(КлючУведомленияЗапрос(),
			Новый ОписаниеОповещения("ПриПолученииЗапроса", ЗапросыMCPКлиент_Ei, , "ПриОшибкеПолученияУведомления", ЗапросыMCPКлиент_Ei));
		Менеджер.ПодключитьОбработчик(КлючУведомленияЗакрыт(),
			Новый ОписаниеОповещения("ПриЗакрытииЗапроса", ЗапросыMCPКлиент_Ei, , "ПриОшибкеПолученияУведомления", ЗапросыMCPКлиент_Ei));
	Исключение
		// Платформа не дает подписаться: агент MCP в этом сеансе не работает, остальной Ei - работает.
		ПриОшибкеПолученияУведомления(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

// Выполняет клиентский код запроса и записывает ответ.
//
// Параметры:
//  Запрос - Структура - данные уведомления mcp_ЗапросВыполненияКода
//  Код - Строка - код к выполнению, пользователь мог его изменить
//
// Возвращаемое значение:
//  см. ЗапросыMCPВызовСервера_Ei.ЗаписатьОтвет
//
Функция ВыполнитьИОтветить(Запрос, Код) Экспорт
	
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("Код", Код);
	РезультатВыполнения.Вставить("КодИзменен", Код <> Запрос.Код);
	РезультатВыполнения.Вставить("Успех", Ложь);
	РезультатВыполнения.Вставить("РезультатJSON", "");
	РезультатВыполнения.Вставить("ТипРезультата", "");
	РезультатВыполнения.Вставить("Ошибка", "");
	
	Попытка
		Результат = ВыполнитьКлиентСервер_Ei.ВычислитьБезопасно(Код, Ложь);
		РезультатВыполнения.Успех = Истина;
		РезультатВыполнения.РезультатJSON = ЗначениеВJSON(Результат);
		РезультатВыполнения.ТипРезультата = Строка(ТипЗнч(Результат));
	Исключение
		РезультатВыполнения.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Итог = ЗапросыMCPВызовСервера_Ei.ЗаписатьОтвет(Запрос, "Выполнено", РезультатВыполнения);
	
	Если Не Итог.Записан Тогда
		СообщитьОбОшибкеОтвета(Итог);
	ИначеЕсли РезультатВыполнения.Успех Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: код выполнен в клиенте'"), , КраткоеОписаниеКода(Код),
			БиблиотекаКартинок.Информация);
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: ошибка выполнения кода в клиенте'"), ,
			КраткоеОписаниеКода(Код), БиблиотекаКартинок.Предупреждение);
	КонецЕсли;
	
	Возврат Итог;
	
КонецФункции

// Записывает решение человека по запросу без выполнения кода.
//
// Параметры:
//  Запрос - Структура - данные уведомления mcp_ЗапросВыполненияКода
//  Решение - Строка - Разрешено или Отклонено
//
// Возвращаемое значение:
//  см. ЗапросыMCPВызовСервера_Ei.ЗаписатьОтвет
//
Функция Ответить(Запрос, Решение) Экспорт
	
	Итог = ЗапросыMCPВызовСервера_Ei.ЗаписатьОтвет(Запрос, Решение);
	Если Не Итог.Записан Тогда
		СообщитьОбОшибкеОтвета(Итог);
	КонецЕсли;
	
	Возврат Итог;
	
КонецФункции

// Имя события Оповестить, по которому окно запроса закрывается.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяСобытияЗапросЗакрыт() Экспорт
	Возврат "mcp_ЗапросВыполненияКодаЗакрыт";
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик уведомления mcp_ЗапросВыполненияКода.
//
// Параметры:
//  Данные - Структура - см. docs/client-agent-protocol.md
//  ДополнительныеПараметры - Неопределено
//
Процедура ПриПолученииЗапроса(Данные, ДополнительныеПараметры) Экспорт
	
	Если Не ЭтоЗапросДляТекущегоПользователя(Данные) Тогда
		Возврат;
	КонецЕсли;
	
	Если Данные.Контекст = "client" Тогда
		// Полю ТребуетсяПодтверждение не доверяем: в копии базы уведомление может отправить любой код.
		ОпасныеКонструкции = ЗапросыMCPВызовСервера_Ei.ОпасныеКонструкции(Данные.Код, "client");
		Если ОпасныеКонструкции <> Неопределено И ОпасныеКонструкции.Количество() = 0 Тогда
			ВыполнитьИОтветить(Данные, Данные.Код);
			Возврат;
		КонецЕсли;
		Если ОпасныеКонструкции <> Неопределено Тогда
			Данные.ОпасныеКонструкции = ОпасныеКонструкции;
		КонецЕсли;
	КонецЕсли;
	
	// ПолучитьФорму, а не ОткрытьФорму: запрос передается в экспортную переменную формы до открытия.
	// Ключ уникальности - идентификатор запроса, повторное уведомление активизирует то же окно.
	//@skip-check use-non-recommended-method
	Форма = ПолучитьФорму("ОбщаяФорма.ЗапросMCP_Ei", , , Данные.Идентификатор);
	Если Не Форма.Открыта() Тогда
		Форма.Запрос = Данные;
	КонецЕсли;
	Форма.Открыть();
	
КонецПроцедуры

// Обработчик уведомления mcp_ЗапросВыполненияКодаЗакрыт.
//
// Параметры:
//  Данные - Структура:
//   * Идентификатор - Строка
//   * Причина - Строка
//  ДополнительныеПараметры - Неопределено
//
Процедура ПриЗакрытииЗапроса(Данные, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("Идентификатор") Тогда
		Оповестить(ИмяСобытияЗапросЗакрыт(), Данные.Идентификатор);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик ошибки получения уведомления.
//
// Параметры:
//  ИнформацияОбОшибке - ИнформацияОбОшибке
//  СтандартнаяОбработка - Булево
//  ДополнительныеПараметры - Неопределено
//
Процедура ПриОшибкеПолученияУведомления(ИнформацияОбОшибке, СтандартнаяОбработка = Истина, ДополнительныеПараметры = Неопределено) Экспорт
	
	СтандартнаяОбработка = Ложь;
	ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: запросы на выполнение кода недоступны'"), ,
		ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке), БиблиотекаКартинок.Предупреждение);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоЗапросДляТекущегоПользователя(Данные)
	
	Возврат ТипЗнч(Данные) = Тип("Структура")
		И Данные.Свойство("ВерсияПротокола") И Данные.ВерсияПротокола = ВерсияПротокола()
		И Данные.Свойство("Пользователь") И Данные.Пользователь = ИмяПользователя()
		И Данные.Свойство("Контекст") И (Данные.Контекст = "server" Или Данные.Контекст = "client");
	
КонецФункции

Процедура СообщитьОбОшибкеОтвета(Итог)
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'MCP: ответ не записан'"), , Итог.Ошибка,
		БиблиотекаКартинок.Предупреждение);
	
КонецПроцедуры

Функция ЗначениеВJSON(Значение)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, Значение);
		Текст = ЗаписьJSON.Закрыть();
	Исключение
		// Значение не сериализуется в JSON - отдаем его представление.
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Строка(Значение));
		Текст = ЗаписьJSON.Закрыть();
	КонецПопытки;
	
	Возврат Текст;
	
КонецФункции

Функция КраткоеОписаниеКода(Код)
	
	МаксимумСтрок = 3;
	Строки = СтрРазделить(Код, Символы.ПС, Ложь);
	Описание = Новый Массив; // Массив из Строка
	Для Каждого СтрокаКода Из Строки Цикл
		Если Описание.Количество() = МаксимумСтрок Тогда
			Описание.Добавить("...");
			Прервать;
		КонецЕсли;
		Описание.Добавить(СокрЛП(СтрокаКода));
	КонецЦикла;
	
	Возврат СтрСоединить(Описание, Символы.ПС);
	
КонецФункции

Функция МенеджерУведомленийКлиента()
	
	// Свойство глобального контекста появилось в 8.3.27 и неизвестно EDT - обращаемся по имени.
	Возврат Вычислить("УведомленияКлиента");
	
КонецФункции

Функция УведомленияКлиентаПоддерживаются()
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Возврат СравнитьВерсии(СистемнаяИнформация.ВерсияПриложения, МинимальнаяВерсияПлатформы()) >= 0;
	
КонецФункции

// Сравнивает версии вида 8.3.27.1606.
//
// Возвращаемое значение:
//  Число - больше нуля, если Версия1 новее, меньше нуля, если старее, ноль - если равны
//
Функция СравнитьВерсии(Версия1, Версия2)
	
	Результат = 0;
	Части1 = СтрРазделить(Версия1, ".");
	Части2 = СтрРазделить(Версия2, ".");
	ОписаниеЧисла = Новый ОписаниеТипов("Число");
	
	Для Индекс = 0 По Макс(Части1.ВГраница(), Части2.ВГраница()) Цикл
		Число1 = 0;
		Если Индекс <= Части1.ВГраница() Тогда
			Число1 = ОписаниеЧисла.ПривестиЗначение(Части1[Индекс]);
		КонецЕсли;
		Число2 = 0;
		Если Индекс <= Части2.ВГраница() Тогда
			Число2 = ОписаниеЧисла.ПривестиЗначение(Части2[Индекс]);
		КонецЕсли;
		Если Число1 <> Число2 Тогда
			Результат = Число1 - Число2;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ВерсияПротокола()
	Возврат 1;
КонецФункции

Функция КлючУведомленияЗапрос()
	Возврат "mcp_ЗапросВыполненияКода";
КонецФункции

Функция КлючУведомленияЗакрыт()
	Возврат "mcp_ЗапросВыполненияКодаЗакрыт";
КонецФункции

Функция МинимальнаяВерсияПлатформы()
	Возврат "8.3.27.1606";
КонецФункции

#КонецОбласти

#Область ИнтерфейсВариантов

Процедура ПриИзмененииДанных(Форма) Экспорт
	ВариантыКлиент_Ei.ПриИзмененииДанныхВариантаСРедактором(Форма,ВариантАлгоритмКлиентСервер_Ei);	
Конецпроцедуры

Процедура ПриОтображении(Форма) Экспорт
	ВариантыКлиент_Ei.ПриОтображенииВариантаСРедактором(Форма,ВариантАлгоритмКлиентСервер_Ei);			
Конецпроцедуры

Процедура ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
	ОтладкаКлиент_Ei.ПоказатьИсключение(Форма,ИнфоОбОшибке,ВариантыКлиентСервер_Ei,ВариантАлгоритмКлиентСервер_Ei);
КонецПроцедуры

Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ЭлементИнструкции = ЭлементИнструкции(Форма);	
	Если Не ЭлементИнструкции = Неопределено Тогда
		ТекстМодуляКлиент_Ei.ВыделитьОшибкуВТексте(Форма,Элемент,ЭлементИнструкции);
	КонецЕсли;			
КонецПроцедуры

Асинх Функция ПередВыполнением(Форма,ДопПараметры) Экспорт
	Возврат Ждать ВариантыКлиент_Ei.УточнитьРежимВыполнения(Форма, ДопПараметры,ВариантАлгоритмКлиентСервер_Ei);
КонецФункции

// Сохранить данные настройки на диск в формате EDT
// 
// Параметры:
//  Путь - Строка 	- Путь к папаке src
//  НаборИмя 		- Строка - Имя варианта набора
//  НаборКлюч 		- УникальныйИдентификатор - Ключ варината набора 
//  Данные			- ФиксированнаяСтруктура - Фиксированная структура подготовленная функцией ПодготовитьДанные()  
Асинх Функция Сохранить(Путь, НаборИмя, НаборКлюч, Данные) Экспорт
	Перем Результат;
	Если ЗначениеЗаполнено(Данные.Инструкция) Тогда
		//ФайлыКлиент_Ei.СохранитьОбщее(ВариантАлгоритмКлиентСервер_Ei, Путь, НаборИмя, НаборКлюч, Данные);
		Обработчик	= ВариантАлгоритмКлиентСервер_Ei;
		ВариантКлюч	= ВариантыКлиентСервер_Ei.ПолучитьИдентификатор(НаборКлюч,Обработчик);
		ВариантИмя	= ВариантыКлиентСервер_Ei.ПолучитьИмя(НаборИмя,Обработчик);//+"_"+Обработчик.Свойства().Имя;
		сМодуль 	= ВариантАлгоритмКлиентСервер_Ei.ПодготовитьМодуль(Данные.Инструкция); 
		//КаталогПуть = Ждать EDTКлиент_Ei.СоздатьОбшийМодуль(Путь, сМодуль, ВариантИмя, ВариантКлюч);
		КаталогПуть = Ждать EDTКлиент_Ei.СоздатьФормуОбработки(Путь, сМодуль, ВариантИмя, ВариантКлюч, НаборИмя);
		Результат 	= ФайлыКлиент_Ei.РезультатСохранения(ВариантИмя, Путь, сМодуль, ВариантКлюч, КаталогПуть, Новый Структура("Синоним",НаборИмя));
	Иначе
		УдалитьФайлыАсинх(Путь+"\"+НаборИмя+"_"+ВариантАлгоритмКлиентСервер_Ei.Свойства().Имя);
	КонецЕсли;
	Возврат Результат;		
КонецФункции	

// Прочитать данные из файла
// 
// Параметры:
//  Путь - Строка 	- Путь к файлы с данными
// 
// Возвращаемое значение:
// 	Структура - см. ВариантАлгоритмКлиентСервер_Ei.ПодготовитьДанные	
Функция Прочитать(Путь) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Инструкция",ФайлыКлиент_Ei.ПрочитатьТекст(Путь));
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Редактор_кода

Процедура ПриИзменении(Форма,Элемент) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если НЕ ТД = Неопределено Тогда
		Обработчик = ВариантАлгоритмКлиентСервер_Ei;	
		Обработчик.ЗапомнитьДанные(Форма,ТД);
		ВариантыКлиент_Ei.УстановитьМодифицированность(Форма,ТД,Обработчик);
	КонецЕсли;	
КонецПроцедуры

Функция ЭлементИнструкции(Форма) Экспорт 
	Возврат Форма.Элементы.Найти("HTML_Алгоритм");			
КонецФункции	

Процедура ПриНажатии(Форма,Элемент, ДанныеСобытия, СтандартнаяОбработка) Экспорт
	Событие=ДанныеСобытия.Event.eventData1C;
	Если Не Событие = Неопределено Тогда
		Если Событие.event="EVENT_CONTENT_CHANGED" Тогда
			ПриИзменении(Форма,Элемент);
		Иначе		
			РедакторКодаКлиент_Ei.ПолеHTML_ПриНажатии(Форма, Элемент, ДанныеСобытия, СтандартнаяОбработка, ЭтотОбъект);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

Процедура ДокументСформирован(Форма,Элемент) Экспорт
	Если РедакторКодаКлиент_Ei.ЭтоНеВебКлиент() Тогда
		РедакторКодаКлиент_Ei.ИнициализацияРедактора(Форма,Элемент);
		РедакторКодаКлиент_Ei.ЗагрузитьСниппеты(Элемент, "РедакторКода_Сниппеты_Ei"); //"ПользовательскиеСниппеты");
	КонецЕсли;
	Элемент.Доступность = Истина; 
	ПриИзмененииДанных(Форма); //ожидаю что это выполняется только один раз при загрузке
КонецПроцедуры

#КонецОбласти

Процедура ДоступныеПеременные(Форма,Команда) Экспорт
	стрПараметры 	= ОбщийМодульКлиент_Ei.ПолучитьСтруктуруПеременных(Форма,Неопределено);
	ФормаРодитель 	= ВыборКлиент_Ei.НаследоватьВыбор(Форма,Форма.Элементы.Выбор,Форма.Элементы.Право);
	ЭлементИнструкции = ЭлементИнструкции(Форма);	
	Если Не ЭлементИнструкции = Неопределено Тогда
		ТекстМодуляКлиент_Ei.ПоказатьДоступныеПеременные(Форма,ЭлементИнструкции,стрПараметры,ФормаРодитель.Выбор);
	КонецЕсли;	
КонецПроцедуры

Функция Модифицированность(Форма,ТД,Обработчик) Экспорт 
	Результат 	= Ложь;
	//Ищем запись о ранее сохраненном файле
	НаборКлюч		= ТД.КлючНастроек;
	ВариантКлюч		= ВариантыКлиентСервер_Ei.ПолучитьИдентификатор(НаборКлюч,Обработчик);
	СсылкаНаФайл 	= НаборВариантовКлиент_Ei.ПолучитьСсылкуНаФайл(ТД,ВариантКлюч);
	Данные 			= Обработчик.ПодготовитьДанные(ТД);
	сМодуль 		= Обработчик.ПодготовитьМодуль(Данные.Инструкция);
	Если ТипЗнч(СсылкаНаФайл)= Тип("Структура") Тогда
		//ссылку получили, сравним Хеш
		Хеш 		= ОбщийМодульВызовСервера_Ei.ПолучитьХешСтроки(сМодуль); 
		Результат 	= Не(СсылкаНаФайл.Хэш = Хеш);
	Иначе
		//В этом случае файл еще не сохранялся
		Результат 	= ЗначениеЗаполнено(сМодуль);		
	КонецЕсли;
	Возврат Результат;
КонецФункции			
	

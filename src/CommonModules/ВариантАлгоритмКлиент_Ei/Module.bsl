#Область ПрограммныйИнтерфейс
#Область ИнтерфейсВариантов

Процедура ПриИзмененииДанных(Форма) Экспорт
	ВариантыКлиент_Ei.ПриИзмененииДанныхВариантаСРедактором(Форма,ВариантАлгоритмКлиентСервер_Ei);	
Конецпроцедуры

Процедура ПриОтображении(Форма) Экспорт
	ВариантыКлиент_Ei.ПриОтображенииВариантаСРедактором(Форма,ВариантАлгоритмКлиентСервер_Ei);			
Конецпроцедуры

Процедура ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
	ОтладкаКлиент_Ei.ПоказатьИсключение(Форма,ИнфоОбОшибке,ВариантыКлиентСервер_Ei,ВариантАлгоритмКлиентСервер_Ei);
КонецПроцедуры

Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ЭлементИнструкции = ОбщегоНазначенияКлиент_Ei.ЭлементИнструкции(Форма);	
	Если Не ЭлементИнструкции = Неопределено Тогда
		ТекстМодуляКлиент_Ei.ВыделитьОшибкуВТексте(Форма,Элемент,ЭлементИнструкции);
	КонецЕсли;			
КонецПроцедуры

Асинх Функция ПередВыполнением(Форма,ДопПараметры) Экспорт
	КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
	ПолныйАлгоритм = ДопПараметры = Неопределено;
	Если Не ПолныйАлгоритм Тогда
		ПолныйАлгоритм = ДопПараметры.Количество() = 1 И ДопПараметры.Свойство("Весь");
	КонецЕсли;
	Результат = Ждать ВариантыКлиент_Ei.УточнитьРежимВыполнения(Форма, ДопПараметры, ВариантАлгоритмКлиентСервер_Ei);
	Если ПолныйАлгоритм И Не Форма.Модифицированность
		И Не ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(Результат, "ВыполнениеОтложено") Тогда
		ОбработкаEDT = ПодготовитьСобраннуюОбработку(Форма);
		Если ОбработкаEDT <> Неопределено Тогда
			Если Результат = Неопределено Тогда
				Результат = Новый Структура;
			КонецЕсли;
			Результат.Вставить("ОбработкаEDT", ОбработкаEDT);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Сохранить данные настройки на диск в формате EDT
// 
// Параметры:
//  Настройки 	- см. ВариантыКлиент_Ei.НастройкиСохранения
//  			
// Возвращаемое значение:
// 	см. ФайлыКлиент_Ei.РезультатСохранения
Асинх Функция Сохранить(Настройки) Экспорт
	Перем Результат;
	Данные = Настройки.Данные; //см. ВариантАлгоритмКлиентСервер_Ei.ПодготовитьДанные
	Если ЗначениеЗаполнено(Данные.Инструкция) Тогда		
		Обработчик	= ВариантАлгоритмКлиентСервер_Ei;
		ВариантКлюч	= ВариантыКлиентСервер_Ei.ПолучитьИдентификатор(Настройки.ВариантыКлюч,Обработчик);
		ВариантИмя	= ВариантыКлиентСервер_Ei.ПолучитьИмя(Настройки.ВариантыИмя,Обработчик);//+"_"+Обработчик.Свойства().Имя;
		//тип Результат - ссылка на модуль объекта, см. ВариантАлгоритмКлиентСервер_Ei.ОписаниеРезультатаФормы
		ОписаниеРезультата = ВариантАлгоритмКлиентСервер_Ei.ОписаниеРезультатаФормы(Настройки.ИмяНабора,
			ВариантАлгоритмКлиентСервер_Ei.ИмяФункцииАлгоритма(Настройки.ВариантыИмя));
		Модуль 	= ВариантАлгоритмКлиентСервер_Ei.ПодготовитьМодуль(ВыполнитьКлиентСервер_Ei.ПолучитьМодуль(Данные.Инструкция), Истина, ОписаниеРезультата);
		//КаталогПуть = Ждать EDTКлиент_Ei.СоздатьОбшийМодуль(Путь, сМодуль, ВариантИмя, ВариантКлюч);
		ОбщаяФорма = Неопределено;
		Если Настройки.Свойство("ОбщаяФорма", ОбщаяФорма) Тогда
			ОписаниеБлока = КодНабораКлиентСервер_Ei.ОписаниеБлока(Строка(ВариантКлюч), Строка(Настройки.ВариантыКлюч),
				Настройки.ВариантыИмя, Обработчик.Свойства().Код, "Алгоритм");
			Результат = ФормаНабораКлиент_Ei.ДобавитьБлок(ОбщаяФорма, ОписаниеБлока, Модуль, ВариантИмя,
				Новый Структура("Синоним", Настройки.ВариантыИмя));
		Иначе
			ПолноеИмя = Ждать EDTКлиент_Ei.СоздатьФормуОбработки(Настройки.Путь, Модуль, ВариантИмя, ВариантКлюч, Настройки.ВариантыИмя, Настройки.ИмяНабора);
			Результат = ФайлыКлиент_Ei.РезультатСохранения(ВариантИмя, Настройки.Путь, Модуль, ВариантКлюч, Новый Файл(ПолноеИмя), Новый Структура("Синоним", Настройки.ВариантыИмя));
		КонецЕсли;
	Иначе
		УдалитьФайлыАсинх(СтрШаблон("%1\%2_%3",Настройки.Путь,Настройки.ВариантыИмя,ВариантАлгоритмКлиентСервер_Ei.Свойства().Имя));
	КонецЕсли;
	Возврат Результат;		
КонецФункции	

// Прочитать данные из файла
// 
// Параметры:
//  Путь - Строка 	- Путь к файлы с данными
// 
// Возвращаемое значение:
//  Структура:
//   * Инструкция - Строка - текст алгоритма в виде Ei, см. ВариантАлгоритмКлиентСервер_Ei.ПолучитьВыражениеИзМодуля
Функция Прочитать(Путь) Экспорт
	ТекстМодуля = ФайлыКлиент_Ei.ПрочитатьТекст(Путь);
	Результат = Новый Структура;
	Результат.Вставить("Инструкция",ВариантАлгоритмКлиентСервер_Ei.ПолучитьВыражениеИзМодуля(ТекстМодуля));
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Редактор_кода

Процедура ПриИзменении(Форма,Элемент) Экспорт
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если НЕ ТекД = Неопределено Тогда
		Обработчик = ВариантАлгоритмКлиентСервер_Ei;	
		Обработчик.ЗапомнитьДанные(Форма,ТекД);
		ВариантыКлиент_Ei.УстановитьМодифицированность(Форма,ТекД,Обработчик);
	КонецЕсли;	
КонецПроцедуры


Процедура ПриНажатии(Форма,Элемент, ДанныеСобытия, СтандартнаяОбработка) Экспорт
	Событие=ДанныеСобытия.Event.eventData1C;
	Если Не Событие = Неопределено Тогда
		Если Событие.event="EVENT_CONTENT_CHANGED" Тогда
			ПриИзменении(Форма,Элемент);
		Иначе		
			РедакторКодаКлиент_Ei.ПолеHTML_ПриНажатии(Форма, Элемент, ДанныеСобытия, СтандартнаяОбработка, ЭтотОбъект);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

Процедура ДокументСформирован(Форма,Элемент) Экспорт
	РедакторКодаКлиент_Ei.ПолеHTML_ДокументСформирован(Форма, Элемент);
	ПриИзмененииДанных(Форма); //ожидаю что это выполняется только один раз при загрузке
КонецПроцедуры

#КонецОбласти

Процедура ДоступныеПеременные(Форма,Команда) Экспорт
	стрПараметры 	= ОбщегоНазначенияКлиент_Ei.ПолучитьСтруктуруПеременных(Форма,Неопределено);
	ФормаРодитель 	= ВыборКлиент_Ei.НаследоватьВыбор(Форма,Форма.Элементы.Выбор,Форма.Элементы.Право);
	ЭлементИнструкции = ОбщегоНазначенияКлиент_Ei.ЭлементИнструкции(Форма);	
	Если Не ЭлементИнструкции = Неопределено Тогда
		ТекстМодуляКлиент_Ei.ПоказатьДоступныеПеременные(Форма,ЭлементИнструкции,стрПараметры,ФормаРодитель.Выбор);
	КонецЕсли;	
КонецПроцедуры

// Модифицированность.
// 
// Параметры:
//  Форма 		- см. Обработка.Ei.Форма.Форма
//  ТекД 		- см. КонструкторКлиентСервер_Ei.ПолучитьПереопределяемыйОбъектОбработки
//  Обработчик 	- см. ВариантАлгоритмКлиентСервер_Ei
// 
// Возвращаемое значение:
//  Булево
Функция Модифицированность(Форма,ТекД,Обработчик) Экспорт 
	Результат 	= Ложь;
	//Ищем запись о ранее сохраненном файле
	НаборКлюч		= ТекД.КлючНастроек;
	ВариантКлюч		= ВариантыКлиентСервер_Ei.ПолучитьИдентификатор(НаборКлюч,Обработчик);
	СсылкаНаФайл 	= НаборВариантовКлиент_Ei.ПолучитьСсылкуНаФайл(ТекД,ВариантКлюч);
	Данные 			= Обработчик.ПодготовитьДанные(ТекД);
	//текст формы - тот же, что при сохранении: с той же ссылкой на тип Результат, см. Сохранить
	ОписаниеРезультата = ВариантАлгоритмКлиентСервер_Ei.ОписаниеРезультатаФормы(ФайлыКлиент_Ei.ИмяОбработки(Форма),
		ВариантАлгоритмКлиентСервер_Ei.ИмяФункцииАлгоритма(ТекД.ИмяНабора));
	Модуль 			= Обработчик.ПодготовитьМодуль(ВыполнитьКлиентСервер_Ei.ПолучитьМодуль(Данные.Инструкция), Истина, ОписаниеРезультата); //см. ВариантАлгоритмКлиентСервер_Ei.ПодготовитьМодуль
	Если ТипЗнч(СсылкаНаФайл) = Тип("Структура") И СсылкаНаФайл.Свойство("КлючБлока") Тогда
		Результат = СсылкаНаФайл.Хэш <> КодНабораКлиентСервер_Ei.КлючКода(Данные.Инструкция);
	ИначеЕсли ТипЗнч(СсылкаНаФайл)= Тип("Структура") Тогда
		//ссылку получили, сравним Хеш
		Хеш 		= ОбщегоНазначенияВызовСервера_Ei.ПолучитьХешСтроки(Модуль); 
		Результат 	= Не(СсылкаНаФайл.Хэш = Хеш);
	Иначе
		//В этом случае файл еще не сохранялся
		Результат 	= ЗначениеЗаполнено(Модуль);		
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Вставляет к выражение сформированное из нав. ссылки
// 
// Параметры:
//  Форма 	- см. Обработка.Ei.Форма.Форма
//  Команда - КомандаФормы
// 
Асинх Процедура ИзБуфера(Форма,Команда) Экспорт
	ИмяПараметра = Ждать ПараметрыКлиент_Ei.ИзБуфера(Форма,Команда);
	Если Не ИмяПараметра = Неопределено Тогда
		ЭлементИнструкции = ОбщегоНазначенияКлиент_Ei.ЭлементИнструкции(Форма);	
		Если Не ЭлементИнструкции = Неопределено Тогда
			ТекстМодуляКлиент_Ei.УстановитьВыделенныйТекст(ЭлементИнструкции,СтрШаблон("Параметры(""%1"")",ИмяПараметра));
		КонецЕсли;				
	КонецЕсли;	
КонецПроцедуры

// Подбирает собранную обработку для выполнения полного алгоритма.
// Несовпадение сборки выявляется до выполнения какого-либо пользовательского кода.
Функция ПодготовитьСобраннуюОбработку(Форма)
	Результат = Неопределено;
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Сборка = ФормаНабораКлиент_Ei.ГотоваяСборка(Форма);
	Если ТекД <> Неопределено И Сборка <> Неопределено Тогда
		Обработчик = ВариантАлгоритмКлиентСервер_Ei;
		Идентификатор = ВариантыКлиентСервер_Ei.ПолучитьИдентификатор(ТекД.КлючНастроек, Обработчик);
		Ссылка = НаборВариантовКлиент_Ei.ПолучитьСсылкуНаФайл(ТекД, Идентификатор);
		КлючБлока = "";
		Если ТипЗнч(Ссылка) = Тип("Структура") И Ссылка.Свойство("КлючБлока", КлючБлока) Тогда
			Режим = Сборка.Режимы.Получить(КлючБлока);
			Если Режим <> Неопределено Тогда
				АдресОбработки = "";
				Попытка
					Данные = Новый ДвоичныеДанные(Сборка.ПутьВыгрузки);
					АдресОбработки = ПоместитьВоВременноеХранилище(Данные, Форма.УникальныйИдентификатор);
					Имя = ВыполнитьВызовСервера_Ei.ПодключитьОбработкуEDT(АдресОбработки, Сборка.ПутьВыгрузки, Сборка.Хеш);
					Если ФормаНабораКлиент_Ei.ГотоваяСборка(Форма) = Сборка Тогда
						Результат = Новый Структура("ИмяОбработки,Форма,КлючБлока", Имя, Ссылка.Имя, КлючБлока);
						Результат.Вставить("КлючиКодаEi", Сборка.КлючиКода);
						Результат.Вставить("НаКлиенте", Режим = "Клиент" Или Режим = "КлиентСервер");
					КонецЕсли;
				Исключение
					// При устаревшей или недоступной EPF используем текущий алгоритм из Ei.
				КонецПопытки;
				Если Не ПустаяСтрока(АдресОбработки) Тогда
					УдалитьИзВременногоХранилища(АдресОбработки);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Выполнить алгоритм в форме обработки EDT: подключить обработку из выгрузки и получить форму алгоритма с адресом результата -
// форма работает только с клиента, как Клиент().Формы(). ПриСозданииНаСервере формы выполняет алгоритм, кладет описание значения
// в этот адрес и отменяет создание формы (во временном хранилище только значение), см. ВариантАлгоритмКлиентСервер_Ei.ПодготовитьМодуль.
// Все, что алгоритм вызывает внутри (параметры, запросы, другие варианты), выполняется, когда до него доходит код, через Ei:
// это серверный вызов, форму там получить нельзя. Ошибка алгоритма приходит исключением из ПолучитьФорму
//
// Параметры:
//  ОбработкаEDT - Структура - обработка для выполнения, см. ПодготовитьСобраннуюОбработку:
//   * ИмяОбработки - Строка - имя проверенной обработки в сеансе
//   * Форма - Строка - имя формы алгоритма в обработке
//   * КлючБлока - Строка - необязательный ключ алгоритма в общей форме
//   * НаКлиенте - Булево - запускать скомпилированный клиентский вход
//   * КлючиКодаEi - Соответствие из КлючИЗначение - соответствие выражений блокам общей формы
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор формы Ei
//
// Возвращаемое значение:
//  Произвольный - описание значения, см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
Функция ВыполнитьВОбработке(ОбработкаEDT, УникальныйИдентификатор) Экспорт
	ИмяФормы = СтрШаблон("ВнешняяОбработка.%1.Форма.%2", ОбработкаEDT.ИмяОбработки, ОбработкаEDT.Форма);
	НаКлиенте = Ложь;
	ОбработкаEDT.Свойство("НаКлиенте", НаКлиенте);
	Если НаКлиенте Тогда
		АдресКонтекста = ПоместитьВоВременноеХранилище(ОбработкаEDT.КлючиКодаEi, УникальныйИдентификатор);
		ПараметрыФормы = Новый Структура("АдресКонтекстаEi", АдресКонтекста);
		Попытка
			//@skip-check use-non-recommended-method
			Форма = ПолучитьФорму(ИмяФормы, ПараметрыФормы, , Новый УникальныйИдентификатор);
			Значение = Форма.ВыполнитьНаКлиентеEi(ОбработкаEDT.КлючБлока);
			Результат = ВыполнитьКлиентСервер_Ei.ПослеВычисленияЗначения(Значение, Неопределено, УникальныйИдентификатор);
		Исключение
			УдалитьИзВременногоХранилища(АдресКонтекста);
			ВызватьИсключение;
		КонецПопытки;
		УдалитьИзВременногоХранилища(АдресКонтекста);
	Иначе
		АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
		ПараметрыФормы = Новый Структура("АдресРезультата,ИдентификаторФормыEi", АдресРезультата, УникальныйИдентификатор);
		Если ОбработкаEDT.Свойство("КлючБлока") Тогда
			ПараметрыФормы.Вставить("КлючБлока", ОбработкаEDT.КлючБлока);
			ПараметрыФормы.Вставить("КлючиКодаEi", ОбработкаEDT.КлючиКодаEi);
		КонецЕсли;
		//@skip-check use-non-recommended-method
		ПолучитьФорму(ИмяФормы, ПараметрыФормы, , Новый УникальныйИдентификатор);
		Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	КонецЕсли;

#Область ИнтерфейсВариантов


Процедура ПриИзмененииДанных(Форма) Экспорт
	Если Форма.Элементы.HTML.Доступность Тогда
		//Нужно дождаться инциализации без этого не будет выполнения методов HTML
		ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
		Если НЕ ТД = Неопределено Тогда	
			РедакторКодаКлиент_Ei.УстановитьТекст(Форма.Элементы.HTML, ТД.Язык, 1, Ложь);;
		КонецЕсли;
	КонецЕсли;	
Конецпроцедуры

Процедура ПриОтображении(Форма) Экспорт
	ПараметрыКлиент_Ei.ИзменитьВидимость(Форма,Истина);
	Обработчик	= ВариантАлгоритмКлиентСервер_Ei;
	Заполнитель = КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,Обработчик);	
	Если Заполнитель.Видимость Тогда
		Заполнитель.Видимость = Ложь;
		Контейнер 	= КонструкторКлиентСервер_Ei.Контейнер(Форма,Обработчик);
			
		ФормаРодитель 	= ПолучитьФорму("ОбщаяФорма.РедакторКода_Ei");
			ПереопредПутиРеквизитов  = Новый Соответствие;
			ПереопредПутиРеквизитов.Вставить("Язык",КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента());
		НаследованиеФормКлиент_Ei.Дополнить(ФормаРодитель,Форма,Контейнер,ПереопредПутиРеквизитов);
		
		ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
		Если НЕ ТД = Неопределено Тогда
			ТД.Язык = РедакторКодаКлиент_Ei.Инициализация();		
		КонецЕсли;	

//		элФормы 	= Форма.Элементы.Добавить("Язык", Тип("ПолеФормы"), Контейнер);
//		элФормы.Вид 				= ВидПоляФормы.ПолеТекстовогоДокумента;
//		элФормы.ПутьКДанным			= "Элементы."+КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента()+".ТекущиеДанные.Язык";
//		элФормы.ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Нет;
//		элФормы.УстановитьДействие("ПриИзменении","АлгоритмПолеПриИзменении");
//		
//		ИмяКоманды	= "ДоступныеПеременные";
//		Кнопка = Форма.Элементы.Добавить(Обработчик.Свойства().Имя+ИмяКоманды, Тип("КнопкаФормы"), элФормы.КонтекстноеМеню);
//		Кнопка.ИмяКоманды = ИмяКоманды;	
	КонецЕсли;			
Конецпроцедуры

Процедура ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
	ОтладкаКлиент_Ei.ПоказатьИсключение(Форма,ИнфоОбОшибке,ВариантыКлиентСервер_Ei,ВариантАлгоритмКлиентСервер_Ei);
КонецПроцедуры

Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ТекстМодуляКлиент_Ei.ВыделитьОшибкуВТексте(Форма,Элемент,Форма.Элементы.Язык);		
КонецПроцедуры

#КонецОбласти

Процедура ТекстПриИзменении(Форма,Элемент) Экспорт
	КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
КонецПроцедуры

Процедура ДоступныеПеременные(Форма,Команда) Экспорт
	стрПараметры 	= ОбщийМодульКлиент_Ei.ПолучитьСтруктуруПеременных(Форма,Неопределено);
	ФормаРодитель 	= ВыборКлиент_Ei.НаследоватьВыбор(Форма,Форма.Элементы.Выбор,Форма.Элементы.Право);
	ТекстМодуляКлиент_Ei.ПоказатьДоступныеПеременные(Форма,Форма.Элементы.Язык,стрПараметры,ФормаРодитель.Выбор);
КонецПроцедуры

Процедура ПриИзменении(Форма,Элемент) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если НЕ ТД = Неопределено Тогда	
		ВариантАлгоритмКлиентСервер_Ei.ЗапомнитьДанные(Форма,ТД);
		КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
	КонецЕсли;	
КонецПроцедуры

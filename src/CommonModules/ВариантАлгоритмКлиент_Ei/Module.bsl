#Область ИнтерфейсВариантов

Процедура ПриИзмененииДанных(Форма) Экспорт
	ЭлементHTML = ОсновнойЭлемент(Форма);	
	Если Не ЭлементHTML = Неопределено И ЭлементHTML.Доступность Тогда
		//Нужно дождаться инциализации без этого не будет выполнения методов HTML
		ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
		Если НЕ ТД = Неопределено Тогда
			Алгоритм =  ТД.Алгоритм;
			РедакторКодаКлиент_Ei.ОчиститьТекст(ЭлементHTML);
			ТД.Алгоритм  = Алгоритм;	
			РедакторКодаКлиент_Ei.УстановитьТекст(ЭлементHTML,Алгоритм, 1, Ложь);;
		КонецЕсли;
	КонецЕсли;	
Конецпроцедуры

Функция ОсновнойЭлемент(Форма) Экспорт 
	Возврат Форма.Элементы.Найти("HTML_Алгоритм");			
КонецФункции	

Процедура ПриОтображении(Форма) Экспорт
	ПараметрыКлиент_Ei.ИзменитьВидимость(Форма,Истина);
	Обработчик	= ВариантАлгоритмКлиентСервер_Ei;
	Заполнитель = КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,Обработчик);	
	Если Заполнитель.Видимость Тогда
		Заполнитель.Видимость = Ложь;
		Контейнер 	= КонструкторКлиентСервер_Ei.Контейнер(Форма,Обработчик);
			
		ФормаРодитель 	= ПолучитьФорму("ОбщаяФорма.РедакторКодаАлгоритм_Ei");
		НаследованиеФормКлиент_Ei.Дополнить(ФормаРодитель,Форма,Контейнер,,КонструкторКлиентСервер_Ei.КонтейнерКП(Форма,Обработчик));//,ПереопредПутиРеквизитов);
		Форма.Алгоритм = РедакторКодаКлиент_Ei.Инициализация();		
	КонецЕсли;			
Конецпроцедуры

Процедура ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
	ОтладкаКлиент_Ei.ПоказатьИсключение(Форма,ИнфоОбОшибке,ВариантыКлиентСервер_Ei,ВариантАлгоритмКлиентСервер_Ei);
КонецПроцедуры

Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ЭлементHTML = ОсновнойЭлемент(Форма);	
	Если Не ЭлементHTML = Неопределено Тогда
		ТекстМодуляКлиент_Ei.ВыделитьОшибкуВТексте(Форма,Элемент,ЭлементHTML);
	КонецЕсли;			
КонецПроцедуры

#КонецОбласти

Процедура ТекстПриИзменении(Форма,Элемент) Экспорт
	КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
КонецПроцедуры

Процедура ДоступныеПеременные(Форма,Команда) Экспорт
	стрПараметры 	= ОбщийМодульКлиент_Ei.ПолучитьСтруктуруПеременных(Форма,Неопределено);
	ФормаРодитель 	= ВыборКлиент_Ei.НаследоватьВыбор(Форма,Форма.Элементы.Выбор,Форма.Элементы.Право);
	ЭлементHTML = ОсновнойЭлемент(Форма);	
	Если Не ЭлементHTML = Неопределено Тогда
		ТекстМодуляКлиент_Ei.ПоказатьДоступныеПеременные(Форма,ЭлементHTML,стрПараметры,ФормаРодитель.Выбор);
	КонецЕсли;	
КонецПроцедуры

Процедура ПриИзменении(Форма,Элемент) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если НЕ ТД = Неопределено Тогда	
		ВариантАлгоритмКлиентСервер_Ei.ЗапомнитьДанные(Форма,ТД);
		//КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
	КонецЕсли;	
КонецПроцедуры

Процедура ПриНажатии(Форма,Элемент, ДанныеСобытия, СтандартнаяОбработка) Экспорт
	Событие=ДанныеСобытия.Event.eventData1C;
	Если Не Событие=Неопределено И Событие.event="EVENT_CONTENT_CHANGED" Тогда
		ПриИзменении(Форма,Элемент);
	Иначе		
		РедакторКодаКлиент_Ei.ПолеHTML_ПриНажатии(Форма, Элемент, ДанныеСобытия, СтандартнаяОбработка);
	КонецЕсли;
КонецПроцедуры

Процедура ДокументСформирован(Форма,Элемент) Экспорт
	Если РедакторКодаКлиент_Ei.ЭтоНеВебКлиент() Тогда
		РедакторКодаКлиент_Ei.ИнициализацияРедактора(Элемент, Форма);
		РедакторКодаКлиент_Ei.ЗагрузитьСниппеты(Элемент, "РедакторКода_Сниппеты_Ei"); //"ПользовательскиеСниппеты");
	КонецЕсли;
	Элемент.Доступность = Истина; 
	ПриИзмененииДанных(Форма); //ожидаю что это выполняется только один раз при загрузке
КонецПроцедуры		
	

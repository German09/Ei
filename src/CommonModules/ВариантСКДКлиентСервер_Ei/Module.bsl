Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Код",			"e1f840eaa8a8"); //12 символьный идентификатор, необходим при сохранении настроек в формат EDT
	Результат.Вставить("Имя",			"СКД");
	Результат.Вставить("Синоним",		"СКД");
	Результат.Вставить("Картинка",		БиблиотекаКартинок.СКД_Ei);
	Результат.Вставить("Класс",			ВариантыКлиентСервер_Ei);
	Результат.Вставить("Исполнение",	Истина); //Исполняется и выводит результат или просто возможно сохранение данных
	Возврат Результат;
КонецФункции

Функция ВыполнитьВариант(УникальныйИдентификатор,ДопПараметры,ОбработчикРезультата = Неопределено, ДанныеКлиента) Экспорт
	Перем ОписаниеЗначения,СтрРасшифровки;
	ТекстСКД =  ВариантыКлиентСервер_Ei.ПолучитьИнструкцию(Неопределено,Свойства().Имя,ДопПараметры);	
	Если ЗначениеЗаполнено(ТекстСКД) Тогда
		ДопПараметры.Свойство("СтрРасшифровки",СтрРасшифровки);
		//ПараметрыКлиентСервер_Ei.УточнитьПараметры(ТД, УникальныйИдентификатор, Параметры);					
		Если ОбработчикРезультата =  Неопределено ИЛИ  
			 ОбработчикРезультата.ПереопределитьВыполнение(УникальныйИдентификатор,ДопПараметры,ВариантСКДКлиентСервер_Ei,ОписаниеЗначения) Тогда
			ОписаниеЗначения		= ВыполнитьКлиентСервер_Ei.СКД(ТекстСКД,УникальныйИдентификатор,,СтрРасшифровки);
		КонецЕсли;	
	КонецЕсли;
	Возврат ОписаниеЗначения;	
КонецФункции

Функция ПередВыполнением(Форма,ДопПараметры) Экспорт
	#Если Клиент Тогда
		КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
	#КонецЕсли	
	Возврат ДопПараметры;	
КонецФункции	

Процедура ПослеВыполнения(Форма,ДанныеКлиента) Экспорт
	Возврат;	
КонецПроцедуры	

// Подготовить данные для помещения их в параметры сеанса НаборВариантов_Ei
// 
// Параметры:
//  Форма Форма конструктора
//  Строка Строка дерева вариантов
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Подготовить данные:
// * Инструкция 
Функция ПодготовитьДанные(Строка) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Инструкция",Строка[Свойства().Имя]);
	Возврат Новый ФиксированнаяСтруктура(Результат);		
КонецФункции

// Обрабатываем исходные (сырые) данные для представления объекта во встроенном языке 
// 
// Параметры:
//  ИсходныеДанные -Структура,ФиксированнаяСтруктура- Исходные данные подготовленные функцией ПодготовитьДанные() 
// 
// Возвращаемое значение:
// 	Произвольный 
Функция Данные(ИсходныеДанные) Экспорт
	Возврат ИсходныеДанные;
КонецФункции	


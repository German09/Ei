#Область ПрограммныйИнтерфейс

// Получить переопределяемый объект обработки.
// 
// Параметры:
//  Форма 			см. Обработка.Ei.Форма.Форма
//  Идентификатор  	- Число
// 
// Возвращаемое значение:
//  ДанныеФормыЭлементДерева:
//		*ИмяНабора 			- Строка -
//		*КлючНастроек		- УникальныйИдентификатор
//		*Файлы				- Произвольный
//		*ПараметрыЗапроса	- ДанныеФормыКоллекция:
//			*ИмяПараметра 		- Строка
//			*ЗначениеПараметра 	- Произвольный 
//			*Ключ 				- Строка
//			*ЭтоВыражение 		- Булево
Функция ПолучитьПереопределяемыйОбъектОбработки(Форма,Идентификатор = Неопределено) Экспорт
	#Если Клиент Тогда
		Возврат Форма.Элементы.Найти(ИмяОсновногоЭлмента()).ТекущиеДанные;	
	#Иначе
		Возврат Форма[ИмяОсновногоЭлмента()].НайтиПоИдентификатору(Идентификатор);	
	#КонецЕсли	
КонецФункции

Функция Контейнер(Форма,Обработчик) Экспорт 
	Свойства 	= Обработчик.Свойства();
	Контейнер 	= Форма.Элементы.Найти(Свойства.Имя);
	Если Контейнер = Неопределено Тогда
		#Если Клиент Тогда
			//на клиенте всегда страница уже будет, осталено для совместимости
			Форма.СоздатьСтраницу(Свойства.Класс.Контейнер(Форма).Имя, Свойства.Имя);
			Контейнер 	= Форма.Элементы.Найти(Свойства.Имя);
		#Иначе
			Контейнер	= ОбщегоНазначения_Ei.СоздатьСтраницу(Форма,Свойства.Класс.Контейнер(Форма).Имя, Свойства.Имя);
		#КонецЕсли				
	КонецЕсли;
	Возврат Контейнер;	
КонецФункции

Функция ГруппаКонтейнера(Форма,Обработчик) Экспорт
	Свойства 	= Обработчик.Свойства();
	ИмяГруппы 	= "ПодГруппа" + Свойства.Имя;
	Группа 		= Форма.Элементы.Найти(ИмяГруппы);	
	Если Группа = Неопределено Тогда
		Контейнер 	= Контейнер(Форма,Обработчик); 
		Группа 		= Форма.Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), Контейнер);
		Группа.Вид 					= ВидГруппыФормы.Страницы;
		Группа.ОтображениеСтраниц 	= ОтображениеСтраницФормы.Нет;				
		ДобавитьПустуюСтраницу(Форма,Группа,Обработчик);
	КонецЕсли;
	Возврат Группа;
КонецФункции

// Страница группы контейнера на случай, когда у строки набора нет результата, см. КонструкторКлиент_Ei.ВидимостьДинЭлементов
// У результатов на ней логотип: группа с данными и логотип переключаются сменой текущей страницы, без смены видимости,
// которая сбрасывает размеры областей, заданные пользователем. Размер логотипа задан и он не растягивается:
// в реальном размере он не дает панели быть ниже картинки, и граница над панелью едет при показе логотипа,
// а растянутый занимает всю панель. Заполнитель - чтобы страница без логотипа не скрывалась.
//
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
//  Группа - ГруппаФормы - см. ГруппаКонтейнера
//  Обработчик - ОбщийМодуль
//
Процедура ДобавитьПустуюСтраницу(Форма,Группа,Обработчик)
	Страница 				= Форма.Элементы.Добавить(ИмяПустойСтраницы(Обработчик), Тип("ГруппаФормы"), Группа);
	Страница.Вид 			= ВидГруппыФормы.Страница;
	Если Обработчик.Свойства().Класс = РезультатыКлиентСервер_Ei Тогда
		Логотип 							= ЗаполнительКонтейнера(Форма,Обработчик);
		Форма.Элементы.Переместить(Логотип,Страница);
		Логотип.РазмерКартинки 				= РазмерКартинки.Пропорционально;
		Логотип.РастягиватьПоВертикали 		= Ложь;
		Логотип.РастягиватьПоГоризонтали 	= Ложь;
		Логотип.Ширина 						= 40;
		Логотип.Высота 						= 5;
		Страница.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Центр;
		Страница.ВертикальноеПоложениеПодчиненных 	= ВертикальноеПоложениеЭлемента.Центр;
		Страница.РастягиватьПоГоризонтали 	= Истина;
		Страница.РастягиватьПоВертикали 	= Истина; //без растягивания страница по высоте логотипа и центр по вертикали не действует
		Группа.РастягиватьПоГоризонтали 	= Истина;
		Группа.РастягиватьПоВертикали 		= Истина;
	Иначе
		Заполнитель 			= Форма.Элементы.Добавить(Страница.Имя+"Заполнитель", Тип("ДекорацияФормы"), Страница);
		Заполнитель.Вид 		= ВидДекорацииФормы.Надпись;
		Заполнитель.Заголовок 	= " ";
	КонецЕсли;
КонецПроцедуры

// Имя страницы группы контейнера без результата, см. ДобавитьПустуюСтраницу
//
// Параметры:
//  Обработчик - ОбщийМодуль
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПустойСтраницы(Обработчик) Экспорт
	Возврат "ПодГруппа" + Обработчик.Свойства().Имя + "Пусто";
КонецФункции

Функция КонтейнерКП(Форма,Обработчик,ОбщийКонтейнер = Неопределено, Имя = Неопределено) Экспорт 
	Если Имя = Неопределено Тогда
		Имя		= КонструкторКлиентСервер_Ei.ПолучитьИмяКПОбработчика(Обработчик);
	КонецЕсли;	
	Контейнер 	= Форма.Элементы.Найти(Имя);
	Если Контейнер = Неопределено Тогда
		Если ОбщийКонтейнер = Неопределено Тогда
			ОбщийКонтейнер		= Обработчик.Свойства().Класс.ГруппаКонтейнераКП(Форма);
		КонецЕсли;	
		Если Не ОбщийКонтейнер = Неопределено Тогда
			Родитель = ОбщийКонтейнер;
			Если ОбщийКонтейнер.Вид = ВидГруппыФормы.Страницы Тогда
				Родитель = ПанельСтраницыКП(Форма,ОбщийКонтейнер,Имя);
			КонецЕсли;
			Контейнер 			= Форма.Элементы.Вставить(Имя, Тип("ГруппаФормы"), Родитель);
			Контейнер.Вид 		= ВидГруппыФормы.ГруппаКнопок;
			Контейнер.Отображение = ОтображениеГруппыКнопок.Компактное; //кнопки варианта вместе, как и основные
		КонецЕсли;			
	КонецЕсли;
	Возврат Контейнер;	
КонецФункции

// Страница группы ВаринатыКП или РезультатыКП с командной панелью обработчика, см. КонструкторКлиент_Ei.АктивизироватьКП
// Команды переключаются сменой текущей страницы: смена видимости групп сбрасывала размеры областей, заданные пользователем.
// Страница без видимых элементов не показывается, поэтому на ней заполнитель: у обработчика может не быть команд.
//
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
//  Страницы - ГруппаФормы - группа страниц
//  ИмяКП - Строка - см. ПолучитьИмяКПОбработчика
//
// Возвращаемое значение:
//  ГруппаФормы - командная панель на странице
//
Функция ПанельСтраницыКП(Форма,Страницы,ИмяКП)
	Страница 				= Форма.Элементы.Добавить(ИмяСтраницыКП(ИмяКП), Тип("ГруппаФормы"), Страницы);
	Страница.Вид 			= ВидГруппыФормы.Страница;
	Страница.Группировка 	= ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	Панель 					= Форма.Элементы.Добавить("Панель"+ИмяКП, Тип("ГруппаФормы"), Страница);
	Панель.Вид 				= ВидГруппыФормы.КоманднаяПанель;
	Заполнитель 			= Форма.Элементы.Добавить("Заполнитель"+ИмяКП, Тип("ДекорацияФормы"), Страница);
	Заполнитель.Вид 		= ВидДекорацииФормы.Надпись;
	Заполнитель.Заголовок 	= " ";
	Возврат Панель;
КонецФункции

// Имя страницы с командной панелью обработчика.
//
// Параметры:
//  ИмяКП - Строка - см. ПолучитьИмяКПОбработчика
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяСтраницыКП(ИмяКП) Экспорт
	Возврат "Стр"+ИмяКП;
КонецФункции

// Страница варианта в правой панели, рядом с параметрами: туда наследуется группа формы варианта,
// названная в свойстве варианта БоковаяЧасть, см. ВариантПроцессыКлиентСервер_Ei.Свойства.
// Создается на сервере при создании формы, на клиенте только находится.
//
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
//  Обработчик - ОбщийМодуль - вариант
//
// Возвращаемое значение:
//  ГруппаФормы, Неопределено - Неопределено, если у варианта нет боковой части или у формы нет правой панели
//
Функция КонтейнерЧасти(Форма, Обработчик) Экспорт
	Контейнер = Неопределено;
	Если Обработчик.Свойства().Свойство("БоковаяЧасть") Тогда
		Имя 		= ИмяСтраницыЧастиВарианта() + Обработчик.Свойства().Имя;
		Контейнер 	= Форма.Элементы.Найти(Имя);
		#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
			Если Контейнер = Неопределено Тогда
				Группа = ГруппаЧастейВариантов(Форма);
				Если Не Группа = Неопределено Тогда
					Контейнер 		= Форма.Элементы.Добавить(Имя, Тип("ГруппаФормы"), Группа);
					Контейнер.Вид 	= ВидГруппыФормы.Страница;
				КонецЕсли;
			КонецЕсли;
		#КонецЕсли
	КонецЕсли;
	Возврат Контейнер;
КонецФункции

// Группа страниц частей вариантов на закладке «Вариант» правой панели, см. КонтейнерЧасти.
// Закладка одна на все варианты, ее заголовок - из реквизита: части переключаются сменой текущей страницы группы
// без закладок, смена видимости и заголовка сбрасывала бы размеры областей, заданные пользователем,
// переключает КонструкторКлиент_Ei.АктивизироватьЧасть. Пустая страница - для вариантов без боковой части.
//
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
//
// Возвращаемое значение:
//  ГруппаФормы, Неопределено - Неопределено, если у формы нет правой панели
//
Функция ГруппаЧастейВариантов(Форма) Экспорт
	Группа = Форма.Элементы.Найти(ИмяСтраницыЧастиВарианта() + "Страницы");
	#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
		ПраваяПанель = Форма.Элементы.Найти("СтраницыПараметры");
		Если Группа = Неопределено И Не ПраваяПанель = Неопределено Тогда
			ИмяРеквизитаЗаголовка			= НаборВариантовКлиентСервер_Ei.ИмяРеквизитаЗаголовка(ИмяСтраницыЧастиВарианта());
			Форма[ИмяРеквизитаЗаголовка] 	= ЗаголовокБезЧасти();
			Страница 						= Форма.Элементы.Добавить(ИмяСтраницыЧастиВарианта(), Тип("ГруппаФормы"), ПраваяПанель);
			Страница.Вид 					= ВидГруппыФормы.Страница;
			Страница.ПутьКДаннымЗаголовка 	= ИмяРеквизитаЗаголовка;
			Страница.Картинка 				= БиблиотекаКартинок.Варианты_Ei;
			Группа 							= Форма.Элементы.Добавить(ИмяСтраницыЧастиВарианта() + "Страницы", Тип("ГруппаФормы"), Страница);
			Группа.Вид 						= ВидГруппыФормы.Страницы;
			Группа.ОтображениеСтраниц 		= ОтображениеСтраницФормы.Нет;
			Группа.РастягиватьПоГоризонтали = Истина;
			Группа.РастягиватьПоВертикали 	= Истина;
			ПустаяСтраница 					= Форма.Элементы.Добавить(ИмяПустойЧастиВарианта(), Тип("ГруппаФормы"), Группа);
			ПустаяСтраница.Вид 				= ВидГруппыФормы.Страница;
			//надпись по центру панели: без растягивания страница по высоте надписи и центр по вертикали не действует
			ПустаяСтраница.РастягиватьПоГоризонтали 			= Истина;
			ПустаяСтраница.РастягиватьПоВертикали 				= Истина;
			ПустаяСтраница.ГоризонтальноеПоложениеПодчиненных 	= ГоризонтальноеПоложениеЭлемента.Центр;
			ПустаяСтраница.ВертикальноеПоложениеПодчиненных 	= ВертикальноеПоложениеЭлемента.Центр;
			Надпись 						= Форма.Элементы.Добавить(ИмяПустойЧастиВарианта() + "Надпись", Тип("ДекорацияФормы"), ПустаяСтраница);
			Надпись.Вид 					= ВидДекорацииФормы.Надпись;
			Надпись.Заголовок 				= "У текущего варианта нет части для этой панели";
			Надпись.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр;
		КонецЕсли;
	#КонецЕсли
	Возврат Группа;
КонецФункции

// Имя закладки части варианта в правой панели, начало имен ее элементов, см. ГруппаЧастейВариантов.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяСтраницыЧастиВарианта() Экспорт
	Возврат "ЧастьВарианта";
КонецФункции

// Имя страницы частей вариантов для варианта без боковой части, см. ГруппаЧастейВариантов.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПустойЧастиВарианта() Экспорт
	Возврат ИмяСтраницыЧастиВарианта() + "Пусто";
КонецФункции

// Заголовок закладки части варианта у варианта без боковой части.
//
// Возвращаемое значение:
//  Строка
//
Функция ЗаголовокБезЧасти() Экспорт
	Возврат "Вариант";
КонецФункции

Функция ПолучитьИмяКПОбработчика(Обработчик,сОкончание="") Экспорт
	Возврат "КП"+Обработчик.Свойства().Имя+сОкончание;
КонецФункции

Функция ПолучитьКнопкуВидимости(Форма,Класс,Контейнер = Неопределено) Экспорт
	ИмяКнопкиВидимости 	= "Видимость_"+Класс.Ключ();
	КнопкаВидимости		= Форма.Элементы.Найти(ИмяКнопкиВидимости);
	Если КнопкаВидимости = Неопределено Тогда
		Если Контейнер = Неопределено Тогда
			Контейнер = Форма.Элементы.Найти("КомандыФормы"); //не группа страниц КП: кнопка видна при любом варианте
		КонецЕсли;	
		КнопкаВидимости = Форма.Элементы.Вставить(ИмяКнопкиВидимости, Тип("КнопкаФормы"), Контейнер);
		КнопкаВидимости.ИмяКоманды = "ВидимостьПанелей_"+Класс.Ключ();
		КнопкаВидимости.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВДополнительномПодменю; //если отобразить в командном меню то она получается отрвана от сотальных кнопок, мутить перемешение этого элемента, слишком затратно поскольку нужен вызов сервера
		ПанельФормы = Класс.Панель(Форма);
		Если Не ПанельФормы = Неопределено Тогда
			КнопкаВидимости.Пометка = ПанельФормы.Видимость;
		КонецЕсли;	
	КонецЕсли;
	Возврат КнопкаВидимости; 
КонецФункции				

//Без заполнителя закладка варианта или результата будет не видна и ее не получится выбрать
//
Функция ЗаполнительКонтейнера(Форма,Обработчик) Экспорт	
	ИмяЭлФормы 	= "Логотип"+Обработчик.Свойства().Имя;
	Заполнитель = Форма.Элементы.Найти(ИмяЭлФормы);
	Если Заполнитель = Неопределено Тогда
		#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
			Контейнер 		= Контейнер(Форма,Обработчик);
			Заполнитель	 	= Форма.Элементы.Добавить(ИмяЭлФормы, Тип("ДекорацияФормы"), Контейнер);
			Заполнитель.Вид								= ВидДекорацииФормы.Картинка;
			Заполнитель.Картинка						= БиблиотекаКартинок.Логотип_Ei;
			//без размеров декорация берет размер картинки 1200x364 как минимальный, и форма Ei не сжимается:
			//появляется прокрутка, соседние области сужаются. Растянутая декорация занимает панель, картинка пропорциональна
			Заполнитель.РазмерКартинки					= РазмерКартинки.Пропорционально;
			Заполнитель.Ширина							= 10;
			Заполнитель.Высота							= 2;
			Заполнитель.ГоризонтальноеПоложениеВГруппе 	= ГоризонтальноеПоложениеЭлемента.Центр;
			Заполнитель.ВертикальноеПоложениеВГруппе 	= ВертикальноеПоложениеЭлемента.Центр;
			Заполнитель.РастягиватьПоВертикали		 	= Истина;
			Заполнитель.РастягиватьПоГоризонтали	 	= Истина;
		#КонецЕсли		
	КонецЕсли;
	Возврат Заполнитель;			
КонецФункции	

Функция СтраницаГруппыКонтейнера(Форма,Обработчик,ИмяРеквизита) Экспорт	
	Группа 	= ГруппаКонтейнера(Форма,Обработчик);
	ИмяСтраницы = ИмяСтраницыКонтейнера(Группа,ИмяРеквизита);
	Страница 	= Форма.Элементы.Найти(ИмяСтраницы); 
	Если Страница = Неопределено Тогда
		Страница 	= Форма.Элементы.Добавить(ИмяСтраницы, Тип("ГруппаФормы"), Группа);
	КонецЕсли;
	Возврат Страница;	
КонецФункции	

Функция ИмяСтраницыКонтейнера(Контейнер,ИмяРеквизита) Экспорт
	Возврат Контейнер.Имя+ИмяРеквизита;	
КонецФункции	

// Получает динамическое имя реквизита в зависимости от обработчика и требуемого результата,
// 
// Параметры:
//  Форма 	- Форма
//  ТекД 		- ДанныеФормыЭлементДерева - Текущая строка данных варианта
//  ОбработчикРезультата - ОбщийМодуль - В некоторых вызовах из "ВариантКоллекция" вместо ОбработчикаРезультата может передаваться обработчик варианта
// 
// Возвращаемое значение:
// 	Строка- Имя реквизита 
Функция ДинамическоеИмяРеквизита(Форма, ТекД, ОбработчикРезультата) Экспорт
	Если ОбработчикРезультата = ВариантКоллекцияКлиентСервер_Ei Тогда
		ОбработчикВарианта  = ОбработчикРезультата;	
	Иначе	
		ОбработчикВарианта 	= ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТекД);	
	КонецЕсли;	
	Возврат  СтрШаблон("%1%2_%3",ОбработчикВарианта.Свойства().Имя
								,ПользовательКлиентСервер_Ei.ПодготовитьКлючНастроек(ТекД)
								,ОбработчикРезультата.Свойства().Имя); 		
КонецФункции
#КонецОбласти


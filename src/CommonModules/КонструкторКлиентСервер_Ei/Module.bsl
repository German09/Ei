#Область ПрограммныйИнтерфейс

// Получить переопределяемый объект обработки.
// 
// Параметры:
//  Форма 			см. ОбщаяФорма.Ei
//  Идентификатор  	- Число
// 
// Возвращаемое значение:
//  ДанныеФормыЭлементДерева:
//		*ИмяНабора 			- Строка -
//		*КлючНастроек		- УникальныйИдентификатор
//		*Файлы				- Произвольный
//		*ПараметрыЗапроса	- ДанныеФормыКоллекция:
//			*ИмяПараметра 		- Строка
//			*ЗначениеПараметра 	- Произвольный 
//			*Ключ 				- Строка
//			*ЭтоВыражение 		- Булево
Функция ПолучитьПереопределяемыйОбъектОбработки(Форма,Идентификатор = Неопределено) Экспорт
	#Если Клиент Тогда
		Возврат Форма.Элементы.Найти(ИмяОсновногоЭлмента()).ТекущиеДанные;	
	#Иначе
		Возврат Форма[ИмяОсновногоЭлмента()].НайтиПоИдентификатору(Идентификатор);	
	#КонецЕсли	
КонецФункции

Функция Контейнер(Форма,Обработчик) Экспорт 
	Свойства 	= Обработчик.Свойства();
	Контейнер 	= Форма.Элементы.Найти(Свойства.Имя);
	Если Контейнер = Неопределено Тогда
		#Если Клиент Тогда
			//на клиенте всегда страница уже будет, осталено для совместимости
			Форма.СоздатьСтраницу(Свойства.Класс.Контейнер(Форма).Имя, Свойства.Имя);
			Контейнер 	= Форма.Элементы.Найти(Свойства.Имя);
		#Иначе
			Контейнер	= ОбщегоНазначения_Ei.СоздатьСтраницу(Форма,Свойства.Класс.Контейнер(Форма).Имя, Свойства.Имя);
		#КонецЕсли				
	КонецЕсли;
	Возврат Контейнер;	
КонецФункции

Функция ГруппаКонтейнера(Форма,Обработчик) Экспорт
	Свойства 	= Обработчик.Свойства();
	ИмяГруппы 	= "ПодГруппа" + Свойства.Имя;
	Группа 		= Форма.Элементы.Найти(ИмяГруппы);	
	Если Группа = Неопределено Тогда
		Контейнер 	= Контейнер(Форма,Обработчик); 
		Группа 		= Форма.Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), Контейнер);
		Группа.Вид 					= ВидГруппыФормы.Страницы;
		Группа.ОтображениеСтраниц 	= ОтображениеСтраницФормы.Нет;				
	КонецЕсли;
	Возврат Группа;
КонецФункции

Функция КонтейнерКП(Форма,Обработчик,ОбщийКонтейнер = Неопределено, Имя = Неопределено) Экспорт 
	Если Имя = Неопределено Тогда
		Имя		= КонструкторКлиентСервер_Ei.ПолучитьИмяКПОбработчика(Обработчик);
	КонецЕсли;	
	Контейнер 	= Форма.Элементы.Найти(Имя);
	Если Контейнер = Неопределено Тогда
		Если ОбщийКонтейнер = Неопределено Тогда
			ОбщийКонтейнер		= Обработчик.Свойства().Класс.ГруппаКонтейнераКП(Форма);
		КонецЕсли;	
		Если Не ОбщийКонтейнер = Неопределено Тогда
			Контейнер 			= Форма.Элементы.Вставить(Имя, Тип("ГруппаФормы"), ОбщийКонтейнер);
			Контейнер.Вид 		= ВидГруппыФормы.ГруппаКнопок;
		КонецЕсли;			
	КонецЕсли;
	Возврат Контейнер;	
КонецФункции

Функция ПолучитьИмяКПОбработчика(Обработчик,сОкончание="") Экспорт
	Возврат "КП"+Обработчик.Свойства().Имя+сОкончание;
КонецФункции

Функция ПолучитьКнопкуВидимости(Форма,Класс,Контейнер = Неопределено) Экспорт
	ИмяКнопкиВидимости 	= "Видимость_"+Класс.Ключ();
	КнопкаВидимости		= Форма.Элементы.Найти(ИмяКнопкиВидимости);
	Если КнопкаВидимости = Неопределено Тогда
		Если Контейнер = Неопределено Тогда
			Контейнер = Класс.ГруппаКонтейнераКП(Форма);		
		КонецЕсли;	
		КнопкаВидимости = Форма.Элементы.Вставить(ИмяКнопкиВидимости, Тип("КнопкаФормы"), Контейнер);
		КнопкаВидимости.ИмяКоманды = "ВидимостьПанелей_"+Класс.Ключ();
		КнопкаВидимости.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВДополнительномПодменю; //если отобразить в командном меню то она получается отрвана от сотальных кнопок, мутить перемешение этого элемента, слишком затратно поскольку нужен вызов сервера
		ПанельФормы = Класс.Панель(Форма);
		Если Не ПанельФормы = Неопределено Тогда
			КнопкаВидимости.Пометка = ПанельФормы.Видимость;
		КонецЕсли;	
	КонецЕсли;
	Возврат КнопкаВидимости; 
КонецФункции				

//Без заполнителя закладка варианта или результата будет не видна и ее не получится выбрать
//
Функция ЗаполнительКонтейнера(Форма,Обработчик) Экспорт	
	ИмяЭлФормы 	= "Логотип"+Обработчик.Свойства().Имя;
	Заполнитель = Форма.Элементы.Найти(ИмяЭлФормы);
	Если Заполнитель = Неопределено Тогда
		#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
			Контейнер 		= Контейнер(Форма,Обработчик);
			Заполнитель	 	= Форма.Элементы.Добавить(ИмяЭлФормы, Тип("ДекорацияФормы"), Контейнер);
			Заполнитель.Вид								= ВидДекорацииФормы.Картинка;
			Заполнитель.Картинка						= БиблиотекаКартинок.Логотип_Ei;
			Заполнитель.ГоризонтальноеПоложениеВГруппе 	= ГоризонтальноеПоложениеЭлемента.Центр;
			Заполнитель.ВертикальноеПоложениеВГруппе 	= ВертикальноеПоложениеЭлемента.Центр;
			Заполнитель.РастягиватьПоВертикали		 	= Истина;
			Заполнитель.РастягиватьПоГоризонтали	 	= Истина;
		#КонецЕсли		
	КонецЕсли;
	Возврат Заполнитель;			
КонецФункции	

Функция СтраницаГруппыКонтейнера(Форма,Обработчик,ИмяРеквизита) Экспорт	
	Группа 	= ГруппаКонтейнера(Форма,Обработчик);
	ИмяСтраницы = ИмяСтраницыКонтейнера(Группа,ИмяРеквизита);
	Страница 	= Форма.Элементы.Найти(ИмяСтраницы); 
	Если Страница = Неопределено Тогда
		Страница 	= Форма.Элементы.Добавить(ИмяСтраницы, Тип("ГруппаФормы"), Группа);
	КонецЕсли;
	Возврат Страница;	
КонецФункции	

Функция ИмяСтраницыКонтейнера(Контейнер,ИмяРеквизита) Экспорт
	Возврат Контейнер.Имя+ИмяРеквизита;	
КонецФункции	

// Получает динамическое имя реквизита в зависимости от обработчика и требуемого результата,
// 
// Параметры:
//  Форма 	- Форма
//  ТекД 		- ДанныеФормыЭлементДерева - Текущая строка данных варианта
//  ОбработчикРезультата - ОбщийМодуль - В некоторых вызовах из "ВариантКоллекция" вместо ОбработчикаРезультата может передаваться обработчик варианта
// 
// Возвращаемое значение:
// 	Строка- Имя реквизита 
Функция ДинамическоеИмяРеквизита(Форма, ТекД, ОбработчикРезультата) Экспорт
	Если ОбработчикРезультата = ВариантКоллекцияКлиентСервер_Ei Тогда
		ОбработчикВарианта  = ОбработчикРезультата;	
	Иначе	
		ОбработчикВарианта 	= ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТекД);	
	КонецЕсли;	
	Возврат  СтрШаблон("%1%2_%3",ОбработчикВарианта.Свойства().Имя
								,ПользовательКлиентСервер_Ei.ПодготовитьКлючНастроек(ТекД)
								,ОбработчикРезультата.Свойства().Имя); 		
КонецФункции
#КонецОбласти


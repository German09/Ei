Функция Инициализация() Экспорт
	Возврат "https://german09.github.io/json/index.html";
КонецФункции	

Процедура Наследовать(Форма, Обработчик, Контейнер) Экспорт
	Имя 			= Обработчик.Свойства().Имя;
	Если Обработчик = ВариантJSONКлиентСервер_Ei Тогда
		ИмяФормы 	= "ОбщаяФорма.РедакторJSON_Ei";
	Иначе
		ИмяФормы 	= "ОбщаяФорма.РедакторJSON2_Ei";
	КонецЕсли;		
	ФормаРодитель 	= ПолучитьФорму(ИмяФормы);	
	КонтейнерКП		= КонструкторКлиентСервер_Ei.КонтейнерКП(Форма,Обработчик);
	НаследованиеФормКлиент_Ei.Дополнить(ФормаРодитель,Форма,Контейнер,,КонтейнерКП);//,ПереопредПутиРеквизитов);
	Форма[Имя] 		= Инициализация();
КонецПроцедуры

Процедура УстановитьТекст(Элемент, Текст) Экспорт
	Объект 	= Документ(Элемент).getElementById("setContent");
	Если Не Объект = Неопределено Тогда
		Объект.setAttribute("text", Текст);
		Объект.click();
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьТекст(Элемент) Экспорт
	Текст = "";
	Объект 	= Документ(Элемент).getElementById("getContent");
	Если Не Объект = Неопределено Тогда
		Объект.click();
		Текст  = Объект.getAttribute("text");
	КонецЕсли;
	Возврат Текст;	
КонецФункции

Функция Документ(Элемент)
	Возврат Элемент.Документ;
КонецФункции

Процедура ПриОтображении(Форма,Обработчик) Экспорт
	Если Обработчик.Свойства().Класс = ВариантыКлиентСервер_Ei Тогда
		ПараметрыКлиент_Ei.ИзменитьВидимость(Форма,Ложь);
	КонецЕсли;
	Заполнитель = КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,Обработчик);	
	Если Заполнитель.Видимость Тогда
		Заполнитель.Видимость 		= Ложь;
		Заполнитель.Доступность  	= Ложь; //когда доступность ложь мы не меняем поведение заполнителя в зависимости от данных
		Контейнер 	= КонструкторКлиентСервер_Ei.Контейнер(Форма,Обработчик);			
		РедакторJSONКлиент_Ei.Наследовать(Форма, Обработчик, Контейнер);		
	КонецЕсли;
Конецпроцедуры
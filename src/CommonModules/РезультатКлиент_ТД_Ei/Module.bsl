
Процедура Инициализировать(Форма, Контейнер) Экспорт
	ФормаРодитель 	= ПолучитьФорму("ОбщаяФорма.ТД_Ei");
	НаследованиеФормКлиент_Ei.Дополнить(ФормаРодитель,Форма,Контейнер);		
КонецПроцедуры

Процедура ПриОтображении(Форма) Экспорт
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда	
		ЗагрузитьНастройки(Форма,ТД);
	КонецЕсли;		
Конецпроцедуры

Процедура ОбработкаОшибокЗагрузки(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
	ОтладкаКлиент_Ei.ПоказатьИсключение(Форма,ИнфоОбОшибке,РезультатыКлиентСервер_Ei,РезультатКлиентСервер_ТД_Ei);
КонецПроцедуры

Процедура ОбработкаРасшифровки(Форма, ДополнительнаяРасшифровка, Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт 
	Перем АдресДанныхРасшифровки,АдресСхемыКомпоновкиДанных;
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		ОписаниеЗначения 		= КэшПользователяКлиентСервер_Ei.ПолучитьОписаниеРезультата(ТД,Форма.КэшПользователя,ВариантКлиентСервер_СКД_Ei.Свойства().Имя);
		РезультатВызовСервера_ТД_Ei.ПолучитьАдресаВспомогательныхДанныхСКД(ОписаниеЗначения,АдресДанныхРасшифровки,АдресСхемыКомпоновкиДанных);
		Если Не АдресДанныхРасшифровки = Неопределено Тогда
			СтандартнаяОбработка 	= Ложь;
			ОбработкаРасшифровкиСКД = Новый ОбработкаРасшифровкиКомпоновкиДанных(АдресДанныхРасшифровки, Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновкиДанных));
			ДополнительныеПараметры = Новый Структура("Форма,Расшифровка,АдресДанныхРасшифровки", Форма, Расшифровка,АдресДанныхРасшифровки);
			ОО_Завершение			= Новый ОписаниеОповещения("ОбработкаРасшифровкиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			Если ДополнительнаяРасшифровка Тогда
				ОбработкаРасшифровкиСКД.ПоказатьВыборДействия(ОО_Завершение, Расшифровка,,,,Форма.Элементы.РезультатЗапросаТД);
	        Иначе
				ОбработкаРасшифровкиСКД.ПоказатьВыборДействия(ОО_Завершение, Расшифровка,,,Истина);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры

Процедура ОбработкаРасшифровкиЗавершение(ВыполненноеДействие, ПараметрВыполненногоДействия, ДополнительныеПараметры) Экспорт
	Перем Форма,Расшифровка,АдресДанныхРасшифровки;
	ДополнительныеПараметры.Свойство("Форма",Форма);
	ДополнительныеПараметры.Свойство("Расшифровка",Расшифровка);
	ДополнительныеПараметры.Свойство("АдресДанныхРасшифровки",АдресДанныхРасшифровки);
	
	Если ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.Нет Тогда
	ИначеЕсли ВыполненноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение Тогда
		ПоказатьЗначение(, ПараметрВыполненногоДействия);
	Иначе
		ОписаниеОбработкиРасшифровки 	= Новый ОписаниеОбработкиРасшифровкиКомпоновкиДанных(АдресДанныхРасшифровки, Расшифровка, ПараметрВыполненногоДействия);
		СтрРасшифровки					= Новый Структура("АдресДанныхРасшифровки,ОписаниеОбработкиРасшифровки",АдресДанныхРасшифровки,ОписаниеОбработкиРасшифровки);
		//тут нужно проверить что мы находимся на закладке СКД
		ВариантыКлиент_Ei.ВыполнитьВарианты(Форма,Новый Структура("СтрРасшифровки",СтрРасшифровки));
	КонецЕсли;
КонецПроцедуры


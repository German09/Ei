Процедура СвойстваТД(Форма,ИмяСвойства,Знач НовоеЗначение = Неопределено, СохранятьНастройки = Истина) Экспорт	 
	ЭлементТД =  Форма.Элементы.Найти("РезультатЗапросаТД");
	Если Не ЭлементТД = Неопределено Тогда
		КнопкаСвойства =  Форма.Элементы.Найти(ИмяСвойства);
		Если НЕ КнопкаСвойства = Неопределено Тогда
			НовоеЗначение			= ?(НовоеЗначение = Неопределено, Не КнопкаСвойства.Пометка,НовоеЗначение); //Если новое значение не заданно то просто инвертируем
			ЭлементТД[ИмяСвойства]	= НовоеЗначение;
			КнопкаСвойства.Пометка 	= НовоеЗначение;
			Если СохранятьНастройки Тогда
				ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
				Если Не ТД = Неопределено Тогда
					СохранитьНастройки(Форма,ТД);
				КонецЕсли;			
			КонецЕсли;	
		КонецЕсли;		
	КонецЕсли;		
КонецПроцедуры

#Область Настройки

Функция ПолучитьСтруктуруНастроек()
	Возврат Новый Структура("Редактирование,ОтображатьЗаголовки,ОтображатьСетку,ОтображатьИменаЯчеек,ОтображатьИменаСтрокИКолонок,ОтображатьГруппировки",Истина,Истина,Истина,Истина,Истина,Истина)
КонецФункции		

Процедура ЗагрузитьНастройки(Форма,ТД)
	Настройки = НастройкиПользователяКлиентСервер_Ei.ПолучитьНастройкиОбработчика(ТД,Форма.НастройкиПользователя,РезультатКлиентСервер_ТД_Ei);
	Если Не ТипЗнч(Настройки) = Тип("Структура") Тогда
		Настройки = ПолучитьСтруктуруНастроек(); 		
	КонецЕсли;
	Для Каждого КлючЗначение ИЗ Настройки Цикл
		СвойстваТД(Форма,КлючЗначение.Ключ,КлючЗначение.Значение, Ложь)		
	КонецЦикла;			
КонецПроцедуры

Процедура СохранитьНастройки(Форма,ТД) Экспорт 
	Настройки = ПолучитьСтруктуруНастроек(); 
	Для Каждого КлючЗначение ИЗ Настройки Цикл
		ЭлементФормы = Форма.Элементы.Найти(КлючЗначение.Ключ);
		Если Не ЭлементФормы = Неопределено Тогда
			Настройки.Вставить(КлючЗначение.Ключ,ЭлементФормы.Пометка);			
		КонецЕсли;
	КонецЦикла;		
	НастройкиПользователяКлиентСервер_Ei.СохранитьНастройкиОбработчика(ТД,Форма.НастройкиПользователя,РезультатКлиентСервер_ТД_Ei,Настройки);
КонецПроцедуры	

#КонецОбласти
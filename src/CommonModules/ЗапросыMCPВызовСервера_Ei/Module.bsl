// Серверная часть клиентского агента MCP: проверка кода и запись ответа на запрос MCP.
// Протокол - docs/client-agent-protocol.md в репозитории 1c_mcp.
// По наличию этого модуля MCP определяет, что агент установлен: не переименовывать.

#Область ПрограммныйИнтерфейс

// Ищет в коде опасные конструкции по списку MCP.
//
// Параметры:
//  Код - Строка
//  Контекст - Строка - server или client
//
// Возвращаемое значение:
//  Массив из Строка, Неопределено - Неопределено, если MCP в базе нет или он не ответил: такой код считается опасным
//
Функция ОпасныеКонструкции(Знач Код, Знач Контекст) Экспорт
	
	Результат = Неопределено;
	ИмяОбработки = "mcp_ИнструментВыполнениеКода";
	
	Если Метаданные.Обработки.Найти(ИмяОбработки) <> Неопределено Тогда
		Попытка
			Результат = Обработки[ИмяОбработки].НайтиОпасныеКонструкции(Код, Контекст);
		Исключение
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Результат = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Записывает ответ Выполнено с результатом запуска: значение результата берется на сервере
// по описанию значения и уходит в ответ как есть, сериализует его MCP.
//
// Параметры:
//  Запрос - Структура - данные уведомления mcp_ЗапросВыполненияКода
//  РезультатВыполнения - Структура - см. ЗаписатьОтвет, без полей Результат и ТипРезультата
//  ОписаниеЗначения - Произвольный - результат выполнения, см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
// Возвращаемое значение:
//  см. ЗаписатьОтвет
//
Функция ЗаписатьОтветЗапуска(Знач Запрос, Знач РезультатВыполнения, Знач ОписаниеЗначения) Экспорт
	
	Значение = Неопределено;
	Если РезультатВыполнения.Успех И ОписаниеЗначения <> Неопределено Тогда
		Значение = ИсторияВызовСервера_Ei.ЗначениеРезультата(ОписаниеЗначения);
		Если ТипЗнч(Значение) = Тип("РезультатЗапроса") Тогда
			Значение = Значение.Выгрузить();
		КонецЕсли;
	КонецЕсли;
	РезультатВыполнения.Вставить("ТипРезультата", Строка(ТипЗнч(Значение)));
	РезультатВыполнения.Вставить("Результат", СохраняемоеЗначение(Значение));
	
	Возврат ЗаписатьОтвет(Запрос, "Выполнено", РезультатВыполнения);
	
КонецФункции

// Записывает ответ на запрос MCP в хранилище общих настроек пользователя.
//
// Параметры:
//  Запрос - Структура - данные уведомления mcp_ЗапросВыполненияКода
//  Решение - Строка - Выполнено или Отклонено
//  РезультатВыполнения - Структура, Неопределено - для Выполнено:
//   * Успех - Булево
//   * Результат - Произвольный - значение переменной Результат или его представление, если оно не сериализуется
//   * ТипРезультата - Строка
//   * Ошибка - Строка
//   * Код - Строка - фактически выполненный код
//   * КодИзменен - Булево
//  ВидОтказа - Строка - для Отклонено: Запрещено, Отменено или Таймаут
//
// Возвращаемое значение:
//  Структура:
//   * Записан - Булево
//   * Ошибка - Строка - почему ответ не записан
//
Функция ЗаписатьОтвет(Знач Запрос, Знач Решение, Знач РезультатВыполнения = Неопределено, Знач ВидОтказа = "") Экспорт
	
	Итог = Новый Структура("Записан, Ошибка", Ложь, "");
	ТекущийСеанс = ПолучитьТекущийСеансИнформационнойБазы();
	
	Если Запрос.Пользователь <> ИмяПользователя() Тогда
		Итог.Ошибка = "Запрос адресован другому пользователю";
	ИначеЕсли КлиентскиеПриложения().Найти(ТекущийСеанс.ИмяПриложения) = Неопределено Тогда
		Итог.Ошибка = "Ответить на запрос MCP можно только из клиента 1С";
	ИначеЕсли ДопустимыеРешения(Запрос.Контекст).Найти(Решение) = Неопределено Тогда
		Итог.Ошибка = "Недопустимое решение " + Решение + " для контекста " + Запрос.Контекст;
	ИначеЕсли ТекущаяУниверсальнаяДата() > Запрос.СрокДействия Тогда
		Итог.Ошибка = "Срок действия запроса истек, MCP ответ уже не примет";
	ИначеЕсли ХранилищеОбщихНастроек.Загрузить(КлючОтветов(), Запрос.Идентификатор) <> Неопределено Тогда
		Итог.Ошибка = "На запрос уже ответили в другом сеансе";
	Иначе
		
		Ответ = Новый Структура;
		Ответ.Вставить("ВерсияПротокола", ВерсияПротокола());
		Ответ.Вставить("Идентификатор", Запрос.Идентификатор);
		Ответ.Вставить("Хеш", Запрос.Хеш);
		Ответ.Вставить("Создан", Запрос.Создан);
		Ответ.Вставить("Контекст", Запрос.Контекст);
		Ответ.Вставить("Решение", Решение);
		Ответ.Вставить("НомерСеанса", ТекущийСеанс.НомерСеанса);
		Ответ.Вставить("Ответил", ТекущаяУниверсальнаяДата());
		Если Решение = "Отклонено" Тогда
			Ответ.Вставить("ВидОтказа", Строка(ВидОтказа));
		КонецЕсли;
		
		Если Решение = "Выполнено" Тогда
			Для Каждого ИмяПоля Из СтрРазделить("Успех,Результат,ТипРезультата,Ошибка,Код,КодИзменен", ",") Цикл
				Ответ.Вставить(ИмяПоля, РезультатВыполнения[ИмяПоля]);
			КонецЦикла;
		КонецЕсли;
		
		ХранилищеОбщихНастроек.Сохранить(КлючОтветов(), Запрос.Идентификатор, Ответ);
		Итог.Записан = Истина;
		
		ОтправитьЗапросЗакрыт(Запрос.Идентификатор, "Ответил сеанс " + Формат(ТекущийСеанс.НомерСеанса, "ЧГ=0"));
		
	КонецЕсли;
	
	ЗаписатьРешениеВЖурнал(Запрос, Решение, РезультатВыполнения, ВидОтказа, Итог);
	
	Возврат Итог;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Значение, которое можно сохранить в хранилище настроек; иначе - его представление.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Произвольный
//
Функция СохраняемоеЗначение(Значение)
	
	Попытка
		// Несериализуемое значение (запрос, COM-объект) хранилище не примет.
		Хранилище = Новый ХранилищеЗначения(Значение);
		Сохраняемое = Хранилище.Получить();
	Исключение
		Сохраняемое = Строка(Значение);
	КонецПопытки;
	
	Возврат Сохраняемое;
	
КонецФункции

Процедура ЗаписатьРешениеВЖурнал(Запрос, Решение, РезультатВыполнения, ВидОтказа, Итог)
	
	Строки = Новый Массив; // Массив из Строка
	Строки.Добавить("Решение: " + Решение);
	Если Не Итог.Записан Тогда
		Строки.Добавить("Ответ не записан: " + Итог.Ошибка);
	КонецЕсли;
	Если ЗначениеЗаполнено(ВидОтказа) Тогда
		Строки.Добавить("Вид отказа: " + ВидОтказа);
	КонецЕсли;
	Строки.Добавить("Идентификатор: " + Запрос.Идентификатор);
	Строки.Добавить("Контекст: " + Запрос.Контекст);
	Строки.Добавить("Хеш: " + Запрос.Хеш);
	Строки.Добавить("Опасные конструкции: " + СтрСоединить(Запрос.ОпасныеКонструкции, ", "));
	
	Если РезультатВыполнения <> Неопределено Тогда
		Строки.Добавить("Успех: " + Формат(РезультатВыполнения.Успех, "БЛ=Нет; БИ=Да"));
		Если РезультатВыполнения.КодИзменен Тогда
			Строки.Добавить("Код изменен пользователем, выполнен:");
			Строки.Добавить(РезультатВыполнения.Код);
		КонецЕсли;
		Если ЗначениеЗаполнено(РезультатВыполнения.Ошибка) Тогда
			Строки.Добавить("Ошибка: " + РезультатВыполнения.Ошибка);
		КонецЕсли;
	КонецЕсли;
	
	Строки.Добавить("Код:");
	Строки.Добавить(Запрос.Код);
	
	Уровень = ?(Итог.Записан, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Предупреждение);
	ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), Уровень, , , СтрСоединить(Строки, Символы.ПС));
	
КонецПроцедуры

// Закрывает окна запроса в остальных сеансах пользователя.
Процедура ОтправитьЗапросЗакрыт(Идентификатор, Причина)
	
	ДанныеУведомления = Новый Структура("Идентификатор, Причина", Идентификатор, Причина);
	
	Попытка
		ОтправитьУведомлениеКлиенту(КлючУведомленияЗакрыт(), ДанныеУведомления, КлиентскиеСеансыПользователя());
	Исключение
		// Ответ уже записан: окна в других сеансах закроет MCP, когда заберет ответ.
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция КлиентскиеСеансыПользователя()
	
	НомераСеансов = Новый Массив; // Массив из Число
	ИмяТекущегоПользователя = ИмяПользователя();
	Приложения = КлиентскиеПриложения();
	
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого Сеанс Из ПолучитьСеансыИнформационнойБазы() Цикл
		Если Сеанс.Пользователь <> Неопределено
			И Сеанс.Пользователь.Имя = ИмяТекущегоПользователя
			И Приложения.Найти(Сеанс.ИмяПриложения) <> Неопределено Тогда
			НомераСеансов.Добавить(Сеанс.НомерСеанса);
		КонецЕсли;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат НомераСеансов;
	
КонецФункции

Процедура ОтправитьУведомлениеКлиенту(Ключ, Данные, НомераСеансов)
	
	МенеджерУведомленийКлиента().ОтправитьУведомление(Ключ, Данные, НомераСеансов);
	
КонецПроцедуры

Функция МенеджерУведомленийКлиента()
	
	УстановитьБезопасныйРежим(Истина);
	
	// Свойство глобального контекста появилось в 8.3.27 и неизвестно EDT - обращаемся по имени.
	//@skip-check server-execution-safe-mode
	Возврат Вычислить("УведомленияКлиента");
	
КонецФункции

// Код выполняет сам агент, в клиенте или на сервере, поэтому решения одинаковы для обоих контекстов.
Функция ДопустимыеРешения(Контекст)
	
	Решения = Новый Массив; // Массив из Строка
	Если Контекст = "server" Или Контекст = "client" Тогда
		Решения.Добавить("Выполнено");
		Решения.Добавить("Отклонено");
	КонецЕсли;
	
	Возврат Решения;
	
КонецФункции

Функция КлиентскиеПриложения()
	
	Приложения = Новый Массив; // Массив из Строка
	Приложения.Добавить("1CV8C");
	Приложения.Добавить("1CV8");
	Приложения.Добавить("WebClient");
	
	Возврат Приложения;
	
КонецФункции

Функция ВерсияПротокола()
	Возврат 1;
КонецФункции

Функция КлючОтветов()
	Возврат "mcp_ОтветыНаЗапросыКода";
КонецФункции

Функция КлючУведомленияЗакрыт()
	Возврат "mcp_ЗапросВыполненияКодаЗакрыт";
КонецФункции

Функция ИмяСобытияЖурнала()
	Возврат "Ei.ЗапросыMCP";
КонецФункции

#КонецОбласти

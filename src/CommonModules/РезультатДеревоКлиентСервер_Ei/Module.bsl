#Если Клиент Тогда

Процедура ПриОтображении(Форма) Экспорт
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	КонструкторКлиент_Ei.ВидимостьДинЭлементов(Форма,ЭтотОбъект,ТД);				
Конецпроцедуры

Процедура ОбработкаОшибокЗагрузки(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
	ОтладкаКлиент_Ei.ПоказатьИсключение(Форма,ИнфоОбОшибке,РезультатыКлиентСервер_Ei,ЭтотОбъект);
КонецПроцедуры

#КонецЕсли

#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда

Процедура Инициализировать(Форма, Контейнер) Экспорт
	Форма.ДобавитьРеквизитыРезультата(Свойства().Имя,Неопределено);	
КонецПроцедуры
	
Процедура ДобавитьРеквизиты(Форма, ИД) Экспорт
	Если ИД = Неопределено Тогда
		//это первичное заполнение, на этапе инициализации
		РезультатыСервер_Ei.ДобавитьВспомогательныеЭлементы(Форма,РезультатДеревоКлиентСервер_Ei);
	Иначе
							
	КонецЕсли;						
КонецПроцедуры 


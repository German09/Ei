Функция мТиповОжидаемыхРезультатов() Экспорт
	Результат 				= Новый Массив;
	Результат.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().РезультатЗапроса);
	Результат.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТаблицаЗначений);
	Результат.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ДеревоЗначений);
	Результат.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТабличныйДокумент);	
	Возврат Результат;
КонецФункции

Функция ВыполнятьВаринатПоУмолчанию() Экспорт 
	Возврат Истина;
КонецФункции

Процедура Поместить(ТД, Вариант, ОписаниеЗначения) Экспорт
	ТД.ПоказателиРезультата.сооАдресовРезультатов.Вставить(Вариант, ОписаниеЗначения);	
КонецПроцедуры

Функция Получить(ТД, Вариант) Экспорт
	ОписаниеЗначения = ТД.ПоказателиРезультата.сооАдресовРезультатов.Получить(Вариант);
	Возврат ОписаниеЗначения;	
КонецФункции

Функция ПолучитьТекущийОбработчик(Форма,ТД) Экспорт
	ИмяОбработчика = НастройкиПользователяКлиентСервер_Ei.ПолучитьИмяТекущегоОбработчика(ТД,Форма.НастройкиПользователя,РезультатыКлиентСерверПовторноеИспользование_Ei.Ключ());
	Возврат РезультатыКлиентСерверПовторноеИспользование_Ei.ПолучитьРезультаты().Получить(ИмяОбработчика);	
КонецФункции				
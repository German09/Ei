// Обработка процесса «Завершение потока»: ждет фоновые задания, запущенные обработкой «Начало потока»,
// и собирает их результаты, см. ОбработкаНачалоПотокаКлиентСервер_Ei

#Область ПрограммныйИнтерфейс

// Свойства обработки.
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - имя обработки, по нему обработка находится, см. ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки
//   * Синоним - Строка - представление в дереве доступных обработок
//   * Картинка - Картинка - картинка в дереве доступных обработок и на схеме
//   * ИспользоватьНастройки - Булево - у обработки нет настройки
//   * Форма - Неопределено - формы настройки нет
//   * ТипЭлемента - Тип - тип элемента графической схемы
//
Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",					"ОбработкаЗавершениеПотока");
	Результат.Вставить("Синоним",				"Завершение потока");
	Результат.Вставить("Картинка",				БиблиотекаКартинок.Слияние_Ei);
	Результат.Вставить("ИспользоватьНастройки",	Ложь);
	Результат.Вставить("Форма",					Неопределено);
	Результат.Вставить("ТипЭлемента",			Тип("ЭлементГрафическойСхемыСлияние"));
	Возврат Результат;
КонецФункции

// Ждет завершения потоков, показывает их сообщения и переносит данные их обработок в данные клиента.
//
// Параметры:
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор для временного хранилища результата
//  Настройка - Неопределено - у обработки нет настройки
//  ДанныеКлиента - Соответствие из КлючИЗначение - данные выполненных обработок, см. ПроцессыКлиентСервер_Ei.ВыполнитьПроцесс
//  Ход - Структура, Неопределено - ход процесса в фоне, см. ПроцессыКлиентСервер_Ei.НовыйХод
//
// Возвращаемое значение:
//  Произвольный - результаты потоков, см. ОбработкаЗавершениеПотокаВызовСервера_Ei.ПолучитьОписанниеРезульатовФЗ;
//    Неопределено - потоки не запускались
//
Функция ВыполнитьОбработку(УникальныйИдентификатор, Настройка, ДанныеКлиента, Ход = Неопределено) Экспорт
	Результат = Неопределено;
	ОписаниеПотоков = ОбъектыВызовСервера_Ei.Получить();
	Если ТипЗнч(ОписаниеПотоков) = Тип("ФиксированныйМассив") Тогда
		ОписаниеПотоков = Новый Массив(ОписаниеПотоков);
		РезультатОжидания = ОжиданиеЗавершения(ОписаниеПотоков, ДанныеКлиента);
		Пока РезультатОжидания.Завершено = Ложь Цикл
			РезультатОжидания = ОжиданиеЗавершения(ОписаниеПотоков, ДанныеКлиента);
		КонецЦикла;
		Результат = ОбработкаЗавершениеПотокаВызовСервера_Ei.ПолучитьОписанниеРезульатовФЗ(УникальныйИдентификатор,
			РезультатОжидания.сооРезультатов);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Создает настройку обработки по контексту других обработок, только для обработки без настроек.
//
// Параметры:
//  Направление - Структура - направление схемы, см. ПроцессыКлиентСервер_Ei.ВыполнитьПоток
//  Направления - Массив из Структура - направления схемы
//  НастройкиОбработок - ФиксированноеСоответствие из КлючИЗначение - настройки обработок схемы
//
// Возвращаемое значение:
//  Неопределено - настройка не нужна
//
Функция СоздатьНастройку(Направление, Направления, НастройкиОбработок) Экспорт
	Возврат Неопределено;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ждет завершения потоков секунду, показывает накопленные сообщения и переносит данные обработок потоков.
//
// Параметры:
//  ОписаниеПотоков - Массив из Структура - описания потоков, см. ОбработкаНачалоПотокаВызовСервера_Ei.ЗапуститьПоток
//  ДанныеКлиента - Соответствие из КлючИЗначение - данные выполненных обработок
//
// Возвращаемое значение:
//  Структура - см. ОбработкаЗавершениеПотокаВызовСервера_Ei.ОжидатьЗавершенияПотоков
//
Функция ОжиданиеЗавершения(ОписаниеПотоков, ДанныеКлиента)
	РезультатОжидания = ОбработкаЗавершениеПотокаВызовСервера_Ei.ОжидатьЗавершенияПотоков(ОписаниеПотоков, 1);
	Для Каждого Поток Из ОписаниеПотоков Цикл
		Для Каждого Сообщение Из Поток.Сообщения Цикл
			Сообщение.Сообщить();
		КонецЦикла;
		Для Каждого КлючИЗначение Из Поток.ДанныеКлиента Цикл
			ДанныеКлиента.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		// Показанное и перенесенное больше не нужно
		Поток.Сообщения = Новый Массив;
		Поток.ДанныеКлиента = Новый Соответствие;
	КонецЦикла;
	Возврат РезультатОжидания;
КонецФункции

#КонецОбласти

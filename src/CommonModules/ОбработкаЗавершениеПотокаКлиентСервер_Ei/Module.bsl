Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",					"ОбработкаЗавершениеПотока");
	Результат.Вставить("Синоним",				"Завершение потока");
	Результат.Вставить("Картинка",				БиблиотекаКартинок.Слияние_Ei);
	Результат.Вставить("КартинкаСсылка",		ПоместитьВоВременноеХранилище(Результат.Картинка,Новый УникальныйИдентификатор));
	Результат.Вставить("ИспользоватьНастройки",	Ложь);
	Результат.Вставить("Форма",					Неопределено);
	Результат.Вставить("ТипЭлемента",			Тип("ЭлементГрафическойСхемыСлияние")); 
	Возврат Результат; 
КонецФункции

// Переопределемая процедура - Выполнить обработку
//
// Параметры:
//  ОписаниеПотока	 - Структура 	- Структура формируемая процедурой ПроцессыКлиент_Ei.ВыполнитьПоток()
//										- сзВызовов 	- СписокЗначений 	- Последовательность подготовленных ОписанийОповещений вызова обоработок, первой располагется следующая к запуску обработка
//										- Контекст  	- Структура  		- Аналог структуры "ДоступныеСтруктуры" из переменной формы СтруктураПеременных
//  ВозврЗначение	 - Структура - Описание возврашаемого значения, в который нужно поместить результат выполнения, своства структуры формируются функцией ОписаниеЗначенияВызовСервера_Ei.Получить()
//
Функция ВыполнитьОбработку(УникальныйИдентификатор, Настройка, ДанныеКлиента) Экспорт 
	Перем Результат;
	Перем РезультатОжидания;
	ОписаниеПотоков 		= ОбъектыВызовСервера_Ei.Получить();
	Если ТипЗнч(ОписаниеПотоков) = Тип("ФиксированныйМассив") Тогда
		ОписаниеПотоков =  Новый Массив(ОписаниеПотоков);	 
		ОжиданиеЗавершения(ОписаниеПотоков,РезультатОжидания,ДанныеКлиента);
		Пока РезультатОжидания.Завершено = Ложь Цикл	
			ОжиданиеЗавершения(ОписаниеПотоков,РезультатОжидания,ДанныеКлиента);	
		КонецЦикла;
		Результат = ОбработкаЗавершениеПотокаВызовСервера_Ei.ПолучитьОписанниеРезульатовФЗ(УникальныйИдентификатор,РезультатОжидания.сооРезультатов);
	КонецЕсли;
	Возврат Результат; 	
КонецФункции

// Может создать настройку обработки на основании контекста других обработок
// Имеет смысл только в случае ИспользоватьНастройки = Ложь.
// 
// Параметры:
//  Направление - Структура
//  мНаправления - Массив из Структура
//  НастройкиОбработок - Соответствие из Структура 
// 
// Возвращаемое значение:
// 	Произвольный 
Функция СоздатьНастройку(Направление, мНаправления, НастройкиОбработок) Экспорт
	Возврат Неопределено;	
КонецФункции

// Процедура - Ожидание завершения потоков с выводом накопленных сообщений
//
// Параметры:
//  ОписаниеПотока		 - Структура - Описание потока
//  РезультатОжидания	 - Структура - Возвращемый параметр
//
Процедура ОжиданиеЗавершения(ОписаниеПотоков,РезультатОжидания,ДанныеКлиента)
	мПоказателиВыполненияПроцесса 	= Новый Массив;
	РезультатОжидания   			= ОбработкаЗавершениеПотокаВызовСервера_Ei.ОжидатьЗавершенияПотоков(ОписаниеПотоков, 1);
	Для Каждого стрЗапускаПотока из ОписаниеПотоков Цикл
		Для Каждого СообщПольз Из стрЗапускаПотока.Сообщения Цикл
			СообщПольз.Сообщить();		
		КонецЦикла;
		Для Каждого КлючЗначение Из стрЗапускаПотока.ДанныеКлиента Цикл
			ДанныеКлиента.Вставить(КлючЗначение.Ключ,КлючЗначение.Значение);		
		КонецЦикла;
		//обнуляем
		стрЗапускаПотока.Сообщения 		=  Новый Массив; 
		стрЗапускаПотока.ДанныеКлиента 	=  Новый Соответствие(); 
	КонецЦикла;
//	Для Каждого ПоказателиВыполненияПроцесса ИЗ мПоказателиВыполненияПроцесса Цикл
//		ДополнитьПоказательВыполнения(ОписаниеПотока, ПоказателиВыполненияПроцесса);
//	КонецЦикла;	
КонецПроцедуры	


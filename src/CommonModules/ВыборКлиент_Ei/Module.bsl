
// Вызывается при начале выборе типа или значения
//
// Параметры:
//	ЗавершениеВыбора	 - ОписаниеОповещения 		- Оповещение которое вызывается при завершении выбора
//	Выбор				 - Произвольный 			- Возвращаемый параметр, путь к переменной Выбор, если не задан то форма открывается в модальном режиме
//  ВладелецФормы		 - Форма 					- Форма в которой иницирован выбор
//  Элемент				 - ЭлементУправленияФормы 	- Элемент, в котором иницирован выбор
//  Параметры			 - Структура - 	Вспомогательная структура
//  	ТекущиеДанные			-<СтрокаТаблицыЗначений.Структура> 	Используется для определения значений - ЭтоВыражение,ИмяПараметра
//  	ДоступныеСтруктуры		-<Структура> 						ВыборПеременные, которые можно выбрать в текщем контексте
//  	ОграничениеТипа			-<ОписаниеТипов> 					Типы которые доступны для выбора в текущем контексте, учитываются и для переменных
//  СтандартнаяОбработка - Булево - признак использования стандартной обработки
//  ПоддержкаЯзыка		 - Булево - Признак поддержки встроенного языка
//
Процедура НачалоВыбора(ЗавершениеВыбора = Неопределено, Выбор = Неопределено, ВладелецФормы, Элемент, Параметры, СтандартнаяОбработка, ПоддержкаЯзыка = Истина) Экспорт
	ПараметрыСтроки		= Новый Соответствие;
	ОткрыватьМодально   = (Выбор = Неопределено);
	Выбор				= Новый Структура("ПараметрыСтроки,ЗавершениеВыбора,ДоступныеСтруктуры,ОграничениеТипа,ТекущиеДанные",ПараметрыСтроки,ЗавершениеВыбора);
	Параметры.Свойство("ДоступныеСтруктуры",Выбор.ДоступныеСтруктуры); 		//ВыборПеременные, которые можно выбрать в текущем контексте
	Параметры.Свойство("ОграничениеТипа",	Выбор.ОграничениеТипа);       	//Типы которые доступны для выбора в текущем контексте, учитываются и для переменных
	Параметры.Свойство("ТекущиеДанные",		Выбор.ТекущиеДанные); 		   	//Используется для определения значений - ЭтоВыражение,ИмяПараметра
	
	Если ТипЗнч(Параметры.ТекущиеДанные.ЗначениеПараметра) = Тип("Неопределено") Тогда   
		СтандартнаяОбработка = Ложь;
		Показать(Выбор,ВладелецФормы,ОткрыватьМодально,ПоддержкаЯзыка);
	Иначе
		Если Параметры.ТекущиеДанные.ЭтоВыражение Тогда
			СтандартнаяОбработка		= Ложь;
			Показать(Выбор,ВладелецФормы,ОткрыватьМодально,ПоддержкаЯзыка);
		Иначе
			//ПРОВЕРКА НА ФАЙЛ
			Если ТипЗнч(Параметры.ТекущиеДанные.ЗначениеПараметра)=Тип("Строка") Тогда
				СтандартнаяОбработка	= Ложь;
				Файл 	= Новый Файл(Выбор.ТекущиеДанные.ЗначениеПараметра);
				Если ЗначениеЗаполнено(Файл.ПолноеИмя) Тогда 	
					Файл.НачатьПроверкуСуществования(Новый ОписаниеОповещения("ОО_ПроверкаСуществованияФайла",ВыборКлиент_Ei,Новый Структура("ПолноеИмя,ВладелецФормы,Выбор",Файл.ПолноеИмя,ВладелецФормы,Выбор)));
				Иначе		
					ПоказатьДиалог(,ВладелецФормы,Выбор);
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ
#Область ОбщегоНазначения

//Отображает окно или элемент выбора типа/значения
//Параметры:
//  Выбор				- Структура - Вспомогательная структура описана в общей форме Выбор_Ei, экспортная переменная
//	ВладелецФормы		- Форма - Элемент в котором произведен выбор
//	ОткрыватьМодально	- Булево - Признак окрытия в модальном режиме если Истина, то происходит модальный выбор из предопределенной формы
//	ПоддержкаЯзыка		- Булево - Признак поддержки встроенного языка
//
//
Процедура Показать(Выбор, ВладелецФормы, ОткрыватьМодально, ПоддержкаЯзыка)
	Если ОткрыватьМодально Тогда
		//открываем модально
		//стрИмяЭлементаВыбора		= "ДеревоВыбора";//указываем как называется имя элемента формы и соотвесвующее ему имя занчения в модальной форме
		РежимОткрытияОкна 			= РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ФормаВыбора 				= ОткрытьФорму(ИмяМодальнойФормы(),,ВладелецФормы,,,,,РежимОткрытияОкна);
		ФормаВыбора.Выбор 			= Выбор;
	Иначе
		ФормаВыбора					= ВладелецФормы;
	КонецЕсли;
	Выбор.Вставить("Форма",ФормаВыбора);
	ФормаВыбора.Элементы.ДеревоВыбора.Родитель.Видимость 	= Истина; //покажем, очень важно для немодального режима, но и в модальном проверить не помешает
	ФормаВыбора.Элементы.ДеревоВыбора_КомПанель.Видимость 	= Не ОткрыватьМодально;
	ФормаВыбора.Элементы.ДеревоВыбора_Путь.Видимость 		= ПоддержкаЯзыка;
	ИнициализацияВыбора(ФормаВыбора, Выбор);
КонецПроцедуры

//Производит инициализацию формы выбора
//Параметры:
//  Форма	 - Форма - Форма в которой отображен диалог выбора 
//  Выбор	 - Структура - Вспомогательная структура описана в общей форме Выбор_Ei, экспортная переменная
//
Процедура ИнициализацияВыбора(Форма, Выбор)
	ДеревоВыбора = Форма.ДеревоВыбора;
	ДеревоВыбора.ПолучитьЭлементы().Очистить(); //очистим строки, а то не при модальном выборе они пополняются постоянно
	ПеречисленияКлиентСерверПовторноеИспользование_Ei.Значения().Очистить();
	Выбор.ПараметрыСтроки.Очистить();
	
	вЗаполнитьДеревоДоступнымиПеременными(Выбор,ДеревоВыбора);
	 
	Если Выбор.ТекущиеДанные.ЭтоВыражение Тогда
	
	Иначе
		//Доступные типы
		СписокТипов = ВыборВызовСервераПовтИсп_Ei.СписокДоступныхТипов();
		Для Каждого ЭлементСЗ  ИЗ СписокТипов Цикл
			Если ЗначениеЗаполнено(ЭлементСЗ.Значение) И вТипРазрешен(Выбор.ОграничениеТипа,ЭлементСЗ.Значение) Тогда
				НоваяСтрока	= ДеревоВыбора.ПолучитьЭлементы().Добавить();
				НоваяСтрока.Представление	= ЭлементСЗ.Представление;
				ПараметрыСтроки(Выбор,НоваяСтрока,,ЭлементСЗ.Значение);
				Если  ЭлементСЗ.Пометка Тогда
					//добавлем подстроку чтобы можно было развернуть
					НоваяСтрока.ПолучитьЭлементы().Добавить();
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
	ВыполнитьОбработкуОповещения(Новый ОписаниеОповещения("ВыборВыражения",ВыборКлиент_Ei,Выбор),Форма); //Производим ассинхронный вызов поиска чтобы не задерживать открытие или отображение формы
	
	//ЭлементыФормы.Путь.КнопкаОткрытия	= Не  СтруктураДопПараметров.Свойство("ЗапретитьВстроенныйЯзык");
	//Если ЭлементыФормы.ДеревоЗначений.ТекущиеДанные = Неопределено Тогда
	//	//тут хорошобы активизировать единственный тип, но он известен только после разворота +	
	//КонецЕсли;	
КонецПроцедуры

Функция ИмяМодальнойФормы() Экспорт
	Возврат "ОбщаяФорма.Выбор_Ei";	
КонецФункции	

//Процедура производит позиционированием на выбранной переменной, либо открывает окно встроенного языка
//Последнне открывается в случае если в доступных переменных мы не нашли указанного пути.
//Параметры:
//  Форма - Форма		- ФормаВыбора.		
//  Выбор -	Структура 	- Вспомогательная структура.
//
Процедура ВыборВыражения(Форма,Выбор) Экспорт
	Если Выбор.ТекущиеДанные.ЭтоВыражение Тогда
		СтрокаПоиска	= Форма.ДеревоВыбора;
		Выражение		= Нрег(СтрЗаменить(Выбор.ТекущиеДанные.ЗначениеПараметра,"[",".["));
		//заменим выражение функций, напмример Варианты("Процессы").Данные нужно поменять на Варианты( ).Процессы.Данные
		Выражение		= СтрЗаменить(Выражение,"(""",ОкончаниеФункции()+".");
		Выражение		= СтрЗаменить(Выражение,""").",".");
		//Надйем в дереве
		Для Каждого сЧастьВыражения ИЗ СтрРазделить(Выражение,".") Цикл
			Если Не ПустаяСтрока(сЧастьВыражения) Тогда 
				Для Каждого ПодСтрока ИЗ СтрокаПоиска.ПолучитьЭлементы() Цикл
					Если нРег(ПодСтрока.Имя) = СокрЛП(нРег(сЧастьВыражения)) Тогда
						СтрокаПоиска = Подстрока;
						Форма.Элементы.ДеревоВыбора.ТекущаяСтрока = СтрокаПоиска.ПолучитьИдентификатор();
						Развернуть(СтрокаПоиска, Выбор);
						Прервать;
					КонецЕсли;	
				КонецЦикла;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

//Производит заполнение дерева значений доступными переменными
//
Процедура вЗаполнитьДеревоДоступнымиПеременными(Выбор,ДеревоВыбора)
	Если ТипЗнч(Выбор.ДоступныеСтруктуры) = Тип("Структура") Тогда
		Для Каждого ДоступнаяСтруктура Из  Выбор.ДоступныеСтруктуры Цикл
			НоваяСтрока = ДеревоВыбора.ПолучитьЭлементы().Добавить();
			НоваяСтрока.Представление	= ДоступнаяСтруктура.Ключ;
			ПараметрыСтроки(Выбор,НоваяСтрока,ДоступнаяСтруктура.Значение);//ДозаполнитьСтрокуДерева(НоваяСтрока,ДоступнаяСтруктура.Значение,Выбор);
			вРазвернутьСвойства(НоваяСтрока,Выбор);
	 	КонецЦикла;	
	КонецЕсли;	
Конецпроцедуры

//Функция проверят разрешен ли к использованию в этой форме данное описание типов(тип)
//Параметры:
//	ОписаниеТипов	-<ОписаниеТипов,Тип>. Объект, который нужно проверить	
Функция вТипРазрешен(ОграничениеТипа,ОписаниеТипов)
	Результат = Истина;
	Если ЗначениеЗаполнено(ОграничениеТипа) Тогда
		Если ТипЗнч(ОписаниеТипов) = Тип("ОписаниеТипов") Тогда
			//Если ОписаниеТипов.Типы().Количество()=0 Тогда
				//Возврат Истина; //неопределенный тип возможен только при загрузке из внешних источников, разрешим надеясь что пользователь понимает что делает не хрена не понятно даже я облажался с номером
			//Иначе	
			Результат = ТипыКлиентСервер_Ei.ОписанияПересекаются(ОграничениеТипа,ОписаниеТипов);		
		ИначеЕсли ТипЗнч(ОписаниеТипов) = Тип("Тип") Тогда
			Результат =  ОграничениеТипа.СодержитТип(ОписаниеТипов);
		Иначе
			Результат =  Ложь;
		КонецЕсли;		
	КонецЕсли;
	Возврат Результат;		
КонецФункции

// Функция - устанавливает или получает значение для строки 
// Не все типы и значения могут использоваться в данных формы (например массив,СписокXDTO) поэтому делаем через функцию
//
// Параметры:
//  Строка			 - ЭлементКоллекции	 - Строка дерева
//  ОписаниеТипов	 - ОписаниеТипов	 - Сохраняемое ОписаниеТипов
// 
// Возвращаемое значение:
//   - ОписаниеТипов. Полученное описание типов
//
Функция ПараметрыСтроки(Выбор,Строка,Знач Значение = Неопределено,Знач ОписаниеТипов=Неопределено)
	Если ОписаниеТипов = Неопределено И Значение = Неопределено Тогда
		//получаем
		Результат = Выбор.ПараметрыСтроки.Получить(Строка.ПолучитьИдентификатор());
		Возврат ?(Результат = Неопределено, Новый Структура("Значение,ОписаниеТипов",Неопределено,Новый ОписаниеТипов),Результат);
	Иначе
		Если ТипЗнч(Значение) = Тип("ОписаниеОповещения") Тогда
			РеальноеЗначение 	= Неопределено;
			Аргументы			= Значение.ДополнительныеПараметры.Аргументы; //До выполнения обработки оповещения	
			ВыполнитьОбработкуОповещения(Значение,РеальноеЗначение);
			Если РеальноеЗначение = Неопределено Тогда
				Строка.ПолучитьЭлементы().Добавить(); //Чтобы можно было выполнить эту процедуру на сервере
			Иначе
				Значение = РеальноеЗначение; //Заменим Описание оповещения что бы клиентские параметры не затерлись серверными результатами (их там не ожидается)
				ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(Значение,ПеречисленияКлиентСерверПовторноеИспользование_Ei.ИмяКлючаКартинки(),Строка.СсылкаНаКартинку);							
			КонецЕсли;	 
			Строка.ПредставлениеЗначения	= Строка(РеальноеЗначение);
			Строка.Представление 			= Строка.Представление+Аргументы;
		КонецЕсли;	
		Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(Значение) Тогда
			//Это ОписаниеЗначения 
			Значение.Свойство("ОписаниеТипов",ОписаниеТипов);
			Значение.Свойство("ПредставлениеЗначения",Строка.ПредставлениеЗначения);
			Значение.Свойство("ОбъемКоллекции",Строка.ОбъемКоллекции);
			Если ЗначениеЗаполнено(Значение.Значение) Тогда
				//это лишнее формирование описаниязначение таких быть не должно
				Значение 						= Значение.Значение;
				Строка.ПредставлениеЗначения    = Строка(Значение);
			КонецЕсли;	
		ИначеЕсли Не ТипЗнч(Значение) = Тип("ОписаниеОповещения") Тогда		
			Строка.ПредставлениеЗначения	= Строка(Значение);
		КонецЕсли;
		Строка.Имя						= НРег(Строка.Представление);
		
		//сохраняем
		Если ОписаниеТипов = Неопределено Тогда
			ОписаниеТипов = ТипыКлиентСервер_Ei.СоздатьОписаниеИзКолекции(ТипЗнч(Значение));	
		КонецЕсли;
		ОписаниеТипов = ТипыКлиентСервер_Ei.ПроверитьОписание(ОписаниеТипов);		
		Выбор.ПараметрыСтроки.Вставить(Строка.ПолучитьИдентификатор(),Новый Структура("Значение,ОписаниеТипов",Значение,ОписаниеТипов));
	КонецЕсли;
КонецФункции

//Процедура разворачивает свойства значения указанного в строке
//Параметры:
//	Строка 				-<СтрокаДереваЗначений>. Разворачиваемая строка
Процедура вРазвернутьСвойства(Строка,Выбор)
	ЗначениеСтроки = ПараметрыСтроки(Выбор,Строка).Значение;
	Если 	ТипыКлиентСерверПовтИсп_Ei.ВсеСсылки().СодержитТип(ТипЗнч(ЗначениеСтроки)) И 
				Не ТипыКлиентСерверПовтИсп_Ei.ВсеСсылки("Перечисления").СодержитТип(ТипЗнч(ЗначениеСтроки))
				ИЛИ вЭтоТипОбъекта(ТипЗнч(ЗначениеСтроки)) Тогда
		Для Каждого ЭлСписка ИЗ ОбщийМодульКлиент_Ei.вПолучитьСвойстваОбъектаМетаданных(ЗначениеСтроки,Выбор.Форма.УникальныйИдентификатор) Цикл
			ПодСтрока=Строка.ПолучитьЭлементы().Добавить();
			ПодСтрока.Представление	= ЭлСписка.Представление;
			ПараметрыСтроки(Выбор,ПодСтрока,ЭлСписка.Значение);//ДозаполнитьСтрокуДерева(ПодСтрока,ЭлСписка.Значение,Выбор);
			ПроверитьВозможностьСвойств(ПодСтрока,Выбор);
		КонецЦикла;
	ИначеЕсли 	ТипЗнч(ЗначениеСтроки) 	= Тип("Структура") ИЛИ  
				(ТипЗнч(ЗначениеСтроки) = Тип("ФиксированнаяСтруктура") И Не ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ЗначениеСтроки)) Тогда
		Для Каждого Переменная ИЗ  ЗначениеСтроки Цикл
			//Если ТипЗнч(Переменная.Значение) = Тип("ФиксированнаяСтруктура") Тогда
			//	ЗначениеСвойства = Переменная.Значение;
			//Иначе	
			//	ЗначениеСвойства = ОбщийМодульВызовСервера_Ei.ПодготовитьОписаниеЗначенияВызовСервера(Переменная.Значение);
			//КонецЕсли;
			ЗначениеСвойства 		= Переменная.Значение;  //пока так
			Если Переменная.Ключ = ПеречисленияКлиентСерверПовторноеИспользование_Ei.ИмяКлючаКартинки() Тогда
				//это предопределенное свойство, тут просто установим картинку строки
				Строка.СсылкаНаКартинку = ЗначениеСвойства;
			Иначе	
				ПодСтрока 				= Строка.ПолучитьЭлементы().Добавить();
				ПодСтрока.Представление	= Переменная.Ключ;
				ПараметрыСтроки(Выбор,ПодСтрока,ЗначениеСвойства);//ДозаполнитьСтрокуДерева(ПодСтрока,ЗначениеСвойства,Выбор);
				ПроверитьВозможностьСвойств(ПодСтрока,Выбор);
			КонецЕсли;	
		КонецЦикла;
	ИначеЕсли Не ТипЗнч(ЗначениеСтроки) = Тип("ОписаниеОповещения") Тогда
		//Попробуем развернуть если это значение возможно передать на сервер
		Попытка
			сооСвойства = ВыборВызовСервера_Ei.ПолучитьСвойстваЗначения(ЗначениеСтроки,Выбор.Форма.УникальныйИдентификатор);
		Исключение
			Перейти ~М1;
		КонецПопытки;
		Для Каждого соо из сооСвойства Цикл
			Строка.СсылкаНаКартинкуЗначения = соо.Ключ;
			Для Каждого ЭлСписка ИЗ соо.Значение Цикл
				ПодСтрока = Строка.ПолучитьЭлементы().Добавить();
				ПодСтрока.Представление	= ЭлСписка.Представление;
				ПараметрыСтроки(Выбор,ПодСтрока,ЭлСписка.Значение);//ДозаполнитьСтрокуДерева(ПодСтрока,ЭлСписка.Значение,Выбор);
				ПроверитьВозможностьСвойств(ПодСтрока,Выбор);
			КонецЦикла;
		КонецЦикла;				
	КонецЕсли;
	~М1:
	Если ПолучениеПоИндексу(Строка,Выбор) Тогда
		Если Строка.ОбъемКоллекции =  Неопределено Тогда
			Строка.ОбъемКоллекции = 0;
			Попытка
				Строка.ОбъемКоллекции	= ВыполнитьКлиентСервер_Ei.Выражение(вПолучитьПутьКПеременной(Строка)+".Количество()",,,Выбор.ДоступныеСтруктуры,Ложь);
			Исключение
			КонецПопытки;
		КонецЕсли;	
		Если Строка.ОбъемКоллекции Тогда
			МаксЭлКоллекцииСтрока	= Строка.ПолучитьЭлементы().Добавить();
			МаксЭлКоллекцииСтрока.Представление = "["+Формат(Строка.ОбъемКоллекции-1,"ЧН=0; ЧГ=")+"]";
			МаксЭлКоллекцииСтрока.ВведенВручную = Истина;
			Если НеУдалосьВычислитьЗначениеСтроки(МаксЭлКоллекцииСтрока,Выбор) Тогда
				Строка.ПолучитьЭлементы().Удалить(МаксЭлКоллекцииСтрока);	
			Конецесли;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

// Процедура - Добавляет специальные строки которые способствует дальнейшему разворачиванию дерева
//
// Параметры:
//  ПодСтрока	 - ЭлементКоллекцииДереваЗначений	 - Строка в которую планируеться добавлять специальные строки
//
Процедура ПроверитьВозможностьСвойств(ПодСтрока,Выбор)
	Если Не ЭтоПримитивноеЗначение(Выбор,ПодСтрока) Тогда
		Если Выбор.Форма.Элементы.ДеревоВыбора.Развернут(ПодСтрока.ПолучитьИдентификатор()) = Истина Тогда //почему то может иногда возвращать неопределено
			Развернуть(ПодСтрока,Выбор);
		Иначе	
			ПодСтрока.ПолучитьЭлементы().Добавить();
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

// Функция - Определяет является ли хранимое в строке значение примитивным
//
// Параметры:
//  Выбор		- Структура	 - 
//  Строка	 	- ЭлементКоллекцииДереваЗначений	 - Строка для которой выполняется определение
// 
// Возвращаемое значение:
//   - 
//
Функция ЭтоПримитивноеЗначение(Выбор,Строка)
	Результат = Ложь;
	ОписаниеТипов = ПараметрыСтроки(Выбор,Строка).ОписаниеТипов;
	Если ТипЗнч(ОписаниеТипов) = Тип("ОписаниеТипов") Тогда	
		//вычтим из исходного описания типов все примитивные если что то осталось то тогда это не примитивное описание типов
		врОписаниеТипов = Новый ОписаниеТипов(ОписаниеТипов,,ТипыКлиентСервер_Ei.Примитивные());
		Результат = (врОписаниеТипов.Типы().Количество() = 0); 
	Иначе
		//этот тип недоступен на клиенте значит точно не является примитивным		
	КонецЕсли;	
	Возврат Результат;	
Конецфункции	

//Определяет является ли переданный тип объектом
//Параметры:
//	Тип	-<Тип>. Исходный тип
//Возвращаемое значение: булево
Функция вЭтоТипОбъекта(Тип)
	Результат = Ложь;
	//Если ПараметрыОкружения.Свойство("ВсеОбъекты") Тогда
	//	Результат		= ПараметрыОкружения.ВсеОбъекты.СодержитТип(Тип);
	//Иначе
	//	//объекты не заполнены подбираем по другому
	//	Результат	= (Найти(Тип," объект: ")>0);
	//КонецЕсли;	
	Возврат Результат;
КонецФункции

// Функция определет является ли текущее описание коллекцией с возможностью получения по индексу
//
// Параметры:
//  Тип	 - 	 - <ОписаниеТип>. Исходное описание которое нужно проверить
// 
// Возвращаемое значение:
//   - Булево
//
Функция ПолучениеПоИндексу(ТД,Выбор)
	Если Не ТД.ОбъемКоллекции = Неопределено Тогда 
		Результат = Истина;
	Иначе
		ОписаниеТипов	= ПараметрыСтроки(Выбор,ТД).ОписаниеТипов;
		Результат		= ТипыКлиентСервер_Ei.ОписанияПересекаются(ОписаниеТипов,ТипыКлиентСервер_Ei.Коллекция());
	КонецЕсли;	
	Возврат Результат;
КонецФункции

//Получает путь к выбранной переменной, перебро всех родителей через "."
//Параметры:
//	Строка	-<СтрокаДереваЗначений>. Строка дерева типов
//	
Функция вПолучитьПутьКПеременной(Строка)
	Если ТипЗнч(Строка) = Тип("ДанныеФормыЭлементДерева") Тогда
		Если  Строка.ПолучитьРодителя() = Неопределено Тогда
			ПутьКпеременной	= ?(ПустаяСтрока(Строка.Имя),"",Строка.Представление);
		Иначе
			Родитель 		= Строка.ПолучитьРодителя();
			Приставка		= вПолучитьПутьКПеременной(Родитель);
			Если СтрНайти(Родитель.Представление,ПеречисленияКлиентСерверПовторноеИспользование_Ei.ПризнакАргумента()) Тогда
				//Параметр внутри функции укажем, в значении с большой долей вероятности ОписаниеОповещения
				ПутьКпеременной	= СтрЗаменить(Приставка,Родитель.Представление,СтрЗаменить(Родитель.Представление,ПеречисленияКлиентСерверПовторноеИспользование_Ei.ПризнакАргумента(),""""+Строка.Представление+"""")); 	
			Иначе	
				ПутьКпеременной	= Приставка+"."+Строка.Представление;
			КонецЕсли;	 				
		КонецЕсли;
	Иначе
		ПутьКпеременной		= "";
	КонецЕсли;
	СоотвесвтиеЗамены = Новый Соответствие;
	СоотвесвтиеЗамены.Вставить("..",".");
	СоотвесвтиеЗамены.Вставить(".[","[");
	Возврат ОбщийМодульКлиентСервер_Ei.СтрЗаменитьИзСписка(ПутьКпеременной,СоотвесвтиеЗамены);
КонецФункции

Функция ОкончаниеФункции() Экспорт
	Возврат "("+ПеречисленияКлиентСерверПовторноеИспользование_Ei.ПризнакАргумента()+")";
КонецФункции	
	 

// Функция - Вычислить значение строки
//
// Параметры:
//  ТекущиеДанные	 - ЭлементКоллекцииДерева	 - Строка дерева значений представление для которой необходмо вычислить 
// 
// Возвращаемое значение:
//   - Булево. Ложь - значение успешно вычислено и заполнено в строке, Истина - значение не смогли вычислить
//
Функция НеУдалосьВычислитьЗначениеСтроки(ТекущиеДанные, Выбор, Обновлять = Истина) 
	Отказ 			= Ложь;
	сВыражение  	= вПолучитьПутьКПеременной(ТекущиеДанные);
	//ЗаполнитьЗначенияСвойств(Выбор.Переменные,Выбор.ДоступныеСтруктуры);
	Попытка
		Значение		= ВыполнитьКлиентСервер_Ei.Выражение(сВыражение);//,,,Выбор.ДоступныеСтруктуры);
	Исключение
	    Отказ = Истина;
	КонецПопытки;
	Если Не Отказ Тогда
		ПараметрыСтроки(Выбор,ТекущиеДанные,Значение);	
		Если Обновлять Тогда
			ТекущиеДанные.ПолучитьЭлементы().Очистить();
			ПроверитьВозможностьСвойств(ТекущиеДанные,Выбор);
		КонецЕсли;	
	КонецЕсли;
	Возврат Отказ;
КонецФункции

// Функция определет можем ли мы получить для укзанного описания типов свойства
//
// Параметры:
//  Тип	 - 	 - <ОписаниеТип>. Исходное описание которое нужно проверить
// 
// Возвращаемое значение:
//   - Булево
//
Функция вОписаниеТиповИмеетСвойства(ОписаниеТипов)
	Результат		= 	ТипыКлиентСервер_Ei.ОписанияПересекаются(ОписаниеТипов,ТипыКлиентСерверПовтИсп_Ei.ВсеСсылки()) И 
					Не 	ТипыКлиентСервер_Ei.ОписанияПересекаются(ОписаниеТипов,ТипыКлиентСерверПовтИсп_Ei.ВсеСсылки("Перечисления"))
				ИЛИ вЭтоТипОбъекта(ОписаниеТипов);
	//Если Не Результат Тогда
	//	МассивТипов	= Новый Массив();
	//	//МассивТипов.Добавить(Тип("СтрокаТаблицыЗначений"));
	//	//МассивТипов.Добавить(Тип("СтрокаДереваЗначений"));
	//	МассивТипов.Добавить(Тип("ОбъектXDTO"));
	//	МассивТипов.Добавить(Тип("Структура"));
	//	Результат	= ОбщийМодульКлиентСервер_Ei.вОписаниеТиповПересекаются(ОписаниеТипов,Новый ОписаниеТипов(МассивТипов));			
	//КонецЕсли;
	//Если Не Результат Тогда
	//	Результат	= (Найти(Тип,"табличная часть строка:")>0);			
	//КонецЕсли;	
	Возврат Результат;
КонецФункции

Процедура Развернуть(СтрокаДЗ,Выбор) 
	УдалилиСтроки = ОбщийМодульКлиент_Ei.УдалитьПустыеСтроки(СтрокаДЗ);	
	
	Если Не СтрокаДЗ.ПолучитьЭлементы().Количество() Тогда
		ПараметрыСтроки = ПараметрыСтроки(Выбор,СтрокаДЗ);
		Если Не ПараметрыСтроки.Значение = Неопределено Тогда
			//развернули свойства значений
			Если ТипЗнч(ПараметрыСтроки.ОписаниеТипов) = Тип("ОписаниеТипов") И ПараметрыСтроки.ОписаниеТипов.Типы().Количество()>1 Тогда
				//значение составного типа
				вРазвернутьТипы(СтрокаДЗ,Истина);
			Иначе	
				Если ТипЗнч(ПараметрыСтроки.Значение) = Тип("ОписаниеОповещения") Тогда
					Если НеУдалосьВычислитьЗначениеСтроки(СтрокаДЗ,Выбор,Ложь) Тогда //вычислим значение без обновления
						Возврат;			
					КонецЕсли;
				КонецЕсли;			
				вРазвернутьСвойства(СтрокаДЗ,Выбор);
			КонецЕсли;
		ИначеЕсли ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ПараметрыСтроки.Значение) Тогда// ЗначениеЗаполнено(СтрокаДЗ.Ссылка) ИЛИ ЗначениеЗаполнено(СтрокаДЗ.КэшПредставление)  Тогда
			вРазвернутьСвойства(СтрокаДЗ,Выбор);						
		Иначе
			//развернули типы
            вРазвернутьТипы(СтрокаДЗ,Выбор);
		КонецЕсли;
	КонецЕсли;
	Если Не УдалилиСтроки Тогда //только строку удалили, нет смыслка проверять на доступные свойства
		Если Не СтрокаДЗ.ПолучитьЭлементы().Количество() Тогда
			ПроверитьВозможностьСвойств(СтрокаДЗ,Выбор);
		КонецЕсли;	
	КонецЕсли;
Конецпроцедуры	

//Процедура разворачивает типы значений указанные в строке
//Параметры:
//	Строка 				-<СтрокаДереваЗначений>. Разворачиваемая строка
//	ПриводитьЗначения   -<Булево>. Определяет необходимость приведения значений к типу.
Процедура вРазвернутьТипы(Строка,Выбор,ПриводитьЗначения=Ложь)
	сзОписанияТипов = Новый СписокЗначений;
	Для Каждого Тип ИЗ ПараметрыСтроки(Выбор,Строка).ОписаниеТипов.Типы() Цикл
		Если вТипРазрешен(Выбор.ОграничениеТипа,Тип) Тогда
			Значение 		= ТипыКлиентСервер_Ei.СоздатьОписаниеИзКолекции(Тип);
			сПредставление	= ТипыКлиентСервер_Ei.ПолучитьИмяОписанияТипов(Значение); //ПривестиЗначение().Метаданные().Имя; //найти по типу дольше работает
			сзОписанияТипов.Добавить(Значение,сПредставление);
		КонецЕсли;
	КонецЦикла;
	сзОписанияТипов.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
	//сортируем список и только потом добавляем строки
	Для Каждого ЭлСписка ИЗ сзОписанияТипов Цикл
		ПодСтрока	= Строка.ПолучитьЭлементы().Добавить();
		ПодСтрока.Представление = ЭлСписка.Представление;
		ПараметрыСтроки(Выбор,ПодСтрока,,ЭлСписка.Значение);
		Если ПриводитьЗначения Тогда
			ПодСтрока.Значение	= ПараметрыСтроки(Выбор,ПодСтрока).ОписаниеТипов.ПривестиЗначение(Строка.Значение);
			Если вОписаниеТиповИмеетСвойства(ПараметрыСтроки(Выбор,ПодСтрока).ОписаниеТипов) Тогда
				вРазвернутьСвойства(ПодСтрока,Выбор);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры


#Область ВыборФайлов

Процедура ОО_ПроверкаСуществованияФайла(Результат,ДопПараметры) Экспорт
	ПолноеИмя = ?(Результат,ДопПараметры.ПолноеИмя,"");
	ПоказатьДиалог(ПолноеИмя,ДопПараметры.ВладелецФормы,ДопПараметры.Выбор); 	
КонецПроцедуры

Процедура ОО_ЗавершениеВыбораФайла(ВыбранныеФайлы,ДопПараметры) Экспорт
	Если Не ВыбранныеФайлы = Неопределено Тогда
		ВыбранноеЗначение =  Неопределено;
		Если ВыбранныеФайлы.Количество() > 1 Тогда
			сзНовый = Новый СписокЗначений;
			сзНовый.ЗагрузитьЗначения(ВыбранныеФайлы);
			ВыбранноеЗначение = сзНовый;
		Иначе	
			Для Каждого сИмяФайла ИЗ ВыбранныеФайлы	Цикл
				ВыбранноеЗначение = сИмяФайла;
			КонецЦикла;
		КонецЕсли;	
		Если Не ВыбранноеЗначение =  Неопределено Тогда
			//дозаполним структуру так чтобы ее могла правильно исполнить обработка выбора
			ДопПараметры.Выбор.ТекущиеДанные.ЗначениеПараметра = ВыбранноеЗначение; 
			//ДопПараметры.ВладелецФормы.ОбработкаВыбора_ВыборТипа(ДопПараметры.Выбор.ТекущиеДанные)
			ОкончаниеВыбора(ДопПараметры.ВладелецФормы, ДопПараметры.Выбор);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

Процедура ПоказатьДиалог(ПолноеИмя="",ВладелецФормы,Выбор)
	Длг 					= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Длг.ПолноеИмяФайла 		= ПолноеИмя;
	Длг.Заголовок 			= "Укажите путь к файлу или папке";
	Длг.Фильтр 				= "Все файлы (*.*)|*.*";
	Длг.МножественныйВыбор	= Истина;
	Длг.Показать(Новый ОписаниеОповещения("ОО_ЗавершениеВыбораФайла",ВыборКлиент_Ei,Новый Структура("ВладелецФормы,Выбор",ВладелецФормы,Выбор)));
КонецПроцедуры

#КонецОбласти

// Процедура - Закрывает/Скрывает диалог выбора в зависмости от типа открытия
//
// Параметры:
//  Форма	 - Форма - Форма в которой отображен диалог выбора 
//
Процедура ЗакрытьВыбор(Форма) Экспорт
	Если Форма.ИмяФормы = ИмяМодальнойФормы() Тогда
		Форма.Закрыть();
	Иначе	
		Форма.Элементы.ДеревоВыбора.Родитель.Видимость = Ложь;
	КонецЕсли;		
КонецПроцедуры

#КонецОбласти


// ОБРАБОТЧИКИ СОБЫТИЙ ДЕРЕВА ЗНАЧЕНИЙ
#Область ОбработчикиСобытийДерева

Процедура ДеревоЗначенийПредставлениеРегулирование(Форма,Выбор,Элемент,Направление, СтандартнаяОбработка) Экспорт
	СтандартнаяОбработка 		= Ложь;
	ЭлементФормыДереваВыбора	= Форма.Элементы.ДеревоВыбора;
	ТД  						= ЭлементФормыДереваВыбора.ТекущиеДанные;
	
	Если Не ТД = Неопределено И Найти(ТД.Представление,"[") И ТД.ВведенВручную Тогда
		сПредставление  =  ТД.Представление;
		сЧисло 			=  СтрЗаменить(СтрЗаменить(сПредставление,"[",""),"]","");
		Попытка
			чЧисло = Макс(Число(сЧисло),0);	
		Исключение
			Возврат;
		КонецПопытки;	
		ТД.Представление = "["+Формат((чЧисло+Направление),"ЧН=0; ЧГ=")+"]";
		Если НеУдалосьВычислитьЗначениеСтроки(ТД,Выбор) Тогда
			ТД.Представление = сПредставление;
		Иначе
			ДеревоЗначенийПриАктивизацииСтроки(Форма,Выбор,ЭлементФормыДереваВыбора);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Процедура ДеревоЗначенийПриАктивизацииСтроки(Форма,Выбор,Элемент) Экспорт
	Если ТипЗнч(Элемент.ТекущиеДанные) = Тип("ДанныеФормыЭлементДерева") Тогда
		//Если Не Элемент.ТекущиеДанные.Значение = Неопределено Тогда
			Форма.ДеревоВыбора_Путь	= вПолучитьПутьКПеременной(Элемент.ТекущиеДанные);
		//Иначе
		//	Путь	= "";
		//КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ДеревоЗначенийПередОкончаниемРедактирования(Форма, Выбор, Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)Экспорт
	Если Не ОтменаРедактирования Тогда
		Отказ = НеУдалосьВычислитьЗначениеСтроки(Элемент.ТекущиеДанные,Выбор);
    КонецЕсли;
КонецПроцедуры

//Устанавливаем признак ввода вручную
//
Процедура ДеревоЗначенийПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование) Экспорт
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.ВведенВручную = Истина;	
	КонецЕсли;	
КонецПроцедуры

//Разрещаем копирование только введеных вручную,
//Создание новых только у тех и кого заполнено значение
//
Процедура ДеревоЗначенийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр) Экспорт
	Если Копирование Тогда
		Отказ = Не Элемент.ТекущиеДанные.ВведенВручную;
	Иначе
		Отказ = (Элемент.ТекущиеДанные = Неопределено);
	КонецЕсли;	
КонецПроцедуры

Процедура ДеревоЗначенийПередРазворачиванием(Форма, Выбор, Элемент, Строка, Отказ) Экспорт
	СтрокаДЗ = Форма.ДеревоВыбора.НайтиПоИдентификатору(Строка);
	Если Не СтрокаДЗ = Неопределено Тогда
		Развернуть(СтрокаДЗ, Выбор);
	КонецЕсли;	
КонецПроцедуры

//Разрешем редактирование только введенных вручную или колонки флажка
//
Процедура ДеревоЗначенийПередНачаломИзменения(Элемент, Отказ) Экспорт
	Если Не Элемент.ТекущиеДанные = Неопределено Тогда
		Отказ = Не Элемент.ТекущиеДанные.ВведенВручную;
	Иначе 
		Отказ = Истина;
	КонецЕсли;	
КонецПроцедуры

//Закрываем форму, а выбранное значение передаем в ТекущиеДанные
//
Процедура ДеревоЗначенийВыбор(Форма, Выбор, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) Экспорт
	СтрокаДЗ = Форма.ДеревоВыбора.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Не СтрокаДЗ = Неопределено Тогда
		ЭлементФормыПредставления	= Форма.Элементы.ДеревоВыбора_Представление;
		ПараметрыСтроки				= ПараметрыСтроки(Выбор,СтрокаДЗ);
		Если Не Поле = ЭлементФормыПредставления И ЗначениеЗаполнено(ПараметрыСтроки.Значение) Тогда
			//шелкнули 2 раза по не пустому значению 
			Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ПараметрыСтроки.Значение) И 
				(ПараметрыСтроки.Значение.ОписаниеТипов = ТипыКлиентСервер_Ei.Универсальные().ТаблицаЗначений
				ИЛИ 
				ПараметрыСтроки.Значение.ОписаниеТипов = ТипыКлиентСервер_Ei.Универсальные().ДеревоЗначений) Тогда
				ПараметрыФормы = Новый Структура("ОписаниеЗначения",ПараметрыСтроки.Значение);
				ОткрытьФорму("ОбщаяФорма.Коллекция_Ei",ПараметрыФормы,Форма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			Иначе	
				ПоказатьЗначение(,ПараметрыСтроки.Значение);
			КонецЕсли;	
		Иначе
			Если вТипРазрешен(Выбор.ОграничениеТипа,ПараметрыСтроки.ОписаниеТипов) Тогда
				Если Не ПараметрыСтроки.Значение = Неопределено Тогда //ИЛИ ЗначениеЗаполнено(СтрокаДЗ.Ссылка) ИЛИ ЗначениеЗаполнено(СтрокаДЗ.КэшПредставление) Тогда
					//выбрали доступную переменную
					ПараметрыСтроки	= ПараметрыСтроки(Выбор,СтрокаДЗ);
					СтруктураВыбора =  Выбор.ТекущиеДанные;
					СтруктураВыбора.Вставить("Значение",ПараметрыСтроки.Значение); //дополним возвращаемую структуру Вычисленным описанием значения, для использования в выборе возвращаемых значений Jбработок
					СтруктураВыбора.ЗначениеПараметра 	= вПолучитьПутьКПеременной(СтрокаДЗ);
					СтруктураВыбора.ЭтоВыражение 		= Истина;
					ОкончаниеВыбора(Форма, Выбор);//,СтруктураВыбора);
				Иначе
					//просто выбрали тип
					Если Не ПараметрыСтроки.ОписаниеТипов = Неопределено Тогда
						Если ПараметрыСтроки.ОписаниеТипов.Типы().Количество() Тогда
							//ЭлементУправления.ОграничениеТипа 	= СтрокаДЗ.ОписаниеТипов;
							Выбор.ТекущиеДанные.ЗначениеПараметра 	= ПараметрыСтроки.ОписаниеТипов.ПривестиЗначение();
							//ЭлементУправления.ВыбиратьТип 			= Ложь;
							Выбор.ТекущиеДанные.ЭтоВыражение		= Ложь;
							ОкончаниеВыбора(Форма, Выбор);//,Выбор.ТекущиеДанные);
						КонецЕсли;	
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Процедура ДеревоВыбораНачалоПеретаскивания(Форма, Выбор, Элемент, ПараметрыПеретаскивания, Выполнение)  Экспорт
	Строка = Форма.ДеревоВыбора.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение);
	Если Не Строка = Неопределено Тогда
		сз = Новый СписокЗначений;
		Выражение = вПолучитьПутьКПеременной(Строка);
		сз.Добавить(Выражение,Выражение);  //Вмемсто 'Строка.Значение' пишем 'Выражение' и тогда по умолчанию будет становится оно, для перетаскивания из этой формы так лучше, всегда можно пересчитать если снять флаэок "Этовыражение" 
		ПеретаскиваниеКлиент_Ei.НачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение, сз);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

// Вызывается при финальном выборе значения
//
// Параметры:
//  Форма	 - Форма - Форма в которой отображен диалог выбора 
//  Выбор	 - Структура - Вспомогательная структура описана в общей форме Выбор_Ei, экспортная переменная
//
Процедура ОкончаниеВыбора(Форма,Выбор)
	Если Не Выбор.ЗавершениеВыбора =  Неопределено Тогда
		ВыполнитьОбработкуОповещения(Выбор.ЗавершениеВыбора,Выбор.ТекущиеДанные);
	КонецЕсли;	
	Выбор	= Новый Структура;
	ЗакрытьВыбор(Форма);
КонецПроцедуры	

// Функция - Выполняет наслдование/копирование поведения общей формы Выбор_Ei
// Параметры:
// 	Форма -  Целевая форма
// 	Контейнер - Элемент формы, где должна появится все элементы наследуемой формы
// 	РодительКонтейнера	- Элемент формы, в котором должен находится контейнер. Необходимо в тех случаях когда контейнер должен появлятся в разных местах формы		
// Возвращаемое значение:
// 	-Форма- из которой скопировали поведение
//
Функция НаследоватьВыбор(Форма,Контейнер,РодительКонтейнера = Неопределено) Экспорт
	Если Не РодительКонтейнера = Неопределено Тогда
		Если РодительКонтейнера.ПодчиненныеЭлементы.Найти(Контейнер.Имя) = Неопределено Тогда
			//нужно контейнер переместить под родителя
			Форма.Переместить(Контейнер.Имя,РодительКонтейнера.Имя);
		КонецЕсли; 
	КонецЕсли;	
	Если Не Контейнер.ПодчиненныеЭлементы.Количество() Тогда
		ФормаРодитель 		= ПолучитьФорму(ВыборКлиент_Ei.ИмяМодальнойФормы());
		НаследованиеФормКлиент_Ei.Дополнить(ФормаРодитель,Форма,Контейнер);
		ФормаРодитель.Выбор = Новый Структура;
	КонецЕсли;
	Если Не РодительКонтейнера = Неопределено Тогда
		// после наследования изменим отображение определенных элементов
		ЭтоВспГруппа = (РодительКонтейнера.Поведение = ПоведениеОбычнойГруппы.Всплывающая);
		//Скроем кнопку закрытия во всплевающем режиме
		КнопкаЗакрытия = Форма.Элементы.Найти("ДеревоВыбораКнопкаЗакрыть"); 
		Если Не КнопкаЗакрытия = Неопределено Тогда
			КнопкаЗакрытия.Видимость = 	Не ЭтоВспГруппа;
		КонецЕсли;
		//Уменьшим таблицу формы во всплыващем режиме
		ЭлементДерева = Форма.Элементы.Найти("ДеревоВыбора"); 
		Если Не ЭлементДерева = Неопределено Тогда
			Если ЭтоВспГруппа Тогда
				ЭлементДерева.ВариантУправленияВысотой = ВариантУправленияВысотойТаблицы.ПоСодержимому;	
			Иначе
				ЭлементДерева.ВариантУправленияВысотой = ВариантУправленияВысотойТаблицы.Авто;			
			КонецЕсли;		
		КонецЕсли;
		//Снимим флаг автоширины
		ЭлементДерева.АвтоМаксимальнаяШирина = Не ЭтоВспГруппа;
	КонецЕсли;	
	Возврат Форма.НаследованиеФорм.ФормыРодители.Получить(Контейнер.Имя);
КонецФункции


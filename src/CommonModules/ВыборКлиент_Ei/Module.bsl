// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

#Область ОбщегоНазначения

//Отображает окно или элемент выбора типа/значения
//Параметры:
//  Выбор					-<Структура> Вспомогательная структура
//									сооТипов				-<Соответствие> Накопление соотвесвия типов более подробно в процедурее ОписаниеТипов
//									Переменные              -<Структура> Фиксированная структура переменных используемая для встроенного языка
//									ТекущиеДанные			-<СтрокаТаблицыЗначений.Структура> Используется для определения значений - ЭтоВыражение,ИмяПараметра
//									ДоступныеПеременные		-<Структура> ВыборПеременные, которые можно выбрать в текщем контексте
//									ОграничениеТипа			-<ОписаниеТипов> Типы которые доступны для выбора в текущем контексте, учитываются и для переменных
//									ЗапретитьВстроенныйЯзык -<Неопределено> Если это свойство указано не открываем окно встроенного языка
//	ВладелецФормы			-<Форма>. Элемент в котором произведен выбор
//	ИмяЭлемента				-<Строка>  Имя элмента владельца формы, если не задано то происходит модальный выбор из предопределенной формы
//
Процедура Показать(Выбор,ВладелецФормы,стрИмяЭлементаВыбора)
	ЭлементВыбора =  Неопределено;
	Если ЗначениеЗаполнено(стрИмяЭлементаВыбора) Тогда
		ЭлементВыбора = ВладелецФормы.Элементы.Найти(стрИмяЭлементаВыбора);	
	КонецЕсли;
	Если ЭлементВыбора = Неопределено Тогда
		//открываем модально
		стрИмяЭлементаВыбора		= "ДеревоВыбора";//указываем как называется имя элемента формы и соотвесвующее ему имя занчения в модальной форме
		стрИмяМодальнойФормыВыбора	= ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеФормы().ВыборТипа;
		РежимОткрытияОкна 			= РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ФормаВыбора 				= ОткрытьФорму(стрИмяМодальнойФормыВыбора,,ВладелецФормы,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ФормаВыбора					= ВладелецФормы;
	КонецЕсли;
	Выбор.Вставить("Форма",ФормаВыбора);
	Выбор.Вставить("ИмяЭлемента",стрИмяЭлементаВыбора); 
	ФормаВыбора.Выбор = Выбор;
	ДеревоВыбораЭлемент(Выбор).Родитель.Видимость = Истина; //
	ИнициализацияВыбора(Выбор);
КонецПроцедуры

//Производит инициализацию формы выбора
//Параметры:
//  Выбор					-<Структура> Вспомогательная структура
//									Форма					-<Форма> Форма в которой производится выбор типа или значения, может быть как модальная так и та из которой происходит выбор
//									ИмяЭлемента				-<Строка> Имя элемента форма и занчения формы в которм расположено дерево выбора
//									сооТипов				-<Соответствие> Накопление соотвесвия типов более подробно в процедурее ОписаниеТипов
//									Переменные              -<Структура> Фиксированная структура переменных используемая для встроенного языка
//									ТекущиеДанные			-<СтрокаТаблицыЗначений.Структура> Используется для определения значений - ЭтоВыражение,ИмяПараметра
//									ДоступныеПеременные		-<Структура> ВыборПеременные, которые можно выбрать в текщем контексте
//									ОграничениеТипа			-<ОписаниеТипов> Типы которые доступны для выбора в текущем контексте, учитываются и для переменных
//									ЗапретитьВстроенныйЯзык -<Неопределено> Если это свойство указано не открываем окно встроенного языка
//
Процедура ИнициализацияВыбора(Выбор)
	ДеревоВыбора = ДеревоВыбора(Выбор);
	Если Не ДеревоВыбора.ПолучитьЭлементы().Количество() Тогда
		Выбор.сооТипов.Очистить();
		вЗаполнитьДеревоДоступнымиПеременными(Выбор,ДеревоВыбора);
	КонецЕсли;	
	//Доступные типы 
	СписокТипов = ВыборВызовСервера_Ei.вПолучитСписокДоступныхТипов(Выбор.ТекущиеДанные.ЭтоВыражение);
	Для Каждого Тип  ИЗ СписокТипов Цикл
		Если вТипРазрешен(Выбор.ОграничениеТипа,Тип.Значение) И Тип.Значение.типы().Количество() Тогда
			НоваяСтрока	= ДеревоВыбора.ПолучитьЭлементы().Добавить();
			НоваяСтрока.Представление	= Тип.Представление;
			ОписаниеТипов(Выбор.сооТипов,НоваяСтрока,Тип.Значение);
			Если  Тип.Пометка Тогда
				//добавлем подстроку чтобы можно было развернуть
				НоваяПодСтрока=НоваяСтрока.ПолучитьЭлементы().Добавить();
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	ВыполнитьОбработкуОповещения(Новый ОписаниеОповещения("ВыборВыражения",ВыборКлиент_Ei),Выбор); //Производим ассинхронный вызов поиска чтобы не задерживать открытие или отображение формы
	
	//ЭлементыФормы.Путь.КнопкаОткрытия	= Не  СтруктураДопПараметров.Свойство("ЗапретитьВстроенныйЯзык");
	//Если ЭлементыФормы.ДеревоЗначений.ТекущиеДанные = Неопределено Тогда
	//	//тут хорошобы активизировать единственный тип, но он известен только после разворота +	
	//КонецЕсли;	
КонецПроцедуры

//Процедура производит позиционированием на выбранной переменной, либо открывает окно встроенного языка.
//Последнне открывается в случае если в доступных переменных мы не нашли указанного пути.
//Параметры:
//  Выбор				-<Структура> Вспомогательная структура
//	ДопПараметры        -<Структура> Структура доп параметров
//								ИскатьВДоступныхПеременных  -<Булево>. Выполнять поиск в доступных переменных
//
Процедура ВыборВыражения(Выбор,ДопПараметры) Экспорт
	Если Выбор.ТекущиеДанные.ЭтоВыражение Тогда
		СтрокаПоиска	= ДеревоВыбора(Выбор);
		Выражение		= Нрег(Выбор.ТекущиеДанные.ЗначениеПараметра);
		Для Каждого сЧастьВыражения ИЗ СтрРазделить(Выражение,".") Цикл
			Если Не ПустаяСтрока(сЧастьВыражения) Тогда 
				Для Каждого ПодСтрока ИЗ СтрокаПоиска.ПолучитьЭлементы() Цикл
					Если нРег(ПодСтрока.Имя) = СокрЛП(нРег(сЧастьВыражения)) Тогда
						СтрокаПоиска = Подстрока;
						ДеревоВыбораЭлемент(Выбор).ТекущаяСтрока = СтрокаПоиска.ПолучитьИдентификатор();
						Развернуть(СтрокаПоиска, Выбор);
						Прервать;
					КонецЕсли;	
				КонецЦикла;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

//Производит заполнение дерева значений доступными переменными
//
Процедура вЗаполнитьДеревоДоступнымиПеременными(Выбор,ДеревоВыбора)
	Если ТипЗнч(Выбор.ДоступныеСтруктуры) = Тип("Структура") Тогда
		Для Каждого ДоступнаяСтруктура Из  Выбор.ДоступныеСтруктуры Цикл
			НоваяСтрока = ДеревоВыбора.ПолучитьЭлементы().Добавить();
			НоваяСтрока.Представление	= ДоступнаяСтруктура.Ключ;
			ДозаполнитьСтрокуДерева(НоваяСтрока,ДоступнаяСтруктура.Значение,Выбор);
			вРазвернутьСвойства(НоваяСтрока,Выбор);
	 	КонецЦикла;	
	КонецЕсли;	
Конецпроцедуры

//Функция проверят разрешен ли к использованию в этой форме данное описание типов(тип)
//Параметры:
//	ОписаниеТипов	-<ОписаниеТипов,Тип>. Объект, который нужно проверить	
Функция вТипРазрешен(ОграничениеТипа,ОписаниеТипов)
	Если ЗначениеЗаполнено(ОграничениеТипа) Тогда
		Если ТипЗнч(ОписаниеТипов) = Тип("ОписаниеТипов") Тогда
			//Если ОписаниеТипов.Типы().Количество()=0 Тогда
				//Возврат Истина; //неопределенный тип возможен только при загрузке из внешних источников, разрешим надеясь что пользователь понимает что делает не хрена не понятно даже я облажался с номером
			//Иначе	
			Возврат Истина;//вОписаниеТиповПересекаются(Параметры.ОграничениеТипа,ОписаниеТипов);
		ИначеЕсли ТипЗнч(ОписаниеТипов) = Тип("Тип") Тогда
			Возврат ОграничениеТипа.СодержитТип(ОписаниеТипов);
		Иначе
			Возврат Ложь;
		КонецЕсли;	
	Иначе
		Возврат Истина;
	КонецЕсли;	
КонецФункции

// Функция - устанавливает или получает значение описание типов для строки 
// Не все типы могут использоваться в данных формы к таким например относится СписокXDTO
//
// Параметры:
//  Строка			 - ЭлементКоллекции	 - Строка дерева
//  ОписаниеТипов	 - ОписаниеТипов	 - Сохраняемое ОписаниеТипов
// 
// Возвращаемое значение:
//   - ОписаниеТипов. Полученное опсиание типов
//
Функция ОписаниеТипов(сооТипов,Строка,ОписаниеТипов=Неопределено)
	Если ОписаниеТипов = Неопределено Тогда
		//получаем
		Результат = сооТипов.Получить(Строка.ПолучитьИдентификатор());
		Возврат ?(Результат = Неопределено,Новый ОписаниеТипов,Результат);
	Иначе
		//сохраняем
		сооТипов.Вставить(Строка.ПолучитьИдентификатор(),ОбщийМодульКлиентСервер_Ei.ПроверитьОписаниеТипов(ОписаниеТипов));
	КонецЕсли;
КонецФункции

Процедура ДозаполнитьСтрокуДерева(НоваяСтрока,Значение,Выбор)
	НоваяСтрока.Имя		= НРег(НоваяСтрока.Представление);
	Если ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		сСвойствоИсключения = "";
		Если Значение.Свойство("Значение") Тогда
			сСвойствоИсключения = "Значение";
			УстановитьЗначениеВСтрокуДерева(НоваяСтрока,Значение.Значение);
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Значение,,сСвойствоИсключения);
		Если Значение.Свойство("ОписаниеТипов") Тогда
			ОписаниеТипов(Выбор.сооТипов,НоваяСтрока,Значение.ОписаниеТипов);
		КонецЕсли;	
	Иначе
		УстановитьЗначениеВСтрокуДерева(НоваяСтрока,Значение);
		ОписаниеТипов(Выбор.сооТипов,НоваяСтрока,ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(ТипЗнч(Значение)));
	КонецЕсли;
Конецпроцедуры

Процедура УстановитьЗначениеВСтрокуДерева(НоваяСтрока,Значение)
	Попытка
		НоваяСтрока.Значение = Значение;
	Исключение
		//этот тип недоступен на клиенте
		ПеречисленияКлиентСерверПовторноеИспользование_Ei.Значения().Вставить(НоваяСтрока.ПолучитьИдентификатор(),Значение); 
		НоваяСтрока.КэшПредставление = Строка(ТипЗнч(Значение));
	КонецПопытки;
КонецПроцедуры 	

//Процедура разворачивает свойства значения указанного в строке
//Параметры:
//	Строка 				-<СтрокаДереваЗначений>. Разворачиваемая строка
Процедура вРазвернутьСвойства(Строка,Выбор)
	Если ЗначениеЗаполнено(Строка.Ссылка) ИЛИ ЗначениеЗаполнено(Строка.КэшПредставление) Тогда
		//это ссылка во внутренее хранилище
		//или
		//это значеие из Кеша сеанса, не все можно посместить во внутренее хранилище (не все сериализуетя)
		Выбор.Форма.ЗаполнитьСвойствамиСсылкиЗначения(Выбор.ИмяЭлемента,Строка.ПолучитьИдентификатор());
		Для Каждого ПодСтрока ИЗ Строка.ПолучитьЭлементы() Цикл
			ОписаниеТипов(Выбор.сооТипов,ПодСтрока,ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(ТипЗнч(ПодСтрока.Значение)));
			ПроверитьВозможностьСвойств(ПодСтрока,Выбор);	
		КонецЦикла;	
	ИначеЕсли 	ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки().СодержитТип(ТипЗнч(Строка.Значение)) И 
			Не ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки("Перечисления").СодержитТип(ТипЗнч(Строка.Значение))
		ИЛИ вЭтоТипОбъекта(ТипЗнч(Строка.Значение)) Тогда
		Для Каждого ЭлСписка ИЗ ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСвойстваОбъектаМетаданных(Строка.Значение,Новый УникальныйИдентификатор) Цикл
			ПодСтрока=Строка.ПолучитьЭлементы().Добавить();
			ПодСтрока.Представление	= ЭлСписка.Представление;
			ДозаполнитьСтрокуДерева(ПодСтрока,ЭлСписка.Значение,Выбор);
			ПроверитьВозможностьСвойств(ПодСтрока,Выбор);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Строка.Значение) = Тип("Структура") Тогда
		Для Каждого Переменная ИЗ  Строка.Значение Цикл
			Если ТипЗнч(Переменная.Значение) = Тип("ФиксированнаяСтруктура") Тогда
				ЗначениеСвойства = Переменная.Значение;
			Иначе	
				ЗначениеСвойства = Новый ФиксированнаяСтруктура("ОписаниеТипов,Значение",ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(ТипЗнч(Переменная.Значение)),Переменная.Значение);
			КонецЕсли;	
			ПодСтрока = Строка.ПолучитьЭлементы().Добавить();
			ПодСтрока.Представление	= Переменная.Ключ;
			ДозаполнитьСтрокуДерева(ПодСтрока,ЗначениеСвойства,Выбор);
			ПроверитьВозможностьСвойств(ПодСтрока,Выбор);
		КонецЦикла;
	КонецЕсли;
	Если ЭтоКоллекция(Строка,Выбор) Тогда
		СлужебныеДанные			= Новый Структура("Выражение",вПолучитьПутьКПеременной(Строка)+".Количество()");
		ЗаполнитьЗначенияСвойств(Выбор.Переменные,Выбор.ДоступныеСтруктуры);
		Попытка
			МаксЭлКоллекции	= ОбщийМодульКлиент_Ei.__ВычислитьЗначение(СлужебныеДанные,Выбор.Переменные.Параметры,Выбор.Переменные.ЭтаФорма,Выбор.Переменные.Объект,Выбор.Переменные.ТекущиеДанные,Выбор.Переменные.СтрокаТЧ,,Ложь);
		Исключение
			МаксЭлКоллекции = 0;
		КонецПопытки;
		Если МаксЭлКоллекции Тогда
			МаксЭлКоллекцииСтрока	= Строка.ПолучитьЭлементы().Добавить();
			МаксЭлКоллекцииСтрока.Представление = "["+Формат(МаксЭлКоллекции-1,"ЧН=0; ЧГ=")+"]";
			МаксЭлКоллекцииСтрока.ВведенВручную = Истина;
			Если НеУдалосьВычислитьЗначениеСтроки(МаксЭлКоллекцииСтрока,Выбор) Тогда
				Строка.ПолучитьЭлементы().Удалить(МаксЭлКоллекцииСтрока);	
			Конецесли;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

// Процедура - Добавляет специальные строки которые способствует дальнейшему разворачиванию дерева
//
// Параметры:
//  ПодСтрока	 - ЭлементКоллекцииДереваЗначений	 - Строка в которую планируеься добавлять специальные строки
//
Процедура ПроверитьВозможностьСвойств(ПодСтрока,Выбор)
	СвойстваВозможны = Ложь;
	Если вОписаниеТиповИмеетСвойства(ОписаниеТипов(Выбор.сооТипов,ПодСтрока)) Тогда
		//добавим пустую строку чтобы можнобыло развернуть
		СвойстваВозможны = Истина;
	КонецЕсли;
	Если Не СвойстваВозможны Тогда
		Если ЗначениеЗаполнено(ПодСтрока.Ссылка) ИЛИ ЗначениеЗаполнено(ПодСтрока.КэшПредставление) Тогда
			//это ссылка на внутренее хранилищие посмотрим что там лежит
			Выбор.Форма.ЗаполнитьСвойствамиСсылкиЗначения(Выбор.ИмяЭлемента,ПодСтрока.ПолучитьИдентификатор(),СвойстваВозможны);
		КонецЕсли;	
	КонецЕсли;
	Если Не СвойстваВозможны Тогда
		СвойстваВозможны = ЭтоКоллекция(ПодСтрока,Выбор);
	КонецЕсли;
	Если СвойстваВозможны Тогда
		Если ДеревоВыбораЭлемент(Выбор).Развернут(ПодСтрока.ПолучитьИдентификатор()) Тогда
			Развернуть(ПодСтрока,Выбор);
		Иначе	
			ПустаяПодСтрока	= ПодСтрока.ПолучитьЭлементы().Добавить();
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

//Получает дерева выбора из вспомогательной структуры
//
Функция ДеревоВыбора(Выбор)
	Возврат Выбор.Форма[Выбор.ИмяЭлемента];	
КонецФункции

//Получает элемент формы дерева выбора из вспомогательной структуры
//
Функция ДеревоВыбораЭлемент(Выбор)
	Возврат Выбор.Форма.Элементы[Выбор.ИмяЭлемента];	
КонецФункции

//Определяет является ли переданный тип объектом
//Параметры:
//	Тип	-<Тип>. Исходный тип
//Возвращаемое значение: булево
Функция вЭтоТипОбъекта(Тип)
	Результат = Ложь;
	//Если ПараметрыОкружения.Свойство("ВсеОбъекты") Тогда
	//	Результат		= ПараметрыОкружения.ВсеОбъекты.СодержитТип(Тип);
	//Иначе
	//	//объекты не заполнены подбираем по другому
	//	Результат	= (Найти(Тип," объект: ")>0);
	//КонецЕсли;	
	Возврат Результат;
КонецФункции

// Функция определет является ли текущее описание коллекцией
//
// Параметры:
//  Тип	 - 	 - <ОписаниеТип>. Исходное описание которое нужно проверить
// 
// Возвращаемое значение:
//   - Булево
//
Функция ЭтоКоллекция(ТД,Выбор)
	Если ТД.ЭтоКоллекция Тогда
		Результат = Истина;
	Иначе
		ОписаниеТипов	= ОписаниеТипов(Выбор.сооТипов,ТД);
		МассивТипов		= Новый Массив();
		//МассивТипов.Добавить(Тип("СтрокаТаблицыЗначений"));
		//МассивТипов.Добавить(Тип("СтрокаДереваЗначений"));
		МассивТипов.Добавить(Тип("СписокXDTO"));
		МассивТипов.Добавить(Тип("СписокЗначений"));
		МассивТипов.Добавить(Тип("Массив"));
		Результат	= ОбщийМодульКлиентСервер_Ei.вОписаниеТиповПересекаются(ОписаниеТипов,Новый ОписаниеТипов(МассивТипов));
	КонецЕсли;	
	Возврат Результат;
КонецФункции

//Получает путь квыбранной переменной, перебро всех родителей через .
//Параметры:
//	Строка	-<СтрокаДереваЗначений>. Строка дерева типов
//	
Функция вПолучитьПутьКПеременной(Строка)
	Если ТипЗнч(Строка) = Тип("ДанныеФормыЭлементДерева") Тогда
		Если  Строка.ПолучитьРодителя() = Неопределено Тогда
			ПутьКпеременной	= ?(ПустаяСтрока(Строка.Имя),"",Строка.Представление);
		Иначе
			Приставка		= вПолучитьПутьКПеременной(Строка.ПолучитьРодителя());
			ПутьКпеременной	= Приставка+"."+Строка.Представление;
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.ДополнениеПредставления) Тогда
			ПутьКпеременной = СтрЗаменить(Строка.ДополнениеПредставления,ПеречисленияКлиентСерверПовторноеИспользование_Ei.Подмена(),ПутьКпеременной);	
		КонецЕсли;	
	Иначе
		ПутьКпеременной		= "";
	КонецЕсли;
	СоотвесвтиеЗамены = Новый Соответствие;
	СоотвесвтиеЗамены.Вставить("..",".");
	СоотвесвтиеЗамены.Вставить(".[","[");
	Возврат ОбщийМодульКлиентСервер_Ei.СтрЗаменитьИзСписка(ПутьКпеременной,СоотвесвтиеЗамены);
КонецФункции

// Функция - Вычислить значение строки
//
// Параметры:
//  ТекущиеДанные	 - ЭлементКоллекцииДерева	 - Строка дерева значений представление для которой необходмо вычислить 
// 
// Возвращаемое значение:
//   - Булево. Ложь - значение успешно вычислено и заполнено в строке, Истина - значение не смогли вычислить
//
Функция НеУдалосьВычислитьЗначениеСтроки(ТекущиеДанные,Выбор) 
	Отказ 			= Ложь;
	сВыражение  	= вПолучитьПутьКПеременной(ТекущиеДанные);
	СлужебныеДанные	= Новый Структура("Выражение",сВыражение);
	ЗаполнитьЗначенияСвойств(Выбор.Переменные,Выбор.ДоступныеСтруктуры);
	СобытиеОтладки 	= ОбщийМодульКлиент_Ei.ДобавитьСобытие("Добавление строки с произвольным выражением"+Символы.ПС+сВыражение,"Исследователь");
	Попытка
		Выбор.Форма.ВычислитьЗначениеСтрокиНаСервере(ТекущиеДанные.ПолучитьИдентификатор(),СлужебныеДанные,Выбор.Переменные,Выбор.ИмяЭлемента);
		//тут еще нужно определить тип вычисленной строки а тто невозможно получить свойства
	Исключение
		ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнформацияОбОшибке());
	    Отказ = Истина;
	КонецПопытки;
	Если Не Отказ Тогда
		ОбщийМодульКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
		ТекущиеДанные.ПолучитьЭлементы().Очистить();
		Если ЗначениеЗаполнено(ТекущиеДанные.Значение) Тогда
			ОписаниеТипов(Выбор.сооТипов,ТекущиеДанные,ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(ТипЗнч(ТекущиеДанные.Значение)));	
		КонецЕсли;	
		ПроверитьВозможностьСвойств(ТекущиеДанные,Выбор);
	КонецЕсли;
	Возврат Отказ;
КонецФункции

// Функция определет можем ли мы получить для укзанного описания типов свойства
//
// Параметры:
//  Тип	 - 	 - <ОписаниеТип>. Исходное описание которое нужно проверить
// 
// Возвращаемое значение:
//   - Булево
//
Функция вОписаниеТиповИмеетСвойства(ОписаниеТипов)
	Результат		= 	ОбщийМодульКлиентСервер_Ei.вОписаниеТиповПересекаются(ОписаниеТипов,ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки()) И 
					Не 	ОбщийМодульКлиентСервер_Ei.вОписаниеТиповПересекаются(ОписаниеТипов,ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки("Перечисления"))
				ИЛИ вЭтоТипОбъекта(ОписаниеТипов);
	Если Не Результат Тогда
		МассивТипов	= Новый Массив();
		//МассивТипов.Добавить(Тип("СтрокаТаблицыЗначений"));
		//МассивТипов.Добавить(Тип("СтрокаДереваЗначений"));
		МассивТипов.Добавить(Тип("ОбъектXDTO"));
		МассивТипов.Добавить(Тип("Структура"));
		Результат	= ОбщийМодульКлиентСервер_Ei.вОписаниеТиповПересекаются(ОписаниеТипов,Новый ОписаниеТипов(МассивТипов));			
	КонецЕсли;
	//Если Не Результат Тогда
	//	Результат	= (Найти(Тип,"табличная часть строка:")>0);			
	//КонецЕсли;	
	Возврат Результат;
КонецФункции

Процедура Развернуть(СтрокаДЗ,Выбор) 
	ПустаяПодСтрока = Неопределено;
	Для Каждого ПодСтрока ИЗ СтрокаДЗ.ПолучитьЭлементы() Цикл
		Если Не ЗначениеЗаполнено(ПодСтрока.Представление) Тогда
			ПустаяПодСтрока = ПодСтрока;
			СтрокаДЗ.ПолучитьЭлементы().Удалить(ПустаяПодСтрока);
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Если Не СтрокаДЗ.ПолучитьЭлементы().Количество() Тогда
		Если Не СтрокаДЗ.Значение = Неопределено Тогда
			//развернули свойства значений
			Если ОписаниеТипов(Выбор.сооТипов,СтрокаДЗ).Типы().Количество()>1 Тогда
				//значение составного типа
				вРазвернутьТипы(СтрокаДЗ,Истина);
			Иначе	
				вРазвернутьСвойства(СтрокаДЗ,Выбор);
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(СтрокаДЗ.Ссылка) ИЛИ ЗначениеЗаполнено(СтрокаДЗ.КэшПредставление)  Тогда
			вРазвернутьСвойства(СтрокаДЗ,Выбор);
		Иначе
			//развернули типы
            вРазвернутьТипы(СтрокаДЗ,Выбор);
		КонецЕсли;
	КонецЕсли;
	Если ПустаяПодСтрока = Неопределено Тогда //только строку удалили, нет смыслка проверять на доступные свойства
		Если Не СтрокаДЗ.ПолучитьЭлементы().Количество() Тогда
			ПроверитьВозможностьСвойств(СтрокаДЗ,Выбор);
		КонецЕсли;	
	КонецЕсли;
	//ИначеЕсли СтрокаДЗ.ПолучитьЭлементы().Количество() И ТипЗнч(СтрокаДЗ.Значение) = Тип("Структура") Тогда  //это вложенные предопределенные структуры
	//	Для Каждого ПодСтрока ИЗ СтрокаДЗ.ПолучитьЭлементы() Цикл
	//		Если ТипЗнч(ПодСтрока.Значение) = Тип("Структура") И Не ПодСтрока.ПолучитьЭлементы().Количество() И ПодСтрока.Значение.Количество() Тогда
	//			//добавим пустую строку чтобы можно было развернуть
	//			ПустаяПодСтрока = ПодСтрока.ПолучитьЭлементы().Добавить();
	//		КонецЕсли;	
	//	КонецЦикла;	
Конецпроцедуры	

//Процедура разворачивает типы значений указанные в строке
//Параметры:
//	Строка 				-<СтрокаДереваЗначений>. Разворачиваемая строка
//	ПриводитьЗначения   -<Булево>. Определяет необходимость приведения значений к типу.
Процедура вРазвернутьТипы(Строка,Выбор,ПриводитьЗначения=Ложь)
	сзОписанияТипов = Новый СписокЗначений;
	Для Каждого Тип ИЗ ОбщийМодульВызовСервера_Ei.ПолучитьМассивТипов(ОписаниеТипов(Выбор.сооТипов,Строка)) Цикл
		Если вТипРазрешен(Выбор.ОграничениеТипа,Тип) Тогда
			Значение 		= ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(Тип);
			сПредставление	= ОбщийМодульЗакрытыйКлиент_Ei.ПолучитьИмяОписанияТипов(Значение); //ПривестиЗначение().Метаданные().Имя; //найти по типу дольше работает
			сзОписанияТипов.Добавить(Значение,сПредставление);
		КонецЕсли;
	КонецЦикла;
	сзОписанияТипов.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
	//сортируем список и только потом добавляем строки
	Для Каждого ЭлСписка ИЗ сзОписанияТипов Цикл
		ПодСтрока	= Строка.ПолучитьЭлементы().Добавить();
		ПодСтрока.Представление = ЭлСписка.Представление;
		ОписаниеТипов(Выбор.сооТипов,ПодСтрока,ЭлСписка.Значение);
		Если ПриводитьЗначения Тогда
			ПодСтрока.Значение	= ОписаниеТипов(Выбор.сооТипов,ПодСтрока).ПривестиЗначение(Строка.Значение);
			Если вОписаниеТиповИмеетСвойства(ОписаниеТипов(Выбор.сооТипов,ПодСтрока)) Тогда
				вРазвернутьСвойства(ПодСтрока,Выбор);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

// Функция полчает соответсвие свойств для строки дерева значений
//
// Параметры:
//  Строка	 - 	СтрокаДереваЗначений- 
// 
// Возвращаемое значение:
//  СписокЗначений - в значениии структура со свойствами ОписаниеТипов, Значение и ДополнениеПредставления
//
Функция вПолучитьСвойства(Строка)
	//СписокСвойств	= Новый СписокЗначений;
	//Если Строка.Значение = Неопределено Тогда
	//	Возврат СписокСвойств;
	//КонецЕсли;
	
	//Расчитываемые
	//Если ЗначениеЗаполнено(Строка.Ссылка) Тогда
	//	//это ссылка во внутренее хранилище
	//	ЗаполнитьСвойствамиСсылкиЗначения(Строка.ПолучитьИдентификатор())
	//ИначеЕсли 	ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки().СодержитТип(ТипЗнч(Строка.Значение)) И 
	//		Не ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки("Перечисления").СодержитТип(ТипЗнч(Строка.Значение))
	//	ИЛИ вЭтоТипОбъекта(ТипЗнч(Строка.Значение)) Тогда
	//	СписокСвойств = ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСвойстваОбъектаМетаданных(Строка.Значение);
	//ИначеЕсли ТипЗнч(Строка.Значение) = Тип("Структура") Тогда
	//	Для Каждого Переменная ИЗ  Строка.Значение Цикл
	//		Если ТипЗнч(Переменная.Значение) = Тип("ФиксированнаяСтруктура") Тогда

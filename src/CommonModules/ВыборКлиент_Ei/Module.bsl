Процедура Развернуть(СтрокаДерева,Выбор) 
	ДанныеСтроки = Выбор.ПараметрыСтроки.Получить(СтрокаДерева.ПолучитьИдентификатор());
	Если ДанныеСтроки <> Неопределено И ДанныеСтроки.Свойство("ГруппаТипов") Тогда
		Если Не ДанныеСтроки.Свойство("ГруппаЗагружена") Тогда
			СписокТипов = ВыборВызовСервера_Ei.СписокСсылочныхТипов(ДанныеСтроки.ГруппаТипов, Выбор.ОграничениеТипа);
			СтрокиГруппы = СтрокаДерева.ПолучитьЭлементы();
			СтрокиГруппы.Очистить();
			Для Каждого ЭлементСписка Из СписокТипов Цикл
				ПодСтрока = СтрокиГруппы.Добавить();
				ПодСтрока.Представление	= ЭлементСписка.Представление;
				ПодСтрока.Имя			= НРег(ПодСтрока.Представление);
				Выбор.ПараметрыСтроки.Вставить(ПодСтрока.ПолучитьИдентификатор(),
					Новый Структура("Значение,ОписаниеТипов,ИмяСсылочногоТипа", Неопределено, Неопределено, ЭлементСписка.Значение));
			КонецЦикла;
			ДанныеСтроки.Вставить("ГруппаЗагружена", Истина);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ВычислитьОтложеннуюПеременную(Выбор, СтрокаДерева);
	УдалилиСтроки = ОбщегоНазначенияКлиент_Ei.УдалитьПустыеСтроки(СтрокаДерева);	
	
	Если Не СтрокаДерева.ПолучитьЭлементы().Количество() Тогда
		ПараметрыСтроки = ПараметрыСтроки(Выбор,СтрокаДерева);
		Если Не ПараметрыСтроки.Значение = Неопределено Тогда
			//развернули свойства значений
			Если ТипЗнч(ПараметрыСтроки.ОписаниеТипов) = Тип("ОписаниеТипов") И ПараметрыСтроки.ОписаниеТипов.Типы().Количество()>1 Тогда
				//значение составного типа
				вРазвернутьТипы(СтрокаДерева,Истина);
			Иначе	
				Если ТипЗнч(ПараметрыСтроки.Значение) = Тип("ОписаниеОповещения") Тогда
					Если НеУдалосьВычислитьЗначениеСтроки(СтрокаДерева,Выбор,Ложь) Тогда //вычислим значение без обновления
						Возврат;			
					КонецЕсли;
				КонецЕсли;			
				вРазвернутьСвойства(СтрокаДерева,Выбор);
			КонецЕсли;
		ИначеЕсли ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ПараметрыСтроки.Значение) Тогда// ЗначениеЗаполнено(СтрокаДерева.Ссылка) ИЛИ ЗначениеЗаполнено(СтрокаДерева.КэшПредставление)  Тогда
			вРазвернутьСвойства(СтрокаДерева,Выбор);						
		Иначе
			//развернули типы
            вРазвернутьТипы(СтрокаДерева,Выбор);
		КонецЕсли;
	КонецЕсли;
	Если Не УдалилиСтроки Тогда //только строку удалили, нет смыслка проверять на доступные свойства
		Если Не СтрокаДерева.ПолучитьЭлементы().Количество() Тогда
			ПроверитьВозможностьСвойств(СтрокаДерева,Выбор);
		КонецЕсли;	
	КонецЕсли;
Конецпроцедуры	

//Процедура разворачивает типы значений указанные в строке
//Параметры:
//	Строка 				- ДанныеФормыЭлементДерева - Разворачиваемая строка
//	Выбор				- см. ПолучитьВыбор 	
//	ПриводитьЗначения   - Булево - Определяет необходимость приведения значений к типу.
Процедура вРазвернутьТипы(Строка, Выбор, ПриводитьЗначения=Ложь)
	ОписанияТипов = Новый СписокЗначений;
	//непонятно зачем идем через массив типов хотя есть описание типов, под переделку когда займемся скоростью разворачивания типов
	Для Каждого Тип ИЗ ПараметрыСтроки(Выбор,Строка).ОписаниеТипов.Типы() Цикл
		Если вТипРазрешен(Выбор.ОграничениеТипа,Тип) Тогда
			Значение 		= ТипыКлиентСервер_Ei.СоздатьОписаниеИзКолекции(Тип);
			сПредставление	= ТипыКлиентСервер_Ei.ПолучитьИмяОписанияТипов(Значение); //ПривестиЗначение().Метаданные().Имя; //найти по типу дольше работает
			ОписанияТипов.Добавить(Значение,сПредставление);
		КонецЕсли;
	КонецЦикла;
	ОписанияТипов.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
	//сортируем список и только потом добавляем строки
	Для Каждого ЭлСписка ИЗ ОписанияТипов Цикл
		ПодСтрока	= Строка.ПолучитьЭлементы().Добавить();
		ПодСтрока.Представление = ЭлСписка.Представление;
		ПараметрыСтроки(Выбор,ПодСтрока,,ЭлСписка.Значение);
		Если ПриводитьЗначения Тогда
			ПодСтрока.Значение	= ПараметрыСтроки(Выбор,ПодСтрока).ОписаниеТипов.ПривестиЗначение(Строка.Значение);
			Если вОписаниеТиповИмеетСвойства(ПараметрыСтроки(Выбор,ПодСтрока).ОписаниеТипов) Тогда
				вРазвернутьСвойства(ПодСтрока,Выбор);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры


#КонецОбласти

//Открываем все что можем показать в ТЗ, кроме ссылок и строк
//
Функция ЗначениеОткрыватьВКоллекции(ОписаниеИлиЗначения)
	Результат = Ложь;
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ОписаниеИлиЗначения) Тогда
		Если Не ОписаниеИлиЗначения.ОписаниеТипов = ТипыКлиентСервер_Ei.Универсальные().Строка Тогда
			Свойства  = РезультатТаблицаКлиентСервер_Ei.Свойства();
			Результат = (Свойства.ТипРеквизита = ОписаниеИлиЗначения.ОписаниеТипов ИЛИ Не Свойства.Типы.Найти(ОписаниеИлиЗначения.ОписаниеТипов) = Неопределено);
		КонецЕсли;
	Иначе
		Если ТипыКлиентСерверПовтИсп_Ei.ОписаниеПримитивных().СодержитТип(ТипЗнч(ОписаниеИлиЗначения)) Тогда
			//тут ничего неделаем 
		ИначеЕсли ТипыКлиентСервер_Ei.ЭтоСсылка(ТипЗнч(ОписаниеИлиЗначения)) Тогда
			//тут ничего неделаем 		
		ИначеЕсли Не РезультатТаблицаКлиентСервер_Ei.Свойства().Типы.Найти(ОбщегоНазначенияКлиентСервер_Ei.ПолучитьИмяТипЗнч(ТипЗнч(ОписаниеИлиЗначения))) = Неопределено	Тогда
			//Если находим в массиве преобразований то запускаем процедуру приведения
			Результат = Истина;
		КонецЕсли;					
	КонецЕсли;
	Возврат Результат; 
КонецФункции				

// Копия значения, которую можно передать на сервер, например параметром формы.
// Значения без преобразования в XDTO (ОписаниеОповещения, форма, общий модуль) с клиента на сервер не передаются,
// в копии они заменены представлением. Тип коллекции, в том числе фиксированной, сохраняется.
//
// Параметры:
//  Значение - Произвольный - значение или коллекция на клиенте
//
// Возвращаемое значение:
//  Произвольный - копия значения
//
Функция ЗначениеДляСервера(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого КлючИЗначение Из Значение Цикл
			Результат.Вставить(КлючИЗначение.Ключ, ЗначениеДляСервера(КлючИЗначение.Значение));
		КонецЦикла;
		Если ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
			Результат = Новый ФиксированнаяСтруктура(Результат);
		КонецЕсли;
	ИначеЕсли ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого КлючИЗначение Из Значение Цикл
			Результат.Вставить(ЗначениеДляСервера(КлючИЗначение.Ключ), ЗначениеДляСервера(КлючИЗначение.Значение));
		КонецЦикла;
		Если ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
			Результат = Новый ФиксированноеСоответствие(Результат);
		КонецЕсли;
	ИначеЕсли ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ЗначениеДляСервера(Элемент));
		КонецЦикла;
		Если ТипЗначения = Тип("ФиксированныйМассив") Тогда
			Результат = Новый ФиксированныйМассив(Результат);
		КонецЕсли;
	ИначеЕсли ТипЗначения = Тип("СписокЗначений") Тогда
		Результат = Новый СписокЗначений;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ЗначениеДляСервера(Элемент.Значение), Элемент.Представление, Элемент.Пометка, Элемент.Картинка);
		КонецЦикла;
	ИначеЕсли ТипыКлиентСерверПовтИсп_Ei.ОписаниеПримитивных().СодержитТип(ТипЗначения)
		Или ТипыКлиентСервер_Ei.ЭтоСсылка(ТипЗначения) Тогда
		Результат = Значение;
	Иначе
		Попытка
			СериализаторXDTO.ЗаписатьXDTO(Значение);
			Результат = Значение;
		Исключение
			Результат = ОписаниеЗначенияКлиентСервер_Ei.ПолучитьПредставлениеПростогоЗнач(Значение, Истина);
		КонецПопытки;
	КонецЕсли;
	Возврат Результат;
КонецФункции
#КонецОбласти

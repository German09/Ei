// Функция определет является ли текущее описание коллекцией с возможностью получения по индексу
//
// Параметры:
//  Тип	 - ОписаниеТипов - Исходное описание которое нужно проверить
// 
// Возвращаемое значение:
//   - Булево
//
Функция ПолучениеПоИндексу(ТД,Выбор)
	Если Не ТД.ОбъемКоллекции = Неопределено Тогда 
		Результат = Истина;
	Иначе
		ОписаниеТипов	= ПараметрыСтроки(Выбор,ТД).ОписаниеТипов;
		Результат		= ТипыКлиентСервер_Ei.ОписанияПересекаются(ОписаниеТипов,ТипыКлиентСервер_Ei.Коллекция());
	КонецЕсли;	
	Возврат Результат;
КонецФункции

// Получает путь к выбранной переменной, перебро всех родителей через "." и вставка аргумента
// 
// Параметры:
//  Строка - ДанныеФормыЭлементДерева - Строка дерева типов
// 
// Возвращаемое значение:
//  Строка - В получить путь к переменной
Функция вПолучитьПутьКПеременной(Строка)
	Если ТипЗнч(Строка) = Тип("ДанныеФормыЭлементДерева") Тогда
		Если  Строка.ПолучитьРодителя() = Неопределено Тогда
			ПутьКпеременной	= ?(ПустаяСтрока(Строка.Имя),"",Строка.Представление);
		Иначе
			Родитель 		= Строка.ПолучитьРодителя();
			Приставка		= вПолучитьПутьКПеременной(Родитель);
			Если СтрНайти(Родитель.Представление,ПризнакАргумента()) Тогда
				//Параметр внутри функции укажем, в значении с большой долей вероятности ОписаниеОповещения
				Аргумент = Строка.Представление;
				Если Не ОбщегоНазначенияКлиентСервер_Ei.ВозможностьКлючСтруктуры(Строка.Представление) Тогда
					//это получение из соответсвия уберем лишнее, и по плану должна остаться только навигационная ссылка из избранного или истории
					Для Каждого Лишнее Из СтрРазделить(ВыборКлиентСервер_Ei.ОберткаОбращенияСоответствия(),"%1") Цикл
						Аргумент = СтрЗаменить(Аргумент,Лишнее,"");
					КонецЦикла;	
				КонецЕсли;
				ПутьКпеременной	= СтрЗаменить(Приставка,Родитель.Представление,СтрЗаменить(Родитель.Представление,ПризнакАргумента(),СтрШаблон("""%1""",Аргумент)));		 	
			Иначе	
				ПутьКпеременной	= Приставка+"."+Строка.Представление;
			КонецЕсли;	 				
		КонецЕсли;
	Иначе
		ПутьКпеременной		= "";
	КонецЕсли;
	СоотвесвтиеЗамены = Новый Соответствие;
	СоотвесвтиеЗамены.Вставить("..",".");
	СоотвесвтиеЗамены.Вставить(".[","[");
	Возврат ОбщегоНазначенияКлиентСервер_Ei.СтрЗаменитьИзСписка(ПутьКпеременной,СоотвесвтиеЗамены);
КонецФункции
	
	 

// Функция - Вычислить значение строки
//
// Параметры:
//  ТекущиеДанные	- ДанныеФормыЭлементДерева	 - Строка дерева значений представление для которой необходмо вычислить
//  Выбор	        см. ПолучитьВыбор 
//  Обновлять		- Булево	   
// 
// Возвращаемое значение:
//   Булево - Ложь - значение успешно вычислено и заполнено в строке, Истина - значение не смогли вычислить
//
Функция НеУдалосьВычислитьЗначениеСтроки(ТекущиеДанные, Выбор, Обновлять = Истина) 
	Отказ 		= Ложь;
	Выражение  	= вПолучитьПутьКПеременной(ТекущиеДанные);
	//ЗаполнитьЗначенияСвойств(Выбор.Переменные,Выбор.ДоступныеСтруктуры);
	Попытка
		Значение		= ВыполнитьКлиентСервер_Ei.Выражение(Выражение);//,,,Выбор.ДоступныеСтруктуры);
	Исключение
	    Отказ = Истина;
	КонецПопытки;
	Если Не Отказ Тогда
		ПараметрыСтроки(Выбор,ТекущиеДанные,Значение);	
		Если Обновлять Тогда
			ТекущиеДанные.ПолучитьЭлементы().Очистить();
			ПроверитьВозможностьСвойств(ТекущиеДанные,Выбор);
		КонецЕсли;	
	КонецЕсли;
	Возврат Отказ;
КонецФункции


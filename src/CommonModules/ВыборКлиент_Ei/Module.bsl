		Отказ = Не Элемент.ТекущиеДанные.ВведенВручную;
	Иначе 
		Отказ = Истина;
	КонецЕсли;	
КонецПроцедуры

// Закрываем форму, а выбранное значение передаем в ТекущиеДанные
// 
// Параметры:
//  Форма 			см. ОбщаяФорма.Выбор_Ei
//  Выбор			- см. ПолучитьВыбор
//  Элемент 		- ТаблицаФормы
//  ВыбраннаяСтрока - Число
//  Поле 			- ПолеФормы
//  СтандартнаяОбработка - Булево
Процедура ДеревоЗначенийВыбор(Форма, Выбор, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) Экспорт
	СтрокаДЗ = Форма.ДеревоВыбора.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Не СтрокаДЗ = Неопределено Тогда
		ВычислитьОтложеннуюПеременную(Выбор, СтрокаДЗ);
		ЭлементФормыПредставления	= Форма.Элементы.ДеревоВыбора_Представление;
		ПараметрыСтроки				= ПараметрыСтроки(Выбор,СтрокаДЗ);
		Если ТипЗнч(ПараметрыСтроки.Значение) = Тип("ФормаКлиентскогоПриложения") Тогда
			ПараметрыСтроки.Значение.Активизировать();			
		ИначеЕсли Не Поле = ЭлементФормыПредставления И ЗначениеЗаполнено(ПараметрыСтроки.Значение) Тогда
			//шелкнули 2 раза по не пустому значению 
			Если ЗначениеОткрыватьВКоллекции(ПараметрыСтроки.Значение) Тогда
				ПараметрыФормы = Новый Структура("ОписаниеЗначения", ЗначениеДляСервера(ПараметрыСтроки.Значение));
				ОткрытьФорму("ОбщаяФорма.Коллекция_Ei",ПараметрыФормы,Форма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			Иначе	
				ОбщегоНазначенияКлиент_Ei.ПоказатьЗначениеРасш(Форма,ПараметрыСтроки.Значение);				
			КонецЕсли;	
		Иначе
			Если вТипРазрешен(Выбор.ОграничениеТипа,ПараметрыСтроки.ОписаниеТипов) Тогда
				Если Не ПараметрыСтроки.Значение = Неопределено Тогда //ИЛИ ЗначениеЗаполнено(СтрокаДЗ.Ссылка) ИЛИ ЗначениеЗаполнено(СтрокаДЗ.КэшПредставление) Тогда
					//выбрали доступную переменную
					ПараметрыСтроки	= ПараметрыСтроки(Выбор,СтрокаДЗ);
					СтруктураВыбора =  Выбор.ТекущиеДанные;
					СтруктураВыбора.Вставить("Значение",ПараметрыСтроки.Значение); //дополним возвращаемую структуру Вычисленным описанием значения, для использования в выборе возвращаемых значений Jбработок
					СтруктураВыбора.ЗначениеПараметра 	= вПолучитьПутьКПеременной(СтрокаДЗ);
					СтруктураВыбора.ЭтоВыражение 		= Истина;
					ОкончаниеВыбора(Форма, Выбор);//,СтруктураВыбора);
				Иначе
					//просто выбрали тип
					Если Не ПараметрыСтроки.ОписаниеТипов = Неопределено Тогда
						Если ПараметрыСтроки.ОписаниеТипов.Типы().Количество() Тогда
							//ЭлементУправления.ОграничениеТипа 	= СтрокаДЗ.ОписаниеТипов;
							Выбор.ТекущиеДанные.ЗначениеПараметра 	= ПараметрыСтроки.ОписаниеТипов.ПривестиЗначение();
							//ЭлементУправления.ВыбиратьТип 			= Ложь;
							Выбор.ТекущиеДанные.ЭтоВыражение		= Ложь;
							ОкончаниеВыбора(Форма, Выбор);//,Выбор.ТекущиеДанные);
						КонецЕсли;	
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

// Функция - получает свойства/функции переденного значения
//
// Параметры:
//  Значение				 - Произвольный	 - переданное значение 
//  УникальныйИдентификатор	 - УникальныйИдентификатор	 -  Адрес для формирования описания значения
// 
// Возвращаемое значение:
//   Соответствие из Произвольный - или описаний значений
//   Неопределено 
//
Функция ПолучитьСвойстваЗначения(Знач Значение, УникальныйИдентификатор) Экспорт
	ЛюбойКлюч				= " ";
	Ключи 					= Новый Соответствие();
	Результат 				= Новый СписокЗначений;
	Тип						= ТипЗнч(Значение); 
	Если Тип = Тип("ФормаКлиентскогоПриложения") Тогда
		Результат.Добавить(Значение.ИмяФормы,				"ИмяФормы");
		Результат.Добавить(Значение.УникальныйИдентификатор,"УникальныйИдентификатор");
		Результат.Добавить(Значение.ПодчиненныеЭлементы,	"ПодчиненныеЭлементы");
		Ключи.Вставить(ЛюбойКлюч,Результат);
	ИначеЕсли Тип = Тип("FormItems") ИЛИ Тип = Тип("Controls") Тогда //Тип("ЭлементыФормы") будет как Тип("Controls")
		Для Каждого Элемент ИЗ Значение Цикл
			Результат.Добавить(Элемент, Элемент.Имя);		
		КонецЦикла;	
		Ключи.Вставить(ЛюбойКлюч,Результат);
	ИначеЕсли Не ТипыКлиентСервер_Ei.ЭлементыФормы().Найти(Тип) = Неопределено Тогда
		Для Каждого Свойство ИЗ НаследованиеФормКлиентСервер_Ei.ПолучитьСвойства(Значение) Цикл
			Попытка 
				Результат.Добавить(Значение[Свойство],	Свойство);
			Исключение
				НаследованиеФормКлиентСервер_Ei.ОбработкаОшибкиПолученияСвойства(Значение,Свойство);			
			КонецПопытки;			
		КонецЦикла;
		Если 	Не Тип =Тип("ПолеФормы")И 
				Не Тип =Тип("КнопкаФормы") Тогда
			Результат.Добавить(Значение.ПодчиненныеЭлементы,	"ПодчиненныеЭлементы");
		КонецЕсли;
		Ключи.Вставить(ЛюбойКлюч,Результат);
	Иначе
		ВыборКлиентСервер_Ei.ДополнитьСвойстваЗначения(Значение, Тип, Результат, ЛюбойКлюч, Ключи);	
	КонецЕсли;
	Если Не Ключи.Количество() Тогда
		//если нет ни одного значения возвращаем Неопределено
		Ключи = Неопределено;
	КонецЕсли;	
	Возврат Ключи;
КонецФункции

Процедура ДеревоВыбораНачалоПеретаскивания(Форма, Выбор, Элемент, ПараметрыПеретаскивания, Выполнение)  Экспорт
	Строка = Форма.ДеревоВыбора.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение);
	Если Не Строка = Неопределено Тогда
		сз = Новый СписокЗначений;
		Выражение = вПолучитьПутьКПеременной(Строка);
		сз.Добавить(Выражение,Выражение);  //Вмемсто 'Строка.Значение' пишем 'Выражение' и тогда по умолчанию будет становится оно, для перетаскивания из этой формы так лучше, всегда можно пересчитать если снять флаэок "Этовыражение" 
		ПеретаскиваниеКлиент_Ei.НачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение, сз);
	КонецЕсли;	
КонецПроцедуры


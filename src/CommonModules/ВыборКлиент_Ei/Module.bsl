#Область СлужебныеПроцедурыИФункции
Асинх Процедура ВыбратьФайлы(Выбор, ВладелецФормы)
	Файл 	= Новый Файл(Выбор.ТекущиеДанные.ЗначениеПараметра);
	Длг 	= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Если ЗначениеЗаполнено(Файл.ПолноеИмя) Тогда
		Если Ждать Файл.СуществуетАсинх() Тогда				
			Длг.ПолноеИмяФайла 		= Файл.ПолноеИмя;
		КонецЕсли;	
	КонецЕсли;
	Длг.Заголовок 			= "Укажите путь к файлу или папке";
	Длг.Фильтр 				= "Все файлы (*.*)|*.*";
	Длг.МножественныйВыбор	= Истина; 
	ВыбранныеФайлы = Ждать Длг.ВыбратьАсинх();
	Если Не ВыбранныеФайлы = Неопределено Тогда
		ВыбранноеЗначение =  Неопределено;
		Если ВыбранныеФайлы.Количество() > 1 Тогда
			СписокНовый = Новый СписокЗначений;
			СписокНовый.ЗагрузитьЗначения(ВыбранныеФайлы);
			ВыбранноеЗначение = СписокНовый;
		Иначе	
			Для Каждого сИмяФайла ИЗ ВыбранныеФайлы	Цикл
				ВыбранноеЗначение = сИмяФайла;
			КонецЦикла;
		КонецЕсли;	
		Если Не ВыбранноеЗначение =  Неопределено Тогда
			//дозаполним структуру так чтобы ее могла правильно исполнить обработка выбора
			Выбор.ТекущиеДанные.ЗначениеПараметра = ВыбранноеЗначение; 
			ОкончаниеВыбора(ВладелецФормы, Выбор);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры



// Вызывается при финальном выборе значения
//
// Параметры:
//  Форма	 см. ОбщаяФорма.Выбор_Ei  
//  Выбор	 - Структура - Вспомогательная структура, экспортная переменная в см. ОбщаяФорма.Выбор_Ei
//
Процедура ОкончаниеВыбора(Форма,Выбор)
	Если Не Выбор.ЗавершениеВыбора =  Неопределено Тогда
		ВыполнитьОбработкуОповещения(Выбор.ЗавершениеВыбора,Выбор.ТекущиеДанные);
	КонецЕсли;	
	Выбор	= Новый Структура;
	ЗакрытьВыбор(Форма);
КонецПроцедуры

Функция ПризнакАргумента()
	Возврат Символы.НПП;
КонецФункции

#Область ОбщегоНазначения

//Отображает окно или элемент выбора типа/значения
//Параметры:
//  Выбор				- Структура	- Вспомогательная структура описана в общей форме Выбор_Ei, экспортная переменная
//  ВладелецФормы		- Форма		- Элемент в котором произведен выбор
//  ОткрыватьМодально	- Булево	- Признак окрытия в модальном режиме если Истина, то происходит модальный выбор из предопределенной формы
//  ПоддержкаЯзыка		- Булево	- Признак поддержки встроенного языка
//  Заголовок			- Строка
//
Процедура Показать(Выбор, ВладелецФормы, ОткрыватьМодально, ПоддержкаЯзыка, Заголовок = "Выбор типа")
	Если ОткрыватьМодально Тогда
		//открываем модально
		РежимОткрытияОкна											= РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ФормаВыбора													= ОткрытьФорму(ИмяМодальнойФормы(),,ВладелецФормы,,,,,РежимОткрытияОкна);
		ФормаВыбора.Выбор											= Выбор;
		ФормаВыбора.Заголовок										= Заголовок;
		ФормаВыбора.Элементы.ДеревоВыбора.АвтоМаксимальнаяШирина	= Истина;
	Иначе
		ФормаВыбора = ВладелецФормы;
	КонецЕсли;
	Выбор.Вставить("Форма",ФормаВыбора);
	ИзменитьВидимость(ФормаВыбора,Истина); //покажем, очень важно для немодального режима, но и в модальном проверить не помешает
	ФормаВыбора.Элементы.ДеревоВыбора_КомПанель.Видимость 	= Не ОткрыватьМодально;
	ФормаВыбора.Элементы.ДеревоВыбора_Путь.Видимость 		= ПоддержкаЯзыка;
	ФормаВыбора.ДеревоВыбора.ПолучитьЭлементы().Очистить();
	ФормаВыбора.ДеревоВыбора_Путь = "";
	Если ОткрыватьМодально Или КонструкторКлиент_Ei.ЭтоОсновнаяФормаEi(ФормаВыбора.ИмяФормы) Тогда
		Выбор.Вставить("ОжидаетЗагрузкиДерева", Истина);
		ФормаВыбора.ПодключитьОбработчикОжидания("ЗагрузитьДеревоВыбора", 0.1, Истина);
	Иначе
		ИнициализацияВыбора(ФормаВыбора, Выбор);
	КонецЕсли;
КонецПроцедуры

// Заполняет дерево после показа формы. Обработчик берет текущий сеанс выбора из формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма с деревом выбора.
//  Выбор - см. ПолучитьВыбор
Процедура ЗагрузитьДеревоВыбора(Форма, Выбор) Экспорт
	Если ТипЗнч(Выбор) <> Тип("Структура") Или Не Выбор.Свойство("ОжидаетЗагрузкиДерева") Тогда
		Возврат;
	КонецЕсли;
	Выбор.Удалить("ОжидаетЗагрузкиДерева");
	Если Форма.Элементы.ДеревоВыбора.Родитель.Видимость Тогда
		ИнициализацияВыбора(Форма, Выбор);
	КонецЕсли;
КонецПроцедуры


//Производит инициализацию формы выбора
//Параметры:
//  Форма	 см. ОбщаяФорма.Выбор_Ei 
//  Выбор	 - Структура - Вспомогательная структура описана в общей форме Выбор_Ei, экспортная переменная
//
Процедура ИнициализацияВыбора(Форма, Выбор)
	ДеревоВыбора = Форма.ДеревоВыбора;
	КэшПользователяКлиентСерверПовтИсп_Ei.Значения().Очистить();
	Выбор.ПараметрыСтроки.Очистить();
	
	вЗаполнитьДеревоДоступнымиПеременными(Выбор,ДеревоВыбора);
	 
	Если Не Выбор.ТекущиеДанные.ЭтоВыражение Тогда
		//Доступные типы
		СписокТипов = ВыборВызовСервераПовтИсп_Ei.СписокТиповВыбора();
		Для Каждого ЭлементСЗ  ИЗ СписокТипов Цикл
			Если ЗначениеЗаполнено(ЭлементСЗ.Значение) И вТипРазрешен(Выбор.ОграничениеТипа,ЭлементСЗ.Значение) Тогда
				НоваяСтрока	= ДеревоВыбора.ПолучитьЭлементы().Добавить();
				НоваяСтрока.Представление	= ЭлементСЗ.Представление;
				Если  ЭлементСЗ.Пометка Тогда
					ПараметрыСтроки(Выбор,НоваяСтрока,,Новый ОписаниеТипов);
					Выбор.ПараметрыСтроки.Получить(НоваяСтрока.ПолучитьИдентификатор()).Вставить("ГруппаТипов",ЭлементСЗ.Значение);
					//добавлем подстроку чтобы можно было развернуть
					НоваяСтрока.ПолучитьЭлементы().Добавить();
				Иначе
					ПараметрыСтроки(Выбор,НоваяСтрока,,ЭлементСЗ.Значение);
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
	ВыборВыражения(Форма, Выбор);
КонецПроцедуры



// Создает корневые строки доступных переменных.
//
// Параметры:
//  Выбор - см. ПолучитьВыбор
//  ДеревоВыбора - ДанныеФормыДерево - Дерево выбора.
Процедура вЗаполнитьДеревоДоступнымиПеременными(Выбор, ДеревоВыбора)
	Если ТипЗнч(Выбор.ДоступныеСтруктуры) = Тип("Структура") Тогда
		Для Каждого Переменная Из Выбор.ДоступныеСтруктуры Цикл
			ДобавитьСтрокуПеременной(Выбор, ДеревоВыбора.ПолучитьЭлементы(), Переменная.Ключ, Переменная.Значение);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Добавляет строку переменной и оставляет дочерние строки до раскрытия ветки.
//
// Параметры:
//  Выбор - см. ПолучитьВыбор
//  Строки - ДанныеФормыКоллекцияЭлементовДерева - Коллекция, в которую добавляется строка.
//  Имя - Строка - Имя переменной.
//  Значение - Произвольный - Значение или оповещение для его получения.
Процедура ДобавитьСтрокуПеременной(Выбор, Строки, Имя, Значение)
	СтрокаДерева = Строки.Добавить();
	СтрокаДерева.Представление = Имя;
	Если ТипЗнч(Значение) = Тип("ОписаниеОповещения") Тогда
		СтрокаДерева.Представление	= Имя + Значение.ДополнительныеПараметры.Аргументы;
		СтрокаДерева.Имя			= НРег(СтрокаДерева.Представление);
		Выбор.ПараметрыСтроки.Вставить(СтрокаДерева.ПолучитьИдентификатор(),
			Новый Структура("Значение,ОписаниеТипов,ИмяОтложеннойПеременной", Значение, Новый ОписаниеТипов, Имя));
		СтрокаДерева.ПолучитьЭлементы().Добавить();
	Иначе
		ПараметрыСтроки(Выбор, СтрокаДерева, Значение);
		ПроверитьВозможностьСвойств(СтрокаДерева, Выбор);
	КонецЕсли;
КонецПроцедуры

// Вычисляет переменную при раскрытии или выборе ее строки.
//
// Параметры:
//  Выбор - см. ПолучитьВыбор
//  СтрокаДерева - ДанныеФормыЭлементДерева - Строка переменной.
Процедура ВычислитьОтложеннуюПеременную(Выбор, СтрокаДерева)
	ДанныеСтроки = Выбор.ПараметрыСтроки.Получить(СтрокаДерева.ПолучитьИдентификатор());
	Если ДанныеСтроки <> Неопределено И ДанныеСтроки.Свойство("ИмяОтложеннойПеременной") Тогда
		ПредставлениеДоВычисления = СтрокаДерева.Представление;
		СтрокаДерева.Представление = ДанныеСтроки.ИмяОтложеннойПеременной;
		Попытка
			ПараметрыСтроки(Выбор, СтрокаДерева, ДанныеСтроки.Значение);
		Исключение
			СтрокаДерева.Представление = ПредставлениеДоВычисления;
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

//Функция проверят разрешен ли к использованию в этой форме данное описание типов(тип)
//Параметры:
//	ОграничениеТипа - ОписаниеТипов
//	ОписаниеТипов	- ОписаниеТипов,Тип,Строка - Объект, который нужно проверить, строка - имя группы ссылочных типов
//Возвращаемое значение:
//	Булево	
Функция вТипРазрешен(ОграничениеТипа,ОписаниеТипов)
	Результат = Истина;
	Если ЗначениеЗаполнено(ОграничениеТипа) Тогда
		Если ТипЗнч(ОписаниеТипов) = Тип("ОписаниеТипов") Тогда
			//Если ОписаниеТипов.Типы().Количество()=0 Тогда
				//Возврат Истина; //неопределенный тип возможен только при загрузке из внешних источников, разрешим надеясь что пользователь понимает что делает не хрена не понятно даже я облажался с номером
			//Иначе	
			Результат = ТипыКлиентСервер_Ei.ОписанияПересекаются(ОграничениеТипа,ОписаниеТипов);		
		ИначеЕсли ТипЗнч(ОписаниеТипов) = Тип("Тип") Тогда
			Результат =  ОграничениеТипа.СодержитТип(ОписаниеТипов);
		ИначеЕсли ТипЗнч(ОписаниеТипов) = Тип("Строка") Тогда
			Результат = ВыборВызовСервера_Ei.СписокСсылочныхТипов(ОписаниеТипов, ОграничениеТипа).Количество() > 0;
		Иначе
			Результат =  Ложь;
		КонецЕсли;		
	КонецЕсли;
	Возврат Результат;		
КонецФункции


//Процедура разворачивает свойства значения указанного в строке
//Параметры:
//	Строка 	- ДанныеФормыЭлементДерева - Разворачиваемая строка
//	Выбор	- см. ПолучитьВыбор 
Процедура вРазвернутьСвойства(Строка,Выбор)
	Перем СооСвойства;
	ЗначениеСтроки 	= ПараметрыСтроки(Выбор,Строка).Значение;
	ЭтоСсылка		= ТипыКлиентСервер_Ei.ЭтоСсылка(ТипЗнч(ЗначениеСтроки)) И 
						Не ТипыКлиентСервер_Ei.ЭтоСсылка(ТипЗнч(ЗначениеСтроки),"Перечисления")
						ИЛИ вЭтоТипОбъекта(ТипЗнч(ЗначениеСтроки));
	Если ЭтоСсылка Тогда
		Для Каждого ЭлСписка ИЗ ОбщегоНазначенияКлиентСервер_Ei.ПолучитьСвойстваОбъектаМетаданных(ЗначениеСтроки,Выбор.Форма.УникальныйИдентификатор) Цикл
			ПодСтрока=Строка.ПолучитьЭлементы().Добавить();
			ПодСтрока.Представление	= ЭлСписка.Представление;
			ПараметрыСтроки(Выбор,ПодСтрока,ЭлСписка.Значение);//ДозаполнитьСтрокуДерева(ПодСтрока,ЭлСписка.Значение,Выбор);
			ПроверитьВозможностьСвойств(ПодСтрока,Выбор);
		КонецЦикла;
	ИначеЕсли 	ТипЗнч(ЗначениеСтроки) 	= Тип("Структура") ИЛИ  
				(ТипЗнч(ЗначениеСтроки) = Тип("ФиксированнаяСтруктура") И Не ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ЗначениеСтроки)) Тогда
		Для Каждого Переменная ИЗ  ЗначениеСтроки Цикл
			ЗначениеСвойства 		= Переменная.Значение;  //пока так
			Если Переменная.Ключ = ОбщегоНазначенияКлиент_Ei.ИмяКлючаКартинки() Тогда
				//это предопределенное свойство, тут просто установим картинку строки
				Строка.СсылкаНаКартинку = ЗначениеСвойства;
			Иначе	
				ДобавитьСтрокуПеременной(Выбор, Строка.ПолучитьЭлементы(), Переменная.Ключ, ЗначениеСвойства);
			КонецЕсли;	
		КонецЦикла;
	ИначеЕсли Не ТипЗнч(ЗначениеСтроки) = Тип("ОписаниеОповещения") Тогда
		//вначале пробуем развернуть на клиенте
		СооСвойства = ПолучитьСвойстваЗначения(ЗначениеСтроки,Выбор.Форма.УникальныйИдентификатор);
		Если СооСвойства = Неопределено Тогда
			//Попробуем развернуть если это значение возможно передать на сервер
			Попытка
				СооСвойства = ВыборВызовСервера_Ei.ПолучитьСвойстваЗначения(ЗначениеСтроки,Выбор.Форма.УникальныйИдентификатор);
			Исключение
				вРазвернутьПоИндексу(Строка, Выбор)
			КонецПопытки;
		КонецЕсли;
		Если Не СооСвойства = Неопределено Тогда
			Для Каждого соо из СооСвойства Цикл
				Строка.СсылкаНаКартинкуЗначения = соо.Ключ;
				Для Каждого ЭлСписка ИЗ соо.Значение Цикл
					ПодСтрока = Строка.ПолучитьЭлементы().Добавить();
					ПодСтрока.Представление	= ЭлСписка.Представление;
					ПараметрыСтроки(Выбор,ПодСтрока,ЭлСписка.Значение);//ДозаполнитьСтрокуДерева(ПодСтрока,ЭлСписка.Значение,Выбор);
					ПроверитьВозможностьСвойств(ПодСтрока,Выбор);
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;						
	КонецЕсли;
	вРазвернутьПоИндексу(Строка, Выбор);
КонецПроцедуры

//Процедура разворачивает свойства значения указанного в строке
//Параметры:
//	Строка 	- ДанныеФормыЭлементДерева - Разворачиваемая строка
//	Выбор	- см. ПолучитьВыбор 
Процедура вРазвернутьПоИндексу(Строка, Выбор)
	Перем МаксЭлКоллекцииСтрока;
	Если ПолучениеПоИндексу(Строка,Выбор) Тогда
		Если Строка.ОбъемКоллекции =  Неопределено Тогда
			//Строка.ОбъемКоллекции = 0;
			Попытка
				Строка.ОбъемКоллекции	= ВыполнитьКлиентСервер_Ei.Выражение(вПолучитьПутьКПеременной(Строка)+".Количество()",,Новый ОписаниеТипов("Число"),Выбор.ДоступныеСтруктуры,Ложь);
			Исключение
				Строка.ОбъемКоллекции 	= 0;
			КонецПопытки;
		КонецЕсли;	
		Если Строка.ОбъемКоллекции Тогда
			//покажем последние 10 начиная с последнего
			Для Ном = (Строка.ОбъемКоллекции-1)*-1 По Мин(0,(Строка.ОбъемКоллекции-10)*-1) Цикл
				МаксЭлКоллекцииСтрока	= Строка.ПолучитьЭлементы().Добавить();
				МаксЭлКоллекцииСтрока.Представление = СтрШаблон("[%1]",Формат(Ном*-1,"ЧН=0; ЧГ="));
				МаксЭлКоллекцииСтрока.ВведенВручную = Истина;
				Если НеУдалосьВычислитьЗначениеСтроки(МаксЭлКоллекцииСтрока,Выбор) Тогда
					Строка.ПолучитьЭлементы().Удалить(МаксЭлКоллекцииСтрока);	
				Конецесли;
			КонецЦикла		
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры


// Процедура - Добавляет специальные строки которые способствует дальнейшему разворачиванию дерева
//
// Параметры:
//  ПодСтрока	 - ДанныеФормыЭлементДерева	 - Строка в которую планируеться добавлять специальные строки
//
Процедура ПроверитьВозможностьСвойств(ПодСтрока,Выбор)
	Если Не ЭтоПримитивноеЗначение(Выбор,ПодСтрока) Тогда
		Если Выбор.Форма.Элементы.ДеревоВыбора.Развернут(ПодСтрока.ПолучитьИдентификатор()) = Истина Тогда //почему то может иногда возвращать неопределено
			Развернуть(ПодСтрока,Выбор);
		Иначе	
			ПодСтрока.ПолучитьЭлементы().Добавить();
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

// Функция - Определяет является ли хранимое в строке значение примитивным
//
// Параметры:
//  Выбор		- Структура	 - 
//  Строка	 	- ДанныеФормыЭлементДерева	 - Строка для которой выполняется определение
// 
// Возвращаемое значение:
//   Булево 
//
Функция ЭтоПримитивноеЗначение(Выбор,Строка)
	Результат = Ложь;
	ОписаниеТипов = ПараметрыСтроки(Выбор,Строка).ОписаниеТипов;
	Если ТипЗнч(ОписаниеТипов) = Тип("ОписаниеТипов") Тогда	
		//вытчтим из исходного описания типов все примитивные если что то осталось то тогда это не примитивное описание типов
		ВрОписаниеТипов = Новый ОписаниеТипов(ОписаниеТипов,,ТипыКлиентСервер_Ei.Примитивные());
		Результат = (ВрОписаниеТипов.Типы().Количество() = 0); 
	Иначе
		//этот тип недоступен на клиенте значит точно не является примитивным		
	КонецЕсли;	
	Возврат Результат;	
Конецфункции	


//
Процедура ДеревоЗначенийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр) Экспорт
	Если Копирование Тогда
		Отказ = Не Элемент.ТекущиеДанные.ВведенВручную;
	Иначе
		Отказ = (Элемент.ТекущиеДанные = Неопределено);

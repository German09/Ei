
#Область ПрограммныйИнтерфейс

// Вызывается при начале выборе типа или значения
// Процедуру нельзя делать АСИНХ поскольку есть возвр параметры
//
// Параметры:
//	ЗавершениеВыбора	 - ОписаниеОповещения 		- Оповещение которое вызывается при завершении выбора
//	Выбор				 - Структура,Неопределено 	- Возвращаемый параметр, путь к переменной Выбор, если не задан то форма открывается в модальном режиме
//  ВладелецФормы		 - Форма 					- Форма в которой иницирован выбор
//  Элемент				 - ПолеФормы  				- Элемент, в котором иницирован выбор
//  Параметры			 - Структура - 	Вспомогательная структура:
//  	*ТекущиеДанные			- СтрокаТаблицыЗначений,Структура 	- Используется для определения значений - ЭтоВыражение,ИмяПараметра
//  	*ДоступныеСтруктуры		- Структура 						- ВыборПеременные, которые можно выбрать в текщем контексте
//  	*ОграничениеТипа		- ОписаниеТипов 					- Типы которые доступны для выбора в текущем контексте, учитываются и для переменных
//  СтандартнаяОбработка - Булево - признак использования стандартной обработки
//  ПоддержкаЯзыка		 - Булево - Признак поддержки встроенного языка
//
Процедура НачалоВыбора(ЗавершениеВыбора = Неопределено, Выбор = Неопределено, ВладелецФормы, Элемент, Параметры, СтандартнаяОбработка, ПоддержкаЯзыка = Истина, Заголовок = Неопределено) Экспорт
	ПараметрыСтроки		= Новый Соответствие;
	ОткрыватьМодально   = (Выбор = Неопределено);
	Выбор 				= ПолучитьВыбор(ЗавершениеВыбора, Параметры, ПараметрыСтроки);
	
	Если ТипЗнч(Параметры.ТекущиеДанные.ЗначениеПараметра) = Тип("Неопределено") Тогда   
		СтандартнаяОбработка = Ложь;
		Показать(Выбор,ВладелецФормы,ОткрыватьМодально,ПоддержкаЯзыка,Заголовок);
	Иначе
		Если Параметры.ТекущиеДанные.ЭтоВыражение Тогда
			СтандартнаяОбработка		= Ложь;
			Показать(Выбор,ВладелецФормы,ОткрыватьМодально,ПоддержкаЯзыка);
		Иначе
			Если ТипЗнч(Параметры.ТекущиеДанные.ЗначениеПараметра) = Тип("Строка") Тогда
				СтандартнаяОбработка	= Ложь;
				ВыбратьФайлы(Выбор, ВладелецФормы);		
			КонецЕсли;				
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры




// Изменить видимость.
// 
// Параметры:
//  Форма см. ОбщаяФорма.Выбор_Ei 
//  Видимость - Булево - Видимость
Процедура ИзменитьВидимость(Форма,Видимость) Экспорт
	Элемент = Форма.Элементы.Найти("ДеревоВыбора");
	Если Не Элемент = Неопределено И Не Элемент.Родитель = Неопределено Тогда
		Элемент.Родитель.Видимость 	= Видимость; 		
	КонецЕсли;		
КонецПроцедуры

// Функция - устанавливает или получает значение для строки 
// Не все типы и значения могут использоваться в данных формы (например массив,СписокXDTO) поэтому делаем через функцию
// Делаем экспортной для перехода из комментариев 
//
// Параметры:
//  Строка			 - ДанныеФормыЭлементДерева	 - Строка дерева
//  Значение		 - Произвольный
//  ОписаниеТипов	 - ОписаниеТипов	 		 - Сохраняемое ОписаниеТипов
// 
// Возвращаемое значение:
//   Структура:
//   *Значение		- Произвольный 
//   *ОписаниеТипов - ОписаниеТипов - Полученное описание типов
//
Функция ПараметрыСтроки(Выбор,Строка,Знач Значение = Неопределено,Знач ОписаниеТипов=Неопределено) Экспорт
	Если ОписаниеТипов = Неопределено И Значение = Неопределено Тогда
		//получаем
		Результат = Выбор.ПараметрыСтроки.Получить(Строка.ПолучитьИдентификатор());
		Если Результат = Неопределено Тогда
			Результат = Новый Структура("Значение,ОписаниеТипов",Неопределено,Новый ОписаниеТипов);
		ИначеЕсли Результат.Свойство("ИмяСсылочногоТипа") Тогда
			Результат.ОписаниеТипов = Новый ОписаниеТипов(Результат.ИмяСсылочногоТипа);
			Результат.Удалить("ИмяСсылочногоТипа");
		ИначеЕсли Результат.Свойство("ГруппаТипов") Тогда
			// Выбор самой группы использует ее составное описание типов.
			Результат.ОписаниеТипов = ТипыКлиентСерверПовтИсп_Ei.ВсеСсылки(Результат.ГруппаТипов);
		КонецЕсли;
		Возврат Результат;
	Иначе
		Если ТипЗнч(Значение) = Тип("ОписаниеОповещения") Тогда
			РеальноеЗначение 	= Неопределено;
			Аргументы			= Значение.ДополнительныеПараметры.Аргументы; //До выполнения обработки оповещения	
			ВыполнитьОбработкуОповещения(Значение,РеальноеЗначение);
			Если РеальноеЗначение = Неопределено Тогда
				Если Строка.ПолучитьЭлементы().Количество() = 0 Тогда
					Строка.ПолучитьЭлементы().Добавить(); // Чтобы строку можно было раскрыть и вычислить на сервере.
				КонецЕсли;
			Иначе
				Значение = РеальноеЗначение; //Заменим Описание оповещения что бы клиентские параметры не затерлись серверными результатами (их там не ожидается)
				ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(Значение,ОбщегоНазначенияКлиент_Ei.ИмяКлючаКартинки(),Строка.СсылкаНаКартинку);							
			КонецЕсли;	 
			Строка.ПредставлениеЗначения	= ОписаниеЗначенияКлиентСервер_Ei.ПолучитьПредставлениеПростогоЗнач(РеальноеЗначение);
			Строка.Представление 			= Строка.Представление+Аргументы;
		КонецЕсли;	
		Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(Значение) Тогда
			//Это ОписаниеЗначения 
			Значение.Свойство("ОписаниеТипов",ОписаниеТипов);
			Значение.Свойство("ПредставлениеЗначения",Строка.ПредставлениеЗначения);
			Значение.Свойство("ОбъемКоллекции",Строка.ОбъемКоллекции);
			Если ЗначениеЗаполнено(Значение.Значение) Тогда
				//это лишнее формирование описания значение таких быть не должно
				Значение 						= Значение.Значение;
				Строка.ПредставлениеЗначения    = Строка(Значение);
			КонецЕсли;	
		ИначеЕсли Не ТипЗнч(Значение) = Тип("ОписаниеОповещения") Тогда		
			Строка.ПредставлениеЗначения	= ОписаниеЗначенияКлиентСервер_Ei.ПолучитьПредставлениеПростогоЗнач(Значение);
		КонецЕсли;
		Строка.Имя						= НРег(Строка.Представление);
		
		//сохраняем
		Если ОписаниеТипов = Неопределено Тогда
			ОписаниеТипов = ТипыКлиентСервер_Ei.СоздатьОписаниеИзКолекции(ТипЗнч(Значение));	
		КонецЕсли;
		ОписаниеТипов = ТипыКлиентСервер_Ei.ПроверитьОписание(ОписаниеТипов);		
		Выбор.ПараметрыСтроки.Вставить(Строка.ПолучитьИдентификатор(),Новый Структура("Значение,ОписаниеТипов",Значение,ОписаниеТипов));
	КонецЕсли;
КонецФункции

//Процедура производит позиционированием на выбранной переменной, либо открывает окно встроенного языка
//Последнне открывается в случае если в доступных переменных мы не нашли указанного пути.
//Параметры:
//  Форма см. ОбщаяФорма.Выбор_Ei 		
//  Выбор -	Структура 	- Вспомогательная структура.
//
Процедура ВыборВыражения(Форма,Выбор) Экспорт
	Если Выбор.ТекущиеДанные.ЭтоВыражение Тогда
		СтрокаПоиска	= Форма.ДеревоВыбора;
		Выражение		= Нрег(СтрЗаменить(Выбор.ТекущиеДанные.ЗначениеПараметра,"[",".["));
		//заменим выражение функций, напмример Варианты("Процессы").Данные нужно поменять на Варианты( ).Процессы.Данные
		Выражение		= СтрЗаменить(Выражение,"(""",ОкончаниеФункции()+".");
		Выражение		= СтрЗаменить(Выражение,""").",".");
		//Надйем в дереве
		Для Каждого сЧастьВыражения ИЗ СтрРазделить(Выражение,".") Цикл
			Если Не ПустаяСтрока(сЧастьВыражения) Тогда 
				Для Каждого ПодСтрока ИЗ СтрокаПоиска.ПолучитьЭлементы() Цикл
					Если нРег(ПодСтрока.Имя) = СокрЛП(нРег(сЧастьВыражения)) Тогда
						СтрокаПоиска = Подстрока;
						Форма.Элементы.ДеревоВыбора.ТекущаяСтрока = СтрокаПоиска.ПолучитьИдентификатор();
						Развернуть(СтрокаПоиска, Выбор);
						Прервать;
					КонецЕсли;	
				КонецЦикла;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

// Функция - Выполняет наслдование/копирование поведения общей формы Выбор_Ei
// Параметры:
// 	Форма 				см. ОбщаяФорма.Выбор_Ei 
// 	Контейнер 			- ГруппаФормы - где должна появится все элементы наследуемой формы
// 	РодительКонтейнера	- ГруппаФормы - в котором должен находится контейнер. Необходимо в тех случаях когда контейнер должен появлятся в разных местах формы		
// Возвращаемое значение:
// 	- Форма - Из которой скопировали поведение
//
Функция НаследоватьВыбор(Форма,Контейнер,РодительКонтейнера = Неопределено) Экспорт
	Если Не РодительКонтейнера = Неопределено Тогда
		Если РодительКонтейнера.ПодчиненныеЭлементы.Найти(Контейнер.Имя) = Неопределено Тогда
			//нужно контейнер переместить под родителя
			Форма.Переместить(Контейнер.Имя,РодительКонтейнера.Имя);
		КонецЕсли; 
	КонецЕсли;	
	Если Не Контейнер.ПодчиненныеЭлементы.Количество() Тогда
		//@skip-check use-non-recommended-method
		ФормаРодитель 		= ПолучитьФорму(ИмяМодальнойФормы());
		НаследованиеФормКлиент_Ei.Дополнить(ФормаРодитель,Форма,Контейнер);
		ФормаРодитель.Выбор = Новый Структура;
	КонецЕсли;
	Если Не РодительКонтейнера = Неопределено Тогда
		// после наследования изменим отображение определенных элементов
		ЭтоВспГруппа = (РодительКонтейнера.Поведение = ПоведениеОбычнойГруппы.Всплывающая);
		//Скроем кнопку закрытия во всплывающем режиме
		КнопкаЗакрытия = Форма.Элементы.Найти("ДеревоВыбораКнопкаЗакрыть"); 
		Если Не КнопкаЗакрытия = Неопределено Тогда
			КнопкаЗакрытия.Видимость = 	Не ЭтоВспГруппа;
		КонецЕсли;
		//Уменьшим таблицу формы во всплывающем режиме
		ЭлементДерева = Форма.Элементы.Найти("ДеревоВыбора"); 
		Если Не ЭлементДерева = Неопределено Тогда
			ЭлементДерева.ВариантУправленияВысотой = ?(ЭтоВспГруппа,ВариантУправленияВысотойТаблицы.ПоСодержимому,ВариантУправленияВысотойТаблицы.Авто);		
		КонецЕсли;
		//Снимим флаг автоширины
		ЭлементДерева.АвтоМаксимальнаяШирина = Не ЭтоВспГруппа;
		//Для всплывающей изменим растягивание (чтобы не растягивало на всю форму) 
		//для обычной такой режим нужно сохранить чтобы можно менять размер в ручную
		ЭлементДерева = Форма.Элементы.Найти("ДеревоВыбораОбычнаяГруппа"); 
		Если Не ЭлементДерева = Неопределено Тогда
			ЭлементДерева.РастягиватьПоГоризонтали = ?(ЭтоВспГруппа,Ложь,Неопределено);				
		КонецЕсли;	   
	КонецЕсли;	
	Возврат Форма.НаследованиеФорм.ФормыРодители.Получить(Контейнер.Имя);
КонецФункции

// Процедура - Закрывает/Скрывает диалог выбора в зависмости от типа открытия
//
// Параметры:
//  Форма	 см. ОбщаяФорма.Выбор_Ei 
//
Процедура ЗакрытьВыбор(Форма) Экспорт
	Если Форма.ИмяФормы = ИмяМодальнойФормы() Или Форма.ИмяФормы = "CommonForm.Выбор_Ei" Тогда
		Форма.Закрыть();
	Иначе	
		ИзменитьВидимость(Форма,Ложь);
	КонецЕсли;		
КонецПроцедуры

// Получить выбор. 
// 
// Параметры:
//  ЗавершениеВыбора - ОписаниеОповещения 		- Оповещение которое вызывается при завершении выбора
//  Параметры - Структура - Параметры:
// 		* ТекущиеДанные 		- ДанныеФормыЭлементКоллекции, Структура - 
// 		* ДоступныеСтруктуры 	- Структура - 
// 		* ОграничениеТипа 		- ОписаниеТипов - 
//  ПараметрыСтроки - Соответствие Из Произвольный
// 
// Возвращаемое значение:
//  Структура - Получить выбор:
// 	* ДоступныеСтруктуры 		- Структура 							- ВыборПеременные, которые можно выбрать в текщем контексте 
// 	* ОграничениеТипа 	 		- ОписаниеТипов 						- Типы которые доступны для выбора в текущем контексте, учитываются и для переменных 
// 	* ТекущиеДанные		 		- ДанныеФормыЭлементКоллекции,Структура - Используется для определения значений - ЭтоВыражение,ИмяПараметра 
//  * ПараметрыСтроки 			- Соответствие Из Произвольный 			- Накопление соотвесвия типов и значени  более подробно в процедурее см. ПараметрыСтроки
//  * ЗавершениеВыбора 			- ОписаниеОповещения 					- Оповещение которое вызывается при завершении выбора 
//	* ЗапретитьВстроенныйЯзык 	- Неопределено							- Если это свойство указано не открываем окно встроенного языка
//  * Форма	 					- Форма 								- Форма в которой отображен диалог выбора 
//
Функция ПолучитьВыбор( ЗавершениеВыбора, Параметры, Знач ПараметрыСтроки)  Экспорт //Только для описания
	Выбор	= Новый Структура("ДоступныеСтруктуры,ОграничениеТипа,ТекущиеДанные");
	Выбор.Вставить("ПараметрыСтроки",ПараметрыСтроки);
	Выбор.Вставить("ЗавершениеВыбора",ЗавершениеВыбора);
	Параметры.Свойство("ДоступныеСтруктуры",Выбор.ДоступныеСтруктуры); 		//ВыборПеременные, которые можно выбрать в текущем контексте
	Параметры.Свойство("ОграничениеТипа",	Выбор.ОграничениеТипа);       	//Типы которые доступны для выбора в текущем контексте, учитываются и для переменных
	Параметры.Свойство("ТекущиеДанные",		Выбор.ТекущиеДанные); 		   	//Используется для определения значений - ЭтоВыражение,ИмяПараметра
	Возврат Выбор;
КонецФункции

#Область ОбработчикиСобытийДерева

// Дерево значений представление регулирование.
// 
// Параметры:
//  Форма 		см. ОбщаяФорма.Выбор_Ei 
//  Выбор 		см. ПолучитьВыбор 
//  Элемент 	- ТаблицаФормы
//  Направление  Направление
//  СтандартнаяОбработка - Булево
Процедура ДеревоЗначенийПредставлениеРегулирование(Форма,Выбор,Элемент,Направление, СтандартнаяОбработка) Экспорт
	СтандартнаяОбработка 		= Ложь;
	ЭлементФормыДереваВыбора	= Форма.Элементы.ДеревоВыбора;
	ТекД  						= ЭлементФормыДереваВыбора.ТекущиеДанные;
	
	Если Не ТекД = Неопределено И СтрНайти(ТекД.Представление,"[") И ТекД.ВведенВручную Тогда
		Представление  =  ТекД.Представление;
		Номер 			=  СтрЗаменить(СтрЗаменить(Представление,"[",""),"]","");
		Если ОбщегоНазначенияКлиентСервер_Ei.ЭтоЧисло(Номер) Тогда 
			Индекс = Макс(Число(Номер),0);	
		Иначе
			Возврат;
		КонецЕсли;	
		ТекД.Представление = СтрШаблон("[%1]",Формат((Индекс+Направление),"ЧН=0; ЧГ="));
		Если НеУдалосьВычислитьЗначениеСтроки(ТекД,Выбор) Тогда
			ТекД.Представление = Представление;
		Иначе
			ДеревоЗначенийПриАктивизацииСтроки(Форма,Выбор,ЭлементФормыДереваВыбора);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Процедура ДеревоЗначенийПриАктивизацииСтроки(Форма,Выбор,Элемент) Экспорт
	Если ТипЗнч(Элемент.ТекущиеДанные) = Тип("ДанныеФормыЭлементДерева") Тогда
		//Если Не Элемент.ТекущиеДанные.Значение = Неопределено Тогда
			Форма.ДеревоВыбора_Путь	= вПолучитьПутьКПеременной(Элемент.ТекущиеДанные);
		//Иначе
		//	Путь	= "";
		//КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Дерево значений перед окончанием редактирования.
// 
// Параметры:
//  Форма 		см. ОбщаяФорма.Выбор_Ei 
//  Выбор 		см. ПолучитьВыбор 
//  Элемент 				- ТаблицаФормы
//  НоваяСтрока 			- Булево
//  ОтменаРедактирования 	- Булево
//  Отказ  					- Булево
Процедура ДеревоЗначенийПередОкончаниемРедактирования(Форма, Выбор, Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)Экспорт

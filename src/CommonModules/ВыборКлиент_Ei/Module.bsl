
//Вызывается при начале выборе типа или значения
//Параметры:
//	ВладелецФормы			-<Форма>. Форма в которой произведен выбор
//	Элемент					-<ЭлементУправления>. Элемент, в котором производим выбор
//	Параметры				-<Структура> Вспомогательная структура 
//									ТекущиеДанные			-<СтрокаТаблицыЗначений.Структура> Используется для определения значений - ЭтоВыражение,ИмяПараметра
//									ДоступныеПеременные		-<Структура> ВыборПеременные, которые можно выбрать в текщем контексте
//									ОграничениеТипа			-<ОписаниеТипов> Типы которые доступны для выбора в текущем контексте, учитываются и для переменных
//									ЗапретитьВстроенныйЯзык -<Неопределено> Если это свойство указано не открываем окно встроенного языка
//	СтандартнаяОбработка    -<Булево>. признак испольлзования стандартной обработки
//  ИмяЭлемента				-<Строка>. Имя элмента владельца формы в случае если выбор типа или значения происходит не модально
//
Процедура НачалоВыбора(ВладелецФормы,Элемент,Параметры,СтандартнаяОбработка,ИмяЭлемента = Неопределено) Экспорт
	
	Переменные		= Новый Структура("Параметры,ЭтаФорма,Объект,ТекущиеДанные,СтрокаТЧ",Неопределено,Неопределено,Неопределено,Неопределено,Неопределено,);
	ПараметрыСтроки	= Новый Соответствие;
	Выбор			= Новый Структура("ПараметрыСтроки,Переменные,ДоступныеСтруктуры,ОграничениеТипа,ТекущиеДанные",ПараметрыСтроки,Переменные);
	Параметры.Свойство("ДоступныеСтруктуры",Выбор.ДоступныеСтруктуры);
	Параметры.Свойство("ОграничениеТипа",Выбор.ОграничениеТипа);
	Параметры.Свойство("ТекущиеДанные",Выбор.ТекущиеДанные);
	//Выбор.Вставить("Форма",ЭтаФорма);
	
	Если ТипЗнч(Параметры.ТекущиеДанные.ЗначениеПараметра) = Тип("Неопределено") Тогда  // 
		СтандартнаяОбработка = Ложь;
		Показать(Выбор,ВладелецФормы,ИмяЭлемента);
	Иначе
		Если Параметры.ТекущиеДанные.ЭтоВыражение Тогда
			СтандартнаяОбработка		= Ложь;
			Показать(Выбор,ВладелецФормы,ИмяЭлемента);
		Иначе
			//ПРОВЕРКА НА ФАЙЛ
			Если ТипЗнч(Параметры.ТекущиеДанные.ЗначениеПараметра)=Тип("Строка") Тогда
				СтандартнаяОбработка	= Ложь;
				Файл 	= Новый Файл(Выбор.ТекущиеДанные.ЗначениеПараметра);
				Если ЗначениеЗаполнено(Файл.ПолноеИмя) Тогда 	
					Файл.НачатьПроверкуСуществования(Новый ОписаниеОповещения("ОО_ПроверкаСуществованияФайла",ВыборКлиент_Ei,Новый Структура("ПолноеИмя,ВладелецФормы,Выбор",Файл.ПолноеИмя,ВладелецФормы,Выбор)));
				Иначе		
					ПоказатьДиалог(,ВладелецФормы,Выбор);
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ
#Область ОбщегоНазначения

//Отображает окно или элемент выбора типа/значения
//Параметры:
//  Выбор					-<Структура> Вспомогательная структура
//									ПараметрыСтроки			-<Соответствие> Накопление соотвесвия и значение типов более подробно в процедурее ПараметрыСтроки()
//									Переменные              -<Структура> Фиксированная структура переменных используемая для встроенного языка
//									ТекущиеДанные			-<СтрокаТаблицыЗначений.Структура> Используется для определения значений - ЭтоВыражение,ИмяПараметра
//									ДоступныеПеременные		-<Структура> ВыборПеременные, которые можно выбрать в текщем контексте
//									ОграничениеТипа			-<ОписаниеТипов> Типы которые доступны для выбора в текущем контексте, учитываются и для переменных
//									ЗапретитьВстроенныйЯзык -<Неопределено> Если это свойство указано не открываем окно встроенного языка
//	ВладелецФормы			-<Форма>. Элемент в котором произведен выбор
//	ИмяЭлемента				-<Строка>  Имя элмента владельца формы, если не задано то происходит модальный выбор из предопределенной формы
//
Процедура Показать(Выбор,ВладелецФормы,стрИмяЭлементаВыбора)
	ЭлементВыбора =  Неопределено;
	Если ЗначениеЗаполнено(стрИмяЭлементаВыбора) Тогда
		ЭлементВыбора = ВладелецФормы.Элементы.Найти(стрИмяЭлементаВыбора);	
	КонецЕсли;
	Если ЭлементВыбора = Неопределено Тогда
		//открываем модально
		стрИмяЭлементаВыбора		= "ДеревоВыбора";//указываем как называется имя элемента формы и соотвесвующее ему имя занчения в модальной форме
		стрИмяМодальнойФормыВыбора	= ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеФормы().ВыборТипа;
		РежимОткрытияОкна 			= РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ФормаВыбора 				= ОткрытьФорму(стрИмяМодальнойФормыВыбора,,ВладелецФормы,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ФормаВыбора					= ВладелецФормы;
	КонецЕсли;
	Выбор.Вставить("Форма",ФормаВыбора);
	Выбор.Вставить("ИмяЭлемента",стрИмяЭлементаВыбора); 
	ФормаВыбора.Выбор = Выбор;
	ДеревоВыбораЭлемент(Выбор).Родитель.Видимость = Истина; //покажем, очень важно для немодального режима, но и в модальном проверить не помешает
	ФормаВыбора.Элементы[Выбор.ИмяЭлемента+"_КомПанель"].Видимость = (Не ЭлементВыбора = Неопределено);
	ИнициализацияВыбора(Выбор);
КонецПроцедуры

//Производит инициализацию формы выбора
//Параметры:
//  Выбор					-<Структура> Вспомогательная структура
//									Форма					-<Форма> Форма в которой производится выбор типа или значения, может быть как модальная так и та из которой происходит выбор
//									ИмяЭлемента				-<Строка> Имя элемента форма и занчения формы в которм расположено дерево выбора
//									ПараметрыСтроки			-<Соответствие> Накопление соотвесвия типов и значени  более подробно в процедурее ПараметрыСтроки()
//									Переменные              -<Структура> Фиксированная структура переменных используемая для встроенного языка
//									ТекущиеДанные			-<СтрокаТаблицыЗначений.Структура> Используется для определения значений - ЭтоВыражение,ИмяПараметра
//									ДоступныеПеременные		-<Структура> ВыборПеременные, которые можно выбрать в текщем контексте
//									ОграничениеТипа			-<ОписаниеТипов> Типы которые доступны для выбора в текущем контексте, учитываются и для переменных
//									ЗапретитьВстроенныйЯзык -<Неопределено> Если это свойство указано не открываем окно встроенного языка
//
Процедура ИнициализацияВыбора(Выбор)
	ДеревоВыбора = ДеревоВыбора(Выбор);
	ДеревоВыбора.ПолучитьЭлементы().Очистить(); //очистим строки, а то не при модальном выборе они пополняются постоянно
	ПеречисленияКлиентСерверПовторноеИспользование_Ei.Значения().Очистить();
	Выбор.ПараметрыСтроки.Очистить();
	
	вЗаполнитьДеревоДоступнымиПеременными(Выбор,ДеревоВыбора);
	//Доступные типы 
	СписокТипов = ВыборВызовСервера_Ei.вПолучитСписокДоступныхТипов(Выбор.ТекущиеДанные.ЭтоВыражение);
	Для Каждого Тип  ИЗ СписокТипов Цикл
		Если вТипРазрешен(Выбор.ОграничениеТипа,Тип.Значение) И Тип.Значение.типы().Количество() Тогда
			НоваяСтрока	= ДеревоВыбора.ПолучитьЭлементы().Добавить();
			НоваяСтрока.Представление	= Тип.Представление;
			ПараметрыСтроки(Выбор,НоваяСтрока,,Тип.Значение);
			Если  Тип.Пометка Тогда
				//добавлем подстроку чтобы можно было развернуть
				НоваяПодСтрока=НоваяСтрока.ПолучитьЭлементы().Добавить();
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	ВыполнитьОбработкуОповещения(Новый ОписаниеОповещения("ВыборВыражения",ВыборКлиент_Ei),Выбор); //Производим ассинхронный вызов поиска чтобы не задерживать открытие или отображение формы
	
	//ЭлементыФормы.Путь.КнопкаОткрытия	= Не  СтруктураДопПараметров.Свойство("ЗапретитьВстроенныйЯзык");
	//Если ЭлементыФормы.ДеревоЗначений.ТекущиеДанные = Неопределено Тогда
	//	//тут хорошобы активизировать единственный тип, но он известен только после разворота +	
	//КонецЕсли;	
КонецПроцедуры

//Процедура производит позиционированием на выбранной переменной, либо открывает окно встроенного языка.
//Последнне открывается в случае если в доступных переменных мы не нашли указанного пути.
//Параметры:
//  Выбор				-<Структура> Вспомогательная структура
//	ДопПараметры        -<Структура> Структура доп параметров
//								ИскатьВДоступныхПеременных  -<Булево>. Выполнять поиск в доступных переменных
//
Процедура ВыборВыражения(Выбор,ДопПараметры) Экспорт
	Если Выбор.ТекущиеДанные.ЭтоВыражение Тогда
		СтрокаПоиска	= ДеревоВыбора(Выбор);
		Выражение		= Нрег(Выбор.ТекущиеДанные.ЗначениеПараметра);
		Для Каждого сЧастьВыражения ИЗ СтрРазделить(Выражение,".") Цикл
			Если Не ПустаяСтрока(сЧастьВыражения) Тогда 
				Для Каждого ПодСтрока ИЗ СтрокаПоиска.ПолучитьЭлементы() Цикл
					Если нРег(ПодСтрока.Имя) = СокрЛП(нРег(сЧастьВыражения)) Тогда
						СтрокаПоиска = Подстрока;
						ДеревоВыбораЭлемент(Выбор).ТекущаяСтрока = СтрокаПоиска.ПолучитьИдентификатор();
						Развернуть(СтрокаПоиска, Выбор);
						Прервать;
					КонецЕсли;	
				КонецЦикла;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

//Производит заполнение дерева значений доступными переменными
//
Процедура вЗаполнитьДеревоДоступнымиПеременными(Выбор,ДеревоВыбора)
	Если ТипЗнч(Выбор.ДоступныеСтруктуры) = Тип("Структура") Тогда
		Для Каждого ДоступнаяСтруктура Из  Выбор.ДоступныеСтруктуры Цикл
			НоваяСтрока = ДеревоВыбора.ПолучитьЭлементы().Добавить();
			НоваяСтрока.Представление	= ДоступнаяСтруктура.Ключ;
			ПараметрыСтроки(Выбор,НоваяСтрока,ДоступнаяСтруктура.Значение);//ДозаполнитьСтрокуДерева(НоваяСтрока,ДоступнаяСтруктура.Значение,Выбор);
			вРазвернутьСвойства(НоваяСтрока,Выбор);
	 	КонецЦикла;	
	КонецЕсли;	
Конецпроцедуры

//Функция проверят разрешен ли к использованию в этой форме данное описание типов(тип)
//Параметры:
//	ОписаниеТипов	-<ОписаниеТипов,Тип>. Объект, который нужно проверить	
Функция вТипРазрешен(ОграничениеТипа,ОписаниеТипов)
	Если ЗначениеЗаполнено(ОграничениеТипа) Тогда
		Если ТипЗнч(ОписаниеТипов) = Тип("ОписаниеТипов") Тогда
			//Если ОписаниеТипов.Типы().Количество()=0 Тогда
				//Возврат Истина; //неопределенный тип возможен только при загрузке из внешних источников, разрешим надеясь что пользователь понимает что делает не хрена не понятно даже я облажался с номером
			//Иначе	
			Возврат Истина;//вОписаниеТиповПересекаются(Параметры.ОграничениеТипа,ОписаниеТипов);
		ИначеЕсли ТипЗнч(ОписаниеТипов) = Тип("Тип") Тогда
			Возврат ОграничениеТипа.СодержитТип(ОписаниеТипов);
		Иначе
			Возврат Ложь;
		КонецЕсли;	
	Иначе
		Возврат Истина;
	КонецЕсли;	
КонецФункции

// Функция - устанавливает или получает значение для строки 
// Не все типы и значения могут использоваться в данных формы (например массив,СписокXDTO) поэтому делаем через функцию
//
// Параметры:
//  Строка			 - ЭлементКоллекции	 - Строка дерева
//  ОписаниеТипов	 - ОписаниеТипов	 - Сохраняемое ОписаниеТипов
// 
// Возвращаемое значение:
//   - ОписаниеТипов. Полученное опсиание типов
//
Функция ПараметрыСтроки(Выбор,Строка,Знач Значение = Неопределено,Знач ОписаниеТипов=Неопределено)
	Если ОписаниеТипов = Неопределено И Значение = Неопределено Тогда
		//получаем
		Результат = Выбор.ПараметрыСтроки.Получить(Строка.ПолучитьИдентификатор());
		Возврат ?(Результат = Неопределено, Новый Структура("Значение,ОписаниеТипов",Неопределено,Новый ОписаниеТипов),Результат);
	Иначе
		Строка.Имя						= НРег(Строка.Представление);
		Если СтруктурыЗначенийКлиентСервер_Ei.ЭтоОписаниеЗначения(Значение) Тогда
			//Это ОписаниеЗначения 
			Значение.Свойство("ОписаниеТипов",ОписаниеТипов);
			Значение.Свойство("ПредставлениеЗначения",Строка.ПредставлениеЗначения);
			Значение.Свойство("ОбъемКоллекции",Строка.ОбъемКоллекции);
			Если ЗначениеЗаполнено(Значение.Значение) Тогда
				//это лишнее формирование описаниязначение таких быть не должно
				Значение 						= Значение.Значение;
				Строка.ПредставлениеЗначения    = Строка(Значение);
			КонецЕсли;	
		Иначе
			Строка.ПредставлениеЗначения	= Строка(Значение);
		КонецЕсли;
		//сохраняем
		Если ОписаниеТипов = Неопределено Тогда
			ОписаниеТипов = ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(ТипЗнч(Значение));	
		КонецЕсли;
		Попытка
			//не все типы могут быть доступны на клиенте, если недоступны то это точно не примитивные типы
			ОписаниеТипов = ОбщийМодульКлиентСервер_Ei.ПроверитьОписаниеТипов(ОписаниеТипов);	
		Исключение
		КонецПопытки;	
		Выбор.ПараметрыСтроки.Вставить(Строка.ПолучитьИдентификатор(),Новый Структура("Значение,ОписаниеТипов",Значение,ОписаниеТипов));
	КонецЕсли;
КонецФункции

//Процедура разворачивает свойства значения указанного в строке
//Параметры:
//	Строка 				-<СтрокаДереваЗначений>. Разворачиваемая строка
Процедура вРазвернутьСвойства(Строка,Выбор)
	ЗначениеСтроки = ПараметрыСтроки(Выбор,Строка).Значение;
	Если СтруктурыЗначенийКлиентСервер_Ei.ЭтоОписаниеЗначения(ЗначениеСтроки) Тогда//ЗначениеЗаполнено(Строка.Ссылка) ИЛИ ЗначениеЗаполнено(Строка.КэшПредставление) Тогда
		СписокСвойств = ВыборВызовСервера_Ei.ПолучитьСвойстваЗначения(ЗначениеСтроки,Выбор.Форма.УникальныйИдентификатор);
		Для Каждого ЭлСписка ИЗ СписокСвойств Цикл
			ПодСтрока=Строка.ПолучитьЭлементы().Добавить();
			ПодСтрока.Представление	= ЭлСписка.Представление;
			ПараметрыСтроки(Выбор,ПодСтрока,ЭлСписка.Значение);//ДозаполнитьСтрокуДерева(ПодСтрока,ЭлСписка.Значение,Выбор);
			ПроверитьВозможностьСвойств(ПодСтрока,Выбор);
		КонецЦикла;	
	ИначеЕсли 	ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки().СодержитТип(ТипЗнч(ЗначениеСтроки)) И 
				Не ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки("Перечисления").СодержитТип(ТипЗнч(ЗначениеСтроки))
				ИЛИ вЭтоТипОбъекта(ТипЗнч(ЗначениеСтроки)) Тогда
		Для Каждого ЭлСписка ИЗ ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСвойстваОбъектаМетаданных(ЗначениеСтроки,Выбор.Форма.УникальныйИдентификатор) Цикл
			ПодСтрока=Строка.ПолучитьЭлементы().Добавить();
			ПодСтрока.Представление	= ЭлСписка.Представление;
			ПараметрыСтроки(Выбор,ПодСтрока,ЭлСписка.Значение);//ДозаполнитьСтрокуДерева(ПодСтрока,ЭлСписка.Значение,Выбор);
			ПроверитьВозможностьСвойств(ПодСтрока,Выбор);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ЗначениеСтроки) = Тип("Структура") Тогда
		Для Каждого Переменная ИЗ  ЗначениеСтроки Цикл
			//Если ТипЗнч(Переменная.Значение) = Тип("ФиксированнаяСтруктура") Тогда
			//	ЗначениеСвойства = Переменная.Значение;
			//Иначе	
			//	ЗначениеСвойства = ОбщийМодульВызовСервера_Ei.ПодготовитьОписаниеЗначенияВызовСервера(Переменная.Значение);
			//КонецЕсли;
			ЗначениеСвойства = Переменная.Значение;  //пока так
			ПодСтрока = Строка.ПолучитьЭлементы().Добавить();
			ПодСтрока.Представление	= Переменная.Ключ;
			ПараметрыСтроки(Выбор,ПодСтрока,ЗначениеСвойства);//ДозаполнитьСтрокуДерева(ПодСтрока,ЗначениеСвойства,Выбор);
			ПроверитьВозможностьСвойств(ПодСтрока,Выбор);
		КонецЦикла;
	КонецЕсли;
	Если ЭтоКоллекция(Строка,Выбор) Тогда
		Если Строка.ОбъемКоллекции =  Неопределено Тогда
			Строка.ОбъемКоллекции = 0;
			Попытка
				Строка.ОбъемКоллекции	= ОбщийМодульКлиент_Ei.__ВычислитьЗначение(вПолучитьПутьКПеременной(Строка)+".Количество()",,,Выбор.ДоступныеСтруктуры,Ложь);
			Исключение
			КонецПопытки;
		КонецЕсли;	
		Если Строка.ОбъемКоллекции Тогда
			МаксЭлКоллекцииСтрока	= Строка.ПолучитьЭлементы().Добавить();
			МаксЭлКоллекцииСтрока.Представление = "["+Формат(Строка.ОбъемКоллекции-1,"ЧН=0; ЧГ=")+"]";
			МаксЭлКоллекцииСтрока.ВведенВручную = Истина;
			Если НеУдалосьВычислитьЗначениеСтроки(МаксЭлКоллекцииСтрока,Выбор) Тогда
				Строка.ПолучитьЭлементы().Удалить(МаксЭлКоллекцииСтрока);	
			Конецесли;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

// Процедура - Добавляет специальные строки которые способствует дальнейшему разворачиванию дерева
//
// Параметры:
//  ПодСтрока	 - ЭлементКоллекцииДереваЗначений	 - Строка в которую планируеться добавлять специальные строки
//
Процедура ПроверитьВозможностьСвойств(ПодСтрока,Выбор)
	Если Не ЭтоПримитивноеЗначение(Выбор,ПодСтрока) Тогда
		Если ДеревоВыбораЭлемент(Выбор).Развернут(ПодСтрока.ПолучитьИдентификатор()) = Истина Тогда //почему то может иногда возвращать неопределено
			Развернуть(ПодСтрока,Выбор);
		Иначе	
			ПустаяПодСтрока	= ПодСтрока.ПолучитьЭлементы().Добавить();
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

// Функция - Определяет является ли хранимое в строке значение примитивным
//
// Параметры:
//  Выбор		- Структура	 - 
//  Строка	 	- ЭлементКоллекцииДереваЗначений	 - Строка для которой выполняется определение
// 
// Возвращаемое значение:
//   - 
//
Функция ЭтоПримитивноеЗначение(Выбор,Строка)
	Результат = Ложь;
	ОписаниеТипов = ПараметрыСтроки(Выбор,Строка).ОписаниеТипов;
	Если ТипЗнч(ОписаниеТипов) = Тип("ОписаниеТипов") Тогда	
		//вычтим из исходного описания типов все примитивные если что то осталось то тогда это не примитивное описание типов
		врОписаниеТипов = Новый ОписаниеТипов(ОписаниеТипов,,ПеречисленияКлиентСерверПовторноеИспользование_Ei.ПримитивныеТипы());
		Результат = (врОписаниеТипов.Типы().Количество() = 0); 
	Иначе
		//этот тип недоступен на клиенте значит точно не является примитивным		
	КонецЕсли;	
	Возврат Результат;	
Конецфункции	

//Получает дерева выбора из вспомогательной структуры
//
Функция ДеревоВыбора(Выбор)
	Возврат Выбор.Форма[Выбор.ИмяЭлемента];	
КонецФункции

//Получает элемент формы дерева выбора из вспомогательной структуры
//
Функция ДеревоВыбораЭлемент(Выбор)
	Возврат Выбор.Форма.Элементы[Выбор.ИмяЭлемента];	
КонецФункции

//Определяет является ли переданный тип объектом
//Параметры:
//	Тип	-<Тип>. Исходный тип
//Возвращаемое значение: булево
Функция вЭтоТипОбъекта(Тип)
	Результат = Ложь;
	//Если ПараметрыОкружения.Свойство("ВсеОбъекты") Тогда
	//	Результат		= ПараметрыОкружения.ВсеОбъекты.СодержитТип(Тип);
	//Иначе
	//	//объекты не заполнены подбираем по другому
	//	Результат	= (Найти(Тип," объект: ")>0);
	//КонецЕсли;	
	Возврат Результат;
КонецФункции

// Функция определет является ли текущее описание коллекцией
//
// Параметры:
//  Тип	 - 	 - <ОписаниеТип>. Исходное описание которое нужно проверить
// 
// Возвращаемое значение:
//   - Булево
//
Функция ЭтоКоллекция(ТД,Выбор)
	Если Не ТД.ОбъемКоллекции = Неопределено Тогда
		Результат = Истина;
	Иначе
		ОписаниеТипов	= ПараметрыСтроки(Выбор,ТД).ОписаниеТипов;
		МассивТипов		= Новый Массив();
		МассивТипов.Добавить(Тип("СписокXDTO"));
		МассивТипов.Добавить(Тип("СписокЗначений"));
		МассивТипов.Добавить(Тип("Массив"));
		Результат	= ОбщийМодульКлиентСервер_Ei.вОписаниеТиповПересекаются(ОписаниеТипов,Новый ОписаниеТипов(МассивТипов));
	КонецЕсли;	
	Возврат Результат;
КонецФункции

//Получает путь к выбранной переменной, перебро всех родителей через "."
//Параметры:
//	Строка	-<СтрокаДереваЗначений>. Строка дерева типов
//	
Функция вПолучитьПутьКПеременной(Строка)
	Если ТипЗнч(Строка) = Тип("ДанныеФормыЭлементДерева") Тогда
		Если  Строка.ПолучитьРодителя() = Неопределено Тогда
			ПутьКпеременной	= ?(ПустаяСтрока(Строка.Имя),"",Строка.Представление);
		Иначе
			Приставка		= вПолучитьПутьКПеременной(Строка.ПолучитьРодителя());
			ПутьКпеременной	= Приставка+"."+Строка.Представление;
		КонецЕсли;
	Иначе
		ПутьКпеременной		= "";
	КонецЕсли;
	СоотвесвтиеЗамены = Новый Соответствие;
	СоотвесвтиеЗамены.Вставить("..",".");
	СоотвесвтиеЗамены.Вставить(".[","[");
	Возврат ОбщийМодульКлиентСервер_Ei.СтрЗаменитьИзСписка(ПутьКпеременной,СоотвесвтиеЗамены);
КонецФункции

// Функция - Вычислить значение строки
//
// Параметры:
//  ТекущиеДанные	 - ЭлементКоллекцииДерева	 - Строка дерева значений представление для которой необходмо вычислить 
// 
// Возвращаемое значение:
//   - Булево. Ложь - значение успешно вычислено и заполнено в строке, Истина - значение не смогли вычислить
//
Функция НеУдалосьВычислитьЗначениеСтроки(ТекущиеДанные,Выбор) 
	Отказ 			= Ложь;
	сВыражение  	= вПолучитьПутьКПеременной(ТекущиеДанные);
	ЗаполнитьЗначенияСвойств(Выбор.Переменные,Выбор.ДоступныеСтруктуры);
	Попытка
		Значение		= ОбщийМодульКлиент_Ei.__ВычислитьЗначение(сВыражение,,,Выбор.ДоступныеСтруктуры);
	Исключение
	    Отказ = Истина;
	КонецПопытки;
	Если Не Отказ Тогда
		//Если ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		//	ЗаполнитьЗначенияСвойств(ТекущиеДанные,Значение);
		//Иначе	
			ПараметрыСтроки(Выбор,ТекущиеДанные,Значение);	
		//КонецЕсли;
		ТекущиеДанные.ПолучитьЭлементы().Очистить();
		ПроверитьВозможностьСвойств(ТекущиеДанные,Выбор);
	КонецЕсли;
	Возврат Отказ;
КонецФункции

// Функция определет можем ли мы получить для укзанного описания типов свойства
//
// Параметры:
//  Тип	 - 	 - <ОписаниеТип>. Исходное описание которое нужно проверить
// 
// Возвращаемое значение:
//   - Булево
//
Функция вОписаниеТиповИмеетСвойства(ОписаниеТипов)
	Результат		= 	ОбщийМодульКлиентСервер_Ei.вОписаниеТиповПересекаются(ОписаниеТипов,ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки()) И 
					Не 	ОбщийМодульКлиентСервер_Ei.вОписаниеТиповПересекаются(ОписаниеТипов,ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки("Перечисления"))
				ИЛИ вЭтоТипОбъекта(ОписаниеТипов);
	//Если Не Результат Тогда
	//	МассивТипов	= Новый Массив();
	//	//МассивТипов.Добавить(Тип("СтрокаТаблицыЗначений"));
	//	//МассивТипов.Добавить(Тип("СтрокаДереваЗначений"));
	//	МассивТипов.Добавить(Тип("ОбъектXDTO"));
	//	МассивТипов.Добавить(Тип("Структура"));
	//	Результат	= ОбщийМодульКлиентСервер_Ei.вОписаниеТиповПересекаются(ОписаниеТипов,Новый ОписаниеТипов(МассивТипов));			
	//КонецЕсли;
	//Если Не Результат Тогда
	//	Результат	= (Найти(Тип,"табличная часть строка:")>0);			
	//КонецЕсли;	
	Возврат Результат;
КонецФункции

Процедура Развернуть(СтрокаДЗ,Выбор) 
	ПустаяПодСтрока = Неопределено;
	Для Каждого ПодСтрока ИЗ СтрокаДЗ.ПолучитьЭлементы() Цикл
		Если Не ЗначениеЗаполнено(ПодСтрока.Представление) Тогда
			ПустаяПодСтрока = ПодСтрока;
			СтрокаДЗ.ПолучитьЭлементы().Удалить(ПустаяПодСтрока);
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Если Не СтрокаДЗ.ПолучитьЭлементы().Количество() Тогда
		ПараметрыСтроки = ПараметрыСтроки(Выбор,СтрокаДЗ);
		Если Не ПараметрыСтроки.Значение = Неопределено Тогда
			//развернули свойства значений
			Если ТипЗнч(ПараметрыСтроки.ОписаниеТипов) = Тип("ОписаниеТипов") И ПараметрыСтроки.ОписаниеТипов.Типы().Количество()>1 Тогда
				//значение составного типа
				вРазвернутьТипы(СтрокаДЗ,Истина);
			Иначе	
				вРазвернутьСвойства(СтрокаДЗ,Выбор);
			КонецЕсли;
		ИначеЕсли СтруктурыЗначенийКлиентСервер_Ei.ЭтоОписаниеЗначения(ПараметрыСтроки.Значение) Тогда// ЗначениеЗаполнено(СтрокаДЗ.Ссылка) ИЛИ ЗначениеЗаполнено(СтрокаДЗ.КэшПредставление)  Тогда
			вРазвернутьСвойства(СтрокаДЗ,Выбор);
		Иначе
			//развернули типы
            вРазвернутьТипы(СтрокаДЗ,Выбор);
		КонецЕсли;
	КонецЕсли;
	Если ПустаяПодСтрока = Неопределено Тогда //только строку удалили, нет смыслка проверять на доступные свойства
		Если Не СтрокаДЗ.ПолучитьЭлементы().Количество() Тогда
			ПроверитьВозможностьСвойств(СтрокаДЗ,Выбор);
		КонецЕсли;	
	КонецЕсли;
	//ИначеЕсли СтрокаДЗ.ПолучитьЭлементы().Количество() И ТипЗнч(СтрокаДЗ.Значение) = Тип("Структура") Тогда  //это вложенные предопределенные структуры
	//	Для Каждого ПодСтрока ИЗ СтрокаДЗ.ПолучитьЭлементы() Цикл
	//		Если ТипЗнч(ПодСтрока.Значение) = Тип("Структура") И Не ПодСтрока.ПолучитьЭлементы().Количество() И ПодСтрока.Значение.Количество() Тогда
	//			//добавим пустую строку чтобы можно было развернуть
	//			ПустаяПодСтрока = ПодСтрока.ПолучитьЭлементы().Добавить();
	//		КонецЕсли;	
	//	КонецЦикла;	
Конецпроцедуры	

//Процедура разворачивает типы значений указанные в строке
//Параметры:
//	Строка 				-<СтрокаДереваЗначений>. Разворачиваемая строка
//	ПриводитьЗначения   -<Булево>. Определяет необходимость приведения значений к типу.
Процедура вРазвернутьТипы(Строка,Выбор,ПриводитьЗначения=Ложь)
	сзОписанияТипов = Новый СписокЗначений;
	Для Каждого Тип ИЗ ОбщийМодульВызовСервера_Ei.ПолучитьМассивТипов(ПараметрыСтроки(Выбор,Строка).ОписаниеТипов) Цикл
		Если вТипРазрешен(Выбор.ОграничениеТипа,Тип) Тогда
			Значение 		= ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(Тип);
			сПредставление	= ОбщийМодульЗакрытыйКлиент_Ei.ПолучитьИмяОписанияТипов(Значение); //ПривестиЗначение().Метаданные().Имя; //найти по типу дольше работает
			сзОписанияТипов.Добавить(Значение,сПредставление);
		КонецЕсли;
	КонецЦикла;
	сзОписанияТипов.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
	//сортируем список и только потом добавляем строки
	Для Каждого ЭлСписка ИЗ сзОписанияТипов Цикл
		ПодСтрока	= Строка.ПолучитьЭлементы().Добавить();
		ПодСтрока.Представление = ЭлСписка.Представление;
		ПараметрыСтроки(Выбор,ПодСтрока,,ЭлСписка.Значение);
		Если ПриводитьЗначения Тогда
			ПодСтрока.Значение	= ПараметрыСтроки(Выбор,ПодСтрока).ОписаниеТипов.ПривестиЗначение(Строка.Значение);
			Если вОписаниеТиповИмеетСвойства(ПараметрыСтроки(Выбор,ПодСтрока).ОписаниеТипов) Тогда
				вРазвернутьСвойства(ПодСтрока,Выбор);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

#Область ВыборФайлов

Процедура ОО_ПроверкаСуществованияФайла(Результат,ДопПараметры) Экспорт
	ПолноеИмя = ?(Результат,ДопПараметры.ПолноеИмя,"");
	ПоказатьДиалог(ПолноеИмя,ДопПараметры.ВладелецФормы,ДопПараметры.Выбор); 	
КонецПроцедуры

Процедура ОО_ЗавершениеВыбораФайла(ВыбранныеФайлы,ДопПараметры) Экспорт
	Если Не ВыбранныеФайлы = Неопределено Тогда
		ВыбранноеЗначение =  Неопределено;
		Если ВыбранныеФайлы.Количество() > 1 Тогда
			сзНовый = Новый СписокЗначений;
			сзНовый.ЗагрузитьЗначения(ВыбранныеФайлы);
			ВыбранноеЗначение = сзНовый;
		Иначе	
			Для Каждого сИмяФайла ИЗ ВыбранныеФайлы	Цикл
				ВыбранноеЗначение = сИмяФайла;
			КонецЦикла;
		КонецЕсли;	
		Если Не ВыбранноеЗначение =  Неопределено Тогда
			//дозаполним структуру так чтобы ее могла правильно исполнить обработка выбора
			ДопПараметры.Выбор.ТекущиеДанные.ЗначениеПараметра = ВыбранноеЗначение; 
			ДопПараметры.ВладелецФормы.ОбработкаВыбора_ВыборТипа(ДопПараметры.Выбор.ТекущиеДанные)
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

Процедура ПоказатьДиалог(ПолноеИмя="",ВладелецФормы,Выбор)
	Длг 					= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Длг.ПолноеИмяФайла 		= ПолноеИмя;
	Длг.Заголовок 			= "Укажите путь к файлу или папке";
	Длг.Фильтр 				= "Все файлы (*.*)|*.*";
	Длг.МножественныйВыбор	= Истина;
	Длг.Показать(Новый ОписаниеОповещения("ОО_ЗавершениеВыбораФайла",ВыборКлиент_Ei,Новый Структура("ВладелецФормы,Выбор",ВладелецФормы,Выбор)));
КонецПроцедуры

#КонецОбласти

Процедура ЗакрытьВыбор(Выбор) Экспорт
	ДеревоВыбораЭлемент(Выбор).Родитель.Видимость = Ложь; //Скроем, очень важно для немодального режима, но и в модальном проверить не помешает
КонецПроцедуры

#КонецОбласти


// ОБРАБОТЧИКИ СОБЫТИЙ ДЕРЕВА ЗНАЧЕНИЙ
#Область ОбработчикиСобытийДерева

Процедура ДеревоЗначенийПредставлениеРегулирование(Выбор,Направление, СтандартнаяОбработка) Экспорт
	СтандартнаяОбработка 		= Ложь;
	ЭлементФормыДереваВыбора	= ДеревоВыбораЭлемент(Выбор);
	ТД  						= ЭлементФормыДереваВыбора.ТекущиеДанные;
	
	Если Не ТД = Неопределено И Найти(ТД.Представление,"[") И ТД.ВведенВручную Тогда
		сПредставление  =  ТД.Представление;
		сЧисло 			=  СтрЗаменить(СтрЗаменить(сПредставление,"[",""),"]","");
		Попытка
			чЧисло = Макс(Число(сЧисло),0);	
		Исключение
			Возврат;
		КонецПопытки;	
		ТД.Представление = "["+Формат((чЧисло+Направление),"ЧН=0; ЧГ=")+"]";
		Если НеУдалосьВычислитьЗначениеСтроки(ТД,Выбор) Тогда
			ТД.Представление = сПредставление;
		Иначе
			ДеревоЗначенийПриАктивизацииСтроки(Выбор,ЭлементФормыДереваВыбора);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Процедура ДеревоЗначенийПриАктивизацииСтроки(Выбор,Элемент) Экспорт
	Если ТипЗнч(Элемент.ТекущиеДанные) = Тип("ДанныеФормыЭлементДерева") Тогда
		//Если Не Элемент.ТекущиеДанные.Значение = Неопределено Тогда
			Выбор.Форма[Выбор.ИмяЭлемента+"_Путь"]	= вПолучитьПутьКПеременной(Элемент.ТекущиеДанные);
		//Иначе
		//	Путь	= "";
		//КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ДеревоЗначенийПередОкончаниемРедактирования(Выбор, Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)Экспорт
	Если Не ОтменаРедактирования Тогда
		Отказ = НеУдалосьВычислитьЗначениеСтроки(Элемент.ТекущиеДанные,Выбор);
    КонецЕсли;
КонецПроцедуры

//Устанавливаем признак ввода вручную
//
Процедура ДеревоЗначенийПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование) Экспорт
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.ВведенВручную = Истина;	
	КонецЕсли;	
КонецПроцедуры

//Разрещаем копирование только введеных вручную,
//Создание новых только у тех и кого заполнено значение
//
Процедура ДеревоЗначенийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр) Экспорт
	Если Копирование Тогда
		Отказ = Не Элемент.ТекущиеДанные.ВведенВручную;
	Иначе
		Отказ = (Элемент.ТекущиеДанные = Неопределено);
	КонецЕсли;	
КонецПроцедуры

Процедура ДеревоЗначенийПередРазворачиванием(Выбор, Элемент, Строка, Отказ) Экспорт
	СтрокаДЗ = ДеревоВыбора(Выбор).НайтиПоИдентификатору(Строка);
	Если Не СтрокаДЗ = Неопределено Тогда
		Развернуть(СтрокаДЗ, Выбор);
	КонецЕсли;	
КонецПроцедуры

//Разрешем редактирование только введенных вручную
//
Процедура ДеревоЗначенийПередНачаломИзменения(Элемент, Отказ) Экспорт
	Если Не Элемент.ТекущиеДанные = Неопределено Тогда
		Отказ = Не Элемент.ТекущиеДанные.ВведенВручную;
	Иначе 
		Отказ = Истина;
	КонецЕсли;	
КонецПроцедуры

//Закрываем форму, а выбранное значение передаем в ТекущиеДанные
//
Процедура ДеревоЗначенийВыбор(Выбор, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) Экспорт
	СтрокаДЗ = ДеревоВыбора(Выбор).НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Не СтрокаДЗ = Неопределено Тогда
		ЭлементФормыПредставления	= Выбор.Форма.Элементы[Выбор.ИмяЭлемента+"_Представление"];
		ПараметрыСтроки				= ПараметрыСтроки(Выбор,СтрокаДЗ);
		Если Не Поле = ЭлементФормыПредставления И ЗначениеЗаполнено(ПараметрыСтроки.Значение) Тогда
			ПоказатьЗначение(,ПараметрыСтроки.Значение);
		Иначе
			Если вТипРазрешен(Выбор.ОграничениеТипа,ПараметрыСтроки.ОписаниеТипов) Тогда
				Если ЗначениеЗаполнено(ПараметрыСтроки.Значение) Тогда //ИЛИ ЗначениеЗаполнено(СтрокаДЗ.Ссылка) ИЛИ ЗначениеЗаполнено(СтрокаДЗ.КэшПредставление) Тогда
					//выбрали доступную переменную
					Выбор.ТекущиеДанные.ЗначениеПараметра 	= вПолучитьПутьКПеременной(СтрокаДЗ);
					Выбор.ТекущиеДанные.ЭтоВыражение 		= Истина;
					ОкончаниеВыбора(Выбор,Выбор.ТекущиеДанные);
				Иначе
					//просто выбрали тип
					Если ПараметрыСтроки.ОписаниеТипов <> Неопределено Тогда
						Если ПараметрыСтроки.ОписаниеТипов.Типы().Количество() Тогда
							//ЭлементУправления.ОграничениеТипа 	= СтрокаДЗ.ОписаниеТипов;
							Выбор.ТекущиеДанные.ЗначениеПараметра 	= ПараметрыСтроки.ОписаниеТипов.ПривестиЗначение();
							//ЭлементУправления.ВыбиратьТип 			= Ложь;
							Выбор.ТекущиеДанные.ЭтоВыражение		= Ложь;
							ОкончаниеВыбора(Выбор,Выбор.ТекущиеДанные);
						КонецЕсли;	
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Процедура ДеревоВыбораНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение, Выбор)  Экспорт
	Строка = ДеревоВыбора(Выбор).НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение);
	Если Не Строка = Неопределено Тогда
		сз = Новый СписокЗначений;
		Выражение = вПолучитьПутьКПеременной(Строка);
		сз.Добавить(Выражение,Выражение);  //Вмемсто 'Строка.Значение' пишем 'Выражение' и тогда по умолчанию будет становится оно, для перетаскивания из этой формы так лучше, всегда можно пересчитать если снять флаэок "Этовыражение" 
		ПеретаскиваниеКлиент_Ei.НачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение, сз);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

//Вызывается при финальном выборе значения
//
Процедура ОкончаниеВыбора(Выбор,ВыбранноеЗначение)
	Выбор.Форма.ОбработкаВыбора_ВыборТипа(Выбор.ТекущиеДанные);
	ЗакрытьВыбор(Выбор);
КонецПроцедуры	


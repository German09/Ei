#Область ПолучитьОписаниеФормы

// Функция - Сериализовать, Получает описание формы
//
// Параметры:
//  Форма	 			- Форма - Форма, описание которой требуется получить
//  ПутьРеквизитов	 	- Соответствие из Строка - Соответсвие переопределяющее ПутьРеквизитов
// 
// Возвращаемое значение:
//   - Строка - Адрес во временном хранилище структура с описанием формы
//
Функция Сериализовать(Форма, ПутьРеквизитов) Экспорт
	
	ОписаниеФормы = Новый Структура;
	
	//Реквизиты
	ДобавитьРеквизитыФормы(ОписаниеФормы, Форма, ПутьРеквизитов);
	
	//Команды
	ДобавитьКомандыФормы(ОписаниеФормы, Форма, ПутьРеквизитов);
	
	ОписаниеФормы.Вставить("КоманднаяПанель", 		ПолучитьОписаниеЭлемента(Форма.КоманднаяПанель,ПутьРеквизитов));
	ОписаниеФормы.Вставить("ПодчиненныеЭлементы", 	ПолучитьОписаниеЭлементов(Форма.ПодчиненныеЭлементы,ПутьРеквизитов));
	
	//Временное хранилище используется чтобы избежать передачи описания между клиентом и сервером
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(ОписаниеФормы);
	
	Возврат АдресВоВременномХранилище;
	
КонецФункции

//Добавляет в описание формы массив реквизитов формы. В том числе добавленные на форму колонки табличных частей
Процедура ДобавитьРеквизитыФормы(ОписаниеФормы, Форма, ПутьРеквизитов, Знач Путь = "")
	ОписаниеРеквизитов = Новый Массив;
	Для Каждого Реквизит Из Форма.ПолучитьРеквизиты(Путь) Цикл
		ОписаниеРеквизита = Новый Структура;
		//Основные свойства реквизитов
		ДобавитьЗначениеСвойства(ОписаниеРеквизита, Реквизит, "Заголовок", 		ПутьРеквизитов);
		ДобавитьЗначениеСвойства(ОписаниеРеквизита, Реквизит, "Имя",			ПутьРеквизитов);
		ДобавитьЗначениеСвойства(ОписаниеРеквизита, Реквизит, "Путь",			ПутьРеквизитов);
		ПереопределитьПутьКРеквизиту(ОписаниеРеквизита.Путь,Реквизит.Имя,ПутьРеквизитов);
		
		ДобавитьЗначениеСвойства(ОписаниеРеквизита, Реквизит, "СохраняемыеДанные",	ПутьРеквизитов);
		ДобавитьЗначениеСвойства(ОписаниеРеквизита, Реквизит, "ТипЗначения",		ПутьРеквизитов);
		
		Если 	Реквизит.ТипЗначения = Новый ОписаниеТипов("ТаблицаЗначений") ИЛИ
				Реквизит.ТипЗначения = Новый ОписаниеТипов("ДеревоЗначений") Тогда
				
			ВложенныйПуть = ?(ЗначениеЗаполнено(Реквизит.Путь),Реквизит.Путь+"."+Реквизит.Имя, Реквизит.Имя);	
			ДобавитьРеквизитыФормы(ОписаниеРеквизита, Форма, ПутьРеквизитов, ВложенныйПуть);
			
		КонецЕсли;	
		ОписаниеРеквизитов.Добавить(ОписаниеРеквизита);
	КонецЦикла;
	ОписаниеФормы.Вставить("Реквизиты", ОписаниеРеквизитов);
КонецПроцедуры

Процедура ДополнитьКолонкамиТЧ(Реквизит,ОписаниеРеквизитов,Форма,ОбъектМетаданных)
	//Добавляем колонки не существующие в ТЧ объекта и колонки реквизитов с типом ТаблицаЗначений
	Если Реквизит.Имя = "Объект" Или Реквизит.ТипЗначения = Новый ОписаниеТипов("ТаблицаЗначений") Тогда
		
		//Метаданные.Документы[ОбъектМетаданных.Имя].ТабличныеЧасти возвращают массив, поэтому приводим к единообразию
		Если Реквизит.Имя = "Объект" Тогда 
			ТабличныеЧасти = ОбъектМетаданных.ТабличныеЧасти;
		Иначе
			ТабличныеЧасти = Новый Массив;
			ТабличныеЧасти.Добавить(Реквизит.Имя);
		КонецЕсли;
		
		Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
			
			Если Реквизит.Имя = "Объект" Тогда
				КолонкиТЧНаФорме = Форма.Объект[ТабличнаяЧасть.Имя].Выгрузить().Колонки;
			Иначе
				КолонкиТЧНаФорме = Форма[Реквизит.Имя].Выгрузить().Колонки;
			КонецЕсли;
			
			Для Каждого Колонка Из КолонкиТЧНаФорме Цикл
				
				//Колонка "НомерСтроки" служебная и добавляется на форму автоматически
				Если Колонка.Имя = "НомерСтроки" И Реквизит.Имя = "Объект" Тогда
					Продолжить;
				КонецЕсли;
				
				//Для табличных частей объектов требуется создавать только те колонки, которых нет в метаданных
				Если Реквизит.Имя = "Объект" И ТабличнаяЧасть.Реквизиты.Найти(Колонка.Имя) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ОписаниеРеквизита = Новый Структура;
				ОписаниеРеквизита.Вставить("Заголовок", Колонка.Заголовок);
				ОписаниеРеквизита.Вставить("Имя", Колонка.Имя);
				ОписаниеРеквизита.Вставить("ТипЗначения", Колонка.ТипЗначения);
				ОписаниеРеквизита.Вставить("СохраняемыеДанные", Ложь);
				
				//Заменяем "Объект" на "Obj" чтобы избежать конфликтов между объектами источника и приемника
				Если Реквизит.Имя = "Объект" Тогда
					ОписаниеРеквизита.Вставить("Путь", "Obj." + ТабличнаяЧасть.Имя);
				Иначе
					ОписаниеРеквизита.Вставить("Путь", ТабличнаяЧасть);
				КонецЕсли;
				
				ОписаниеРеквизитов.Добавить(ОписаниеРеквизита);
				
			КонецЦикла;
			
		КонецЦикла;
		 
	КонецЕсли;
КонецПроцедуры

//Добавляет в описание формы массив команд формы
Процедура ДобавитьКомандыФормы(ОписаниеФормы, Форма, ПутьРеквизитов)
	
	ОписаниеКоманд = Новый Массив;
	
	Для Каждого Команда Из Форма.Команды Цикл
		
		ОписаниеКоманды = Новый Структура;
		
		ДобавитьЗначениеСвойства(ОписаниеКоманды, Команда, "Действие",					ПутьРеквизитов);
		ДобавитьЗначениеСвойства(ОписаниеКоманды, Команда, "Заголовок",					ПутьРеквизитов);
		ДобавитьЗначениеСвойства(ОписаниеКоманды, Команда, "ИзменяетСохраняемыеДанные",	ПутьРеквизитов);
		ДобавитьЗначениеСвойства(ОписаниеКоманды, Команда, "Имя",							ПутьРеквизитов);
		ДобавитьЗначениеСвойства(ОписаниеКоманды, Команда, "ИспользованиеТекущейСтроки",	ПутьРеквизитов);
		ДобавитьЗначениеСвойства(ОписаниеКоманды, Команда, "ИспользуемаяТаблица",			ПутьРеквизитов);
		ДобавитьЗначениеСвойства(ОписаниеКоманды, Команда, "Картинка",					ПутьРеквизитов);
		ДобавитьЗначениеСвойства(ОписаниеКоманды, Команда, "Отображение",					ПутьРеквизитов);
		ДобавитьЗначениеСвойства(ОписаниеКоманды, Команда, "Подсказка",					ПутьРеквизитов);
		ДобавитьЗначениеСвойства(ОписаниеКоманды, Команда, "СочетаниеКлавиш",				ПутьРеквизитов);
		
		ОписаниеКоманд.Добавить(ОписаниеКоманды);
		
	КонецЦикла;
	
	ОписаниеФормы.Вставить("Команды", ОписаниеКоманд);
	
КонецПроцедуры

//Добавляет свойства элемента 
Процедура ДобавитьОписание(ОписаниеЭлемента, Элемент, ПутьРеквизитов)
	Перем Тип,Расширение;
	Для Каждого ИмяСвойства ИЗ НаследованиеФормКлиентСервер_Ei.ПолучитьСвойства(Элемент,Тип,Расширение) Цикл
		ДобавитьЗначениеСвойства(ОписаниеЭлемента.Свойства, Элемент, ИмяСвойства, ПутьРеквизитов);		
	КонецЦикла;	
	События 		= НаследованиеФормСерверПовтИсп_Ei.ПолучитьСобытияЭлемента(Тип,Расширение);
	//Если стрРасширение =  Неопределено Тогда
	//	стрКлючУникальности = стрТип;
	//Иначе
	//	стрКлючУникальности = Сред(стрРасширение,Найти(стрРасширение,".")+1);
	//КонецЕсли;	
	Для Каждого стрСобытие ИЗ События Цикл
		стрДействие = Элемент.ПолучитьДействие(стрСобытие.Значение);
		Если Не ПустаяСтрока(стрДействие) Тогда
			ОписаниеЭлемента.События.Вставить(стрСобытие.Значение,стрДействие);//стрСобытие.Значение+"_"+стрКлючУникальности);
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры



//Процедура для копирования свойств в структуру с описанием
Процедура ДобавитьЗначениеСвойства(ОписаниеЭлемента, Элемент, ИмяСвойства, ПутьРеквизитов)
	ОписаниеЭлФ = Новый ОписаниеТипов("ЭлементыФормы");
	Попытка
		Если Не ИмяСвойства =  "Родитель" Тогда
			Значение = Элемент[ИмяСвойства];
			Если Не Значение = Неопределено И НаследованиеФормСерверПовтИсп_Ei.ПолучитьСериализованныеТипы().СодержитТип(ТипЗнч(Значение)) Тогда
				ОписаниеЭлемента.Вставить(ИмяСвойства, ПолучитьОписаниеЭлемента(Значение, ПутьРеквизитов));
			ИначеЕсли ПроверкаЗагадочногоУсловия(Значение) Тогда 
				ОписаниеЭлемента.Вставить(ИмяСвойства, ПолучитьОписаниеЭлементов(Значение,ПутьРеквизитов));
			Иначе	
				ОписаниеЭлемента.Вставить(ИмяСвойства, Значение);
			КонецЕсли;
		КонецЕсли;	
	Исключение
		НаследованиеФормКлиентСервер_Ei.ОбработкаОшибкиПолученияСвойства(Элемент,ИмяСвойства);
	КонецПопытки;	
КонецПроцедуры


//Возвращает структуру с описанием всех свойств элемента, включая подчиненные элементы для групп и для таблиц
Функция ПолучитьОписаниеЭлемента(Элемент,ПутьРеквизитов)
	ОписаниеЭлемента = Новый Структура("Свойства,События", Новый Структура,Новый Структура);
	//Чтобы отличать корневые элементы от остальных для корневых в качестве родителя передаем "Неопределено"
	Если ТипЗнч(Элемент.Родитель) = Тип("УправляемаяФорма") Тогда
		ОписаниеЭлемента.Свойства.Вставить("Родитель", Неопределено);
	Иначе
		ОписаниеЭлемента.Свойства.Вставить("Родитель", Элемент.Родитель.Имя);
	КонецЕсли;
	//Основные свойства элемента
	ОписаниеЭлемента.Свойства.Вставить("ТипЭлемента", ТипЗнч(Элемент));
	ДобавитьОписание(ОписаниеЭлемента, Элемент, ПутьРеквизитов);
	Если ОписаниеЭлемента.Свойства.Свойство("ПутьКДанным") Тогда
		ПереопределитьПутьКРеквизиту(ОписаниеЭлемента.Свойства.ПутьКДанным,"",ПутьРеквизитов)	
	КонецЕсли;	
	Возврат ОписаниеЭлемента;
КонецФункции

//Возвращает массив с описаниями элементов, входящих в коллекцию
Функция ПолучитьОписаниеЭлементов(КоллекцияЭлементовФормы,ПутьРеквизитов)
	ОписаниеКоллекции = Новый Массив;
	Для Каждого Элемент Из КоллекцияЭлементовФормы Цикл
		ОписаниеЭлемента = ПолучитьОписаниеЭлемента(Элемент,ПутьРеквизитов);
		ОписаниеКоллекции.Добавить(ОписаниеЭлемента);
	КонецЦикла;
	Возврат ОписаниеКоллекции;
КонецФункции

#КонецОбласти


#Область ЗаполнитьФормуПоОписанию

// Процедура - Структурировать. Добавить в форму элементы. команды и реквизиты из описания
//
// Параметры:
//  Форма						- Форма - Форма, в которую происходит добавление элементов, команды и реквизиты
//	ЭлементРодительИмя          - Строка - Имя элемена формы, под который добавляются все элменты
//  АдресВоВременномХранилище	- Строка - Временное хранилище, в котором находится описание формы
//  ЭлементКПИмя				- Строка - Имя элемента формы в который будет помещаться командная панель		 
//
Процедура Структурировать(Форма, ЭлементРодительИмя, АдресВоВременномХранилище, ЭлементКПИмя = Неопределено) Экспорт
	
	ОписаниеФормы = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	
	//Реквизиты
	СоздатьРеквизитыФормы(Форма, ОписаниеФормы);
	
	//Команды
	с_СоздатьКомандыФормы(Форма, ОписаниеФормы, ЭлементРодительИмя);
	
	//Свойства и элементы формы
	//с_ЗаполнитьСвойстваФормы(Форма, ОписаниеФормы);
	СоздатьЭлементы(Форма, ОписаниеФормы.ПодчиненныеЭлементы, ЭлементРодительИмя,,Истина);
	
	Если Не ЭлементКПИмя = Неопределено Тогда
		//размещаем элементы командной панели
		СоздатьЭлементы(Форма, ОписаниеФормы.КоманднаяПанель.Свойства.ПодчиненныеЭлементы, ЭлементКПИмя, Форма.Элементы[ЭлементКПИмя]);			
	КонецЕсли;
КонецПроцедуры

//Создает на форме реквизиты по переданному описанию
Процедура СоздатьРеквизитыФормы(Форма, ОписаниеФормы)
	ДобавляемыеРеквизиты = Новый Массив;
	ЗаполнитьМассивРеквизитов(Форма, ОписаниеФормы, ДобавляемыеРеквизиты);
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
КонецПроцедуры

Процедура ЗаполнитьМассивРеквизитов(Форма, Описание, ДобавляемыеРеквизиты,ПроверятьНаличие = Истина)
	//мСущРеквизитов = ?(ПроверятьНаличие,Форма.ПолучитьРеквизиты(Путь),Новый Массив);
	Для Каждого ОписаниеРеквизита Из Описание.Реквизиты Цикл
		Добавляем 	= Истина;
		//проверим существует ли такой реквизит на форме
		Если ПроверятьНаличие Тогда
			Для Каждого СущРеквизит ИЗ Форма.ПолучитьРеквизиты(ОписаниеРеквизита.Путь) Цикл
				Если нРег(СущРеквизит.Имя) = нРег(ОписаниеРеквизита.Имя) Тогда
					Добавляем 	= Ложь;	
					Прервать;
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;	
		Если Добавляем Тогда
			ТипЗначения =  ТипыКлиентСервер_Ei.ПроверитьОписание(ОписаниеРеквизита.ТипЗначения);
			Реквизит 	= Новый РеквизитФормы(ОписаниеРеквизита.Имя, ТипЗначения, ОписаниеРеквизита.Путь, ОписаниеРеквизита.Заголовок);
			с_ЗаполнитьЗначениеСвойства(Реквизит, ОписаниеРеквизита, "СохраняемыеДанные");
			ДобавляемыеРеквизиты.Добавить(Реквизит);
		КонецЕсли;
		Если ОписаниеРеквизита.Свойство("Реквизиты") Тогда
			ВложенныйПуть = ?(ЗначениеЗаполнено(ОписаниеРеквизита.Путь),ОписаниеРеквизита.Путь+"."+ОписаниеРеквизита.Имя, ОписаниеРеквизита.Имя);
			ЗаполнитьМассивРеквизитов(Форма,ОписаниеРеквизита,ДобавляемыеРеквизиты,НЕ Добавляем);
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры	

//Создает на форме команды по переданному описанию
Процедура с_СоздатьКомандыФормы(Форма, ОписаниеФормы, ЭлементРодительИмя)
	
	Для Каждого ОписаниеКоманды Из ОписаниеФормы.Команды Цикл
		
		Команда = Форма.Команды.Добавить(ПереопределитьИмяКоманды(ОписаниеКоманды.Имя,ЭлементРодительИмя));
		Команда.Действие =  "Команда"; //действие, всегда команда
		//с_ЗаполнитьЗначениеСвойства(Команда, ОписаниеКоманды, "Действие");
		с_ЗаполнитьЗначениеСвойства(Команда, ОписаниеКоманды, "Заголовок");
		с_ЗаполнитьЗначениеСвойства(Команда, ОписаниеКоманды, "ИзменяетСохраняемыеДанные");
		с_ЗаполнитьЗначениеСвойства(Команда, ОписаниеКоманды, "ИспользованиеТекущейСтроки");
		с_ЗаполнитьЗначениеСвойства(Команда, ОписаниеКоманды, "ИспользуемаяТаблица");
		с_ЗаполнитьЗначениеСвойства(Команда, ОписаниеКоманды, "Картинка");
		с_ЗаполнитьЗначениеСвойства(Команда, ОписаниеКоманды, "Отображение");
		с_ЗаполнитьЗначениеСвойства(Команда, ОписаниеКоманды, "Подсказка");
		с_ЗаполнитьЗначениеСвойства(Команда, ОписаниеКоманды, "СочетаниеКлавиш");
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПереопределитьИмяКоманды(Имя,РодительИмя)
	Результат =  "";
	Если Не ПустаяСтрока(Имя) Тогда
		Результат = РодительИмя + НаследованиеФормКлиентСервер_Ei.стрРазделительИмени() + Имя;
	КонецЕсли;	
	Возврат Результат; 
КонецФункции

//Получает полное имя команды в зависимости от окончания
//
Функция ПолучитьПолноеИмяКоманды(Форма,Окончание)
	Результат = "";
	Для Каждого Команда ИЗ Форма.Команды Цикл
		Если СтрЗаканчиваетсяНа(нРег(Команда.Имя),НаследованиеФормКлиентСервер_Ei.стрРазделительИмени() + нРег(Окончание)) Тогда
			Результат = Команда.Имя;
			Прервать;
		КонецЕсли;				
	КонецЦикла;
	Возврат Результат; 		
КонецФункции	

Процедура ПереопределитьПутьКРеквизиту(Путь,ИмяРеквизита,ПутьРеквизитов)
	Если Не ПутьРеквизитов = Неопределено Тогда
		Если ПустаяСтрока(Путь) Тогда
			НовыйПуть = ПутьРеквизитов.Получить(ИмяРеквизита);	
			Если Не НовыйПуть = Неопределено Тогда
				Путь = НовыйПуть			
			КонецЕсли;	
		Иначе	
			Для Каждого Элемент ИЗ ПутьРеквизитов Цикл
				Если СтрНачинаетсяС(Путь,Элемент.Ключ) Тогда
					Путь = Элемент.Значение+"."+Путь;
					Прервать;
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	


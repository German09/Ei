//Заполняет свойства 
Процедура ЗаполнитьСвойства(Форма, Элемент, ОписаниеЭлемента, ЭлементРодительИмя)
	мСвойствИсключений =  Новый Массив;
	мСвойствИсключений.Добавить("ПутьКДанным");
	мСвойствИсключений.Добавить("ТипЭлемента");
	мСвойствИсключений.Добавить("Родитель");
	
	Если ОписаниеЭлемента.Свойства.Свойство("ПутьКДанным") Тогда
		//Заполним вначале его а то не получится установить ПутьКданным в подчиненных реквизитах 
		с_ЗаполнитьЗначениеСвойства(Элемент, ОписаниеЭлемента.Свойства, "ПутьКДанным");
	КонецЕсли;
	
	Если ОписаниеЭлемента.Свойства.Свойство("ИмяКоманды") Тогда
		//переопределеим, а заполним уже в основном цикле
		ОписаниеЭлемента.Свойства.ИмяКоманды = ПолучитьПолноеИмяКоманды(Форма,ОписаниеЭлемента.Свойства.ИмяКоманды);//ПереопределитьИмяКоманды(ОписаниеЭлемента.Свойства.ИмяКоманды,ЭлементРодительИмя);
	КонецЕсли;
	
	Для Каждого КлючЗначение ИЗ ОписаниеЭлемента.Свойства Цикл
		Если мСвойствИсключений.Найти(КлючЗначение.Ключ) = Неопределено	Тогда
			Если ТипЗнч(КлючЗначение.Значение) = Тип("Массив") Тогда
				СоздатьЭлементы(Форма, КлючЗначение.Значение, ЭлементРодительИмя,,Истина);	
			ИначеЕсли ТипЗнч(КлючЗначение.Значение) = Тип("Структура") Тогда
				ЗаполнитьСвойства(Форма, Элемент[КлючЗначение.Ключ], КлючЗначение.Значение, ЭлементРодительИмя);	
			Иначе
				с_ЗаполнитьЗначениеСвойства(Элемент, ОписаниеЭлемента.Свойства, КлючЗначение.Ключ);	
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	Для Каждого КлючЗначение ИЗ ОписаниеЭлемента.События Цикл
		Элемент.УстановитьДействие(КлючЗначение.Ключ,КлючЗначение.Значение);		
	КонецЦикла;	
КонецПроцедуры

//Процедура для заполнения конкретного свойства из описания
Процедура с_ЗаполнитьЗначениеСвойства(Элемент, ОписаниеЭлемента, ИмяСвойства);
	Попытка
		Если Элемент[ИмяСвойства] <> ОписаниеЭлемента[ИмяСвойства] Тогда
			Элемент[ИмяСвойства] = ОписаниеЭлемента[ИмяСвойства];
		КонецЕсли;
	Исключение
		стрКраткое = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		//Если Не Найти(стрКраткое,"недоступно") Тогда
			ТекстОшибки = "Ошибка "+?(ЗначениеЗаполнено(Элемент[ИмяСвойства]),"изменения","установки")+" свойства <"+ИмяСвойства+"> для "+ТипЗнч(Элемент)+" - "+Элемент.Имя+" ";
			ТекстОшибки = ТекстОшибки + "Значение "+?(ЗначениеЗаполнено(Элемент[ИмяСвойства]),""+Элемент[ИмяСвойства]+"->","")+ОписаниеЭлемента[ИмяСвойства]; 
			Сообщить(стрКраткое+"-"+ТекстОшибки,СтатусСообщения.Важное);
			//Если ошибка в установке своства ПутьКДанным, проверьте на дублирование элементов, тоесть по какой то причине элемент заполняется вновь
			//Например: есть свойство ТекущаяСтраница, описание которого приводит к повторонрму заполнению свойств элементов формы, а ПутьКДанным после его заполнения сложно поменять
			//своство путь к Даннм после установки ДеревоЗапросов.ДоступныеОбработки становится = Элементы.ДеревоЗапросов.ТекущиеДанные.ДоступныеОбработки
			//повторное изменение этого своства приводит к ошибке	
		//КонецЕсли;	
	КонецПопытки;	
КонецПроцедуры

// Процедура для создания элементов по списку описаний
//
// Параметры:
//  Форма				 - Форма - Форма в которую добавляются элементы
//  ОписаниеКоллекции	 - Массив - Массив описаний всех добавляемых элементов
//  ЭлементРодительИмя	 - Строка - Имя элемента родителя под который добавляются элементы
//
Процедура СоздатьЭлементы(Форма, ОписаниеКоллекции, ЭлементРодительИмя, Родитель = Неопределено, ПроверятьРодителя = Ложь)
	Для Каждого ОписаниеЭлемента Из ОписаниеКоллекции Цикл
		Если Родитель = Неопределено Тогда
			//"Неопределено" в качестве родителя записано у корневых элементов
			Если ОписаниеЭлемента.Свойства.Родитель = Неопределено Тогда
				Если ЭлементРодительИмя = Неопределено Тогда
					РодительНастоящий = Форма;
				Иначе
					РодительНастоящий = Форма.Элементы[ЭлементРодительИмя];
				КонецЕсли;
			Иначе
				РодительНастоящий = Форма.Элементы[ОписаниеЭлемента.Свойства.Родитель];
			КонецЕсли;
		Иначе
			РодительНастоящий = Родитель;	
		КонецЕсли;	
		//Создаем элемент на форме, если он не найден
		Элемент = Форма.Элементы.Найти(ОписаниеЭлемента.Свойства.Имя);
		Если Элемент = Неопределено Тогда
			СледующийЭлемент 	= ПолучитьСледующийЭлемент(Форма,ОписаниеКоллекции,ОписаниеЭлемента,РодительНастоящий);
			Попытка
				Элемент 			= Форма.Элементы.Вставить(ОписаниеЭлемента.Свойства.Имя, ОписаниеЭлемента.Свойства.ТипЭлемента, РодительНастоящий, СледующийЭлемент);
			Исключение
				ТекстОшибки =  "Не удалось добавить на форму "+ОписаниеЭлемента.Свойства.ТипЭлемента+" с именем <"+ОписаниеЭлемента.Свойства.Имя+"> возможно он уже существует";
				//Сообщить(ТекстОшибки,СтатусСообщения.Важное);
				ВызватьИсключение ТекстОшибки;
			КонецПопытки;
		ИначеЕсли ПроверятьРодителя И Не РодительНастоящий = Неопределено Тогда
			//если найден проверим его родителя возможно необходимо перенести
			Если Не РодительНастоящий = Элемент.Родитель Тогда
				//Сообщить("Не оригинальный родитель у "+Элемент.Имя);
				СледующийЭлемент 	= ПолучитьСледующийЭлемент(Форма,ОписаниеКоллекции,ОписаниеЭлемента,РодительНастоящий);
				Попытка
					Форма.Элементы.Переместить(Элемент,РодительНастоящий,СледующийЭлемент); 
				Исключение
					ТекстОшибки =  "Не удалось переместить элемент на форме с именем <"+Элемент.Имя+">";
					//Сообщить(ТекстОшибки,СтатусСообщения.Важное);
					ВызватьИсключение ТекстОшибки;
				КонецПопытки;	
			КонецЕсли;	  				
		КонецЕсли;
	    //Заполняем элемент в соответствии с описанием
		ЗаполнитьСвойства(Форма, Элемент, ОписаниеЭлемента, ЭлементРодительИмя);
	КонецЦикла;
КонецПроцедуры

// Функция - Получает следующий элмент формы описанный в массиве коллекции
//
// Параметры:
//  Форма			 - Форма - Форма в которую добавляются элементы 
//  Коллекция		 - Массив	 - Массив описаний всех добавляемых элементов
//  ЭлементКоллекции - Структура - Текущий элемент расположенный в массиве 
// 
// Возвращаемое значение:
//   - Найденный элемент формы или неопределенно
//
Функция ПолучитьСледующийЭлемент(Форма,Коллекция,ЭлементКоллекции,Родитель)
	чИндекс = Коллекция.Найти(ЭлементКоллекции);
	Если чИндекс < Коллекция.ВГраница() Тогда
		СледущийЭлКоллекции = Коллекция[чИндекс+1];
		Возврат   Родитель.ПодчиненныеЭлементы.Найти(СледущийЭлКоллекции.Свойства.Имя); //Ищем именно у родителя важно чтобы следующий был именно в этой группе
	КонецЕсли;	
Конецфункции	

#КонецОбласти

#Область СлежубныеФункцииПодготовкиРелиза

// Функция - Формирует текст моудля 
//
// Параметры:
//  ТипМодуля	 - Строка - Варианты значения:
//					          			МодульФормы - область События_ВФормеНазначения модуля формы наследника
//                                      ОбщийМодуль	- область ПереопределенияСобытий общего модуля НаследованиеФормКлиент_Ei
// Возвращаемое значение:
//   - Строка
//
Функция ПолучитьМодуль(ТипМодуля = "МодульФормы") Экспорт
	Результат 	= "";
	ТабСобытий  = НаследованиеФормСерверПовтИсп_Ei.ПолучитьВсеСобытия();
	ТЗ_Тип = ТабСобытий.Скопировать(,"Тип");
	ТЗ_Тип.Свернуть("Тип");
	ТЗ_Расширение = ТабСобытий.Скопировать(,"Расширение");
	ТЗ_Расширение.Свернуть("Расширение");
	мТипов 		= ТЗ_Тип.ВыгрузитьКолонку("Тип");
	мРасширений = ТЗ_Расширение.ВыгрузитьКолонку("Расширение");
	
	Для Каждого Тип ИЗ мТипов Цикл
		Если ЭтоОбщийМоудуль(ТипМодуля) Тогда
			Результат =  Результат+Символы.ПС+"#Область "+ПолучитьПредставлениеТипа(Тип);
		КонецЕсли;	
		ДляТипаЕстьРасширения = Ложь;
		Для Каждого Расширение ИЗ мРасширений Цикл
			ПолучилиСобытияРасширения =  Ложь;
			Если Не ПустаяСтрока(Расширение) Тогда
				ВывелиОбластьРасширения = Ложь;
				Для Каждого Строка ИЗ ТабСобытий.НайтиСтроки(Новый Структура("Тип,Расширение",Тип,Расширение)) Цикл
					Если Не ВывелиОбластьРасширения Тогда
						ВывелиОбластьРасширения = Истина;
						Если ЭтоОбщийМоудуль(ТипМодуля) Тогда
							Результат =  Результат+Символы.ПС+"#Область "+ПолучитьПредставлениеРасширения(Расширение);
						КонецЕсли;
					КонецЕсли;			
					ДополнитьМодуль(ТипМодуля,Результат,Строка);
					ПолучилиСобытияРасширения 	= Истина;
				КонецЦикла;
				Если ПолучилиСобытияРасширения Тогда
					ДляТипаЕстьРасширения = Истина; 
					//расширим события событиями родителя
					Для Каждого Строка ИЗ ТабСобытий.НайтиСтроки(Новый Структура("Тип,Расширение",Тип,"")) Цикл
						ДополнитьМодуль(ТипМодуля,Результат,Строка,ПолучитьПредставлениеРасширения(Расширение));
					КонецЦикла;
					Если ЭтоОбщийМоудуль(ТипМодуля) Тогда
						Результат =  Результат+Символы.ПС+"#КонецОбласти";
					КонецЕсли;		
				КонецЕсли;	
			КонецЕСли;	
		КонецЦикла;
		Если Не ДляТипаЕстьРасширения Тогда
			Для Каждого Строка ИЗ ТабСобытий.НайтиСтроки(Новый Структура("Тип,Расширение",Тип,"")) Цикл
				ДополнитьМодуль(ТипМодуля,Результат,Строка);
			КонецЦикла;
		КонецЕсли;
		Если ЭтоОбщийМоудуль(ТипМодуля) Тогда
			Результат =  Результат+Символы.ПС+"#КонецОбласти";
		КонецЕсли;		
	КонецЦикла;	
	Возврат Результат;
КонецФункции

Функция ПолучитьСвойстваЭлемента(Тип,Расширение) Экспорт
	Возврат НаследованиеФормСерверПовтИсп_Ei.ПолучитьСвойстваЭлемента(Тип,Расширение);
КонецФункции	

Функция ЭтоОбщийМоудуль(Знач ТипМодуля)
	Возврат нРег(ТипМодуля) = нРег("ОбщийМодуль");
КонецФункции

Процедура ДополнитьМодуль(ТипМодуля,Результат,Строка,стрДопУникальности="")
	Если нРег(ТипМодуля) = нРег("МодульФормы") Тогда
		ДополнитьМодульФормыПриемника(Результат,Строка,стрДопУникальности);	
	ИначеЕсли ЭтоОбщийМоудуль(ТипМодуля) Тогда
		ДополнитьОбщийМодульНаследования(Результат,Строка,стрДопУникальности);
	КонецЕсли;	
КонецПроцедуры

Процедура ДополнитьМодульФормыПриемника(Результат,Строка,стрДопУникальности)
	Если Не ПустаяСтрока(Строка.Аргументы) Тогда
		стрКлючУникальности = ПолучитьПредставлениеТипа(Строка.Тип) + ПолучитьПредставлениеРасширения(Строка.Расширение) + стрДопУникальности;			
		стрИмяПроцедуры 	= Строка.Значение+"_"+стрКлючУникальности;
		стрАргументы 		= СтрЗаменить(СтрЗаменить(Строка.Аргументы,"(","(Элемент, "),", )",")");
		Результат = Результат+
					Символы.ПС+"&НаКлиенте"+
					СтрЗаменить(
						Символы.ПС+"Процедура "+стрИмяПроцедуры+стрАргументы+
						Символы.ПС+Символы.Таб+"НаследованиеФормКлиент_Ei."+стрИмяПроцедуры+СтрЗаменить(стрАргументы,"(","(ЭтотОбъект, ")+
						Символы.ПС+"КонецПроцедуры"
					,Символы.ПС," "); //сокрашенный формат записи
	КонецЕсли;
КонецПроцедуры

Процедура ДополнитьОбщийМодульНаследования(Результат,Строка,стрДопУникальности)
	Если Не ПустаяСтрока(Строка.Аргументы) Тогда
		стрКлючУникальности = ПолучитьПредставлениеТипа(Строка.Тип) + ПолучитьПредставлениеРасширения(Строка.Расширение) + стрДопУникальности;
		стрИмяПроцедуры 	= Строка.Значение+"_"+стрКлючУникальности;
		стрАргументы 		= СтрЗаменить(СтрЗаменить(Строка.Аргументы,"(","(ФормаПотомок, Элемент, "),", )",")");
		Результат = Результат+
					Символы.ПС+"Процедура "+стрИмяПроцедуры+стрАргументы+" Экспорт"+
					Символы.ПС+Символы.Таб+"ФормаРодитель = ПолучитьФормуРодителя(ФормаПотомок, Элемент);"+
					Символы.ПС+Символы.Таб+"Если Не ФормаРодитель = Неопределено Тогда"+	
					Символы.ПС+Символы.Таб+Символы.Таб+"ФормаРодитель."+стрИмяПроцедуры+СтрЗаменить(стрАргументы,"ФормаПотомок, ","")+";"+
					Символы.ПС+Символы.Таб+"КонецЕсли;"+
					Символы.ПС+"КонецПроцедуры"
	КонецЕсли;	
КонецПроцедуры

Функция ПолучитьПредставлениеРасширения(Расширение)
	Результат = "";
	мСтрок = СтрРазделить(Расширение,".");
	Если мСтрок.ВГраница() Тогда
		Результат = мСтрок[1];		
	КонецЕсли;	
	Возврат Результат;
КонецФункции

Функция ПолучитьПредставлениеТипа(Тип)
	сТипов = Новый Соответствие;
	сТипов.Вставить("FormGroup","ГруппаФормы");
	сТипов.Вставить("FormTable","ТаблицаФормы");
	сТипов.Вставить("FormField","ПолеФормы");
	сТипов.Вставить("FormButton","КнопкаФормы");
	сТипов.Вставить("FormDecoration","ДекорацияФормы");
	Возврат сТипов.Получить(Тип);
КонецФункции	


#КонецОбласти
   
//Заполняет свойства элемента с типом ТаблицаФормы
Процедура с_ЗаполнитьСвойства(Форма, Элемент, ОписаниеЭлемента, ЭлементРодительИмя)
	мСвойствИсключений =  Новый Массив;
	мСвойствИсключений.Добавить("ПутьКДанным");
	мСвойствИсключений.Добавить("ТипЭлемента");
	мСвойствИсключений.Добавить("Родитель");
	
	Если ОписаниеЭлемента.Свойства.Свойство("ПутьКДанным") Тогда
		//Заполним вначале его а то не получится установить ПутьКданным в подчиненных реквизитах 
		с_ЗаполнитьЗначениеСвойства(Элемент, ОписаниеЭлемента.Свойства, "ПутьКДанным");
	КонецЕсли;
	
	Если ОписаниеЭлемента.Свойства.Свойство("ИмяКоманды") Тогда
		//переопределеим, а заполним уже в основном цикле
		ОписаниеЭлемента.Свойства.ИмяКоманды = ПереопределитьИмяКоманды(ОписаниеЭлемента.Свойства.ИмяКоманды,ЭлементРодительИмя);
	КонецЕсли;
	
	Для Каждого КлючЗначение ИЗ ОписаниеЭлемента.Свойства Цикл
		Если мСвойствИсключений.Найти(КлючЗначение.Ключ) = Неопределено	Тогда
			Если ТипЗнч(КлючЗначение.Значение) = Тип("Массив") Тогда
				с_СоздатьЭлементы(Форма, КлючЗначение.Значение, ЭлементРодительИмя);	
			ИначеЕсли ТипЗнч(КлючЗначение.Значение) = Тип("Структура") Тогда
				с_ЗаполнитьСвойства(Форма, Элемент[КлючЗначение.Ключ], КлючЗначение.Значение, ЭлементРодительИмя);	
			Иначе
				с_ЗаполнитьЗначениеСвойства(Элемент, ОписаниеЭлемента.Свойства, КлючЗначение.Ключ);	
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	Для Каждого КлючЗначение ИЗ ОписаниеЭлемента.События Цикл
		Элемент.УстановитьДействие(КлючЗначение.Ключ,КлючЗначение.Значение);		
	КонецЦикла;	
КонецПроцедуры

//Процедура для заполнения конкретного свойства из описания
Процедура с_ЗаполнитьЗначениеСвойства(Элемент, ОписаниеЭлемента, ИмяСвойства);
	Попытка
		Если Элемент[ИмяСвойства] <> ОписаниеЭлемента[ИмяСвойства] Тогда
			Элемент[ИмяСвойства] = ОписаниеЭлемента[ИмяСвойства];
		КонецЕсли;
	Исключение
		стрКраткое = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		//Если Не Найти(стрКраткое,"недоступно") Тогда
			Сообщить("Свойство "+ИмяСвойства+" для "+ТипЗнч(Элемент)+" "+стрКраткое,СтатусСообщения.Важное);
		//КонецЕсли;	
	КонецПопытки;	
КонецПроцедуры

//Процедура для создания элементов по списку описаний
Процедура с_СоздатьЭлементы(Форма, ОписаниеКоллекции, ЭлементРодительИмя)
	
	Для Каждого ОписаниеЭлемента Из ОписаниеКоллекции Цикл
		
		//"Неопределено" в качестве родителя записано у корневых элементов
		Если ОписаниеЭлемента.Свойства.Родитель = Неопределено Тогда
			Если ЭлементРодительИмя = Неопределено Тогда
				Родитель = Форма;
			Иначе
				Родитель = Форма.Элементы[ЭлементРодительИмя];
			КонецЕсли;
		Иначе
			Родитель = Форма.Элементы[ОписаниеЭлемента.Свойства.Родитель];
		КонецЕсли;
		
		//Создаем элемент на форме, если он не найден
		Элемент = Форма.Элементы.Найти(ОписаниеЭлемента.Свойства.Имя);
		Если Элемент = Неопределено Тогда
			Элемент = Форма.Элементы.Добавить(ОписаниеЭлемента.Свойства.Имя, ОписаниеЭлемента.Свойства.ТипЭлемента, Родитель);
			
			//Заполняем элемент в соответствии с описанием
			с_ЗаполнитьСвойства(Форма, Элемент, ОписаниеЭлемента, ЭлементРодительИмя);
		КонецЕСли;	
			
	КонецЦикла;

КонецПроцедуры


#КонецОбласти

#Область СлежубныеФункцииПодготовкиРелиза

// Функция - Формирует текст области События_ВФормеНазначения модуля формы наследника
// 
// Возвращаемое значение:
//   - Строка
//
Функция ПолучитьМодульФормыПриемника() Экспорт
	Результат =  "";
	Для Каждого Строка ИЗ НаследованиеФормСерверПовторноеИспользование_Ei.ПолучитьВсеСобытия() Цикл
		Если Не ПустаяСтрока(Строка.Аргументы) Тогда
			Если Не Найти(Строка.Тип,".") Тогда
				стрКлючУникальности = Строка.Тип;
			Иначе
				стрКлючУникальности = Сред(Строка.Тип,Найти(Строка.Тип,".")+1);
			КонецЕсли;
			стрИмяПроцедуры = Строка.Значение+"_"+стрКлючУникальности;
			стрАргументы 	= СтрЗаменить(СтрЗаменить(Строка.Аргументы,"(","(Элемент, "),", )",")");
			Результат = Результат+
						Символы.ПС+"&НаКлиенте"+
						Символы.ПС+"Процедура "+стрИмяПроцедуры+стрАргументы+
						Символы.ПС+Символы.Таб+"НаследованиеФормКлиент_Ei."+стрИмяПроцедуры+СтрЗаменить(стрАргументы,"(","(ЭтаФорма, ")+
						Символы.ПС+"КонецПроцедуры"
		КонецЕсли;	
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Функция - Формирует тест области ПереопределенияСобытий общего модуля НаследованиеФормКлиент_Ei
// 
// Возвращаемое значение:
//   - Строка
//
Функция ПолучитьМодульНаследования() Экспорт
	Результат =  "";
	Для Каждого Строка ИЗ НаследованиеФормСерверПовторноеИспользование_Ei.ПолучитьВсеСобытия() Цикл
		Если Не ПустаяСтрока(Строка.Аргументы) Тогда
			Если Не Найти(Строка.Тип,".") Тогда
				стрКлючУникальности = Строка.Тип;
			Иначе
				стрКлючУникальности = Сред(Строка.Тип,Найти(Строка.Тип,".")+1);
			КонецЕсли;
			стрИмяПроцедуры = Строка.Значение+"_"+стрКлючУникальности;
			стрАргументы 	= СтрЗаменить(СтрЗаменить(Строка.Аргументы,"(","(ФормаПотомок, Элемент, "),", )",")");
			Результат = Результат+
						Символы.ПС+"Процедура "+стрИмяПроцедуры+стрАргументы+" Экспорт"+
						Символы.ПС+Символы.Таб+"ФормаРодитель = ПолучитьФормуРодителя(ФормаПотомок, Элемент);"+
						Символы.ПС+Символы.Таб+"Если Не ФормаРодитель = Неопределено Тогда"+	
						Символы.ПС+Символы.Таб+Символы.Таб+"ФормаРодитель."+стрИмяПроцедуры+СтрЗаменить(стрАргументы,"ФормаПотомок, ","")+";"+
						Символы.ПС+Символы.Таб+"КонецЕсли;"+
						Символы.ПС+"КонецПроцедуры"
		КонецЕсли;	
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти


   
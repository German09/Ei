//Добавляет свойства элемента 
Процедура с_ДобавитьОписание(ОписаниеЭлемента, Элемент)
	стрТип 			= ОбщийМодульКлиентСервер_Ei.ПолучитьИмяТипЗнч(ТипЗнч(Элемент));
	стрРасширение	= ПолучитьЗначениеРасширения(Элемент);
	Свойства 		= НаследованиеФормСерверПовторноеИспользование_Ei.ПолучитьСвойстваЭлемента(стрТип,стрРасширение);
	Для Каждого стрСвойства ИЗ Свойства Цикл
		с_ДобавитьЗначениеСвойства(ОписаниеЭлемента.Свойства, Элемент, стрСвойства.Значение);		
	КонецЦикла;	
	
	События 		= НаследованиеФормСерверПовторноеИспользование_Ei.ПолучитьСобытияЭлемента(стрТип,стрРасширение);
	Если стрРасширение =  Неопределено Тогда
		стрКлючУникальности = стрТип;
	Иначе
		стрКлючУникальности = Сред(стрРасширение,Найти(стрРасширение,".")+1);
	КонецЕсли;	
	Для Каждого стрСобытие ИЗ События Цикл
		стрДействие = Элемент.ПолучитьДействие(стрСобытие.Значение);
		Если Не ПустаяСтрока(стрДействие) Тогда
			ОписаниеЭлемента.События.Вставить(стрСобытие.Значение,стрСобытие.Значение+"_"+стрКлючУникальности);//стрДействие);
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

//Процедура для копирования свойств в структуру с описанием
Процедура с_ДобавитьЗначениеСвойства(ОписаниеЭлемента, Элемент, ИмяСвойства)
	Попытка
		Если Не ИмяСвойства =  "Родитель" Тогда
			Значение = Элемент[ИмяСвойства];
			Если Не Значение = Неопределено И НаследованиеФормСерверПовторноеИспользование_Ei.ПолучитьСериализованныеТипы().СодержитТип(ТипЗнч(Значение)) Тогда
				ОписаниеЭлемента.Вставить(ИмяСвойства, с_ПолучитьОписаниеЭлемента(Значение));
			ИначеЕсли ТипЗнч(Значение) = Тип("ЭлементыФормы") Тогда
				ОписаниеЭлемента.Вставить(ИмяСвойства, с_ПолучитьОписаниеЭлементов(Значение));
			Иначе	
				ОписаниеЭлемента.Вставить(ИмяСвойства, Значение);
			КонецЕсли;
		КонецЕсли;	
	Исключение
		стрКраткое = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Если Не Найти(стрКраткое,"недоступно") Тогда
			Сообщить("Свойство "+ИмяСвойства+" для "+ТипЗнч(Элемент)+" "+стрКраткое,СтатусСообщения.Важное);
		КонецЕсли;	
	КонецПопытки;	
КонецПроцедуры

//Возвращает структуру с описанием всех свойств элемента, включая подчиненные элементы для групп и для таблиц
Функция с_ПолучитьОписаниеЭлемента(Элемент)
	
	ОписаниеЭлемента = Новый Структура("Свойства,События", Новый Структура,Новый Структура);
	
	//Чтобы отличать корневые элементы от остальных для корневых в качестве родителя передаем "Неопределено"
	Если ТипЗнч(Элемент.Родитель) = Тип("УправляемаяФорма") Тогда
		ОписаниеЭлемента.Свойства.Вставить("Родитель", Неопределено);
	Иначе
		ОписаниеЭлемента.Свойства.Вставить("Родитель", Элемент.Родитель.Имя);
	КонецЕсли;
	
	//Основные свойства элемента
	ОписаниеЭлемента.Свойства.Вставить("ТипЭлемента", ТипЗнч(Элемент));
	
	с_ДобавитьОписание(ОписаниеЭлемента, Элемент);
	
	Для Каждого КлючИЗначение Из ОписаниеЭлемента Цикл
		
		//Заменяем в пути к данным "Объект" на "Obj" чтобы не было конфликтов между объектами форм источника и приемника
		Если (КлючИЗначение.Ключ = "ПутьКДанным"
			Или КлючИЗначение.Ключ = "ПутьКДаннымПодвала"
			Или КлючИЗначение.Ключ = "ПутьКДаннымЗаголовка")
			И Лев(КлючИЗначение.Значение, 6) = "Объект" Тогда
			ОписаниеЭлемента.Свойства[КлючИЗначение.Ключ] = "Obj" + Прав(КлючИЗначение.Значение, СтрДлина(КлючИЗначение.Значение) - 6);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОписаниеЭлемента;
	
КонецФункции

//Возвращает массив с описаниями элементов, входящих в коллекцию
Функция с_ПолучитьОписаниеЭлементов(КоллекцияЭлементовФормы)
	ОписаниеКоллекции = Новый Массив;
	Для Каждого Элемент Из КоллекцияЭлементовФормы Цикл
		ОписаниеЭлемента = с_ПолучитьОписаниеЭлемента(Элемент);
		ОписаниеКоллекции.Добавить(ОписаниеЭлемента);
	КонецЦикла;
	Возврат ОписаниеКоллекции;
КонецФункции

// Функция - Получить значение расширения для элемента формы
//
// Параметры:
//  Элемент	 - Элементы	формы - Элемент для которого получаем имя расширения
// 
// Возвращаемое значение:
//   -  Строка
//
Функция ПолучитьЗначениеРасширения(Элемент)
	Результат = Неопределено;
	Если 	ТипЗнч(Элемент) = Тип("ГруппаФормы") ИЛИ
			ТипЗнч(Элемент) = Тип("ПолеФормы") Тогда
		Результат = ПолучитьПолноеИмяПредопределенногоЗначения(Элемент.Вид);
	КонецЕсли;
	Возврат Результат;
КонецФункции


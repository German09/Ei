#Область ПрограммныйИнтерфейс
// Обертка обращения соответствия.
// 
// Возвращаемое значение:
//  Строка - Обертка обращения соответствия
Функция ОберткаОбращенияСоответствия() Экспорт
	Возврат "Получить(""%1"")";
КонецФункции

// Дополнить свойства значения. 
// Обработка свойств получаемых см. Обработка.ОбъектКлиент_Ei 
// 
// 
// Параметры:
//  Значение 	- Произвольный
//  Тип 		- Тип
//  Результат 	- СписокЗначений Из Произвольный
//  ЛюбойКлюч	- Строка
//  Ключи 		- Соответствие Из Произвольный - Возвращаемый параметр
Процедура ДополнитьСвойстваЗначения(Знач Значение, Тип, Результат, ЛюбойКлюч, Ключи) Экспорт
	Если Тип = Тип("ИнформацияОбОшибке") Тогда
		Результат.Добавить(Значение.Описание,			"Описание");
		Результат.Добавить(Значение.Причина, 			"Причина");	
		Результат.Добавить(Значение.ИмяМодуля,			"ИмяМодуля");
		Результат.Добавить(Значение.ИсходнаяСтрока,		"ИсходнаяСтрока");
		Результат.Добавить(Значение.НомерСтроки,		"НомерСтроки");
		Ключи.Вставить(ЛюбойКлюч,Результат);
	ИначеЕсли Тип = Тип("Соответствие") ИЛИ Тип = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого элКлючЗначение ИЗ Значение Цикл
			Если ТипЗнч(элКлючЗначение.Ключ) = Тип("Строка") Тогда
				Результат.Добавить(элКлючЗначение.Значение,	СтрШаблон(ОберткаОбращенияСоответствия(),элКлючЗначение.Ключ)); //Добавлем Получить(Строка)
			КонецЕсли;			
		КонецЦикла;
		Ключи.Вставить(ЛюбойКлюч,Результат);
	ИначеЕсли Тип = Тип("СписокЗначений") Тогда
		Для Каждого Элемент ИЗ Значение Цикл
			//используется для разворачивания см. ОбщегоНазначенияКлиент_Ei.ПолучитьИсторию 
			Если ОбщегоНазначенияКлиентСервер_Ei.ЭтоНавСсылкаНаСсылку(Элемент.Представление) Тогда
				Результат.Добавить(Элемент.Значение, Элемент.Представление);			
			КонецЕсли;				
		КонецЦикла;
		Ключи.Вставить(ЛюбойКлюч,Результат);			
	КонецЕсли;	
КонецПроцедуры
#КонецОбласти		
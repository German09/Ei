#Область ПрограммныйИнтерфейс
// Загрузить.
// 
// Параметры:
//  Форма 				- Форма
//  ВариантИД 			- Число
//  Результат 			- ТаблицаЗначений
//  КолонкиРезультата 	- см. КоллекцияВызовСервера_Ei.ПолучитьКолонки
// 
// Возвращаемое значение:
//  см. ЗагрузитьДляОбработчика
Функция Загрузить(Форма,ВариантИД,Результат,КолонкиРезультата) Экспорт
	Если Результат = Неопределено Тогда
		//это очистка значения
		Результат =  Новый ТаблицаЗначений();
	КонецЕсли;
	Возврат ЗагрузитьДляОбработчика(Форма,ВариантИД,Результат,КолонкиРезультата,РезультатТаблицаКлиентСервер_Ei);
КонецФункции

// Загрузить для обработчика.
// 
// Параметры:
//  Форма 				- Форма - Форма
//  ВариантИД 			- Число - Вариант ИД
//  Результат 			- ТаблицаЗначений - Результат
//  КолонкиРезультата 	- см. КоллекцияВызовСервера_Ei.ПолучитьКолонки 
//  Обработчик 			- ОбщийМодуль
// 
// Возвращаемое значение:
//  Булево - Загрузить для обработчика
Функция ЗагрузитьДляОбработчика(Форма,ВариантИД,Результат,КолонкиРезультата,Обработчик) Экспорт
	Перем ИмяРеквизита;
	ВариантТД 				= Форма.ПолучитьПереопределяемыйОбъектОбработкиСервер(ВариантИД); //не условие не проверяем потому что уже проверяли, по другому сюда не попасть
	ОписаниеТиповРеквизита	= Новый ОписаниеТипов(Обработчик.Свойства().ТипРеквизита);
	ТаблицаФормы			= РезультатыСервер_Ei.ДобавитьРеквизитыКоллекции(Форма,Обработчик, ВариантТД, ИмяРеквизита,ОписаниеТиповРеквизита); 	
	РезультатыСервер_Ei.ЗагрузитьТаблицуИлиДерево(Форма,Результат,КолонкиРезультата,ИмяРеквизита);
	ТаблицаФормы.Видимость	= КолонкиРезультата.Количество();
	ТаблицаФормы.ИзменятьСоставСтрок 	= Ложь; //сотав нужно, менять в коллекции - для удобства конечно лучше добавить специальную кнопку
	//элФормы.ИзменятьПорядокСтрок 	= Ложь; //порядок пускай изменяется а то без этого нет возможности сортировать 
	ИзменитьОтображениеКнопокМеню(ТаблицаФормы);
	Возврат Истина;
КонецФункции

	
// Привести результат к типу, который возможно показать
// 
// Параметры:
//  Значение 			- Произвольный - значение которое мы пытаемся показать данным обработчиком
// 	ВложенноеЗначение	- Булево - Признак вложеннойсти
// Возвращаемое значение:
//	ТаблицаЗначений - Значение приведенное к типу,который можно тут отобразить   
Функция ПривестиРезультат(Значение,ВложенноеЗначение = Ложь) Экспорт
	ОписаниеТипаРезультата 	= Новый ОписаниеТипов(РезультатТаблицаКлиентСервер_Ei.Свойства().ТипРеквизита);
	Результат 				= ОписаниеТипаРезультата.ПривестиЗначение(Неопределено);
	Если Значение =  Неопределено Тогда
		//тут лучше разметисть самой первой поскольку не удастся проверить на вхождение в тип
		Результат.Колонки.Добавить("Неопределено");	
	ИначеЕсли ТипЗнч(Значение) = Тип("МакетКомпоновкиДанных") Тогда
		РезультатыСервер_Ei.ВывестиВКоллекециюСКД(Значение,Результат); //Устарела после использования ПроцессорВывода_Ei
	ИначеЕсли ТипЗнч(Значение) = Тип("ОтчетОбъект.ПроцессорВывода_Ei") Тогда
		Значение.ВывестиВКоллекцию(Результат);
	ИначеЕсли ТипЗнч(Значение) = Тип("ТабличныйДокумент") Тогда
		ПостроительЗапроса 	= Новый ПостроительЗапроса;
		ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(Значение.Область("T"));//Вся таблица или Значение.Область()
		ПостроительЗапроса.ДобавлениеПредставлений = ТипДобавленияПредставлений.НеДобавлять;
    	ПостроительЗапроса.ЗаполнитьНастройки();
		ПостроительЗапроса.Выполнить();
		Результат  = ПостроительЗапроса.Результат.Выгрузить();		
	ИначеЕсли ТипЗнч(Значение) = Тип("РезультатЗапроса") Тогда
		Результат 	= Значение.Выгрузить(ОбходРезультатаЗапроса.Прямой);
	ИначеЕсли ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
		Результат 	= ВыгрузитьДеревоЗначенийВТаблицуЗначений(Значение);		
	ИначеЕсли 	ТипыКлиентСервер_Ei.Коллекция().СодержитТип(ТипЗнч(Значение)) Тогда
		Если ТипЗнч(Значение) = Тип("СписокЗначений") Тогда
			Результат.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
			Результат.Колонки.Добавить("Пометка",Новый ОписаниеТипов("Булево"));
		Иначе
			Результат.Колонки.Добавить("Индекс", Новый ОписаниеТипов("Число"));	
		КонецЕсли;	
		Результат.Колонки.Добавить("Значение");	
		КоллекцияВТЗ(Значение, Результат);
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие")  Тогда
		Результат.Колонки.Добавить("Ключ");	
		Результат.Колонки.Добавить("Значение");	
		КоллекцияВТЗ(Значение, Результат);
	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") ИЛИ ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		Результат.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));	
		Результат.Колонки.Добавить("Значение");	
		КоллекцияВТЗ(Значение, Результат);
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Если ВложенноеЗначение Тогда
			//для вложенного значения строку отдадим как есть, тут не нужно преобразований
			Результат = Значение;
		Иначе		
			СтрокаВТЗ(Значение, Результат);
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("COMОбъект") Тогда
		//подразумеваем что это RS
		Результат = RecordSetвТЗ(Значение);	
	ИначеЕсли ТипЗнч(Значение) = Тип("ВыборкаИзРезультатаЗапроса") Тогда
		Результат = Значение.Владелец().Выгрузить(ОбходРезультатаЗапроса.Прямой);
	ИначеЕсли ТипЗнч(Значение) = Тип("ОбъектXDTO") Тогда 
		Результат = ПривестиРезультат(ОбщегоНазначенияКлиентСервер_Ei.ОбьектXDTOВСтруктуру(Значение));	
	ИначеЕсли ТипЗнч(Значение) = Тип("ДокументHTML") Тогда
		Результат = ТаблицуИзДом(Значение);					
	ИначеЕсли Не Значение = Неопределено  Тогда
		Попытка 
			СериализаторXDTO.ЗаписатьXDTO(Значение);
			//если не можем сериализовать то скорее всего и не получится это значение как то обработать и передать на клиент для отображения
		Исключение
			ВызватьИсключение СтрШаблон("Не удалось отобразить результат (%1) в данном представлении ",ТипЗнч(Значение));
		КонецПопытки;		
		ДобавитьКолонкуЗначения(Значение, Результат);
	КонецЕсли;
	//@skip-check constructor-function-return-section
	Возврат Результат;		
КонецФункции

// Определить размерность.
// 
// Параметры:
//  Результат - ТаблицаЗначений
// 
// Возвращаемое значение:
//  Строка,Неопределено - Определить размерность
Функция ОпределитьРазмерность(Результат) Экспорт
	Перем ОбъемКоллекции;
	Если ТипЗнч(Результат) = Тип("ТаблицаЗначений") Тогда
		ОписаниеЗначенияКлиентСервер_Ei.ОбъемКоллекции(Результат,ОбъемКоллекции);
		Если ЗначениеЗаполнено(ОбъемКоллекции) Тогда
			ОбъемКоллекции = СтрШаблон("%1/%2",ОбъемКоллекции,Результат.Колонки.Количество());
		КонецЕсли; 	
	КонецЕсли;
	Возврат ОбъемКоллекции;		
КонецФункции


// Получить допустимые свойства.
// 
// Параметры:
//  Значение 				- ТаблицаЗначений
//  УникальныйИдентификатор - УникальныйИдентификатор,Неопределено
// 
// Возвращаемое значение:
//  СписокЗначений из см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
Функция ПолучитьДопустимыеСвойства(Значение, УникальныйИдентификатор) Экспорт
	Результат 				= Новый СписокЗначений;
	Результат.Добавить(ОписаниеЗначенияКлиентСервер_Ei.Подготовить(Значение.Колонки,УникальныйИдентификатор),"Колонки");
	Результат.Добавить(ОписаниеЗначенияКлиентСервер_Ei.Подготовить(Значение.Индексы,УникальныйИдентификатор),"Индексы");
	Возврат Результат;		
КонецФункции


// Функция выгружает данные из дерева значений в таблицу значений
// 
// Параметры:
//  Дерево 				-ДеревоЗначений
// 
// Возвращаемое значение:
//  ТаблицаЗначений 
Функция ВыгрузитьДеревоЗначенийВТаблицуЗначений(Дерево) Экспорт
    Таблица = Новый ТаблицаЗначений();;
    Для Каждого Колонка Из Дерево.Колонки Цикл
        Таблица.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
    КонецЦикла;
    ВспомКолонка = РезультатДеревоВызовСервера_Ei.ДобавитьВспомКолонку(Дерево);
	СтрокиДерева = КоллекцияВызовСервера_Ei.ПолучитьСтрокиКоллекции(Дерево,Ложь,ВспомКолонка.Имя);
	Дерево.Колонки.Удалить(ВспомКолонка);
    Для Каждого СтрокаДерева ИЗ СтрокиДерева Цикл
        ЗаполнитьЗначенияСвойств(Таблица.Добавить(), СтрокаДерева);
    КонецЦикла;
    Возврат Таблица;
КонецФункции
#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс
// Record setв ТЗ.
// 
// Параметры:
//  Recordset - ComОбъект 
//  ИмяПоляИД - Строка - имя поля, которое является разделителем для строк второго уровня, все поля поторые идут после этого поля,
//        считаются данными строк второго уровня - строками, подчиненными строке первого уровня, значение в этом поле в них должно быть одинаковым,
//        и соответствовать строке первого уровня. В результирующей таблице будет созана колонка с именем Состав типа ТаблицаЗначений,
//        которая будет содержать данные строк второго уровня
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Результат 
Функция RecordSetвТЗ(Recordset,ИмяПоляИД = Неопределено) Экспорт
	ТЗРезультат = Новый ТаблицаЗначений();
	Пока Recordset.State = 0 Цикл
        Recordset = Recordset.NextRecordset();
    КонецЦикла;
    
    ПолеИД = Неопределено;
    ПервоеПолеСостава = Неопределено;
    Поля = Новый Структура();
    ПоляСостава = Новый Структура();
    Состав = Ложь;
    Для каждого Field Из Recordset.Fields Цикл
        Если Состав Тогда
            ПоляСостава.Вставить(Field.Name, Field);
            Если ПервоеПолеСостава=Неопределено Тогда
                ПервоеПолеСостава = Field;
            КонецЕсли;
        Иначе
            Поля.Вставить(Field.Name, Field);
            ТЗРезультат.Колонки.Добавить(Field.Name, ТипыКлиентСервер_Ei.ПолучитьИзADO(Field));
        КонецЕсли;
        
        Если Field.Name=ИмяПоляИД Тогда
            Состав = Истина;
            ТЗРезультат.Колонки.Добавить("Состав");
            ПолеИД = Field;
        КонецЕсли;
    КонецЦикла;
    
    Если ИмяПоляИД=Неопределено Тогда
        Пока не Recordset.EOF() Цикл
            
            СтрокаДанных = ТЗРезультат.Добавить();
            Для каждого КлючИЗначение Из Поля Цикл
                СтрокаДанных[КлючИЗначение.Ключ] = КлючИЗначение.Значение.Value;
            КонецЦикла;
            
            Попытка
            	Recordset.MoveNext();
            Исключение
            	Прервать; //результат может быть лимитирован на кол-во получемых строк как например в AD
            КонецПопытки;
        КонецЦикла;
    Иначе
        ТекИД = Неопределено;
        Пока не Recordset.EOF() Цикл
            
            Если ПолеИД.Value<>ТекИД Тогда
                
                СтрокаДанных = ТЗРезультат.Добавить();
                Для каждого КлючИЗначение Из Поля Цикл
                    СтрокаДанных[КлючИЗначение.Ключ] = КлючИЗначение.Значение.Value;
                КонецЦикла;
                
                ТЗСостав = Новый ТаблицаЗначений;
                Для каждого КлючИЗначение Из ПоляСостава Цикл
                    ТЗСостав.Колонки.Добавить(КлючИЗначение.Ключ, ТипыКлиентСервер_Ei.ПолучитьИзADO(КлючИЗначение.Значение));
                КонецЦикла;
                СтрокаДанных.Состав = ТЗСостав;
                
                ТекИД = ПолеИД.Value;
            КонецЕсли;
            
            Если ПервоеПолеСостава.Value<>Null Тогда
                СтрокаДанных = ТЗСостав.Добавить();
                Для каждого КлючИЗначение Из ПоляСостава Цикл
                    СтрокаДанных[КлючИЗначение.Ключ] = КлючИЗначение.Значение.Value;
                КонецЦикла;
            КонецЕсли;
            
            Попытка
            	Recordset.MoveNext();
            Исключение
            	Прервать; //результат может быть лимитирован на кол-во получемых строк как например в AD
            КонецПопытки;		
        КонецЦикла;
    КонецЕсли;
    
    //Recordset.Close(); закрвать не будем возможно сможем использваоть повторно
    
    Возврат ТЗРезультат;
КонецФункции
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура КоллекцияВТЗ(Знач Значение, Результат)
	НеопрКолонки 	= Новый Структура;
	Вложенный 		= "Вложенный";
	//Переберем все колоки и для которых не указаны типы добавим одну вложенную колонку 
	//поскольку мы не сможем отбразить на форме таблицу с простоми значенияи и ТЗ
	Для Каждого Колонка Из Результат.Колонки Цикл
		Если Колонка.ТипЗначения.Типы().Количество() = 0 Тогда
			НеопрКолонки.Вставить(Колонка.Имя, Новый Массив);
			Результат.Колонки.Добавить(Колонка.Имя+Вложенный,Новый ОписаниеТипов("ТаблицаЗначений")); //Вложенная колонка			
		КонецЕсли;
	КонецЦикла;
	//Заполним	
	Индекс = 0;
	Для Каждого Эл ИЗ Значение Цикл
		Строка = Результат.Добавить();
		Если Результат.Колонки.Найти("Индекс") = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Строка,Эл);
		Иначе
			Строка.Индекс 	= Индекс;
			Строка.Значение = Эл;
		КонецЕсли;
		Для Каждого НеопрКолонка Из НеопрКолонки Цикл		
			ПривЗначение 	 = ПривестиВложенноеЗначение(Строка[НеопрКолонка.Ключ]);
			Если ТипыВызовСервера_Ei.ОписаниеВложеннойКоллекции(ТипыКлиентСервер_Ei.СоздатьОписаниеИзКолекции(ТипЗнч(ПривЗначение))) Тогда
				Строка[НеопрКолонка.Ключ] = Неопределено; //обнулим
				Строка[НеопрКолонка.Ключ+Вложенный] = ПривЗначение;
			Иначе
				//это простое значение, просто расширим тип будущей колонки		
				НеопрКолонка.Значение.Добавить(ТипЗнч(ПривЗначение));
			КонецЕсли;	
		КонецЦикла;	
		Индекс = Индекс + 1;
	КонецЦикла;
	//Теперь фиксируем финальный состав колонок исходя из заполненности
	Для Каждого НеопрКолонка Из НеопрКолонки Цикл
		Вложенная 		= НеопрКолонка.Ключ + Вложенный;
		ЕстьПростые 	= Не (Результат.НайтиСтроки(Новый Структура(НеопрКолонка.Ключ)).Количество() 	= Результат.Количество());
		ЕстьВложенные 	= Не (Результат.НайтиСтроки(Новый Структура(Вложенная)).Количество() 			= Результат.Количество());
		ИндексКолонки 	= Результат.Колонки.Индекс(Результат.Колонки.Найти(НеопрКолонка.Ключ));
		Если ЕстьПростые Тогда
			Значения 	 	= Результат.ВыгрузитьКолонку(НеопрКолонка.Ключ);
			Результат.Колонки.Удалить(НеопрКолонка.Ключ);
			Результат.Колонки.Вставить(ИндексКолонки,НеопрКолонка.Ключ,Новый ОписаниеТипов(НеопрКолонка.Значение));
			Результат.ЗагрузитьКолонку(Значения,НеопрКолонка.Ключ);
		Иначе
			Если ЕстьВложенные Тогда
				//простых нет, но есть вложенные
				Значения = Результат.ВыгрузитьКолонку(Вложенная);
				Результат.Колонки.Удалить(НеопрКолонка.Ключ);
				Результат.Колонки.Удалить(Вложенная);
				Результат.Колонки.Вставить(ИндексКолонки,НеопрКолонка.Ключ,Новый ОписаниеТипов("ТаблицаЗначений"));
				Результат.ЗагрузитьКолонку(Значения,НеопрКолонка.Ключ);
			Иначе
				Результат.Колонки.Удалить(Вложенная);
			КонецЕсли;		
		КонецЕсли;								 				
	КонецЦикла;
КонецПроцедуры	

//Добавляет в ТЗ одну колонку и одну строку
//
Процедура ДобавитьКолонкуЗначения(Значение, Результат)
	КолонкаИмя = ОбщегоНазначенияКлиентСервер_Ei.вВрегПослеПробела(ТипыКлиентСервер_Ei.ВСтроку(ТипЗнч(Значение)));
	Результат.Колонки.Добавить(КолонкаИмя);
	Результат.Добавить()[КолонкаИмя] = Значение;
КонецПроцедуры

Процедура ИзменитьОтображениеКнопокМеню(ТаблицаФормы)
	КомП = ТаблицаФормы.КоманднаяПанель;
	Приставка 	= ТаблицаФормы.Имя;
	//немного причешем командную панель
	ГруппаКнопок = КомП.ПодчиненныеЭлементы.Найти(Приставка+"Переместить");
	Если Не ГруппаКнопок = Неопределено Тогда
		//по умолчанию отображаем только в доп. подменю
		ОбщегоНазначенияКлиентСервер_Ei.УстановитьОтображениеДляКнопок(ГруппаКнопок,ПоложениеКнопкиВКоманднойПанели.ВДополнительномПодменю);
	КонецЕсли;
	ГруппаКнопок = КомП.ПодчиненныеЭлементы.Найти(Приставка+"Сортировка");
	Если Не ГруппаКнопок = Неопределено Тогда
		//по умолчанию отображаем только в доп. подменю
		ОбщегоНазначенияКлиентСервер_Ei.УстановитьОтображениеДляКнопок(ГруппаКнопок,ПоложениеКнопкиВКоманднойПанели.ВКоманднойПанелиИВДополнительномПодменю);
		ГруппаКнопок.Отображение = ОтображениеГруппыКнопок.Компактное;
		Кнопка = ГруппаКнопок.ПодчиненныеЭлементы.Найти(Приставка+"ВывестиСписок");
		Если Не Кнопка = Неопределено Тогда
			Кнопка.Отображение = ОтображениеКнопки.Картинка;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

Функция ПривестиВложенноеЗначение(Значение)
	Перем Результат;
	Если ТипыКлиентСерверПовтИсп_Ei.ОписаниеПримитивных().СодержитТип(ТипЗнч(Значение))  Тогда
		Результат = Значение;	
	ИначеЕсли Не РезультатТаблицаКлиентСервер_Ei.Свойства().Типы.Найти(ОбщегоНазначенияКлиентСервер_Ei.ПолучитьИмяТипЗнч(ТипЗнч(Значение))) = Неопределено	Тогда
		//Если находим в массиве преобразований то запускаем процедуру приведения
		Результат = ПривестиРезультат(Значение,Истина);
	Иначе	
		Результат = Значение;				
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура СтрокаВТЗ(Значение, Результат)
	Чтение = Новый ЧтениеHTML;
	Чтение.УстановитьСтроку(Значение);
	Построитель = Новый ПостроительDOM;
	РезультатИзДом = ПривестиРезультат(Построитель.Прочитать(Чтение));
	Если ЗначениеЗаполнено(РезультатИзДом) Тогда
		Результат = РезультатИзДом;
	Иначе
		Результат.Колонки.Добавить("Колонка1",Новый ОписаниеТипов("Строка"));
		Для Ном=1 По СтрЧислоСтрок(Значение) Цикл
			Результат.Добавить().Колонка1 = СтрПолучитьСтроку(Значение,Ном);
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры

Функция ТаблицуИзДом(Дом)
    Для Каждого Таблица Из Дом.ПолучитьЭлементыПоИмени("table") Цикл
    	Возврат ТаблицуИзДом(Таблица);	
    КонецЦикла;
    ВсеБуквы = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ";

    //ищем заголовки
    Для Каждого Способ Из СтрРазделить("th,col", ",") Цикл
	    Заголовки = Дом.ПолучитьЭлементыПоИмени(Способ); 
	    Если Заголовки.Количество() Тогда
	        Результат 	= Новый ТаблицаЗначений;
	        НомК = 0;      
	        Для Каждого Колонка Из Заголовки Цикл
	        	НомК = НомК + 1; 
	        	Если ЗначениеЗаполнено(Колонка.ТекстовоеСодержимое) Тогда 
		            ДобавитьКолонку(Результат, Колонка, НомК);
		        КонецЕсли;    	
	        КонецЦикла;
	        
			// Ищем строки таблиц
	        Для каждого ЭлСтр Из Дом.ПолучитьЭлементыПоИмени("tr") Цикл
	        	Если Результат.Колонки.Количество() Тогда
	        		Строка = Результат.Добавить();
	        	Иначе
	        		ЗначениеЯчейки = Неопределено;	
	        	КонецЕсли;	
	            // Ищем колонки для каждой строки
	            Ном 	= 0;
	            НомК 	= 0; 
	            Для каждого Колонка Из ЭлСтр.ПолучитьЭлементыПоИмени("td") Цикл
	            	Если Строка = Неопределено Тогда
	            		//колонки в первой строке
	            		НомК = НомК + 1;
	            		ДобавитьКолонку(Результат, Колонка, НомК);	
	            	Иначе
		                Строка[Ном] = "";
		                Для каждого Эл Из Колонка.ДочерниеУзлы Цикл
		                    Если Эл.ИмяУзла = "br" Тогда // в строке заменяем перенос строки на "; " (просто для удобства последующего разбора)
		                        ЗначениеЯчейки = "; ";
		                    Иначе
		                    	Если ЗначениеЗаполнено(Эл.ЗначениеУзла) Тогда
		                    		ЗначениеЯчейки = Эл.ЗначениеУзла;
		                    	Иначе
		                    		ЗначениеЯчейки = Эл.ТекстовоеСодержимое;
		                    	КонецЕсли;	
		                    КонецЕсли;
		                    //максимально типизируем значения из строки
		                    Если ТипЗнч(ЗначениеЯчейки) = Тип("Строка") И ЗначениеЗаполнено(ЗначениеЯчейки) Тогда
			                    Если ОбщегоНазначенияКлиентСервер_Ei.ЭтоЧисло(ЗначениеЯчейки) Тогда
			                    	ЗначениеЯчейки = Число(ЗначениеЯчейки)
			                    Иначе
			                    	//это или дата или строка
									Если Не СтрРазделить(ВРег(ЗначениеЯчейки), СтрЗаменить(ВсеБуквы,"T","")).Количество() > 1 Тогда
										//букв кроме T в строке нет
				                    	ВозможноДата = ОбщегоНазначенияКлиентСервер_Ei.ДатаИзСтрокиЛюбогоФормата(ЗначениеЯчейки);
				                    	Если ЗначениеЗаполнено(ВозможноДата) Тогда
				                    		ЗначениеЯчейки = ВозможноДата;		
				                    	КонецЕсли;
				                    КонецЕсли;	
			                    КонецЕсли;
			                КонецЕсли;    
		                    Если 	ТипЗнч(Строка[Ном]) 		= Тип("Строка") 
		                    		И ТипЗнч(ЗначениеЯчейки) 	= Тип("Строка") Тогда	
		                    	Строка[Ном] = Строка[Ном] + СтрЗаменить(СтрЗаменить(ЗначениеЯчейки,Символы.ВК,""),Символы.ПС,"");
		                    Иначе
		                    	Строка[Ном] = ЗначениеЯчейки;
		                    	Прервать;
		                    КонецЕсли;					
		                КонецЦикла;
		                Ном = Ном + 1;
		            КонецЕсли;     
	            КонецЦикла;
	        КонецЦикла;
			Возврат Результат;
	    КонецЕсли;
	КонецЦикла;    	
КонецФункции	

Процедура ДобавитьКолонку(Результат, Колонка, Знач Ном)
	ИмяКолонки = ОбщегоНазначенияКлиентСервер_Ei.вВрегПослеПробела(Колонка.ТекстовоеСодержимое);
	Результат.Колонки.Добавить(?(Не ПустаяСтрока(ИмяКолонки),ИмяКолонки,"Колонка"+Ном));
КонецПроцедуры


#Область ПрограммныйИнтерфейс

// Возвращает результат последнего объекта процесса, если в текущем наборе есть данные варианта процессов.
//
// Параметры:
//  ВызовСервера - Булево - Истина - вызов с клиента: вернуть описание значения без преобразования
//
// Возвращаемое значение:
//  Произвольный - описание значения или значение результата, Неопределено - если объекта нет
//
Функция Получить(ВызовСервера = Ложь) Экспорт
	Перем ДанныеПроцесса;
	Перем ОписаниеЗначения;
	ДанныеНабора 	= НаборВариантовКлиентСервер_Ei.ПолучитьДанныеНабора();
	Объекты			= ПолучитьВсе();
	Если Не ДанныеНабора = Неопределено Тогда
		Данные = ДанныеНабора.Данные;
		Если Данные.Свойство(ВариантПроцессыКлиентСервер_Ei.Ключ(),ДанныеПроцесса) Тогда
			Если Объекты.Количество() Тогда
				ОписаниеЗначения = Объекты.Получить(Объекты.ВГраница()).Результат; //ИзначальныйОбъект всегда будет первый в списке если он указан
			КонецЕсли;	 	
		КонецЕсли;
	КонецЕсли;	
	Если ВызовСервера Тогда
		//Вызываем сервер с клиента
		Возврат ОписаниеЗначения;
	Иначе
		Возврат ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОписаниеЗначения);		
	КонецЕсли;			
Конецфункции

// Возвращает объекты процесса текущего сеанса.
//
// Возвращаемое значение:
//  ФиксированныйМассив из ФиксированнаяСтруктура:
//   * Имя 		- Строка - имя элемента схемы процесса
//   * Результат 	- Произвольный - описание значения результата элемента
//   * Источник 	- Произвольный - источник результата
//
Функция ПолучитьВсе() Экспорт	
	Возврат  ПараметрыСеанса.Объект_Процессы_Ei;
КонецФункции

// Устанавливает объекты процесса текущего сеанса.
//
// Параметры:
//  Значение - Массив из ФиксированнаяСтруктура - объекты процесса, см. ПолучитьВсе
//             принимается и ФиксированныйМассив, другое значение очищает состав
//
Процедура Установить(Значение) Экспорт
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		НовоеЗначение = Новый ФиксированныйМассив(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("ФиксированныйМассив") Тогда
		НовоеЗначение = Значение;	
	Иначе
		НовоеЗначение = Новый ФиксированныйМассив(Новый Массив);	
	КонецЕсли;
	ПараметрыСеанса.Объект_Процессы_Ei = НовоеЗначение;		
КонецПроцедуры

// Устанавливает объекты, с которыми вложенный процесс «Для Каждого» начинает обрабатывать элемент коллекции,
// см. ОбработкаДляКаждогоКлиентСервер_Ei.ОбъектыЭлемента
//
// Параметры:
//  Выражение 	- Строка - выражение коллекции
//  ИмяКоллекции - Строка - имя обработки «Для Каждого»
//  ИмяЭлемента - Строка - имя первой обработки вложенного процесса
//  Индекс 		- Число - индекс элемента коллекции
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор формы для временного хранилища
//
// Возвращаемое значение:
//  Булево - Ложь, если коллекцию или ее элемент получить не удалось: объекты процесса не изменились
//
Функция УстановитьОбъектыЭлемента(Выражение, ИмяКоллекции, ИмяЭлемента, Индекс, УникальныйИдентификатор) Экспорт
	ОбъектыДо = ПолучитьВсе();
	Попытка
		Установить(ОбработкаДляКаждогоКлиентСервер_Ei.ОбъектыЭлемента(Выражение, ИмяКоллекции, ИмяЭлемента, Индекс, УникальныйИдентификатор));
		Результат = Истина;
	Исключение
		Установить(ОбъектыДо);
		Результат = Ложь;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Возвращает значение результата объекта процесса по имени элемента схемы.
//
// Параметры:
//  ИмяЭлемента - Строка - имя элемента схемы процесса
//
// Возвращаемое значение:
//  Произвольный - значение результата, Неопределено - если объекта с таким именем нет
//
Функция ПолучитьРезультат(ИмяЭлемента) Экспорт
	Перем Результат;
	Для Каждого ОбъектПроцесса ИЗ ПолучитьВсе() Цикл
		Если нРег(ОбъектПроцесса.Имя) = нРег(ИмяЭлемента) Тогда
			Результат = ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОбъектПроцесса.Результат);
			Прервать;
		КонецЕсли;		
	КонецЦикла;			
	Возврат Результат;
КонецФункции

#КонецОбласти

Функция Получить(ВызовСервера = Ложь) Экспорт
	Перем ДанныеПроцесса;
	Перем ОписаниеЗначения;
	ДанныеНабора 	= НаборВариантовКлиентСервер_Ei.ПолучитьДанныеНабора();
	мОбъекты		= ПолучитьВсе();
	Если Не ДанныеНабора = Неопределено Тогда
		Данные = ДанныеНабора.Данные;
		Если Данные.Свойство(ВариантПроцессыКлиентСервер_Ei.Ключ(),ДанныеПроцесса) Тогда
			Если мОбъекты.Количество() Тогда
				ОписаниеЗначения = мОбъекты.Получить(мОбъекты.ВГраница()).Результат; //ИзначальныйОбъект всегда будет первый в списке если он указан
			КонецЕсли;	 	
		КонецЕсли;
	КонецЕсли;	
	Если ВызовСервера Тогда
		//Вызываем сервер с клиента
		Возврат ОписаниеЗначения;
	Иначе
		Возврат ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОписаниеЗначения);		
	КонецЕсли;			
Конецфункции

Функция ПолучитьВсе() Экспорт	
	Возврат  ПараметрыСеанса.Объект_Процессы_Ei;
КонецФункции
	
Процедура Установить(Значение) Экспорт
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		НовоеЗначение = Новый ФиксированныйМассив(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("ФиксированныйМассив") Тогда
		НовоеЗначение = Значение;	
	Иначе
		НовоеЗначение = Новый ФиксированныйМассив(Новый Массив);	
	КонецЕсли;
	ПараметрыСеанса.Объект_Процессы_Ei = НовоеЗначение;		
КонецПроцедуры

Функция ПолучитьРезультат(ИмяЭлемента) Экспорт
	Перем ОписаниеЗначения;
	Для Каждого СтрРезультата ИЗ ОбъектыВызовСервера_Ei.ПолучитьВсе() Цикл
		Если нРег(СтрРезультата.Имя) = нРег(ИмяЭлемента) Тогда
			ОписаниеЗначения = СтрРезультата.Результат;
			Возврат ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОписаниеЗначения);;
		КонецЕсли;		
	КонецЦикла;			
КонецФункции
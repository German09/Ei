Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",			"Комментарий");
	Результат.Вставить("Синоним",		"Комментарий");
	Результат.Вставить("Картинка",		БиблиотекаКартинок.Комментарий_Ei);
	Результат.Вставить("КартинкаСсылка",ПоместитьВоВременноеХранилище(Результат.Картинка,Новый УникальныйИдентификатор));
	Результат.Вставить("Класс",			ВариантыКлиентСервер_Ei);
	Результат.Вставить("Исполнение",	Ложь); //Исполняется и выводит результат или просто возможно сохранение данных
	Возврат Результат;
КонецФункции


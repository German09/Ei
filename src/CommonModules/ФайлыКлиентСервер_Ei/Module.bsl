#Область ПрограммныйИнтерфейс

// Записать строку.
// 
// Параметры:
//  ПолноеИмя 	- Строка
//  Содержание 	- Строка
Процедура ЗаписатьСтроку(Знач ПолноеИмя,Содержание) Экспорт
	ЗаписьТекста 		= Новый ЗаписьТекста(ПолноеИмя);
	ЗаписьТекста.ЗаписатьСтроку(Содержание);
	ЗаписьТекста.Закрыть();
КонецПроцедуры

// Каталог исходников.
// 
// Возвращаемое значение:
//  Строка
Функция КаталогИсходников() Экспорт
	Возврат "src";
КонецФункции	

#Область ПоследниеНаборы

// Сколько последних открытых и сохраненных наборов показывать в подменю Открыть
// 
// Возвращаемое значение:
//  Число
Функция ЧислоПоследнихНаборов() Экспорт
	Возврат 10;
КонецФункции

// Имя команды формы, открывающей последний набор с номером Номер.
// Все такие команды обрабатывает ОткрытьПоследнийНабор в форме см. ОбщаяФорма.Ei
// 
// Параметры:
//  Номер - Число - с 1 до см. ЧислоПоследнихНаборов
// 
// Возвращаемое значение:
//  Строка
Функция ИмяКомандыПоследнегоНабора(Номер) Экспорт
	Возврат ПрефиксКомандыПоследнегоНабора() + Формат(Номер, "ЧГ=");
КонецФункции

// Номер последнего набора по имени команды см. ИмяКомандыПоследнегоНабора
// 
// Параметры:
//  ИмяКоманды - Строка
// 
// Возвращаемое значение:
//  Число
Функция НомерПоследнегоНабора(ИмяКоманды) Экспорт
	Возврат Число(Сред(ИмяКоманды, СтрДлина(ПрефиксКомандыПоследнегоНабора()) + 1));
КонецФункции

// Имя кнопки, открывающей последний набор с номером Номер
// 
// Параметры:
//  Номер - Число
// 
// Возвращаемое значение:
//  Строка
Функция ИмяКнопкиПоследнегоНабора(Номер) Экспорт
	Возврат "Форма" + ИмяКомандыПоследнегоНабора(Номер);
КонецФункции

// Превращает кнопку Открыть в подменю: в нем выбор папки и последние наборы.
// Кнопки последних наборов создаются скрытыми, заголовки и видимость им задает см. ФайлыКлиент_Ei.ОбновитьМенюПоследнихНаборов
// 
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
Процедура СоздатьМенюПоследнихНаборов(Форма) Экспорт
	КнопкаОткрыть = Форма.Элементы.Найти("ФормаФайлОткрыть");
	Если Не КнопкаОткрыть = Неопределено Тогда
		Подменю 			= Форма.Элементы.Вставить("ФормаГруппаОткрыть", Тип("ГруппаФормы"), КнопкаОткрыть.Родитель, КнопкаОткрыть);
		Подменю.Вид 		= ВидГруппыФормы.Подменю;
		Подменю.Заголовок 	= НСтр("ru = 'Открыть'");
		Подменю.Картинка 	= БиблиотекаКартинок.Открыть_Ei;
		Форма.Элементы.Переместить(КнопкаОткрыть, Подменю);
		КнопкаОткрыть.Заголовок = НСтр("ru = 'Выбрать папку...'");
		
		ГруппаПоследних 	= Форма.Элементы.Добавить("ФормаГруппаПоследниеНаборы", Тип("ГруппаФормы"), Подменю);
		ГруппаПоследних.Вид	= ВидГруппыФормы.ГруппаКнопок;
		Для Номер = 1 По ЧислоПоследнихНаборов() Цикл
			Команда 			= Форма.Команды.Добавить(ИмяКомандыПоследнегоНабора(Номер));
			Команда.Действие 	= "ОткрытьПоследнийНабор";
			Кнопка 				= Форма.Элементы.Добавить(ИмяКнопкиПоследнегоНабора(Номер), Тип("КнопкаФормы"), ГруппаПоследних);
			Кнопка.ИмяКоманды 	= Команда.Имя;
			Кнопка.Видимость 	= Ложь;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрефиксКомандыПоследнегоНабора()
	Возврат "ОткрытьПоследнийНабор";
КонецФункции

#КонецОбласти

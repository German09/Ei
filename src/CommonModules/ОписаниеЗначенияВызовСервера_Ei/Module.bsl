#Область ПрограммныйИнтерфейс
// Функция - Формирует струтуру описание значения, на основе переданных аргументов
// Функция похожа на см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
// Параметры:
//  стрЗначение	 - Строка -  Сериализованное значение
// 
// Возвращаемое значение:
//   см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить		
//
Функция ПодготовитьПоХешу(СтрЗначение) Экспорт
	Перем ОбъемКоллекции,ПредставлениеЗначения;	
	Ключ 		= ОбщегоНазначенияВызовСервера_Ei.ПолучитьХешСтроки(стрЗначение);
	Результат 	= ПараметрыСеанса.ХешАдресов_Ei.Получить(Ключ);
	Если Результат = Неопределено Тогда
		Значение = ОбщегоНазначенияВызовСервера_Ei.Структурировать(стрЗначение);	
		//сформируем строковое универсальное представление типа, не все типы доступны на клиенте 
		ОписаниеЗначенияКлиентСервер_Ei.ОбъемКоллекции(Значение,ОбъемКоллекции);
		ОписаниеТипов 			= ОбщегоНазначенияКлиентСервер_Ei.ПолучитьИмяТипЗнч(ТипЗнч(Значение));
		Ссылка 					= ПоместитьВоВременноеХранилище(Значение, Новый УникальныйИдентификатор());
		ПредставлениеЗначения	= ОписаниеЗначенияКлиентСервер_Ei.ПолучитьПредставление(Значение);	
		Значение				= Неопределено;
		Результат 	= Новый ФиксированнаяСтруктура("ОписаниеТипов,Значение,Ссылка,ПредставлениеЗначения,ОбъемКоллекции",ОписаниеТипов,Значение,Ссылка,ПредставлениеЗначения,ОбъемКоллекции);
		//Добавим в кеш
		ХешАдресов 	= Новый Соответствие(ПараметрыСеанса.ХешАдресов_Ei);
		ХешАдресов.Вставить(Ключ,Результат);
		ПараметрыСеанса.ХешАдресов_Ei = Новый ФиксированноеСоответствие(ХешАдресов);
	КонецЕсли;	
	//@skip-check constructor-function-return-section
	Возврат Результат;
КонецФункции

#КонецОбласти
	
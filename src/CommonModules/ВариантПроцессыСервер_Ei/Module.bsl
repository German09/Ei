#Область ПрограммныйИнтерфейс

// Создает заполнитель контейнера варианта процессов и реквизиты процесса на форме.
//
// Параметры:
//  Форма		- ФормаКлиентскогоПриложения - форма, в которую добавляется вариант
//  Контейнер	- ГруппаФормы - контейнер варианта на форме
//
Процедура Инициализировать(Форма, Контейнер) Экспорт
	КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,ВариантПроцессыКлиентСервер_Ei);
	СоздатьРеквизиты(Форма,КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента());
КонецПроцедуры

// Добавляет на форму реквизиты процесса: схему, объект и дерево доступных обработок.
//
// Параметры:
//  Форма	- ФормаКлиентскогоПриложения - форма, в которую добавляются реквизиты
//  Путь	- Строка, Неопределено - путь к реквизиту-родителю, Неопределено - реквизиты верхнего уровня
//
Процедура СоздатьРеквизиты(Форма,Знач Путь=Неопределено) Экспорт
	ДобавляемыеРеквизиты	= Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ГрафСхемаXDTO", 	Новый ОписаниеТипов("Строка"),Путь,,Истина));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Процессы_Объект", Новый ОписаниеТипов("Строка"),Путь,,Истина));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДоступныеОбработки", Новый ОписаниеТипов("ДеревоЗначений"),Путь,,Истина));
		//Вложенные в доступные обработки повторяет реквизиты формы Процессы_Ei
		Путь = ?(ЗначениеЗаполнено(Путь),Путь+".","")+"ДоступныеОбработки";
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Имя", 					Новый ОписаниеТипов("Строка"),Путь,,Истина));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ИспользоватьНастройки", 	Новый ОписаниеТипов("Булево"),Путь,,Истина));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("КлючНастроек", 			Новый ОписаниеТипов("УникальныйИдентификатор"),Путь,,Истина));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Настройка", 				Новый ОписаниеТипов(),Путь,,Истина)); //Произвольный тип
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Представление", 			Новый ОписаниеТипов("Строка"),Путь,,Истина));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СсылкаНаКартинку", 		Новый ОписаниеТипов("Строка"),Путь,,Истина));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ТипЭлемента", 			Новый ОписаниеТипов(),Путь,,Истина)); //Произвольный тип
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
КонецПроцедуры

// Данные варианта Процессы по описанию шагов: линейная схема Старт - шаги - Завершение и настроенные обработки
// шагов в том виде, в каком их сохраняет форма процесса. Так процесс создает create_variants.
//
// Параметры:
//  Шаги - Массив из Структура - шаги процесса по порядку:
//   * Вид - Строка - имя обработки: Алгоритм, Выполнить или ДляКаждого
//   * Имя - Строка - имя настроенной обработки, уникальное среди шагов процесса
//   * Заголовок - Строка - надпись элемента схемы
//   * Код - Строка - текст алгоритма, у шага Алгоритм
//   * ИмяНабора - Строка - строка набора, у шага Выполнить
//   * ИмяВарианта - Строка - вариант строки, у шага Выполнить
//   * Шаги - Массив из Структура - шаги вложенного процесса, у шага ДляКаждого
//  ИзначальныйОбъект - Строка - выражение объекта процесса
//
// Возвращаемое значение:
//  см. ВариантПроцессыКлиентСервер_Ei.ПодготовитьДанные
//
Функция ДанныеПроцесса(Шаги, ИзначальныйОбъект) Экспорт
	
	СхемаXDTO = СериализаторXDTO.ЗаписатьXDTO(ПроцессыВызовСервера_Ei.ПолучитьМакетСхемыПоУмолчанию());
	Старт = ОбъектСхемыПоТипу(СхемаXDTO, КонстантыКлиентСерверГС_Ei.ТипОбъектаСтарт());
	Завершение = ОбъектСхемыПоТипу(СхемаXDTO, КонстантыКлиентСерверГС_Ei.ТипОбъектаЗавершение());
	// Линия Старт - Завершение и подсказки пустой схемы не нужны: шаги встают между Старт и Завершение
	УдалитьОбъектыСхемыПоТипу(СхемаXDTO, КонстантыКлиентСерверГС_Ei.ТипОбъектаЛиния());
	УдалитьОбъектыСхемыПоТипу(СхемаXDTO, КонстантыКлиентСерверГС_Ei.ТипОбъектаДекорация());
	
	// Шаги начинаются от левого края Старт, а Старт и Завершение встают по центру шагов:
	// шаг по центру узкого Старт уходил левее края схемы вместе со своей картинкой
	Лево = Старт.rectLeft;
	Центр = Лево + ШиринаШага() / 2;
	СдвинутьОбъектСхемы(Старт, Центр - (Старт.rectLeft + Старт.rectRight) / 2, 0);
	Верх = Старт.rectBottom + ОтступШагов();
	Предыдущий = Старт;
	НастройкиОбработок = Новый Соответствие;
	Картинки = Новый Соответствие;
	Для Каждого Шаг Из Шаги Цикл
		Обработчик = ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки().Получить(Шаг.Вид);
		ИмяЭлемента = Шаг.Имя + ПроцессыКлиентСервер_Ei.стрРазделительИмени() + "1";
		Элемент = РаботаСГС_Ei.НовыйОбъектПоТипу(Обработчик.Свойства().ТипЭлемента, СхемаXDTO, ИмяЭлемента, Шаг.Заголовок,
			Лево, Верх, ШиринаШага(), ВысотаШага());
		СхемаXDTO.item.Добавить(Элемент);
		РаботаСГС_Ei.СоединитьОбъектыЛинией(СхемаXDTO, Предыдущий, Элемент, 4, 2);
		// Представление обработки - заголовок шага: форма процесса переносит его в заголовок элемента схемы
		НастройкаОбработки = Новый Структура("Настройка, КлючНастроек, Обработчик", НастройкаШага(Шаг), Новый УникальныйИдентификатор, Шаг.Вид);
		НастройкаОбработки.Вставить("Представление", Шаг.Заголовок);
		НастройкиОбработок.Вставить(Шаг.Имя, Новый ФиксированнаяСтруктура(НастройкаОбработки));
		Картинки.Вставить(ИмяЭлемента, Обработчик.Свойства().Картинка);
		Предыдущий = Элемент;
		Верх = Элемент.rectBottom + ОтступШагов();
	КонецЦикла;
	СдвинутьОбъектСхемы(Завершение, Центр - (Завершение.rectLeft + Завершение.rectRight) / 2, Верх - Завершение.rectTop);
	РаботаСГС_Ei.СоединитьОбъектыЛинией(СхемаXDTO, Предыдущий, Завершение, 4, 2);
	
	// Картинки, как у элементов, добавленных в форме процесса: XDTO-объект схемы их не задает
	Схема = СериализаторXDTO.ПрочитатьXDTO(СхемаXDTO);
	Для Каждого КартинкаЭлемента Из Картинки Цикл
		Элемент = Схема.ЭлементыГрафическойСхемы.Найти(КартинкаЭлемента.Ключ);
		Если Элемент <> Неопределено Тогда
			Элемент.Картинка = КартинкаЭлемента.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый ФиксированнаяСтруктура("Инструкция, Обработки, ИзначальныйОбъект", ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(Схема),
		Новый ФиксированноеСоответствие(НастройкиОбработок), Строка(ИзначальныйОбъект));
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Настройка обработки шага в формате формы настройки обработки, см. ОбработкиКлиент_Ei.СохранитьНастройку
//
// Параметры:
//  Шаг - Структура - шаг процесса, см. ДанныеПроцесса.Шаги
//
// Возвращаемое значение:
//  Строка - сериализованная настройка
//
Функция НастройкаШага(Шаг)
	
	Если Шаг.Вид = ОбработкаДляКаждогоКлиентСервер_Ei.Свойства().Имя Тогда
		Настройка = ДанныеПроцесса(Шаг.Шаги, "");
	Иначе
		Настройка = Новый Соответствие;
		Если Шаг.Вид = ОбработкаВыполнитьКлиентСервер_Ei.Свойства().Имя Тогда
			Настройка.Вставить("Variant.xml", 	Шаг.ИмяНабора);
			Настройка.Вставить("Type.xml", 		Шаг.ИмяВарианта);
		Иначе
			Настройка.Вставить("Algoritm.bsl", 	Шаг.Код);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(Настройка);
	
КонецФункции

// Первый объект схемы указанного типа.
//
// Параметры:
//  СхемаXDTO - ОбъектXDTO - сериализованная графическая схема
//  ТипОбъекта - Число - тип объекта, см. КонстантыКлиентСерверГС_Ei
//
// Возвращаемое значение:
//  ОбъектXDTO, Неопределено - объект схемы, Неопределено - такого объекта нет
//
Функция ОбъектСхемыПоТипу(СхемаXDTO, ТипОбъекта)
	
	Результат = Неопределено;
	Для Каждого ОбъектСхемы Из СхемаXDTO.item Цикл
		Если ОбъектСхемы.itemType = ТипОбъекта Тогда
			Результат = ОбъектСхемы;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Удаляет из схемы все объекты указанного типа.
//
// Параметры:
//  СхемаXDTO - ОбъектXDTO - сериализованная графическая схема
//  ТипОбъекта - Число - тип объекта, см. КонстантыКлиентСерверГС_Ei
//
Процедура УдалитьОбъектыСхемыПоТипу(СхемаXDTO, ТипОбъекта)
	
	// СписокXDTO удаляет по индексу: с конца, чтобы индексы оставшихся не сдвигались
	Индекс = СхемаXDTO.item.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если СхемаXDTO.item.Получить(Индекс).itemType = ТипОбъекта Тогда
			СхемаXDTO.item.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
КонецПроцедуры

// Сдвигает объект схемы вместе с точками его контура.
//
// Параметры:
//  ОбъектСхемы - ОбъектXDTO - объект графической схемы
//  СдвигВправо - Число
//  СдвигВниз - Число
//
Процедура СдвинутьОбъектСхемы(ОбъектСхемы, СдвигВправо, СдвигВниз)
	
	ОбъектСхемы.rectLeft 	= ОбъектСхемы.rectLeft + СдвигВправо;
	ОбъектСхемы.rectRight 	= ОбъектСхемы.rectRight + СдвигВправо;
	ОбъектСхемы.rectTop 	= ОбъектСхемы.rectTop + СдвигВниз;
	ОбъектСхемы.rectBottom 	= ОбъектСхемы.rectBottom + СдвигВниз;
	Для Каждого Точка Из ОбъектСхемы.Point Цикл
		Точка.x = Точка.x + СдвигВправо;
		Точка.y = Точка.y + СдвигВниз;
	КонецЦикла;
	
КонецПроцедуры

// Расстояние между шагами схемы по вертикали.
//
// Возвращаемое значение:
//  Число
//
Функция ОтступШагов()
	Возврат 30;
КонецФункции

// Ширина элемента шага на схеме.
//
// Возвращаемое значение:
//  Число
//
Функция ШиринаШага()
	Возврат 180;
КонецФункции

// Высота элемента шага на схеме.
//
// Возвращаемое значение:
//  Число
//
Функция ВысотаШага()
	Возврат 30;
КонецФункции

#КонецОбласти

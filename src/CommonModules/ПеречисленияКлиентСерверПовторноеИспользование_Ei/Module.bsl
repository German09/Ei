//Получает таблицу свойств или собтий элемента управления описанную в макете 
//Параметры:
//  сТипЭлУправления	- <Строка>. Строка типа элемента управления, без пробелов 
//Возвращаемое значение
//	Таблица значений или пустой массив
Функция офПолучитьТаблицуЭлУправления(сТипЭлУправления,Раздел="Свойства") Экспорт
	Результат 		= Новый ТаблицаЗначений;
	МакетОписания 	= ПолучитьОбщийМакет("оф"+Раздел);
	Если Не МакетОписания.Области.Найти(сТипЭлУправления) = Неопределено Тогда
		ПЗ = Новый ПостроительЗапроса;
		ПЗ.ИсточникДанных = Новый ОписаниеИсточникаДанных(МакетОписания.Область(сТипЭлУправления));
		ПЗ.Выполнить();
    	Результат = ПЗ.Результат.Выгрузить();
    КонецЕсли;	
	Возврат Результат;
КонецФункции

// Функция - Возвращает описание типов, которые легко преобразуются в выражение на встроенном языке просто за счет удаления пробелов
// 
// Возвращаемое значение:
//   - ОпсиниеТипов
//
Функция ОписаниеПростыхТипов() Экспорт
	Возврат Новый ОписаниеТипов(ОбщийМодульВызовСервера_Ei.ОписаниеПростыхТипов(),,"Строка");  //Вычитаем типа строка, при преобразовании часть типов получается недоступна на клиенет и интерпритируется как строка
КонецФункции

// Функция - Получает структуру описания метаданных переданного значения (пустого
//
// Параметры:
//  Значение - Произволное - произволная ссылка, важен тип значения 
// 
// Возвращаемое значение:
//   -  Структура
//			- ПолноеИмя
//			- Тип
//			- ТипДляЗапроса
//
Функция ПолучитьОписаниеМетаданных(Значение) Экспорт
	Результат = Новый Структура("ПолноеИмя,Тип,ТипДляЗапроса");
	Попытка
		ЛексическоеЗначение = СериализаторXDTO.ЗаписатьXDTO(ТипЗнч(Значение)).ЛексическоеЗначение;
		Для Каждого Эл ИЗ ПолучитьКлючевыеТипы() Цикл
			Если Найти(ЛексическоеЗначение,Эл.Ключ) Тогда
				Результат.Тип 			= СтрРазделить(Эл.Значение,";")[0];
				Результат.ТипДляЗапроса = СтрРазделить(Эл.Значение,";")[1];
				Результат.ПолноеИмя 	= СтрЗаменить(ЛексическоеЗначение,Эл.Ключ+".","");
				Если Результат.Тип = сВнешниеИсточникиДанных() Тогда
					Результат.ПолноеИмя = СтрЗаменить(Результат.ПолноеИмя,".",".Таблица.");	 
				КонецЕсли;	
				Возврат Результат;
			КонецЕсли;	
		КонецЦикла;	
	Исключение
		Возврат Неопределено;
	КонецПопытки;	
КонецФункции	

Функция ПолучитьКлючевыеТипы() Экспорт
	КлючевыеТипы 	= Новый Соответствие();
	сИмяФабрики 	= "{http://v8.1c.ru/8.1/data/enterprise/current-config}";
	КлючевыеТипы.Вставить(сИмяФабрики+"CatalogRef","Справочники;Справочник");
	КлючевыеТипы.Вставить(сИмяФабрики+"DocumentRef","Документы;Документ");
	КлючевыеТипы.Вставить(сИмяФабрики+ТипыСтрУниверсальные().Перечисления,"Перечисления;Перечисление");
    КлючевыеТипы.Вставить(сИмяФабрики+"AccumulationRegisterRecord","РегистрыНакопления;РегистрНакопления");
	КлючевыеТипы.Вставить(сИмяФабрики+"InformationRegisterRecord","РегистрыСведений;РегистрСведений");
	КлючевыеТипы.Вставить(сИмяФабрики+"CalculationRegisterRecord","РегистрыРасчета;РегистрРасчета");
	КлючевыеТипы.Вставить(сИмяФабрики+"Константа","Константы;Константа"); //не было буквы 'а' на конце
	КлючевыеТипы.Вставить(сИмяФабрики+"SequenceRecord","Последовательности;Последовательность");
	КлючевыеТипы.Вставить(сИмяФабрики+"ЖурналДокументов","ЖурналыДокументов;ЖурналДокументов");
	КлючевыеТипы.Вставить(сИмяФабрики+"ChartOfCharacteristicTypesObject","ПланыВидовХарактеристик;ПланВидовХарактеристик");
	КлючевыеТипы.Вставить(сИмяФабрики+"BaseCalculationTypesRow","ПланыВидовРасчета;ПланВидовРасчета");
	КлючевыеТипы.Вставить(сИмяФабрики+"ChartOfAccountsRef","ПланыСчетов;ПланСчетов");
	КлючевыеТипы.Вставить(сИмяФабрики+"ExchangePlanRef","ПланыОбмена;ПланОбмена");
	КлючевыеТипы.Вставить(сИмяФабрики+"TaskRef","Задачи;Задача");
	КлючевыеТипы.Вставить(сИмяФабрики+"BusinessProcessObject","БизнесПроцессы;БизнесПроцесс");
	КлючевыеТипы.Вставить(сИмяФабрики+"ExternalDataSourceTableRef",сВнешниеИсточникиДанных()+";ВнешнийИсточникДанных");	
	Возврат КлючевыеТипы;
КонецФункции	

//Определяет порядок в котором будут применены алгоритмы формирования выражения на основе значений
//
Функция АлгоритмыФормированияВыражения() Экспорт
	Результат = Новый СписокЗначений;
	//измените порядок в случае необходимости
	Результат.Добавить("Предопределенный","Проверка на предопределенное значение");
	Результат.Добавить("ПустаяСсылка","Проверка на пустую ссылку");
	Результат.Добавить("ПоискПоКоду","Поиск по коду");
	Результат.Добавить("ПоискПоНомеру","Поиск по номеру");
	Результат.Добавить("ПоискПоНаименованию","Поиск по наименованию");
	Результат.Добавить("УникальныйИдентификатор","Ссылка из уникального идентификатора");
	Возврат Результат;
КонецФункции	

//Получает универсальное строковое представление типа, которое можно преобразовывать в тип знч и обратно с помошью функции ОбщийМодульКлиентСервер_Ei.ПолучитьИмяТипЗнч()
//
Функция ТипыСтрУниверсальные() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Запрос","Query");
	//Результат.Вставить("ДинамическийСписок","DynamicList");
	Результат.Вставить("РезультатЗапроса","QueryResult");
	Результат.Вставить("ТаблицаЗначений","ValueTable");
	Результат.Вставить("ДеревоЗначений","ValueTree");
	Результат.Вставить("ТабличныйДокумент","SpreadsheetDocument");
	Результат.Вставить("Перечисления","EnumRef");
	Результат.Вставить("МакетКомпоновкиДанных","DataCompositionTemplate");
	Результат.Вставить("Запрос","Query");
	Возврат Результат
КонецФункции


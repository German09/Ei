// Прежний интерфейс отладки Ei. События пишутся в журнал выполнения, см. ЖурналКлиентСервер_Ei
// Новый код пишет замеры напрямую через ЖурналКлиентСервер_Ei.

#Область ПрограммныйИнтерфейс

// Начинает событие отладки.
//
// Параметры:
//  Действие - Строка - действие, которое выполняется
//  ТипСобытия - Строка, Неопределено - вид действия
//  Родитель - Структура, Неопределено - событие, в которое вложить новое, по умолчанию последнее незавершенное
//  Сообщать - Булево - показать пользователю оповещение, если событие завершится ошибкой
//
// Возвращаемое значение:
//  см. ЖурналКлиентСервер_Ei.НачатьЗамер
//
Функция ДобавитьСобытие(Действие, ТипСобытия = Неопределено, Родитель = Неопределено, Сообщать = Истина) Экспорт
	
	Возврат ЖурналКлиентСервер_Ei.НачатьЗамер(Действие, ТипСобытия, Родитель, Сообщать);
	
КонецФункции

// Завершает событие отладки.
//
// Параметры:
//  Событие - см. ЖурналКлиентСервер_Ei.НачатьЗамер
//  Статус - Строка, Неопределено - Ошибка, Информация, Без статуса
//  СообщениеОбОшибке - Строка, ИнформацияОбОшибке - сообщение об ошибке или другая информация
//
Процедура ЗавершитьСобытие(Событие, Статус = Неопределено, Знач СообщениеОбОшибке = "") Экспорт
	
	ЖурналКлиентСервер_Ei.ЗавершитьЗамер(Событие, Статус, СообщениеОбОшибке);
	
КонецПроцедуры

// Статусы завершения события.
//
// Возвращаемое значение:
//  см. ЖурналКлиентСервер_Ei.СтатусыЗамера
//
Функция СтатусСообщения() Экспорт
	
	Возврат ЖурналКлиентСервер_Ei.СтатусыЗамера();
	
КонецФункции

// Виды событий по умолчанию.
//
// Возвращаемое значение:
//  см. ЖурналКлиентСервер_Ei.ТипыОпераций
//
Функция ТипыСобытий() Экспорт
	
	Возврат ЖурналКлиентСервер_Ei.ТипыОпераций();
	
КонецФункции

// Признак в сообщении события: событие пишется в журнал, но пользователю не показывается.
//
// Возвращаемое значение:
//  см. ЖурналКлиентСервер_Ei.ПризнакТолькоДляОтладки
//
Функция ПризнакИсключения() Экспорт
	
	Возврат ЖурналКлиентСервер_Ei.ПризнакТолькоДляОтладки();
	
КонецФункции

#КонецОбласти

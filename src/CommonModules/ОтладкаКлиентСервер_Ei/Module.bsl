
//Функция добавляет событие в дерево отладки и заполняет колонки
//Параметры:
//	Действие			- Строка - Действие которое вызвало отладку.
//	ТипСобытия			- Строка - Тип выполняемого действия.
//	Родитель			- СтрокаДереваЗначений-  Родитель. если не указан определяем по пустому значению, дата окончания.
//Возвращаемое значение:
//	Добавленая строка ДЗ
Функция ДобавитьСобытие(Действие, ТипСобытия = Неопределено, Родитель = Неопределено, Сообщать = Истина) Экспорт 
	ТипСобытия 	= ?(Не ТипСобытия = Неопределено, ТипСобытия, ПеречисленияКлиентСерверПовторноеИспользование_Ei.ОтладкаТипыСобытий().Общие);
	#Если Клиент Тогда
		Возврат ОтладкаКлиент_Ei.ДобавитьСобытие(Действие, ТипСобытия, Родитель, Сообщать);
	#Иначе
		
	#КонецЕсли	
Конецфункции

//Фиксирует факт завершения события
//Параметры:
//	Событие				- СтрокаДереваЗначений - Строка обозначающее событие
//  Статус				- Строка - Определяет как завершилось событие, Ошибка,Информация,БезСтатуса
//	СообщениеОбОшибке   - Строка,ИнформацияОбОшибке - Сообщение об ошибке или другая информация 
//
Процедура ЗавершитьСобытие(Событие, Статус = Неопределено, Знач СообщениеОбОшибке = "") Экспорт
	Статус 	= ?(Не Статус = Неопределено, Статус, ПеречисленияКлиентСерверПовторноеИспользование_Ei.ОтладкаСтатусСообщения().БезСтатуса);
	#Если Клиент Тогда
		ОтладкаКлиент_Ei.ЗавершитьСобытие(Событие, Статус, СообщениеОбОшибке);
	#Иначе
		
	#КонецЕсли	
КонецПроцедуры	
//Есть еще вСформироватьСписокПоСтруктуреКолонок() нужно их объединить
//
Функция ПолучитьКолонкиРезультата(Набор) Экспорт
	Результат 		= Новый Массив;
	ТекущийНабор 	= Неопределено;
	Если ТипЗнч(Набор) = Тип("ТаблицаЗначений") Тогда
		ТекущийНабор 	= Набор
	ИначеЕсли ТипЗнч(Набор) = Тип("ДеревоЗначений") Тогда
		ТекущийНабор 	=	Набор.Строки;	
	КонецЕсли;	
	Для Каждого Колонка ИЗ Набор.Колонки Цикл
		мВложенныхКолонок =  Новый Массив;
		Если Колонка.ТипЗначения =  Новый ОписаниеТипов("ТаблицаЗначений") Тогда
			Если Не ТекущийНабор = Неопределено Тогда
				Для Каждого Подстрока ИЗ ТекущийНабор Цикл
					Если Подстрока[Колонка.Имя].Количество() Тогда
						мВложенныхКолонок = ПолучитьКолонкиРезультата(Подстрока[Колонка.Имя]);
						Прервать;
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Колонка,мКолонкиРезультата",Новый Структура("Имя,ТипЗначения",Колонка.Имя,Колонка.ТипЗначения),мВложенныхКолонок)); //объект возвращается на клиент для создания граф схемы поэтому приводим к простому типу
	КонецЦикла;	
	Возврат Результат;
КонецФункции

Процедура СоздатьСтраницу(Форма,ОбщийКонтейнерИмя, Имя) Экспорт
	ОбщийКонтейнер		= Форма.Элементы.Найти(ОбщийКонтейнерИмя);
	Если Не ОбщийКонтейнер = Неопределено Тогда
		Контейнер 			= Форма.Элементы.Вставить(Имя, Тип("ГруппаФормы"), ОбщийКонтейнер);
		Контейнер.Вид 		= ВидГруппыФормы.Страница;
	КонецЕсли;	
КонецПроцедуры
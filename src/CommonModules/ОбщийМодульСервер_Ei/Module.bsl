Функция  СоздатьСтраницу(Форма,ОбщийКонтейнерИмя, Имя) Экспорт
	Перем Контейнер;
	ОбщийКонтейнер		= Форма.Элементы.Найти(ОбщийКонтейнерИмя);
	Если Не ОбщийКонтейнер = Неопределено Тогда
		Контейнер 			= Форма.Элементы.Вставить(Имя, Тип("ГруппаФормы"), ОбщийКонтейнер);
		Контейнер.Вид 		= ВидГруппыФормы.Страница;
	КонецЕсли;
	Возврат Контейнер;	
КонецФункции

Процедура Переместить(Форма,ЭлементИмя,РодительИмя) Экспорт
	Элемент 	= Форма.Элементы.Найти(ЭлементИмя);
	Родитель	= Форма.Элементы.Найти(РодительИмя);
	Если Не Элемент = Неопределено И Не Родитель = Неопределено Тогда 
		Форма.Элементы.Переместить(Элемент, Родитель);	
	КонецЕсли;	
КонецПроцедуры	

Функция ИмяПараметраРасшифровкаСКД() Экспорт
	Возврат "Расшифрока_Ei";
КонецФункции
// Функция - После вычисления значения
//
// Параметры:
//  Значение				 - Произвольный	 				- Вычисленное значение 
//  ОписаниеТипов			 - Массив, Срока, ОписаниеТипов	- Тип к которому нужно привести значение
//  УникальныйИдентификатор	 - УникальныйИдентифкатор	 	- Индентифкатор формы, в случае его указания возвращается структура ОписанияЗначения
// 
// Возвращаемое значение:
//   -  Структура описания значения, формируемая ОбщийМодульКлиентСервер_Ei.ПолучитьОписаниеЗначения()
//	ИЛИ
//	 - 	Уникальный идентификатор значения в Кеше
//
Функция ПослеВычисленияЗначения(Значение, ОписаниеТипов,УникальныйИдентификатор) Экспорт
	Если Не ОписаниеТипов = Неопределено Тогда
		ТипПриведения  	= ОбщийМодульКлиентСервер_Ei.ПроверитьОписаниеТипов(ОписаниеТипов);
		Если НЕ ТипПриведения.СодержитТип(ТипЗнч(Значение)) Тогда
			//тут нужно подумать как приводить в сложные значение привести автоматом невсегда возможно
			Если ТипПриведения.СодержитТип(Тип("ТаблицаЗначений")) Тогда
				//приведем значение к таблице или дереву значений
				Результат = ОбщийМодульЗакрытыйВызовСервера_Ei.ПреобразоватьВТаблицуИЛИДеревоЗначений(Значение);
			Иначе	
				Результат = ТипПриведения.ПривестиЗначение(Значение);			
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
	Если Не УникальныйИдентификатор = Неопределено Тогда
		//если уникальный идентификатор указан то сразу формируем описание значения без попытки передать в явном виде на клиент
	    Результат = ПодготовитьОписаниеЗначения(Значение,УникальныйИдентификатор);
	Иначе
		//мутабельные значения не получится поместить во внутренее хранилище поэтому просто поместим сохраним на сервере в КЭШе
		Результат = Новый УникальныйИдентификатор;
		ПеречисленияКлиентСерверПовторноеИспользование_Ei.Значения().Вставить(Результат,Значение);
	КонецЕсли;	
	Возврат  Результат			
КонецФункции

// Функция - Формирует струтуру описание значения, на основе переданных аргументов, некоторые аргументы доуточняются
//
// Параметры:
//  Значение				 - Произвольный	 			-  Искомое значение, которое необходимо описать или адрес значения в кеше
//  УникальныйИдентификатор	 - УникальныйИдентивикатор	-  Адрес по которому необходимо сохранить значние, в дальнешем на клиент передается уже сам адрес, а не значение
//  ОписаниеТипов			 - ОписаниеТипов	 		-  Описание типов. Исползуется для определения какой тип значения получен, если значение сохранено во временном хранилище, иногда получить его на клиенте будет невозможно
// 
// Возвращаемое значение:
//   - Фиксированная структура со свойствами аналогичными аргументам функции (именно ФИКСИРОВАННАЯ важна для совместимости с формой выбора типа)
//			
//
Функция ПодготовитьОписаниеЗначения(ЗначениеИлиАдрес,УникальныйИдентификатор = Неопределено,Знач ОписаниеТипов = Неопределено) Экспорт
	Перем ОбъемКоллекции,ПредставлениеЗначения;
	Если ОбщийМодульКлиентСервер_Ei.ЭтоАдресКешаЗначений(ЗначениеИлиАдрес) Тогда 
		Значение 	= ПеречисленияКлиентСерверПовторноеИспользование_Ei.Значения().Получить(ЗначениеИлиАдрес);	
		Ссылка 		= ЗначениеИлиАдрес;
	Иначе
		Значение 	= ЗначениеИлиАдрес;
		Если УникальныйИдентификатор = Неопределено Тогда
			Ссылка 		= Неопределено;
		КонецЕсли;	
	КонецЕсли;	
	Если ОписаниеТипов = Неопределено Тогда
		//сформируем строковое универсальное представление типа, не все типы доступны на клиенте 
		ОписаниеТипов 	= ОбщийМодульКлиентСервер_Ei.ПолучитьИмяТипЗнч(ТипЗнч(Значение));
	КонецЕсли;
	Попытка 
		ОбъемКоллекции = Значение.Количество();
	Исключение
	КонецПопытки;	
	Если Не УникальныйИдентификатор = Неопределено Тогда
		//требуется поместить значение во временное хранилище или кэш вероятно будет использовано на клиенте
		Попытка
			//для более прогнозируемой жизни объекта попробуем поместить по указанному адресу
			Ссылка 		= ПоместитьВоВременноеХранилище(Значение, УникальныйИдентификатор);
		Исключение
			//вероятно значение мутабельное поэтому просто помещаем его в КЭШ
			Ссылка		= Новый УникальныйИдентификатор; //переданный уникальный идентифкато не используем поскольку там м.б. НЕ уникальный идентифкатор формы
			ПеречисленияКлиентСерверПовторноеИспользование_Ei.Значения().Вставить(Ссылка,Значение);
		КонецПопытки;
		ПредставлениеЗначения    	= Строка(Значение);
		Если ПустаяСтрока(ПредставлениеЗначения) Тогда
			//Иногда значение не имеет представления (например результат запроса), тогда просто возьемм его тип
			ПредставлениеЗначения  	= Строка(ТипЗнч(Значение));
		КонецЕсли;	
		Значение					= Неопределено;
	КонецЕсли;	
	Результат = СтруктурыЗначенийКлиентСервер_Ei.ПолучитьОписаниеЗначения(ОписаниеТипов,Значение,Ссылка,ПредставлениеЗначения,ОбъемКоллекции);	
	Возврат Результат;
КонецФункции

//Есть еще вСформироватьСписокПоСтруктуреКолонок() нужно их объединить
//
Функция ПолучитьКолонкиРезультата(Набор) Экспорт
	Результат 		= Новый Массив;
	ТекущийНабор 	= Неопределено;
	Если ТипЗнч(Набор) = Тип("ТаблицаЗначений") Тогда
		ТекущийНабор 	= Набор
	ИначеЕсли ТипЗнч(Набор) = Тип("ДеревоЗначений") Тогда
		ТекущийНабор 	=	Набор.Строки;
	КонецЕсли;	
	Для Каждого Колонка ИЗ Набор.Колонки Цикл
		мВложенныхКолонок =  Новый Массив;
		Если Колонка.ТипЗначения =  Новый ОписаниеТипов("ТаблицаЗначений") Тогда
			Если Не ТекущийНабор = Неопределено Тогда
				Для Каждого Подстрока ИЗ ТекущийНабор Цикл
					Если Подстрока[Колонка.Имя].Количество() Тогда
						мВложенныхКолонок = ПолучитьКолонкиРезультата(Подстрока[Колонка.Имя]);
						Прервать;
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;
		КонецЕсли;	
		Результат.Добавить(Новый Структура("Колонка,мКолонкиРезультата",Новый Структура("Имя,ТипЗначения",Колонка.Имя,Колонка.ТипЗначения),мВложенныхКолонок)); //объект возвращается на клиент для создания граф схемы поэтому приводим к простому типу
	КонецЦикла;	
	Возврат Результат;
КонецФункции

// Формы настройки обработок процессов и дерево доступных обработок на клиенте.

#Область ПрограммныйИнтерфейс

// Перед закрытием формы настройки обработки: при несохраненных изменениях - вопрос о сохранении.
//
// Параметры:
//  Обработчик - ОбщийМодуль - модуль обработки, например ОбработкаАлгоритмКлиентСервер_Ei
//  Форма - ФормаКлиентскогоПриложения - форма настройки обработки
//  Отказ - Булево
//
Процедура ПередЗакрытием(Обработчик, Форма, Отказ) Экспорт
	Если Не Форма.ТолькоПросмотр Тогда
		ВычислитьМодифицированность(Обработчик, Форма);
		Если Форма.Модифицированность Тогда
			Отказ = Истина;
			ВопросПредЗакрытием(Обработчик, Форма);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Модифицированность формы настройки: настройка формы отличается от переданной при открытии.
//
// Параметры:
//  Обработчик - ОбщийМодуль - модуль обработки
//  Форма - ФормаКлиентскогоПриложения - форма настройки обработки
//
Процедура ВычислитьМодифицированность(Обработчик, Форма) Экспорт
	Если Не Форма.ТолькоПросмотр Тогда
		Форма.Модифицированность = Не (Форма.Параметры.Настройка = ПолучитьНастройкуДляСохранения(Обработчик, Форма));
	Иначе
		Форма.Модифицированность = Ложь;
	КонецЕсли;
КонецПроцедуры

// Записывает в строку обработки настройку, сохраненную формой настройки, обработчик оповещения о закрытии.
//
// Параметры:
//  Результат - Строка, Неопределено - сохраненная настройка обработки, Неопределено - не сохраняли
//  ДополнительныеПараметры - Структура:
//   * Форма - ФормаКлиентскогоПриложения - форма с процессом
//   * СтрокаОбработки - ДанныеФормыЭлементДерева - строка дерева доступных обработок
//
Процедура СохранитьНастройку(Результат, ДополнительныеПараметры) Экспорт
	Если Результат <> Неопределено Тогда
		ДополнительныеПараметры.СтрокаОбработки.Настройка = Результат;
		ДополнительныеПараметры.Форма.ВычислитьМодифицированность();
	КонецЕсли;
КонецПроцедуры

// Заполняет дерево доступных обработок видами обработок с их картинками.
//
// Параметры:
//  ДоступныеОбработки - ДанныеФормыКоллекцияЭлементовДерева - строки верхнего уровня дерева доступных обработок
//
Процедура ЗагрузитьОбработки(ДоступныеОбработки) Экспорт
	Для Каждого ЭлементОбработки Из ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки() Цикл
		Свойства = ЭлементОбработки.Значение.Свойства();
		СтрокаВида = Неопределено;
		Для Каждого Найденная Из ОбщегоНазначенияКлиентСервер_Ei.НайтиВКоллекцииДерева(Новый Структура("Имя", ЭлементОбработки.Ключ), ДоступныеОбработки, Ложь) Цикл
			СтрокаВида = Найденная;
			Прервать;
		КонецЦикла;
		Если СтрокаВида = Неопределено Тогда
			СтрокаВида = ДоступныеОбработки.Добавить();
		КонецЕсли;
		СтрокаВида.Имя						= Свойства.Имя;
		СтрокаВида.ТипЭлемента				= Свойства.ТипЭлемента;
		СтрокаВида.ИспользоватьНастройки	= Свойства.ИспользоватьНастройки;
		СтрокаВида.Представление			= Свойства.Синоним;
		// Адрес всегда этого сеанса: адрес в данных строки мог остаться от прошлого сеанса, по нему картинки уже нет
		СтрокаВида.СсылкаНаКартинку			= ОбработкиКлиентСерверПовтИсп_Ei.КартинкаСсылка(Свойства.Имя);
		// Настроенные обработки вида - с картинкой вида, как их элементы на схеме
		Для Каждого СтрокаОбработки Из СтрокаВида.ПолучитьЭлементы() Цикл
			СтрокаОбработки.СсылкаНаКартинку = СтрокаВида.СсылкаНаКартинку;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Декорация ошибки формы настройки обработки.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма настройки обработки
//
// Возвращаемое значение:
//  ДекорацияФормы, Неопределено - декорация, Неопределено - ее нет в форме
//
Функция ПолучитьДекорациюОшибки(Форма) Экспорт
	Возврат Форма.Элементы.Найти("ОшибкаТекст");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сериализованная настройка обработки из формы настройки.
//
// Параметры:
//  Обработчик - ОбщийМодуль - модуль обработки
//  Форма - ФормаКлиентскогоПриложения - форма настройки обработки
//
// Возвращаемое значение:
//  Строка
//
Функция ПолучитьНастройкуДляСохранения(Обработчик, Форма)
	Возврат ОбщегоНазначенияВызовСервера_Ei.Сериализовать(Обработчик.ПолучитьНастройку(Форма));
КонецФункции

// Спрашивает, сохранить ли изменения настройки, и закрывает форму по ответу.
//
// Параметры:
//  Обработчик - ОбщийМодуль - модуль обработки
//  Форма - ФормаКлиентскогоПриложения - форма настройки обработки
//
Асинх Процедура ВопросПредЗакрытием(Обработчик, Форма)
	Ответ = Ждать ВопросАсинх(НСтр("ru = 'Сохранить текущие изменения?'"), РежимДиалогаВопрос.ДаНетОтмена);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Форма.ТолькоПросмотр = Истина;
		Форма.Закрыть(ПолучитьНастройкуДляСохранения(Обработчик, Форма));
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		Форма.ТолькоПросмотр = Истина;
		Форма.Закрыть();
	КонецЕсли;
	// Отмена - форма остается открытой
КонецПроцедуры

#КонецОбласти

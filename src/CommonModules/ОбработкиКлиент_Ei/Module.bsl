Процедура ПередЗакрытием(Обработчик, Форма, Отказ) Экспорт
	Если Не Форма.ТолькоПросмотр Тогда
		ВычислитьМодифицированность(Обработчик,Форма);
		Если Форма.Модифицированность Тогда
			Отказ = Истина;
			ПоказатьВопрос(Новый ОписаниеОповещения("ВыборСохранения",ЭтотОбъект,Новый Структура("Обработчик,Форма",Обработчик,Форма)),"Сохранить текущие изменения?", РежимДиалогаВопрос.ДаНетОтмена);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

Процедура ВычислитьМодифицированность(Обработчик,Форма) Экспорт
	Если Не Форма.ТолькоПросмотр Тогда
		Форма.Модифицированность 	= Не(Форма.Параметры.Настройка = ПолучитьНастройкуДляСохранения(Обработчик,Форма));
	Иначе
		Форма.Модифицированность    = Ложь;
	КонецЕсли;	
КонецПроцедуры

Функция ПолучитьНастройкуДляСохранения(Обработчик,Форма)
	Возврат ОбщегоНазначенияВызовСервера_Ei.Сериализовать(Обработчик.ПолучитьНастройку(Форма)); 
КонецФункции

// Процедура - описанная в ОписаниеОповещения вызывается при попытке закрытия обработки с результатом вопроса о сохранении
//
// Параметры:
//  РезультатВопроса - КодВозвратаДиалога-	Ответ на вопрос сохранить или нет
//  ДопПараметры	 - Структура	 		 
//
Процедура ВыборСохранения(РезультатВопроса, ДопПараметры) Экспорт
	Обработчик 	= ДопПараметры.Обработчик;
	Форма		= ДопПараметры.Форма;	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Форма.ТолькоПросмотр = Истина;
		Форма.Закрыть(ПолучитьНастройкуДляСохранения(Обработчик,Форма));
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		//отказались от продолжения операции
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Форма.ТолькоПросмотр = Истина;
		Форма.Закрыть();
	КонецЕсли;	
КонецПроцедуры	

// Сохранить настройку. ОО вызываемый при сохранении настройки обработка
// 
// Параметры:
//  Результат - Строка - Сохраненная настройка обработки  
//  ДопПараметр - Структура - Доп параметры ОО 
//					* Форма 			- Форма - Форма владелец 
//					* СтрокаОбработки 	- СтрокаДереваЭлементовФормы
Процедура СохранитьНастройку(Результат,ДопПараметр) Экспорт
	Если НЕ Результат = Неопределено Тогда
		Форма 			= ДопПараметр.Форма;
		СтрокаОбработки = ДопПараметр.СтрокаОбработки;
		
		СтрокаОбработки.Настройка = Результат;
		Форма.ВычислитьМодифицированность();
	КонецЕсли;	
КонецПроцедуры

// Заполняет дерево доступных обработок водможными типами
//
Процедура ЗагрузитьОбработки(ДоступныеОбработки) Экспорт
	Для Каждого ЭлОбработчика ИЗ ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки() Цикл
		Обработчик 	= ЭлОбработчика.Значение;
		Свойства 	= Обработчик.Свойства();
		СтрокиВида 	= ОбщегоНазначенияКлиентСервер_Ei.НайтиВКоллекцииДерева(Новый Структура("Имя",ЭлОбработчика.Ключ),ДоступныеОбработки,Ложь); 
		Если СтрокиВида.Количество() Тогда
			СтрокаВида = СтрокиВида[0];	
		Иначе	
			СтрокаВида	= ДоступныеОбработки.Добавить();
		КонецЕсли;
		СтрокаВида.Имя						= Свойства.Имя;
		СтрокаВида.ТипЭлемента				= Свойства.ТипЭлемента;
		СтрокаВида.ИспользоватьНастройки	= Свойства.ИспользоватьНастройки;
		СтрокаВида.СсылкаНаКартинку 		= ВариантыКлиентСерверПовтИсп_Ei.КартинкаСсылка(Обработчик.Свойства().Имя);
		СтрокаВида.Представление	 		= Свойства.Синоним;
	КонецЦикла;	
Конецпроцедуры	

Функция ПолучитьДекорациюОшибки(Форма) Экспорт
	Возврат Форма.Элементы.Найти("ОшибкаТекст");
КонецФункции

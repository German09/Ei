Процедура ТекущееЗначение(Форма) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Форма,ТД, ВариантКоллекцияКлиентСервер_Ei);
		Элемент 		= Форма.Элементы.Найти(ИмяРеквизита);
		Если Не Элемент = Неопределено Тогда
			Значения = КоллекцияКлиент_Ei.ПолучитьВыделенныеЯчейки(Форма,Элемент,Элемент.ВыделенныеСтроки,Элемент.ТекущийЭлемент);
			Если Значения.Количество() Тогда
				Параметры 	= Новый Структура();
				Параметры.Вставить("Значение",	Значения[0].Значение);
				Параметры.Вставить("Выделенных",Значения.Количество());
				Параметры.Вставить("Колонка",	Элемент.ТекущийЭлемент.Заголовок);
				Параметры.Вставить("Всего",		Форма[ИмяРеквизита].Количество());
				ОО_Закрытия	= Новый ОписаниеОповещения("УстановитьЗначение",ЭтотОбъект,Новый Структура("Форма,Колонка",Форма,Параметры.Колонка));
				ОткрытьФорму("ОбщаяФорма.УстановитьЗначение_Ei",Параметры,Форма,,,,ОО_Закрытия,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

//Команда формы
//
Процедура Установить(Форма) Экспорт
	РезультатВыбора = Новый Структура("Способ,Значение",Форма.Способ,Форма.Значение);
	Форма.Закрыть(РезультатВыбора);	 //Вызывает УстановитьЗначение()
КонецПроцедуры	

//Вызывается при закрытии окна установки значения
//
Процедура УстановитьЗначение(Результат,ДопПараметры) Экспорт
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Форма 	= ДопПараметры.Форма;
		Колонка = ДопПараметры.Колонка;
		ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
		Если Не ТД = Неопределено Тогда
			ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(ВариантКоллекцияКлиентСервер_Ei,ТД);
			Элемент 		= Форма.Элементы.Найти(ИмяРеквизита);
			Если Не Элемент = Неопределено Тогда
				//TODO #21 еще нужно проверять тип колонки возможно выбранное значение не входит в допустимые типы колонки
				Если Результат.Способ = Способы().Все Тогда
					Для Каждого Строка ИЗ Форма[ИмяРеквизита] Цикл
						Строка[Колонка] = Результат.Значение;	
					КонецЦикла;			
				ИначеЕсли Результат.Способ = Способы().Выделенные Тогда
					Для Каждого ИдСтроки ИЗ Элемент.ВыделенныеСтроки Цикл
						ДанныеСтроки = Элемент.ДанныеСтроки(ИдСтроки);
						Если Не ДанныеСтроки = Неопределено Тогда
							ДанныеСтроки[Колонка] = Результат.Значение;			
						КонецЕсли;
					КонецЦикла;		 	 
				ИначеЕсли Результат.Способ = Способы().Видимые Тогда
					Для Каждого Строка ИЗ Форма[ИмяРеквизита] Цикл
						Если Элемент.ПроверитьСтроку(Строка.ПолучитьИдентификатор()) Тогда
							Строка[Колонка] = Результат.Значение;
						КонецЕсли;		
					КонецЦикла;			 	 
				КонецЕсли;
				ВариантКоллекцияКлиент_Ei.ПриИзменении(Форма,Элемент);
			КонецЕсли;			 	 
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры

Процедура ПриОткрытии(Форма,Отказ) Экспорт
	Форма.Способ 	= ?(Форма.Параметры.Выделенных>1,Способы().Выделенные,Способы().Видимые);
	Форма.Заголовок = Форма.Параметры.Колонка;
	Форма.Значение 	= Форма.Параметры.Значение;
	ДляПриИзменении(Форма,Неопределено);
КонецПроцедуры

//Сформируем пояснения
Процедура ДляПриИзменении(Форма,Элемент) Экспорт
	Если Форма.Способ = Способы().Все Тогда
		Форма.Пояснение = СтрШаблон("для всех %1 строк коллекции",Форма.Параметры.Всего);
	ИначеЕсли Форма.Способ = Способы().Выделенные Тогда
		Форма.Пояснение = СтрШаблон("только для %1 выделенных строк коллекции",Форма.Параметры.Выделенных);
	ИначеЕсли Форма.Способ = Способы().Видимые Тогда
		Форма.Пояснение = "только для строк удовлетворяющих параметрам поиска";		
	КонецЕсли;						
КонецПроцедуры

Функция Способы()
	Возврат Новый Структура("Все,Выделенные,Видимые","все","выд","вид");
КонецФункции	
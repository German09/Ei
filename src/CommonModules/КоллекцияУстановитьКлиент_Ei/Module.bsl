Процедура ТекущееЗначение(Форма) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		Параметры 	= Новый Структура();
		ОО_Закрытия	= Новый ОписаниеОповещения("УстановитьЗначение",ЭтотОбъект,Новый Структура("Форма",Форма));
		ОткрытьФорму("ОбщаяФорма.УстановитьЗначение_Ei",Параметры,Форма,,,,ОО_Закрытия,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
КонецПроцедуры

//Вызывается при закрытии окна установки значения
//
Процедура УстановитьЗначение(Результат,ДопПараметры) Экспорт
	Если Не Результат = Неопределено Тогда
		Форма = ДопПараметры.Форма;
		ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
		Если Не ТД = Неопределено Тогда
//			Форма.ИзменитьКоллекцию(Результат,ТД.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры

Процедура ПриОткрытии(Форма,Отказ) Экспорт
	Форма.Способ = "все";
КонецПроцедуры


Процедура Инициализация(Форма,Отказ) Экспорт
	Настройка = Новый СписокЗначений();
	Настройка.Добавить("ТаблицаЗначений", "Коллекция");
	ДобавитьКолонки(Форма.Структура,Настройка);
КонецПроцедуры

Процедура ДобавитьКолонки(Коллекция,СзНастройка)
	Для Каждого Элемент ИЗ СзНастройка Цикл
		НоваяСтрока  = Коллекция.ПолучитьЭлементы().Добавить();
		НоваяСтрока.Имя 		= Элемент.Представление;
		НоваяСтрока.ИмяРанее 	= Элемент.Представление;
		Если ТипЗнч(Элемент.Значение) = Тип("Структура") Тогда
			НоваяСтрока.Тип 		= Элемент.Значение.Тип;
			ДобавитьКолонки(НоваяСтрока,Элемент.Значение.Вложенные);		
		Иначе	
			НоваяСтрока.Тип 		= Элемент.Значение;	
		КонецЕсли;
		СписокТипов = ПолучитьСписокТипов(НоваяСтрока);	
		ДобавитьТипы(НоваяСтрока.ДеревоТипов,СписокТипов,0);
		Если Не НоваяСтрока.Тип = Произвольный() Тогда
			ОтметитьПометками(НоваяСтрока.ДеревоТипов,НоваяСтрока.Тип);
		КонецЕсли;		
	КонецЦикла;		
КонецПроцедуры

Функция ПолучитьСписокТипов(СтрокаСтруктуры)
	Результат = Новый СписокЗначений();
	Если Не СтрокаСтруктуры.ПолучитьРодителя() = Неопределено Тогда
		Результат = ВыборВызовСервераПовтИсп_Ei.СписокДоступныхТипов().Скопировать();			
	КонецЕсли;
	ДополнитьТипыКоллекций(Результат);
	Возврат Результат;
КонецФункции

Процедура ДополнитьТипыКоллекций(СписокТипов)
	СписокТипов.Вставить(0,"ДеревоЗначений","Дерево значений");
	СписокТипов.Вставить(0,"ТаблицаЗначений","Таблица значений");
КонецПроцедуры		

Процедура СтруктураПриНачалеРедактирования(Форма,Элемент, НоваяСтрока, Копирование) Экспорт
	ТД = Элемент.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		Если НоваяСтрока Тогда
			Если Не Копирование Тогда
				ТД.Тип 		= Произвольный();
				ДеревоТипов = ТД.ДеревоТипов;
				Если Не ДеревоТипов.ПолучитьЭлементы().Количество() Тогда
					СписокТипов = ПолучитьСписокТипов(ТД);
					ДобавитьТипы(ДеревоТипов,СписокТипов,0);		
				КонецЕсли;
				ИмяКадидат 		= "Колонка";
			Иначе
				ТД.ИмяРанее		= "";
				ИмяКадидат 		= ТД.Имя;		
			КонецЕсли;
			Родитель	= ТД.ПолучитьРодителя();
			Если Не Родитель = Неопределено Тогда
				ТД.Имя 		= ОбщийМодульКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("Имя",СокрЛП(ИмяКадидат)),Родитель.ПолучитьЭлементы());
			КонецЕсли	
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры

Процедура ПередОкончаниемРедактирования(Форма, Элемент, НоваяСтрока, ОтменаРедактирования, Отказ) Экспорт
	ТД 				= Элемент.ТекущиеДанные;
	сПричина 		= "";
	сИмя			= СтрЗаменить(ТД.Имя," ","");
	Попытка 
		вр = Новый Структура;
		вр.Вставить(сИмя);
	Исключение
		сПричина = "Имя '"+сИмя+"' не соответствует правилу именования ключа колонки";
	КонецПопытки;
	Родитель	= ТД.ПолучитьРодителя();
	Если Не ЗначениеЗаполнено(сПричина) И Не Родитель = Неопределено Тогда
		ДублиСтрок = ОбщийМодульКлиентСервер_Ei.НайтиВКоллекцииДерева(Новый Структура("Имя",сИмя),Родитель.ПолучитьЭлементы());
		Если ДублиСтрок.Количество()> 1 Тогда
			сПричина = "Колонка с именем '"+сИмя+"' на данном уровне уже существует";	
		КонецЕсли;	
	КонецЕсли;
	Если ЗначениеЗаполнено(сПричина) Тогда
		Если НоваяСтрока И ОтменаРедактирования Тогда
			//тут разрешаем отказаться 
		Иначе
			ПоказатьПредупреждение(,сПричина,20,"Ошибка в имени колонки");	
			Отказ = Истина;
		КонецЕсли;	
	Иначе
		//без лишних пробелов
		ТД.Имя = сИмя;
	КонецЕсли;	
КонецПроцедуры

Процедура ТипыПередРазворачиванием(Форма, Элемент, Строка, Отказ) Экспорт
	СтрокаТипов = Форма.Элементы.Структура.ТекущиеДанные.ДеревоТипов.НайтиПоИдентификатору(Строка);
	Если Не СтрокаТипов = Неопределено И ТипЗнч(СтрокаТипов.Значение) =  Тип("ОписаниеТипов") Тогда
		Если ОбщийМодульКлиент_Ei.УдалитьПустыеСтроки(СтрокаТипов) Тогда
			//Формируем список типов для их сортировки
			сзОписанияТипов = Новый СписокЗначений;
			Для Каждого Тип ИЗ СтрокаТипов.Значение.Типы() Цикл
				Значение 		= Тип;
				Описание 		= ТипыКлиентСервер_Ei.СоздатьОписаниеИзКолекции(Тип);
				сПредставление	= ТипыКлиентСервер_Ei.ПолучитьИмяОписанияТипов(Описание);
				сзОписанияТипов.Добавить(Значение,сПредставление);
			КонецЦикла;
			сзОписанияТипов.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
			ДобавитьТипы(СтрокаТипов,сзОписанияТипов,СтрокаТипов.Пометка);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Процедура ТипыПриИзменении(Форма,Элемент) Экспорт
	Перем мТипов,мСтрокТипов;
	ТДТипов = Форма.Элементы.СтруктураДеревоТипов.ТекущиеДанные;
	ТД 		= Форма.Элементы.Структура.ТекущиеДанные;
	ИзменитьПометки(ТДТипов);
	Если Не ТД = Неопределено Тогда
		ЗаполнитьМассивВыбранныхТипов(Форма,мТипов,мСтрокТипов);
		Родитель = ТД.ПолучитьРодителя();
		Если  Родитель = Неопределено Тогда
			//это строка верхнего уровня, определяет тип объекта
			Если мСтрокТипов.Количество() > 0 И мТипов.Количество() = 0 Тогда
				ТД.Тип = мСтрокТипов[0]; //всегда возьмем первую, а то не понятно как с дерева преключится на обычную							
			Иначе
				//тут укажем ошибку
				//вернем пометки 
				ОтметитьПометками(ТД.ДеревоТипов,ТД.Тип);	
			КонецЕсли;
		Иначе
			//это колонка
			Если мСтрокТипов.Количество() = 1 И мТипов.Количество() = 0 Тогда
				ТД.Тип = мСтрокТипов[0];			
			ИначеЕсли мТипов.Количество() > 0 И  мСтрокТипов.Количество() = 0 Тогда
				ТД.Тип = Новый ОписаниеТипов(мТипов);	 								
			ИначеЕсли мТипов.Количество() = 0 И  мСтрокТипов.Количество() = 0 Тогда
				ТД.Тип = Произвольный();
			Иначе
				//тут укажем ошибку
				//		
				//вернем пометки 
				ОтметитьПометками(ТД.ДеревоТипов,ТД.Тип);			 								
			КонецЕСли;			 								
		КонецЕсли;		
	КонецЕсли;	
КонецПроцедуры

Процедура ИзменитьПометки(ТДТипов)
	Если Не ТДТипов = Неопределено Тогда
		Родитель = ТДТипов.ПолучитьРодителя();
		Если  Не Родитель = Неопределено Тогда
			//Рассчитаем у установим пометку для родителя
			Сумма = ПолучитьСуммуПометок(Родитель);
			Всего = Родитель.ПолучитьЭлементы().Количество();
			Если Сумма = 0 Тогда
				Родитель.Пометка = 0;				
			ИначеЕсли Сумма = Всего Тогда
				Родитель.Пометка = ТДТипов.Пометка;	
			Иначе
				Родитель.Пометка = 2;  						
			КонецЕсли;		  						
		КонецЕсли;
		Для Каждого ПодСтрока ИЗ ТДТипов.ПолучитьЭлементы() Цикл
			ПодСтрока.Пометка = ТДТипов.Пометка;				
		КонецЦикла;				
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьТипы(СтрокаДЗ, Знач СписокТипов, Пометка)
	Перем НоваяСтрокаТипа;
	Для Каждого ЭлементСЗ  ИЗ СписокТипов Цикл
			Если ЗначениеЗаполнено(ЭлементСЗ.Значение) Тогда
				НоваяСтрокаТипа	= СтрокаДЗ.ПолучитьЭлементы().Добавить();
				НоваяСтрокаТипа.Пометка			= Пометка;
				НоваяСтрокаТипа.Представление	= ЭлементСЗ.Представление;
				Если ТипЗнч(ЭлементСЗ.Значение) = Тип("ОписаниеТипов") 
						И ЭлементСЗ.Значение.Типы().Количество() = 1 
						И Не ЭлементСЗ.Пометка //должны быть сгруппированы
					Тогда
					НоваяСтрокаТипа.Значение		= ЭлементСЗ.Значение.Типы()[0];	
				Иначе	
					НоваяСтрокаТипа.Значение		= ЭлементСЗ.Значение;
				КонецЕсли;	
				Если  ЭлементСЗ.Пометка Тогда
					//добавлем подстроку чтобы можно было развернуть
					НоваяСтрокаТипа.ПолучитьЭлементы().Добавить();
				КонецЕсли;					
			КонецЕсли;
		КонецЦикла;
КонецПроцедуры

Функция ПолучитьСуммуПометок(Строка)
	Результат = 0;
	Для Каждого ПодСтрока ИЗ Строка.ПолучитьЭлементы() Цикл
		Результат = Результат+ПодСтрока.Пометка;				
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьМассивВыбранныхТипов(Форма,мТипов,мСтрокТипов)
	мТипов 		= Новый Массив;
	мСтрокТипов = Новый Массив;
	Для Каждого Строка ИЗ  Форма.Элементы.Структура.ТекущиеДанные.ДеревоТипов.ПолучитьЭлементы() Цикл
		Если Строка.Пометка = 1 Тогда
			Если ТипЗнч(Строка.Значение) = Тип("ОписаниеТипов") Тогда
				ОбщийМодульКлиентСервер_Ei.вСоединить(мТипов,Строка.Значение.Типы());
			ИначеЕсли ТипЗнч(Строка.Значение) = Тип("Тип") Тогда
				мТипов.Добавить(Строка.Значение);	
			Иначе
				мСтрокТипов.Добавить(Строка.Значение);
			КонецЕсли;
		ИначеЕсли Строка.Пометка = 2 Тогда 
			Для Каждого ПодСтрока ИЗ Строка.ПолучитьЭлементы() Цикл
				Если ТипЗнч(ПодСтрока.Значение) = Тип("Тип") И ПодСтрока.Пометка = 1 Тогда
					мТипов.Добавить(ПодСтрока.Значение);
				КонецЕсли;				
			КонецЦикла;									
		КонецЕсли;		
	КонецЦикла;
КонецПроцедуры

Процедура ОтметитьПометками(ДеревоТипов,ОписаниеТипов)
	Для Каждого Строка ИЗ ДеревоТипов.ПолучитьЭлементы() Цикл
		Если ОписаниеТипов = Произвольный() Тогда
			Строка.Пометка = 0;
			ИзменитьПометки(Строка);
		ИначеЕсли ТипЗнч(ОписаниеТипов) =  Тип("ОписаниеТипов") Тогда
			Если ТипЗнч(Строка.Значение) = Тип("Тип") Тогда
				Строка.Пометка = (ОписаниеТипов.СодержитТип(Строка.Значение));
			ИначеЕсли ТипЗнч(Строка.Значение) = Тип("ОписаниеТипов") Тогда
				Если ТипыКлиентСервер_Ei.ОписанияПересекаются(Строка.Значение,ОписаниеТипов) Тогда
					Строка.Пометка = 1;
					ОтметитьПометками(Строка,ОписаниеТипов);	 	
				КонецЕсли;								
			КонецЕсли;							
		Иначе
			Строка.Пометка = (ОписаниеТипов = Строка.Значение);	
		КонецЕсли;						
	КонецЦикла			
КонецПроцедуры		

Функция Произвольный()
	Возврат "Произвольный";
КонецФункции			
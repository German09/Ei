

#Область СобытияФормы

//Возникает при открытии, заполняем форму
//
Процедура Инициализация(Форма,Отказ) Экспорт
	Настройка 	= ОбщегоНазначенияВызовСервера_Ei.Структурировать(Форма.Параметры.Настройка); //Если структурировать настройку на клиенте то не все типы смогут быть получены из настройки, например ссылочные типы	
	ДобавитьКолонки(Форма.Структура,Настройка);
КонецПроцедуры

//Разрешаем добавлять элементы только под таблицу или дерево
//
Процедура СтруктураПередНачаломДобавления(Форма,Элемент, Отказ, Копирование, Родитель, ЭтоГруппа, Параметр) Экспорт
	ТД = Элемент.ТекущиеДанные;
	Если Копирование Тогда
		Родитель = ТД.ПолучитьРодителя();
		Если Родитель = Неопределено Тогда
			//запрещаем копировать строку верхнего уровня
			Отказ = Истина;
		Иначе
			//https://forum.mista.ru/topic.php?id=649969
			Отказ = Истина;
			НоваяСтрока = Неопределено;
			НоваяСтрока	= СкопироватьСтроку(Родитель, ТД);
			ИмяКадидат 					= ТД.Имя;
			НоваяСтрока.ИмяОригинала	= ТД.ИмяРанее;
			НоваяСтрока.ИмяРанее		= "";
			НоваяСтрока.Имя 			= ОбщегоНазначенияКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("Имя",СокрЛП(ИмяКадидат)),Родитель.ПолучитьЭлементы(),,,Ложь);
			СтруктураПриИзменении(Форма,Элемент);			
		КонецЕсли;		
	Иначе	
		Если  ТипЗнч(ТД.Тип) = Тип("Строка") И Не ТД.Тип = КоллекцияСтруктураКлиентСервер_Ei.Произвольный() Тогда
			//тут можно добавлять
			
		Иначе	
			Отказ = Истина;
			ПоказатьПредупреждение(,"Колонки можно добавлять только под Таблицу или Дерево значений",20);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

Функция СкопироватьСтроку(Родитель, ТД)
	НоваяСтрока = Родитель.ПолучитьЭлементы().Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока,ТД,,"ДеревоТипов");
	ЗаполнитьДеревоТипов(НоваяСтрока);
	Для Каждого ПодСтрока ИЗ ТД.ПолучитьЭлементы() Цикл
		СкопироватьСтроку(НоваяСтрока, ПодСтрока);		
	КонецЦикла;	
	Возврат НоваяСтрока;
КонецФункции

Процедура СтруктураПриНачалеРедактирования(Форма,Элемент, НоваяСтрока, Копирование) Экспорт
	ТД = Элемент.ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		Если НоваяСтрока Тогда
			Если Не Копирование Тогда
				ТД.Тип 		= КоллекцияСтруктураКлиентСервер_Ei.Произвольный();
				ИмяКадидат 		= "Колонка";
				ЗаполнитьДеревоТипов(ТД);
			Иначе
				// см. СтруктураПередНачаломДобавления()	
			КонецЕсли;
			Родитель	= ТД.ПолучитьРодителя();
			Если Не Родитель = Неопределено Тогда
				ТД.Имя 		= ОбщегоНазначенияКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("Имя",СокрЛП(ИмяКадидат)),Родитель.ПолучитьЭлементы(),,,Ложь);
			КонецЕсли	
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры

Процедура СтруктураПриОкончанииРедактирования(Форма, Элемент, НоваяСтрока, ОтменаРедактирования) Экспорт
	Если НоваяСтрока И ОтменаРедактирования Тогда
		//тут ничего не делаем 
	Иначе		
		СтруктураПриИзменении(Форма,Элемент);
	КонецЕсли;	
КонецПроцедуры

Процедура ПередОкончаниемРедактирования(Форма, Элемент, НоваяСтрока, ОтменаРедактирования, Отказ) Экспорт
	ТД 				= Элемент.ТекущиеДанные;
	сПричина 		= "";
	сИмя			= СтрЗаменить(ТД.Имя," ","");
	Попытка 
		вр = Новый Структура;
		вр.Вставить(сИмя);
	Исключение
		сПричина = "Имя '"+сИмя+"' не соответствует правилу именования ключа колонки";
	КонецПопытки;
	Родитель	= ТД.ПолучитьРодителя();
	Если Не ЗначениеЗаполнено(сПричина) И Не Родитель = Неопределено Тогда
		ДублиСтрок = ОбщегоНазначенияКлиентСервер_Ei.НайтиВКоллекцииДерева(Новый Структура("Имя",сИмя),Родитель.ПолучитьЭлементы(),Ложь);
		Если ДублиСтрок.Количество()> 1 Тогда
			сПричина = "Колонка с именем '"+сИмя+"' на данном уровне уже существует";	
		КонецЕсли;	
	КонецЕсли;
	Если ЗначениеЗаполнено(сПричина) Тогда
		Если НоваяСтрока И ОтменаРедактирования Тогда
			//тут разрешаем отказаться 
		Иначе
			ПоказатьПредупреждение(,сПричина,20,"Ошибка в имени колонки");	
			Отказ = Истина;
		КонецЕсли;	
	Иначе
		//без лишних пробелов
		ТД.Имя = сИмя;
	КонецЕсли;	
КонецПроцедуры

//Попробуем изменить исходную таблицу, реквизиты и элементы формы
//
Процедура СтруктураПриИзменении(Форма,Элемент) Экспорт
	РедактированиеЗакончено = Истина;
	мКоллекцияИСостав = ПолучитьКоллекциюИСостав(Форма.Структура.ПолучитьЭлементы(),РедактированиеЗакончено);
	ВычислитьМодифицированность(Форма,мКоллекцияИСостав);
	Если РедактированиеЗакончено Тогда
		Форма.ИзменитьОбразецКоллекции(мКоллекцияИСостав);
	КонецЕсли;			
КонецПроцедуры

//Запрещаем удалять строку верхнего уровня
//
Процедура СтруктураПередУдалением(Форма,Элемент, Отказ) Экспорт
	Родитель = Элемент.ТекущиеДанные.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;		
КонецПроцедуры

Процедура ТипыПередРазворачиванием(Форма, Элемент, Строка, Отказ) Экспорт
	СтрокаТипов = Форма.Элементы.Структура.ТекущиеДанные.ДеревоТипов.НайтиПоИдентификатору(Строка);
	Если Не СтрокаТипов = Неопределено И ТипЗнч(СтрокаТипов.Значение) =  Тип("ОписаниеТипов") Тогда
		Если ОбщегоНазначенияКлиент_Ei.УдалитьПустыеСтроки(СтрокаТипов) Тогда
			//Формируем список типов для их сортировки
			сзОписанияТипов = Новый СписокЗначений;
			Для Каждого Тип ИЗ СтрокаТипов.Значение.Типы() Цикл
				Значение 		= Тип;
				Описание 		= ТипыКлиентСервер_Ei.СоздатьОписаниеИзКолекции(Тип);
				сПредставление	= ТипыКлиентСервер_Ei.ПолучитьИмяОписанияТипов(Описание);
				сзОписанияТипов.Добавить(Значение,сПредставление);
			КонецЦикла;
			сзОписанияТипов.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
			ДобавитьТипы(СтрокаТипов,сзОписанияТипов,СтрокаТипов.Пометка);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Процедура ТипыПриИзменении(Форма,Элемент) Экспорт
	Перем мТипов,мСтрокТипов;
	ТДТипов = Форма.Элементы.СтруктураДеревоТипов.ТекущиеДанные;
	ТД 		= Форма.Элементы.Структура.ТекущиеДанные;
	ИзменитьПометки(ТДТипов);
	ОтменитьПометки = Новый ОписаниеОповещения("ОтменитьПометки",ЭтотОбъект,ТД);
	Если Не ТД = Неопределено Тогда
		ЗаполнитьМассивВыбранныхТипов(Форма,мТипов,мСтрокТипов);
		Родитель = ТД.ПолучитьРодителя();
		Если  Родитель = Неопределено Тогда
			//это строка верхнего уровня, определяет тип объекта
			Если мСтрокТипов.Количество() > 0 И мТипов.Количество() = 0 Тогда
				ЗафиксироватьИзменениеТипа(Форма,ТД, мСтрокТипов[0]); //всегда возьмем первую, а то не понятно как с дерева преключится на обычную
			Иначе
				ПоказатьПредупреждение(ОтменитьПометки,"Выберите Таблицу или Дерево значений",20);
			КонецЕсли;
		Иначе
			//это колонка
			Если мСтрокТипов.Количество() > 0 И мТипов.Количество() = 0 Тогда
				ЗафиксироватьИзменениеТипа(Форма,ТД, мСтрокТипов[0]);			
			ИначеЕсли мТипов.Количество() > 0 И  мСтрокТипов.Количество() = 0 Тогда
				ПроверитьНаличиеПодчиненных(Форма,ТД,Новый ОписаниеТипов(мТипов)); 								
			ИначеЕсли мТипов.Количество() = 0 И  мСтрокТипов.Количество() = 0 Тогда
				ПроверитьНаличиеПодчиненных(Форма,ТД, КоллекцияСтруктураКлиентСервер_Ei.Произвольный());
			Иначе
				ПоказатьПредупреждение(ОтменитьПометки,"Для Коллекции Выберите Таблицу или Дерево значений. Для Колонки набор других типов без Дерева или ТаблицыЗначений",20);			 								
			КонецЕСли;			 								
		КонецЕсли;		
	КонецЕсли;	
КонецПроцедуры

//Проверим были ли вложенные строки если да, то нужно пердварительно задать вопрос об удалении и если откажется то ничего не делать
//				
Процедура ПроверитьНаличиеПодчиненных(Форма,ТД,Тип) 
	Если ТД.ПолучитьЭлементы().Количество() Тогда
		Параметры = Новый Структура("Форма,ТД,Тип",Форма,ТД,Тип); 
		ОО_Ответа = Новый ОписаниеОповещения("ВыборУдаленияПодчиненнных", ЭтотОбъект, Параметры);
		ПоказатьВопрос(ОО_Ответа, "Вложенные строки будут удалены, Продолжить?", РежимДиалогаВопрос.ОКОтмена,10,);	
	Иначе
		ЗафиксироватьИзменениеТипа(Форма,ТД,Тип);				
	КонецЕсли;				
КонецПроцедуры

Процедура ЗафиксироватьИзменениеТипа(Форма,ТД,Тип)
	ТД.Тип = Тип;
	СтруктураПриИзменении(Форма,Форма.Элементы.Структура);		
КонецПроцедуры	

Процедура ВыборУдаленияПодчиненнных(Результат, Параметры) Экспорт
	ТД 		= Параметры.ТД;
	Форма	= Параметры.Форма; 
    Если Результат = КодВозвратаДиалога.Ок Тогда
    	//Удаляем все вложенные
    	ТД.ПолучитьЭлементы().Очистить();
    	ЗафиксироватьИзменениеТипа(Форма,ТД, Параметры.Тип);	 
    Иначе	    
		//отменяем правки
		ОтменитьПометки(ТД);
    КонецЕсли;
КонецПроцедуры    
	 	

Процедура ОтменитьПометки(ТД) Экспорт
	ОтметитьПометками(ТД.ДеревоТипов,ТД.Тип)		
КонецПроцедуры

Процедура ПередЗакрытием(Форма, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка) Экспорт
	ВычислитьМодифицированность(Форма);
	Если Форма.Модифицированность Тогда
		Отказ = Истина;
		ПоказатьВопрос(Новый ОписаниеОповещения("ВыборСохранения",ЭтотОбъект,Новый Структура("Форма",Форма)),"Сохранить текущие изменения?", РежимДиалогаВопрос.ДаНетОтмена);
	КонецЕсли;
КонецПроцедуры
#КонецОбласти

// Процедура - описанная в ОписаниеОповещения вызывается при попытке закрытия обработки с результатом вопроса о сохранении
//
// Параметры:
//  РезультатВопроса - КодВозвратаДиалога-	Ответ на вопрос сохранить или нет
//  ДопПараметры	 - Структура	 		 
//
Процедура ВыборСохранения(РезультатВопроса, ДопПараметры) Экспорт
	Форма		= ДопПараметры.Форма;	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		мКоллекцияИСостав = ПолучитьКоллекциюИСостав(Форма.Структура.ПолучитьЭлементы(),Ложь);
		
		Форма.ТолькоПросмотр = Истина;
		Форма.Закрыть(мКоллекцияИСостав);
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		//отказались от продолжения операции
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Форма.ТолькоПросмотр = Истина;
		Форма.Закрыть();
	КонецЕсли;	
КонецПроцедуры

Процедура ВычислитьМодифицированность(Форма, мКоллекцияИСостав = Неопределено) Экспорт
	Если Не Форма.ТолькоПросмотр Тогда
		Если мКоллекцияИСостав = Неопределено Тогда
			сНастройка = ПолучитьНастройкуДляСохранения(Форма);
		Иначе
			сНастройка = ОбщегоНазначенияВызовСервера_Ei.Сериализовать(мКоллекцияИСостав);	
		КонецЕсли;		
		Форма.Модифицированность = Не(СокрЛП(Форма.Параметры.Настройка) = СокрЛП(сНастройка));
	Иначе
		Форма.Модифицированность = Ложь;
	КонецЕсли;		
КонецПроцедуры

Процедура ДобавитьКолонки(Коллекция,мКолонок)
	Для Каждого Значение ИЗ мКолонок Цикл
		НоваяСтрока  = Коллекция.ПолучитьЭлементы().Добавить();
		НоваяСтрока.Имя 		= Значение.Колонка.Имя;
		НоваяСтрока.ИмяРанее 	= Значение.Колонка.Имя;
		НоваяСтрока.Тип 		= ?(ЗначениеЗаполнено(Значение.Колонка.ТипЗначения),Значение.Колонка.ТипЗначения,КоллекцияСтруктураКлиентСервер_Ei.Произвольный());
		ДобавитьКолонки(НоваяСтрока,Значение.мКолонки);
		ЗаполнитьДеревоТипов(НоваяСтрока);		
//		СписокТипов = ПолучитьСписокТипов(НоваяСтрока);	
//		ДобавитьТипы(НоваяСтрока.ДеревоТипов,СписокТипов,0);
//		Если Не НоваяСтрока.Тип = КоллекцияСтруктураКлиентСервер_Ei.Произвольный() Тогда
//			ОтметитьПометками(НоваяСтрока.ДеревоТипов,НоваяСтрока.Тип);
//		КонецЕсли;		
	КонецЦикла;		
КонецПроцедуры

Процедура ЗаполнитьДеревоТипов(ТД)
	ДеревоТипов = ТД.ДеревоТипов;
	//Если Не ДеревоТипов.ПолучитьЭлементы().Количество() Тогда
		СписокТипов = ПолучитьСписокТипов(ТД);
		ДобавитьТипы(ДеревоТипов,СписокТипов,0);
		Если Не ТД.Тип = КоллекцияСтруктураКлиентСервер_Ei.Произвольный() Тогда
			ОтметитьПометками(ДеревоТипов,ТД.Тип);
		КонецЕсли;			
	//КонецЕсли;
КонецПроцедуры

Функция ПолучитьСписокТипов(СтрокаСтруктуры)
	Результат = Новый СписокЗначений();
	Если Не СтрокаСтруктуры.ПолучитьРодителя() = Неопределено Тогда
		Результат = ВыборВызовСервераПовтИсп_Ei.СписокДоступныхТипов().Скопировать();
		Результат.Добавить(Новый ОписаниеТипов("Null"),"Null");			
	КонецЕсли;
	ДополнитьТипыКоллекций(Результат);
	Возврат Результат;
КонецФункции

Процедура ДополнитьТипыКоллекций(СписокТипов)
	СписокТипов.Вставить(0,ТипыКлиентСервер_Ei.Универсальные().ДеревоЗначений, "Дерево значений");
	СписокТипов.Вставить(0,ТипыКлиентСервер_Ei.Универсальные().ТаблицаЗначений,"Таблица значений");
КонецПроцедуры		


Функция ПолучитьКоллекциюИСостав(Строки,НетОшибок)
	Результат =  Новый Массив; 
	Для Каждого Строка ИЗ Строки Цикл
		Если ЗначениеЗаполнено(Строка.Имя) Тогда //строка м.б. пустая если мы зашли в функцию до срабатывания обработчика ПередНачаломРедактирования
			Колонка 	= Новый Структура("Имя,ТипЗначения,ИмяРанее,ИмяОригинала",Строка.Имя,Строка.Тип,Строка.ИмяРанее,Строка.ИмяОригинала);
			Результат.Добавить(Новый Структура("Колонка,мКолонки",Колонка, ПолучитьКоллекциюИСостав(Строка.ПолучитьЭлементы(),НетОшибок)));
		Иначе
			НетОшибок	= Ложь;	
		КонецЕсли;	
	КонецЦикла;	
	Возврат Результат;				
Конецфункции		

Процедура ИзменитьПометки(ТДТипов)
	Если Не ТДТипов = Неопределено Тогда
		Родитель = ТДТипов.ПолучитьРодителя();
		Если  Не Родитель = Неопределено Тогда
			//Рассчитаем у установим пометку для родителя
			Сумма = ПолучитьСуммуПометок(Родитель);
			Всего = Родитель.ПолучитьЭлементы().Количество();
			Если Сумма = 0 Тогда
				Родитель.Пометка = 0;				
			ИначеЕсли Сумма = Всего Тогда
				Родитель.Пометка = ТДТипов.Пометка;	
			Иначе
				Родитель.Пометка = 2;  						
			КонецЕсли;		  						
		КонецЕсли;
		Для Каждого ПодСтрока ИЗ ТДТипов.ПолучитьЭлементы() Цикл
			ПодСтрока.Пометка = ТДТипов.Пометка;				
		КонецЦикла;				
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьТипы(СтрокаДЗ, Знач СписокТипов, Пометка)
	Перем НоваяСтрокаТипа;
	Для Каждого ЭлементСЗ  ИЗ СписокТипов Цикл
			Если ЗначениеЗаполнено(ЭлементСЗ.Значение) Тогда
				НоваяСтрокаТипа	= СтрокаДЗ.ПолучитьЭлементы().Добавить();
				НоваяСтрокаТипа.Пометка			= Пометка;
				НоваяСтрокаТипа.Представление	= ЭлементСЗ.Представление;
				Если ТипЗнч(ЭлементСЗ.Значение) = Тип("ОписаниеТипов") 
						И ЭлементСЗ.Значение.Типы().Количество() = 1 
						И Не ЭлементСЗ.Пометка //должны быть сгруппированы
					Тогда
					НоваяСтрокаТипа.Значение		= ЭлементСЗ.Значение.Типы()[0];	
				Иначе	
					НоваяСтрокаТипа.Значение		= ЭлементСЗ.Значение;
				КонецЕсли;	
				Если  ЭлементСЗ.Пометка Тогда
					//добавлем подстроку чтобы можно было развернуть
					НоваяСтрокаТипа.ПолучитьЭлементы().Добавить();
				КонецЕсли;					
			КонецЕсли;
		КонецЦикла;
КонецПроцедуры

Функция ПолучитьСуммуПометок(Строка)
	Результат = 0;
	Для Каждого ПодСтрока ИЗ Строка.ПолучитьЭлементы() Цикл
		Результат = Результат+ПодСтрока.Пометка;				
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьМассивВыбранныхТипов(Форма,мТипов,мСтрокТипов)
	мТипов 		= Новый Массив;
	мСтрокТипов = Новый Массив;
	Для Каждого Строка ИЗ  Форма.Элементы.Структура.ТекущиеДанные.ДеревоТипов.ПолучитьЭлементы() Цикл
		Если Строка.Пометка = 1 Тогда
			Если ТипЗнч(Строка.Значение) = Тип("ОписаниеТипов") Тогда
				ОбщегоНазначенияКлиентСервер_Ei.вСоединить(мТипов,Строка.Значение.Типы());
			ИначеЕсли ТипЗнч(Строка.Значение) = Тип("Тип") Тогда
				мТипов.Добавить(Строка.Значение);	
			Иначе
				мСтрокТипов.Добавить(Строка.Значение);
			КонецЕсли;
		ИначеЕсли Строка.Пометка = 2 Тогда 
			Для Каждого ПодСтрока ИЗ Строка.ПолучитьЭлементы() Цикл
				Если ТипЗнч(ПодСтрока.Значение) = Тип("Тип") И ПодСтрока.Пометка = 1 Тогда
					мТипов.Добавить(ПодСтрока.Значение);
				КонецЕсли;				
			КонецЦикла;									
		КонецЕсли;		
	КонецЦикла;
КонецПроцедуры

Процедура ОтметитьПометками(ДеревоТипов,ОписаниеТипов)
	Для Каждого Строка ИЗ ДеревоТипов.ПолучитьЭлементы() Цикл
		Если ОписаниеТипов = КоллекцияСтруктураКлиентСервер_Ei.Произвольный() Тогда
			Строка.Пометка = 0;
			ИзменитьПометки(Строка);
		ИначеЕсли ТипЗнч(ОписаниеТипов) =  Тип("ОписаниеТипов") Тогда
			Если ТипЗнч(Строка.Значение) = Тип("Тип") Тогда
				Строка.Пометка = (ОписаниеТипов.СодержитТип(Строка.Значение));
			ИначеЕсли ТипЗнч(Строка.Значение) = Тип("ОписаниеТипов") Тогда
				Если ТипыКлиентСервер_Ei.ОписанияПересекаются(Строка.Значение,ОписаниеТипов) Тогда
					Строка.Пометка = 1;
					ОтметитьПометками(Строка,ОписаниеТипов);	 	
				КонецЕсли;								
			КонецЕсли;							
		Иначе
			Строка.Пометка = (ОписаниеТипов = Строка.Значение);	
		КонецЕсли;						
	КонецЦикла			
КонецПроцедуры		



Функция ПолучитьНастройкуДляСохранения(Форма)
	мКоллекцияИСостав = ПолучитьКоллекциюИСостав(Форма.Структура.ПолучитьЭлементы(),Ложь);
	Возврат ОбщегоНазначенияВызовСервера_Ei.Сериализовать(мКоллекцияИСостав); 
КонецФункции


#Область ПрограммныйИнтерфейс

// Возвращает ключ подсистемы обработок процессов.
//
// Возвращаемое значение:
//  Строка - имя подсистемы обработок
//
Функция Ключ() Экспорт
	Возврат "Обработки";
КонецФункции

// Собирает настройки обработок из дерева доступных обработок.
//
// Параметры:
//  ДоступныеОбработки - ДанныеФормыДерево - дерево доступных обработок: виды обработок и обработки в них
//
// Возвращаемое значение:
//  ФиксированноеСоответствие из КлючИЗначение:
//   * Ключ - Строка - имя обработки
//   * Значение - ФиксированнаяСтруктура:
//    ** Настройка 		- Произвольный - настройка обработки
//    ** КлючНастроек 	- УникальныйИдентификатор - ключ настроек обработки
//    ** Обработчик 	- Строка - имя вида обработки
//    ** Представление 	- Строка - представление обработки: его получает заголовок ее элемента схемы
//
Функция ПолучитьДанныеОбработок(ДоступныеОбработки) Экспорт
	Результат = Новый Соответствие();
	Для Каждого СтрокаВида ИЗ ДоступныеОбработки.ПолучитьЭлементы() Цикл
		Для Каждого Строка ИЗ СтрокаВида.ПолучитьЭлементы() Цикл
			ДанныеОбработки = Новый Структура("Настройка, КлючНастроек, Обработчик", Строка.Настройка, Строка.КлючНастроек, СтрокаВида.Имя);
			ДанныеОбработки.Вставить("Представление", Строка.Представление);
			Результат.Вставить(Строка.Имя, Новый ФиксированнаяСтруктура(ДанныеОбработки));
		КонецЦикла;
	КонецЦикла;
	Возврат Новый ФиксированноеСоответствие(Результат);
КонецФункции

// Процедура - Добавить обработки в коллекцию
//
// Параметры:
//  Коллекция	 - ДанныеФормыКоллекцияЭлементовДерева  	-  Строки дерева доступный обработок
//  Обработки	 - см. ПолучитьДанныеОбработок
//
Процедура ДобавитьОбработкиВКоллекцию(Коллекция,Обработки) Экспорт 
	Если ТипЗнч(Обработки) = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого Элемент ИЗ Обработки Цикл
			Найденные = ОбщегоНазначенияКлиентСервер_Ei.НайтиВКоллекцииДерева(Новый Структура("Имя",Элемент.Значение.Обработчик),Коллекция,Ложь); 
			Если Найденные.Количество() Тогда
				Обработчик = Найденные[0];	
			Иначе	
				Обработчик	= Коллекция.Добавить();
				Обработчик.Имя	= Элемент.Значение.Обработчик;
			КонецЕсли;	
			// Представление сохраняется с 3.1.7.3, у сохраненных раньше - имя обработки
			Представление = Неопределено;
			Если Не Элемент.Значение.Свойство("Представление", Представление) Или Не ЗначениеЗаполнено(Представление) Тогда
				Представление = Элемент.Ключ;
			КонецЕсли;
			Обработка 				= Обработчик.ПолучитьЭлементы().Добавить();
			Обработка.Имя			= Элемент.Ключ;
			Обработка.Представление	= Представление;
			Обработка.КлючНастроек	= Элемент.Значение.КлючНастроек;
			Обработка.Настройка		= Элемент.Значение.Настройка;
		КонецЦикла;
	КонецЕсли;	
Конецпроцедуры	

#КонецОбласти

				Для Каждого Каталог ИЗ Каталоги Цикл
					Сохранить(Каталог,Новый Структура("Форма",Форма));		
				КонецЦикла;
			КонецЕсли;		
//			Длг 				= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
//			Длг.ПолноеИмяФайла 	= ФайлНастройки.ПолноеИмя;
//			Длг.Каталог 		= ФайлНастройки.Путь;
//			Длг.Заголовок 		= "Укажите файл для списка наборов";

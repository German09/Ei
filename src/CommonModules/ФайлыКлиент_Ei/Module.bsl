// Прочитать текст.
// 
// Параметры:
//  ИмяФайла - Строка - имя файла
// 
// Возвращаемое значение:
//  Строка, Неопределено - Прочитать текст
Функция ПрочитатьТекст(ИмяФайла) Экспорт
	Результат = "";
	ЧтениеТекста = Новый ЧтениеТекста(ИмяФайла);
	Результат = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	//файлы пишем см. ФайлыКлиентСервер_Ei.ЗаписатьСтроку, она добавляет перевод строки в конце,
	//а хэш при сохранении считается по тексту без него: уберем, иначе прочитанный текст не совпадет с сохраненным
	Если Прав(Результат, 1) = Символы.ПС Тогда
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Записать XMLСтроку.
// 
// Параметры:
//  ПолноеИмя 	- Строка
//  Содержание 	- Строка
Процедура ЗаписатьXMLСтроку(Знач ПолноеИмя,Содержание) Экспорт
	ЗаписьXML 		= Новый ЗаписьXML();
	ЗаписьXML.ОткрытьФайл(ПолноеИмя);
	ЗаписьXML.ЗаписатьБезОбработки(Содержание);
	ЗаписьXML.Закрыть();
КонецПроцедуры

// Получить имя временного файла настройки.
// 
// Параметры:
//  ИмяФайлаНастройки - Строка -
// 
// Возвращаемое значение:
//  Строка - Получить имя временного файла настройки
Функция ПолучитьИмяВременногоФайлаНастройки(ИмяФайлаНастройки) Экспорт
	Файл = Новый Файл(ИмяФайлаНастройки);
	Возврат Файл.Путь+"~"+Файл.ИмяБезРасширения+"."+РасширениеВременныйФайл();	
КонецФункции

// Подписаться на изменение файлов.
// 
// Параметры:
//  Форма см. ОбщаяФорма.Ei
// 
// Возвращаемое значение:
// 	Неопределено 
Асинх Функция ПодписатьсяНаИзменениеФайлов(Форма) Экспорт
	Если ЗначениеЗаполнено(Форма.ИмяФайлаНастройки) Тогда
		ИмяПроекта = Ждать EDTКлиент_Ei.ПолучитьИмяПроекта(Форма.ИмяФайлаНастройки, Ложь);
		НаборВариантовКлиент_Ei.ЗаполнитьФайлыКНаборам(Форма, Форма.ИмяФайлаНастройки, ИмяПроекта);
	КонецЕсли;
	ВКОтслеживания	= Ждать ПолучитьВКОтслеживания(Форма);
	Если Не ВКОтслеживания =  Неопределено Тогда
		ВКОтслеживания.НачатьСлежение(Форма.ИмяФайлаНастройки);
	КонецЕсли;	
КонецФункции			

#Область ПроверкаФайла
Процедура ОО_ПолучениеРезультатаСуществованияВременногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат Тогда
		Файл = Новый Файл(ДопПараметры.ИмяФайла);
		Файл.НачатьПолучениеВремениИзменения(Новый ОписаниеОповещения("ОО_ПолучениеВремениИзмененияВременногоФайла",ЭтотОбъект,ДопПараметры));
	КонецЕсли;
КонецПроцедуры	

Процедура ОО_ПолучениеВремениИзмененияВременногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат   >  ДопПараметры.ДатаИзмененияФайлаНастройки Тогда
		//файл запросов свяжее, загрузим результат из него
		Открыть(ДопПараметры.ИмяФайла,Новый Структура("Форма",ДопПараметры.Форма));
	КонецЕсли;	
КонецПроцедуры

Процедура ОО_ПолучениеВремениИзмененияСохраненногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат   >  ДопПараметры.ДатаИзменения Тогда
		//файл запросов свяжее, загрузим результат из него или из временного
		Открыть(ДопПараметры.ИмяФайла,Новый Структура("Форма,ДатаИзмененияФайлаНастройки",ДопПараметры.Форма,Результат));
	КонецЕсли;	
КонецПроцедуры
#КонецОбласти

// Считываем с ФС определенный Вариант
// 
// Параметры:
//  Форма см. ОбщаяФорма.Ei
//
Асинх Процедура Перечитать(Форма) Экспорт
	Если Не ПустаяСтрока(Форма.ИмяФайлаНастройки) Тогда
		Каталог    = Форма.ИмяФайлаНастройки;
		ИмяПроекта = Ждать EDTКлиент_Ei.ПолучитьИмяПроекта(Каталог);
		Если ЗначениеЗаполнено(ИмяПроекта) Тогда
			ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
			Если Не ТекД = Неопределено Тогда
				Вариант = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТекД);
				Если Не Вариант = Неопределено Тогда
					Если ТипЗнч(ТекД.Файлы) = Тип("Структура") Тогда
						//ИскомоеИмя = ВариантыКлиентСервер_Ei.ПолучитьИмя(ТекД.ИмяНабора,Вариант);
						ИсклюмыйКлюч =  Строка(ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(ТекД.КлючНастроек,Вариант.Свойства().Код));
						Для Каждого Файл ИЗ ТекД.Файлы Цикл
							Если Файл.Значение.Ключ = ИсклюмыйКлюч Тогда
								ПолноеИмя 	= СтрШаблон("%1%6%5%6%2s%6%3%6%4",Каталог,EDTКлиент_Ei.ВнешОбработка(),ИмяПроекта,Файл.Значение.Окончание,ФайлыКлиентСервер_Ei.КаталогИсходников(),ПолучитьРазделительПути());
								ЗагрузитьВариантИзФайла(Форма, ТекД, Вариант, Файл.Значение, ПолноеИмя, ПрочитатьТекст(ПолноеИмя));
								Прервать;	
							КонецЕсли;		
						КонецЦикла;
					КонецЕсли;			
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

// Сохранить в каталог обработки.
// 
// Параметры:
//  Форма 		см. ОбщаяФорма.Ei
//  СтрНаборов 	см. ВариантыКлиент_Ei.Получить
//  ИмяФайла 	- Строка - Имя папки
Асинх Процедура СохранитьВКаталогОбработки(Форма,СтрНаборов,ИмяФайла) Экспорт
	Перем Набор;
	ИмяПроекта		= "";
	СтрРезультат 	= Новый Структура;	
	Файл 			= Новый Файл(ИмяФайла);
	Каталог 		= Файл.ПолноеИмя+ПолучитьРазделительПути();
	ПутьИсходники 	= Ждать СоздатьКаталогАсинх(Каталог+ФайлыКлиентСервер_Ei.КаталогИсходников());
	ИмяНабора  		= НаборВариантовКлиентСервер_Ei.ПолучитьИмяНабора(СтрНаборов);
	СущКаталоги 	= ПолучитьСущКаталоги();
	Модуль			= Новый Массив;
	ВКОтслеживания	= Ждать ПолучитьВКОтслеживания(Форма);
	Модуль.Добавить("//Формируется см. ФайлыКлиент_Ei.СохранитьВКаталогОбработки");	
	Модуль.Добавить("#Область ПрограммныйИнтерфейс");
	Если Не ИмяНабора = Неопределено И СтрНаборов.Свойство(ИмяНабора,Набор) Тогда
		Если Не ВКОтслеживания =  Неопределено Тогда
			ВКОтслеживания.ОстановитьСлежение(ИмяФайла); //остановим слежение, чтобы не вызывать ненужных событий
		КонецЕсли;
		 
		Запись = Ждать EDTКлиент_Ei.ПолучитьМетаданныеОбработки(ПутьИсходники, Набор.КлючНастроек, ИмяНабора);
		Для Каждого СтрНабор ИЗ СтрНаборов Цикл
			Набор 		= СтрНабор.Значение;
			мСостава 	= Новый Массив;	
			СтрРезультат.Вставить(Набор.Имя,мСостава);			
			
			//Сохранение параметров
			РезультатыСохр = Ждать ПараметрыКлиент_Ei.СохранитьВКаталог(Запись.Каталог, Набор, ИмяНабора);
			//@skip-check bsl-legacy-check-for-each-statetement-collection
			Для Каждого СтрСохранения ИЗ РезультатыСохр Цикл
				мСостава.Добавить(СтрСохранения);
				ЗапомнитьКаталог(СущКаталоги,СтрСохранения);
				Модуль.Добавить(СтрСохранения.Описание);
				Модуль.Добавить(СтрСохранения.Получение);	
			КонецЦикла;		
			
			//Сохранение вариантов, тут поведение уже определяется настройкой каждого варианта
			РезультатыСохр = Ждать ВариантыКлиент_Ei.СохранитьВКаталог(Запись.Каталог, Набор, ИмяНабора);
			//@skip-check bsl-legacy-check-for-each-statetement-collection
			Для Каждого СтрСохранения ИЗ РезультатыСохр Цикл
				мСостава.Добавить(СтрСохранения);
				ЗапомнитьКаталог(СущКаталоги,СтрСохранения);
				Модуль.Добавить(СтрСохранения.Описание);
				Модуль.Добавить(СтрСохранения.Получение);	
			КонецЦикла;

		КонецЦикла;
		EDTКлиент_Ei.ЗаписатьСоставОбработки(Запись.ЗаписьXML,СтрРезультат, СтрНаборов);
		Запись.ЗаписьXML.ЗаписатьКонецЭлемента();	
		Запись.ЗаписьXML.Закрыть();
		Модуль.Добавить("#КонецОбласти");
		EDTКлиент_Ei.ЗаписатьМодуль(Запись.Каталог,СтрСоединить(Модуль,Символы.ПС),"Object");
		НаборВариантовКлиент_Ei.ЗапомнитьСсылкиНаФайлы(Форма, СтрРезультат, Файл.ПолноеИмя, ИмяНабора);
		
		//Служебные файлы для того чтобы проект можно было открыть в EDT
		Для Каждого СтрНабор ИЗ СтрНаборов Цикл
			Набор 		= СтрНабор.Значение;
			Если Набор.Родитель =  Неопределено Тогда		
				//Создаем файл проекта
				ИмяПроекта = Набор.Имя;
				EDTКлиент_Ei.СоздатьФайлПроекта(Каталог, ИмяПроекта,"V8ExternalObjectsNature");	
				//Определение
				EDTКлиент_Ei.СоздатьОпределение(Форма,Каталог);			
				Прервать;	
			КонецЕсли;
		КонецЦикла;
		//удалим каталоги, которых уже нет
		УдалитьНесуществующиеКаталоги(ИмяФайла,ИмяПроекта,СущКаталоги);
		Если Не ВКОтслеживания =  Неопределено Тогда
			ВКОтслеживания.НачатьСлежение(ИмяФайла);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

// Результат сохранения.
// 
// Параметры:
//  Имя					- Строка - Имя объекта. 			Набор_Параметр_Особенность
//  ПутьККорневойПапаке - Строка - Путь к корневой папаке	C:\Users\g.kudiakov\Documents\Ei_Настройка\src\ExternalDataProcessors\Набор
//  Текст 				- Строка - Текст файла				
//  ВариантКлюч 		- Строка - Ключ						55a4e36a-d2be-4a18-bbb0-c13c4a1ec5c5
//  Файл 				- Файл 	 - Считанный файл			C:\Users\g.kudiakov\Documents\Ei_Настройка\src\ExternalDataProcessors\Набор\Templates\Набор_Параметр_Особенность
//  ДопСвойства			- Структура -  Структура дополнительных свойств которая передается в результат:
//  	* Комментарий   - Строка - Параметр
//  	* Синоним 		- Строка - Имя параметра - Особенность
//  	* ТипМакета		- Строка - Ключ см. EDTКлиент_Ei.ТипыМакетов
//  	
// 
// Возвращаемое значение:
//  Структура - Результат сохранения:
// * Имя		- Строка - Имя объекта (для возможности сохранения в метаданные)- Набор_Параметр_Особенность
// * Ключ 		- Строка - 55a4e36a-d2be-4a18-bbb0-c13c4a1ec5c5
// * Каталог 	- Строка - Templates\Набор_Параметр_Особенность
// * Окончание 	- Строка - Templates\Набор_Параметр_Особенность\Template.txt
// * Ссылка 	- Строка - Относительный путь - Template.Набор_Параметр_Особенность
// * Хэш 		- Строка - BEDC02EFD880356D5B04DECE55DE8BB6
// * ТипМакета  - Строка - Ключ см. EDTКлиент_Ei.ТипыМакетов [не всегда, получаем из ДопСвойства, специфично для макета]
// * Синоним	- Строка - Синоним метаданных [почти всегда, получаем из ДопСвойства]
// * Описание	- Строка - Документирующий комментарий описания результата
// * Получение	- Строка - Текст алгоритма получения результата, который будет размещен в модуле обработки 
//
Функция РезультатСохранения(Имя, ПутьККорневойПапаке, Текст, ВариантКлюч, Файл, ДопСвойства = Неопределено) Экспорт
	ОтносительныйПуть 	= БезПоследнегоСимвола(СтрЗаменить(Файл.Путь,ПутьККорневойПапаке+"\",""));
	Ссылка 				= СтрЗаменить(ОтносительныйПуть,EDTКлиент_Ei.ОкончаниеКласса(),".");
	Результат 			= Новый Структура("Ключ,Каталог,Ссылка",ВариантКлюч,ОтносительныйПуть,Ссылка);
	Результат.Вставить("Хэш",		ОбщегоНазначенияВызовСервера_Ei.ПолучитьХешСтроки(Текст));
	Результат.Вставить("Имя",		ОбщегоНазначенияКлиентСервер_Ei.СтрПослеОкончание(Ссылка,"."));
	Результат.Вставить("Окончание",	СтрШаблон("%1\%2",ОтносительныйПуть,Файл.Имя));
	Если ТипЗнч(ДопСвойства) = Тип("Структура") Тогда
		//дополним специфичными свойствами 
		ОбщегоНазначенияКлиентСервер_Ei.вСоединить(Результат,ДопСвойства);		
	КонецЕсли;	
	//@skip-check constructor-function-return-section
	Возврат Результат;	
КонецФункции

// Сохраняет по умолчанию в текстовый макет, самый простой случай
// 
// Параметры:
//  Обработчик 	- ОбщийМодуль
//  Путь 		- Строка 
//  НаборИмя 	- Строка
//  НаборКлюч  	- Строка
//  Данные 		- ФиксированнаяСтруктура
// 
// Возвращаемое значение:
// 	см. СохранитьВМакет
Асинх Функция СохранитьОбщее(Обработчик, Путь, НаборИмя, НаборКлюч, Данные) Экспорт
	ВариантКлюч	= ВариантыКлиентСервер_Ei.ПолучитьИдентификатор(НаборКлюч,Обработчик);
	ВариантИмя	= ВариантыКлиентСервер_Ei.ПолучитьИмя(НаборИмя,Обработчик);
	Содержание		= ОбщегоНазначенияВызовСервера_Ei.Сериализовать(Новый Структура(Данные)); //Структуру делаем из фиксированной структуры
	//КаталогПуть = Ждать EDTКлиент_Ei.СоздатьОбшийМакет(Путь, Содержание, ВариантИмя, ВариантКлюч);
	Результат 	= СохранитьВМакет("TextDocument", НаборИмя, Путь, Содержание, ВариантИмя, ВариантКлюч);
	Возврат Результат;
КонецФункции

// Сохраняет по умолчанию в макет определенного типа
// 
// Параметры:
// 	ТипМакета		- Строка - Ключ из см. EDTКлиент_Ei.ТипыМакетов
//  НаборИмя 		- Строка
//  Путь 			- Строка
//  Содержание			- Строка - Содержание макета 
//  ВариантИмя  	- Строка
//  ВариантКлюч  	- Строка
//  Данные 			- ФиксированнаяСтруктура
// 
// Возвращаемое значение:
// 	см. РезультатСохранения
Асинх Функция СохранитьВМакет(Знач ТипМакета, НаборИмя, Путь, Содержание, ВариантИмя, ВариантКлюч) Экспорт
	Перем ИмяМакета;
	Если EDTКлиент_Ei.ТипыМакетов().Свойство(ТипМакета,ИмяМакета) Тогда
		ДопСвойства = Новый Структура("ТипМакета,Синоним", ТипМакета, НаборИмя);
		ПолноеИмя	= Ждать EDTКлиент_Ei.СоздатьМакетОбработки(Путь, Содержание, ВариантИмя, ВариантКлюч, ИмяМакета, НаборИмя);
		Результат 	= РезультатСохранения(НаборИмя, Путь, Содержание, ВариантКлюч, Новый Файл(ПолноеИмя), ДопСвойства);
		Возврат Результат;
	КонецЕсли;	
КонецФункции

// Сохранить начало.
// 
// Параметры:
//  Форма 					см. ОбщаяФорма.Ei
//  ЗапрашиватьСохранение 	- Булево - Запрашивать сохранение
//  ЗапрашиватьИмяФайла 	- Булево - Запрашивать имя файла
// 
// Возвращаемое значение:
// 	Булево - Довели процесс сохранения до конца или отказались на каком то этапе вопросов 
Асинх Функция Сохранить(Форма, ЗапрашиватьСохранение = Ложь, ЗапрашиватьИмяФайла = Ложь) Экспорт 
	Существует = Ложь;
	Если Не ЗапрашиватьИмяФайла И ЗапрашиватьСохранение Тогда
		Ответ = Ждать ВопросАсинх("Сохранить текущие варианты?", РежимДиалогаВопрос.ДаНетОтмена);		
		Если Ответ = Неопределено ИЛИ Ответ = КодВозвратаДиалога.Отмена Тогда
			Возврат Ложь;
		ИначеЕсли Ответ = КодВозвратаДиалога.Нет  Тогда
			Возврат Истина;		
		КонецЕсли;
	КонецЕсли;
	СохраненныйКаталог 	= Новый Файл(Форма.ИмяФайлаНастройки);
	Если ПустаяСтрока(Форма.ИмяФайлаНастройки) Тогда
		Существует = Ложь;
	Иначе	
		Существует = Ждать СохраненныйКаталог.СуществуетАсинх();		
	КонецЕсли;
	
	Если ЗапрашиватьИмяФайла ИЛИ Не Существует Тогда
		Длг 					= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
		Длг.Каталог 			= СохраненныйКаталог.Путь;
		Длг.Заголовок 			= "Выберите каталог для сохранения вариантов";
		Длг.МножественныйВыбор 	= Ложь;
		Каталоги = Ждать Длг.ВыбратьАсинх();
		Если Каталоги =  Неопределено Тогда
			Возврат Ложь;
		Иначе	
			Для Каждого Каталог ИЗ Каталоги Цикл
				СохранитьВКаталог(Форма, Каталог);
				Прервать; //по идее будет только один		
			КонецЦикла;	
		КонецЕсли;		
	Иначе 	
		СохранитьВКаталог(Форма, СохраненныйКаталог.ПолноеИмя);
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Начинает открытие набора из папки
//
// Параметры:
//  Форма 		 см. ОбщаяФорма.Ei
//           
Асинх Процедура Выбрать(Форма) Экспорт
	ФайлКаталог 	= Новый Файл(Форма.ИмяФайлаНастройки);
	Длг 			= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Длг.Каталог 	= ФайлКаталог;
	Длг.Заголовок 	= "Выберите каталог с варинтами";
	Длг.МножественныйВыбор 	= Ложь;
	Каталоги = Ждать Длг.ВыбратьАсинх();
	Если Не Каталоги =  Неопределено Тогда
		Для Каждого Каталог ИЗ Каталоги Цикл
			ИмяПроекта = Ждать EDTКлиент_Ei.ПолучитьИмяПроекта(Каталог);
			Если ЗначениеЗаполнено(ИмяПроекта) Тогда
				СсылкиНаФайлы = Новый Структура;
				Набор = Ждать EDTКлиент_Ei.ПрочитатьСоставОбработки(Каталог,ИмяПроекта,СсылкиНаФайлы);
				Если Не Набор =  Неопределено Тогда	
					ЗагрузитьВарианты(Форма,Набор,Каталог,ИмяПроекта,СсылкиНаФайлы);
					Форма.СохраненныйОбраз 		= вПолучитьСохраняемыйОбраз(Форма);
					ПослеОбновленияФС(Форма, Каталог);
					Прервать;
				КонецЕсли;	
			КонецЕсли;			
		КонецЦикла;
	КонецЕсли;		
КонецПроцедуры


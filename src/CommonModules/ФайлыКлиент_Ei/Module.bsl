// Подготовка к созданию нового файла запросов
//
// Параметры:
//  Результат		- Неопределено
//  ДопПараметры	- Структура:
//  	*Форма 		 см. ОбщаяФорма.Ei
//
Процедура СоздатьНовый(Результат, ДопПараметры = Неопределено) Экспорт
	Перем Форма;
	Если 	ДопПараметры.Свойство("Форма",Форма) 
			И ТипЗнч(Форма) = Тип("ФормаКлиентскогоПриложения") Тогда
		Форма.ИмяФайлаНастройки = "";
		НаборВариантовКлиент_Ei.Очистить(Форма);
		КонструкторКлиент_Ei.УстановитьЗаголовок(Форма);
		НаборВариантовКлиент_Ei.СоздатьНовый(Форма);
		ВариантыКлиент_Ei.ОбновитьВаринаты(Форма,НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма));
		Форма.СохраненныйОбраз 		= вПолучитьСохраняемыйОбраз(Форма);
		Форма.Модифицированность 	= Ложь;
	КонецЕсли;	
КонецПроцедуры


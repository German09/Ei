// Запомнить каталог.
// 
// Параметры:
//  СущКаталоги см. ПолучитьСущКаталоги
//  СтрСохранения см. ФайлыКлиент_Ei.РезультатСохранения
Процедура ЗапомнитьКаталог(СущКаталоги,СтрСохранения)
	Файлы = Неопределено; 
	Для Каждого Путь ИЗ  СтрРазделить(СтрСохранения.Каталог,"\") Цикл
		Если Файлы = Неопределено Тогда
			//это первый проход
			Файлы = СущКаталоги.Получить(Путь);
		Иначе
			Файлы.Добавить(нРег(Путь));
		КонецЕсли;			
	КонецЦикла;			
КонецПроцедуры

// Удаляет только прежние объекты Ei, которых больше нет в новом составе.
// Посторонние и неописанные в .mdo каталоги не входят в кандидаты на удаление.
//
// Параметры:
//  ИмяПапкиПроекта - Строка - каталог проекта
//  ИмяПроекта - Строка - имя обработки
//  СущКаталоги - см. ПолучитьСущКаталоги
//  ОбъектыEi - Массив из Структура - прежние объекты Ei:
//   * Тип - Строка - Forms или Templates
//   * Имя - Строка - имя каталога
//
// Возвращаемое значение:
//  Булево - очистка завершена
Асинх Функция УдалитьНесуществующиеКаталоги(ИмяПапкиПроекта, ИмяПроекта, СущКаталоги, ОбъектыEi)
	Для Каждого Объект Из ОбъектыEi Цикл
		Каталоги = СущКаталоги.Получить(Объект.Тип);
		Если Каталоги <> Неопределено И Каталоги.Найти(НРег(Объект.Имя)) = Неопределено Тогда
			Путь = СтрШаблон("%1%6%5%6%2s%6%3%6%4%6%7", ИмяПапкиПроекта, EDTКлиент_Ei.ВнешОбработка(),
				ИмяПроекта, Объект.Тип, ФайлыКлиентСервер_Ei.КаталогИсходников(), ПолучитьРазделительПути(), Объект.Имя);
			Ждать УдалитьФайлыАсинх(Путь);
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция БезПоследнегоСимвола(Путь,Символ = "\")
	Результат = Путь;
	Если СтрЗаканчиваетсяНа(Путь,Символ) Тогда
		Результат = Лев(Путь,СтрДлина(Путь)-1);		
	КонецЕсли;
	Возврат Результат;
КонецФункции			 


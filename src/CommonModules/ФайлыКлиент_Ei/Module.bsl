//  	*Значение	- Массив ИЗ Строка
Функция ПолучитьСущКаталоги()
	СущКаталоги 	= Новый Соответствие();
	Для Каждого ТипыМетаданных ИЗ EDTКлиент_Ei.ТипыМетаданных() Цикл
		СущКаталоги.Вставить(ТипыМетаданных.Значение,	Новый Массив);
	КонецЦикла;

#Область Сохранение
Процедура Сохранить_Начало(Форма, ЗапрашиватьСохранение = Ложь, ЗапрашиватьИмяФайла = Ложь, ОО_Завершения = Неопределено) Экспорт 
	//вСохранитьЗапросТекущейСтроки();
	ДопПараметры = Новый Структура("Форма,ЗапрашиватьИмяФайла,ОО_Завершения",Форма,ЗапрашиватьИмяФайла,ОО_Завершения);
	Если Не ЗапрашиватьИмяФайла И ЗапрашиватьСохранение Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("Сохранить_Выбор",ЭтотОбъект,ДопПараметры),"Сохранить текущие варианты?", РежимДиалогаВопрос.ДаНетОтмена);
	Иначе
		Сохранить_Выбор(КодВозвратаДиалога.Да, ДопПараметры);
	КонецЕсли;
КонецПроцедуры

// Начинает сохранение дерево запросов в файл запросов
//
// Параметры:
//  РезультатВопроса	- КодВозвратаДиалога 	 - признак необходимости предупрежедния перед сохранением
//  ДопПараметры	 	- Структура	 - Дополнительные параметры 
//           
Процедура Сохранить_Выбор(РезультатВопроса, ДопПараметры) Экспорт
	Форма 			= ДопПараметры.Форма;
	ФайлНастройки 	= Новый Файл(Форма.ИмяФайлаНастройки);
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Если ДопПараметры.ЗапрашиватьИмяФайла ИЛИ ПустаяСтрока(Форма.ИмяФайлаНастройки) Тогда
			Длг 				= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
			Длг.ПолноеИмяФайла 	= ФайлНастройки.ПолноеИмя;
			Длг.Каталог 		= ФайлНастройки.Путь;
			Длг.Заголовок 		= "Укажите файл для списка запросов";
			Длг.Расширение 		= РасширениеФайл();
			Длг.Фильтр 			= "Файлы запросов (*."+Длг.Расширение+")|*."+Длг.Расширение+"|Файлы консоли отчётов (*.rcf)|*.rcf|Все файлы (*.*)|*.*";
			Длг.Показать(Новый ОписаниеОповещения("Сохранить_Завершение",ЭтотОбъект));
		Иначе	
			Сохранить(ФайлНастройки.ПолноеИмя,ДопПараметры);
		КонецЕсли;
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		//отказались от продолжения операции
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет И Не ДопПараметры.ОО_Завершения = Неопределено Тогда	
		ВыполнитьОбработкуОповещения(ДопПараметры.ОО_Завершения);
	КонецЕсли;	
КонецПроцедуры

Процедура Сохранить_Завершение(ВыбранныеФайлы, ДопПараметры) Экспорт
	Если Не ВыбранныеФайлы = Неопределено Тогда
		Для Каждого сИмяФайла ИЗ ВыбранныеФайлы	Цикл
			Сохранить(сИмяФайла,ДопПараметры);
			Прервать;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

Процедура Сохранить(сИмяФайла,ДопПараметры) Экспорт
	Форма 			= ДопПараметры.Форма;
	СобытиеОтладки 	= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Сохранение списка запросов в файл "+сИмяФайла,"Конструктор");
	//АктуализироватьДинамическиеПоказатели(Ложь); //Актуализируем динамические показатели, могли и не бегать по строкам
	Попытка
		ЗТ = Новый ЗаписьТекста(сИмяФайла);
		ЗТ.ЗаписатьСтроку(ОбщийМодульВызовСервера_Ei.Сериализовать(ПолучитьВарианты(Форма[КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента()].ПолучитьЭлементы())));//ПолучитьПредставлениеДереваЗапросов(мПолучитьВспомогательныеКолонки()));
		ЗТ.Закрыть();
	Исключение
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	
	Файл 				= Новый Файл(сИмяФайла);
	ЭтоВременныйФайл 	= (Файл.Расширение = "."+РасширениеВременныйФайл());
	Если Не ЭтоВременныйФайл Тогда  
		Форма.Модифицированность 	= Ложь;
		Форма.ИмяФайлаНастройки 	= сИмяФайла;//вСохранитьИмяФайла();
		Форма.вУстановитьЗаголовокФормы(Ложь);
	КонецЕсли;
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,"ОО_Завершения") И Не ДопПараметры.ОО_Завершения = Неопределено Тогда	
		ВыполнитьОбработкуОповещения(ДопПараметры.ОО_Завершения);
	КонецЕсли;
КонецПроцедуры

// Функция - Получаетить список вариантов из дерева значений
// обратно перобразуется функцией ЗагрзитьПредставлениеВДеревоЗапросов()
//
// Параметры:
//  Коллекция	 - ДанныеФормыКоллекцияЭлементовДерева  	-  Строки дерева варинатов	 - 
// 
// Возвращаемое значение:
//   - Список значений
//
Функция ПолучитьВарианты(Коллекция) Экспорт
	сзВариантов = Новый СписокЗначений;
	Для Каждого Строка ИЗ Коллекция Цикл
		Значение = Новый Соответствие;
		Значение.Вставить("Query.bsl",			Строка.ТекстЗапроса);
		Значение.Вставить("Algoritm.bsl",		Строка.Язык);
		Значение.Вставить("DataComposition.xml",Строка.ТекстСКД);
		//Значение.Вставить("Comment.xml",		Строка.КомментарийXDTO);

			ЗначенияПараметров = Новый СписокЗначений;
			Для Каждого Параметр ИЗ Строка.ПараметрыЗапроса Цикл
				Если Параметр.ЭтоВыражение Тогда
	        		ЗначенияПараметров.Добавить(Параметр.ЗначениеПараметра, Параметр.ИмяПараметра+".bsl");
				Иначе
					ЗначенияПараметров.Добавить(Параметр.ЗначениеПараметра, Параметр.ИмяПараметра+".xml"); //ОбщийМодульКлиентСервер_Ei.Сериализовать(Параметр.ЗначениеПараметра)
				КонецЕСли;	
			КонецЦикла;	
		Значение.Вставить("Params", 			ЗначенияПараметров);
		Значение.Вставить("Settings.xml",		ОбщийМодульКлиент_Ei.ПолучитьСтруктуруДанных(Строка,"КлючНастроек,ПоказателиСтроки"));
		//Значение.Вставить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ИмяФайлаСтатистики(), ОбщийМодульКлиент_Ei.ПолучитьСтруктуруДанных(Строка,"ПоказателиРезультата,ПоказателиВыполнения"));
		Значение.Вставить("Process",			ВариантКлиентСервер_Ei_Процессы.ПодготовитьДанные(Строка));
		Значение.Вставить("",					ПолучитьВарианты(Строка.ПолучитьЭлементы())); //теперь вложенные
		сзВариантов.Добавить(Значение,Строка.Запрос);
	КонецЦикла;
	Возврат сзВариантов;
КонецФункции
#КонецОбласти

#Область Чтение
// Начинает сохранение дерево запросов в файл запросов
//
// Параметры:
//  ЗапрашиватьСохранение	 - Булево 	 - признак необходимости предупрежедния перед сохранением
//  ЗапрашиватьИмяФайла		 - Булево	 - признак необходимости запроса имени файла
//   - 
//           
Процедура Открыть_Выбор(РезультатВопроса, ДопПараметры) Экспорт
	Форма			= ДопПараметры.Форма;
	ФайлНастройки 	= Новый Файл(Форма.ИмяФайлаНастройки);
	Длг 				= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Длг.ПолноеИмяФайла 	= ФайлНастройки.ПолноеИмя;
	Длг.Каталог 		= ФайлНастройки.Путь;
	Длг.Заголовок 		= "Выберите файл со списком запросов";
	Длг.Расширение 		= РасширениеФайл();
	Длг.Фильтр 			= "Файлы запросов (*."+Длг.Расширение+")|*."+Длг.Расширение+"|Все файлы (*.*)|*.*";
	Длг.Показать(Новый ОписаниеОповещения("Открыть_Завершение",ЭтотОбъект,ДопПараметры));
КонецПроцедуры

Процедура Открыть_Завершение(ВыбранныеФайлы, ДопПараметры) Экспорт
	Если Не ВыбранныеФайлы = Неопределено Тогда
		Для Каждого сИмяФайла ИЗ ВыбранныеФайлы	Цикл
			Открыть(сИмяФайла,ДопПараметры);
			Прервать;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

// Загружает дерево запросов, текстов модулей и других данных из файла
//
Процедура Открыть(сИмяФайла,ДопПараметры) 
	Форма			= ДопПараметры.Форма;
	СобытиеОтладки 	= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Чтение списка запросов из файла "+сИмяФайла,"Конструктор");
	Попытка
		Результат = ПрочитатьТекст(сИмяФайла);
		Если ЗначениеЗаполнено(Результат) Тогда
			ЗагрузитьВарианты(Форма,Результат);
		КонецЕсли;	
	Исключение
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	Файл 				= Новый Файл(сИмяФайла);
	ЭтоВременныйФайл 	= (Файл.Расширение = "."+РасширениеВременныйФайл());
	Если Не ЭтоВременныйФайл Тогда  
		Форма.Модифицированность 	= Ложь;
		Форма.ИмяФайлаНастройки 	= сИмяФайла;//вСохранитьИмяФайла();
	КонецЕсли;
	ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,"ДатаИзмененияФайлаНастройки",Форма.ДатаИзменения); //обновим дату а то пойжет бесконечный цикл, буде каждый раз перечитывайть файл настроек
	Форма.вУстановитьЗаголовокФормы(,ЭтоВременныйФайл);
	Если Не ЭтоВременныйФайл Тогда	
		Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,"ДатаИзмененияФайлаНастройки") Тогда
			//проверим а нет ли сохраненного врменного файла с датой больше чем дата сохраненного запроса, если есть то данные прочитаем из него
			Файл = Новый Файл(ПолучитьИмяВременногоФайлаНастройки(сИмяФайла));
			Файл.НачатьПроверкуСуществования(Новый ОписаниеОповещения("ОО_ПолучениеРезультатаСуществованияВременногоФайла",ЭтотОбъект,Новый Структура("Форма, ДатаИзмененияФайлаНастройки,ИмяФайла",Форма,ДопПараметры.ДатаИзмененияФайлаНастройки,Файл.ПолноеИмя)));
		КонецЕсли;
	Иначе
		Форма.Модифицированность 	= Истина; //покажем модифицированность чтобы кто бы чего не думал
	КонецЕсли;	
КонецПроцедуры

// Процедура - загружает дерево вариантов из сохраненной строки
//
// Параметры:
//  сДеревоЗапросов	 - Строка	- Сериализованное процедурой  ПолучитьВарианты() список значений вариантов
//
Процедура ЗагрузитьВарианты(Форма,сДеревоЗапросов)
	Элементы = Форма[КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента()].ПолучитьЭлементы();
	Элементы.Очистить();
	сзВариантов = ОбщийМодульВызовСервера_Ei.Структурировать(сДеревоЗапросов,Новый СписокЗначений);
	ДобавитьВариантыВКоллекцию(Элементы,сзВариантов)
КонецПроцедуры

// Процедура - Добавляет варианты 
//
// Параметры:
//  Коллекция	 - ДанныеФормыКоллекцияЭлементовДерева  	-  Строки дерева варинатов
//  сзВариантов	 - СписокЗначений	 - список значений сформированный ранее функцией вПолучитьСохраняемыйОбраз()
//
Процедура ДобавитьВариантыВКоллекцию(Коллекция,сзВариантов)
	Если ТипЗнч(сзВариантов) = Тип("СписокЗначений") Тогда
		Для Каждого Элемент ИЗ сзВариантов Цикл
			Вариант = Коллекция.Добавить();
			Вариант.Запрос 			= Элемент.Представление;
			Вариант.ТекстЗапроса	= Элемент.Значение.Получить("Query.bsl");
			Вариант.Язык			= Элемент.Значение.Получить("Algoritm.bsl");
			Вариант.ТекстСКД		= Элемент.Значение.Получить("DataComposition.xml");
			//Вариант.КомментарийXDTO	= Элемент.Значение.Получить("Comment.xml");
			сзПараметры 			= Элемент.Значение.Получить("Params");
			Если ТипЗнч(сзПараметры) =  Тип("СписокЗначений") Тогда
				Для Каждого ЭлПараметра ИЗ сзПараметры Цикл
					Параметр 					= Вариант.ПараметрыЗапроса.Добавить();
					Параметр.ЭтоВыражение		= СтрЗаканчиваетсяНа(ЭлПараметра.Представление,нРег("bsl"));
					Параметр.ИмяПараметра		= Лев(ЭлПараметра.Представление,Найти(ЭлПараметра.Представление,".")-1);
					//Если Параметр.ЭтоВыражение Тогда
						Параметр.ЗначениеПараметра  = ЭлПараметра.Значение;
					//Иначе
					//	Параметр.ЗначениеПараметра  = ОбщийМодульКлиентСервер_Ei.Структурировать(ЭлПараметра.Значение,Неопределено);   //ОбщийМодульВызовСервера_Ei  ОбщийМодульКлиентСервер_Ei
					//КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;
			стрНастройки 			= Элемент.Значение.Получить("Settings.xml");
			Если ТипЗнч(стрНастройки) =  Тип("Структура") Тогда
				ЗаполнитьЗначенияСвойств(Вариант,стрНастройки);	
			КонецЕсли;
//			стрСтатистика 			= Элемент.Значение.Получить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ИмяФайлаСтатистики());
//			Если ТипЗнч(стрСтатистика) =  Тип("Структура") Тогда
//				Если стрСтатистика.Свойство("ПоказателиРезультата") Тогда
//					ОбщийМодульКлиентСервер_Ei.ПроверитьПоказателиРезультата(стрСтатистика.ПоказателиРезультата);
//					//обнулим адреса в большинстве случаев они уже не действительны
//					стрСтатистика.ПоказателиРезультата.Вставить("сооАдресовРезультатов",Новый Соответствие);
//				КонецЕсли;	
//				ЗаполнитьЗначенияСвойств(Вариант,стрСтатистика);	
//			КонецЕсли;
			ВариантКлиентСервер_Ei_Процессы.ЗагрузитьДанные(Вариант, Элемент.Значение.Получить("Process"));
			//сооПроцессы 			= Элемент.Значение.Получить("Process");
			//Если ТипЗнч(сооПроцессы) =  Тип("Соответствие") Тогда
			//	Вариант.ГрафСхемаXDTO	= сооПроцессы.Получить("GraphicalSchema.xml");
			//	ДобавитьОбработкиВКоллекцию(Вариант.ДоступныеОбработки.ПолучитьЭлементы(),сооПроцессы.Получить(""))
			//КонецЕсли;	
			//Теперь вложенные
			ДобавитьВариантыВКоллекцию(Вариант.ПолучитьЭлементы(),Элемент.Значение.Получить(""));
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры
#КонецОбласти

#Область ПроверкаФайла
Процедура ОО_ПолучениеРезультатаСуществованияВременногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат Тогда
		Файл = Новый Файл(ДопПараметры.ИмяФайла);
		Файл.НачатьПолучениеВремениИзменения(Новый ОписаниеОповещения("ОО_ПолучениеВремениИзмененияВременногоФайла",ЭтотОбъект,ДопПараметры));
	КонецЕсли;
КонецПроцедуры	

Процедура ОО_ПолучениеВремениИзмененияВременногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат   >  ДопПараметры.ДатаИзмененияФайлаНастройки Тогда
		//файл запросов свяжее, загрузим результат из него
		Открыть(ДопПараметры.ИмяФайла,Новый Структура("Форма",ДопПараметры.Форма));
	КонецЕсли;	
КонецПроцедуры

Процедура ОО_ПолучениеВремениИзмененияСохраненногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат   >  ДопПараметры.ДатаИзменения Тогда
		//файл запросов свяжее, загрузим результат из него или из временного
		Открыть(ДопПараметры.ИмяФайла,Новый Структура("Форма,ДатаИзмененияФайлаНастройки",ДопПараметры.Форма,Результат));
	КонецЕсли;	
КонецПроцедуры
#КонецОбласти


// Подготовка к созданию нового файла запросов
//
// Параметры:
//  Нет.
//
Процедура СоздатьНовый(Результат, ДопПараметры) Экспорт
	Форма = ДопПараметры.Форма;

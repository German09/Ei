#Область Сохранение
Процедура Сохранить_Начало(Форма, ЗапрашиватьСохранение = Ложь, ЗапрашиватьИмяФайла = Ложь, ОО_Завершения = Неопределено) Экспорт 
	//вСохранитьЗапросТекущейСтроки();
	ДопПараметры = Новый Структура("Форма,ЗапрашиватьИмяФайла,ОО_Завершения",Форма,ЗапрашиватьИмяФайла,ОО_Завершения);
	Если Не ЗапрашиватьИмяФайла И ЗапрашиватьСохранение Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("Сохранить_Выбор",ЭтотОбъект,ДопПараметры),"Сохранить текущие варианты?", РежимДиалогаВопрос.ДаНетОтмена);
	Иначе
		Сохранить_Выбор(КодВозвратаДиалога.Да, ДопПараметры);
	КонецЕсли;
КонецПроцедуры

// Начинает сохранение дерево запросов в файл запросов
//
// Параметры:
//  РезультатВопроса	- КодВозвратаДиалога 	 - признак необходимости предупрежедния перед сохранением
//  ДопПараметры	 	- Структура	 - Дополнительные параметры 
//           
Процедура Сохранить_Выбор(РезультатВопроса, ДопПараметры) Экспорт
	Форма 			= ДопПараметры.Форма;
	ФайлНастройки 	= Новый Файл(Форма.ИмяФайлаНастройки);
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Если ДопПараметры.ЗапрашиватьИмяФайла ИЛИ ПустаяСтрока(Форма.ИмяФайлаНастройки) Тогда
			Длг 				= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
			Длг.ПолноеИмяФайла 	= ФайлНастройки.ПолноеИмя;
			Длг.Каталог 		= ФайлНастройки.Путь;
			Длг.Заголовок 		= "Укажите файл для списка запросов";
			Длг.Расширение 		= РасширениеФайл();
			Длг.Фильтр 			= "Файлы запросов (*."+Длг.Расширение+")|*."+Длг.Расширение+"|Файлы консоли отчётов (*.rcf)|*.rcf|Все файлы (*.*)|*.*";
			Длг.Показать(Новый ОписаниеОповещения("Сохранить_Завершение",ЭтотОбъект,Новый Структура("Форма",Форма)));
		Иначе	
			Сохранить(ФайлНастройки.ПолноеИмя,ДопПараметры);
		КонецЕсли;
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		//отказались от продолжения операции
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет И Не ДопПараметры.ОО_Завершения = Неопределено Тогда	
		ВыполнитьОбработкуОповещения(ДопПараметры.ОО_Завершения);
	КонецЕсли;	
КонецПроцедуры

Процедура Сохранить_Завершение(ВыбранныеФайлы, ДопПараметры) Экспорт
	Если Не ВыбранныеФайлы = Неопределено Тогда
		Для Каждого сИмяФайла ИЗ ВыбранныеФайлы	Цикл
			Сохранить(сИмяФайла,ДопПараметры);
			Прервать;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

Процедура Сохранить(сИмяФайла,ДопПараметры) Экспорт
	Форма 			= ДопПараметры.Форма;
	СобытиеОтладки 	= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Сохранение в файл "+сИмяФайла,"Конструктор");
	СтрНаборов 		= ВариантыКлиент_Ei.Получить(Форма);
	//Сохранить в один файл 
	Попытка
		ЗТ = Новый ЗаписьТекста(сИмяФайла);
		ЗТ.ЗаписатьСтроку(ОбщийМодульВызовСервера_Ei.Сериализовать(СтрНаборов));
		ЗТ.Закрыть();
	Исключение
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	//СохранитьВКаталогРасширения(Форма,СтрНаборов,сИмяФайла);
	СохранитьВКаталогОбработки(Форма,СтрНаборов,сИмяФайла);
	
	Файл 				= Новый Файл(сИмяФайла);
	ЭтоВременныйФайл 	= (Файл.Расширение = "."+РасширениеВременныйФайл());
	Если Не ЭтоВременныйФайл Тогда  
		Форма.Модифицированность 	= Ложь;
		Форма.ИмяФайлаНастройки 	= сИмяФайла;//вСохранитьИмяФайла();
		КонструкторКлиент_Ei.УстановитьЗаголовок(Форма,Ложь);
	КонецЕсли;
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,"ОО_Завершения") И Не ДопПараметры.ОО_Завершения = Неопределено Тогда	
		ВыполнитьОбработкуОповещения(ДопПараметры.ОО_Завершения);
	КонецЕсли;
КонецПроцедуры

Асинх Процедура СохранитьВКаталогРасширения(Форма,СтрНаборов,сИмяФайла) Экспорт
	Файл 			= Новый Файл(сИмяФайла);
	ПутьИсходники 	= Ждать СоздатьКаталогАсинх(Файл.Путь+"src");
	СтрРезультат 	= Ждать СохранитьНаборВКаталогРасширения(ПутьИсходники,ПутьИсходники,СтрНаборов,Неопределено);
	Для Каждого СтрНабор ИЗ СтрНаборов Цикл
		Набор 		= СтрНабор.Значение;
		Если Набор.Родитель =  Неопределено Тогда		
			//Создаем метаданные конфигурации
			EDTКлиент_Ei.СоздатьФайлКонфигурации(ПутьИсходники, Набор.Имя, Набор.КлючНастроек, СтрРезультат, СтрНаборов);
			//Создаем файл проекта
			EDTКлиент_Ei.СоздатьФайлПроекта(Файл.Путь, Набор.Имя);	
			//Определение
			EDTКлиент_Ei.СоздатьОпределение(Файл.Путь);			
			Прервать;	
		КонецЕсли;
	КонецЦикла;
	НаборВариантовКлиент_Ei.ЗапомнитьСсылкиНаФайлы(Форма, СтрРезультат);	
КонецПроцедуры

Асинх Процедура СохранитьВКаталогОбработки(Форма,СтрНаборов,сИмяФайла) Экспорт
	Перем Набор;
	СтрРезультат 	= Новый Структура;	
	Файл 			= Новый Файл(сИмяФайла);
	ПутьИсходники 	= Ждать СоздатьКаталогАсинх(Файл.Путь+"src");
	ИмяНабора  		= НаборВариантовКлиентСервер_Ei.ПолучитьИмяНабора(СтрНаборов);
	Если Не ИмяНабора = Неопределено И СтрНаборов.Свойство(ИмяНабора,Набор) Тогда
		Запись = Ждать EDTКлиент_Ei.ПолучитьМетаданныеОбработки(ПутьИсходники, Набор.КлючНастроек, Набор.Имя);
		Для Каждого СтрНабор ИЗ СтрНаборов Цикл
			Набор 		= СтрНабор.Значение;
			мСостава 	= Новый Массив;	
			СтрРезультат.Вставить(Набор.Имя,мСостава);			
			
			//Сохранение параметров
			мСтрСохранения = Ждать ПараметрыКлиент_Ei.СохранитьВКаталог(Запись.Каталог, Набор);
			Для Каждого СтрСохранения ИЗ мСтрСохранения Цикл
				мСостава.Добавить(СтрСохранения);	
			КонецЦикла;		
			
			//Сохранение вариантов, тут повидение уже определяется настройкой каждого варианта
			Для Каждого СтрВаринат ИЗ Набор.Данные Цикл
				Варинат = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(СтрВаринат.Ключ);
				СтрСохранения 	= Ждать Варинат.Сохранить(Запись.Каталог,Набор.Имя, Набор.КлючНастроек, СтрВаринат.Значение);
				Если Не СтрСохранения = Неопределено Тогда
					мСостава.Добавить(СтрСохранения);
				КонецЕсли;		
			КонецЦикла;	
		КонецЦикла;
		EDTКлиент_Ei.ЗаписатьСоставОбработки(Запись.ЗаписьXML,СтрРезультат);
		Запись.ЗаписьXML.Закрыть();
		
		НаборВариантовКлиент_Ei.ЗапомнитьСсылкиНаФайлы(Форма, СтрРезультат);
	КонецЕсли;	
КонецПроцедуры

// Результат сохранения.
// 
// Параметры:
//  Имя					- Строка - Имя объекта
//  ПутьККорневойПапаке - Строка - Путь к корневой папаке
//  сТекст 				- Строка - Текст файла
//  ВариантКлюч 		- Строка - Ключ
//  КаталогПуть 		- Строка - Путь к файлу
//  ДопСвойства			- Структура -  Структура дополнительных свойств которая передается в результат
// 
// Возвращаемое значение:
//  Структура - Результат сохранения:
// * Имя		- Строка - Имя объекта (для возможности сохранения в метаданные)
// * Ключ 		- Строка -
// * Каталог 	- Строка -
// * Ссылка 	- Строка - Относительный путь
// * Хэш 		- Строка -
// * ТипМакета  - Строка - Ключ см. EDTКлиент_Ei.ТипыМакетов [не всегда, получаем из ДопСвойства, специфично для макета]
// * Синоним	- Строка - Синоним метаданных [почти всегда, получаем из ДопСвойства]
//
Функция РезультатСохранения(Имя, ПутьККорневойПапаке, сТекст, ВариантКлюч, КаталогПуть, ДопСвойства = Неопределено) Экспорт
	ОтносительныйПуть 	= СтрЗаменить(КаталогПуть,ПутьККорневойПапаке+"\","");
	Ссылка 				= СтрЗаменить(ОтносительныйПуть,EDTКлиент_Ei.ОкончаниеКласса(),".");
	Хэш					= ОбщийМодульВызовСервера_Ei.ПолучитьХешСтроки(сТекст);
	Результат 			= Новый Структура("Ключ,Каталог,Ссылка,Хэш",ВариантКлюч,ОтносительныйПуть,Ссылка,Хэш);
	Если ТипЗнч(ДопСвойства) = Тип("Структура") Тогда
		//дополним специфичными свойствами 
		ОбщийМодульКлиентСервер_Ei.вСоединить(Результат,ДопСвойства);		
	КонецЕсли;	
	Возврат Результат;	
КонецФункции
	 

// Сохранить набор с определенным именем родителя в каталог.
// 
// Параметры:
//  ПутьИсходники - Строка - Путь исходники
//  ПутьПодсистема - Строка - Путь к вложенному каталогу подсистемы
//  СтрНаборов - Структура из КлючИЗначение:
// * Ключ - Строка -
// * Значение см. ВариантыКлиентСервер_Ei.ПолучитьВариант
//  Родитель - Строка - Имя родителя варианта, которые необходимо сохранить
//  
// Возвращаемое значение:
//  Обещание - Сохранить набор в каталог
Асинх Функция СохранитьНаборВКаталогРасширения(ПутьИсходники,ПутьПодсистема,СтрНаборов,Родитель)
	Результат = Новый Структура;	
	Для Каждого СтрНабор ИЗ СтрНаборов Цикл
		Набор 		= СтрНабор.Значение;
		Если Набор.Родитель =  Родитель Тогда
			мСостава 	= Новый Массив;	
			Результат.Вставить(Набор.Имя,мСостава);			
			//Сохранение параметров
			мСтрСохранения = Ждать ПараметрыКлиент_Ei.СохранитьВКаталог(ПутьИсходники, Набор);
			Для Каждого СтрСохранения ИЗ мСтрСохранения Цикл
				мСостава.Добавить(СтрСохранения);	
			КонецЦикла;		
			
			//Сохранение вариантов, тут повидение уже определяется настройкой каждого варианта
			Для Каждого СтрВаринат ИЗ Набор.Данные Цикл
				Варинат = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(СтрВаринат.Ключ);
				СтрСохранения 	= Ждать Варинат.Сохранить(ПутьИсходники,Набор.Имя, Набор.КлючНастроек, СтрВаринат.Значение);
				Если Не СтрСохранения = Неопределено Тогда
					мСостава.Добавить(СтрСохранения);
				КонецЕсли;		
			КонецЦикла;
			
			//Сохранение вложенных
			ПутьВложеннаяПодсистема =  Ждать СоздатьКаталогАсинх(ПутьПодсистема+"\Subsystems\"+Набор.Имя);
			мВложенные	= Ждать СохранитьНаборВКаталогРасширения(ПутьИсходники,ПутьВложеннаяПодсистема,СтрНаборов,Набор.Имя);
			Для Каждого Вариант ИЗ мВложенные Цикл
				Результат.Вставить(Вариант.Ключ, Вариант.Значение);			
			КонецЦикла;	
			
			//Сохранение набора
			EDTКлиент_Ei.СоздатьМетаданныеПодсистемы(ПутьПодсистема, Набор.КлючНастроек, Набор.Имя, мСостава, СтрНаборов);			
		КонецЕсли;		
	КонецЦикла;
	Возврат Результат;		
КонецФункции

Асинх Функция СохранитьОбщее(Обработчик, Путь, НаборИмя, НаборКлюч, Данные) Экспорт
	ВариантКлюч	= ВариантыКлиентСервер_Ei.ПолучитьИдентификатор(НаборКлюч,Обработчик);
	ВариантИмя	= ВариантыКлиентСервер_Ei.ПолучитьИмя(НаборИмя,Обработчик);
	сМакет		= ОбщийМодульВызовСервера_Ei.Сериализовать(Новый Структура(Данные)); //не понял для чего данные оборачивать в структуру если это и так структура
	//КаталогПуть = Ждать EDTКлиент_Ei.СоздатьОбшийМакет(Путь, сМакет, ВариантИмя, ВариантКлюч);
	ТипМакета 	=  "TextDocument";
	ДопСвойства = Новый Структура("ТипМакета,Синоним", ТипМакета, НаборИмя);
	КаталогПуть	= Ждать EDTКлиент_Ei.СоздатьМакетОбработки(Путь, сМакет, ВариантИмя, ВариантКлюч, EDTКлиент_Ei.ТипыМакетов()[ТипМакета], НаборИмя);
	Результат 	= ФайлыКлиент_Ei.РезультатСохранения(НаборИмя, Путь, сМакет, ВариантКлюч, КаталогПуть, ДопСвойства);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Чтение
// Начинает сохранение дерево запросов в файл запросов
//
// Параметры:
//  ЗапрашиватьСохранение	 - Булево 	 - признак необходимости предупрежедния перед сохранением
//  ЗапрашиватьИмяФайла		 - Булево	 - признак необходимости запроса имени файла
//   - 
//           
Процедура Открыть_Выбор(РезультатВопроса, ДопПараметры) Экспорт
	Форма			= ДопПараметры.Форма;
	ФайлНастройки 	= Новый Файл(Форма.ИмяФайлаНастройки);
	Длг 				= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Длг.ПолноеИмяФайла 	= ФайлНастройки.ПолноеИмя;
	Длг.Каталог 		= ФайлНастройки.Путь;
	Длг.Заголовок 		= "Выберите файл со списком запросов";
	Длг.Расширение 		= РасширениеФайл();
	Длг.Фильтр 			= СтрШаблон("Файлы запросов (*.%1)|*.%1|Все файлы (*.*)|*.*",Длг.Расширение);
	Длг.Показать(Новый ОписаниеОповещения("Открыть_Завершение",ЭтотОбъект,ДопПараметры));
КонецПроцедуры

Процедура Открыть_Завершение(ВыбранныеФайлы, ДопПараметры) Экспорт
	Если Не ВыбранныеФайлы = Неопределено Тогда
		Для Каждого сИмяФайла ИЗ ВыбранныеФайлы	Цикл
			Открыть(сИмяФайла,ДопПараметры);
			Прервать;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

// Загружает дерево запросов, текстов модулей и других данных из файла
//
Процедура Открыть(сИмяФайла,ДопПараметры) 
	Форма			= ДопПараметры.Форма;
	СобытиеОтладки 	= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Чтение списка запросов из файла "+сИмяФайла,"Конструктор");
	Попытка
		Результат = ПрочитатьТекст(сИмяФайла);
		Если ЗначениеЗаполнено(Результат) Тогда
			ЗагрузитьВарианты(Форма,Результат);
		КонецЕсли;	
	Исключение
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	Файл 				= Новый Файл(сИмяФайла);
	ЭтоВременныйФайл 	= (Файл.Расширение = "."+РасширениеВременныйФайл());
	Если Не ЭтоВременныйФайл Тогда  
		Форма.Модифицированность 	= Ложь;
		Форма.ИмяФайлаНастройки 	= сИмяФайла;//вСохранитьИмяФайла();
	КонецЕсли;
	ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,"ДатаИзмененияФайлаНастройки",Форма.ДатаИзменения); //обновим дату а то пойжет бесконечный цикл, буде каждый раз перечитывайть файл настроек
	КонструкторКлиент_Ei.УстановитьЗаголовок(Форма,,ЭтоВременныйФайл);
	Если Не ЭтоВременныйФайл Тогда	
		Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,"ДатаИзмененияФайлаНастройки") Тогда
			//проверим а нет ли сохраненного врменного файла с датой больше чем дата сохраненного запроса, если есть то данные прочитаем из него
			Файл = Новый Файл(ПолучитьИмяВременногоФайлаНастройки(сИмяФайла));
			Файл.НачатьПроверкуСуществования(Новый ОписаниеОповещения("ОО_ПолучениеРезультатаСуществованияВременногоФайла",ЭтотОбъект,Новый Структура("Форма, ДатаИзмененияФайлаНастройки,ИмяФайла",Форма,ДопПараметры.ДатаИзмененияФайлаНастройки,Файл.ПолноеИмя)));
		КонецЕсли;
	Иначе
		Форма.Модифицированность 	= Истина; //покажем модифицированность чтобы кто бы чего не думал
	КонецЕсли;	
КонецПроцедуры

// Процедура - загружает дерево вариантов из сохраненной строки
// 
// Параметры:
//  Форма  - Форма- См. ОбщаяФорма.Ei
//  сНабора - Строка - Сериализованное См. ПолучитьВарианты
Процедура ЗагрузитьВарианты(Форма,сНабора)
	Набор = НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма);
	НаборВариантовКлиент_Ei.Очистить(Форма);
	стрНабора = ОбщийМодульВызовСервера_Ei.Структурировать(сНабора,Новый Структура);
	ДобавитьВариантыВКоллекцию(Набор,стрНабора);
	ВариантыКлиент_Ei.ОбновитьВаринаты(Форма,Набор);
	КонструкторКлиент_Ei.АктивизироватьПоследнийВариант(Форма);
КонецПроцедуры

// Процедура - Добавляет варианты 
//
// Параметры:
//  Коллекция	 - ДанныеФормыКоллекцияЭлементовДерева  	- Строки дерева варинатов
//  стрНабора	 - СписокЗначений	 						- Структура настроек
//
Процедура ДобавитьВариантыВКоллекцию(Коллекция,стрНабора)
	Если ТипЗнч(стрНабора) = Тип("Структура") Тогда
		Пока стрНабора.Количество() Цикл
			мУдаления = Новый Массив;
			Для Каждого ЭлСтрНабора ИЗ стрНабора Цикл
				Набор = ЭлСтрНабора.Значение;
				Если ЗначениеЗаполнено(Набор.Родитель) Тогда
					//Ищем
					мРодители = ОбщийМодульКлиентСервер_Ei.НайтиВКоллекцииДерева(Новый Структура("ИмяНабора",Набор.Родитель),Коллекция);
					Если мРодители.Количество() Тогда
						Родитель = мРодители[0].ПолучитьЭлементы();
					Иначе
						//родителя не нашли продолжим
						Продолжить;	
					КонецЕсли;		
				Иначе
					Родитель = Коллекция;	
				КонецЕсли;		
				Вариант = Родитель.Добавить();
				Вариант.ИмяНабора 		= Набор.Имя;
				Вариант.КлючНастроек	= Набор.КлючНастроек;
				Для Каждого ЭлСтрДанные ИЗ Набор.Данные Цикл
					Обработчик = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(ЭлСтрДанные.Ключ);
					Если Не Обработчик = Неопределено Тогда
						Обработчик.ЗагрузитьДанные(Вариант, ЭлСтрДанные.Значение);	
					КонецЕсли;			
				КонецЦикла;	
				ПараметрыКлиент_Ei.ЗагрузитьДанные(Вариант,Набор.Параметры);
				мУдаления.Добавить(ЭлСтрНабора.Ключ);
			КонецЦикла;
			Для Каждого Ключ ИЗ мУдаления Цикл
				стрНабора.Удалить(Ключ); //Будем постепенно удалять все элементы и так мы переберем все элементы вне зависимости от порядка родителей				
			КонецЦикла;	
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры
#КонецОбласти

#Область ПроверкаФайла
Процедура ОО_ПолучениеРезультатаСуществованияВременногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат Тогда
		Файл = Новый Файл(ДопПараметры.ИмяФайла);
		Файл.НачатьПолучениеВремениИзменения(Новый ОписаниеОповещения("ОО_ПолучениеВремениИзмененияВременногоФайла",ЭтотОбъект,ДопПараметры));
	КонецЕсли;
КонецПроцедуры	

Процедура ОО_ПолучениеВремениИзмененияВременногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат   >  ДопПараметры.ДатаИзмененияФайлаНастройки Тогда
		//файл запросов свяжее, загрузим результат из него
		Открыть(ДопПараметры.ИмяФайла,Новый Структура("Форма",ДопПараметры.Форма));
	КонецЕсли;	
КонецПроцедуры

Процедура ОО_ПолучениеВремениИзмененияСохраненногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат   >  ДопПараметры.ДатаИзменения Тогда
		//файл запросов свяжее, загрузим результат из него или из временного
		Открыть(ДопПараметры.ИмяФайла,Новый Структура("Форма,ДатаИзмененияФайлаНастройки",ДопПараметры.Форма,Результат));
	КонецЕсли;	
КонецПроцедуры
#КонецОбласти


// Подготовка к созданию нового файла запросов
//
// Параметры:
//  Нет.
//
Процедура СоздатьНовый(Результат, ДопПараметры) Экспорт
	Форма = ДопПараметры.Форма;
	Форма.ИмяФайлаНастройки 	= "";
	//чТекущаяСтрока 		= Неопределено;
	НаборВариантовКлиент_Ei.Очистить(Форма);
	КонструкторКлиент_Ei.УстановитьЗаголовок(Форма);
	НаборВариантовКлиент_Ei.СоздатьНовый(Форма);
	ВариантыКлиент_Ei.ОбновитьВаринаты(Форма,НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма));
	Форма.СохраненныйОбраз = вПолучитьСохраняемыйОбраз(Форма);
	Форма.Модифицированность = Ложь;
КонецПроцедуры


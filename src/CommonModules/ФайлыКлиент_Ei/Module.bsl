#Область ПоследниеНаборы

// Выбрать обработку в проекте EDT: в одном проекте может быть несколько сохраненных наборов
// 
// Параметры:
//  Каталог 	- Строка - папка проекта EDT
//  ИмяПроекта 	- Строка - обработку с этим именем предлагаем первой
// 
// Возвращаемое значение:
//  Строка - имя обработки; пустая, если выбор отменили или обработок нет
Асинх Функция ВыбратьОбработкуПроекта(Каталог, ИмяПроекта)
	Результат			= "";
	Обработки			= Ждать ОбработкиПроекта(Каталог);
	Список				= Новый СписокЗначений;
	Для Каждого Обработка Из Обработки Цикл
		Список.Добавить(Обработка.Значение.Имя);
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Если Список.Количество() = 0 Тогда
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'В проекте %1 (%2) нет обработок'"), ИмяПроекта, Каталог));
	ИначеЕсли Список.Количество() = 1 Тогда
		Для Каждого Элемент Из Список Цикл
			Результат = Элемент.Значение;
		КонецЦикла;
	Иначе
		Выбранный = Ждать Список.ВыбратьЭлементАсинх(СтрШаблон(НСтр("ru = 'Какой набор проекта %1 открыть?'"), ИмяПроекта),
			Список.НайтиПоЗначению(ИмяПроекта));
		Если Не Выбранный = Неопределено Тогда
			Результат = Выбранный.Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Открыть набор - обработку из проекта EDT
// 
// Параметры:
//  Форма 			- см. Обработка.Ei.Форма.Форма
//  Каталог 		- Строка - папка проекта EDT
//  ИмяОбработки 	- Строка - имя обработки в проекте, оно же имя корневого набора
// 
// Возвращаемое значение:
//  Булево - набор прочитан
Асинх Функция ОткрытьНабор(Форма, Каталог, ИмяОбработки) Экспорт
	Результат		= Ложь;
	СсылкиНаФайлы	= Новый Структура;
	Набор			= Ждать EDTКлиент_Ei.ПрочитатьСоставОбработки(Каталог,ИмяОбработки,СсылкиНаФайлы);
	Если Не Набор =  Неопределено Тогда	
		ЗагрузитьПрочитанныйНабор(Форма, Набор, Каталог, ИмяОбработки, СсылкиНаФайлы);
		Результат = Истина;
	КонецЕсли;	
	Возврат Результат;
КонецФункции

// Поставить набор первым в списке последних, см. ОбновитьМенюПоследнихНаборов
// 
// Параметры:
//  Форма 	- см. Обработка.Ei.Форма.Форма
//  Каталог - Строка - папка проекта EDT
//  Имя 	- Строка - имя обработки
Процедура ЗапомнитьПоследнийНабор(Форма, Каталог, Имя)
	ПоследниеНаборы = НастройкиПользователяКлиентСервер_Ei.ПолучитьПоследниеНаборы(Форма.НастройкиПользователя);
	Обновленные 	= Новый Массив;
	Обновленные.Добавить(Новый Структура("Каталог,Имя", Каталог, Имя));
	Для Каждого Последний Из ПоследниеНаборы Цикл
		Если Обновленные.Количество() < ФайлыКлиентСервер_Ei.ЧислоПоследнихНаборов()
			И Не ЭтоТотЖеНабор(Последний, Каталог, Имя) Тогда
			Обновленные.Добавить(Последний);
		КонецЕсли;
	КонецЦикла;
	НастройкиПользователяКлиентСервер_Ei.СохранитьПоследниеНаборы(Форма.НастройкиПользователя, Обновленные);
	КонструкторКлиент_Ei.ЗапомнитьНастройки(Форма);
	ОбновитьМенюПоследнихНаборов(Форма);
КонецПроцедуры

// Это тот же набор.
// 
// Параметры:
//  Последний 	- Структура - элемент см. НастройкиПользователяКлиентСервер_Ei.ПолучитьПоследниеНаборы
//  Каталог 	- Строка
//  Имя 		- Строка
// 
// Возвращаемое значение:
//  Булево
Функция ЭтоТотЖеНабор(Последний, Каталог, Имя)
	Возврат ОдинКаталог(Последний.Каталог, Каталог) И нРег(Последний.Имя) = нРег(Имя);
КонецФункции

// Пути указывают на одну папку: без учета регистра и разделителя в конце
// 
// Параметры:
//  Каталог1 - Строка
//  Каталог2 - Строка
// 
// Возвращаемое значение:
//  Булево
Функция ОдинКаталог(Каталог1, Каталог2)
	Разделитель = ПолучитьРазделительПути();
	Возврат нРег(БезПоследнегоСимвола(Каталог1, Разделитель)) = нРег(БезПоследнегоСимвола(Каталог2, Разделитель));
КонецФункции


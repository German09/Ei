// Устарела. 
// Начинает открытие набора запросов из файла
//
// Параметры:
//  РезультатВопроса	 - Булево 	 - признак необходимости предупрежедния перед сохранением
//  ДопПараметры		 - Неопределено, Структура -
//           
Процедура Открыть_Выбор_(РезультатВопроса, ДопПараметры) Экспорт
	Форма			= ДопПараметры.Форма;
	ФайлНастройки 	= Новый Файл(Форма.ИмяФайлаНастройки);
	Длг 				= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Длг.ПолноеИмяФайла 	= ФайлНастройки.ПолноеИмя;
	Длг.Каталог 		= ФайлНастройки.Путь;
	Длг.Заголовок 		= "Выберите файл со списком запросов";
	Длг.Расширение 		= РасширениеФайл();
	Длг.Фильтр 			= СтрШаблон("Файлы запросов (*.%1)|*.%1|Все файлы (*.*)|*.*",Длг.Расширение);
	Длг.Показать(Новый ОписаниеОповещения("Открыть_Завершение",ЭтотОбъект,ДопПараметры));
КонецПроцедуры

//Устарела.
Процедура Открыть_Завершение(ВыбранныеФайлы, ДопПараметры) Экспорт
	Если Не ВыбранныеФайлы = Неопределено Тогда
		Для Каждого сИмяФайла ИЗ ВыбранныеФайлы	Цикл
			Открыть(сИмяФайла,ДопПараметры);
			Прервать;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

// Загружает дерево запросов, текстов модулей и других данных из файла
//
Процедура Открыть(сИмяФайла,ДопПараметры) 
	Форма			= ДопПараметры.Форма;
	СобытиеОтладки 	= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Чтение списка запросов из файла "+сИмяФайла,"Конструктор");
	Попытка
		Результат = ПрочитатьТекст(сИмяФайла);
		Если ЗначениеЗаполнено(Результат) Тогда
			ЗагрузитьВарианты(Форма,Результат);
		КонецЕсли;	
	Исключение
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	Файл 				= Новый Файл(сИмяФайла);
	ЭтоВременныйФайл 	= (Файл.Расширение = "."+РасширениеВременныйФайл());
	Если Не ЭтоВременныйФайл Тогда  
		Форма.Модифицированность 	= Ложь;
		Форма.ИмяФайлаНастройки 	= сИмяФайла;//вСохранитьИмяФайла();
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,"ДатаИзмененияФайлаНастройки",Форма.ДатаИзменения); //обновим дату а то пойжет бесконечный цикл, буде каждый раз перечитывайть файл настроек
	КонструкторКлиент_Ei.УстановитьЗаголовок(Форма,,ЭтоВременныйФайл);
	Если Не ЭтоВременныйФайл Тогда	
		Если ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,"ДатаИзмененияФайлаНастройки") Тогда
			//проверим а нет ли сохраненного врменного файла с датой больше чем дата сохраненного запроса, если есть то данные прочитаем из него
			Файл = Новый Файл(ПолучитьИмяВременногоФайлаНастройки(сИмяФайла));
			Файл.НачатьПроверкуСуществования(Новый ОписаниеОповещения("ОО_ПолучениеРезультатаСуществованияВременногоФайла",ЭтотОбъект,Новый Структура("Форма, ДатаИзмененияФайлаНастройки,ИмяФайла",Форма,ДопПараметры.ДатаИзмененияФайлаНастройки,Файл.ПолноеИмя)));
		КонецЕсли;
	Иначе
		Форма.Модифицированность 	= Истина; //покажем модифицированность чтобы кто бы чего не думал
	КонецЕсли;	
КонецПроцедуры

// Процедура - загружает дерево вариантов из сохраненной строки
// 
// Параметры:
//  Форма  		- Форма   - См. Обработка.Ei.Форма.Форма
//  НовыйНабор 	- Строка  - Сериализованное См. ПолучитьВарианты,
//				- Структура - см. ВариантыКлиент_Ei.Получить
//  Каталог 	- Строка 
//  ИмяПроекта	- Строка
//  СсылкиНаФайлы - Структура, Неопределено - ссылки на файлы, из которых прочитан набор, см. EDTКлиент_Ei.ПрочитатьСоставОбработки
Процедура ЗагрузитьВарианты(Форма,Знач НовыйНабор,Каталог="",ИмяПроекта="",СсылкиНаФайлы=Неопределено)
	Набор = НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма);
	НаборВариантовКлиент_Ei.Очистить(Форма);
	Если ТипЗнч(НовыйНабор) =  Тип("Строка") Тогда
		НовыйНабор = ОбщегоНазначенияВызовСервера_Ei.Структурировать(НовыйНабор,Новый Структура);
	КонецЕсли;	
	ДобавитьВариантыВКоллекцию(Набор,НовыйНабор,Каталог,ИмяПроекта);
	Если Не СсылкиНаФайлы = Неопределено Тогда
		//ссылки с хэшами нужны строкам до активизации варианта: редактор при замене текста
		//синхронно вызывает ПриИзменении, и без хэшей вариант считается измененным
		НаборВариантовКлиент_Ei.ЗапомнитьСсылкиНаФайлы(Форма,СсылкиНаФайлы,Каталог,ИмяПроекта);
	КонецЕсли;
	ВариантыКлиент_Ei.ОбновитьВаринаты(Форма,Набор);
	КонструкторКлиент_Ei.АктивизироватьПоследнийВариант(Форма);
КонецПроцедуры

// Процедура - Добавляет варианты 
//
// Параметры:
//  Коллекция	 - ДанныеФормыКоллекцияЭлементовДерева  	- Строки дерева варинатов
//  стрНабора	 см. ВариантыКлиент_Ei.Получить
//	Каталог 	 - Строка 
//  ИмяПроекта	 - Строка
//
Процедура ДобавитьВариантыВКоллекцию(Коллекция,СтрНабора,Каталог,ИмяПроекта)
	Если ТипЗнч(стрНабора) = Тип("Структура") Тогда
		Пока стрНабора.Количество() Цикл
			Удаляемые = Новый Массив;
			Для Каждого ЭлСтрНабора ИЗ стрНабора Цикл
				Набор = ЭлСтрНабора.Значение;
				Если ЗначениеЗаполнено(Набор.Родитель) Тогда
					//Ищем
					мРодители = ОбщегоНазначенияКлиентСервер_Ei.НайтиВКоллекцииДерева(Новый Структура("ИмяНабора",Набор.Родитель),Коллекция);
					Если мРодители.Количество() Тогда
						Родитель = мРодители[0].ПолучитьЭлементы();
					Иначе
						//родителя не нашли продолжим
						Продолжить;	
					КонецЕсли;		
				Иначе
					Родитель = Коллекция;	
				КонецЕсли;		
				Вариант = Родитель.Добавить();
				Вариант.ИмяНабора 		= Набор.Имя;
				Вариант.КлючНастроек	= Набор.КлючНастроек;
				Для Каждого ЭлСтрДанные ИЗ Набор.Данные Цикл
					Обработчик = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(ЭлСтрДанные.Ключ);
					Если Не Обработчик = Неопределено Тогда
						Обработчик.ЗагрузитьДанные(Вариант, ЭлСтрДанные.Значение);	
					КонецЕсли;			
				КонецЦикла;	
				ПараметрыКлиент_Ei.ЗагрузитьДанные(Вариант,Набор.Параметры,Каталог,ИмяПроекта);
				Удаляемые.Добавить(ЭлСтрНабора.Ключ);
			КонецЦикла;
			Для Каждого Ключ ИЗ Удаляемые Цикл
				стрНабора.Удалить(Ключ); //Будем постепенно удалять все элементы и так мы переберем все элементы вне зависимости от порядка родителей				
			КонецЦикла;	
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти
	

// Считать вариант набора из файла, обновить хэш в ссылке на файл и отображение формы.
// Вариант из нескольких файлов (см. EDTКлиент_Ei.КомментарийЧасти) читается целиком из главного файла, какая бы
// его часть ни изменилась, и хэши обновляются у всех его файлов
// 
// Параметры:
//  Форма 			- см. Обработка.Ei.Форма.Форма
//  СтрокаНабора 	- ДанныеФормыЭлементДерева - строка дерева наборов
//  Обработчик 		- ОбщийМодуль - обработчик варианта, например см. ВариантАлгоритмКлиентСервер_Ei
//  СсылкаНаФайл 	- см. РезультатСохранения
//  ПолноеИмя 		- Строка - полный путь к файлу варианта или его части
//  Текст 			- Строка - текст файла, по нему пересчитывается хэш
Процедура ЗагрузитьВариантИзФайла(Форма, СтрокаНабора, Обработчик, СсылкаНаФайл, ПолноеИмя, Текст)
	БылиИзменения 		= ЕстьНесохраненныеИзменения(Форма);
	Разделитель 		= ПолучитьРазделительПути();
	КаталогОбработки 	= Лев(ПолноеИмя, СтрДлина(ПолноеИмя) - СтрДлина(СсылкаНаФайл.Окончание) - СтрДлина(Разделитель));
	ВариантКлюч 		= КлючВариантаФайла(СсылкаНаФайл);
	Главная 			= НаборВариантовКлиент_Ei.ПолучитьСсылкуНаФайл(СтрокаНабора, ВариантКлюч);
	Если Главная = Неопределено Тогда
		Главная = СсылкаНаФайл;
	КонецЕсли;
	Обработчик.ЗагрузитьДанные(СтрокаНабора, Обработчик.Прочитать(КаталогОбработки + Разделитель + Главная.Окончание));
	//ссылки собираем заранее: обновление хэша перезаписывает Файлы строки
	СсылкиВарианта = Новый Массив;
	Если ТипЗнч(СтрокаНабора.Файлы) = Тип("Структура") Тогда
		Для Каждого СтрФайл Из СтрокаНабора.Файлы Цикл
			Если КлючВариантаФайла(СтрФайл.Значение) = ВариантКлюч Тогда
				СсылкиВарианта.Добавить(СтрФайл.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Ссылка Из СсылкиВарианта Цикл
		Если Ссылка.Ключ = СсылкаНаФайл.Ключ Тогда
			ОбновитьХэшФайла(СтрокаНабора, Ссылка, Текст);
		Иначе
			Попытка
				ОбновитьХэшФайла(СтрокаНабора, Ссылка, ПрочитатьТекст(КаталогОбработки + Разделитель + Ссылка.Окончание));
			Исключение
				//части уже нет на диске: хэш остается прежним, вариант покажет изменения при следующем сохранении
				Продолжить;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	//редактор на форме показывает только текущий вариант текущей строки
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТекД = Неопределено И ТекД.ПолучитьИдентификатор() = СтрокаНабора.ПолучитьИдентификатор() Тогда
		ТекущийОбработчик = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма, ТекД);
		Если Не ТекущийОбработчик = Неопределено
			И ТекущийОбработчик.Свойства().Имя = Обработчик.Свойства().Имя Тогда
			Обработчик.ПриИзмененииДанных(Форма);
		КонецЕсли;
	КонецЕсли;
	ВариантыКлиент_Ei.УстановитьМодифицированность(Форма, СтрокаНабора, Обработчик);
	ПослеЗагрузкиИзФайла(Форма, БылиИзменения);
КонецПроцедуры

// Считать параметр набора из файла, обновить хэш в ссылке на файл и модифицированность формы.
// Таблица параметров - данные формы, она обновится на форме сама
// 
// Параметры:
//  Форма 			- см. Обработка.Ei.Форма.Форма
//  СтрокаНабора 	- ДанныеФормыЭлементДерева - строка дерева наборов
//  Параметр 		- ДанныеФормыЭлементКоллекции - строка ПараметрыЗапроса
//  СсылкаНаФайл 	- см. РезультатСохранения
//  Текст 			- Строка - текст файла параметра
Процедура ЗагрузитьПараметрИзФайла(Форма, СтрокаНабора, Параметр, СсылкаНаФайл, Текст)
	БылиИзменения = ЕстьНесохраненныеИзменения(Форма);
	ПараметрыКлиент_Ei.ЗагрузитьИзФайла(Параметр, СсылкаНаФайл, Текст);
	ОбновитьХэшФайла(СтрокаНабора, СсылкаНаФайл, Текст);
	ПослеЗагрузкиИзФайла(Форма, БылиИзменения);
КонецПроцедуры

// Есть ли в наборах изменения относительно последнего сохранения или открытия папки
// 
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
// 
// Возвращаемое значение:
//  Булево
Функция ЕстьНесохраненныеИзменения(Форма)
	Возврат Не СокрЛП(Форма.СохраненныйОбраз) = СокрЛП(вПолучитьСохраняемыйОбраз(Форма));
КонецФункции

// Пересчитать модифицированность формы после загрузки варианта или параметра из файла.
// Файл и есть сохраненное состояние, поэтому если до загрузки несохраненных изменений не было,
// загруженное становится новым сохраненным образом и форма не помечается измененной
// 
// Параметры:
//  Форма 			- см. Обработка.Ei.Форма.Форма
//  БылиИзменения 	- Булево - результат см. ЕстьНесохраненныеИзменения до загрузки
Процедура ПослеЗагрузкиИзФайла(Форма, БылиИзменения)
	Если Не БылиИзменения Тогда
		Форма.СохраненныйОбраз = вПолучитьСохраняемыйОбраз(Форма);
	КонецЕсли;
	КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
КонецПроцедуры

// Запомнить в строке набора хэш загруженного текста файла, с ним сравнивается модифицированность
// 
// Параметры:
//  СтрокаНабора 	- ДанныеФормыЭлементДерева - строка дерева наборов
//  СсылкаНаФайл 	- см. РезультатСохранения
//  Текст 			- Строка - текст файла
Процедура ОбновитьХэшФайла(СтрокаНабора, СсылкаНаФайл, Текст)
	СсылкаНаФайл.Вставить("Хэш", ОбщегоНазначенияВызовСервера_Ei.ПолучитьХешСтроки(Текст));
	//колонка Файлы в данных формы произвольного типа: полученное из нее значение может оказаться копией,
	//поэтому ссылку с новым хэшем записываем в строку набора явно, иначе данные останутся модифицированными
	Файлы = СтрокаНабора.Файлы;
	Файлы.Вставить(ОбщегоНазначенияКлиентСервер_Ei.ИдентификаторВКлюч(СсылкаНаФайл.Ключ), СсылкаНаФайл);
	СтрокаНабора.Файлы = Файлы;
КонецПроцедуры

// Обработчик варианта, которому принадлежит сохраненный файл
// 
// Параметры:
//  СтрокаНабора 	- ДанныеФормыЭлементДерева - строка дерева наборов
//  ВариантКлюч 	- Строка - ключ из ссылки на файл см. РезультатСохранения
// 
// Возвращаемое значение:
//  ОбщийМодуль, Неопределено - Неопределено, если файл не относится к вариантам, например это параметр набора
Функция НайтиОбработчикВарианта(СтрокаНабора, ВариантКлюч)
	Результат = Неопределено;
	Для Каждого СтрВариант Из ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
		Если Строка(ВариантыКлиентСервер_Ei.ПолучитьИдентификатор(СтрокаНабора.КлючНастроек, СтрВариант.Значение)) = ВариантКлюч Тогда
			Результат = СтрВариант.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// После обновления ФС.
// 
// Параметры:
//  Форма   см. Обработка.Ei.Форма.Форма
//  Каталог - Строка - Каталог из которого считаны или сохранены варианты
Процедура ПослеОбновленияФС(Форма, Знач Каталог)
	Форма.Модифицированность 	= Ложь;
	Форма.ИмяФайлаНастройки 	= Каталог;
	Форма.ЗапомнитьДанные(Форма.СохраненныйОбраз);
	КонструкторКлиент_Ei.УстановитьЗаголовок(Форма);
КонецПроцедуры

#КонецОбласти

#КонецОбласти




		

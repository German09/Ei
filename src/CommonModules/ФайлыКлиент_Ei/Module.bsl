// Получить ВКОтслеживания.
// 
// Параметры:
//  Форма 			- ФормаКлиентскогоПриложения - Форма
//  Устанавливали 	- Булево - Устанавливали
// 
// Возвращаемое значение:
//  ВнешнийКомпонент - Получить ВКОтслеживания
Асинх Функция ПолучитьВКОтслеживания(Форма, Устанавливали = Ложь) Экспорт
	Расположение = "ОбщийМакет.ОтслеживаниеФайлов_ВК_Ei";
	Если Форма.ВКОтслеживания = Неопределено Тогда		
		Если Ждать ПодключитьВнешнююКомпонентуАсинх(
			Расположение,  	// имя макета
			ОбщегоНазначенияКлиентСервер_Ei.Постфикс(),  // произвольный идентификатор
			ТипВнешнейКомпоненты.Native) Тогда
			
		Иначе
			Если Не Устанавливали Тогда
				Ждать УстановитьВнешнююКомпонентуАсинх(Расположение);
				Возврат ПолучитьВКОтслеживания(Форма, Истина);
			Иначе
				ВызватьИсключение СтрШаблон("Не удалось подключить %1", ИмяВкОтслеживания());	
			КонецЕсли;		
		КонецЕсли;
		// AddIn.<идентификатор>.<имя класса из компоненты>
		Форма.ВКОтслеживания = Новый(СтрШаблон("AddIn.%1.%2",ОбщегоНазначенияКлиентСервер_Ei.Постфикс(),ИмяВкОтслеживания()));
	КонецЕсли;
	Результат = Форма.ВКОтслеживания;	
	Возврат Результат; 	
КонецФункции

// Событие отслеживания.
// 
// Параметры:
//  Форма 		см. ОбщаяФорма.Ei
//  Каталог 	- Строка - путь папки слежения (как передано в НачатьСлежение / StartWatch);
//  Данные   	- Структура:
//    type             - Строка  - тип операции:
//                                 "created"  - создание;
//                                 "deleted"  - удаление;
//                                 "modified" - изменение;
//                                 "renamed"  - переименование;
//    itemType         - Строка  - тип объекта: "file" или "directory";
//    path             - Строка  - полный путь к объекту (для renamed совпадает с newPath);
//    oldPath          - Строка  - прежний путь (заполняется только для renamed, иначе "");
//    newPath          - Строка  - новый путь (заполняется только для renamed, иначе "");
//    date             - Дата    - дата/время в формате "yyyy-MM-ddTHH:mm:ss"
//                                 (mtime файла, если доступен; для deleted - время события);
//    content          - Строка  - текстовое содержимое файла (UTF-8);
//                                 для directory, deleted, бинарных и при ошибке чтения - "";
//    contentTruncated - Булево  - Истина, если файл больше лимита МаксБайтСодержимого;
//    contentSkipped   - Булево  - Истина, если содержимое не читалось
//                                 (бинарный файл, ошибка доступа, нулевой лимит и т.п.).
//
Асинх Процедура СобытиеОтслеживания(Форма, Каталог, Данные) Экспорт
	Если Данные.itemType = "file" И Данные.type = "modified" Тогда
		ФайлНабора = НаборВариантовКлиент_Ei.НайтиФайлНабора(Форма, Данные.path);
		Если Не ФайлНабора = Неопределено Тогда
			СтрокаНабора	= ФайлНабора.СтрокаНабора;
			СсылкаНаФайл	= ФайлНабора.СсылкаНаФайл;
			Обработчик		= НайтиОбработчикВарианта(СтрокаНабора, СсылкаНаФайл.Ключ); //TODO: файлы параметров набора пока не перечитываем
			ЗаписьКарты		= ФайлНабора.ЗаписьКарты;
			//содержимое из события не берем: хэш при сохранении считался по тексту, прочитанному так же
			ХэшТекста		= ОбщегоНазначенияВызовСервера_Ei.ПолучитьХешСтроки(ПрочитатьТекст(Данные.path));
			//одно сохранение файла порождает несколько событий: каждую версию файла обрабатываем один раз
			Если Не Обработчик = Неопределено
				И Не СсылкаНаФайл.Хэш = ХэшТекста
				И Не ЗаписьКарты.ХэшОбработанного = ХэшТекста Тогда
				ЗаписьКарты.ХэшОбработанного = ХэшТекста;
				Загружать = Истина;
				Если Обработчик.Модифицированность(Форма, СтрокаНабора) Тогда
					ТекстВопроса = СтрШаблон(НСтр("ru = 'Файл %1 изменен вне Ei, а в наборе %2 есть несохраненные изменения этого варианта.
						|Загрузить вариант из файла? Несохраненные изменения будут потеряны.'"), Данные.path, СтрокаНабора.ИмяНабора);
					Ответ		= Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
					Загружать	= (Ответ = КодВозвратаДиалога.Да);
				КонецЕсли;
				Если Загружать Тогда
					//пока ждали ответа, файл мог измениться еще раз - берем текущую версию
					ЗагрузитьВариантИзФайла(Форма, СтрокаНабора, Обработчик, СсылкаНаФайл, Данные.path, ПрочитатьТекст(Данные.path));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;			
КонецПроцедуры

// Каталог исходников внешней обработки, в которую сохранены наборы.
// Путь совпадает с тем, что присылает ВК отслеживания в событиях
// 
// Параметры:
//  Каталог 	- Строка - папка сохранения наборов, с разделителем в конце или без
//  ИмяПроекта 	- Строка - имя проекта EDT, оно же имя корневого набора
// 
// Возвращаемое значение:
//  Строка - например D:\edt\Ei\Внешние_Ei\Новый1\src\ExternalDataProcessors\Вар1
Функция КаталогОбработки(Знач Каталог, ИмяПроекта) Экспорт
	Разделитель = ПолучитьРазделительПути();
	Если СтрЗаканчиваетсяНа(Каталог, Разделитель) Тогда
		Каталог = БезПоследнегоСимвола(Каталог);
	КонецЕсли;
	ЧастиПути = Новый Массив;
	ЧастиПути.Добавить(Каталог);
	ЧастиПути.Добавить(ФайлыКлиентСервер_Ei.КаталогИсходников());
	ЧастиПути.Добавить(EDTКлиент_Ei.ВнешОбработка() + "s");
	ЧастиПути.Добавить(ИмяПроекта);
	Возврат СтрСоединить(ЧастиПути, Разделитель);
КонецФункции


//  	*Значение	- Массив ИЗ Строка
Функция ПолучитьСущКаталоги()
	СущКаталоги 	= Новый Соответствие();
	Для Каждого ТипыМетаданных ИЗ EDTКлиент_Ei.ТипыМетаданных() Цикл
		СущКаталоги.Вставить(ТипыМетаданных.Значение,	Новый Массив);
	КонецЦикла;
	Возврат СущКаталоги;
КонецФункции

// Запомнить каталог.
// 
// Параметры:
//  СущКаталоги см. ПолучитьСущКаталоги
//  СтрСохранения см. ФайлыКлиент_Ei.РезультатСохранения
Процедура ЗапомнитьКаталог(СущКаталоги,СтрСохранения)
	Файлы = Неопределено; 
	Для Каждого Путь ИЗ  СтрРазделить(СтрСохранения.Каталог,"\") Цикл
		Если Файлы = Неопределено Тогда
			//это первый проход
			Файлы = СущКаталоги.Получить(Путь);
		Иначе
			Файлы.Добавить(нРег(Путь));
		КонецЕсли;			
	КонецЦикла;			
КонецПроцедуры

// Удалим кталоги которые есть на диске но нет в метаданных
// 
// Параметры:
//  ИмяПапкиПроекта - Строка - Имя папки проекта
//  ИмяПроекта		- Строка
//  СущКаталоги 	см. ПолучитьСущКаталоги
Асинх Процедура УдалитьНесуществующиеКаталоги(ИмяПапкиПроекта,ИмяПроекта,СущКаталоги)
	Для Каждого СущКаталог ИЗ  СущКаталоги Цикл
		Каталоги = Ждать НайтиФайлыАсинх(СтрШаблон("%1\src\%2s\%3\%4\",ИмяПапкиПроекта,EDTКлиент_Ei.ВнешОбработка(),ИмяПроекта,СущКаталог.Ключ),"*");
		Для Каждого Каталог ИЗ Каталоги Цикл
			Если СущКаталог.Значение.Найти(нРег(Каталог.Имя)) = Неопределено Тогда
				УдалитьФайлыАсинх(Каталог.ПолноеИмя);	
			КонецЕсли;		
		КонецЦикла;
	КонецЦикла;			
КонецПроцедуры		



Функция БезПоследнегоСлеша(Путь)
	Результат = Путь;
	Если СтрЗаканчиваетсяНа(Путь,"\") Тогда

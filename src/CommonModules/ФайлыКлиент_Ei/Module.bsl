Функция вПолучитьСохраняемыйОбраз(Форма) Экспорт 
	сзВариантов = ПолучитьВарианты(Форма[КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента()].ПолучитьЭлементы());
	Возврат ФайлВызовСервера_Ei.ПолучитьПредставлениеСохраенногоОбраза(сзВариантов); //
КонецФункции

Функция вПолучитьСохраненныйОбраз(Форма) Экспорт
	Результат = ФайлыКлиент_Ei.ПрочитатьТекст(Форма.ИмяФайлаНастройки);
	Если ЗначениеЗаполнено(Результат) Тогда
		Результат =  ФайлВызовСервера_Ei.ПолучитьПредставлениеСохраенногоОбраза(Результат)	
	КонецЕсли;	
	Возврат Результат;
КонецФункции

Функция ПрочитатьТекст(сИмяФайла) Экспорт
	Результат = "";
	ЧТ = Новый ЧтениеТекста(сИмяФайла);
	Результат = ЧТ.Прочитать();
	ЧТ.Закрыть();
	Возврат Результат;
КонецФункции

Функция ПолучитьИмяВременногоФайлаНастройки(сИмяФайлаНастройки) Экспорт
	Файл = Новый Файл(сИмяФайлаНастройки);
	Возврат Файл.Путь+"~"+Файл.ИмяБезРасширения+"."+РасширениеВременныйФайл();	
КонецФункции

Функция РасширениеВременныйФайл()
	Возврат "tmp";	
КонецФункции


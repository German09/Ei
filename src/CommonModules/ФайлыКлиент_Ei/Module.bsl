// Прочитать текст.
// 
// Параметры:
//  ИмяФайла - Строка - имя файла
// 
// Возвращаемое значение:
//  Строка, Неопределено - Прочитать текст
Функция ПрочитатьТекст(ИмяФайла) Экспорт
	Результат = "";
	ЧтениеТекста = Новый ЧтениеТекста(ИмяФайла);
	Результат = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	//файлы пишем см. ФайлыКлиентСервер_Ei.ЗаписатьСтроку, она добавляет перевод строки в конце,
	//а хэш при сохранении считается по тексту без него: уберем, иначе прочитанный текст не совпадет с сохраненным
	Если Прав(Результат, 1) = Символы.ПС Тогда
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Записать XMLСтроку.
// 
// Параметры:
//  ПолноеИмя 	- Строка
//  Содержание 	- Строка
Процедура ЗаписатьXMLСтроку(Знач ПолноеИмя,Содержание) Экспорт
	ЗаписьXML 		= Новый ЗаписьXML();
	ЗаписьXML.ОткрытьФайл(ПолноеИмя);
	ЗаписьXML.ЗаписатьБезОбработки(Содержание);
	ЗаписьXML.Закрыть();
КонецПроцедуры

// Получить имя временного файла настройки.
// 
// Параметры:
//  ИмяФайлаНастройки - Строка -
// 
// Возвращаемое значение:
//  Строка - Получить имя временного файла настройки
Функция ПолучитьИмяВременногоФайлаНастройки(ИмяФайлаНастройки) Экспорт
	Файл = Новый Файл(ИмяФайлаНастройки);
	Возврат Файл.Путь+"~"+Файл.ИмяБезРасширения+"."+РасширениеВременныйФайл();	
КонецФункции

// Подписаться на изменение файлов.
// 
// Параметры:
//  Форма см. Обработка.Ei.Форма.Форма
// 
// Возвращаемое значение:
// 	Неопределено 
Асинх Функция ПодписатьсяНаИзменениеФайлов(Форма) Экспорт
	Если ЗначениеЗаполнено(Форма.ИмяФайлаНастройки) Тогда
		НаборВариантовКлиент_Ei.ЗаполнитьФайлыКНаборам(Форма, Форма.ИмяФайлаНастройки, ИмяОбработки(Форма));
	КонецЕсли;
	ОтслеживатьПапку(Форма, Форма.ИмяФайлаНастройки);
КонецФункции			

#Область ПроверкаФайла
Процедура ОО_ПолучениеРезультатаСуществованияВременногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат Тогда
		Файл = Новый Файл(ДопПараметры.ИмяФайла);
		Файл.НачатьПолучениеВремениИзменения(Новый ОписаниеОповещения("ОО_ПолучениеВремениИзмененияВременногоФайла",ЭтотОбъект,ДопПараметры));
	КонецЕсли;
КонецПроцедуры	

Процедура ОО_ПолучениеВремениИзмененияВременногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат   >  ДопПараметры.ДатаИзмененияФайлаНастройки Тогда
		//файл запросов свяжее, загрузим результат из него
		Открыть(ДопПараметры.ИмяФайла,Новый Структура("Форма",ДопПараметры.Форма));
	КонецЕсли;	
КонецПроцедуры

Процедура ОО_ПолучениеВремениИзмененияСохраненногоФайла(Результат,ДопПараметры) Экспорт
	Если Результат   >  ДопПараметры.ДатаИзменения Тогда
		//файл запросов свяжее, загрузим результат из него или из временного
		Открыть(ДопПараметры.ИмяФайла,Новый Структура("Форма,ДатаИзмененияФайлаНастройки",ДопПараметры.Форма,Результат));
	КонецЕсли;	
КонецПроцедуры
#КонецОбласти

// Считываем с ФС определенный Вариант
// 
// Параметры:
//  Форма см. Обработка.Ei.Форма.Форма
//
Асинх Процедура Перечитать(Форма) Экспорт
	Если Не ПустаяСтрока(Форма.ИмяФайлаНастройки) Тогда
		Каталог    = Форма.ИмяФайлаНастройки;
		ИмяПроекта = ИмяОбработки(Форма); //путь к файлам ведет через имя обработки, а не через имя проекта EDT
		Если ЗначениеЗаполнено(ИмяПроекта) Тогда
			ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
			Если Не ТекД = Неопределено Тогда
				Вариант = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТекД);
				Если Не Вариант = Неопределено Тогда
					Если ТипЗнч(ТекД.Файлы) = Тип("Структура") Тогда
						//ИскомоеИмя = ВариантыКлиентСервер_Ei.ПолучитьИмя(ТекД.ИмяНабора,Вариант);
						ИсклюмыйКлюч =  Строка(ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(ТекД.КлючНастроек,Вариант.Свойства().Код));
						Для Каждого Файл ИЗ ТекД.Файлы Цикл
							Если Файл.Значение.Ключ = ИсклюмыйКлюч Тогда
								ПолноеИмя 	= СтрШаблон("%1%6%5%6%2s%6%3%6%4",Каталог,EDTКлиент_Ei.ВнешОбработка(),ИмяПроекта,Файл.Значение.Окончание,ФайлыКлиентСервер_Ei.КаталогИсходников(),ПолучитьРазделительПути());
								Если Файл.Значение.Свойство("КлючБлока") Тогда
									Событие = Новый Структура("path,type", ПолноеИмя, "modified");
									Ждать ФормаНабораКлиент_Ei.ОбработатьСобытие(Форма, Каталог, Событие);
								Иначе
									ЗагрузитьВариантИзФайла(Форма, ТекД, Вариант, Файл.Значение, ПолноеИмя, ПрочитатьТекст(ПолноеИмя));
								КонецЕсли;
								Прервать;	
							КонецЕсли;		
						КонецЦикла;
					КонецЕсли;			
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

// Сохранить в каталог обработки.
// 
// Параметры:
//  Форма 		см. Обработка.Ei.Форма.Форма
//  СтрНаборов 	см. ВариантыКлиент_Ei.Получить
//  ИмяФайла 	- Строка - Имя папки
Асинх Процедура СохранитьВКаталогОбработки(Форма,СтрНаборов,ИмяФайла) Экспорт
	Перем Набор;
	ИмяПроекта		= "";
	СтрРезультат 	= Новый Структура;	
	Файл 			= Новый Файл(ИмяФайла);
	Каталог 		= Файл.ПолноеИмя+ПолучитьРазделительПути();
	ПутьИсходники 	= Ждать СоздатьКаталогАсинх(Каталог+ФайлыКлиентСервер_Ei.КаталогИсходников());
	ИмяНабора  		= НаборВариантовКлиентСервер_Ei.ПолучитьИмяНабора(СтрНаборов);
	СущКаталоги 	= ПолучитьСущКаталоги();
	Если Не ИмяНабора = Неопределено И СтрНаборов.Свойство(ИмяНабора,Набор) Тогда
		ОстановитьОтслеживание(Форма); //на время сохранения, чтобы не вызывать ненужных событий
		
		Попытка
			Запись = Ждать EDTКлиент_Ei.ПолучитьМетаданныеОбработки(ПутьИсходники, Набор.КлючНастроек, ИмяНабора, Файл.ПолноеИмя);
			КлючНабора = Набор.КлючНастроек;
			ОбщаяФорма = ФормаНабораКлиент_Ei.НачатьСохранение(Запись.Каталог, ИмяНабора, СтрНаборов);
			Для Каждого СтрНабор ИЗ СтрНаборов Цикл
				Набор 		= СтрНабор.Значение;
				мСостава 	= Новый Массив;	
				СтрРезультат.Вставить(Набор.Имя,мСостава);			
				
				//Сохранение параметров
				РезультатыСохр = Ждать ПараметрыКлиент_Ei.СохранитьВКаталог(Запись.Каталог, Набор, ИмяНабора, ОбщаяФорма);
				//@skip-check bsl-legacy-check-for-each-statetement-collection
				Для Каждого СтрСохранения ИЗ РезультатыСохр Цикл
					мСостава.Добавить(СтрСохранения);
					ЗапомнитьКаталог(СущКаталоги,СтрСохранения);
				КонецЦикла;		
				
				//Сохранение вариантов, тут поведение уже определяется настройкой каждого варианта
				РезультатыСохр = Ждать ВариантыКлиент_Ei.СохранитьВКаталог(Запись.Каталог, Набор, ИмяНабора, ОбщаяФорма);
				//@skip-check bsl-legacy-check-for-each-statetement-collection
				Для Каждого СтрСохранения ИЗ РезультатыСохр Цикл
					мСостава.Добавить(СтрСохранения);
					ЗапомнитьКаталог(СущКаталоги,СтрСохранения);
				КонецЦикла;

			КонецЦикла;
			ФайлОбщейФормы = Ждать ФормаНабораКлиент_Ei.ЗавершитьСохранение(ОбщаяФорма, КлючНабора);
			СтрРезультат[ИмяНабора].Добавить(ФайлОбщейФормы);
			ЗапомнитьКаталог(СущКаталоги, ФайлОбщейФормы);
			EDTКлиент_Ei.ЗаписатьСоставОбработки(Запись.ЗаписьXML,СтрРезультат, СтрНаборов);
			Запись.ЗаписьXML.ЗаписатьКонецЭлемента();	
			ЗаписатьXMLСтроку(Запись.ИмяФайла, Запись.ЗаписьXML.Закрыть());
			//модуль объекта - обвязка для EDT: встроенные функции Ei с типами, алгоритмы остаются в формах
			EDTКлиент_Ei.ЗаписатьМодуль(Запись.Каталог,EDTКлиент_Ei.ТекстМодуляОбъекта(СтрНаборов),"Object");
			НаборВариантовКлиент_Ei.ЗапомнитьСсылкиНаФайлы(Форма, СтрРезультат, Файл.ПолноеИмя, ИмяНабора);
			
			//Служебные файлы для того чтобы проект можно было открыть в EDT. Готовый проект EDT не трогаем:
			//в нем могут быть и другие обработки, а имя проекта и базовый проект задал его автор
			ИмяПроекта = Ждать EDTКлиент_Ei.ПолучитьИмяПроекта(Файл.ПолноеИмя, Ложь);
			Если Не ЗначениеЗаполнено(ИмяПроекта) Тогда
				EDTКлиент_Ei.СоздатьФайлПроекта(Каталог, ИмяНабора,"V8ExternalObjectsNature");	
				EDTКлиент_Ei.СоздатьОпределение(Форма,Каталог);			
			КонецЕсли;
			//удалим каталоги, которых уже нет
			Ждать УдалитьНесуществующиеКаталоги(ИмяФайла, ИмяНабора, СущКаталоги, Запись.ОбъектыEi);
		Исключение
			ОтслеживатьПапку(Форма, ИмяФайла);
			ВызватьИсключение;
		КонецПопытки;
		ОтслеживатьПапку(Форма, ИмяФайла);
	КонецЕсли;	
КонецПроцедуры

// Результат сохранения.
// 
// Параметры:
//  Имя					- Строка - Имя объекта. 			Набор_Параметр_Особенность
//  ПутьККорневойПапаке - Строка - Путь к корневой папаке	C:\Users\g.kudiakov\Documents\Ei_Настройка\src\ExternalDataProcessors\Набор
//  Текст 				- Строка - Текст файла				
//  ВариантКлюч 		- Строка - Ключ						55a4e36a-d2be-4a18-bbb0-c13c4a1ec5c5
//  Файл 				- Файл 	 - Считанный файл			C:\Users\g.kudiakov\Documents\Ei_Настройка\src\ExternalDataProcessors\Набор\Templates\Набор_Параметр_Особенность
//  ДопСвойства			- Структура -  Структура дополнительных свойств которая передается в результат:
//  	* Комментарий   - Строка - Параметр
//  	* Синоним 		- Строка - Имя параметра - Особенность
//  	* ТипМакета		- Строка - Ключ см. EDTКлиент_Ei.ТипыМакетов
//  	* Владелец		- Строка - у части варианта из нескольких файлов - ключ варианта, см. КлючВариантаФайла
//  	
// 
// Возвращаемое значение:
//  Структура - Результат сохранения:
// * Имя		- Строка - Имя объекта (для возможности сохранения в метаданные)- Набор_Параметр_Особенность
// * Ключ 		- Строка - 55a4e36a-d2be-4a18-bbb0-c13c4a1ec5c5
// * Каталог 	- Строка - Templates\Набор_Параметр_Особенность
// * Окончание 	- Строка - Templates\Набор_Параметр_Особенность\Template.txt
// * Ссылка 	- Строка - Относительный путь - Template.Набор_Параметр_Особенность
// * Хэш 		- Строка - BEDC02EFD880356D5B04DECE55DE8BB6
// * КлючБлока - Строка - ключ блока общей формы, если код хранится в ней
// * ИмяЧасти - Строка - логическое имя части общей формы
// * СтрокаБлока - Строка - имя строки, которой принадлежит блок
// * ТипМакета  - Строка - Ключ см. EDTКлиент_Ei.ТипыМакетов [не всегда, получаем из ДопСвойства, специфично для макета]
// * Синоним	- Строка - Синоним метаданных [почти всегда, получаем из ДопСвойства]
// * Описание	- Строка - Документирующий комментарий описания результата
// * Получение	- Строка - Текст алгоритма получения результата, который будет размещен в модуле обработки 
//
Функция РезультатСохранения(Имя, ПутьККорневойПапаке, Текст, ВариантКлюч, Файл, ДопСвойства = Неопределено) Экспорт
	ОтносительныйПуть 	= БезПоследнегоСимвола(СтрЗаменить(Файл.Путь,ПутьККорневойПапаке+"\",""));
	Ссылка 				= СтрЗаменить(ОтносительныйПуть,EDTКлиент_Ei.ОкончаниеКласса(),".");
	Результат 			= Новый Структура("Ключ,Каталог,Ссылка",ВариантКлюч,ОтносительныйПуть,Ссылка);
	Результат.Вставить("Хэш",		ОбщегоНазначенияВызовСервера_Ei.ПолучитьХешСтроки(Текст));
	Результат.Вставить("Имя",		ОбщегоНазначенияКлиентСервер_Ei.СтрПослеОкончание(Ссылка,"."));
	Результат.Вставить("Окончание",	СтрШаблон("%1\%2",ОтносительныйПуть,Файл.Имя));
	Если ТипЗнч(ДопСвойства) = Тип("Структура") Тогда
		//дополним специфичными свойствами 
		ОбщегоНазначенияКлиентСервер_Ei.вСоединить(Результат,ДопСвойства);		
	КонецЕсли;	
	//@skip-check constructor-function-return-section
	Возврат Результат;	
КонецФункции

// Ключ варианта, которому принадлежит файл: у части варианта из нескольких файлов (свойство Владелец,
// см. EDTКлиент_Ei.КомментарийЧасти) - ключ ее варианта, иначе - ключ самого файла
// 
// Параметры:
//  СсылкаНаФайл - см. РезультатСохранения
// 
// Возвращаемое значение:
//  Строка
Функция КлючВариантаФайла(СсылкаНаФайл) Экспорт
	Владелец = Неопределено;
	Если Не СсылкаНаФайл.Свойство("Владелец", Владелец) Или Не ЗначениеЗаполнено(Владелец) Тогда
		Владелец = СсылкаНаФайл.Ключ;
	КонецЕсли;
	Возврат Строка(Владелец);
КонецФункции

// Сохраняет по умолчанию в текстовый макет, самый простой случай
// 
// Параметры:
//  Обработчик 	- ОбщийМодуль
//  Путь 		- Строка 
//  НаборИмя 	- Строка
//  НаборКлюч  	- Строка
//  Данные 		- ФиксированнаяСтруктура
// 
// Возвращаемое значение:
// 	см. СохранитьВМакет
Асинх Функция СохранитьОбщее(Обработчик, Путь, НаборИмя, НаборКлюч, Данные) Экспорт
	ВариантКлюч	= ВариантыКлиентСервер_Ei.ПолучитьИдентификатор(НаборКлюч,Обработчик);
	ВариантИмя	= ВариантыКлиентСервер_Ei.ПолучитьИмя(НаборИмя,Обработчик);
	Содержание		= ОбщегоНазначенияВызовСервера_Ei.Сериализовать(Новый Структура(Данные)); //Структуру делаем из фиксированной структуры
	//КаталогПуть = Ждать EDTКлиент_Ei.СоздатьОбшийМакет(Путь, Содержание, ВариантИмя, ВариантКлюч);
	Результат 	= СохранитьВМакет("TextDocument", НаборИмя, Путь, Содержание, ВариантИмя, ВариантКлюч);
	Возврат Результат;
КонецФункции

// Сохраняет по умолчанию в макет определенного типа
// 
// Параметры:
// 	ТипМакета		- Строка - Ключ из см. EDTКлиент_Ei.ТипыМакетов
//  НаборИмя 		- Строка
//  Путь 			- Строка
//  Содержание			- Строка - Содержание макета 
//  ВариантИмя  	- Строка
//  ВариантКлюч  	- Строка
//  Данные 			- ФиксированнаяСтруктура
// 
// Возвращаемое значение:
// 	см. РезультатСохранения
Асинх Функция СохранитьВМакет(Знач ТипМакета, НаборИмя, Путь, Содержание, ВариантИмя, ВариантКлюч) Экспорт
	Перем ИмяМакета;
	Если EDTКлиент_Ei.ТипыМакетов().Свойство(ТипМакета,ИмяМакета) Тогда
		ДопСвойства = Новый Структура("ТипМакета,Синоним", ТипМакета, НаборИмя);
		ПолноеИмя	= Ждать EDTКлиент_Ei.СоздатьМакетОбработки(Путь, Содержание, ВариантИмя, ВариантКлюч, ИмяМакета, НаборИмя);
		Результат 	= РезультатСохранения(НаборИмя, Путь, Содержание, ВариантКлюч, Новый Файл(ПолноеИмя), ДопСвойства);
		Возврат Результат;
	КонецЕсли;	
КонецФункции

// Сохранить начало.
// 
// Параметры:
//  Форма 					см. Обработка.Ei.Форма.Форма
//  ЗапрашиватьСохранение 	- Булево - Запрашивать сохранение
//  ЗапрашиватьИмяФайла 	- Булево - Запрашивать имя файла
// 
// Возвращаемое значение:
// 	Булево - Довели процесс сохранения до конца или отказались на каком то этапе вопросов 
Асинх Функция Сохранить(Форма, ЗапрашиватьСохранение = Ложь, ЗапрашиватьИмяФайла = Ложь) Экспорт 
	Существует = Ложь;
	Если Не ЗапрашиватьИмяФайла И ЗапрашиватьСохранение Тогда
		Ответ = Ждать ВопросАсинх("Сохранить текущие варианты?", РежимДиалогаВопрос.ДаНетОтмена);		
		Если Ответ = Неопределено ИЛИ Ответ = КодВозвратаДиалога.Отмена Тогда
			Возврат Ложь;
		ИначеЕсли Ответ = КодВозвратаДиалога.Нет  Тогда
			Возврат Истина;		
		КонецЕсли;
	КонецЕсли;
	СохраненныйКаталог 	= Новый Файл(Форма.ИмяФайлаНастройки);
	Если ПустаяСтрока(Форма.ИмяФайлаНастройки) Тогда
		Существует = Ложь;
	Иначе	
		Существует = Ждать СохраненныйКаталог.СуществуетАсинх();		
	КонецЕсли;
	
	Если ЗапрашиватьИмяФайла ИЛИ Не Существует Тогда
		Каталог = Ждать ВыбратьКаталогСохранения(Форма, СохраненныйКаталог.Путь);
		Если Каталог =  Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;		
		СохранитьВКаталог(Форма, Каталог);
	Иначе 	
		СохранитьВКаталог(Форма, СохраненныйКаталог.ПолноеИмя);
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Начинает открытие набора из папки
//
// Параметры:
//  Форма 		 см. Обработка.Ei.Форма.Форма
//           
Асинх Процедура Выбрать(Форма) Экспорт
	ФайлКаталог 	= Новый Файл(Форма.ИмяФайлаНастройки);
	Длг 			= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Длг.Каталог 	= ФайлКаталог;
	Длг.Заголовок 	= "Выберите каталог с варинтами";
	Длг.МножественныйВыбор 	= Ложь;
	Каталоги = Ждать Длг.ВыбратьАсинх();
	Если Не Каталоги =  Неопределено Тогда
		Для Каждого Каталог ИЗ Каталоги Цикл
			ИмяПроекта = Ждать EDTКлиент_Ei.ПолучитьИмяПроекта(Каталог);
			Если ЗначениеЗаполнено(ИмяПроекта) Тогда
				ИмяОбработки = Ждать ВыбратьОбработкуПроекта(Каталог, ИмяПроекта);
				Если ЗначениеЗаполнено(ИмяОбработки) Тогда
					Ждать ОткрытьНабор(Форма, Каталог, ИмяОбработки);
				КонецЕсли;
			КонецЕсли;			
			Прервать; //по идее будет только один
		КонецЦикла;
	КонецЕсли;		
КонецПроцедуры

// Открыть набор из списка последних, см. ОбновитьМенюПоследнихНаборов
// 
// Параметры:
//  Форма 		- см. Обработка.Ei.Форма.Форма
//  ИмяКоманды 	- Строка - см. ФайлыКлиентСервер_Ei.ИмяКомандыПоследнегоНабора
Асинх Процедура ОткрытьПоследнийНабор(Форма, ИмяКоманды) Экспорт
	Номер 			= ФайлыКлиентСервер_Ei.НомерПоследнегоНабора(ИмяКоманды);
	ПоследниеНаборы = НастройкиПользователяКлиентСервер_Ei.ПолучитьПоследниеНаборы(Форма.НастройкиПользователя);
	Счетчик 		= 0;
	Для Каждого Последний Из ПоследниеНаборы Цикл
		Счетчик = Счетчик + 1;
		Если Счетчик = Номер Тогда
			Открыли = Ждать ОткрытьНабор(Форма, Последний.Каталог, Последний.Имя);
			Если Не Открыли Тогда
				//папку или обработку удалили или переименовали: из списка ее убираем
				ПоследниеНаборы.Удалить(ПоследниеНаборы.Найти(Последний));
				НастройкиПользователяКлиентСервер_Ei.СохранитьПоследниеНаборы(Форма.НастройкиПользователя, ПоследниеНаборы);
				ОбновитьМенюПоследнихНаборов(Форма);
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Показать последние наборы в подменю Открыть, см. ФайлыКлиентСервер_Ei.СоздатьМенюПоследнихНаборов.
// Текущий набор отмечен пометкой
// 
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
Процедура ОбновитьМенюПоследнихНаборов(Форма) Экспорт
	ПоследниеНаборы = НастройкиПользователяКлиентСервер_Ei.ПолучитьПоследниеНаборы(Форма.НастройкиПользователя);
	ТекущееИмя		= ИмяОбработки(Форма);
	Номер 			= 0;
	Для Каждого Последний Из ПоследниеНаборы Цикл
		Номер 	= Номер + 1;
		Кнопка 	= Форма.Элементы.Найти(ФайлыКлиентСервер_Ei.ИмяКнопкиПоследнегоНабора(Номер));
		Если Не Кнопка = Неопределено Тогда
			Кнопка.Заголовок 	= СтрШаблон("%1 (%2)", Последний.Имя, Последний.Каталог);
			Кнопка.Пометка 		= ЭтоТотЖеНабор(Последний, Форма.ИмяФайлаНастройки, ТекущееИмя);
			Кнопка.Видимость 	= Истина;
		КонецЕсли;
	КонецЦикла;
	Для Номер = Номер + 1 По ФайлыКлиентСервер_Ei.ЧислоПоследнихНаборов() Цикл
		Кнопка = Форма.Элементы.Найти(ФайлыКлиентСервер_Ei.ИмяКнопкиПоследнегоНабора(Номер));
		Если Не Кнопка = Неопределено Тогда
			Кнопка.Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Имя обработки, в которую сохраняется набор: имя корневого набора
// 
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
// 
// Возвращаемое значение:
//  Строка - пустая, если наборов нет
Функция ИмяОбработки(Форма) Экспорт
	Результат		= "";
	КорневаяСтрока	= НаборВариантовКлиент_Ei.КорневаяСтрока(Форма);
	Если Не КорневаяСтрока = Неопределено Тогда
		Результат = КорневаяСтрока.ИмяНабора;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Получить ВК отслеживания изменений файлов. При первом обращении ВК подключается, при необходимости
// с установкой. Если подключить не удалось, пользователь один раз получает оповещение, а форма работает
// без отслеживания: повторных попыток подключения и установки в этой форме не будет
// 
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
// 
// Возвращаемое значение:
//  Неопределено - ВК недоступна;
//  Произвольный - объект ВК AddIn.<Идентификатор>.FileWatcher, см. ИмяВКОтслеживания
Асинх Функция ПолучитьВКОтслеживания(Форма) Экспорт
	Если Форма.ВКОтслеживания = Неопределено Тогда
		Расположение	= "ОбщийМакет.ОтслеживаниеФайлов_ВК_Ei";
		// Имя регистрации меняется вместе с пакетом, чтобы 1С загрузила новую DLL.
		Идентификатор	= ОбщегоНазначенияКлиентСервер_Ei.Постфикс() + "FileWatcher135";
		Подключена		= Ждать ПодключитьВнешнююКомпонентуАсинх(Расположение, Идентификатор, ТипВнешнейКомпоненты.Native);
		Если Не Подключена Тогда
			Попытка
				Ждать УстановитьВнешнююКомпонентуАсинх(Расположение);
				Подключена = Ждать ПодключитьВнешнююКомпонентуАсинх(Расположение, Идентификатор, ТипВнешнейКомпоненты.Native);
			Исключение
				Подключена = Ложь; //установку отменил пользователь или ВК не поддерживается на этой платформе
			КонецПопытки;
		КонецЕсли;
		Если Подключена Тогда
			// AddIn.<идентификатор>.<имя класса из компоненты>
			Форма.ВКОтслеживания = Новый(СтрШаблон("AddIn.%1.%2", Идентификатор, ИмяВКОтслеживания()));
		Иначе
			Форма.ВКОтслеживания = Ложь; //признак неудачи, см. описание переменной в Обработка.Ei.Форма.Форма
			ПоказатьОповещениеПользователя(НСтр("ru = 'Отслеживание изменений файлов недоступно'"), ,
				НСтр("ru = 'Не удалось подключить внешнюю компоненту. Изменения сохраненных файлов не будут подтягиваться автоматически, используйте команду Перечитать.'"),
				ОбщегоНазначенияКлиент_Ei.КартинкаОповещения());
		КонецЕсли;
	КонецЕсли;
	Результат = ?(Форма.ВКОтслеживания = Ложь, Неопределено, Форма.ВКОтслеживания);
	Возврат Результат;
КонецФункции

// Событие отслеживания.
// 
// Параметры:
//  Форма 		см. Обработка.Ei.Форма.Форма
//  Каталог 	- Строка - путь папки слежения (как передано в НачатьСлежение / StartWatch);
//  Данные   	- Структура:
//    type             - Строка  - тип операции:
//                                 "created"  - создание;
//                                 "deleted"  - удаление;
//                                 "modified" - изменение;
//                                 "renamed"  - переименование;
//                                 "rescan"   - потеря событий слежения;
//    itemType         - Строка  - тип объекта: "file" или "directory";
//    path             - Строка  - полный путь к объекту (для renamed совпадает с newPath);
//    oldPath          - Строка  - прежний путь (заполняется только для renamed, иначе "");
//    newPath          - Строка  - новый путь (заполняется только для renamed, иначе "");
//    date             - Дата    - дата/время в формате "yyyy-MM-ddTHH:mm:ss"
//                                 (mtime файла, если доступен; для deleted - время события);
//    content          - Строка  - текстовое содержимое файла (UTF-8);
//                                 для directory, deleted, бинарных и при ошибке чтения - "";
//    contentTruncated - Булево  - Истина, если файл больше лимита МаксБайтСодержимого;
//    contentSkipped   - Булево  - Истина, если содержимое не читалось
//                                 (бинарный файл, ошибка доступа, нулевой лимит и т.п.).
//
Асинх Процедура СобытиеОтслеживания(Форма, Каталог, Данные) Экспорт
	Если Данные.type = "rescan" Тогда
		Если Не ОдинКаталог(Форма.ИмяФайлаНастройки, Каталог) Тогда
			Возврат;
		КонецЕсли;
		Ревизия = Форма.ВКОтслеживания.РевизияСлежения(Каталог);
		Если СтрЗаканчиваетсяНа(Ревизия, ":0") Тогда
			Возврат; //событие от предыдущей подписки, текущая подписка полная
		КонецЕсли;
	КонецЕсли;
	ФормаНабораКлиент_Ei.ЗапланироватьПроверкуСборки(Форма);
	Если Ждать ФормаНабораКлиент_Ei.ОбработатьСобытие(Форма, Каталог, Данные) Тогда
		Возврат;
	КонецЕсли;
	Если Данные.itemType = "file" И Данные.type = "modified" Тогда
		ФайлНабора = НаборВариантовКлиент_Ei.НайтиФайлНабора(Форма, Данные.path);
		Если Не ФайлНабора = Неопределено Тогда
			СтрокаНабора	= ФайлНабора.СтрокаНабора;
			СсылкаНаФайл	= ФайлНабора.СсылкаНаФайл;
			ЗаписьКарты		= ФайлНабора.ЗаписьКарты;
			//файл принадлежит либо варианту (в том числе как часть, см. EDTКлиент_Ei.КомментарийЧасти), либо параметру набора
			Обработчик		= НайтиОбработчикВарианта(СтрокаНабора, КлючВариантаФайла(СсылкаНаФайл));
			Параметр		= ?(Обработчик = Неопределено, ПараметрыКлиент_Ei.НайтиПараметр(СтрокаНабора, СсылкаНаФайл.Ключ), Неопределено);
			//содержимое из события не берем: хэш при сохранении считался по тексту, прочитанному так же
			ХэшТекста		= ОбщегоНазначенияВызовСервера_Ei.ПолучитьХешСтроки(ПрочитатьТекст(Данные.path));
			//одно сохранение файла порождает несколько событий: каждую версию файла обрабатываем один раз
			Если (Не Обработчик = Неопределено Или Не Параметр = Неопределено)
				И Не СсылкаНаФайл.Хэш = ХэшТекста
				И Не ЗаписьКарты.ХэшОбработанного = ХэшТекста Тогда
				ЗаписьКарты.ХэшОбработанного = ХэшТекста;
				Если Обработчик = Неопределено Тогда
					Модифицирован	= ПараметрыКлиент_Ei.Модифицированность(Параметр, СсылкаНаФайл, ИмяОбработки(Форма));
					Что				= СтрШаблон(НСтр("ru = 'параметра %1'"), Параметр.ИмяПараметра);
				Иначе
					Модифицирован	= Обработчик.Модифицированность(Форма, СтрокаНабора);
					Что				= НСтр("ru = 'этого варианта'");
				КонецЕсли;
				Загружать = Истина;
				Если Модифицирован Тогда
					ТекстВопроса = СтрШаблон(НСтр("ru = 'Файл %1 изменен вне Ei, а в наборе %2 есть несохраненные изменения %3.
						|Загрузить из файла? Несохраненные изменения будут потеряны.'"), Данные.path, СтрокаНабора.ИмяНабора, Что);
					Ответ		= Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
					Загружать	= (Ответ = КодВозвратаДиалога.Да);
				КонецЕсли;
				Если Загружать Тогда
					//пока ждали ответа, файл мог измениться еще раз - берем текущую версию
					Текст = ПрочитатьТекст(Данные.path);
					Если Обработчик = Неопределено Тогда
						ЗагрузитьПараметрИзФайла(Форма, СтрокаНабора, Параметр, СсылкаНаФайл, Текст);
					Иначе
						ЗагрузитьВариантИзФайла(Форма, СтрокаНабора, Обработчик, СсылкаНаФайл, Данные.path, Текст);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;			
КонецПроцедуры

// Каталог исходников внешней обработки, в которую сохранены наборы.
// Путь совпадает с тем, что присылает ВК отслеживания в событиях
// 
// Параметры:
//  Каталог 	- Строка - папка сохранения наборов, с разделителем в конце или без
//  ИмяПроекта 	- Строка - имя проекта EDT, оно же имя корневого набора
// 
// Возвращаемое значение:
//  Строка - например D:\edt\Ei\Внешние_Ei\Новый1\src\ExternalDataProcessors\Вар1
Функция КаталогОбработки(Знач Каталог, ИмяПроекта) Экспорт
	Разделитель = ПолучитьРазделительПути();
	Если СтрЗаканчиваетсяНа(Каталог, Разделитель) Тогда
		Каталог = БезПоследнегоСимвола(Каталог);
	КонецЕсли;
	ЧастиПути = Новый Массив;
	ЧастиПути.Добавить(Каталог);
	ЧастиПути.Добавить(ФайлыКлиентСервер_Ei.КаталогИсходников());
	ЧастиПути.Добавить(EDTКлиент_Ei.ВнешОбработка() + "s");
	ЧастиПути.Добавить(ИмяПроекта);
	Возврат СтрСоединить(ЧастиПути, Разделитель);
КонецФункции

// Следить за изменением файлов в папке сохранения наборов.
// У каждой формы свой экземпляр ВК, и форма следит только за одной папкой,
// поэтому прежнее слежение останавливается целиком
// 
// Параметры:
//  Форма 	- см. Обработка.Ei.Форма.Форма
//  Каталог - Строка - папка сохранения наборов; если пустая или ее нет на диске, слежение только останавливается
Асинх Процедура ОтслеживатьПапку(Форма, Каталог) Экспорт
	ОстановитьОтслеживание(Форма);
	//папки может не быть, например настройки формы перенесены с другого компьютера: тогда отслеживать нечего
	ПапкаЕсть = Ложь;
	Если ЗначениеЗаполнено(Каталог) Тогда
		Папка		= Новый Файл(Каталог);
		ПапкаЕсть	= Ждать Папка.СуществуетАсинх();
	КонецЕсли;
	Если ПапкаЕсть Тогда
		ВКОтслеживания = Ждать ПолучитьВКОтслеживания(Форма);
		Если ВКОтслеживания <> Неопределено Тогда
			Если ВКОтслеживания.НачатьСлежение(Каталог) Тогда
				ФормаНабораКлиент_Ei.ЗапланироватьПроверкуСборки(Форма);
			Иначе
			ПоказатьОповещениеПользователя(НСтр("ru = 'Изменения файлов не отслеживаются'"), ,
				СтрШаблон(НСтр("ru = 'Папка %1. Изменения файлов не будут подтягиваться автоматически, используйте команду Перечитать.
					|Причина: %2'"), Каталог, ВКОтслеживания.ПолучитьПоследнююОшибку(Каталог)),
				ОбщегоНазначенияКлиент_Ei.КартинкаОповещения());
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Остановить слежение, запущенное см. ОтслеживатьПапку
// 
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
Процедура ОстановитьОтслеживание(Форма) Экспорт
	Форма.СнимокСборкиEDT = Неопределено;
	Если Не Форма.ВКОтслеживания = Неопределено И Не Форма.ВКОтслеживания = Ложь Тогда
		Форма.ВКОтслеживания.ОстановитьВсе();
	КонецЕсли;
КонецПроцедуры

Функция ИмяВКОтслеживания() Экспорт
	Возврат "FileWatcher";
КонецФункции		

// Загрузить в форму набор, уже прочитанный из папки проекта EDT: дерево наборов, сохраненный образ,
// слежение за папкой, последние наборы. Чтение отделено от загрузки, чтобы прочитанное можно было
// проверить до того, как форма потеряет свои несохраненные варианты, см. НавигационныеСсылкиКлиент_Ei.ОткрытьПоСсылке
// 
// Параметры:
//  Форма 			- см. Обработка.Ei.Форма.Форма
//  Набор 			- см. EDTКлиент_Ei.ПрочитатьСоставОбработки
//  Каталог 		- Строка - папка проекта EDT
//  ИмяОбработки 	- Строка - имя обработки в проекте, оно же имя корневого набора
//  СсылкиНаФайлы 	- Структура - ссылки на файлы из EDTКлиент_Ei.ПрочитатьСоставОбработки
Процедура ЗагрузитьПрочитанныйНабор(Форма, Набор, Каталог, ИмяОбработки, СсылкиНаФайлы) Экспорт
	ЗагрузитьВарианты(Форма,Набор,Каталог,ИмяОбработки,СсылкиНаФайлы);
	Форма.СохраненныйОбраз 		= вПолучитьСохраняемыйОбраз(Форма);
	ПослеОбновленияФС(Форма, Каталог);
	ОтслеживатьПапку(Форма, Каталог);
	ЗапомнитьПоследнийНабор(Форма, Каталог, ИмяОбработки);
КонецПроцедуры

#КонецОбласти


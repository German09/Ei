Функция ПрочитатьТекст(сИмяФайла) Экспорт
	Результат = "";
	ЧТ = Новый ЧтениеТекста(сИмяФайла);
	Результат = ЧТ.Прочитать();
	ЧТ.Закрыть();
	Возврат Результат;
КонецФункции

Функция ПолучитьИмяВременногоФайлаНастройки(сИмяФайлаНастройки) Экспорт
	Файл = Новый Файл(сИмяФайлаНастройки);
	Возврат Файл.Путь+"~"+Файл.ИмяБезРасширения+"."+РасширениеВременныйФайл();	
КонецФункции

Функция РасширениеВременныйФайл()
	Возврат "tmp";	
КонецФункции

Функция РасширениеФайл()
	Возврат "sel";	
КонецФункции		
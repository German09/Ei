#Область Сохранение


Процедура СохранитьВКаталог(Форма, Каталог)
	СтрНаборов 		= ВариантыКлиент_Ei.Получить(Форма);
	СохранитьВКаталогОбработки(Форма,СтрНаборов,Каталог);
  	
	Форма.СохраненныйОбраз	= ОбщегоНазначенияВызовСервера_Ei.Сериализовать(СтрНаборов);
	ПослеОбновленияФС(Форма, Каталог);		
	ЗапомнитьПоследнийНабор(Форма, Каталог, ИмяОбработки(Форма));
КонецПроцедуры

#Область ПроверкаПапкиСохранения

// Выбрать папку проекта EDT для сохранения набора. Папку проверяем, пока пользователь не согласится
// сохранить в нее или не откажется: в папке должен быть проект EDT, а в проекте не должно быть другой обработки
// с именем набора
// 
// Параметры:
//  Форма 				- см. Обработка.Ei.Форма.Форма
//  НачальныйКаталог 	- Строка - с какой папки начать выбор
// 
// Возвращаемое значение:
//  Строка, Неопределено - папка для сохранения; Неопределено, если пользователь отказался
Асинх Функция ВыбратьКаталогСохранения(Форма, НачальныйКаталог)
	Результат	= Неопределено;
	Каталог		= Ждать ВыбратьКаталог(НачальныйКаталог);
	Пока Не Каталог = Неопределено Цикл
		Решение = Ждать ПроверитьКаталогСохранения(Форма, Каталог);
		Если Решение = РешениеСохранить() Тогда
			Результат = Каталог;
			Прервать;
		ИначеЕсли Решение = РешениеДругаяПапка() Тогда
			Каталог = Ждать ВыбратьКаталог(Каталог);
		ИначеЕсли Решение = РешениеОтмена() Тогда
			Каталог = Неопределено;
		КонецЕсли;
		//РешениеПроверить: сменили имя набора или создали проект в EDT - проверяем ту же папку заново
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Диалог выбора папки сохранения.
// 
// Параметры:
//  НачальныйКаталог - Строка
// 
// Возвращаемое значение:
//  Строка, Неопределено - Неопределено, если выбор отменили
Асинх Функция ВыбратьКаталог(НачальныйКаталог)
	Результат				= Неопределено;
	Длг 					= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Длг.Каталог 			= НачальныйКаталог;
	Длг.Заголовок 			= "Выберите папку проекта EDT для сохранения набора";
	Длг.МножественныйВыбор 	= Ложь;
	Каталоги = Ждать Длг.ВыбратьАсинх();
	Если Не Каталоги = Неопределено Тогда
		Для Каждого Каталог ИЗ Каталоги Цикл
			Результат = Каталог;
			Прервать; //по идее будет только один
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Проверить папку перед сохранением в нее набора и при необходимости спросить пользователя, что делать
// 
// Параметры:
//  Форма 	- см. Обработка.Ei.Форма.Форма
//  Каталог - Строка - выбранная папка
// 
// Возвращаемое значение:
//  Строка - см. РешениеСохранить, РешениеПроверить, РешениеДругаяПапка, РешениеОтмена
Асинх Функция ПроверитьКаталогСохранения(Форма, Каталог)
	ИмяПроекта = Ждать EDTКлиент_Ei.ПолучитьИмяПроекта(Каталог, Ложь);
	Если Не ЗначениеЗаполнено(ИмяПроекта) Тогда
		Результат = Ждать ВопросСоздатьПроект(Каталог);
	ИначеЕсли НаборВариантовКлиент_Ei.КорневаяСтрока(Форма) = Неопределено Тогда
		Результат = РешениеСохранить(); //наборов нет - сравнивать с обработками проекта нечего
	Иначе
		Результат = Ждать ПроверитьИмяОбработки(Форма, Каталог, ИмяПроекта);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Нет проекта EDT: подсказать, как создать его в EDT, или создать файлы проекта средствами Ei,
// см. СохранитьВКаталогОбработки
// 
// Параметры:
//  Каталог - Строка
// 
// Возвращаемое значение:
//  Строка - см. ПроверитьКаталогСохранения
Асинх Функция ВопросСоздатьПроект(Каталог)
	ТекстВопроса = СтрШаблон(НСтр("ru = 'В папке %1 нет проекта EDT (файла .project).
		|
		|Набор сохраняется как внешняя обработка в проект внешних отчетов и обработок EDT. Как создать проект в EDT:
		|1. Файл - Создать - Проект внешних отчетов и обработок.
		|2. Задайте имя проекта, снимите флажок расположения по умолчанию и укажите эту папку.
		|3. Выберите базовый проект - конфигурацию, к которой относится обработка, и нажмите Готово.
		|4. Вернитесь сюда и нажмите Проверить снова.
		|
		|Либо Ei создаст файлы проекта сам. Тогда в EDT проект нужно импортировать:
		|Файл - Импорт - Общие - Существующие проекты в рабочую область.'"), Каталог);
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(РешениеПроверить(),		НСтр("ru = 'Проверить снова'"));
	Кнопки.Добавить(РешениеСохранить(),		НСтр("ru = 'Создать средствами Ei'"));
	Кнопки.Добавить(РешениеДругаяПапка(),	НСтр("ru = 'Другая папка'"));
	Кнопки.Добавить(РешениеОтмена(),		НСтр("ru = 'Отмена'"));
	Ответ = Ждать ВопросАсинх(ТекстВопроса, Кнопки, , РешениеПроверить(), НСтр("ru = 'Нет проекта EDT'"));
	Возврат РешениеИзОтвета(Ответ);
КонецФункции

// В проекте обработка с именем набора уже может быть: или это этот же набор, сохраненный раньше,
// или другой набор. Кроме того, этот же набор мог быть сохранен в проект под прежним именем:
// две обработки с одним идентификатором EDT в проект не загрузит
// 
// Параметры:
//  Форма 		- см. Обработка.Ei.Форма.Форма
//  Каталог 	- Строка - папка проекта EDT
//  ИмяПроекта 	- Строка
// 
// Возвращаемое значение:
//  Строка - см. ПроверитьКаталогСохранения
Асинх Функция ПроверитьИмяОбработки(Форма, Каталог, ИмяПроекта)
	Результат		= РешениеСохранить();
	КорневаяСтрока	= НаборВариантовКлиент_Ei.КорневаяСтрока(Форма);
	ИмяНабора		= КорневаяСтрока.ИмяНабора;
	КлючНабора		= нРег(Строка(КорневаяСтрока.КлючНастроек));
	Обработки		= Ждать ОбработкиПроекта(Каталог);
	ТезкаНабора		= Обработки.Получить(нРег(ИмяНабора));
	КопияНабора		= Неопределено;
	Для Каждого Обработка Из Обработки Цикл
		Если Обработка.Значение.Ключ = КлючНабора И Не Обработка.Значение = ТезкаНабора Тогда
			КопияНабора = Обработка.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не КопияНабора = Неопределено Тогда
		ТекстВопроса = СтрШаблон(НСтр("ru = 'Этот набор уже сохранен в проект %1 под именем %2, а сейчас называется %3.
			|Две копии одного набора EDT в проект не загрузит: у них общий идентификатор.
			|Сохранить набор под прежним именем %2?'"), ИмяПроекта, КопияНабора.Имя, ИмяНабора);
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(РешениеПроверить(),		СтрШаблон(НСтр("ru = 'Вернуть имя %1'"), КопияНабора.Имя));
		Кнопки.Добавить(РешениеДругаяПапка(),	НСтр("ru = 'Другая папка'"));
		Кнопки.Добавить(РешениеОтмена(),		НСтр("ru = 'Отмена'"));
		Результат = РешениеИзОтвета(Ждать ВопросАсинх(ТекстВопроса, Кнопки, , РешениеПроверить(), НСтр("ru = 'Набор уже есть в проекте'")));
		Если Результат = РешениеПроверить() Тогда
			Ждать ПереименоватьНабор(Форма, КорневаяСтрока, КопияНабора.Имя);
		КонецЕсли;
		
	ИначеЕсли ТезкаНабора = Неопределено Тогда
		//обработки с таким именем в проекте нет
		
	ИначеЕсли ТезкаНабора.Ключ = КлючНабора Тогда
		//обработку сохранили из этого же набора: в своей папке набор просто сохраняем, в другой - уточняем
		Если Не ОдинКаталог(Каталог, Форма.ИмяФайлаНастройки) Тогда
			ТекстВопроса = СтрШаблон(НСтр("ru = 'В проекте %1 уже есть обработка %2, сохраненная из этого набора.
				|Перезаписать ее?'"), ИмяПроекта, ТезкаНабора.Имя);
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(РешениеСохранить(),		НСтр("ru = 'Перезаписать'"));
			Кнопки.Добавить(РешениеДругаяПапка(),	НСтр("ru = 'Другая папка'"));
			Кнопки.Добавить(РешениеОтмена(),		НСтр("ru = 'Отмена'"));
			Результат = РешениеИзОтвета(Ждать ВопросАсинх(ТекстВопроса, Кнопки, , РешениеСохранить(), НСтр("ru = 'Перезапись обработки'")));
		КонецЕсли;
		
	Иначе
		ТекстВопроса = СтрШаблон(НСтр("ru = 'В проекте %1 уже есть обработка %2 из другого набора.
			|Две обработки с одним именем в проекте быть не может: сохранение заменит ее этим набором.
			|Смените имя набора, чтобы сохранить его рядом, или перезапишите обработку.'"), ИмяПроекта, ТезкаНабора.Имя);
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(РешениеПроверить(),		НСтр("ru = 'Сменить имя набора'"));
		Кнопки.Добавить(РешениеСохранить(),		НСтр("ru = 'Перезаписать'"));
		Кнопки.Добавить(РешениеДругаяПапка(),	НСтр("ru = 'Другая папка'"));
		Кнопки.Добавить(РешениеОтмена(),		НСтр("ru = 'Отмена'"));
		Результат = РешениеИзОтвета(Ждать ВопросАсинх(ТекстВопроса, Кнопки, , РешениеПроверить(), НСтр("ru = 'Обработка с таким именем уже есть'")));
		Если Результат = РешениеПроверить() Тогда
			НовоеИмя = Ждать ВвестиСтрокуАсинх(ИмяНабора, НСтр("ru = 'Новое имя набора'"), 0, Ложь);
			Если ЗначениеЗаполнено(НовоеИмя) Тогда
				Ждать ПереименоватьНабор(Форма, КорневаяСтрока, СтрЗаменить(НовоеИмя, " ", ""));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Переименовать корневой набор перед сохранением, если имя подходит
// 
// Параметры:
//  Форма 			- см. Обработка.Ei.Форма.Форма
//  КорневаяСтрока 	- ДанныеФормыЭлементДерева
//  НовоеИмя 		- Строка
// 
// Возвращаемое значение:
//  Булево - переименовали
Асинх Функция ПереименоватьНабор(Форма, КорневаяСтрока, НовоеИмя)
	Причина = НаборВариантовКлиент_Ei.ОшибкаИмениНабора(Форма, НовоеИмя);
	Если ЗначениеЗаполнено(Причина) Тогда
		Ждать ПредупреждениеАсинх(Причина, , НСтр("ru = 'Ошибка в имени набора'"));
	Иначе
		НаборВариантовКлиент_Ei.Переименовать(Форма, КорневаяСтрока, НовоеИмя);
	КонецЕсли;
	Возврат Не ЗначениеЗаполнено(Причина);
КонецФункции

// Обработки проекта EDT
// 
// Параметры:
//  Каталог - Строка - папка проекта EDT
// 
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//  	* Ключ 		- Строка - имя обработки в нижнем регистре: имена папок в Windows регистр не различают
//  	* Значение 	- Структура:
//  		** Имя 	- Строка - имя обработки
//  		** Ключ - Строка - идентификатор обработки в нижнем регистре
//  		** Файл - Строка - полный путь к .mdo обработки
Асинх Функция ОбработкиПроекта(Знач Каталог) Экспорт
	Результат			= Новый Соответствие;
	Разделитель			= ПолучитьРазделительПути();
	Каталог				= БезПоследнегоСимвола(Каталог, Разделитель);
	КаталогОбработок	= СтрШаблон("%1%2%3%2%4s", Каталог, Разделитель, ФайлыКлиентСервер_Ei.КаталогИсходников(), EDTКлиент_Ei.ВнешОбработка());
	Папки				= Ждать НайтиФайлыАсинх(КаталогОбработок, "*", Ложь);
	Для Каждого Папка Из Папки Цикл
		ФайлОбработки = Новый Файл(СтрШаблон("%1%2%3.mdo", Папка.ПолноеИмя, Разделитель, Папка.Имя));
		Если Ждать ФайлОбработки.СуществуетАсинх() Тогда
			Обработка = Новый Структура("Имя,Ключ,Файл", Папка.Имя, ИдентификаторОбработки(ФайлОбработки.ПолноеИмя), ФайлОбработки.ПолноеИмя);
			Результат.Вставить(нРег(Папка.Имя), Обработка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Идентификатор обработки - атрибут uuid корневого элемента .mdo; весь файл не читаем
// 
// Параметры:

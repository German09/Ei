// Устарела. 
// Сохранить набор с определенным именем родителя в каталог.
// 
// Параметры:
//  ПутьИсходники - Строка - Путь исходники
//  ПутьПодсистема - Строка - Путь к вложенному каталогу подсистемы
//  СтрНаборов - Структура из КлючИЗначение:
// 		* Ключ 		- Строка -
// 		* Значение 	- см. ВариантыКлиентСервер_Ei.ПолучитьВариант
//  Родитель - Строка - Имя родителя варианта, которые необходимо сохранить
//  
// Возвращаемое значение:
//  Обещание - Сохранить набор в каталог
Асинх Функция СохранитьНаборВКаталогРасширения(ПутьИсходники,ПутьПодсистема,СтрНаборов,Родитель)
	Результат = Новый Структура;	
	Для Каждого СтрНабор ИЗ СтрНаборов Цикл
		Набор 		= СтрНабор.Значение;
		Если Набор.Родитель =  Родитель Тогда
			мСостава 	= Новый Массив;	
			Результат.Вставить(Набор.Имя,мСостава);			
			//Сохранение параметров
			мСтрСохранения = Ждать ПараметрыКлиент_Ei.СохранитьВКаталог(ПутьИсходники, Набор);
			Для Каждого СтрСохранения ИЗ мСтрСохранения Цикл
				мСостава.Добавить(СтрСохранения);	
			КонецЦикла;		
			
			//Сохранение вариантов, тут поведение уже определяется настройкой каждого варианта
			мСтрСохранения = Ждать ВариантыКлиент_Ei.СохранитьВКаталог(ПутьИсходники, Набор);
			Для Каждого СтрСохранения ИЗ мСтрСохранения Цикл
				мСостава.Добавить(СтрСохранения);	
			КонецЦикла;
			
			//Сохранение вложенных
			ПутьВложеннаяПодсистема =  Ждать СоздатьКаталогАсинх(ПутьПодсистема+"\Subsystems\"+Набор.Имя);
			мВложенные	= Ждать СохранитьНаборВКаталогРасширения(ПутьИсходники,ПутьВложеннаяПодсистема,СтрНаборов,Набор.Имя);
			Для Каждого Вариант ИЗ мВложенные Цикл
				Результат.Вставить(Вариант.Ключ, Вариант.Значение);			
			КонецЦикла;	
			
			//Сохранение набора
			EDTКлиент_Ei.СоздатьМетаданныеПодсистемы(ПутьПодсистема, Набор.КлючНастроек, Набор.Имя, мСостава, СтрНаборов);			
		КонецЕсли;		
	КонецЦикла;
	Возврат Результат;		
КонецФункции

//Устарела.
Асинх Процедура СохранитьВКаталогРасширения(Форма,СтрНаборов,сИмяФайла) Экспорт
	Файл 			= Новый Файл(сИмяФайла);
	ПутьИсходники 	= Ждать СоздатьКаталогАсинх(Файл.Путь+ФайлыКлиентСервер_Ei.КаталогИсходников());
	СтрРезультат 	= Ждать СохранитьНаборВКаталогРасширения(ПутьИсходники,ПутьИсходники,СтрНаборов,Неопределено);
	Для Каждого СтрНабор ИЗ СтрНаборов Цикл
		Набор 		= СтрНабор.Значение;
		Если Набор.Родитель =  Неопределено Тогда		
			//Создаем метаданные конфигурации
			EDTКлиент_Ei.СоздатьФайлКонфигурации(ПутьИсходники, Набор.Имя, Набор.КлючНастроек, СтрРезультат, СтрНаборов);
			//Создаем файл проекта
			EDTКлиент_Ei.СоздатьФайлПроекта(Файл.Путь, Набор.Имя);	
			//Определение
			EDTКлиент_Ei.СоздатьОпределение(Форма,Файл.Путь);			
			Прервать;	
		КонецЕсли;
	КонецЦикла;
	НаборВариантовКлиент_Ei.ЗапомнитьСсылкиНаФайлы(Форма, СтрРезультат);	
КонецПроцедуры

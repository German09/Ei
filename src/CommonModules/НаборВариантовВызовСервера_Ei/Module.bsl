#Область ПрограммныйИнтерфейс
Процедура Обновить(НаборВсехВариантов) Экспорт
	ПараметрыСеанса.НаборВариантов_Ei = НаборВсехВариантов; 
КонецПроцедуры

Функция Получить() Экспорт
	Возврат ПараметрыСеанса.НаборВариантов_Ei;
КонецФункции

Функция ПолучитьОбъект(ИмяНабора) Экспорт
	ОбработкаОбъект = Обработки.ОбъектНабора_Ei.Создать();
	ОбработкаОбъект.ИмяНабора = ИмяНабора;
	Возврат ОбработкаОбъект; 	
КонецФункции

Процедура Наборы(Результат, ИмяНабора = Неопределено) Экспорт
	//тут вызов только по конкретному имени
	Если Не ИмяНабора = Неопределено Тогда
		Результат = ПолучитьОбъект(ИмяНабора);
	Иначе
		Результат = Неопределено;
	КонецЕсли;			
КонецПроцедуры

// Установить текущий набор.
// 
// Параметры:
//  Набор - см. ПолучитьТекущийНабор
Процедура УстановитьТекущийНабор(Набор) Экспорт
	ПараметрыСеанса.Набор_Ei = Набор; 
КонецПроцедуры

// Получить текущий набор.
// 
// Возвращаемое значение:
//  Строка - Получить текущий набор
Функция ПолучитьТекущийНабор() Экспорт
	Возврат ПараметрыСеанса.Набор_Ei;	
КонецФункции

//Дополняем дерево наборов, для каждого варианта добавляем 3 колонки:
//[ИмяВарианта]_Текст 		- размерность варианта
//[ИмяВарианта]_Изм			- признак изменения относительнос сохраненнного значения
//[ИмяВарианта]_Картинка	- ссылка на картинку которая будет отображаться рядом с ячейкой варианта
Процедура ДополнитьРеквизиты(Форма) Экспорт
	ДопРеквизиты = Новый Массив;	
	Для Каждого ЭлВарианта ИЗ ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
		Обработчик = ЭлВарианта.Значение;
		Имя = Обработчик.Свойства().Имя;	
		рекТекст 	= Новый РеквизитФормы(Имя+"_Текст",		Новый ОписаниеТипов("Строка"),КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента()); 
		рекИзм 		= Новый РеквизитФормы(Имя+"_Изм", 		Новый ОписаниеТипов("Булево"),КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента());
		рекКартинка = Новый РеквизитФормы(Имя+"_Картинка", 	Новый ОписаниеТипов("Строка"),КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента());
		ДопРеквизиты.Добавить(рекТекст);
		ДопРеквизиты.Добавить(рекИзм);
		ДопРеквизиты.Добавить(рекКартинка);
	КонецЦикла;
	Форма.ИзменитьРеквизиты(ДопРеквизиты);
КонецПроцедуры
#КонецОбласти	

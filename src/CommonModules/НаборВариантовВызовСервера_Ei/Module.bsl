#Область ПрограммныйИнтерфейс
// Обновляет снимок наборов в параметрах сеанса.
//
// Параметры:
//  НаборВсехВариантов - ФиксированнаяСтруктура
//  ЗапускВарианта - Строка, Неопределено - идентификатор начинающегося запуска варианта,
//                   Неопределено - не менять, см. ИсторияВызовСервера_Ei
//
Процедура Обновить(НаборВсехВариантов, ЗапускВарианта = Неопределено) Экспорт
	ПараметрыСеанса.НаборВариантов_Ei = НаборВсехВариантов; 
	Если ЗапускВарианта <> Неопределено Тогда
		ПараметрыСеанса.ЗапускВарианта_Ei = ЗапускВарианта;
	КонецЕсли;
КонецПроцедуры

Функция Получить() Экспорт
	Возврат ПараметрыСеанса.НаборВариантов_Ei;
КонецФункции

Функция ПолучитьОбъект(ИмяНабора) Экспорт
	ОбработкаОбъект = Обработки.ОбъектНабора_Ei.Создать();
	ОбработкаОбъект.ИмяНабора = ИмяНабора;
	Возврат ОбработкаОбъект; 	
КонецФункции

Процедура Наборы(Результат, ИмяНабора = Неопределено) Экспорт
	//тут вызов только по конкретному имени
	Если Не ИмяНабора = Неопределено Тогда
		Результат = ПолучитьОбъект(ИмяНабора);
	Иначе
		Результат = Неопределено;
	КонецЕсли;			
КонецПроцедуры

// Установить текущий набор.
// 
// Параметры:
//  Набор - см. ПолучитьТекущийНабор
Процедура УстановитьТекущийНабор(Набор) Экспорт
	ПараметрыСеанса.Набор_Ei = Набор; 
КонецПроцедуры

// Получить текущий набор.
// 
// Возвращаемое значение:
//  Строка - Получить текущий набор
Функция ПолучитьТекущийНабор() Экспорт
	Возврат ПараметрыСеанса.Набор_Ei;	
КонецФункции

//Дополняем дерево наборов колонками:
//[ИмяВарианта]_Изм			- для каждого варианта признак изменения относительнос сохраненнного значения
//СимволыВариантов			- значки заполненных вариантов строки текстом, см. ВариантыКлиент_Ei.СимволыВариантов
Процедура ДополнитьРеквизиты(Форма) Экспорт
	ДопРеквизиты = Новый Массив;	
	Для Каждого ЭлВарианта ИЗ ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
		Обработчик = ЭлВарианта.Значение;
		Имя = Обработчик.Свойства().Имя;	
		рекИзм 		= Новый РеквизитФормы(Имя+"_Изм", 		Новый ОписаниеТипов("Булево"),КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента());
		ДопРеквизиты.Добавить(рекИзм);
		ДопРеквизиты.Добавить(Новый РеквизитФормы(НаборВариантовКлиентСервер_Ei.ИмяРеквизитаЗаголовка(Имя), Новый ОписаниеТипов("Строка")));
	КонецЦикла;
	//закладка части варианта в правой панели, см. КонструкторКлиентСервер_Ei.ГруппаЧастейВариантов
	ДопРеквизиты.Добавить(Новый РеквизитФормы(НаборВариантовКлиентСервер_Ei.ИмяРеквизитаЗаголовка(КонструкторКлиентСервер_Ei.ИмяСтраницыЧастиВарианта()), Новый ОписаниеТипов("Строка")));
	Для Каждого Обработчик ИЗ РезультатыКлиентСерверПовтИсп_Ei.ПолучитьМассивРезультатов() Цикл
		Если ТипЗнч(Обработчик) = Тип("ОбщийМодуль") Тогда
			ДопРеквизиты.Добавить(Новый РеквизитФормы(НаборВариантовКлиентСервер_Ei.ИмяРеквизитаЗаголовка(Обработчик.Свойства().Имя), Новый ОписаниеТипов("Строка")));
		КонецЕсли;
	КонецЦикла;
	рекСимволы = Новый РеквизитФормы(НаборВариантовКлиентСервер_Ei.ИмяКолонкиСимволов(), Новый ОписаниеТипов("Строка"),
		КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента());
	ДопРеквизиты.Добавить(рекСимволы);
	Форма.ИзменитьРеквизиты(ДопРеквизиты);
	//у закладок заголовки из реквизитов: при автоматической ширине группы платформа сужает дерево наборов и параметры
	Форма.Элементы.Варианты.Ширина 			= 70;
	Форма.Элементы.ПанельРезультата.Ширина 	= 70;
КонецПроцедуры
#КонецОбласти	

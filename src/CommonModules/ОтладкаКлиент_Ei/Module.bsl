
//Функция добавляет событие в дерево отладки и заполняет колонки
//Параметры:
//	Действие			- Строка - Действие которое вызвало отладку.
//	ТипСобытия			- Строка - Тип выполняемого действия.
//	Родитель			- СтрокаДереваЗначений-  Родитель. если не указан определяем по пустому значению, дата окончания.
//Возвращаемое значение:
//	Добавленая строка ДЗ
Функция ДобавитьСобытие(Действие, ТипСобытия, Родитель, Сообщать) Экспорт 
	Форма 		=  БезопасноПолучитьФормуОтладки();
	
	Если Не ТипЗнч(Родитель) = Тип("ДанныеФормыЭлементДерева") Тогда
			//определяем родителя в которого будем добавлять
		Если Форма.НеЗавершенныеСобытия.Количество() Тогда
			Родитель = Форма.НеЗавершенныеСобытия[0].Значение;
		Иначе
			Родитель = Форма.ДеревоСообщений;
		КонецЕсли;
	КонецЕсли;
	Если Родитель = Форма.ДеревоСообщений Тогда
		ВладелецОткрыт = ?(Форма.ВладелецФормы = Неопределено,Ложь,Форма.ВладелецФормы.Открыта()); //владельца может и не быть
		Если Не Форма.РежимОтладки И ВладелецОткрыт Тогда
			Родитель.ПолучитьЭлементы().Очистить();	//очистим все дерево отладки для того чтобы не путались другие сообщения, а то оно м,б. очень большим
		КонецЕсли;	
	КонецЕсли;	
	НовоеСобытие 					= Родитель.ПолучитьЭлементы().Добавить();
	НовоеСобытие.Действие			= Действие;
	НовоеСобытие.Тип				= ТипСобытия;
	НовоеСобытие.ДатаНачала			= ТекущаяУниверсальнаяДатаВМиллисекундах();
	НовоеСобытие.Продолжительность	= 0;
	НовоеСобытие.Сообщать			= Сообщать;
	Форма.НеЗавершенныеСобытия.Вставить(0,НовоеСобытие);
	
	Возврат НовоеСобытие;
КонецФункции

//Фиксирует факт завершения события
//Параметры:
//	Событие				- СтрокаДереваЗначений - Строка обозначающее событие
//  Статус				- Строка - Определяет как завершилось событие, Ошибка,Информация,БезСтатуса
//	СообщениеОбОшибке   - Строка,ИнформацияОбОшибке - Сообщение об ошибке или другая информация 
//
Процедура ЗавершитьСобытие(Событие, Статус, СообщениеОбОшибке) Экспорт
	Форма 	= БезопасноПолучитьФормуОтладки();

	Если ТипЗнч(СообщениеОбОшибке) = Тип("ИнформацияОбОшибке") Тогда
		стрСообщениеОбОшибке	= СообщениеОбОшибке.Описание;
		Статус					= ОтладкаКлиентСервер_Ei.СтатусСообщения().Ошибка;
		Форма.cooИнфОбОшибке.Вставить(Событие,СообщениеОбОшибке);
	Иначе
		стрСообщениеОбОшибке 	= СообщениеОбОшибке;
	КонецЕсли;
	
	Событие.Статус				= Статус;
	Событие.СообщениеОбОшибке	= СтрЗаменить(стрСообщениеОбОшибке,ОтладкаКлиентСервер_Ei.ПризнакИсключения(),"");
	Событие.Продолжительность	= ТекущаяУниверсальнаяДатаВМиллисекундах()- Событие.ДатаНачала;
	
	НеЗавершенныеСобытие = Форма.НеЗавершенныеСобытия.НайтиПоЗначению(Событие);
	Если Не НеЗавершенныеСобытие = Неопределено Тогда 
		Форма.НеЗавершенныеСобытия.Удалить(НеЗавершенныеСобытие);
	КонецЕсли;	
	Если Событие.Сообщать И Не Найти(стрСообщениеОбОшибке,ОтладкаКлиентСервер_Ei.ПризнакИсключения()) Тогда
		Если ТипЗнч(СообщениеОбОшибке) = Тип("ИнформацияОбОшибке") Тогда
			ОО 			= Новый ОписаниеОповещения("ОО_ОткрытьФормуОтладки",ОтладкаКлиент_Ei,Событие.ПолучитьИдентификатор());
			Пояснение 	= КраткоеПредставлениеОшибки(СообщениеОбОшибке);
			Если ЗначениеЗаполнено(Пояснение) Тогда
				ПоказатьОповещениеПользователя(СтрПолучитьСтроку(Событие.Действие,1),ОО,Пояснение,БиблиотекаКартинок.Отладка_Ei60);
			КонецЕсли;
		Иначе
			
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

// Функция - Безопасно получает форму отладки
// 
// Возвращаемое значение:
//   -  Форма отладки
//
Функция БезопасноПолучитьФормуОтладки() Экспорт
	Если Не ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(ОбщийМодульКлиентПовтИсп_Ei.Формы(),"Отладка") Тогда
		Инициализировать();		
	КонецЕсли;
	Возврат ОбщийМодульКлиентПовтИсп_Ei.Формы().Отладка;
КонецФункции	

// Процедура - Инициализация отладки
//
// Параметры:
//  Владелец - Форма - Владелец формы
//
Процедура Инициализировать(Владелец = Неопределено) Экспорт
	ФормаОтладки = ПолучитьФорму("ОбщаяФорма.Отладка_Ei",,Владелец);
	ФормаОтладки.cooИнфОбОшибке = Новый Соответствие;
	ОбщийМодульКлиентПовтИсп_Ei.Формы().Вставить("Отладка",ФормаОтладки);		
КонецПроцедуры

Процедура ОО_ОткрытьФормуОтладки(ДопПараметр) Экспорт
	Форма = ОбщийМодульКлиентПовтИсп_Ei.Формы().Отладка;
	ОткрытьФорму(Форма,,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Если ТипЗнч(ДопПараметр) = Тип("Число") Тогда
		Форма.Элементы.ДеревоСообщений.ТекущаяСтрока = ДопПараметр; 	
	КонецЕсли;	
КонецПроцедуры	

Процедура СкрытьГруппуОшибок(Элемент) Экспорт
	Элемент.Родитель.Видимость 	= Ложь;
Конецпроцедуры 	

#Область ОшибкиИсключения

Процедура СкрытьИсключение(Форма,МенеджерОбработчиков) Экспорт
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		Обработчик = МенеджерОбработчиков.ПолучитьТекущийОбработчик(Форма,ТД);
		Если Не Обработчик = Неопределено Тогда	
			ПоказатьИсключение(Форма,Неопределено,МенеджерОбработчиков,Обработчик);
		КонецЕсли;	
	КонецЕсли;		 		
КонецПроцедуры	

Процедура ПоказатьИсключение(Форма, ИнформацияОбОшибке, МенеджерОбработчиков,Обработчик) Экспорт
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		КэшПользователяКлиентСервер_Ei.СохранитьОшибку(ТД,Форма.КэшПользователя, Обработчик.Свойства().Имя, ИнформацияОбОшибке);
		ОбновитьДекорациюОшибки(Форма,МенеджерОбработчиков,Обработчик.Свойства().Имя);
	КонецЕсли;	
КонецПроцедуры

Процедура ОбновитьДекорациюОшибки(Форма,МенеджерОбработчиков,ОбработчикИмя) Экспорт
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		ИнформацияОбОшибке 	= КэшПользователяКлиентСервер_Ei.ПолучитьОшибку(ТД,Форма.КэшПользователя,ОбработчикИмя);
		ПоказатьОшибки(Форма, МенеджерОбработчиков, ИнформацияОбОшибке);				
	КонецЕсли;		
КонецПроцедуры

Процедура ПоказатьОшибки(Форма, МенеджерОбработчиков, ИнформацияОбОшибке) Экспорт
	Декорация			= МенеджерОбработчиков.ПолучитьДекорациюОшибки(Форма);
	Если НЕ Декорация = Неопределено Тогда
		Если ИнформацияОбОшибке = Неопределено Тогда
			Декорация.Родитель.Видимость 	= Ложь;
		Иначе
			сОшибка 	= ?(ТипЗнч(ИнформацияОбОшибке) = Тип("ИнформацияОбОшибке"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке),ИнформацияОбОшибке);
			Декорация.Родитель.Видимость 	= Истина;
			Декорация.Заголовок 			= Лев(СтрЗаменить(СтрЗаменить(сОшибка,Символы.ПС,Символы.НПП)," ",Символы.НПП),100);;
			Декорация.Подсказка 			= сОшибка;				 
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
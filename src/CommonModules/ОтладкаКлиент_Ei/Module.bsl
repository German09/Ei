// Показ ошибок выполнения в форме Ei. Журнал выполнения и его просмотр см. ЖурналКлиент_Ei

#Область ПрограммныйИнтерфейс

Процедура СкрытьГруппуОшибок(Элемент) Экспорт
	Элемент.Родитель.Видимость 	= Ложь;
Конецпроцедуры 	

#Область ОшибкиИсключения

Процедура СкрытьИсключение(Форма,МенеджерОбработчиков) Экспорт
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		Обработчик = МенеджерОбработчиков.ПолучитьТекущийОбработчик(Форма,ТД);
		Если Не Обработчик = Неопределено Тогда	
			ПоказатьИсключение(Форма,Неопределено,МенеджерОбработчиков,Обработчик);
		КонецЕсли;	
	КонецЕсли;		 		
КонецПроцедуры	

Процедура ПоказатьИсключение(Форма, ИнформацияОбОшибке, МенеджерОбработчиков,Обработчик) Экспорт
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		КэшПользователяКлиентСервер_Ei.СохранитьОшибку(ТД,Форма.КэшПользователя, Обработчик.Свойства().Имя, ИнформацияОбОшибке);
		ОбновитьДекорациюОшибки(Форма,МенеджерОбработчиков,Обработчик.Свойства().Имя);
	КонецЕсли;	
КонецПроцедуры

Процедура ОбновитьДекорациюОшибки(Форма,МенеджерОбработчиков,ОбработчикИмя) Экспорт
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		ИнформацияОбОшибке 	= КэшПользователяКлиентСервер_Ei.ПолучитьОшибку(ТД,Форма.КэшПользователя,ОбработчикИмя);
		ПоказатьОшибки(Форма, МенеджерОбработчиков, ИнформацияОбОшибке);				
	КонецЕсли;		
КонецПроцедуры

Процедура ПоказатьОшибки(Форма, МенеджерОбработчиков, ИнформацияОбОшибке) Экспорт
	Декорация			= МенеджерОбработчиков.ПолучитьДекорациюОшибки(Форма);
	Если НЕ Декорация = Неопределено Тогда
		//присваиваем только при изменении: смена видимости и заголовка перестраивает форму и сбрасывает размеры областей
		Если ИнформацияОбОшибке = Неопределено Тогда
			Если Декорация.Родитель.Видимость Тогда
				Декорация.Родитель.Видимость 	= Ложь;
			КонецЕсли;
		Иначе
			сОшибка 	= ?(ТипЗнч(ИнформацияОбОшибке) = Тип("ИнформацияОбОшибке"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке),ИнформацияОбОшибке);
			Заголовок 	= Лев(СтрЗаменить(СтрЗаменить(сОшибка,Символы.ПС,Символы.НПП)," ",Символы.НПП),100);
			Если Не Декорация.Родитель.Видимость Тогда
				Декорация.Родитель.Видимость 	= Истина;
			КонецЕсли;
			Если Не Декорация.Заголовок = Заголовок Тогда
				Декорация.Заголовок 			= Заголовок;
			КонецЕсли;
			Если Не Декорация.Подсказка = сОшибка Тогда
				Декорация.Подсказка 			= сОшибка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецОбласти

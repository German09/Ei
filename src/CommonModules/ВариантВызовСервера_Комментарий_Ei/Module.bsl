Процедура ДобавитьРеквизиты(Форма, ИД) Экспорт
	Если ИД = Неопределено Тогда
		//это первичное заполнение, на этапе инициализации, тут еще нудно добавить реквизит в Девево, где будем сохранять данные
		КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,ВариантКлиентСервер_Комментарий_Ei);	
	Иначе
		ТД = Форма.ПолучитьПереопределяемыйОбъектОбработкиСервер(ИД);
		Если Не ТД = Неопределено Тогда
			ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(ВариантКлиентСервер_Комментарий_Ei,ТД);
			ДобавляемыеРеквизиты	= Новый Массив;
			ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("ФорматированныйДокумент")));
			Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
			Страница 	= КонструкторКлиентСервер_Ei.СтраницаГруппыКонтейнера(Форма,ВариантКлиентСервер_Комментарий_Ei,ИмяРеквизита);
			элФормы 	= Форма.Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), Страница);
			элФормы.Вид 				= ВидПоляФормы.ПолеФорматированногоДокумента;
			элФормы.ПутьКДанным			= ИмяРеквизита;
			элФормы.ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Нет;
			элФормы.УстановитьДействие("ПриИзменении","КомментарийПолеПриИзменении");
		КонецЕсли;
	КонецЕсли;							
КонецПроцедуры 	
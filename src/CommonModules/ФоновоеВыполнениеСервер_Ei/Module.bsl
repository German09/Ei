// Фоновое выполнение вариантов Ei на сервере: фоновое задание, которое выполняет вариант строки набора,
// и учет фоновых запусков в хранилище общих настроек - по записи на запуск, у каждого пользователя свои.
// Вариант строки у пользователя выполняется в фоне не больше одного раза одновременно; разные варианты
// одной строки (запрос и алгоритм) и разные пользователи выполняются независимо, см. КлючЗадания
// Запуск попадает в историю Ei с тем же идентификатором: при старте - выполняющимся, по завершении - с результатом,
// см. ИсторияВызовСервера_Ei.ЗаписатьФоновыйЗапуск
// Сообщения пользователю задания платформа не показывает: клиент получает их при сверке и с итогом,
// история хранит их вместе с запуском. Замер журнала выполнения хранит сеанс запуска, см. ЖурналВызовСервера_Ei
// Вызовы с клиента см. ФоновоеВыполнениеВызовСервера_Ei, клиентская часть см. ФоновоеВыполнениеКлиент_Ei
// Без @strict-types: модули вариантов вызываются динамически, записи читаются из хранилища настроек.

#Область ПрограммныйИнтерфейс

// Запускает вариант строки набора в фоновом задании. Снимок наборов для выражений параметров, Наборы() и Варианты()
// берется из параметров сеанса: перед запуском клиент обновляет его, см. ВариантыКлиент_Ei.ОбновитьВаринаты
//
// Параметры:
//  Описание - Структура:
//   * Запуск - Структура - запуск варианта с инструкцией, см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//   * КлючСтроки - Строка - КлючНастроек строки набора
//   * ИмяНабора - Строка - имя строки набора
//   * Синоним - Строка - синоним варианта
//
// Возвращаемое значение:
//  Структура:
//   * Запись - Структура, Неопределено - запись запущенного запуска, см. ДляКлиента
//   * Ошибка - Строка - почему вариант не запущен
//
Функция Запустить(Описание) Экспорт
	
	Итог = Новый Структура("Запись, Ошибка", Неопределено, "");
	Запуск = Описание.Запуск;
	
	Для Каждого Запись Из Записи() Цикл
		Если Запись.Ключ = Запуск.Ключ И Запись.Состояние = Состояния().Выполняется Тогда
			Итог.Ошибка = СтрШаблон(НСтр("ru = '%1 / %2 уже выполняется в фоне с %3'"),
				Запись.ИмяНабора, Запись.Синоним, Формат(Запись.Начало, "ДЛФ=T"));
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Итог.Ошибка) Тогда
		
		Запуск.Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Запуск.Статус = ИсторияКлиентСервер_Ei.СтатусыЗапуска().Выполняется;
		Запуск.ПредставлениеРезультата = НСтр("ru = 'Выполняется в фоне'");
		Запись = НоваяЗапись(Запуск, Описание);
		СохранитьЗапись(Запись);
		// До старта задания: завершенный запуск заменяет в истории выполняющийся, а не наоборот
		ЗаписатьВИсторию(Запуск, Неопределено, Запись);
		
		ПараметрыЗадания = Новый Массив;
		ПараметрыЗадания.Добавить(Запись.Ид);
		ПараметрыЗадания.Добавить(НаборВариантовВызовСервера_Ei.Получить());
		ПараметрыЗадания.Добавить(Запись.Адрес);
		Попытка
			ФоновыеЗадания.Выполнить("ФоновоеВыполнениеСервер_Ei.ВыполнитьЗадание", ПараметрыЗадания, КлючЗадания(Запуск.Ключ),
				СтрШаблон(НСтр("ru = 'Ei: %1 / %2'"), Описание.ИмяНабора, Описание.Синоним));
		Исключение
			Итог.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
		Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
			ПрерватьЗапуск(Запись, Состояния().Ошибка, СтрШаблон(НСтр("ru = 'Фоновое задание не запущено: %1'"), Итог.Ошибка));
			ОсвободитьАдрес(Запись);
			УдалитьЗапись(Запись.Ид);
		Иначе
			Итог.Запись = ДляКлиента(Запись);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Итог;
	
КонецФункции

// Выполняет вариант строки набора в фоновом задании, см. Запустить
// Вариант выполняется только на сервере: алгоритм не пробуется на клиенте, запрос выполняется всегда,
// в том числе когда результат строки - динамический список: фоновый результат показывается таблицей.
// Результат передается во временное хранилище сеанса запуска и записывается в историю, клиент получает уведомление.
//
// Параметры:
//  Ид - Строка - идентификатор запуска
//  Наборы - ФиксированнаяСтруктура - снимок наборов сеанса запуска, см. НаборВариантовВызовСервера_Ei.Получить
//  Адрес - Строка - адрес результата во временном хранилище сеанса запуска
//
Процедура ВыполнитьЗадание(Ид, Наборы, Адрес) Экспорт
	
	Запись = ЗагрузитьЗапись(Ид);
	Если Запись = Неопределено Или Запись.Состояние <> Состояния().Выполняется Тогда
		Возврат; // запуск остановлен до начала задания
	КонецЕсли;
	ТекущееЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Если ТекущееЗадание <> Неопределено Тогда
		Запись.Задание = Строка(ТекущееЗадание.УникальныйИдентификатор);
		СохранитьЗапись(Запись);
	КонецЕсли;
	
	Запуск = Запись.Запуск;
	НаборВариантовВызовСервера_Ei.Обновить(Наборы, Ид);
	НаборВариантовВызовСервера_Ei.УстановитьТекущийНабор(Запись.ИмяНабора);
	Замер = ЖурналКлиентСервер_Ei.НачатьЗамер(ОперацияЗамера(Запись), ЖурналКлиентСервер_Ei.ТипыОпераций().Конструктор, , , Ид, "");
	Замер.Контекст = Новый Структура;
	Замер.Контекст.Вставить("КлючСтроки", 	Запись.КлючСтроки);
	Замер.Контекст.Вставить("Вариант", 		Запись.ИмяВарианта);
	Замер.Контекст.Вставить("Запуск", 		Ид);
	// Журнал выполнения показывает замер вместе с сеансом запуска, см. ЖурналВызовСервера_Ei.ПрочитатьЗамеры
	Замер.Контекст.Вставить("СеансЗапуска", Запись.НомерСеанса);
	
	ОписаниеЗначения = Неопределено;
	ИнформацияОбОшибке = Неопределено;
	НачалоВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Вариант = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(Запись.ИмяВарианта);
		ДопПараметры = Новый Структура("Инструкция", Запуск.Инструкция);
		ОписаниеЗначения = Вариант.ВыполнитьВариант(Новый УникальныйИдентификатор, ДопПараметры, Неопределено, Неопределено);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
	КонецПопытки;
	Запуск.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВыполнения;
	
	Записанная = ЗагрузитьЗапись(Ид);
	Если Записанная = Неопределено Или Записанная.Состояние <> Состояния().Выполняется Тогда
		// Пока вариант выполнялся, запуск остановили: итог уже записан остановкой
		ЖурналКлиентСервер_Ei.ЗавершитьЗамер(Замер, , НСтр("ru = 'Выполнение остановлено'"));
		Возврат;
	КонецЕсли;
	
	Запуск.ПредставлениеРезультата = "";
	Если ИнформацияОбОшибке = Неопределено Тогда
		Запуск.Статус = ИсторияКлиентСервер_Ei.СтатусыЗапуска().Успех;
		Запись.Состояние = Состояния().Выполнено;
		Значение = ПереносимоеЗначение(ИсторияВызовСервера_Ei.ЗначениеРезультата(ОписаниеЗначения));
		Запись.ПредставлениеРезультата = ПредставлениеЗначения(Значение);
		Если ОписаниеЗначения <> Неопределено Тогда
			ПередатьРезультат(Значение, Адрес, Запись);
		КонецЕсли;
	Иначе
		Запуск.Статус = ИсторияКлиентСервер_Ei.СтатусыЗапуска().Ошибка;
		Запуск.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		Запись.Состояние = Состояния().Ошибка;
		Запись.Ошибка = Запуск.Ошибка;
	КонецЕсли;
	Запись.Длительность = Запуск.Длительность;
	// Варианты, вызванные из кода этого варианта: результаты клиент получит из их снимков в истории
	Запись.Вложенные = ВариантыВызовСервера_Ei.ВложенныеЗапуски();
	// Данные вариантов, заданные кодом: снимок наборов задания клиенту не виден
	Запись.ЗаданныеДанные = ВариантыВызовСервера_Ei.ЗаданныеДанные();
	// Сообщения задания платформа пользователю не показывает: их показывает клиент Ei и хранит история
	Запись.Сообщения = ТекстыСообщений(ПолучитьСообщенияПользователю(Ложь));
	Запуск.Вставить("Сообщения", Запись.Сообщения);
	ЗаписатьВИсторию(Запуск, ОписаниеЗначения, Запись);
	Запись.Запуск = Запуск;
	СохранитьЗапись(Запись);
	
	Если ИнформацияОбОшибке = Неопределено Тогда
		ЖурналКлиентСервер_Ei.ЗавершитьЗамер(Замер);
	Иначе
		ЖурналКлиентСервер_Ei.ЗавершитьЗамер(Замер, , ИнформацияОбОшибке);
	КонецЕсли;
	Уведомить(Запись);
	
КонецПроцедуры

// Останавливает фоновый запуск: отменяет задание и записывает запуск в историю остановленным.
// Запись запуска удаляется: остановленный запуск остается только в истории.
//
// Параметры:
//  Ид - Строка - идентификатор запуска
//
// Возвращаемое значение:
//  Структура, Неопределено - запись запуска, Неопределено - запуска уже нет, см. ДляКлиента
//
Функция Остановить(Ид) Экспорт
	
	Запись = ЗагрузитьЗапись(Ид);
	Если Запись <> Неопределено Тогда
		Если Запись.Состояние = Состояния().Выполняется Тогда
			Задание = АктивноеЗадание(Запись);
			Если Задание <> Неопределено Тогда
				Запись.Сообщения = ТекстыСообщений(Задание.ПолучитьСообщенияПользователю(Ложь));
				Задание.Отменить();
			КонецЕсли;
			ПрерватьЗапуск(Запись, Состояния().Остановлено, НСтр("ru = 'Выполнение остановлено пользователем'"));
		КонецЕсли;
		ОсвободитьАдрес(Запись);
		УдалитьЗапись(Ид);
		Запись = ДляКлиента(Запись);
	КонецЕсли;
	
	Возврат Запись;
	
КонецФункции

// Описание значения сеанса запуска для фонового задания. Задание не читает временное хранилище и кеш сеанса запуска:
// ПолучитьИзВременногоХранилища в нем дает Неопределено (проверено 2026-10-31), поэтому значение запрашивается у клиента.
//
// Параметры:
//  Описание - см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - описание с адресом в сеансе задания, время получения прежнее;
//  Неопределено - это не фоновый запуск или клиент не передал значение
//
Функция ОписаниеИзСеансаЗапуска(Описание) Экспорт
	
	Результат = Неопределено;
	ТекущееЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Запись = ?(ТекущееЗадание = Неопределено, Неопределено, ЗагрузитьЗапись(ПараметрыСеанса.ЗапускВарианта_Ei));
	Если Запись <> Неопределено Тогда
		Значение = ЗначениеИзСеансаЗапуска(Описание, Запись, ТекущееЗадание);
		Если Значение <> Неопределено Тогда
			Копия = Новый Структура(Описание);
			Копия.Ссылка = ПоместитьВоВременноеХранилище(Значение, Новый УникальныйИдентификатор);
			Результат = Новый ФиксированнаяСтруктура(Копия);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Передает фоновому заданию запрошенное значение этого сеанса, см. ЗначениеИзСеансаЗапуска
//
// Параметры:
//  Данные - Структура - данные уведомления:
//   * Ид - Строка - идентификатор запроса значения
//   * НомерСеанса - Число - сеанс запуска: значение есть только у него
//   * Описание - см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
Процедура ПередатьЗначение(Данные) Экспорт
	
	// Запроса уже нет, если задание не дождалось ответа и выполнило вариант само
	Если Данные.НомерСеанса = НомерСеансаИнформационнойБазы()
		И ХранилищеОбщихНастроек.Загрузить(КлючЗначений(), Данные.Ид) <> Неопределено Тогда
		Попытка
			Ответ = Новый ХранилищеЗначения(ПереносимоеЗначение(ИсторияВызовСервера_Ei.ЗначениеРезультата(Данные.Описание)), Новый СжатиеДанных(6));
		Исключение
			// Значение не сериализуется: пустой ответ, чтобы задание сразу выполнило вариант
			Ответ = Новый ХранилищеЗначения(Неопределено);
		КонецПопытки;
		ХранилищеОбщихНастроек.Сохранить(КлючЗначений(), Данные.Ид, Ответ);
	КонецЕсли;
	
КонецПроцедуры

// Забирает итог завершенного фонового запуска для показа в строке набора и удаляет запись запуска.
// Результат берется из временного хранилища сеанса запуска, в другом сеансе - из снимка в истории.
//
// Параметры:
//  Ид - Строка - идентификатор запуска
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор формы Ei для временного хранилища
//
// Возвращаемое значение:
//  Структура:
//   * Запись - Структура, Неопределено - запись запуска, Неопределено - запуска уже нет или он еще выполняется,
//              см. ДляКлиента
//   * ОписаниеЗначения - ФиксированнаяСтруктура, Неопределено - результат, Неопределено - результата нет,
//              см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//   * СнимокУсечен - Булево - результат взят из истории, в нем только часть строк
//
Функция ЗабратьРезультат(Ид, УникальныйИдентификатор) Экспорт
	
	Итог = Новый Структура("Запись, ОписаниеЗначения, СнимокУсечен", Неопределено, Неопределено, Ложь);
	
	Запись = ЗагрузитьЗапись(Ид);
	Если Запись <> Неопределено И Запись.Состояние <> Состояния().Выполняется Тогда
		Если Запись.Состояние = Состояния().Выполнено Тогда
			Если Запись.ЕстьРезультат И АдресДействителен(Запись) Тогда
				Итог.ОписаниеЗначения = ВариантыВызовСервера_Ei.ОписаниеРезультата(ПолучитьИзВременногоХранилища(Запись.Адрес),
					Запись.ИмяВарианта, УникальныйИдентификатор);
			Иначе
				Итог.ОписаниеЗначения = ИсторияВызовСервера_Ei.ОписаниеРезультата(Ид, УникальныйИдентификатор, Запись.ИмяВарианта);
				Итог.СнимокУсечен = СнимокУсечен(Запись);
			КонецЕсли;
		КонецЕсли;
		ОсвободитьАдрес(Запись);
		УдалитьЗапись(Ид);
		// Запись удаляется: заданные данные забрать потом будет неоткуда
		Итог.Запись = ДляКлиента(Запись, , Истина);
	КонецЕсли;
	
	Возврат Итог;
	
КонецФункции

// Данные вариантов, заданные кодом фонового запуска, см. ВариантыВызовСервера_Ei.ЗаданныеДанные
// В записях опроса и уведомлений их нет, клиент забирает их один раз, см. ДляКлиента
//
// Параметры:
//  Ид - Строка - идентификатор запуска
//
// Возвращаемое значение:
//  см. ВариантыВызовСервера_Ei.ЗаданныеДанные
//
Функция ЗаданныеДанные(Ид) Экспорт
	
	Запись = ЗагрузитьЗапись(Ид);
	Возврат ?(Запись = Неопределено, Новый Массив, Запись.ЗаданныеДанные);
	
КонецФункции

// Фоновые запуски текущего пользователя. Запуск, задание которого уже не выполняется, а итог не записан
// (задание прервано вместе с сеансом или процессом сервера), завершается ошибкой.
// Завершенные запуски старше срока хранения удаляются.
//
// Возвращаемое значение:
//  Массив из см. НоваяЗапись
//
Функция Записи() Экспорт
	
	Результат = Новый Массив;
	Устаревшие = ТекущаяДатаСеанса() - СрокХраненияЗавершенных();
	
	Для Каждого ЭлементСписка Из ХранилищеОбщихНастроек.ПолучитьСписок(КлючОбъекта()) Цикл
		Запись = ЗагрузитьЗапись(ЭлементСписка.Значение);
		Если Запись = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Запись.Состояние = Состояния().Выполняется Тогда
			Запись = ПроверитьЗадание(Запись);
		ИначеЕсли Запись.Начало < Устаревшие Тогда
			ОсвободитьАдрес(Запись);
			УдалитьЗапись(Запись.Ид);
			Запись = Неопределено;
		КонецЕсли;
		Если Запись <> Неопределено Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Запись запуска для клиента и уведомления: поля записи, кроме запуска истории с текстом инструкции,
// сколько запуск уже идет - по нему клиент считает время на закладке своими часами,
// и сообщения пользователю, которых клиент еще не показал. У выполняющегося запуска сообщения берутся
// из фонового задания: так они видны еще до завершения.
// Кроме описанных, в результате все поля записи, кроме Запуск и ЗаданныеДанные, см. НоваяЗапись:
// таблицы, заданные кодом, шли бы с каждой сверкой запусков и в уведомлении, клиент забирает их один раз, см. ЗаданныеДанные
//
// Параметры:
//  Запись - Структура - запись запуска, см. НоваяЗапись
//  ПоказаноСообщений - Число - сколько первых сообщений запуска клиент уже показал
//  СЗаданнымиДанными - Булево - передать и ЗаданныеДанные: запись забирается вместе с результатом и удаляется
//
// Возвращаемое значение:
//  Структура:
//   * Прошло - Число - миллисекунды от начала выполняющегося запуска до получения записи, у завершенного - длительность
//   * Сообщения - Массив из Строка - тексты сообщений, начиная с номера ПервоеСообщение
//   * ПервоеСообщение - Число - номер первого из переданных сообщений, с нуля
//   * ЕстьЗаданныеДанные - Булево - код запуска задал данные вариантов
//
Функция ДляКлиента(Запись, ПоказаноСообщений = 0, СЗаданнымиДанными = Ложь) Экспорт
	
	Данные = Новый Структура;
	Для Каждого Поле Из Запись Цикл
		Если Поле.Ключ <> "Запуск" И (Поле.Ключ <> "ЗаданныеДанные" Или СЗаданнымиДанными) Тогда
			Данные.Вставить(Поле.Ключ, Поле.Значение);
		КонецЕсли;
	КонецЦикла;
	ЗаданныеДанные = Неопределено;
	Данные.Вставить("ЕстьЗаданныеДанные", Запись.Свойство("ЗаданныеДанные", ЗаданныеДанные) И ЗаданныеДанные.Количество() > 0);
	
	Сообщения = Запись.Сообщения;
	Если Запись.Состояние = Состояния().Выполняется Тогда
		Данные.Вставить("Прошло", Макс(0, ТекущаяУниверсальнаяДатаВМиллисекундах() - Запись.Запуск.Начало));
		Задание = АктивноеЗадание(Запись);
		Если Задание <> Неопределено Тогда
			Сообщения = ТекстыСообщений(Задание.ПолучитьСообщенияПользователю(Ложь));
		КонецЕсли;
	Иначе
		Данные.Вставить("Прошло", Запись.Длительность);
	КонецЕсли;
	
	Новые = Новый Массив; // Массив из Строка
	Для Номер = ПоказаноСообщений По Сообщения.ВГраница() Цикл
		Новые.Добавить(Сообщения.Получить(Номер));
	КонецЦикла;
	Данные.Вставить("Сообщения", Новые);
	Данные.Вставить("ПервоеСообщение", ПоказаноСообщений);
	
	Возврат Данные;
	
КонецФункции

// Описание хода фонового запуска для уведомлений клиента, см. ПроцессыКлиентСервер_Ei.СообщитьХод
// Есть только в фоновом задании запуска, пока выполняется вариант строки самого запуска: у вложенного запуска
// свой идентификатор в ЗапускВарианта_Ei, а вариант другой строки меняет текущий набор.
//
// Возвращаемое значение:
//  - Неопределено - это не фоновый запуск
//  - Структура - описание хода:
//   * Ид - Строка - идентификатор запуска
//   * КлючСтроки - Строка - КлючНастроек строки набора
//   * ИмяНабора - Строка - имя строки набора
//   * Пользователь - Строка - имя пользователя, запустившего вариант
//   * Элемент - Строка - имя выполняющегося элемента схемы процесса, его заполняет процесс
//   * Отправлено - Число - когда отправлено последнее уведомление, универсальное время в миллисекундах
//
Функция ОписаниеХода() Экспорт
	
	Результат = Неопределено;
	Если ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание() <> Неопределено Тогда
		Запись = ЗагрузитьЗапись(ПараметрыСеанса.ЗапускВарианта_Ei);
		Если Запись <> Неопределено И Запись.Состояние = Состояния().Выполняется
			И Запись.ИмяНабора = НаборВариантовВызовСервера_Ei.ПолучитьТекущийНабор() Тогда
			Результат = Новый Структура;
			Результат.Вставить("Ид", 			Запись.Ид);
			Результат.Вставить("КлючСтроки", 	Запись.КлючСтроки);
			Результат.Вставить("ИмяНабора", 	Запись.ИмяНабора);
			Результат.Вставить("Пользователь", 	Запись.Пользователь);
			Результат.Вставить("Элемент", 		"");
			Результат.Вставить("Отправлено", 	0);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
// Уведомляет клиентские сеансы пользователя о ходе фонового запуска, уведомление обрабатывает
// ФоновоеВыполнениеКлиент_Ei.ПриХодеЗапуска. Ход только показывается: ошибка отправки выполнению не мешает,
// итог придет уведомлением о завершении.
//
// Параметры:
//  Ход - см. ОписаниеХода
//  Данные - Структура - поля уведомления, см. ПроцессыКлиентСервер_Ei.СообщитьХод
//
Процедура УведомитьОХоде(Ход, Данные) Экспорт
	
	Уведомление = Новый Структура;
	Уведомление.Вставить("Ид", 				Ход.Ид);
	Уведомление.Вставить("КлючСтроки", 		Ход.КлючСтроки);
	Уведомление.Вставить("ИмяНабора", 		Ход.ИмяНабора);
	Уведомление.Вставить("Пользователь", 	Ход.Пользователь);
	Для Каждого Поле Из Данные Цикл
		Уведомление.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;
	
	Попытка
		ЗапросыMCPСервер_Ei.УведомитьСеансыПользователя(ФоновоеВыполнениеКлиентСервер_Ei.КлючУведомленияХода(), Уведомление);
	Исключение
		Возврат; // ход не показан, итог покажет уведомление о завершении
	КонецПопытки;
	
КонецПроцедуры

// Уведомляет клиентские сеансы пользователя о варианте, вызванном из кода фонового запуска, как только он выполнен:
// его результат нужен клиенту до итога запуска, например в нем процесс показывает строку, которую обрабатывает
// «Для Каждого». Уведомление обрабатывает ФоновоеВыполнениеКлиент_Ei.ПриХодеЗапуска, результат клиент получает
// из снимка в истории, см. ФоновоеВыполнениеВызовСервера_Ei.ВложенныеЗапуски
// Уведомляет только задание запуска о вариантах, вызванных из самого запуска: у вызванных глубже в ЗапускВарианта_Ei
// не запуск задания, а вложенный запуск, их покажет итог запуска.
//
// Параметры:
//  Вложенный - см. ВариантыВызовСервера_Ei.ВложенныеЗапуски
//
Процедура УведомитьОВложенном(Вложенный) Экспорт
	
	Если ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание() = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Запись = ЗагрузитьЗапись(ПараметрыСеанса.ЗапускВарианта_Ei);
	Если Запись = Неопределено Или Запись.Состояние <> Состояния().Выполняется Тогда
		Возврат;
	КонецЕсли;
	
	// Копия через фиксированную: Новый Структура(Структура) не копирует, а создает структуру без этих полей
	ДанныеВложенного = Новый Структура(Новый ФиксированнаяСтруктура(Вложенный));
	ДанныеВложенного.ОписаниеЗначения = Неопределено; // временное хранилище задания из сеанса клиента недоступно
	
	Уведомление = Новый Структура;
	Уведомление.Вставить("Ид", 				Запись.Ид);
	Уведомление.Вставить("КлючСтроки", 		Запись.КлючСтроки);
	Уведомление.Вставить("ИмяНабора", 		Запись.ИмяНабора);
	Уведомление.Вставить("Пользователь", 	Запись.Пользователь);
	Уведомление.Вставить("Вложенный", 		ДанныеВложенного);
	
	Попытка
		ЗапросыMCPСервер_Ei.УведомитьСеансыПользователя(ФоновоеВыполнениеКлиентСервер_Ei.КлючУведомленияХода(), Уведомление);
	Исключение
		Возврат; // вложенный запуск покажет итог запуска
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Записи

// Новая запись фонового запуска.
//
// Параметры:
//  Запуск - см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//  Описание - см. Запустить.Описание
//
// Возвращаемое значение:
//  Структура:
//   * Ид - Строка - идентификатор запуска, он же запуска в истории и замера журнала выполнения
//   * Ключ - Строка - ключ истории варианта строки, см. ИсторияКлиентСервер_Ei.КлючВарианта
//   * КлючСтроки - Строка - КлючНастроек строки набора
//   * ИмяВарианта - Строка
//   * ИмяНабора - Строка - имя строки набора
//   * Синоним - Строка - синоним варианта
//   * Пользователь - Строка - имя пользователя, запустившего вариант
//   * НомерСеанса - Число - сеанс запуска: только в нем действителен Адрес
//   * Адрес - Строка - адрес результата во временном хранилище сеанса запуска
//   * Задание - Строка - уникальный идентификатор фонового задания
//   * Начало - Дата - дата сеанса запуска
//   * Состояние - Строка - см. ФоновоеВыполнениеКлиентСервер_Ei.Состояния
//   * Ошибка - Строка
//   * Предупреждение - Строка - итог записан не полностью: результат не передан или запуск не попал в историю
//   * Длительность - Число - миллисекунды выполнения варианта
//   * ЕстьРезультат - Булево - результат передан во временное хранилище
//   * ПредставлениеРезультата - Строка
//   * Сообщения - Массив из Строка - сообщения пользователю, накопленные заданием, см. ТекстыСообщений
//   * Вложенные - Массив из см. ВариантыВызовСервера_Ei.ВложенныеЗапуски - варианты, вызванные из кода этого варианта
//   * ЗаданныеДанные - см. ВариантыВызовСервера_Ei.ЗаданныеДанные - данные вариантов, заданные кодом этого варианта
//   * Запуск - Структура - запуск для истории, см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//
Функция НоваяЗапись(Запуск, Описание)
	
	Запись = Новый Структура;
	Запись.Вставить("Ид", Запуск.Ид);
	Запись.Вставить("Ключ", Запуск.Ключ);
	Запись.Вставить("КлючСтроки", Описание.КлючСтроки);
	Запись.Вставить("ИмяВарианта", Запуск.Имя);
	Запись.Вставить("ИмяНабора", Описание.ИмяНабора);
	Запись.Вставить("Синоним", Описание.Синоним);
	Запись.Вставить("Пользователь", ИмяПользователя());
	Запись.Вставить("НомерСеанса", НомерСеансаИнформационнойБазы());
	// Адрес не формы: результат не пропадает, когда форму Ei закрывают до завершения задания
	Запись.Вставить("Адрес", ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор));
	Запись.Вставить("Задание", "");
	Запись.Вставить("Начало", ТекущаяДатаСеанса());
	Запись.Вставить("Состояние", Состояния().Выполняется);
	Запись.Вставить("Ошибка", "");
	Запись.Вставить("Предупреждение", "");
	Запись.Вставить("Длительность", 0);
	Запись.Вставить("ЕстьРезультат", Ложь);
	Запись.Вставить("ПредставлениеРезультата", "");
	Запись.Вставить("Сообщения", Новый Массив);
	Запись.Вставить("Вложенные", Новый Массив);
	Запись.Вставить("ЗаданныеДанные", Новый Массив);
	Запись.Вставить("Запуск", Запуск);
	
	Возврат Запись;
	
КонецФункции

Функция ЗагрузитьЗапись(Ид)
	
	Запись = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта(), Ид);
	Если ТипЗнч(Запись) <> Тип("Структура") Тогда
		Запись = Неопределено;
	Иначе
		// Записи версий Ei без сообщений задания, вложенных запусков и заданных данных
		Если Не Запись.Свойство("Сообщения") Тогда
			Запись.Вставить("Сообщения", Новый Массив);
		КонецЕсли;
		Если Не Запись.Свойство("Вложенные") Тогда
			Запись.Вставить("Вложенные", Новый Массив);
		КонецЕсли;
		Если Не Запись.Свойство("ЗаданныеДанные") Тогда
			Запись.Вставить("ЗаданныеДанные", Новый Массив);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Запись;
	
КонецФункции

Процедура СохранитьЗапись(Запись)
	
	ХранилищеОбщихНастроек.Сохранить(КлючОбъекта(), Запись.Ид, Запись);
	
КонецПроцедуры

Процедура УдалитьЗапись(Ид)
	
	ХранилищеОбщихНастроек.Удалить(КлючОбъекта(), Ид, ИмяПользователя());
	
КонецПроцедуры

// Завершает запуск без результата: ошибкой задания или остановкой, и записывает его в историю.
//
// Параметры:
//  Запись - см. НоваяЗапись
//  Состояние - Строка - см. ФоновоеВыполнениеКлиентСервер_Ei.Состояния
//  Причина - Строка - текст ошибки запуска
//
Процедура ПрерватьЗапуск(Запись, Состояние, Причина)
	
	Запуск = Запись.Запуск;
	Запуск.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Запуск.Начало;
	Запуск.Статус = ИсторияКлиентСервер_Ei.СтатусыЗапуска().Ошибка;
	Запуск.Ошибка = Причина;
	Запуск.ПредставлениеРезультата = "";
	Запуск.Вставить("Сообщения", Запись.Сообщения);
	
	Запись.Состояние = Состояние;
	Запись.Ошибка = Причина;
	Запись.Длительность = Запуск.Длительность;
	ЗаписатьВИсторию(Запуск, Неопределено, Запись);
	Запись.Запуск = Запуск;
	СохранитьЗапись(Запись);
	
КонецПроцедуры

// Завершает ошибкой запуск, задание которого уже не выполняется, а итог не записан.
//
// Параметры:
//  Запись - Структура - запуск в состоянии Выполняется, см. НоваяЗапись
//
// Возвращаемое значение:
//  Структура, Неопределено - запись запуска, Неопределено - запись удалена, пока ее проверяли, см. НоваяЗапись
//
Функция ПроверитьЗадание(Знач Запись)
	
	Если АктивноеЗадание(Запись) = Неопределено Тогда
		// Задание могло записать итог между чтением записи и поиском задания
		Записанная = ЗагрузитьЗапись(Запись.Ид);
		Если Записанная = Неопределено Или Записанная.Состояние <> Состояния().Выполняется Тогда
			Запись = Записанная;
		Иначе
			Задание = Неопределено;
			Если ЗначениеЗаполнено(Записанная.Задание) Тогда
				Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(Записанная.Задание));
			КонецЕсли;
			Если Задание <> Неопределено Тогда
				Записанная.Сообщения = ТекстыСообщений(Задание.ПолучитьСообщенияПользователю(Ложь));
			КонецЕсли;
			ПрерватьЗапуск(Записанная, Состояния().Ошибка, ПричинаПрерывания(Задание));
			Запись = Записанная;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Запись;
	
КонецФункции

// Почему задание запуска завершилось, не записав итог.
//
// Параметры:
//  Задание - ФоновоеЗадание, Неопределено - задание запуска, Неопределено - не найдено
//
// Возвращаемое значение:
//  Строка
//
Функция ПричинаПрерывания(Задание)
	
	Причина = НСтр("ru = 'Фоновое задание прервано: завершен сеанс или процесс сервера, в котором оно выполнялось'");
	Если Задание <> Неопределено И Задание.ИнформацияОбОшибке <> Неопределено Тогда
		Причина = ОбработкаОшибок.ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
	ИначеЕсли Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
		Причина = НСтр("ru = 'Фоновое задание отменено'");
	КонецЕсли;
	
	Возврат Причина;
	
КонецФункции

// Выполняющееся фоновое задание запуска: ищется по ключу, задание выполняющегося запуска с ним одно.
//
// Параметры:
//  Запись - см. НоваяЗапись
//
// Возвращаемое значение:
//  ФоновоеЗадание, Неопределено - Неопределено, если задание не выполняется
//
Функция АктивноеЗадание(Запись)
	
	Задание = Неопределено;
	Отбор = Новый Структура("Ключ, Состояние", КлючЗадания(Запись.Ключ), СостояниеФоновогоЗадания.Активно);
	Для Каждого Найденное Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор) Цикл
		Задание = Найденное;
	КонецЦикла;
	
	Возврат Задание;
	
КонецФункции

// Ключ фонового задания: платформа не запустит второе задание с тем же ключом, пока выполняется первое.
// В ключе пользователь: один и тот же вариант строки разные пользователи выполняют независимо.
//
// Параметры:
//  КлючИстории - Строка - см. ИсторияКлиентСервер_Ei.КлючВарианта
//
// Возвращаемое значение:
//  Строка
//
Функция КлючЗадания(КлючИстории)
	
	Возврат "Ei." + ОбщегоНазначения_Ei.ХешСтроки(ИмяПользователя() + "|" + КлючИстории);
	
КонецФункции

#КонецОбласти

#Область Результат

// Значение для передачи в сеанс запуска: результат запроса, который не передается между сеансами,
// выгружается в таблицу значений, как и в снимке истории.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Произвольный
//
Функция ПереносимоеЗначение(Знач Значение)
	
	Если ТипЗнч(Значение) = Тип("РезультатЗапроса") Тогда
		Значение = Значение.Выгрузить();
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		// Пакет запроса
		Значения = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Значения.Добавить(ПереносимоеЗначение(Элемент));
		КонецЦикла;
		Значение = Значения;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Запрашивает значение у клиентского сеанса запуска уведомлением и ждет его ответ в хранилище настроек.
//
// Параметры:
//  Описание - см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//  Запись - см. НоваяЗапись
//  ТекущееЗадание - ФоновоеЗадание
//
// Возвращаемое значение:
//  Произвольный, Неопределено - см. ПереносимоеЗначение;
//  Неопределено - клиент закрыт, занят дольше срока ожидания или значения у него уже нет
//
Функция ЗначениеИзСеансаЗапуска(Описание, Запись, ТекущееЗадание)
	
	Ид = Строка(Новый УникальныйИдентификатор);
	ХранилищеОбщихНастроек.Сохранить(КлючЗначений(), Ид, Истина);
	Данные = Новый Структура("Ид, Пользователь, НомерСеанса, Описание", Ид, ИмяПользователя(), Запись.НомерСеанса, Описание);
	Попытка
		Отправлено = ЗапросыMCPСервер_Ei.УведомитьСеансыПользователя(ФоновоеВыполнениеКлиентСервер_Ei.КлючЗапросаЗначения(), Данные);
	Исключение
		Отправлено = Ложь;
	КонецПопытки;
	
	Ответ = Неопределено;
	Срок = ТекущаяУниверсальнаяДата() + ВремяОжиданияЗначения();
	Пока Отправлено И ТипЗнч(Ответ) <> Тип("ХранилищеЗначения") И ТекущаяУниверсальнаяДата() < Срок Цикл
		// Ожидание завершения самого себя - пауза без нагрузки на процессор.
		ТекущееЗадание.ОжидатьЗавершенияВыполнения(0.2);
		Ответ = ХранилищеОбщихНастроек.Загрузить(КлючЗначений(), Ид);
	КонецЦикла;
	ХранилищеОбщихНастроек.Удалить(КлючЗначений(), Ид, ИмяПользователя());
	
	Возврат ?(ТипЗнч(Ответ) = Тип("ХранилищеЗначения"), Ответ.Получить(), Неопределено);
	
КонецФункции

Процедура ПередатьРезультат(Значение, Адрес, Запись)
	
	Попытка
		ПоместитьВоВременноеХранилище(Значение, Адрес);
		Запись.ЕстьРезультат = Истина;
	Исключение
		Запись.Предупреждение = СтрШаблон(НСтр("ru = 'Результат не передан в сеанс запуска, показывается снимок из истории: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ПредставлениеЗначения(Значение)
	
	Попытка
		Представление = ОписаниеЗначенияКлиентСервер_Ei.ПолучитьПредставление(Значение);
	Исключение
		Представление = Строка(ТипЗнч(Значение));
	КонецПопытки;
	
	Возврат Лев(Представление, 300);
	
КонецФункции

Функция АдресДействителен(Запись)
	
	Возврат Запись.НомерСеанса = НомерСеансаИнформационнойБазы() И ЭтоАдресВременногоХранилища(Запись.Адрес);
	
КонецФункции

Процедура ОсвободитьАдрес(Запись)
	
	Если АдресДействителен(Запись) Тогда
		УдалитьИзВременногоХранилища(Запись.Адрес);
	КонецЕсли;
	
КонецПроцедуры

// Усечен ли снимок результата запуска в истории.
//
// Параметры:
//  Запись - см. НоваяЗапись
//
// Возвращаемое значение:
//  Булево
//
Функция СнимокУсечен(Запись)
	
	Усечен = Ложь;
	Для Каждого Запуск Из ИсторияВызовСервера_Ei.Запуски(Запись.Ключ) Цикл
		Если Запуск.Ид = Запись.Ид Тогда
			Усечен = Запуск.СнимокУсечен;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Усечен;
	
КонецФункции

#КонецОбласти

#Область ИсторияИУведомления

// Записывает запуск в историю. История не должна мешать выполнению: ошибка записи
// остается предупреждением запуска.
//
// Параметры:
//  Запуск - см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//  ОписаниеЗначения - Произвольный - результат варианта
//  Запись - см. НоваяЗапись
//
Процедура ЗаписатьВИсторию(Запуск, ОписаниеЗначения, Запись)
	
	Попытка
		ИсторияВызовСервера_Ei.ЗаписатьФоновыйЗапуск(Запуск, ОписаниеЗначения);
	Исключение
		Запись.Предупреждение = СтрШаблон(НСтр("ru = 'Запуск не записан в историю: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// Уведомляет клиентские сеансы пользователя о завершении запуска, см. ФоновоеВыполнениеКлиент_Ei.ПриЗавершенииЗапуска
//
// Параметры:
//  Запись - см. НоваяЗапись
//
Процедура Уведомить(Запись)
	
	Попытка
		ЗапросыMCPСервер_Ei.УведомитьСеансыПользователя(ФоновоеВыполнениеКлиентСервер_Ei.КлючУведомления(), ДляКлиента(Запись));
	Исключение
		// Без уведомления завершенный запуск найдет проверка открытой формы Ei, а закрытая - при открытии
		Запись.Предупреждение = СтрШаблон(НСтр("ru = 'Уведомление о завершении не отправлено: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		СохранитьЗапись(Запись);
	КонецПопытки;
	
КонецПроцедуры

Функция ОперацияЗамера(Запись)
	
	Возврат СтрШаблон(НСтр("ru = '%1 / %2 в фоне'"), Запись.ИмяНабора, Запись.Синоним) + Символы.ПС + Строка(Запись.Запуск.Инструкция);
	
КонецФункции

// Тексты сообщений пользователю фонового задания: не больше МаксимумСообщений,
// о прочих - одна строка с их количеством.
//
// Параметры:
//  Сообщения - ФиксированныйМассив из СообщениеПользователю
//  Первое - Число - номер первого сообщения, с нуля
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ТекстыСообщений(Сообщения, Первое = 0) Экспорт
	
	Тексты = Новый Массив; // Массив из Строка
	Для Номер = Первое По Сообщения.ВГраница() Цикл
		Если Тексты.Количество() = МаксимумСообщений() Тогда
			Тексты.Добавить(СтрШаблон(НСтр("ru = 'Еще сообщений: %1'"), Сообщения.Количество() - Первое - МаксимумСообщений()));
			Прервать;
		КонецЕсли;
		Тексты.Добавить(Сообщения.Получить(Номер).Текст);
	КонецЦикла;
	
	Возврат Тексты;
	
КонецФункции

#КонецОбласти

#Область Константы

Функция Состояния()
	Возврат ФоновоеВыполнениеКлиентСервер_Ei.Состояния();
КонецФункции

Функция КлючОбъекта()
	Возврат "Ei.ФоновоеВыполнение";
КонецФункции

Функция КлючЗначений()
	Возврат "Ei.ФоновоеВыполнение.Значения";
КонецФункции

// Сколько секунд задание ждет значение от клиента, дальше выполняет вариант само.
Функция ВремяОжиданияЗначения()
	Возврат 10;
КонецФункции

// Сколько секунд хранится завершенный запуск, результат которого так и не показали: неделя.
Функция СрокХраненияЗавершенных()
	Возврат 604800;
КонецФункции

// Сколько сообщений пользователю фонового запуска передается клиенту и хранится в истории.
Функция МаксимумСообщений()
	Возврат 1000;
КонецФункции

#КонецОбласти


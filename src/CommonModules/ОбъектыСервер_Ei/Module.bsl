#Область ПрограммныйИнтерфейс

// Получает объекты процесса текущего сеанса с результатами в явном виде.
//
// Параметры:
//  НачинаяС - Число - индекс первого возвращаемого объекта
//
// Возвращаемое значение:
//  Массив из Структура - объекты процесса, поля см. ОбъектыВызовСервера_Ei.ПолучитьВсе
//
Функция ПолучитьВсе(НачинаяС=0) Экспорт 
	Результат = Новый Массив;
	Индекс = 0;
	Для Каждого ФиксированныйОбъект ИЗ ОбъектыВызовСервера_Ei.ПолучитьВсе() Цикл
		Если Индекс >= НачинаяС Тогда
			ОбъектПроцесса = Новый Структура(ФиксированныйОбъект);
			ОбъектПроцесса.Результат = ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОбъектПроцесса.Результат);
			Результат.Добавить(ОбъектПроцесса);
		КонецЕсли;	  
		Индекс =  Индекс+1;	
	КонецЦикла;
	Возврат Результат;	
КонецФункции

// Преобразовывает массив объектов с результатами в явном виде в массив фиксированных структур с описанием результатов.
//
// Параметры:
//  Объекты - Массив из Структура - объекты процесса, см. ПолучитьВсе, элементы заменяются фиксированными структурами
//
Процедура Преобразовать(Объекты) Экспорт 
	Индекс 			= 0;
	Идентификатор 	= Новый УникальныйИдентификатор(); 
	Для Каждого ОбъектПроцесса ИЗ Объекты Цикл
		ОбъектПроцесса.Результат = ОписаниеЗначенияКлиентСервер_Ei.Подготовить(ОбъектПроцесса.Результат,Идентификатор);
		Объекты.Установить(Индекс,Новый ФиксированнаяСтруктура(ОбъектПроцесса));  
		Индекс =  Индекс+1;	
	КонецЦикла;
КонецПроцедуры

// Дополняет объекты процесса текущего сеанса объектами с результатами в явном виде.
//
// Параметры:
//  Дополнения 				- Массив из Структура - добавляемые объекты процесса, см. ПолучитьВсе
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор для помещения результатов во временное хранилище
//
Процедура Дополнить(Дополнения,УникальныйИдентификатор) Экспорт
	Объекты = Новый Массив(ОбъектыВызовСервера_Ei.ПолучитьВсе());	
	Для Каждого ОбъектПроцесса ИЗ Дополнения Цикл
		ОбъектПроцесса.Результат = ОписаниеЗначенияКлиентСервер_Ei.Подготовить(ОбъектПроцесса.Результат,УникальныйИдентификатор);
		Объекты.Добавить(Новый ФиксированнаяСтруктура(ОбъектПроцесса));  		
	КонецЦикла;	
	ОбъектыВызовСервера_Ei.УстановитьОбъекты(Объекты);
КонецПроцедуры		

// Коллекция «Для Каждого», строки которой меняет вложенный процесс, например Объект().ПометкаУдаления = Истина:
// таблица варианта Коллекция, которую дает выражение объекта, например Варианты("Коллекция").Данные().
// Таблица одна на все элементы: объект коллекции ссылается на нее в кэше значений, а не во временном хранилище,
// откуда каждое получение дает копию. Измененную таблицу записывает в вариант ЗаписатьИзменяемуюКоллекцию.
//
// Параметры:
//  ОбъектКоллекции - ФиксированнаяСтруктура - объект процесса с коллекцией, см. ОбъектыВызовСервера_Ei.ПолучитьВсе
//
// Возвращаемое значение:
//  - Неопределено - коллекция не таблица варианта Коллекция
//  - Структура:
//   * Объект 		- ФиксированнаяСтруктура - объект процесса с коллекцией в кэше значений
//   * ИмяНабора 	- Строка - строка набора с вариантом Коллекция
//   * Таблица 		- ТаблицаЗначений - таблица коллекции, ее строки получает вложенный процесс
//   * Исходная 	- Строка - таблица до обработки, см. ЗначениеВСтрокуВнутр
//   * Ссылка 		- УникальныйИдентификатор - адрес таблицы в кэше значений
//
Функция ИзменяемаяКоллекция(ОбъектКоллекции) Экспорт
	Перем Источник;
	ИмяКоллекции = ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя;
	ОбъектКоллекции.Свойство("Источник",Источник);
	Если ТипЗнч(Источник) <> Тип("ФиксированнаяСтруктура") Или НРег(Источник.ИмяВарианта) <> НРег(ИмяКоллекции)
		Или Не ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ОбъектКоллекции.Результат) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Таблица = ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОбъектКоллекции.Результат);
	Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Ссылка = Неопределено;
	Значение = Таблица;
	КэшПользователяКлиентСервер_Ei.Запомнить(Ссылка,Значение);
	Результат = Новый Структура;
	//без имени набора выражение берет вариант строки, в которой выполняется процесс
	Результат.Вставить("ИмяНабора",	?(ЗначениеЗаполнено(Источник.ИмяНабора),Источник.ИмяНабора,НаборВариантовВызовСервера_Ei.ПолучитьТекущийНабор()));
	Результат.Вставить("Таблица",	Таблица);
	Результат.Вставить("Исходная",	ЗначениеВСтрокуВнутр(Таблица));
	Результат.Вставить("Ссылка",	Ссылка);
	//описание то же, только значение в кэше: в параметре сеанса объектов самой таблицы нет
	Описание = Новый Структура(ОбъектКоллекции.Результат);
	Описание.Ссылка 	= Ссылка;
	Описание.Значение 	= Неопределено;
	ОбъектПроцесса = Новый Структура(ОбъектКоллекции);
	ОбъектПроцесса.Результат = Новый ФиксированнаяСтруктура(Описание);
	Результат.Вставить("Объект", Новый ФиксированнаяСтруктура(ОбъектПроцесса));
	Возврат Результат;
КонецФункции

// Возвращает таблицу изменяемой коллекции в кэш значений, если кэш сбросили. Кэш - повторно используемое значение
// (КэшПользователяКлиентСерверПовтИсп_Ei.Значения), его очищает ОбновитьПовторноИспользуемыеЗначения(), который вызывают
// обработчики записи объектов конфигурации, например Справочник.Склады.ПриЗаписи. Без возврата после записи в первой строке
// следующие строки коллекции получить нельзя: Результат("ДляКаждого")[1] - Неопределено.
//
// Параметры:
//  ИзменяемаяКоллекция - см. ИзменяемаяКоллекция
//
Процедура ВосстановитьИзменяемуюКоллекцию(ИзменяемаяКоллекция) Экспорт
	Если ИзменяемаяКоллекция = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Значения = КэшПользователяКлиентСерверПовтИсп_Ei.Значения();
	Если Значения.Получить(ИзменяемаяКоллекция.Ссылка) = Неопределено Тогда
		Значения.Вставить(ИзменяемаяКоллекция.Ссылка, ИзменяемаяКоллекция.Таблица);
	КонецЕсли;
КонецПроцедуры

// Значения строки изменяемой коллекции до ее обработки: по ним ДобавитьИзмененияСтроки находит, что поменял
// вложенный процесс, и ход процесса в фоне показывает изменения в форме, не дожидаясь конца перебора.
//
// Параметры:
//  ИзменяемаяКоллекция - см. ИзменяемаяКоллекция
//  Индекс - Число - индекс строки коллекции
//
// Возвращаемое значение:
//  Структура, Неопределено - значения по именам колонок, Неопределено - коллекция не изменяемая
//
Функция ЗначенияСтроки(ИзменяемаяКоллекция, Индекс) Экспорт
	Если ИзменяемаяКоллекция = Неопределено Или Индекс >= ИзменяемаяКоллекция.Таблица.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура;
	СтрокаКоллекции = ИзменяемаяКоллекция.Таблица.Получить(Индекс);
	Для Каждого Колонка Из ИзменяемаяКоллекция.Таблица.Колонки Цикл
		Результат.Вставить(Колонка.Имя, СтрокаКоллекции[Колонка.Имя]);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Добавляет изменения строки изменяемой коллекции после ее обработки: колонки, значения которых поменял
// вложенный процесс. Изменения уходят клиенту с уведомлением о ходе, см. ПроцессыКлиентСервер_Ei.СообщитьХод
//
// Параметры:
//  Изменения - Массив из Структура - накопленные изменения строк:
//   * Индекс - Число - индекс строки коллекции
//   * Значения - Структура - новые значения по именам колонок
//  ИзменяемаяКоллекция - см. ИзменяемаяКоллекция
//  Индекс - Число - индекс строки коллекции
//  ЗначенияДо - см. ЗначенияСтроки
//
Процедура ДобавитьИзмененияСтроки(Изменения, ИзменяемаяКоллекция, Индекс, ЗначенияДо) Экспорт
	//строки и колонки мог удалить сам процесс: такие изменения покажет итоговая запись коллекции
	Если ЗначенияДо = Неопределено Или Индекс >= ИзменяемаяКоллекция.Таблица.Количество() Тогда
		Возврат;
	КонецЕсли;
	СтрокаКоллекции = ИзменяемаяКоллекция.Таблица.Получить(Индекс);
	Значения = Новый Структура;
	Для Каждого ЗначениеДо Из ЗначенияДо Цикл
		Если ИзменяемаяКоллекция.Таблица.Колонки.Найти(ЗначениеДо.Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Значение = СтрокаКоллекции[ЗначениеДо.Ключ];
		Если Значение <> ЗначениеДо.Значение Тогда
			Значения.Вставить(ЗначениеДо.Ключ, Значение);
		КонецЕсли;
	КонецЦикла;
	Если Значения.Количество() > 0 Тогда
		Изменения.Добавить(Новый Структура("Индекс, Значения", Индекс, Значения));
	КонецЕсли;
КонецПроцедуры

// Записывает в вариант Коллекция таблицу, строки которой поменял вложенный процесс «Для Каждого»,
// как Варианты("Коллекция").Данные(Источник): форма Ei покажет ее после выполнения, см. ВариантыВызовСервера_Ei.УстановитьДанные.
// Неизмененная таблица не записывается: строка набора не становится модифицированной.
//
// Параметры:
//  ИзменяемаяКоллекция - см. ИзменяемаяКоллекция
//
Процедура ЗаписатьИзменяемуюКоллекцию(ИзменяемаяКоллекция) Экспорт
	Если ИзменяемаяКоллекция = Неопределено Тогда
		Возврат;
	КонецЕсли;
	КэшПользователяКлиентСерверПовтИсп_Ei.Значения().Удалить(ИзменяемаяКоллекция.Ссылка);
	Если ЗначениеВСтрокуВнутр(ИзменяемаяКоллекция.Таблица) <> ИзменяемаяКоллекция.Исходная Тогда
		ВариантыВызовСервера_Ei.УстановитьДанные(ИзменяемаяКоллекция.ИмяНабора,ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя,
			ИзменяемаяКоллекция.Таблица);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

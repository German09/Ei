#Область ПрограммныйИнтерфейс

// Получает объекты процесса текущего сеанса с результатами в явном виде.
//
// Параметры:
//  НачинаяС - Число - индекс первого возвращаемого объекта
//
// Возвращаемое значение:
//  Массив из Структура - объекты процесса, поля см. ОбъектыВызовСервера_Ei.ПолучитьВсе
//
Функция ПолучитьВсе(НачинаяС=0) Экспорт 
	Результат = Новый Массив;
	Индекс = 0;
	Для Каждого ФиксированныйОбъект ИЗ ОбъектыВызовСервера_Ei.ПолучитьВсе() Цикл
		Если Индекс >= НачинаяС Тогда
			ОбъектПроцесса = Новый Структура(ФиксированныйОбъект);
			ОбъектПроцесса.Результат = ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОбъектПроцесса.Результат);
			Результат.Добавить(ОбъектПроцесса);
		КонецЕсли;	  
		Индекс =  Индекс+1;	
	КонецЦикла;
	Возврат Результат;	
КонецФункции

// Преобразовывает массив объектов с результатами в явном виде в массив фиксированных структур с описанием результатов.
//
// Параметры:
//  Объекты - Массив из Структура - объекты процесса, см. ПолучитьВсе, элементы заменяются фиксированными структурами
//
Процедура Преобразовать(Объекты) Экспорт 
	Индекс 			= 0;
	Идентификатор 	= Новый УникальныйИдентификатор(); 
	Для Каждого ОбъектПроцесса ИЗ Объекты Цикл
		ОбъектПроцесса.Результат = ОписаниеЗначенияКлиентСервер_Ei.Подготовить(ОбъектПроцесса.Результат,Идентификатор);
		Объекты.Установить(Индекс,Новый ФиксированнаяСтруктура(ОбъектПроцесса));  
		Индекс =  Индекс+1;	
	КонецЦикла;
КонецПроцедуры

// Дополняет объекты процесса текущего сеанса объектами с результатами в явном виде.
//
// Параметры:
//  Дополнения 				- Массив из Структура - добавляемые объекты процесса, см. ПолучитьВсе
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор для помещения результатов во временное хранилище
//
Процедура Дополнить(Дополнения,УникальныйИдентификатор) Экспорт
	Объекты = Новый Массив(ОбъектыВызовСервера_Ei.ПолучитьВсе());	
	Для Каждого ОбъектПроцесса ИЗ Дополнения Цикл
		ОбъектПроцесса.Результат = ОписаниеЗначенияКлиентСервер_Ei.Подготовить(ОбъектПроцесса.Результат,УникальныйИдентификатор);
		Объекты.Добавить(Новый ФиксированнаяСтруктура(ОбъектПроцесса));  		
	КонецЦикла;	
	ОбъектыВызовСервера_Ei.Установить(Объекты);
КонецПроцедуры		

#КонецОбласти

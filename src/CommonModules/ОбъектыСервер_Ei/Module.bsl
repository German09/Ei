//Получем весь массив объектов в явном виде
//
Функция ПолучитьВсе(НачинаяС=0) Экспорт 
	Результат = Новый Массив;
	Индекс = 0;
	Для Каждого ФиксСтрОбъекта ИЗ ОбъектыВызовСервера_Ei.ПолучитьВсе() Цикл
		Если Индекс >= НачинаяС Тогда
			стрОбъекта = Новый Структура(ФиксСтрОбъекта);
			стрОбъекта.Результат = ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(стрОбъекта.Результат);
			Результат.Добавить(стрОбъекта);
		КонецЕсли;	  
		Индекс =  Индекс+1;	
	КонецЦикла;
	Возврат Результат;	
КонецФункции

//Преобразовываем из обычного массива с результатами в фиксированный с описанием результатов
//
Процедура Преобразовать(мОбъекты) Экспорт 
	Индекс 			= 0;
	Идентификатор 	= Новый УникальныйИдентификатор(); 
	Для Каждого СтрОбъекта ИЗ мОбъекты Цикл
		стрОбъекта.Результат = ОписаниеЗначенияКлиентСервер_Ei.Подготовить(стрОбъекта.Результат,Идентификатор);
		мОбъекты.Установить(Индекс,Новый ФиксированнаяСтруктура(стрОбъекта));  
		Индекс =  Индекс+1;	
	КонецЦикла;
КонецПроцедуры

Процедура Дополнить(мДополнения,УникальныйИдентификатор) Экспорт
	мОбъектов = Новый Массив(ОбъектыВызовСервера_Ei.ПолучитьВсе());	
	Для Каждого СтрОбъекта ИЗ мДополнения Цикл
		стрОбъекта.Результат = ОписаниеЗначенияКлиентСервер_Ei.Подготовить(стрОбъекта.Результат,УникальныйИдентификатор);
		мОбъектов.Добавить(Новый ФиксированнаяСтруктура(стрОбъекта));  		
	КонецЦикла;	
	ОбъектыВызовСервера_Ei.Установить(мОбъектов);
КонецПроцедуры		
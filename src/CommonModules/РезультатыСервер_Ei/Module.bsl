#Область ПрограммныйИнтерфейс
// Загрузить результат.
// 
// Параметры:
//  Форма 		- см. ОбщаяФорма.Ei
//  ВариантИД 	- Число
//  Очистить 	- Булево
Процедура ЗагрузитьРезультат(Форма, ВариантИД, Очистить) Экспорт
	Перем Результат;
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработкиСервер(ВариантИД);
	Если Не ТекД = Неопределено Тогда
		ОбработчикРезультата 	= РезультатыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТекД);
		ОбработчикВарианта 		= ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТекД);
		Если Не ОбработчикРезультата = Неопределено Тогда
			//ИмяРеквизита			= ОбработчикРезультата.Свойства().ИмяРеквизита;	
			КолонкиРезультата 		= Новый Массив; //см. КоллекцияВызовСервера_Ei.ПолучитьКолонки
			Если Не Очистить Тогда			 
				ВсегоСтрок 		= Неопределено;
				Результат		= ПолучитьСохраненныйРезультат(Форма,ТекД,ОбработчикВарианта,ОбработчикРезультата,ВсегоСтрок);
				ОбъемКоллекции 	= ОбработчикРезультата.ОпределитьРазмерность(Результат);
				Если ВсегоСтрок <> Неопределено Тогда
					ОбъемКоллекции = РазмерностьУсеченного(ОбъемКоллекции,ВсегоСтрок);
				КонецЕсли;
				НастройкиПользователяКлиентСервер_Ei.СохранитьРазмерность(ТекД,Форма.НастройкиПользователя,ОбработчикРезультата,ОбъемКоллекции);
				НастройкиПользователяКлиентСервер_Ei.СохранитьВсегоСтрокУсеченного(ТекД,Форма.НастройкиПользователя,ОбработчикРезультата,ВсегоСтрок);
			КонецЕсли;
			Если ОбработчикРезультата.Загрузить(Форма,ВариантИД,Результат,КолонкиРезультата) Тогда	
				ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Форма, ТекД, ОбработчикРезультата);
				КоллекцияВызовСервера_Ei.ДобавитьКолонкиВЭлемент(Форма,ВариантИД,ИмяРеквизита,ИмяРеквизита,КолонкиРезультата);
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;		
КонецПроцедуры

// Загрузить таблицу или дерево.
// 
// Параметры:ИзменитьРеквизиты
//  Форма 				- Форма
//  Результат			- ТаблицаЗначений, ДеревоЗначений -	
//  КолонкиРезультата 	- см. КоллекцияВызовСервера_Ei.ПолучитьКолонки
//  ИмяРеквизита 		- Строка
Процедура ЗагрузитьТаблицуИлиДерево(Форма,Результат,КолонкиРезультата,ИмяРеквизита) Экспорт			
	КоллекцияРеквизитыСервер_Ei.ИзменитьРеквизиты(Форма,ИмяРеквизита,Результат);				
	Если Результат.Колонки.Количество() = 0 Тогда
		//очистка: у реквизита остаются колонки прежнего результата, значение без колонок в него не загрузить
		Если ТипЗнч(Результат) = Тип("ДеревоЗначений") Тогда
			Форма[ИмяРеквизита].ПолучитьЭлементы().Очистить();
		Иначе
			Форма[ИмяРеквизита].Очистить();
		КонецЕсли;
	Иначе
		Форма.ЗначениеВРеквизитФормы(Результат,ИмяРеквизита); // переставил сюда, был в самом конце процедуры
	КонецЕсли;
	КолонкиРезультата 	= КоллекцияВызовСервера_Ei.ПолучитьКолонки(Результат);
КонецПроцедуры

// Функция - Получает сохраненный результат для строки дерева значений?
//
// Параметры:
//  сПоказателиРезультата		 - 	Структура 	- Структура данных ПоказателиРезультата создаваемая процедурой ОбщегоНазначенияКлиентСервер_Ei.ПроверитьПоказателиРезультата
//  СпособВыгрузки				 - 	Строка 		- Строковое описание типа данных итоговой коллекции
// 
// Возвращаемое значение:
//   ТаблицаЗначений, ДеревоЗначений, РезультатЗапроса, ТабличныйДокумент -
//
Функция ПолучитьСохраненныйРезультат(Форма,ТД,ОбработчикВарианта,ОбработчикРезультата,ВсегоСтрок = Неопределено) Экспорт 
	ОписаниеЗначения 	= КэшПользователяКлиентСервер_Ei.ПолучитьОписаниеРезультата(ТД,Форма.КэшПользователя,ОбработчикВарианта.Свойства().Имя); //получили в результатх значение соотвесвующее текущему
	Предел 				= НастройкиПользователяКлиентСервер_Ei.ПолучитьСтрокРезультата(Форма.НастройкиПользователя);
	Результат 			= ПолучитьРезультатПоОписанию(ОписаниеЗначения,ОбработчикРезультата,Предел,ВсегоСтрок);
	Возврат Результат; 
КонецФункции
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Функция ПолучитьРезультатПоОписанию(ОписаниеЗначения,ОбработчикРезультата,Предел,ВсегоСтрок)
	Перем Результат;
	ИмяТипа		 			= ОбработчикРезультата.Свойства().ТипРеквизита;
	ОписаниеТипаРезультата	= Новый ОписаниеТипов(ИмяТипа);
	РезультатПустой 		= ОписаниеТипаРезультата.ПривестиЗначение(Неопределено);
	Если Не ОписаниеЗначения = Неопределено Тогда
		СохраненныйРезультат	= ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОписаниеЗначения); 
		//усекаем до приведения: таблице, табличному документу и JSON не нужно обходить весь результат
		СохраненныйРезультат	= ПервыеСтроки(СохраненныйРезультат,ОбработчикРезультата,Предел,ВсегоСтрок);
		Если Не ОписаниеЗначения.ОписаниеТипов = ИмяТипа Тогда
			//нужно выполнить трансформацию значения 
			Результат 	= ОбработчикРезультата.ПривестиРезультат(СохраненныйРезультат);			
			//коллекции других типов (массив, соответствие) таблицей становятся только после приведения
			Результат 	= ПервыеСтроки(Результат,ОбработчикРезультата,Предел,ВсегоСтрок);
		Иначе
			Результат 	= СохраненныйРезультат;
		КонецЕсли;	
	Иначе
		//просто отдадим пустое значение для обнуления
		Результат 	= РезультатПустой;
	КонецЕсли;
	Возврат Результат
КонецФункции

// Первые строки результата для реквизита формы. Весь результат остается во временном хранилище:
// его показывают «Результат: ...» над панелью и динамический список запроса.
// Результат запроса с группировками для дерева не усекается: плоская выборка потеряет иерархию.
//
// Параметры:
//  Значение 				- Произвольный - сохраненный результат
//  ОбработчикРезультата 	- ОбщийМодуль
//  Предел 					- Число - 0 - без ограничения
//  ВсегоСтрок 				- Число, Неопределено - возвращаемый: строк во всем результате, если он усечен
//
// Возвращаемое значение:
//  Произвольный - значение или таблица значений его первых строк
Функция ПервыеСтроки(Значение,ОбработчикРезультата,Предел,ВсегоСтрок)
	Если Не ЗначениеЗаполнено(Предел) Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
		Если Значение.Количество() <= Предел Тогда
			Возврат Значение;
		КонецЕсли;
		ВсегоСтрок 	= Значение.Количество();
		Строки 		= Новый Массив;
		Для Индекс = 0 По Предел - 1 Цикл
			Строки.Добавить(Значение[Индекс]);
		КонецЦикла;
		Возврат Значение.Скопировать(Строки);
	ИначеЕсли ТипЗнч(Значение) = Тип("РезультатЗапроса") И ОбработчикРезультата <> РезультатДеревоКлиентСервер_Ei Тогда
		Выборка = Значение.Выбрать();
		Если Выборка.Количество() <= Предел Тогда
			Возврат Значение;
		КонецЕсли;
		ВсегоСтрок 	= Выборка.Количество();
		Таблица 	= Новый ТаблицаЗначений;
		Для Каждого Колонка Из Значение.Колонки Цикл
			Таблица.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
		КонецЦикла;
		Пока Таблица.Количество() < Предел И Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Выборка);
		КонецЦикла;
		Возврат Таблица;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Размерность на закладке результата, когда в форму загружены не все строки: «10 000 из 472 766/29».
//
// Параметры:
//  ОбъемКоллекции 	- Строка, Неопределено - размерность загруженной части, см. РезультатТаблицаВызовСервера_Ei.ОпределитьРазмерность
//  ВсегоСтрок 		- Число
//
// Возвращаемое значение:
//  Строка
Функция РазмерностьУсеченного(ОбъемКоллекции,ВсегоСтрок)
	Части = СтрРазделить(Строка(ОбъемКоллекции), "/");
	Если Части.Количество() = 2 Тогда
		Возврат СтрШаблон("%1 из %2/%3", Части[0], ВсегоСтрок, Части[1]);
	КонецЕсли;
	Возврат СтрШаблон("из %1", ВсегоСтрок);
КонецФункции
#КонецОбласти

Процедура ВывестиВКоллекециюСКД(СохраненныйРезультат, Результат) Экспорт
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(СохраненныйРезультат);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Результат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
КонецПроцедуры	

Функция ДобавитьРеквизитыКоллекции(Форма,Обработчик,ТД,ИмяРеквизита,ОписаниеТиповРеквизита) Экспорт
	ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Форма,ТД,Обработчик);
	ТаблицаФормы 	= Форма.Элементы.Найти(ИмяРеквизита); 
	Если ТаблицаФормы = Неопределено Тогда
		ДобавляемыеРеквизиты	= Новый Массив;
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизита, ОписаниеТиповРеквизита));
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		Страница 		= КонструкторКлиентСервер_Ei.СтраницаГруппыКонтейнера(Форма,Обработчик,ИмяРеквизита);
		ТаблицаФормы 	= КоллекцияВызовСервера_Ei.ПолучитьТаблицуФормы(Форма, ИмяРеквизита, ИмяРеквизита, Страница);
		Если Не ТаблицаФормы = Неопределено Тогда
		    ТаблицаФормы.ПоложениеКоманднойПанели		= ПоложениеКоманднойПанелиЭлементаФормы.Низ;
			Обработчик.ДополнитьДинамическийЭлементФормы(Форма,ТаблицаФормы);
			ТаблицаФормы.Видимость =  Истина;
		КонецЕсли;
	Иначе
		ТаблицаФормы.Видимость =  Истина;
	КонецЕсли;
	Возврат ТаблицаФормы;
КонецФункции

Процедура ДобавитьВспомогательныеЭлементы(Форма,Отработчик) Экспорт
	КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,Отработчик);	
	КонструкторКлиентСервер_Ei.ГруппаКонтейнера(Форма,Отработчик);
КонецПроцедуры	

Процедура ДобавитьРеквизиты(Форма,ОбработчикИмя,ИД) Экспорт
	Обработчик = РезультатыКлиентСерверПовтИсп_Ei.ПолучитьРезультаты().Получить(ОбработчикИмя);
	Если Не Обработчик = Неопределено Тогда
		Обработчик.ДобавитьРеквизиты(Форма,ИД);
	КонецЕсли;		
КонецПроцедуры	

Процедура ЗагрузитьРезультат(Форма, ВариантИД, Очистить) Экспорт
	Перем Результат;
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработкиСервер(ВариантИД);
	Если Не ТД = Неопределено Тогда
		ОбработчикРезультата 	= РезультатыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
		ОбработчикВарианта 		= ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
		Если Не ОбработчикРезультата = Неопределено Тогда
			//ИмяРеквизита			= ОбработчикРезультата.Свойства().ИмяРеквизита;	
			мКолонокРезультата 		= Новый Массив;
			Если Не Очистить Тогда			 
				Результат		= ПолучитьСохраненныйРезультат(Форма,ТД,ОбработчикВарианта,ОбработчикРезультата);
				ОбъемКоллекции 	= ОбработчикРезультата.ОпределитьРазмерность(Результат);
				НастройкиПользователяКлиентСервер_Ei.СохранитьРазмерность(ТД,Форма.НастройкиПользователя,ОбработчикРезультата,ОбъемКоллекции);
			КонецЕсли;
			Если ОбработчикРезультата.Загрузить(Форма,ВариантИД,Результат,мКолонокРезультата) Тогда	
				ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(ОбработчикРезультата,ТД);
				ТаблицаОткрытьВызовСервера_Ei.ДобавитьКолонкиВЭлемент(Форма,ВариантИД,ИмяРеквизита,ИмяРеквизита,мКолонокРезультата);
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;		
КонецПроцедуры

Процедура ЗагрузитьТаблицуИлиДерево(Форма,Результат,мКолонокРезультата,ИмяРеквизита) Экспорт			
	ТаблицаОткрытьВызовСервера_Ei.ДобавитьРеквизитыТЗ(Форма,ИмяРеквизита,Результат);				
	Форма.ЗначениеВРеквизитФормы(Результат,ИмяРеквизита); // переставил сюда, был в самом конце процедуры
	мКолонокРезультата 	= ВариантКоллекцияВызовСервера_Ei.ПолучитьКолонки(Результат);
КонецПроцедуры

// Функция - Получает сохраненный результат для строки дерева значений?
//
// Параметры:
//  сПоказателиРезультата		 - 	Структура 	- Структура данных ПоказателиРезультата создаваемая процедурой ОбщийМодульКлиентСервер_Ei.ПроверитьПоказателиРезультата
//  СпособВыгрузки				 - 	Строка 		- Строковое описание типа данных итоговой коллекции
// 
// Возвращаемое значение:
//   - Таблица значение, Дерево значений, Результат запроса, Табличный документ
//
Функция ПолучитьСохраненныйРезультат(Форма,ТД,ОбработчикВарианта,ОбработчикРезультата) Экспорт 
	ОписаниеЗначения 	= КэшПользователяКлиентСервер_Ei.ПолучитьОписаниеРезультата(ТД,Форма.КэшПользователя,ОбработчикВарианта.Свойства().Имя); //получили в результатх значение соотвесвующее текущему
	Результат 			= ПолучитьРезультатПоОписанию(ОписаниеЗначения,ОбработчикРезультата);
	Возврат Результат; 
КонецФункции

Функция ПолучитьРезультатПоОписанию(ОписаниеЗначения,ОбработчикРезультата)
	Перем Результат;
	ИмяТипа		 			= ОбработчикРезультата.Свойства().Имя;
	ОписаниеТипаРезультата 	= Новый ОписаниеТипов(ИмяТипа);
	РезультатПустой 		= ОписаниеТипаРезультата.ПривестиЗначение(Неопределено);
	Если Не ОписаниеЗначения = Неопределено Тогда
		СохраненныйРезультат	= ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОписаниеЗначения); 
		Если Не ОписаниеЗначения.ОписаниеТипов = ИмяТипа Тогда
			//нужно выполнить трансформацию значения 
			Результат 	= ОбработчикРезультата.ПривестиРезультат(СохраненныйРезультат);			
		Иначе
			Результат 	= СохраненныйРезультат;
		КонецЕсли;	
	Иначе
		//просто отдадим пустое значение для обнуления
		Результат 	= РезультатПустой;
	КонецЕсли;
	Возврат Результат
КонецФункции

Процедура ВывестиВКоллекециюСКД(СохраненныйРезультат, Результат) Экспорт
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(СохраненныйРезультат);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Результат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
КонецПроцедуры	

Функция  ДобавитьРеквизиты(Форма,Обработчик,ТД,ИмяРеквизита,ОписаниеТиповРеквизита) Экспорт
	ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Обработчик,ТД);
	элФормы 		= Форма.Элементы.Найти(ИмяРеквизита); 
	Если элФормы = Неопределено Тогда
		ДобавляемыеРеквизиты	= Новый Массив;
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизита, ОписаниеТиповРеквизита));
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		Страница 	= КонструкторКлиентСервер_Ei.СтраницаГруппыКонтейнера(Форма,Обработчик,ИмяРеквизита);
		элФормы 	= Форма.Элементы.Добавить(ИмяРеквизита, Тип("ТаблицаФормы"), Страница);
		элФормы.ПоложениеКоманднойПанели		= ПоложениеКоманднойПанелиЭлементаФормы.Низ;
		элФормы.ПоложениеСтрокиПоиска			= ПоложениеСтрокиПоиска.Верх;
		элФормы.ПоложениеСостоянияПросмотра		= ПоложениеСостоянияПросмотра.Верх;
		элФормы.ПоложениеУправленияПоиском		= ПоложениеУправленияПоиском.КоманднаяПанель;
	    элФормы.ПутьКДанным         			= ИмяРеквизита;
	    элФормы.УстановитьДействие("Выбор","РезультатВыбор");
		Обработчик.ДополнитьДинамическийЭлементФормы(элФормы);
	КонецЕсли;
	элФормы.Видимость =  Истина;
	Возврат элФормы;
КонецФункции

Процедура ДобавитьВспомогательныеЭлементы(Форма,Отработчик) Экспорт
	КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,Отработчик);	
	КонструкторКлиентСервер_Ei.ГруппаКонтейнера(Форма,Отработчик);
КонецПроцедуры		

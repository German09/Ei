#Область ИнтерфейсВариантов

Процедура ПриИзмененииДанных(Форма) Экспорт
	ВариантыКлиент_Ei.ПриИзмененииДанныхВариантаСРедактором(Форма,ВариантСКДКлиентСервер_Ei);	
Конецпроцедуры

Процедура ПриОтображении(Форма) Экспорт
	ВариантыКлиент_Ei.ПриОтображенииВариантаСРедактором(Форма,ВариантСКДКлиентСервер_Ei);	
Конецпроцедуры

Процедура ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
	ОтладкаКлиент_Ei.ПоказатьИсключение(Форма,ИнфоОбОшибке,ВариантыКлиентСервер_Ei,ВариантСКДКлиентСервер_Ei);
КонецПроцедуры

Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ЭлементИнструкции = ЭлементИнструкции(Форма);	
	Если Не ЭлементИнструкции = Неопределено Тогда
		ТекстМодуляКлиент_Ei.ВыделитьОшибкуВТексте(Форма,Элемент,ЭлементИнструкции);
	КонецЕСли;				
КонецПроцедуры

// Сохранить данные настройки на диск в формате EDT
// 
// Параметры:
//  Путь - Строка 	- Путь к папаке src
//  НаборИмя 		- Строка - Имя варианта набора
//  НаборКлюч 		- УникальныйИдентификатор - Ключ варината набора 
//  Данные			- ФиксированнаяСтруктура - Фиксированная структура см. ПодготовитьДанные 
Асинх Функция Сохранить(Путь, НаборИмя, НаборКлюч, Данные) Экспорт
	Перем Результат;
	Если ЗначениеЗаполнено(Данные.Инструкция) Тогда
		Результат = ФайлыКлиент_Ei.СохранитьОбщее(ВариантСКДКлиентСервер_Ei,Путь, НаборИмя, НаборКлюч, Данные);
	Иначе
		УдалитьФайлыАсинх(Путь+"\"+НаборИмя+"_"+ВариантСКДКлиентСервер_Ei.Свойства().Имя);
	КонецЕсли;
	Возврат Результат;	
КонецФункции

// Прочитать данные из файла
// 
// Параметры:
//  Путь - Строка 	- Путь к файлы с данными
// 
// Возвращаемое значение:
// 	Структура - см. ВариантСКДКлиентСервер_Ei.ПодготовитьДанные		
Функция Прочитать(Путь) Экспорт
	Результат = ОбщегоНазначенияКлиентСервер_Ei.Структурировать(ФайлыКлиент_Ei.ПрочитатьТекст(Путь));
	Возврат Результат;
КонецФункции	

#КонецОбласти

#Область ВспомогательныеПроцедуры

Процедура ОткрытьКонструкторНачало(Форма,ФормаОбработкиВыбора) Экспорт 
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
			ТекстСКД =  ВариантыКлиентСервер_Ei.ПолучитьИнструкцию(Неопределено,ВариантСКДКлиентСервер_Ei.Свойства().Имя);
			Конструктор = Новый КонструкторСхемыКомпоновкиДанных(ОбщегоНазначенияКлиентСервер_Ei.Структурировать(ТекстСКД,Новый СхемаКомпоновкиДанных));
			Конструктор.Редактировать(ФормаОбработкиВыбора);
		#Иначе
			ПоказатьПредупреждение(, НСтр("ru='Конструктор СКД можно открыть только в толстом клиенте. В тонком клиенте и веб клиенте редактирование СКД возможно только в тексте.'"));
		#КонецЕсли
	КонецЕсли;	
КонецПроцедуры

Процедура УстановитьСхему(Форма,Схема) Экспорт
	ТекстСКД = ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(Схема);
	ЭлементИнструкции = ЭлементИнструкции(Форма); 
	Если Не ЭлементИнструкции = Неопределено Тогда	
		РедакторКодаКлиент_Ei.ЗаменитьТекст(ЭлементИнструкции,ТекстСКД); 
		ПриИзменении(Форма,ЭлементИнструкции);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область Редактор_кода

Процедура ПриИзменении(Форма,Элемент) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если НЕ ТД = Неопределено Тогда
		ПараметрыКлиент_Ei.Установить(Форма);	
		ВариантСКДКлиентСервер_Ei.ЗапомнитьДанные(Форма,ТД);
		//КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
	КонецЕсли;	
КонецПроцедуры

Функция ЭлементИнструкции(Форма) Экспорт 
	Возврат Форма.Элементы.Найти("HTML_СКД");			
КонецФункции	

Процедура ПриНажатии(Форма,Элемент, ДанныеСобытия, СтандартнаяОбработка) Экспорт
	Событие=ДанныеСобытия.Event.eventData1C;
	Если Не Событие=Неопределено И Событие.event="EVENT_CONTENT_CHANGED" Тогда
		ПриИзменении(Форма,Элемент);
	Иначе		
		РедакторКодаКлиент_Ei.ПолеHTML_ПриНажатии(Форма, Элемент, ДанныеСобытия, СтандартнаяОбработка, ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

Процедура ДокументСформирован(Форма,Элемент) Экспорт
	РедакторКодаКлиент_Ei.ПолеHTML_ДокументСформирован(Форма, Элемент,"dcs_query");
	ПриИзмененииДанных(Форма); //ожидаю что это выполняется только один раз при загрузке
КонецПроцедуры

#КонецОбласти	

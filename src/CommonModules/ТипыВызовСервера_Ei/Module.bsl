#Область ПрограммныйИнтерфейс
// Все ссылки.
// 
// Параметры:
//  Ограничение - СТрока
// 
// Возвращаемое значение:
//  ОписаниеТипов - Все ссылки
Функция ВсеСсылки(Ограничение) Экспорт
	Если Не Ограничение = Неопределено Тогда
		Если нРег(Ограничение) = нРег(ОбщегоНазначенияКлиентСервер_Ei.сВнешниеИсточникиДанных()) Тогда
			Результат = Новый ОписаниеТипов();
			Для Каждого ВнешнийИстоник ИЗ ВыполнитьКлиентСервер_Ei.ВычислитьБезопасно(Ограничение) Цикл
				Результат = Новый ОписаниеТипов(Результат,ВнешнийИстоник.Таблицы.ТипВсеСсылки().Типы());		
			КонецЦикла;
			Возврат Результат;
		Иначе
			Возврат ВыполнитьКлиентСервер_Ei.ВычислитьБезопасно(Ограничение+".ТипВсеСсылки()");	
		КонецЕсли;	
	Иначе	
		Результат  	= Новый ОписаниеТипов();    
		Результат	= Новый ОписаниеТипов(Результат,Справочники.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,Перечисления.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,Документы.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,ПланыВидовХарактеристик.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,ПланыСчетов.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,ПланыВидовРасчета.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,ПланыОбмена.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,БизнесПроцессы.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,БизнесПроцессы.ТипВсеСсылкиТочекМаршрутаБизнесПроцессов().Типы());
		Результат	= Новый ОписаниеТипов(Результат,Задачи.ТипВсеСсылки().Типы());
		Для Каждого ВнешнийИстоник ИЗ ВнешниеИсточникиДанных Цикл
			Результат = Новый ОписаниеТипов(Результат,ВнешнийИстоник.Таблицы.ТипВсеСсылки().Типы());		
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Определяет, что тип ссылочный.
// 
// Параметры:
//  Тип - Тип - Тип
//  Ограничение - Строка - Ограничение
// 
// Возвращаемое значение:
//  Булево - Истина, если тип входит в см. ВсеСсылки
Функция ЭтоСсылка(Тип, Ограничение) Экспорт
	Возврат ТипыКлиентСерверПовтИсп_Ei.ВсеСсылки(Ограничение).СодержитТип(Тип);
КонецФункции

// Описание вложенной коллекции.
// 
// Параметры:
//  ВозможноОписание - ОписаниеТипов
// 
// Возвращаемое значение:
//  Булево - Описание вложенной коллекции
Функция ОписаниеВложеннойКоллекции(ВозможноОписание) Экспорт
	Описание = ТипыКлиентСервер_Ei.ПроверитьОписание(ВозможноОписание);
		Возврат Описание.СодержитТип(Тип(ТипыКлиентСервер_Ei.Универсальные().ТаблицаЗначений)) 
				ИЛИ Описание.СодержитТип(Тип(ТипыКлиентСервер_Ei.Универсальные().ДеревоЗначений));			
КонецФункции
#КонецОбласти	

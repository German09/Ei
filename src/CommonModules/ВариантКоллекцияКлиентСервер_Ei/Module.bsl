Процедура Инициализировать(Форма, Контейнер) Экспорт
	//Исключительно для команд
	ФормаРодитель 	= ПолучитьФорму("ОбщаяФорма.КоллекцияРедактор_Ei");
	НаследованиеФормКлиент_Ei.Дополнить(ФормаРодитель,Форма,Контейнер);
	Форма.ДобавитьРеквизитыВарианта(Свойства().Имя,Неопределено);
КонецПроцедуры


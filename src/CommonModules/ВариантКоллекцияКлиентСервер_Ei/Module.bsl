Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Код",			"df5193ea43ac"); //12 символьный идентификатор, необходим при сохранении настроек в формат EDT
	Результат.Вставить("Имя",			КоллекцияСтруктураКлиентСервер_Ei.РеквизитКоллекции());
	Результат.Вставить("Синоним",		"Коллекция");
	Результат.Вставить("Картинка",		БиблиотекаКартинок.Таблица_Ei);
	Результат.Вставить("Класс",			ВариантыКлиентСервер_Ei);
	Результат.Вставить("Исполнение",	Ложь); //Исполняется и выводит результат или просто возможно сохранение данных
	Возврат Результат;
КонецФункции

Функция ВыполнитьВариант(УникальныйИдентификатор,ДопПараметры,ОбработчикРезультата = Неопределено, ДанныеКлиента) Экспорт
	Возврат Неопределено;	

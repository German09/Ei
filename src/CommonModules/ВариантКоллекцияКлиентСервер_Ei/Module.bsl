Процедура ПриОтображении(Форма) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если НЕ ТД = Неопределено Тогда	
		ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(ЭтотОбъект,ТД);
		элФормы 		= Форма.Элементы.Найти(ИмяРеквизита); 
		Если элФормы = Неопределено Тогда
			Форма.ДобавитьРеквизитыВарианта(Свойства().Имя,ТД.ПолучитьИдентификатор());
		КонецЕсли;
		КонструкторКлиент_Ei.ВидимостьДинЭлементов(Форма,ЭтотОбъект,ТД);
		КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,ЭтотОбъект).Видимость = Ложь;	
	КонецЕсли;		
Конецпроцедуры


Процедура ПослеВыполнения(Форма,ДанныеКлиента) Экспорт
	Возврат;	
КонецПроцедуры	

// Подготовить данные для помещения их в параметры сеанса НаборВариантов_Ei
// 
// Параметры:
//  Форма Форма конструктора
//  Строка Строка дерева вариантов
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Подготовить данные:
// 
Функция ПодготовитьДанные(Строка) Экспорт
	Результат = Новый Структура;
	Результат.Вставить(КоллекцияСтруктураКлиентСервер_Ei.РеквизитКоллекции(),Строка[Свойства().Имя]);
	Возврат Новый ФиксированнаяСтруктура(Результат);		
КонецФункции

// Обрабатываем исходные (сырые) данные для представления объекта во встроенном языке 
// 
// Параметры:
//  ИсходныеДанные -Структура,ФиксированнаяСтруктура- Исходные данные подготовленные функцией ПодготовитьДанные() 
// 
// Возвращаемое значение:
// 	Произвольный 
Функция Данные(ИсходныеДанные) Экспорт
	Перем Результат;
	#Если Клиент Тогда
		Результат = ОписаниеЗначенияВызовСервера_Ei.ПодготовитьПоХешу(ИсходныеДанные.Коллекция);	
	#Иначе
		Результат = ОбщегоНазначенияВызовСервера_Ei.Структурировать(ИсходныеДанные.Коллекция);	
	#КонецЕсли		
	Возврат Результат;
КонецФункции	

// Загрузить данные из файла
// 
// Параметры:
//  Объект		-ДанныеФормыКоллекцияЭлементовДерева - Строка в которую грузим настройку
//  Настройка  	-ФиксированнаяСтруктура,Структура - Сохраненная настройка
//
Процедура ЗагрузитьДанные(Объект,Настройка) Экспорт
	Если ТипЗнч(Настройка) =  Тип("ФиксированнаяСтруктура") ИЛИ ТипЗнч(Настройка) =  Тип("Структура") Тогда
		Объект[Свойства().Имя]		= Настройка.Коллекция;
	КонецЕсли;	
КонецПроцедуры


#Если Клиент Тогда

// Получить размерность. Результат выводится в нименование закладки варината, вызывается при автивизации
// 
// Параметры:
//  Форма 	- ФормаКлиентскогоПриложения - Основная форма
//  ТД 		- ДанныеФормыЭлементДерева - Вариант набора
// 
// Возвращаемое значение:
// 	см. КоллекцияКлиент_Ei.ПолучитьРазмерностьКоллекции
Функция ПолучитьРазмерность(Форма,ТД) Экспорт
	ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Форма,ТД, ЭтотОбъект);
	элФормы 		= Форма.Элементы.Найти(ИмяРеквизита); 
	Если Не элФормы = Неопределено Тогда
		//Если есть элемент формы то и есть реквизит формы
		Возврат КоллекцияКлиент_Ei.ПолучитьРазмерностьКоллекции(Форма[ИмяРеквизита],элФормы);
	КонецЕсли;	
КонецФункции

Процедура ПриИзмененииДанных(Форма) Экспорт
	Возврат;
Конецпроцедуры

Процедура ПриОтображении(Форма) Экспорт
	ПараметрыКлиент_Ei.ИзменитьВидимость(Форма,Ложь);
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Обработчик = ВариантКоллекцияКлиентСервер_Ei;
	Заполнитель = КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,Обработчик);	
	Если Заполнитель.Видимость Тогда
		Заполнитель.Видимость = Ложь;
		//Исключительно для команд
		Контейнер 	= КонструкторКлиентСервер_Ei.Контейнер(Форма,Обработчик);
		ФормаРодитель 	= ПолучитьФорму("ОбщаяФорма.КоллекцияРедактор_Ei");
		НаследованиеФормКлиент_Ei.Дополнить(ФормаРодитель,Форма,Контейнер);
	КонецЕсли;	
	Если НЕ ТД = Неопределено Тогда	
		ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Форма,ТД,ЭтотОбъект);
		элФормы 		= Форма.Элементы.Найти(ИмяРеквизита);
		ИД 				= ТД.ПолучитьИдентификатор(); 
		Если элФормы = Неопределено Тогда
			Форма.ДобавитьРеквизитыВарианта(Свойства().Имя,ИД);
		КонецЕсли;
		УстановитьВидимостьВложенныхКонтейнеровКП(Форма,ИД);
		КонструкторКлиент_Ei.ВидимостьДинЭлементов(Форма,ЭтотОбъект,ТД);
		КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,ЭтотОбъект).Видимость = Ложь;	
	КонецЕсли;		
Конецпроцедуры


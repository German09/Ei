// Запрос клиентскому агенту Ei из HTTP-сеанса MCP: подтверждение кода человеком и выполнение кода на клиенте,
// а также отправка наборов вариантов для отладки в Ei пользователя и чтение отлаженных строк обратно.
// Клиентская часть агента - см. ЗапросыMCPКлиент_Ei, запись ответа - см. ЗапросыMCPВызовСервера_Ei
// Протокол - docs/client-agent-protocol.md в репозитории 1c_mcp: ключи и форматы менять только вместе с ним.

#Область ПрограммныйИнтерфейс

// Проверяет, можно ли обратиться к клиентскому агенту.
//
// Возвращаемое значение:
//  Структура:
//   * Доступен - Булево
//   * Причина - Строка - почему агент недоступен
//
Функция СостояниеАгента() Экспорт
	
	Состояние = Новый Структура("Доступен, Причина", Ложь, "");
	
	Если Не УведомленияКлиентаПоддерживаются() Тогда
		Состояние.Причина = "уведомления клиента требуют платформу " + МинимальнаяВерсияПлатформы() + " или новее";
	Иначе
		Состояние.Доступен = Истина;
	КонецЕсли;
	
	Возврат Состояние;
	
КонецФункции

// Отправляет запрос клиентскому агенту (или продолжает ожидание по ранее созданному) и ждет ответ.
//
// Параметры:
//  Описание - Структура:
//   * Код - Строка - код как его прислала модель
//   * Контекст - Строка - server, client или variants - чтение наборов вариантов, см. КонтекстЧтенияНаборов
//   * Режим - Строка - Выполнить, Вычислить или Модуль: режим ВыполнитьКлиентСервер_Ei.ВыражениеВМесте
//   * Параметры - Структура - параметры временного набора MCP по имени: ЭтоВыражение и ЗначениеПараметра
//   * ОпасныеКонструкции - Массив из Строка - найденные конструкции, для подсветки у человека
//   * Хеш - Строка - хеш кода, режима и параметров: по нему повторный вызов связывается с запросом
//   * НомераСеансов - Массив из Число - необязательно: кому отправить запрос, по умолчанию - по контексту
//   * ДанныеЗапроса - Структура - необязательно: дополнительные поля уведомления
//  ИдентификаторЗапроса - Строка - request_id прежнего вызова, пустой - создать новый запрос
//
// Возвращаемое значение:
//  Структура:
//   * Статус - Строка - answered, pending или error
//   * Идентификатор - Строка - идентификатор запроса
//   * Ответ - Структура, Неопределено - проверенный ответ агента для answered
//   * Ошибка - Строка - текст ошибки для error
//
Функция ЗапроситьРешение(Описание, ИдентификаторЗапроса) Экспорт
	
	Итог = Новый Структура;
	Итог.Вставить("Статус", 		"error");
	Итог.Вставить("Идентификатор", 	"");
	Итог.Вставить("Ответ", 			Неопределено);
	Итог.Вставить("Ошибка", 		"");
	
	Инструмент = ?(Описание.Контекст = КонтекстЧтенияНаборов(), "get_variants", "execute_code");
	Если ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		Запрос = ЗагрузитьЗапрос(ИдентификаторЗапроса);
		Если Запрос = Неопределено Тогда
			Итог.Ошибка = СтрШаблон("Запрос request_id=%1 не найден или уже закрыт. Вызовите %2 без request_id, чтобы создать новый запрос.",
				ИдентификаторЗапроса, Инструмент);
		ИначеЕсли Запрос.Хеш <> Описание.Хеш Или Запрос.Контекст <> Описание.Контекст Тогда
			Итог.Ошибка = СтрШаблон("Аргументы вызова %1 отличаются от запроса request_id=%2. Передайте те же значения без изменений или вызовите %1 без request_id.",
				Инструмент, ИдентификаторЗапроса);
		КонецЕсли;
	Иначе
		Запрос = НовыйЗапрос(Описание, Итог);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Итог.Ошибка) Тогда
		
		Итог.Идентификатор = Запрос.Идентификатор;
		Если ТекущаяУниверсальнаяДата() <= Запрос.СрокДействия Тогда
			ДождатьсяОтвета(Запрос);
		КонецЕсли;
		
		Ответ = ЗабратьОтвет(Запрос.Идентификатор);
		Если Ответ <> Неопределено Тогда
			ОшибкаПроверки = ОшибкаПроверкиОтвета(Ответ, Запрос);
			Если ЗначениеЗаполнено(ОшибкаПроверки) Тогда
				ЗакрытьЗапрос(Запрос, "Ответ не прошел проверку");
				Итог.Ошибка = ОшибкаПроверки;
			Иначе
				ЗакрытьЗапрос(Запрос, "Ответ получен");
				Итог.Статус 	= "answered";
				Итог.Ответ 		= Ответ;
			КонецЕсли;
		ИначеЕсли ТекущаяУниверсальнаяДата() > Запрос.СрокДействия Тогда
			ЗакрытьЗапрос(Запрос, "Истек срок действия");
			Итог.Ошибка = СтрШаблон("Срок действия запроса request_id=%1 истек: клиент 1С не ответил. Вызовите %2 без request_id, чтобы создать новый запрос.",
				Запрос.Идентификатор, Инструмент);
		Иначе
			Итог.Статус = "pending";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Итог;
	
КонецФункции

// Отправляет наборы вариантов во все клиентские сеансы пользователя для отладки в Ei.
// Ответа не ждет: пользователь сам выполняет варианты, строки добавляются в Ei по нажатию на оповещение,
// которое показывает обработчик ПриПолученииНаборов модуля ЗапросыMCPКлиент_Ei.
//
// Параметры:
//  Наборы - Массив из Структура - строки дерева наборов:
//   * Имя - Строка
//   * Варианты - Структура - текст по имени варианта Ei: Запрос, Алгоритм, СКД, JSON, Комментарий
//   * Параметры - Структура - параметры по имени, см. ЗапросыMCPВызовСервера_Ei.НачатьНаборЗапроса
//   * ТекущийВариант - Строка - имя варианта Ei, открытого в строке; пустая - не менять
//   * Строки - Массив из Структура - вложенные строки того же вида
//  Описание - Строка - что отлаживать, для оповещения
//  ОпасныеКонструкции - Массив из Строка - для предупреждения пользователя
//
// Возвращаемое значение:
//  Структура:
//   * Идентификатор - Строка - идентификатор отправки
//   * КоличествоСеансов - Число - в скольких сеансах показано оповещение
//   * Ошибка - Строка - почему наборы не отправлены
//
Функция ОтправитьНаборы(Наборы, Описание, ОпасныеКонструкции) Экспорт
	
	Итог = Новый Структура("Идентификатор, КоличествоСеансов, Ошибка", "", 0, "");
	
	НомераСеансов = КлиентскиеСеансыПользователя(Ложь);
	Если НомераСеансов.Количество() = 0 Тогда
		Итог.Ошибка = СтрШаблон("Нет открытых клиентских сеансов пользователя %1: наборы некому показать."
			+ " Запустите клиент 1С (тонкий, толстый или веб) под этим пользователем.", ПредставлениеПользователя());
	Иначе
		
		Создан = ТекущаяУниверсальнаяДата();
		
		ДанныеУведомления = Новый Структура;
		ДанныеУведомления.Вставить("ВерсияПротокола", 		ВерсияПротокола());
		ДанныеУведомления.Вставить("Идентификатор", 		Строка(Новый УникальныйИдентификатор));
		ДанныеУведомления.Вставить("Пользователь", 			ИмяПользователя());
		ДанныеУведомления.Вставить("Создан", 				Создан);
		ДанныеУведомления.Вставить("СрокДействия", 			Создан + СрокДействияНаборов());
		ДанныеУведомления.Вставить("Описание", 				Описание);
		ДанныеУведомления.Вставить("Наборы", 				Наборы);
		ДанныеУведомления.Вставить("ОпасныеКонструкции", 	ОпасныеКонструкции);
		
		Попытка
			ОтправитьУведомлениеКлиенту(КлючУведомленияНаборы(), ДанныеУведомления, НомераСеансов);
			Итог.Идентификатор 		= ДанныеУведомления.Идентификатор;
			Итог.КоличествоСеансов 	= НомераСеансов.Количество();
		Исключение
			Итог.Ошибка = "Не удалось отправить уведомление клиентскому агенту Ei: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
		Если Не ЗначениеЗаполнено(Итог.Ошибка) Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Информация, , ,
				СтрШаблон("Наборы вариантов отправлены в Ei для отладки%1Идентификатор: %2%1Описание: %3%1Опасные конструкции: %4",
					Символы.ПС, ДанныеУведомления.Идентификатор, Описание, СтрСоединить(ОпасныеКонструкции, ", ")));
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Итог;
	
КонецФункции

// Запоминает ключи строк, добавленных в Ei, и сеанс, в котором их добавили: по ним get_variants найдет строки,
// в том числе после сохранения набора и перезапуска клиента - КлючНастроек строки сохраняется в файлах набора.
//
// Параметры:
//  Идентификатор - Строка - идентификатор отправки наборов, sets_id
//  НомерСеанса - Число - сеанс, в котором строки добавлены
//  КлючиСтрок - Массив из Строка - КлючНастроек добавленных строк всех уровней, родитель раньше вложенных
//
Процедура ЗарегистрироватьНаборы(Идентификатор, НомерСеанса, КлючиСтрок) Экспорт
	
	УдалитьУстаревшиеНаборы();
	Запись = Новый Структура("НомерСеанса, Добавлены, КлючиСтрок", НомерСеанса, ТекущаяУниверсальнаяДата(), КлючиСтрок);
	ХранилищеОбщихНастроек.Сохранить(КлючДобавленныхНаборов(), Идентификатор, Запись);
	
КонецПроцедуры

// Какие строки читать для get_variants и в каком клиентском сеансе.
// Сеанс - тот, где наборы добавлены, а если он завершен - последний начатый клиентский сеанс пользователя:
// после сохранения набора и перезапуска клиента строки находятся по тем же ключам.
//
// Параметры:
//  Идентификатор - Строка - sets_id; пустой - наборы, добавленные последними
//  ВсеНаборы - Булево - при пустом Идентификаторе взять строки всех запомненных наборов, для отбора по именам
//
// Возвращаемое значение:
//  Структура:
//   * НомерСеанса - Число - 0, если читать негде
//   * КлючиСтрок - Массив из Строка - КлючНастроек строк, родитель раньше вложенных
//   * Ошибка - Строка - почему читать негде
//
Функция НаборыДляЧтения(Идентификатор, ВсеНаборы) Экспорт
	
	Итог = Новый Структура("НомерСеанса, КлючиСтрок, Ошибка", 0, Новый Массив, "");
	
	Последняя = Неопределено;
	Для Каждого Запись Из ЗаписиДобавленныхНаборов() Цикл
		Если ЗначениеЗаполнено(Идентификатор) И Запись.Идентификатор <> Идентификатор Тогда
			Продолжить;
		КонецЕсли;
		Последняя = Запись;
		Если ВсеНаборы И Не ЗначениеЗаполнено(Идентификатор) Тогда
			Для Каждого Ключ Из Запись.КлючиСтрок Цикл
				Итог.КлючиСтрок.Добавить(Ключ);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Если Последняя = Неопределено И ЗначениеЗаполнено(Идентификатор) Тогда
		Итог.Ошибка = СтрШаблон("Наборы sets_id=%1 еще не добавлены в Ei: пользователь не нажал на оповещение о них, или срок их хранения истек", Идентификатор);
	ИначеЕсли Последняя = Неопределено Тогда
		Итог.Ошибка = "Наборы create_variants еще не добавлялись в Ei, или срок их хранения истек";
	Иначе
		Если Итог.КлючиСтрок.Количество() = 0 Тогда
			Итог.КлючиСтрок = Последняя.КлючиСтрок;
		КонецЕсли;
		Если КлиентскиеСеансыПользователя(Ложь).Найти(Последняя.НомерСеанса) <> Неопределено Тогда
			Итог.НомерСеанса = Последняя.НомерСеанса;
		Иначе
			Для Каждого НомерСеанса Из КлиентскиеСеансыПользователя(Истина) Цикл
				Итог.НомерСеанса = НомерСеанса;
			КонецЦикла;
		КонецЕсли;
		Если Итог.НомерСеанса = 0 Тогда
			Итог.Ошибка = СтрШаблон("Нет открытых клиентских сеансов пользователя %1: строки наборов негде прочитать."
				+ " Запустите клиент 1С и откройте в Ei сохраненный набор с этими строками.", ПредставлениеПользователя());
		КонецЕсли;
	КонецЕсли;
	
	Возврат Итог;
	
КонецФункции

// Контекст запроса клиентскому агенту на чтение строк наборов из Ei, см. ЗапроситьРешение
//
// Возвращаемое значение:
//  Строка
//
Функция КонтекстЧтенияНаборов() Экспорт
	
	Возврат "variants";
	
КонецФункции

// Ждет в фоновом задании, пока агент не запишет ответ или не наступит срок.
// Вызывается только из ДождатьсяОтвета.
//
// Параметры:
//  Идентификатор - Строка - идентификатор запроса
//  Срок - Дата - универсальное время окончания ожидания
//
Процедура ОжидатьОтветВФоне(Идентификатор, Срок) Экспорт
	
	ТекущееЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Если ТекущееЗадание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Пока Не ОтветЕсть(Идентификатор) И ТекущаяУниверсальнаяДата() < Срок Цикл
		// Ожидание завершения самого себя - пауза без нагрузки на процессор.
		ТекущееЗадание.ОжидатьЗавершенияВыполнения(ИнтервалОпросаОтвета());
	КонецЦикла;
	
КонецПроцедуры

// SHA-256 строки в UTF-8, hex.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция Хеш(Текст) Экспорт
	
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь));
	
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
	
КонецФункции

// Сколько секунд один вызов execute_code ждет ответ, дальше - status=pending_approval.
//
// Возвращаемое значение:
//  Число
//
Функция ВремяОжиданияОтвета() Экспорт
	
	Возврат 40;
	
КонецФункции

// Отправляет уведомление клиента во все интерактивные клиентские сеансы текущего пользователя.
// Нужно и вне MCP: о завершении фонового выполнения варианта, см. ФоновоеВыполнениеСервер_Ei
//
// Параметры:
//  Ключ - Строка - ключ уведомления, на который подписан клиент
//  Данные - Произвольный - данные уведомления
//
// Возвращаемое значение:
//  Булево - уведомление отправлено хотя бы в один сеанс
//
Функция УведомитьСеансыПользователя(Ключ, Данные) Экспорт
	
	Отправлено = Ложь;
	Если УведомленияКлиентаПоддерживаются() Тогда
		НомераСеансов = КлиентскиеСеансыПользователя(Ложь);
		Если НомераСеансов.Количество() > 0 Тогда
			ОтправитьУведомлениеКлиенту(Ключ, Данные, НомераСеансов);
			Отправлено = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Отправлено;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Запросы

Функция НовыйЗапрос(Описание, Итог)
	
	Запрос = Неопределено;
	УдалитьУстаревшиеЗапросы();
	
	НомераСеансов = Неопределено;
	Если Не Описание.Свойство("НомераСеансов", НомераСеансов) Тогда
		НомераСеансов = КлиентскиеСеансыПользователя(Описание.Контекст = "client");
	КонецЕсли;
	Если НомераСеансов.Количество() = 0 Тогда
		Итог.Ошибка = СтрШаблон("Нет открытых клиентских сеансов пользователя %1 %2: запрос некому показать."
			+ " Запустите клиент 1С (тонкий, толстый или веб) под этим пользователем.",
			ПредставлениеПользователя(), НазначениеЗапроса(Описание));
	Иначе
		
		Создан = ТекущаяУниверсальнаяДата();
		
		Запрос = Новый Структура;
		Запрос.Вставить("ВерсияПротокола", 			ВерсияПротокола());
		Запрос.Вставить("Идентификатор", 			Строка(Новый УникальныйИдентификатор));
		Запрос.Вставить("Пользователь", 			ИмяПользователя());
		Запрос.Вставить("Контекст", 				Описание.Контекст);
		Запрос.Вставить("Режим", 					Описание.Режим);
		Запрос.Вставить("Хеш", 						Описание.Хеш);
		Запрос.Вставить("ОпасныеКонструкции", 		Описание.ОпасныеКонструкции);
		Запрос.Вставить("ТребуетсяПодтверждение", 	Описание.Контекст = "server" Или Описание.ОпасныеКонструкции.Количество() > 0);
		Запрос.Вставить("Создан", 					Создан);
		Запрос.Вставить("СрокДействия", 			Создан + СрокДействияЗапроса());
		// Агент ставит таймаут формы подтверждения меньше этого времени, чтобы отказ по таймауту успел в тот же вызов
		Запрос.Вставить("ВремяОжидания", 			ВремяОжиданияОтвета());
		Запрос.Вставить("НомераСеансов", 			НомераСеансов);
		
		ДанныеУведомления = Новый Структура;
		Для Каждого КлючИЗначение Из Запрос Цикл
			ДанныеУведомления.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		ДанныеУведомления.Удалить("НомераСеансов");
		ДанныеУведомления.Вставить("Код", 			Описание.Код);
		ДанныеУведомления.Вставить("Параметры", 	Описание.Параметры);
		ДанныеЗапроса = Неопределено;
		Если Описание.Свойство("ДанныеЗапроса", ДанныеЗапроса) Тогда
			Для Каждого КлючИЗначение Из ДанныеЗапроса Цикл
				ДанныеУведомления.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЦикла;
		КонецЕсли;
		// Чтение наборов - запрос Ei, а не протокола 1c_mcp: у него свой ключ уведомления
		КлючУведомления = ?(Описание.Контекст = КонтекстЧтенияНаборов(), КлючУведомленияЧтениеНаборов(), КлючУведомленияЗапрос());
		
		ХранилищеОбщихНастроек.Сохранить(КлючЗапросов(), Запрос.Идентификатор, Запрос);
		Попытка
			ОтправитьУведомлениеКлиенту(КлючУведомления, ДанныеУведомления, НомераСеансов);
		Исключение
			ХранилищеОбщихНастроек.Удалить(КлючЗапросов(), Запрос.Идентификатор, ИмяПользователя());
			Итог.Ошибка = "Не удалось отправить уведомление клиентскому агенту Ei: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

// Пользователь, в чьих клиентских сеансах ищется агент: имя входа и полное имя, если они отличаются.
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеПользователя()
	
	Имя 		= ИмяПользователя();
	ПолноеИмя 	= ПолноеИмяПользователя();
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Представление = """<пользователь не задан>""";
	ИначеЕсли ЗначениеЗаполнено(ПолноеИмя) И ПолноеИмя <> Имя Тогда
		Представление = СтрШаблон("""%1"" (%2)", Имя, ПолноеИмя);
	Иначе
		Представление = СтрШаблон("""%1""", Имя);
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

// Зачем запросу нужен клиент 1С: подтвердить опасную операцию, выполнить код в клиенте или и то и другое.
//
// Параметры:
//  Описание - см. ЗапроситьРешение
//
// Возвращаемое значение:
//  Строка
//
Функция НазначениеЗапроса(Описание)
	
	Опасные = СтрСоединить(Описание.ОпасныеКонструкции, ", ");
	Если Описание.Контекст = КонтекстЧтенияНаборов() Тогда
		Назначение = "для чтения наборов вариантов из Ei";
	ИначеЕсли Описание.Контекст = "server" Тогда
		Назначение = СтрШаблон("для подтверждения опасной операции (%1)", Опасные);
	ИначеЕсли ЗначениеЗаполнено(Опасные) Тогда
		Назначение = СтрШаблон("для подтверждения опасной операции (%1) и выполнения кода в клиенте", Опасные);
	Иначе
		Назначение = "для выполнения кода в клиенте";
	КонецЕсли;
	
	Возврат Назначение;
	
КонецФункции

Функция ЗагрузитьЗапрос(Идентификатор)
	
	Запрос = ХранилищеОбщихНастроек.Загрузить(КлючЗапросов(), Идентификатор);
	Если ТипЗнч(Запрос) <> Тип("Структура") Тогда
		Запрос = Неопределено;
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

Процедура ЗакрытьЗапрос(Запрос, Причина)
	
	ХранилищеОбщихНастроек.Удалить(КлючЗапросов(), Запрос.Идентификатор, ИмяПользователя());
	
	ДанныеУведомления = Новый Структура("Идентификатор, Причина", Запрос.Идентификатор, Причина);
	Попытка
		ОтправитьУведомлениеКлиенту(КлючУведомленияЗакрыт(), ДанныеУведомления, Запрос.НомераСеансов);
	Исключение
		// Окно запроса останется открытым, но ответ из него уже не будет принят.
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// Удаляет записи о наборах старше срока хранения и записи прежнего формата, без ключей строк.
Процедура УдалитьУстаревшиеНаборы()
	
	Граница = ТекущаяУниверсальнаяДата() - СрокХраненияНаборов();
	
	Для Каждого ЭлементСписка Из ХранилищеОбщихНастроек.ПолучитьСписок(КлючДобавленныхНаборов()) Цикл
		Запись = ХранилищеОбщихНастроек.Загрузить(КлючДобавленныхНаборов(), ЭлементСписка.Значение);
		Если Не ЭтоЗаписьНаборов(Запись) Или Запись.Добавлены < Граница Тогда
			ХранилищеОбщихНастроек.Удалить(КлючДобавленныхНаборов(), ЭлементСписка.Значение, ИмяПользователя());
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Запомненные наборы в порядке добавления, см. ЗарегистрироватьНаборы
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Идентификатор - Строка - sets_id
//   * НомерСеанса - Число
//   * Добавлены - Дата
//   * КлючиСтрок - Массив из Строка
//
Функция ЗаписиДобавленныхНаборов()
	
	Граница = ТекущаяУниверсальнаяДата() - СрокХраненияНаборов();
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Добавлены");
	Таблица.Колонки.Добавить("Запись");
	Для Каждого ЭлементСписка Из ХранилищеОбщихНастроек.ПолучитьСписок(КлючДобавленныхНаборов()) Цикл
		Запись = ХранилищеОбщихНастроек.Загрузить(КлючДобавленныхНаборов(), ЭлементСписка.Значение);
		Если ЭтоЗаписьНаборов(Запись) И Запись.Добавлены >= Граница Тогда
			Запись.Вставить("Идентификатор", ЭлементСписка.Значение);
			НоваяСтрока 			= Таблица.Добавить();
			НоваяСтрока.Добавлены 	= Запись.Добавлены;
			НоваяСтрока.Запись 		= Запись;
		КонецЕсли;
	КонецЦикла;
	Таблица.Сортировать("Добавлены");
	
	Возврат Таблица.ВыгрузитьКолонку("Запись");
	
КонецФункции

Функция ЭтоЗаписьНаборов(Запись)
	
	Возврат ТипЗнч(Запись) = Тип("Структура") И Запись.Свойство("Добавлены") И Запись.Свойство("НомерСеанса")
		И Запись.Свойство("КлючиСтрок") И ТипЗнч(Запись.КлючиСтрок) = Тип("Массив");
	
КонецФункции

// Удаляет запросы с истекшим сроком и ответы на них, если модель так и не вернулась за ответом.
Процедура УдалитьУстаревшиеЗапросы()
	
	ТекущаяДата = ТекущаяУниверсальнаяДата();
	
	Для Каждого ЭлементСписка Из ХранилищеОбщихНастроек.ПолучитьСписок(КлючЗапросов()) Цикл
		Идентификатор 	= ЭлементСписка.Значение;
		Запрос 			= ЗагрузитьЗапрос(Идентификатор);
		Если Запрос = Неопределено Или ТекущаяДата > Запрос.СрокДействия Тогда
			ХранилищеОбщихНастроек.Удалить(КлючЗапросов(), Идентификатор, ИмяПользователя());
			ХранилищеОбщихНастроек.Удалить(КлючОтветов(), Идентификатор, ИмяПользователя());
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Ответы

Процедура ДождатьсяОтвета(Запрос)
	
	Если ОтветЕсть(Запрос.Идентификатор) Тогда
		Возврат;
	КонецЕсли;
	
	Срок = Мин(ТекущаяУниверсальнаяДата() + ВремяОжиданияОтвета(), Запрос.СрокДействия);
	
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(Запрос.Идентификатор);
	ПараметрыЗадания.Добавить(Срок);
	
	Попытка
		Задание 	= ФоновыеЗадания.Выполнить("ЗапросыMCPСервер_Ei.ОжидатьОтветВФоне", ПараметрыЗадания, ,
			"Ei: ожидание ответа на запрос MCP");
		Задание 	= Задание.ОжидатьЗавершенияВыполнения(ВремяОжиданияОтвета() + 5);
		Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			Задание.Отменить();
		КонецЕсли;
	Исключение
		// Без фонового задания ответ проверяется один раз, модель повторит вызов с request_id.
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ОтветЕсть(Идентификатор)
	
	Возврат ХранилищеОбщихНастроек.Загрузить(КлючОтветов(), Идентификатор) <> Неопределено;
	
КонецФункции

// Читает ответ и сразу удаляет его из хранилища: ответ одноразовый.
Функция ЗабратьОтвет(Идентификатор)
	
	Ответ = ХранилищеОбщихНастроек.Загрузить(КлючОтветов(), Идентификатор);
	Если Ответ <> Неопределено Тогда
		ХранилищеОбщихНастроек.Удалить(КлючОтветов(), Идентификатор, ИмяПользователя());
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция ОшибкаПроверкиОтвета(Ответ, Запрос)
	
	ОшибкаПроверки = "";
	
	Если ТипЗнч(Ответ) <> Тип("Структура")
		Или Не ЕстьСвойства(Ответ, "ВерсияПротокола, Идентификатор, Хеш, Создан, Контекст, Решение, НомерСеанса, Ответил") Тогда
		ОшибкаПроверки = "Ответ клиентского агента имеет неверный формат";
	ИначеЕсли Ответ.Идентификатор <> Запрос.Идентификатор
		Или Ответ.Хеш <> Запрос.Хеш
		Или Ответ.Создан <> Запрос.Создан
		Или Ответ.Контекст <> Запрос.Контекст Тогда
		ОшибкаПроверки = "Ответ клиентского агента не соответствует запросу";
	ИначеЕсли ТипЗнч(Ответ.Ответил) <> Тип("Дата") Или Ответ.Ответил > Запрос.СрокДействия Тогда
		ОшибкаПроверки = "Ответ клиентского агента получен после срока действия запроса";
	ИначеЕсли Ответ.Решение <> "Выполнено" И Ответ.Решение <> "Отклонено" Тогда
		ОшибкаПроверки = "Недопустимое решение клиентского агента: " + Строка(Ответ.Решение);
	ИначеЕсли Ответ.Решение = "Выполнено"
		И Не ЕстьСвойства(Ответ, "Успех, Результат, ТипРезультата, Ошибка, Код, КодИзменен") Тогда
		ОшибкаПроверки = "Ответ клиентского агента о выполнении кода имеет неверный формат";
	ИначеЕсли Не СеансОтветаДопустим(Ответ.НомерСеанса) Тогда
		ОшибкаПроверки = "Ответ записан не из интерактивного клиентского сеанса пользователя " + ИмяПользователя()
			+ " и не принят";
	КонецЕсли;
	
	Возврат ОшибкаПроверки;
	
КонецФункции

Функция ЕстьСвойства(Структура, ИменаСвойств)
	
	Есть = Истина;
	Для Каждого ИмяСвойства Из СтрРазделить(ИменаСвойств, ",", Ложь) Цикл
		Если Не Структура.Свойство(СокрЛП(ИмяСвойства)) Тогда
			Есть = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Есть;
	
КонецФункции

#КонецОбласти

#Область Сеансы

// Возвращает номера интерактивных клиентских сеансов текущего пользователя.
//
// Параметры:
//  ТолькоПоследний - Булево - вернуть только последний начатый сеанс
//
// Возвращаемое значение:
//  Массив из Число
//
Функция КлиентскиеСеансыПользователя(ТолькоПоследний)
	
	НомераСеансов 				= Новый Массив; // Массив из Число
	ПоследнийСеанс 				= Неопределено;
	ИмяТекущегоПользователя 	= ИмяПользователя();
	
	УстановитьПривилегированныйРежим(Истина);
	Сеансы = ПолучитьСеансыИнформационнойБазы();
	УстановитьПривилегированныйРежим(Ложь);
	
	Для Каждого Сеанс Из Сеансы Цикл
		Если Не ЭтоКлиентскийСеансПользователя(Сеанс, ИмяТекущегоПользователя) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ТолькоПоследний Тогда
			НомераСеансов.Добавить(Сеанс.НомерСеанса);
		ИначеЕсли ПоследнийСеанс = Неопределено Или Сеанс.НачалоСеанса > ПоследнийСеанс.НачалоСеанса Тогда
			ПоследнийСеанс = Сеанс;
		КонецЕсли;
	КонецЦикла;
	
	Если ПоследнийСеанс <> Неопределено Тогда
		НомераСеансов.Добавить(ПоследнийСеанс.НомерСеанса);
	КонецЕсли;
	
	Возврат НомераСеансов;
	
КонецФункции

// Проверяет, что сеанс, записавший ответ, существует, принадлежит текущему пользователю
// и является интерактивным клиентом: ответ из HTTP-сеанса или фонового задания не принимается.
Функция СеансОтветаДопустим(НомерСеанса)
	
	Допустим 					= Ложь;
	ИмяТекущегоПользователя 	= ИмяПользователя();
	
	УстановитьПривилегированныйРежим(Истина);
	Сеансы = ПолучитьСеансыИнформационнойБазы();
	УстановитьПривилегированныйРежим(Ложь);
	
	Для Каждого Сеанс Из Сеансы Цикл
		Если Сеанс.НомерСеанса = НомерСеанса Тогда
			Допустим = ЭтоКлиентскийСеансПользователя(Сеанс, ИмяТекущегоПользователя);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Допустим;
	
КонецФункции

Функция ЭтоКлиентскийСеансПользователя(Сеанс, ИмяПользователяСеанса)
	
	ИмяПользователяСеансаФакт = "";
	Если Сеанс.Пользователь <> Неопределено Тогда
		ИмяПользователяСеансаФакт = Сеанс.Пользователь.Имя;
	КонецЕсли;
	
	Возврат ИмяПользователяСеансаФакт = ИмяПользователяСеанса
		И КлиентскиеПриложения().Найти(Сеанс.ИмяПриложения) <> Неопределено;
	
КонецФункции

Функция КлиентскиеПриложения()
	
	Приложения = Новый Массив; // Массив из Строка
	Приложения.Добавить("1CV8C");
	Приложения.Добавить("1CV8");
	Приложения.Добавить("WebClient");
	
	Возврат Приложения;
	
КонецФункции

#КонецОбласти

#Область УведомленияКлиента

Процедура ОтправитьУведомлениеКлиенту(Ключ, Данные, НомераСеансов)
	
	МенеджерУведомленийКлиента().ОтправитьУведомление(Ключ, Данные, НомераСеансов);
	
КонецПроцедуры

Функция МенеджерУведомленийКлиента()
	
	УстановитьБезопасныйРежим(Истина);
	
	// Свойство глобального контекста появилось в 8.3.27, а режим совместимости Ei ниже - обращаемся по имени.
	//@skip-check server-execution-safe-mode
	Возврат Вычислить("УведомленияКлиента");
	
КонецФункции

Функция УведомленияКлиентаПоддерживаются()
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Возврат СравнитьВерсии(СистемнаяИнформация.ВерсияПриложения, МинимальнаяВерсияПлатформы()) >= 0;
	
КонецФункции

// Сравнивает версии вида 8.3.27.1606.
//
// Возвращаемое значение:
//  Число - больше нуля, если Версия1 новее, меньше нуля, если старее, ноль - если равны
//
Функция СравнитьВерсии(Версия1, Версия2)
	
	Результат 		= 0;
	Части1 			= СтрРазделить(Версия1, ".");
	Части2 			= СтрРазделить(Версия2, ".");
	ОписаниеЧисла 	= Новый ОписаниеТипов("Число");
	
	Для Индекс = 0 По Макс(Части1.ВГраница(), Части2.ВГраница()) Цикл
		Число1 = 0;
		Если Индекс <= Части1.ВГраница() Тогда
			Число1 = ОписаниеЧисла.ПривестиЗначение(Части1[Индекс]);
		КонецЕсли;
		Число2 = 0;
		Если Индекс <= Части2.ВГраница() Тогда
			Число2 = ОписаниеЧисла.ПривестиЗначение(Части2[Индекс]);
		КонецЕсли;
		Если Число1 <> Число2 Тогда
			Результат = Число1 - Число2;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


#Область ПрограммныйИнтерфейс

// Имя и признак служебной общей формы набора.
//
// Возвращаемое значение:
//  Строка
Функция ИмяФормы() Экспорт
	Возврат "КодНабораEi";
КонецФункции



// Очередь проверки исходников набора. Проверка запускается вне команды выполнения.
//
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
Процедура ЗапланироватьПроверкуСборки(Форма) Экспорт
	Форма.ПодключитьОбработчикОжидания("ОбновитьСборкуEDT", 0.3, Истина);
КонецПроцедуры

// Поддерживает хеши файлов и служебное значение в модуле объекта.
// Первое чтение и восстановление после потери событий требуют просмотра каталога.
//
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
Асинх Процедура ОбновитьСборку(Форма) Экспорт
	Если Форма.ОбновляетсяСборкаEDT = Истина Или Форма.ВКОтслеживания = Неопределено
		Или Форма.ВКОтслеживания = Ложь Или ПустаяСтрока(Форма.ИмяФайлаНастройки) Тогда
		Возврат;
	КонецЕсли;

	КаталогПроекта = Форма.ИмяФайлаНастройки;
	ИмяОбработки = ФайлыКлиент_Ei.ИмяОбработки(Форма);
	Если ПустаяСтрока(ИмяОбработки) Тогда
		Возврат;
	КонецЕсли;

	Форма.ОбновляетсяСборкаEDT = Истина;
	Попытка
		Ждать ОбновитьСнимокСборки(Форма, КаталогПроекта, ИмяОбработки);
	Исключение
		// Файл могли заменить, удалить или оставить недописанным. Обновим снимок по следующему событию.
		Форма.СнимокСборкиEDT = Неопределено;
	КонецПопытки;
	Форма.ОбновляетсяСборкаEDT = Ложь;
КонецПроцедуры

// Файлы и блоки сборки, соответствующие текущей ревизии слежения.
//
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
//
// Возвращаемое значение:
//  Структура, Неопределено - см. ОбновитьСнимокСборки
Функция ГотоваяСборка(Форма) Экспорт
	Результат = Неопределено;
	Снимок = Форма.СнимокСборкиEDT;
	Если Форма.ОбновляетсяСборкаEDT <> Истина И Снимок <> Неопределено
		И Не ПустаяСтрока(Снимок.Хеш) И Не ПустаяСтрока(Снимок.ПутьВыгрузки)
		И Снимок.Каталог = Форма.ИмяФайлаНастройки И Снимок.Имя = ФайлыКлиент_Ei.ИмяОбработки(Форма)
		И Форма.ВКОтслеживания.РевизияСлежения(Снимок.Каталог) = Снимок.Ревизия Тогда
		Результат = Снимок;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Асинх Функция ОбновитьСнимокСборки(Форма, КаталогПроекта, ИмяОбработки)
	Снимок = Форма.СнимокСборкиEDT;
	Ревизия = "";
	Если Снимок <> Неопределено И Снимок.Каталог = КаталогПроекта И Снимок.Имя = ИмяОбработки Тогда
		Ревизия = Снимок.Ревизия;
	КонецЕсли;
	JSON = Форма.ВКОтслеживания.ИзмененияСлежения(КаталогПроекта, Ревизия);
	Если ПустаяСтрока(JSON) Тогда
		Форма.СнимокСборкиEDT = Неопределено;
	Иначе
		Изменения = ПрочитатьЗначениеJSON(JSON);
		Разделитель = ПолучитьРазделительПути();
		Корень = ФайлыКлиент_Ei.КаталогОбработки(КаталогПроекта, ИмяОбработки) + Разделитель;
		ПутьОбъекта = Корень + "ObjectModule.bsl";
		ПутьФормы = Корень + "Forms" + Разделитель + ИмяФормы() + Разделитель + "Module.bsl";
		ПолноеЧтение = Изменения.rescan Или ПустаяСтрока(Ревизия);
		ВК = Форма.ВКОтслеживания;
		Если ПолноеЧтение Тогда
			Снимок = Новый Структура("Каталог,Имя,Хеши", КаталогПроекта, ИмяОбработки, Новый Соответствие);
			Снимок.Вставить("Ревизия", "");
			Снимок.Вставить("Хеш", "");
			Снимок.Вставить("ПутьВыгрузки", "");
			Снимок.Вставить("КлючиКода", Новый Соответствие);
			Снимок.Вставить("Режимы", Новый Соответствие);
			Пути = Новый Массив;
			Пути.Добавить(Корень);
		Иначе
			Пути = Изменения.paths;
		КонецЕсли;
		// Удаление или переименование каталога удаляет и записи всех его файлов.
		Для Каждого Путь Из Пути Цикл
			Если СтрНачинаетсяС(НРег(Путь + Разделитель), НРег(Корень)) Тогда
				Ждать ОбновитьХешиПути(Снимок.Хеши, Путь, Корень, ПутьОбъекта, ВК);
			КонецЕсли;
		КонецЦикла;

		ХешФормы = Снимок.Хеши.Получить(НРег(Сред(ПутьФормы, СтрДлина(Корень) + 1)));
		Если Не Снимок.Свойство("ХешМодуляФормы") Или Снимок.ХешМодуляФормы <> ХешФормы Тогда
			Снимок.Вставить("ХешМодуляФормы", ХешФормы);
			Снимок.КлючиКода = Новый Соответствие;
			Снимок.Режимы = Новый Соответствие;
			Если ХешФормы <> Неопределено Тогда
				ПрочитатьКлючиБлоков(ПутьФормы, Снимок.КлючиКода, Снимок.Режимы);
			КонецЕсли;
		КонецЕсли;
		Снимок.Хеш = "";
		ФайлМодуля = Новый Файл(ПутьОбъекта);
		Если Ждать ФайлМодуля.СуществуетАсинх() Тогда
			ТекстОбъекта = ФайлыКлиент_Ei.ПрочитатьТекст(ПутьОбъекта);
			Маркер = СтрокаХешаСборки(ТекстОбъекта);
			Если Не ПустаяСтрока(Маркер) Тогда
				Хеш = ХешСнимка(Снимок.Хеши, ВК);
				НовыйМаркер = ТекстСтрокиХеша(Хеш);
				Если Форма.ИмяФайлаНастройки = КаталогПроекта
					И Форма.ВКОтслеживания.РевизияСлежения(КаталогПроекта) = Изменения.revision Тогда
					Если Маркер <> НовыйМаркер Тогда
						ФайлыКлиентСервер_Ei.ЗаписатьСтроку(ПутьОбъекта, СтрЗаменить(ТекстОбъекта, Маркер, НовыйМаркер));
					КонецЕсли;
					Снимок.Хеш = Хеш;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если Форма.ИмяФайлаНастройки = КаталогПроекта Тогда
			Снимок.Ревизия = Изменения.revision;
			Снимок.ПутьВыгрузки = ПутьВыгрузки(КаталогПроекта, ИмяОбработки);
			Форма.СнимокСборкиEDT = Снимок;
			Если Форма.ВКОтслеживания.РевизияСлежения(КаталогПроекта) <> Снимок.Ревизия Тогда
				ЗапланироватьПроверкуСборки(Форма);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Не ПустаяСтрока(JSON);
КонецФункции

Асинх Функция ОбновитьХешиПути(Хеши, Путь, Корень, ПутьОбъекта, ВК)
	Файл = Новый Файл(Путь);
	Если Ждать Файл.СуществуетАсинх() Тогда
		Если Ждать Файл.ЭтоКаталогАсинх() Тогда
			ВложенныеФайлы = Ждать НайтиФайлыАсинх(Файл.ПолноеИмя, "*", Истина);
			Для Каждого Вложенный Из ВложенныеФайлы Цикл
				Если Не (Ждать Вложенный.ЭтоКаталогАсинх()) Тогда
					ДобавитьХешФайла(Хеши, Вложенный.ПолноеИмя, Корень, ПутьОбъекта, ВК);
				КонецЕсли;
			КонецЦикла;
		Иначе
			ДобавитьХешФайла(Хеши, Файл.ПолноеИмя, Корень, ПутьОбъекта, ВК);
		КонецЕсли;
	Иначе
		ИмяФайла = НРег(Сред(Путь, СтрДлина(Корень) + 1));
		Хеши.Удалить(ИмяФайла);
		Вложенные = Новый Массив;
		Префикс = ИмяФайла + ПолучитьРазделительПути();
		Для Каждого ХешФайла Из Хеши Цикл
			Если СтрНачинаетсяС(ХешФайла.Ключ, Префикс) Тогда
				Вложенные.Добавить(ХешФайла.Ключ);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Имя Из Вложенные Цикл
			Хеши.Удалить(Имя);
		КонецЦикла;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Процедура ДобавитьХешФайла(Хеши, Путь, Корень, ПутьОбъекта, ВК)
	Если НРег(Путь) = НРег(ПутьОбъекта) Тогда
		Текст = ФайлыКлиент_Ei.ПрочитатьТекст(Путь);
		Маркер = СтрокаХешаСборки(Текст);
		Если Не ПустаяСтрока(Маркер) Тогда
			Текст = СтрЗаменить(Текст, Маркер, ТекстСтрокиХеша(""));
		КонецЕсли;
		Хеш = ВК.ХешSHA256(Текст, Ложь);
	Иначе
		Хеш = ВК.ХешSHA256(Путь, Истина);
	КонецЕсли;
	Если ПустаяСтрока(Хеш) Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось прочитать исходный файл EDT для сверки сборки.'");
	КонецЕсли;
	Хеши.Вставить(НРег(Сред(Путь, СтрДлина(Корень) + 1)), Хеш);
КонецПроцедуры

Функция ХешСнимка(Хеши, ВК)
	Имена = Новый СписокЗначений;
	Для Каждого ХешФайла Из Хеши Цикл
		Имена.Добавить(ХешФайла.Ключ);
	КонецЦикла;
	Имена.СортироватьПоЗначению();
	СтрокиХешей = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		СтрокиХешей.Добавить(Строка(СтрДлина(Имя.Значение)) + ":" + Имя.Значение + Хеши.Получить(Имя.Значение));
	КонецЦикла;
	Возврат ВК.ХешSHA256(СтрСоединить(СтрокиХешей, Символы.ПС), Ложь);
КонецФункции

Функция СтрокаХешаСборки(Текст)
	Итог = "";
	Для Каждого СтрокаКода Из СтрРазделить(Текст, Символы.ПС) Цикл
		Если СтрНачинаетсяС(СтрокаКода, Символы.Таб + "Возврат """)
			И СтрЗаканчиваетсяНа(СтрЗаменить(СтрокаКода, Символы.ВК, ""), "//<EiХешИсходников>") Тогда
			Итог = СтрЗаменить(СтрокаКода, Символы.ВК, "");
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;
КонецФункции

Функция ТекстСтрокиХеша(Хеш)
	Возврат Символы.Таб + "Возврат """ + Хеш + """; //<EiХешИсходников>";
КонецФункции

Функция ПутьВыгрузки(Каталог, ИмяОбработки)
	Разделитель = ПолучитьРазделительПути();
	Путь = Каталог + Разделитель + "bin";
	Выгрузка = Ложь;
	Настройки = Новый Файл(СтрШаблон("%1%2.settings%2com._1c.g5.v8.dt.platform.services.core.prefs", Каталог, Разделитель));
	Если Настройки.Существует() Тогда
		Для Каждого СтрокаНастройки Из СтрРазделить(ФайлыКлиент_Ei.ПрочитатьТекст(Настройки.ПолноеИмя), Символы.ПС, Ложь) Цикл
			Равно = СтрНайти(СтрокаНастройки, "=");
			Если СтрНайти(СтрокаНастройки, "EXT_OBJECT_DUMP") = 0 Или Равно = 0 Тогда
				Продолжить;
			КонецЕсли;
			Значение = СокрЛП(Сред(СтрокаНастройки, Равно + 1));
			Если СтрНайти(СтрокаНастройки, "GENERATION") > 0 Тогда
				Выгрузка = НРег(Значение) = "true";
			ИначеЕсли Не ПустаяСтрока(Значение) Тогда
				Путь = СтрЗаменить(СтрЗаменить(Значение, "\:", ":"), "\\", "\");
				Если СтрНайти(Путь, ":") = 0 И Не СтрНачинаетсяС(Путь, Разделитель) Тогда
					Путь = Каталог + Разделитель + Путь;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ?(Выгрузка, Путь + Разделитель + ИмяОбработки + ".epf", "");
КонецФункции

// Кеширует диспетчер общей формы по содержимому файла.
Процедура ПрочитатьКлючиБлоков(Путь, КлючиКода, Режимы)
	Блоки = КодНабораКлиентСервер_Ei.ПрочитатьБлоки(ФайлыКлиент_Ei.ПрочитатьТекст(Путь));
	Для Каждого Блок Из Блоки Цикл
		Режим = Неопределено;
		Блок.Значение.Описание.Свойство("РежимКомпиляции", Режим);
		Режимы.Вставить(Блок.Ключ, ?(Режим = Неопределено, "Сервер", Режим));
		Ключ = КодНабораКлиентСервер_Ei.КлючКода(Блок.Значение.Код);
		Если КлючиКода.Получить(Ключ) = Неопределено Тогда
			КлючиКода.Вставить(Ключ, Блок.Ключ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Начинает сборку общей формы, сохраняя навигационные ссылки прежних блоков.
//
// Параметры:
//  Каталог - Строка - каталог обработки
//  ИмяОбработки - Строка - имя обработки
//  СтрНаборов - Структура - строки сохраняемого набора
//
// Возвращаемое значение:
//  Структура - контекст сохранения:
//   * Каталог - Строка
//   * ИмяОбработки - Строка
//   * Блоки - Массив из Строка
//   * Части - Массив из Структура
//   * Строки - Массив из Структура
//   * ПрежниеБлоки - Соответствие из КлючИЗначение
//   * Путь - Строка
Функция НачатьСохранение(Каталог, ИмяОбработки, СтрНаборов) Экспорт
	Результат = Новый Структура("Каталог,ИмяОбработки,Блоки", Каталог, ИмяОбработки, Новый Массив);
	Результат.Вставить("Части", Новый Массив);
	Результат.Вставить("Строки", Новый Массив);
	Результат.Вставить("ПрежниеБлоки", Новый Соответствие);
	Результат.Вставить("Путь", Каталог + "\Forms\" + ИмяФормы() + "\Module.bsl");
	Для Каждого СтрокаНабора Из СтрНаборов Цикл
		Набор = СтрокаНабора.Значение;
		СтрокаСостава = Новый Структура("Имя,КлючНастроек,Родитель", Набор.Имя, Строка(Набор.КлючНастроек), Набор.Родитель);
		Результат.Строки.Добавить(СтрокаСостава);
	КонецЦикла;
	Файл = Новый Файл(Результат.Путь);
	Если Файл.Существует() Тогда
		Результат.ПрежниеБлоки = КодНабораКлиентСервер_Ei.ПрочитатьБлоки(ФайлыКлиент_Ei.ПрочитатьТекст(Файл.ПолноеИмя));
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Добавляет логическую форму как блок общей формы, без отдельного файла кода.
//
// Параметры:
//  Контекст - см. НачатьСохранение
//  Описание - см. КодНабораКлиентСервер_Ei.ОписаниеБлока
//  Модуль - Строка - прежний модуль самостоятельной формы
//  ИмяЧасти - Строка - прежнее имя части для схемы процесса
//  ДопСвойства - Структура - дополнительные свойства ссылки на файл
//
// Возвращаемое значение:
//  см. ФайлыКлиент_Ei.РезультатСохранения
Функция ДобавитьБлок(Контекст, Описание, Модуль, ИмяЧасти, ДопСвойства) Экспорт
	Прежний = Контекст.ПрежниеБлоки.Получить(Описание.Ключ);
	Если Прежний <> Неопределено Тогда
		Описание.Ссылка = Прежний.Описание.Ссылка;
	КонецЕсли;
	Код = ВариантАлгоритмКлиентСервер_Ei.ПолучитьВыражениеИзМодуля(Модуль);
	ТипРезультата = "Произвольный";
	Если ЗначениеЗаполнено(Описание.КлючПараметра) Тогда
		ТипРезультата = ВариантАлгоритмКлиентСервер_Ei.ОписаниеРезультатаФормы(Контекст.ИмяОбработки,
			ВариантАлгоритмКлиентСервер_Ei.ИмяФункцииПараметра(Описание.Имя));
	ИначеЕсли Не ЗначениеЗаполнено(Описание.Владелец) Тогда
		ТипРезультата = ВариантАлгоритмКлиентСервер_Ei.ОписаниеРезультатаФормы(Контекст.ИмяОбработки,
			ВариантАлгоритмКлиентСервер_Ei.ИмяФункцииАлгоритма(Описание.ИмяСтроки));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Описание.КлючПараметра) И Не ЗначениеЗаполнено(Описание.Владелец)
		И КодНабораКлиентСервер_Ei.Компилируется(Код, Истина) Тогда
		Режим = ?(ВыполнитьВызовСервера_Ei.КомпилируетсяНаСервере(Код), "КлиентСервер", "Клиент");
		Описание.Вставить("РежимКомпиляции", Режим);
	КонецЕсли;
	Контекст.Блоки.Добавить(КодНабораКлиентСервер_Ei.ТекстБлока(Описание, Код, ТипРезультата));
	Результат = ФайлыКлиент_Ei.РезультатСохранения(ИмяФормы(), Контекст.Каталог, "", Описание.Ключ,
		Новый Файл(Контекст.Путь), ДопСвойства);
	Результат.Вставить("КлючБлока", Описание.Ключ);
	Результат.Вставить("ИмяЧасти", ИмяЧасти);
	Результат.Вставить("СтрокаБлока", Описание.ИмяСтроки);
	Результат.Хэш = КодНабораКлиентСервер_Ei.КлючКода(Код);
	Контекст.Части.Добавить(Результат);
	Возврат Результат;
КонецФункции

// Записывает единственную форму после подготовки всех частей набора.
//
// Параметры:
//  Контекст - см. НачатьСохранение
//  КлючСтроки - Строка, УникальныйИдентификатор - ключ корневой строки
//
// Возвращаемое значение:
//  см. ФайлыКлиент_Ei.РезультатСохранения
Асинх Функция ЗавершитьСохранение(Контекст, КлючСтроки) Экспорт
	Состав = Новый Структура("Версия,Строки,Части", 1, Контекст.Строки, Контекст.Части);
	Состав.Вставить("ИмяОбработки", Контекст.ИмяОбработки);
	Текст = КодНабораКлиентСервер_Ei.ТекстМодуля(Контекст.Блоки, Состав);
	Ключ = Строка(ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(КлючСтроки, "89f13c2a51b7"));
	Путь = Ждать EDTКлиент_Ei.СоздатьФормуОбработки(Контекст.Каталог, Текст, ИмяФормы(), Ключ, ИмяФормы(), Контекст.ИмяОбработки);
	ДопСвойства = Новый Структура("Синоним,Комментарий", ИмяФормы(), ИмяФормы());
	Возврат ФайлыКлиент_Ei.РезультатСохранения(ИмяФормы(), Контекст.Каталог, Текст, Ключ, Новый Файл(Путь), ДопСвойства);
КонецФункции

//@skip-check constructor-function-return-section
// Читает один снимок общей формы и восстанавливает строки набора для привязки макетов.
//
// Параметры:
//  Путь - Строка - путь к общей форме
//  Результат - Структура - читаемые строки набора
//
// Возвращаемое значение:
//  Структура - снимок общей формы:
//   * Строки - Массив из Структура - описания строк набора из состава
//   * Части - Массив из Структура - описания частей набора из состава
//   * Блоки - см. КодНабораКлиентСервер_Ei.ПрочитатьБлоки
Функция ПрочитатьСтроки(Путь, Результат) Экспорт
	Текст = ФайлыКлиент_Ei.ПрочитатьТекст(Путь);
	Состав = КодНабораКлиентСервер_Ei.ПрочитатьСостав(Текст);
	Если Состав = Неопределено Или Состав.Версия <> 1 Тогда
		ВызватьИсключение НСтр("ru = 'В общей форме Ei отсутствует поддерживаемое описание состава'");
	КонецЕсли;
	Блоки = КодНабораКлиентСервер_Ei.ПрочитатьБлоки(Текст);
	Для Каждого СтрокаСостава Из Состав.Строки Цикл
		СтрокаНабора = Неопределено;
		Если Не Результат.Свойство(СтрокаСостава.Имя, СтрокаНабора) Тогда
			СтрокаНабора = Новый Структура("Имя,КлючНастроек,Родитель", СтрокаСостава.Имя,
				Новый УникальныйИдентификатор(СтрокаСостава.КлючНастроек), СтрокаСостава.Родитель);
			СтрокаНабора.Вставить("Параметры", Новый Структура);
			СтрокаНабора.Вставить("Данные", Новый Структура);
			Результат.Вставить(СтрокаНабора.Имя, СтрокаНабора);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Строки,Части,Блоки", Состав.Строки, Состав.Части, Блоки);
КонецФункции

// Восстанавливает строки и код из общей формы; данные макетов добавляет обычный читатель EDT.
// Текст блока и его хеш читаются отдельно от служебного диспетчера.
//
// Параметры:
//  Путь - Строка - путь к общей форме
//  Результат - Структура - читаемые строки набора
//  СсылкиНаФайлы - Структура - ссылки по строкам
//  Снимок - Структура, Неопределено - ранее прочитанная общая форма, см. ПрочитатьСтроки
//
// Возвращаемое значение:
//  Массив из Структура - виртуальные объекты кода, в том числе части процессов
Функция Прочитать(Путь, Результат, СсылкиНаФайлы, Снимок = Неопределено) Экспорт
	Если Снимок = Неопределено Тогда
		Снимок = ПрочитатьСтроки(Путь, Результат);
	КонецЕсли;
	Блоки = Снимок.Блоки;
	Для Каждого СтрокаСостава Из Снимок.Строки Цикл
		Если Не СсылкиНаФайлы.Свойство(СтрокаСостава.Имя) Тогда
			СсылкиНаФайлы.Вставить(СтрокаСостава.Имя, Новый Массив);
		КонецЕсли;
	КонецЦикла;
	Объекты = Новый Массив;
	Для Каждого Часть Из Снимок.Части Цикл
		Блок = Блоки.Получить(Часть.КлючБлока);
		Если Блок = Неопределено Тогда
			//Удаление блока в EDT удаляет соответствующий алгоритм или параметр.
			Продолжить;
		КонецЕсли;
		Описание = Блок.Описание;
		СтрокаНабора = Результат[Описание.ИмяСтроки];
		Если СтрокаНабора = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Блок кода Ei ссылается на неизвестную строку набора'");
		КонецЕсли;
		Часть.Хэш = КодНабораКлиентСервер_Ei.КлючКода(Блок.Код);
		СсылкиНаФайлы[СтрокаНабора.Имя].Добавить(Часть);
		Если ЗначениеЗаполнено(Описание.КлючПараметра) Тогда
			Параметр = Новый Структура("Ключ,ЭтоВыражение,ЗначениеПараметра", Описание.КлючПараметра, Истина, Блок.Код);
			СтрокаНабора.Параметры.Вставить(Описание.Имя, Параметр);
		ИначеЕсли Не ЗначениеЗаполнено(Описание.Владелец) Тогда
			ИмяВарианта = НавигационныеСсылкиКлиентСервер_Ei.ИмяВариантаПоКоду(Описание.КодВарианта);
			СтрокаНабора.Данные.Вставить(ИмяВарианта, Новый Структура("Инструкция", Блок.Код));
		КонецЕсли;
		Объект = Новый Структура("Ключ,Имя,Синоним", Описание.Ключ, Часть.ИмяЧасти, Часть.Синоним);
		Объект.Вставить("Форма", Истина);
		Объект.Вставить("ТипМакета", "");
		Объект.Вставить("Комментарий", ?(ЗначениеЗаполнено(Описание.Владелец), EDTКлиент_Ei.КомментарийЧасти(Описание.Владелец), ""));
		Объект.Вставить("ПолноеИмя", Путь);
		Объект.Вставить("КодБлока", Блок.Код);
		Объект.Вставить("КлючБлока", Описание.Ключ);
		Объекты.Добавить(Объект);
	КонецЦикла;
	Возврат Объекты;
КонецФункции

// Обрабатывает общую форму и структурные изменения проекта до старого слежения.
//
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
//  Каталог - Строка - каталог проекта
//  Данные - Структура - событие отслеживания
//
// Возвращаемое значение:
//  Булево - событие относится к общему хранению и обработано
Асинх Функция ОбработатьСобытие(Форма, Каталог, Данные) Экспорт
	Обработано = Ложь;
	ИмяОбработки = ФайлыКлиент_Ei.ИмяОбработки(Форма);
	Если ЗначениеЗаполнено(ИмяОбработки) Тогда
		Корень = ФайлыКлиент_Ei.КаталогОбработки(Каталог, ИмяОбработки);
		ПутьМодуля = Корень + "\Forms\" + ИмяФормы() + "\Module.bsl";
		ПутьМетаданных = Корень + "\" + ИмяОбработки + ".mdo";
		ПутьСобытия = НРег(Данные.path);
		Если ПутьСобытия = НРег(ПутьМодуля) И Данные.type = "modified" Тогда
			Ждать ОбновитьБлоки(Форма, ПутьМодуля);
			Обработано = Истина;
		ИначеЕсли Данные.type = "rescan" Или ПутьСобытия = НРег(ПутьМетаданных)
			Или Данные.type <> "modified" И СтрНачинаетсяС(ПутьСобытия, НРег(Корень + "\"))
			И (СтрНайти(ПутьСобытия, "\forms\") > 0 Или СтрНайти(ПутьСобытия, "\templates\") > 0) Тогда
			Ждать ПеречитатьСтруктуру(Форма, Каталог, ИмяОбработки);
			Обработано = Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Обработано;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Асинх Функция ПеречитатьСтруктуру(Форма, Каталог, ИмяОбработки)
	Ссылки = Новый Структура;
	Набор = Ждать EDTКлиент_Ei.ПрочитатьСоставОбработки(Каталог, ИмяОбработки, Ссылки);
	Загружать = Набор <> Неопределено;
	Если Загружать И ЕстьИзменения(Форма) Тогда
		Ответ = Ждать ВопросАсинх(НСтр("ru = 'Состав набора на диске изменен. Перечитать набор целиком? Несохраненные изменения в Ei будут потеряны.'"),
			РежимДиалогаВопрос.ДаНет);
		Загружать = Ответ = КодВозвратаДиалога.Да;
	КонецЕсли;
	Если Загружать Тогда
		ФайлыКлиент_Ei.ЗагрузитьПрочитанныйНабор(Форма, Набор, Каталог, ИмяОбработки, Ссылки);
	КонецЕсли;
	Возврат Загружать;
КонецФункции

Асинх Функция ОбновитьБлоки(Форма, Путь)
	СтабильныйСнимок = Ложь;
	Пока Не СтабильныйСнимок Цикл
		Текст = ФайлыКлиент_Ei.ПрочитатьТекст(Путь);
		Блоки = КодНабораКлиентСервер_Ei.ПрочитатьБлоки(Текст);
		Строки = Новый Массив;
		ДобавитьСтроки(НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма), Строки);
		СтруктураИзменена = Ложь;
		Для Каждого СтрокаНабора Из Строки Цикл
			Если ТипЗнч(СтрокаНабора.Файлы) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого ЗаписьФайла Из СтрокаНабора.Файлы Цикл
				Если ЗаписьФайла.Значение.Свойство("КлючБлока")
					И Блоки.Получить(ЗаписьФайла.Значение.КлючБлока) = Неопределено Тогда
					СтруктураИзменена = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Если СтруктураИзменена Тогда
			Ждать ПеречитатьСтруктуру(Форма, Форма.ИмяФайлаНастройки, ФайлыКлиент_Ei.ИмяОбработки(Форма));
		Иначе
		БылиИзменения = ЕстьИзменения(Форма);
		Изменено = Ложь;
		Для Каждого СтрокаНабора Из Строки Цикл
			Если ТипЗнч(СтрокаНабора.Файлы) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			Файлы = СтрокаНабора.Файлы;
			Для Каждого ЗаписьФайла Из Файлы Цикл
				Ссылка = ЗаписьФайла.Значение;
				Если Не Ссылка.Свойство("КлючБлока") Тогда
					Продолжить;
				КонецЕсли;
				Блок = Блоки.Получить(Ссылка.КлючБлока);
				Хэш = КодНабораКлиентСервер_Ei.КлючКода(Блок.Код);
				Если Ссылка.Хэш = Хэш Тогда
					Продолжить;
				КонецЕсли;
				Параметр = ПараметрыКлиент_Ei.НайтиПараметр(СтрокаНабора, Ссылка.Ключ);
				Обработчик = Неопределено;
				Если Параметр <> Неопределено Тогда
					Конфликт = ПараметрыКлиент_Ei.Модифицированность(Параметр, Ссылка);
				Иначе
					КлючВарианта = ФайлыКлиент_Ei.КлючВариантаФайла(Ссылка);
					Для Каждого Вид Из ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
						Если Строка(ВариантыКлиентСервер_Ei.ПолучитьИдентификатор(СтрокаНабора.КлючНастроек, Вид.Значение)) = КлючВарианта Тогда
							Обработчик = Вид.Значение;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если Обработчик = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					Конфликт = Обработчик.Модифицированность(Форма, СтрокаНабора);
				КонецЕсли;
				Если Конфликт Тогда
					Ответ = Ждать ВопросАсинх(СтрШаблон(НСтр("ru = 'Блок %1 строки %2 изменен в EDT и в Ei. Загрузить его из EDT?'"),
						Блок.Описание.Имя, СтрокаНабора.ИмяНабора), РежимДиалогаВопрос.ДаНет);
					Если Ответ <> КодВозвратаДиалога.Да Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				Если Параметр <> Неопределено Тогда
					Параметр.ЗначениеПараметра = Блок.Код;
				ИначеЕсли Обработчик.Свойства().Имя = ВариантАлгоритмКлиентСервер_Ei.Свойства().Имя Тогда
					Обработчик.ЗагрузитьДанные(СтрокаНабора, Новый Структура("Инструкция", Блок.Код));
				Иначе
					Главная = НаборВариантовКлиент_Ei.ПолучитьСсылкуНаФайл(СтрокаНабора, КлючВарианта);
					Корень = ФайлыКлиент_Ei.КаталогОбработки(Форма.ИмяФайлаНастройки, ФайлыКлиент_Ei.ИмяОбработки(Форма));
					Обработчик.ЗагрузитьДанные(СтрокаНабора, Обработчик.Прочитать(Корень + "\" + Главная.Окончание));
				КонецЕсли;
				Ссылка.Хэш = Хэш;
				Файлы.Вставить(ЗаписьФайла.Ключ, Ссылка);
				СтрокаНабора.Файлы = Файлы;
				ВариантыКлиент_Ei.ПересчитатьМодифицированность(Форма, СтрокаНабора);
				ТекущаяСтрока = Форма.ПолучитьПереопределяемыйОбъектОбработки();
				Если Обработчик <> Неопределено И ТекущаяСтрока <> Неопределено
					И ТекущаяСтрока.КлючНастроек = СтрокаНабора.КлючНастроек Тогда
					Обработчик.ПриИзмененииДанных(Форма);
				КонецЕсли;
				Изменено = Истина;
			КонецЦикла;
		КонецЦикла;
		Если Изменено Тогда
			Если Не БылиИзменения Тогда
				Форма.СохраненныйОбраз = ФайлыКлиент_Ei.вПолучитьСохраняемыйОбраз(Форма);
			КонецЕсли;
			КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
		КонецЕсли;
		КонецЕсли;
		СтабильныйСнимок = Текст = ФайлыКлиент_Ei.ПрочитатьТекст(Путь);
	КонецЦикла;
	Возврат Истина;
КонецФункции



Процедура ДобавитьСтроки(Коллекция, Строки)
	Для Каждого СтрокаНабора Из Коллекция Цикл
		Строки.Добавить(СтрокаНабора);
		ДобавитьСтроки(СтрокаНабора.ПолучитьЭлементы(), Строки);
	КонецЦикла;
КонецПроцедуры

Функция ЕстьИзменения(Форма)
	Возврат СокрЛП(Форма.СохраненныйОбраз) <> СокрЛП(ФайлыКлиент_Ei.вПолучитьСохраняемыйОбраз(Форма));
КонецФункции

#КонецОбласти

// Вариант «Процессы» на клиенте: элементы формы варианта, настройки пользователя и показатели после выполнения.

#Область ПрограммныйИнтерфейс

// Наследует в форму Ei элементы формы процесса.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, в которую наследуются элементы
//  Контейнер - ГруппаФормы - группа для элементов процесса
//  РодительРеквизитов - Строка, Неопределено - путь к реквизитам процесса в форме
//
Процедура Инициализировать(Форма, Контейнер, РодительРеквизитов = Неопределено) Экспорт
	ПереопределенныеПути = Неопределено;
	// Форма процесса нужна неоткрытой: от нее наследуется поведение
	//@skip-check use-non-recommended-method
	ФормаРодитель = ПолучитьФорму(ПроцессыКлиент_Ei.ИмяМодальнойФормы());
	Если РодительРеквизитов <> Неопределено Тогда
		ПереопределенныеПути = Новый Соответствие;
		ПереопределенныеПути.Вставить("ДоступныеОбработки",	РодительРеквизитов);
		ПереопределенныеПути.Вставить("ГрафСхемаXDTO",		РодительРеквизитов);
		ПереопределенныеПути.Вставить("Процессы_Объект",	РодительРеквизитов);
	КонецЕсли;
	КонтейнерКП = КонструкторКлиентСервер_Ei.КонтейнерКП(Форма, ВариантПроцессыКлиентСервер_Ei);
	// Обработки и контекст - в правой панели формы Ei, если она есть: в форме обработки Для Каждого ее нет
	КонтейнерыЧастей = Неопределено;
	КонтейнерЧасти = КонструкторКлиентСервер_Ei.КонтейнерЧасти(Форма, ВариантПроцессыКлиентСервер_Ei);
	Если КонтейнерЧасти <> Неопределено Тогда
		КонтейнерыЧастей = Новый Соответствие;
		КонтейнерыЧастей.Вставить(ВариантПроцессыКлиентСервер_Ei.Свойства().БоковаяЧасть, КонтейнерЧасти);
	КонецЕсли;
	НаследованиеФормКлиент_Ei.Дополнить(ФормаРодитель, Форма, Контейнер, ПереопределенныеПути, КонтейнерКП, КонтейнерыЧастей);
	ИзменитьОтображениеКнопокМеню(Форма, КонтейнерКП);
КонецПроцедуры

// При изменении данных строки набора: схема с показателями или без них.
// Загрузка процесса (в том числе перечитанного из файла) строит дерево доступных обработок только из настроенных
// обработок, без представлений и картинок видов: виды дополняются здесь, как при переходе на закладку
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//
Процедура ПриИзмененииДанных(Форма) Экспорт
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если ТекД <> Неопределено Тогда
		ОбработкиКлиент_Ei.ЗагрузитьОбработки(ТекД.ДоступныеОбработки.ПолучитьЭлементы());
	КонецЕсли;
	Кнопка = Форма.Элементы.Найти("ОтобразитьПоказателиПроцесса");
	Если Кнопка <> Неопределено Тогда
		ПроцессыКлиент_Ei.ОтобразитьПоказателиПроцесса(Форма, Кнопка.Пометка);
	КонецЕсли;
КонецПроцедуры

// При переходе на закладку варианта: элементы процесса создаются при первом показе, а не при открытии формы
// сразу для всех вариантов.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//
Процедура ПриОтображении(Форма) Экспорт
	Заполнитель = КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма, ВариантПроцессыКлиентСервер_Ei);
	Если Заполнитель.Видимость Тогда
		Заполнитель.Видимость = Ложь;
		Контейнер = КонструкторКлиентСервер_Ei.Контейнер(Форма, ВариантПроцессыКлиентСервер_Ei);
		Инициализировать(Форма, Контейнер, КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента());
		// Пока не было элементов формы, обновлять было нечего
		ПриИзмененииДанных(Форма);
	КонецЕсли;
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если ТекД <> Неопределено Тогда
		ОбработкиКлиент_Ei.ЗагрузитьОбработки(ТекД.ДоступныеОбработки.ПолучитьЭлементы());
		ЗагрузитьНастройки(Форма, ТекД);
		ПроцессыКлиент_Ei.ОбновитьЗаголовокОбъекта(Форма, ТекД);
		// Кнопки командной панели возвращаются к исходному виду при переключении на вариант Коллекция и обратно
		ИзменитьОтображениеКнопокМеню(Форма, КонструкторКлиентСервер_Ei.КонтейнерКП(Форма, ВариантПроцессыКлиентСервер_Ei));
	КонецЕсли;
КонецПроцедуры

// Показывает ошибку выполнения варианта.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  СобытиеОтладки - Структура, Неопределено - событие отладки
//  ИнфоОбОшибке - ИнформацияОбОшибке, Строка - ошибка
//
Процедура ОбработкаОшибокВыполнения(Форма, СобытиеОтладки, ИнфоОбОшибке) Экспорт
	Если СобытиеОтладки <> Неопределено Тогда
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки, , ИнфоОбОшибке);
	КонецЕсли;
	ОтладкаКлиент_Ei.ПоказатьИсключение(Форма, ИнфоОбОшибке, ВариантыКлиентСервер_Ei, ВариантПроцессыКлиентСервер_Ei);
КонецПроцедуры

// Показывает обработку с ошибкой на схеме.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  Элемент - ДекорацияФормы - декорация ошибки
//
Процедура РасшифровкаОшибки(Форма, Элемент) Экспорт
	ПроцессыКлиент_Ei.ВыделитьОшибкуВПроцессе(Форма, Элемент);
КонецПроцедуры

// Сколько обработок на схеме процесса.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  ТекД - ДанныеФормыЭлементДерева - строка набора
//
// Возвращаемое значение:
//  Число
//
Функция ПолучитьРазмерность(Форма, ТекД) Экспорт
	Возврат ПроцессыКлиентСервер_Ei.ПолучитьУправляющиеЭлементы(Форма.Процессы_ГрафСхема).Количество();
КонецФункции

// Сохраняет процесс на диск в формате EDT несколькими файлами, см. СхемаПроцессаEDTВызовСервера_Ei.ФайлыПроцесса:
// главный - макет «Графическая схема», части - формы алгоритмов и изначального объекта, макеты ссылок «Выполнить»,
// схемы «Для Каждого». Пустой процесс (без схемы) не сохраняется: его прежние файлы удалит сохранение набора
//
// Параметры:
//  Настройки - см. ВариантыКлиент_Ei.НастройкиСохранения
//
// Возвращаемое значение:
//  Массив из см. ФайлыКлиент_Ei.РезультатСохранения, Неопределено - процесс пустой
//
Асинх Функция Сохранить(Настройки) Экспорт
	Результат = Неопределено;
	Данные = Настройки.Данные;
	ОбщаяФорма = Неопределено;
	Настройки.Свойство("ОбщаяФорма", ОбщаяФорма);
	Если ЗначениеЗаполнено(Данные.Инструкция) Тогда
		Результат = Новый Массив;
		Для Каждого Файл Из СхемаПроцессаEDTВызовСервера_Ei.ФайлыПроцесса(Данные, Настройки.ВариантыИмя, Настройки.ВариантыКлюч) Цикл
			ДопСвойства = Новый Структура("Синоним", Файл.Синоним);
			Если Файл.Форма И ОбщаяФорма <> Неопределено Тогда
				ПолноеИмя = ОбщаяФорма.Путь;
			ИначеЕсли Файл.Форма Тогда
				ПолноеИмя = Ждать EDTКлиент_Ei.СоздатьФормуОбработки(Настройки.Путь, Файл.Текст, Файл.Имя, Файл.Ключ, Файл.Синоним,
					Настройки.ИмяНабора);
			Иначе
				ДопСвойства.Вставить("ТипМакета", Файл.ТипМакета);
				ПолноеИмя = Ждать EDTКлиент_Ei.СоздатьМакетОбработки(Настройки.Путь, Файл.Текст, Файл.Имя, Файл.Ключ,
					EDTКлиент_Ei.ТипыМакетов()[Файл.ТипМакета], Файл.Синоним);
			КонецЕсли;
			Если ЗначениеЗаполнено(Файл.Владелец) Тогда
				ДопСвойства.Вставить("Комментарий", EDTКлиент_Ei.КомментарийЧасти(Файл.Владелец));
				ДопСвойства.Вставить("Владелец", Файл.Вариант);
			Иначе
				//до 3.2.9.5 процесс сохранялся текстовым макетом в этот же каталог
				ФайлСхемы = Новый Файл(ПолноеИмя);
				УдалитьФайлыАсинх(ФайлСхемы.Путь, EDTКлиент_Ei.ТипыМакетов().TextDocument);
			КонецЕсли;
			Если Файл.Форма И ОбщаяФорма <> Неопределено Тогда
				ОписаниеБлока = КодНабораКлиентСервер_Ei.ОписаниеБлока(Файл.Ключ, Строка(Настройки.ВариантыКлюч),
					Настройки.ВариантыИмя, ВариантПроцессыКлиентСервер_Ei.Свойства().Код, Файл.Синоним, "", Файл.Владелец);
				Результат.Добавить(ФормаНабораКлиент_Ei.ДобавитьБлок(ОбщаяФорма, ОписаниеБлока, Файл.Текст, Файл.Имя, ДопСвойства));
			Иначе
				Результат.Добавить(ФайлыКлиент_Ei.РезультатСохранения(Файл.Имя, Настройки.Путь, Файл.Текст, Файл.Ключ, Новый Файл(ПолноеИмя), ДопСвойства));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Читает данные варианта из главного файла: схемы в формате EDT вместе с частями процесса
// или, у сохраненного до 3.2.9.5, текстового макета со всем процессом.
//
// Параметры:
//  Путь - Строка - путь к главному файлу варианта
//
// Возвращаемое значение:
//  Структура - см. ВариантПроцессыКлиентСервер_Ei.ПодготовитьДанные
//
Функция Прочитать(Путь) Экспорт
	Если СтрЗаканчиваетсяНа(НРег(Путь), НРег(EDTКлиент_Ei.ТипыМакетов().TextDocument)) Тогда
		Результат = ОбщегоНазначенияКлиентСервер_Ei.Структурировать(ФайлыКлиент_Ei.ПрочитатьТекст(Путь));
	Иначе
		//Путь: <обработка>\Templates\<макет>\Template.scheme, состав обработки - <обработка>\<обработка>.mdo
		Разделитель = ПолучитьРазделительПути();
		ЧастиПути = СтрРазделить(Путь, Разделитель);
		ИмяОбработки = ЧастиПути.Получить(ЧастиПути.ВГраница() - 3);
		ЧастиПути.Удалить(ЧастиПути.ВГраница());
		ЧастиПути.Удалить(ЧастиПути.ВГраница());
		ЧастиПути.Удалить(ЧастиПути.ВГраница());
		ЧастиПути.Добавить(ИмяОбработки + ".mdo");
		Объекты = EDTКлиент_Ei.ОбъектыОбработки(СтрСоединить(ЧастиПути, Разделитель));
		ВиртуальныеОбъекты = Новый Массив;
		Для Каждого ОбъектКода Из Объекты Цикл
			Если ОбъектКода.Комментарий = ФормаНабораКлиент_Ei.ИмяФормы() Тогда
				ВиртуальныеОбъекты = ФормаНабораКлиент_Ei.Прочитать(ОбъектКода.ПолноеИмя, Новый Структура, Новый Структура);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Для Каждого ВиртуальныйОбъект Из ВиртуальныеОбъекты Цикл
			Объекты.Добавить(ВиртуальныйОбъект);
		КонецЦикла;
		Главный = Неопределено;
		Для Каждого Объект Из Объекты Цикл
			Если НРег(Объект.ПолноеИмя) = НРег(Путь) Тогда
				Главный = Объект;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Главный = Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Файл процесса %1 не описан в составе обработки'"), Путь);
		КонецЕсли;
		Результат = СхемаПроцессаEDTВызовСервера_Ei.ДанныеПроцесса(ОписаниеФайлаПроцесса(Главный, Объекты));
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Есть ли в процессе строки изменения относительно его файлов: тексты файлов процесса сравниваются по хэшам
// с сохраненными ссылками на файлы, см. СхемаПроцессаEDTВызовСервера_Ei.ФайлыПроцесса
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  ТекД - ДанныеФормыЭлементДерева - строка набора
//
// Возвращаемое значение:
//  Булево
//
Функция Модифицированность(Форма, ТекД) Экспорт
	Обработчик = ВариантПроцессыКлиентСервер_Ei;
	Данные = Обработчик.ПодготовитьДанные(ТекД);
	ВариантКлюч = ВариантыКлиентСервер_Ei.ПолучитьИдентификатор(ТекД.КлючНастроек, Обработчик);
	СсылкиВарианта = 0;
	Если ТипЗнч(ТекД.Файлы) = Тип("Структура") Тогда
		Для Каждого СтрФайл Из ТекД.Файлы Цикл
			Если ФайлыКлиент_Ei.КлючВариантаФайла(СтрФайл.Значение) = ВариантКлюч Тогда
				СсылкиВарианта = СсылкиВарианта + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ЗначениеЗаполнено(Данные.Инструкция) Тогда
		Файлы = СхемаПроцессаEDTВызовСервера_Ei.ФайлыПроцесса(Данные, ТекД.ИмяНабора, ТекД.КлючНастроек);
		Результат = Не Файлы.Количество() = СсылкиВарианта;
		Для Каждого Файл Из Файлы Цикл
			СсылкаНаФайл = НаборВариантовКлиент_Ei.ПолучитьСсылкуНаФайл(ТекД, Файл.Ключ);
			Хэш = Файл.Хэш;
			Если СсылкаНаФайл <> Неопределено И СсылкаНаФайл.Свойство("КлючБлока") Тогда
				Хэш = КодНабораКлиентСервер_Ei.КлючКода(ВариантАлгоритмКлиентСервер_Ei.ПолучитьВыражениеИзМодуля(Файл.Текст));
			КонецЕсли;
			Если Результат Или СсылкаНаФайл = Неопределено Или Не СсылкаНаФайл.Хэш = Хэш Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Результат = СсылкиВарианта > 0;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Запоминает в настройках пользователя, показывать ли показатели процесса строки.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  ТекД - ДанныеФормыЭлементДерева - строка набора
//
Процедура СохранитьНастройки(Форма, ТекД) Экспорт
	Настройки = Новый Структура;
	Кнопка = Форма.Элементы.Найти("ОтобразитьПоказателиПроцесса");
	Если Кнопка <> Неопределено Тогда
		Настройки.Вставить("ОтобразитьПоказателиПроцесса", Кнопка.Пометка);
	КонецЕсли;
	НастройкиПользователяКлиентСервер_Ei.СохранитьНастройкиОбработчика(ТекД, Форма.НастройкиПользователя, ВариантПроцессыКлиентСервер_Ei, Настройки);
КонецПроцедуры

// После обычного выполнения: запоминает время, ошибки и контекст обработок, показывает их на схеме.
// После выполнения в фоне показатели запоминает ход процесса, см. ПроцессыКлиент_Ei.ПоказатьХод
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  ДанныеКлиента - Соответствие из КлючИЗначение - данные обработок, см. ПроцессыКлиентСервер_Ei.ВыполнитьПроцесс
//
Процедура ПослеВыполнения(Форма, ДанныеКлиента) Экспорт
	ПоследняяОшибка = Неопределено;
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если ТипЗнч(ДанныеКлиента) = Тип("Соответствие") И ТекД <> Неопределено Тогда
		Для Каждого ДанныеЭлемента Из ДанныеКлиента Цикл
			КлючНастроекСпец = ПроцессыКлиентСервер_Ei.ПолучитьСпециальныйКлючНастроек(ТекД.КлючНастроек, ДанныеЭлемента.Ключ);
			ИнфоОбОшибке = ДанныеЭлемента.Значение.ИнфоОбОшибке;
			НастройкиПользователяКлиентСервер_Ei.СохранитьЗатраченноеВремя(КлючНастроекСпец, Форма.НастройкиПользователя,
				ВариантПроцессыКлиентСервер_Ei, ДанныеЭлемента.Значение.ВремяВыполнения);
			// Ошибка устанавливается или очищается прежняя
			КэшПользователяКлиентСервер_Ei.СохранитьОшибку(КлючНастроекСпец, Форма.КэшПользователя, ВариантПроцессыКлиентСервер_Ei, ИнфоОбОшибке);
			КэшПользователяКлиентСервер_Ei.СохранитьКонтекст(КлючНастроекСпец, Форма.КэшПользователя, ВариантПроцессыКлиентСервер_Ei,
				ДанныеЭлемента.Значение.Контекст);
			Если ИнфоОбОшибке <> Неопределено Тогда
				ПоследняяОшибка = ИнфоОбОшибке;
			КонецЕсли;
		КонецЦикла;
		Если ПоследняяОшибка <> Неопределено Тогда
			ВариантПроцессыКлиентСервер_Ei.ОбработкаОшибокВыполнения(Форма, Неопределено, ПоследняяОшибка);
		КонецЕсли;
	КонецЕсли;
	Если ПоследняяОшибка <> Неопределено И Не Форма.Элементы.ОтобразитьПоказателиПроцесса.Пометка Тогда
		// Была ошибка: показатели показываются сразу
		ПроцессыКлиент_Ei.ОтобразитьПоказателиПроцесса(Форма, Истина);
	Иначе
		// и без показателей: на схеме не должно остаться хода прежнего фонового запуска
		ПроцессыКлиент_Ei.ОбновитьВыполненнуюСхему(Форма, ТекД);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание схемы процесса с текстами ее файла и файлов ее частей для сборки процесса на сервере,
// см. СхемаПроцессаEDTВызовСервера_Ei.ДанныеПроцесса. Части схемы - объекты с ее ключом в комментарии
//
// Параметры:
//  Объект - см. EDTКлиент_Ei.ОбъектыОбработки - макет схемы
//  Объекты - см. EDTКлиент_Ei.ОбъектыОбработки
//
// Возвращаемое значение:
//  см. СхемаПроцессаEDTВызовСервера_Ei.ДанныеПроцесса.Описание
//
Функция ОписаниеФайлаПроцесса(Объект, Объекты)
	Результат = Новый Структура("Ключ, Имя, Синоним, Текст, Форма, ТипМакета", Объект.Ключ, Объект.Имя, Объект.Синоним,
		ФайлыКлиент_Ei.ПрочитатьТекст(Объект.ПолноеИмя), Объект.Форма, Объект.ТипМакета);
	Результат.Вставить("Части", Новый Массив);
	Комментарий = EDTКлиент_Ei.КомментарийЧасти(Объект.Ключ);
	Для Каждого Часть Из Объекты Цикл
		Если Не Часть.Комментарий = Комментарий Или Часть.Ключ = Объект.Ключ Тогда
			Продолжить;
		КонецЕсли;
		Если Часть.ТипМакета = "GraphicalSchema" Тогда
			Результат.Части.Добавить(ОписаниеФайлаПроцесса(Часть, Объекты));
		Иначе
			Описание = Новый Структура("Ключ, Имя, Синоним, Текст, Форма, ТипМакета", Часть.Ключ, Часть.Имя, Часть.Синоним,
				ТекстЧастиПроцесса(Часть), Часть.Форма, Часть.ТипМакета);
			Описание.Вставить("Части", Новый Массив);
			Результат.Части.Добавить(Описание);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Загружает из настроек пользователя, показывать ли показатели процесса строки.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  ТекД - ДанныеФормыЭлементДерева - строка набора
//
Процедура ЗагрузитьНастройки(Форма, ТекД)
	ОтобразитьПоказатели = Неопределено;
	Настройки = НастройкиПользователяКлиентСервер_Ei.ПолучитьНастройкиОбработчика(ТекД, Форма.НастройкиПользователя, ВариантПроцессыКлиентСервер_Ei);
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Настройки.Свойство("ОтобразитьПоказателиПроцесса", ОтобразитьПоказатели);
	КонецЕсли;
	Форма.Элементы.ОтобразитьПоказателиПроцесса.Пометка = (ОтобразитьПоказатели = Истина);
КонецПроцедуры

// Командная панель процесса: вставка - кнопками в панели, выравнивание и перемещение - в «Еще».
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  КонтейнерКП - ГруппаФормы - командная панель варианта
//
Процедура ИзменитьОтображениеКнопокМеню(Форма, КонтейнерКП)
	Приставка = "Процессы_ГрафСхема";
	ГруппаКнопок = КонтейнерКП.ПодчиненныеЭлементы.Найти(Приставка + "Вставить");
	Если ГруппаКнопок <> Неопределено Тогда
		ГруппаКнопок.Вид = ВидГруппыФормы.ГруппаКнопок; // по умолчанию подменю
		ОбщегоНазначенияКлиентСервер_Ei.УстановитьОтображениеДляКнопок(ГруппаКнопок, ПоложениеКнопкиВКоманднойПанели.ВКоманднойПанели);
	КонецЕсли;
	ГруппаКнопок = КонтейнерКП.ПодчиненныеЭлементы.Найти(Приставка + "Выравнивание");
	Если ГруппаКнопок <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер_Ei.УстановитьОтображениеДляКнопок(ГруппаКнопок, ПоложениеКнопкиВКоманднойПанели.ВДополнительномПодменю);
	КонецЕсли;
	ГруппаКнопок = КонтейнерКП.ПодчиненныеЭлементы.Найти(Приставка + "Переместить");
	Если ГруппаКнопок <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер_Ei.УстановитьОтображениеДляКнопок(ГруппаКнопок, ПоложениеКнопкиВКоманднойПанели.ВДополнительномПодменю);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

// Текст части из общей формы или прежнего самостоятельного файла.
Функция ТекстЧастиПроцесса(Часть)
	Если Часть.Свойство("КодБлока") Тогда
		Результат = ВариантАлгоритмКлиентСервер_Ei.ПодготовитьМодуль(
			ВыполнитьКлиентСервер_Ei.ПолучитьМодуль(Часть.КодБлока));
	Иначе
		Результат = ФайлыКлиент_Ei.ПрочитатьТекст(Часть.ПолноеИмя);
	КонецЕсли;
	Возврат Результат;
КонецФункции

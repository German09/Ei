// ПРОЦЕДУРЫ - ИНТЕРФЕЙСА ВАРИАНТОВ КОНСТРУКТОРА 
#Область ИнтерфейсВариантов

Процедура Инициализировать(Форма, Контейнер, РодительРеквизитов = Неопределено) Экспорт
	Перем ПереопредПутиРеквизитов;
	ФормаРодитель 		= ПолучитьФорму(ПроцессыКлиент_Ei.ИмяМодальнойФормы());
	Если Не РодительРеквизитов = Неопределено Тогда
		ПереопредПутиРеквизитов  = Новый Соответствие;
		ПереопредПутиРеквизитов.Вставить("ДоступныеОбработки",	РодительРеквизитов);
		ПереопредПутиРеквизитов.Вставить("ГрафСхемаXDTO",		РодительРеквизитов);		
		ПереопредПутиРеквизитов.Вставить("Процессы_Объект",		РодительРеквизитов);
	КонецЕсли;	
	НаследованиеФормКлиент_Ei.Дополнить(ФормаРодитель,Форма,Контейнер,ПереопредПутиРеквизитов);	
КонецПроцедуры

Процедура ПриИзмененииДанных(Форма) Экспорт
	Кнопка = Форма.Элементы.Найти("ОтобразитьПоказателиПроцесса");
	Если Не Кнопка = Неопределено Тогда
		ПроцессыКлиент_Ei.ОтобразитьПоказателиПроцесса(Форма,Кнопка.Пометка);
	КонецЕсли;		
Конецпроцедуры

//Возникает при переходе на закладку обработчика, уместо единоразово выполнить инициализациюю чтобы не делать это при старте для всех обработчиков сразу
//
Процедура ПриОтображении(Форма) Экспорт
	ПараметрыКлиент_Ei.ИзменитьВидимость(Форма,Ложь);
	Обработчик 	= ВариантПроцессыКлиентСервер_Ei;
	Заполнитель = КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,Обработчик);	
	Если Заполнитель.Видимость Тогда
		Заполнитель.Видимость = Ложь;
		РодительРеквизитов 	= КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента();
		Контейнер 			= КонструкторКлиентСервер_Ei.Контейнер(Форма,Обработчик);
		Инициализировать(Форма, Контейнер, РодительРеквизитов);
		//Вызовем при изменении, а то из за того что не было элементов формы возможно нечего было обновлять
		ПриИзмененииДанных(Форма);	
	КонецЕсли;	
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		ОбработкиКлиент_Ei.ЗагрузитьОбработки(ТД.ДоступныеОбработки.ПолучитьЭлементы());
		ЗагрузитьНастройки(Форма,ТД);
		ПроцессыКлиент_Ei.ОбновитьЗаголовокОбъекта(Форма,ТД);
	КонецЕсли;	
Конецпроцедуры

Процедура ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	Если Не СобытиеОтладки = Неопределено Тогда
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
	КонецЕсли;	
	ОтладкаКлиент_Ei.ПоказатьИсключение(Форма,ИнфоОбОшибке,ВариантыКлиентСервер_Ei,ВариантПроцессыКлиентСервер_Ei);
КонецПроцедуры

Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ПроцессыКлиент_Ei.ВыделитьОшибкуВПроцессе(Форма,Элемент);	
КонецПроцедуры

Функция ПолучитьРазмерность(Форма,ТД) Экспорт
	Возврат ПроцессыКлиентСервер_Ei.ПолучитьУправялющиеЭлементы(Форма.Процессы_ГрафСхема).Количество();
КонецФункции

// Сохранить данные настройки на диск в формате EDT
// 
// Параметры:
//  Путь - Строка 	- Путь к папаке src
//  НаборИмя 		- Строка - Имя варианта набора
//  НаборКлюч 		- УникальныйИдентификатор - Ключ варината набора 
//  Данные			- ФиксированнаяСтруктура - Фиксированная структура подготовленная функцией ПодготовитьДанные()  
Асинх Процедура Сохранить(Путь, НаборИмя, НаборКлюч, Данные) Экспорт
	ФайлыКлиент_Ei.СохранитьОбщее(ВариантПроцессыКлиентСервер_Ei,Путь, НаборИмя, НаборКлюч, Данные);
КонецПроцедуры
	

#КонецОбласти

Процедура ЗагрузитьНастройки(Форма,ТД)
	Перем ОтобразитьПоказателиПроцесса;
	Настройки = НастройкиПользователяКлиентСервер_Ei.ПолучитьНастройкиОбработчика(ТД,Форма.НастройкиПользователя,ВариантПроцессыКлиентСервер_Ei);
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Настройки.Свойство("ОтобразитьПоказателиПроцесса",ОтобразитьПоказателиПроцесса);		
	КонецЕсли;
	Форма.Элементы.ОтобразитьПоказателиПроцесса.Пометка = (ОтобразитьПоказателиПроцесса = Истина);		
КонецПроцедуры

Процедура СохранитьНастройки(Форма,ТД) Экспорт 
	Настройки = Новый Структура; 
	ЭлементФормы = Форма.Элементы.Найти("ОтобразитьПоказателиПроцесса");
	Если Не ЭлементФормы = Неопределено Тогда
		Настройки.Вставить("ОтобразитьПоказателиПроцесса",ЭлементФормы.Пометка);			
	КонецЕсли;	
	НастройкиПользователяКлиентСервер_Ei.СохранитьНастройкиОбработчика(ТД,Форма.НастройкиПользователя,ВариантПроцессыКлиентСервер_Ei,Настройки);
КонецПроцедуры	

Процедура ПослеВыполнения(Форма,ДанныеКлиента) Экспорт
	Перем ПоследняяОшибка;
	ТД 			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если ТипЗнч(ДанныеКлиента) =  Тип("Соответствие") Тогда
		Если Не ТД = Неопределено Тогда
			Для Каждого Эл ИЗ ДанныеКлиента Цикл
				КлючНастроекСпец	= ПроцессыКлиентСервер_Ei.ПолучитьСпециальныйКлючНастроек(ТД.КлючНастроек,Эл.Ключ); 
				ВремяВыполнения 	= Эл.Значение.ВремяВыполнения;
				ИнфоОбОшибке 		= Эл.Значение.ИнфоОбОшибке;
				Объект_Процессы_Ei	= Эл.Значение.Контекст;
				НастройкиПользователяКлиентСервер_Ei.СохранитьЗатраченноеВремя(КлючНастроекСпец,Форма.НастройкиПользователя,ВариантПроцессыКлиентСервер_Ei,ВремяВыполнения);
				КэшПользователяКлиентСервер_Ei.СохранитьОшибку(КлючНастроекСпец,Форма.КэшПользователя, ВариантПроцессыКлиентСервер_Ei, ИнфоОбОшибке);	//установим ошибку или очистим ранее установленную
				КэшПользователяКлиентСервер_Ei.СохранитьКонтекст(КлючНастроекСпец,Форма.КэшПользователя, ВариантПроцессыКлиентСервер_Ei, Объект_Процессы_Ei);
				Если Не ИнфоОбОшибке = Неопределено Тогда
					ПоследняяОшибка = ИнфоОбОшибке;	
				КонецЕсли;			
			КонецЦикла;
			Если Не ПоследняяОшибка = Неопределено Тогда
				ВариантПроцессыКлиентСервер_Ei.ОбработкаОшибокВыполнения(Форма,Неопределено,ПоследняяОшибка);
			КонецЕсли;	
		КонецЕсли;			
	КонецЕсли;
	//покажем новую схему
	Если Форма.Элементы.ОтобразитьПоказателиПроцесса.Пометка Тогда	
		Форма.Процессы_ГрафСхема = ПроцессыКлиент_Ei.ПолучитьВыполненнуюСхему(ТД,Форма, Форма.КэшПользователя, Истина);
	ИначеЕсли Не ПоследняяОшибка = Неопределено Тогда 
		//Ошибка была покажем сразу все подробности если не показали до этого
		ПроцессыКлиент_Ei.ОтобразитьПоказателиПроцесса(Форма,Истина);		
	КонецЕсли;	
КонецПроцедуры	



#Область ПрограммныйИнтерфейс

// Заполняет форму обработки «Алгоритм» из настройки и инициализирует редактор кода.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма обработки «Алгоритм»
//
Процедура Инициализация(Форма) Экспорт
	ЗаполнитьЗначенияСвойств(Форма,ОбработкаАлгоритмКлиентСервер_Ei.ПолучитьДанныеНастройки(Форма.Параметры.Настройка));	
	Форма.Алгоритм = РедакторКодаКлиент_Ei.Инициализация();
КонецПроцедуры

// Выделяет в тексте алгоритма место ошибки, указанной в элементе.
//
// Параметры:
//  Форма 	- ФормаКлиентскогоПриложения - форма обработки «Алгоритм»
//  Элемент - ДекорацияФормы - элемент с текстом ошибки
//
Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ЭлементИнструкции = ОбщегоНазначенияКлиент_Ei.ЭлементИнструкции(Форма);	
	Если Не ЭлементИнструкции = Неопределено Тогда
		ТекстМодуляКлиент_Ei.ВыделитьОшибкуВТексте(Форма,Элемент,ЭлементИнструкции);
	КонецЕсли;			
КонецПроцедуры

#Область Редактор_кода

// Обрабатывает нажатие в поле редактора кода: изменение текста или действие редактора.
//
// Параметры:
//  Форма 				- ФормаКлиентскогоПриложения - форма обработки «Алгоритм»
//  Элемент 			- ПолеФормы - поле HTML-документа редактора кода
//  ДанныеСобытия 		- ФиксированнаяСтруктура - данные события поля HTML-документа
//  СтандартнаяОбработка - Булево - признак стандартной обработки события
//
Процедура ПриНажатии(Форма,Элемент, ДанныеСобытия, СтандартнаяОбработка) Экспорт
	Событие=ДанныеСобытия.Event.eventData1C;
	Если Не Событие=Неопределено И Событие.event="EVENT_CONTENT_CHANGED" Тогда
		ПриИзменении(Форма,Элемент);
	Иначе		
		РедакторКодаКлиент_Ei.ПолеHTML_ПриНажатии(Форма, Элемент, ДанныеСобытия, СтандартнаяОбработка, ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

// Обрабатывает окончание загрузки редактора кода и выводит в него текст алгоритма.
//
// Параметры:
//  Форма 	- ФормаКлиентскогоПриложения - форма обработки «Алгоритм»
//  Элемент - ПолеФормы - поле HTML-документа редактора кода
//
Процедура ДокументСформирован(Форма,Элемент) Экспорт
	РедакторКодаКлиент_Ei.ПолеHTML_ДокументСформирован(Форма, Элемент);
	ПриИзмененииДанных(Форма); //выполняется только один раз при загрузке
КонецПроцедуры

#КонецОбласти

// Переносит текст из редактора кода в реквизит ТекстМодуля и пересчитывает модифицированность.
//
// Параметры:
//  Форма 				- ФормаКлиентскогоПриложения - форма обработки «Алгоритм»
//  ЭлементИнструкции 	- ПолеФормы - поле редактора кода
//
Процедура ПриИзменении(Форма,ЭлементИнструкции) Экспорт
	Форма.ТекстМодуля =  РедакторКодаКлиент_Ei.ПолучитьТекст(ЭлементИнструкции);
	ОбработкиКлиент_Ei.ВычислитьМодифицированность(ОбработкаАлгоритмКлиентСервер_Ei,Форма);	
КонецПроцедуры

// Выводит реквизит ТекстМодуля в редактор кода, если редактор доступен.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма обработки «Алгоритм»
//
Процедура ПриИзмененииДанных(Форма) Экспорт
	ЭлементИнструкции = ОбщегоНазначенияКлиент_Ei.ЭлементИнструкции(Форма);	
	Если Не ЭлементИнструкции = Неопределено И ЭлементИнструкции.Доступность Тогда
		РедакторКодаКлиент_Ei.ЗаменитьТекст(ЭлементИнструкции,Форма.ТекстМодуля);
	КонецЕсли;
КонецПроцедуры

// Показывает переменные, доступные в алгоритме.
//
// Параметры:
//  Форма 	- ФормаКлиентскогоПриложения - форма обработки «Алгоритм»
//  Команда - КомандаФормы - выполняемая команда
//
Процедура ДоступныеПеременные(Форма,Команда) Экспорт
	СтрПараметры 	= ОбщегоНазначенияКлиент_Ei.ПолучитьСтруктуруПеременных(Форма.ВладелецФормы,Неопределено);
	ПроцессыКлиент_Ei.ДополнитьПеременнымиОбработки(СтрПараметры.ДоступныеСтруктуры,Форма.ВладелецФормы);
	ФормаРодитель 	= ВыборКлиент_Ei.НаследоватьВыбор(Форма,Форма.Элементы.Выбор,Форма.Элементы.Выбор);
	ЭлементИнструкции = ОбщегоНазначенияКлиент_Ei.ЭлементИнструкции(Форма);	
	Если Не ЭлементИнструкции = Неопределено Тогда
		ТекстМодуляКлиент_Ei.ПоказатьДоступныеПеременные(Форма,ЭлементИнструкции,СтрПараметры,ФормаРодитель.Выбор);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

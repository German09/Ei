
#Область ПрограммныйИнтерфейс

//Запоминаем вероятно мутабельное значение
Процедура ЗапомнитьМутабельные(Ссылка,Значение) Экспорт
	#Если Клиент Тогда
		//сохраним КЭШ именно на сервере тогда он будет доступен и на клиенте и на сервере см. https://its.1c.ru/db/metod8dev/content/4594/hdoc
		Попытка
			КэшПользователяВызовСервера_Ei.Запомнить(Ссылка,Значение);
		Исключение
			//это значение невозможно передать на сервер например объект ОбъектXDTO
			ВызватьИсключение "Невозможно значение передать на сервер";
		КонецПопытки;			
	#Иначе	
		Запомнить(Ссылка,Значение);			
	#КонецЕсли		
КонецПроцедуры

Процедура Запомнить(Ссылка,Значение) Экспорт
	Ссылка	= Новый УникальныйИдентификатор; //переданный уникальный идентифкатор не используем поскольку там м.б. НЕ уникальный идентифкатор формы
	КэшПользователяКлиентСерверПовтИсп_Ei.Значения().Вставить(Ссылка,Значение);
	//обнулим значение
	Значение = Неопределено;
КонецПроцедуры			


#Область ОписаниеРезультата

Функция ОписаниеРезультата(ТД,ВидОбработчика)
	Возврат "Результат"+ВидОбработчика + ПользовательКлиентСервер_Ei.ПодготовитьКлючНастроек(ТД);	
КонецФункции	

Функция ПолучитьОписаниеРезультата(ТД,КэшПользователя,ВидОбработчика) Экспорт
	Ключ = ОписаниеРезультата(ТД,ВидОбработчика); 
	Возврат ПользовательКлиентСервер_Ei.Получить(Ключ, КэшПользователя);	
КонецФункции	

Процедура СохранитьОписаниеРезультата(ТД,КэшПользователя,ВидОбработчика,Значение) Экспорт
	Ключ = ОписаниеРезультата(ТД,ВидОбработчика);
	ПользовательКлиентСервер_Ei.Сохранить(Ключ, КэшПользователя, Значение); 		
КонецПроцедуры

#КонецОбласти


#Область ОписаниеРезультата

Функция ОписаниеРезультата(ТД,ВидОбработчика)
	Возврат "Результат"+ВидОбработчика + ПользовательКлиентСервер_Ei.ПодготовитьКлючНастроек(ТД);	
КонецФункции	

Функция ПолучитьОписаниеРезультата(ТД,КэшПользователя,ВидОбработчика) Экспорт
	Ключ = ОписаниеРезультата(ТД,ВидОбработчика); 
	Возврат ПользовательКлиентСервер_Ei.Получить(Ключ, КэшПользователя);	
КонецФункции	

Процедура СохранитьОписаниеРезультата(ТД,КэшПользователя,ВидОбработчика,Значение) Экспорт
	Ключ = ОписаниеРезультата(ТД,ВидОбработчика);
	ПользовательКлиентСервер_Ei.Сохранить(Ключ, КэшПользователя, Значение); 		
КонецПроцедуры

#КонецОбласти


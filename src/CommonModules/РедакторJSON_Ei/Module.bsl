Функция Инициализация() Экспорт
	Возврат "https://german09.github.io/json/index.html";
КонецФункции	

Процедура Наследовать(Форма, Обработчик, Контейнер) Экспорт
	Имя 			= Обработчик.Свойства().Имя;
	ФормаРодитель 	= ПолучитьФорму("ОбщаяФорма.РедакторJSON_Ei");
	КонтейнерКП		= КонструкторКлиентСервер_Ei.КонтейнерКП(Форма,Обработчик);
	НаследованиеФормКлиент_Ei.Дополнить(ФормаРодитель,Форма,Контейнер,,КонтейнерКП);//,ПереопредПутиРеквизитов);
	Форма[Имя] 		= Инициализация();
КонецПроцедуры

Процедура УстановитьТекст(Элемент, Текст) Экспорт
	Объект 	= Документ(Элемент).getElementById("setContent");
	Если Не Объект = Неопределено Тогда
		Объект.setAttribute("text", Текст);
		Объект.click();
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьТекст(Элемент) Экспорт
	Текст = "";
	Объект 	= Документ(Элемент).getElementById("getContent");
	Если Не Объект = Неопределено Тогда
		Объект.click();
		Текст  = Объект.getAttribute("text");
	КонецЕсли;
	Возврат Текст;	
КонецФункции

Функция Документ(Элемент)
	Возврат Элемент.Документ;
КонецФункции
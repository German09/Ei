// Загружает текущую настройку, выполняется самой первой как при интерактивном открытии так и при выполнении
//
// Параметры:
//  Настройка - Строка- Настройка обработки.
//Возвращаемое значение:
//   Структура
//   	* ТекстМодуля
//   	* ВозвращаемоеЗначение
//
Функция ПолучитьДанныеНастройки(Настройка) Экспорт
	Результат = Новый Структура;
	Если Не Настройка = Неопределено Тогда
		сооНастройка 			= ОбщийМодульВызовСервера_Ei.Структурировать(Настройка,Новый Соответствие);
		Результат.Вставить("ТекстМодуля", 			сооНастройка.Получить("Algoritm.bsl"));		
	Иначе
		//настройка по умолчанию	
		//ВозврЗначениеКлиент_Ei.ПоУмолчанию(ЭтаФорма);
	КонецЕсли;
	Возврат Результат;	
КонецФункции

// Функция - получить значение, которое будет интрпретированна как настройка формы
// 
// Возвращаемое значение:
//   Соответствие из Строка
//
Функция ПолучитьНастройку(Форма) Экспорт
	Результат = Новый Соответствие;
	Результат.Вставить("Algoritm.bsl",	Форма.ТекстМодуля);
	Возврат Результат;
КонецФункции	


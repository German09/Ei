Процедура Установить(Форма) Экспорт
	ТД 			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		Вариант = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
		Если Не Вариант = Неопределено Тогда
			Вариант.УстановитьПараметры(Форма);		
		КонецЕсли;
	КонецЕсли;			
КонецПроцедуры

Процедура ВставитьПараметры(ТД, мПараметров) Экспорт
	Перем ОписаниеПараметра;
	Перем СтрокаПараметров;
	Для Каждого ОписаниеПараметра ИЗ мПараметров Цикл
			ПараметрыКлиентСервер_Ei.ДобавитьПараметр(ТД,ОписаниеПараметра);
		КонецЦикла;
		Для Каждого ОписаниеПараметра ИЗ мПараметров Цикл
			Для Каждого СтрокаПараметров ИЗ ТД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",ОписаниеПараметра.Имя)) Цикл
				Пока ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров)> мПараметров.Найти(ОписаниеПараметра) Цикл
					ТД.ПараметрыЗапроса.Сдвинуть(ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров),-1);	
				КонецЦикла;
				Пока ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров)< мПараметров.Найти(ОписаниеПараметра) Цикл
					ТД.ПараметрыЗапроса.Сдвинуть(ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров),1);	
				КонецЦикла;
				Прервать;
			КонецЦикла;	
		КонецЦикла;
КонецПроцедуры

Процедура ИзменитьВидимость(Форма,Видимость) Экспорт
	Форма.Элементы.ДеревоЗапросовПараметрыЗапроса.Видимость = Видимость;
КонецПроцедуры	
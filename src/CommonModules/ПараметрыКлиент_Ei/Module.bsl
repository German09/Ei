#Область ПрограммныйИнтерфейс

// Коллекция параметров.
// 
// Параметры:
//  Форма 	см. Обработка.Ei.Форма.Форма
// 
// Возвращаемое значение:
//  ТаблицаФормы - Коллекция параметров
Функция КоллекцияПараметров(Форма) Экспорт
	Возврат Форма.Элементы.Найти("ДеревоЗапросовПараметрыЗапроса");
КонецФункции	

#Область ОбработчикиКоманд

// Приводит к вызову
// См. ВставитьПараметры
// 
// Параметры:
//  Форма 	см. Обработка.Ei.Форма.Форма
//  Команда - КомандаФормы
Процедура Установить(Форма,Команда = Неопределено) Экспорт
	ТекД 			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТекД = Неопределено Тогда
		Вариант = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТекД);
		Если Не Вариант = Неопределено Тогда
			Вариант.УстановитьПараметры(Форма);		
		КонецЕсли;
	КонецЕсли;			
КонецПроцедуры

// В список.
// 
// Параметры:
//  Форма 	см. Обработка.Ei.Форма.Форма
//  Команда - КомандаФормы
Процедура ВСписок(Форма,Команда) Экспорт
	ТекД = КоллекцияПараметров(Форма).ТекущиеДанные;
	Если НЕ ТекД = Неопределено И Не ТекД.ЭтоВыражение Тогда
		Если ТипЗнч(ТекД.ЗначениеПараметра) = Тип("СписокЗначений") Тогда
			Для Каждого ЭлСЗ ИЗ ТекД.ЗначениеПараметра Цикл
				ТекД.ЗначениеПараметра = ЭлСЗ.Значение;
				Прервать;
			КонецЦикла;	
		Иначе	
			Список = Новый СписокЗначений;
			Если ТипЗнч(ТекД.ЗначениеПараметра) = Тип("Строка") И СтрЧислоСтрок(ТекД.ЗначениеПараметра)>1 Тогда
				//многострочну строку разложим в массив строк
				Для Ном = 1 По СтрЧислоСтрок(ТекД.ЗначениеПараметра) Цикл	
					Список.Добавить(СтрПолучитьСтроку(ТекД.ЗначениеПараметра,Ном));
				КонецЦикла;	
			Иначе	
				Список.Добавить(ТекД.ЗначениеПараметра);
			КонецЕсли;	
			ТекД.ЗначениеПараметра = Список;
		КонецЕсли;
		КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
	КонецЕсли;	
КонецПроцедуры

// Установить период.
// 
// Параметры:
//  Форма 	см. Обработка.Ei.Форма.Форма
//  Команда - КомандаФормы
Асинх Процедура УстановитьПериод(Форма,Команда) Экспорт
	ТекД = КоллекцияПараметров(Форма).ТекущиеДанные;
	Если НЕ ТекД = Неопределено И Не ТекД.ЭтоВыражение Тогда
		ВыбранныйПериод = Новый СтандартныйПериод;
		СтрукПериода 	= ПолучитьСтруктуруПериода(Форма,ТекД);
		Если ТипЗнч(СтрукПериода) =  Тип("Структура") Тогда
			// Устанавливаем начальные данные
			ВыбранныйПериод.ДатаНачала 		= СтрукПериода.ДатаНачала.ЗначениеПараметра;
			ВыбранныйПериод.ДатаОкончания 	= СтрукПериода.ДатаОкончания.ЗначениеПараметра;
			
			Диалог = Новый ДиалогРедактированияСтандартногоПериода();
			Диалог.Период = ВыбранныйПериод;
			Период =  Ждать Диалог.РедактироватьАсинх();
			Если Не Период = Неопределено Тогда
				СтрукПериода.ДатаНачала.ЗначениеПараметра 		= Период.ДатаНачала;	
				СтрукПериода.ДатаОкончания.ЗначениеПараметра 	= Период.ДатаОкончания;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

// Из буфера.
// 
// Параметры:
//  Форма 	см. Обработка.Ei.Форма.Форма
//  Команда - КомандаФормы
//
// Возвращаемое значение:
//  Строка, Неопределено - Добавленное или существующее имя параметра
Асинх Функция ИзБуфера(Форма,Команда) Экспорт
	Текст = Ждать ОбщегоНазначенияКлиент_Ei.ТекстИзБуфераОбмена();
	Если ЗначениеЗаполнено(Текст) Тогда
		// ссылка на параметр Ei - не значение, а параметр другой строки: вставляется выражение его получения
		ДанныеСсылки = НавигационныеСсылкиКлиентСервер_Ei.ДанныеСсылки(Текст);
		Если ДанныеСсылки <> Неопределено Тогда
			Возврат ИзСсылкиНаПараметр(Форма, ДанныеСсылки);
		КонецЕсли;
		//@skip-check bsl-legacy-check-expression-type
		Ссылка = ОбщегоНазначенияВызовСервера_Ei.ПолучитьСсылкуИзНавСсылки(Текст);
		Если Не Ссылка = Неопределено Тогда	
			//Попробуем найти
			ТекД 			= Форма.ПолучитьПереопределяемыйОбъектОбработки(); 
			Если Не ТекД = Неопределено Тогда
				Для Каждого Найденная ИЗ ТекД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ЗначениеПараметра",Ссылка)) Цикл
					КоллекцияПараметров(Форма).ТекущаяСтрока = Найденная.ПолучитьИдентификатор();
					Возврат Найденная.ИмяПараметра; //нашли просто активизируем	
				КонецЦикла;
			КонецЕсли;	
			//не нашли добавляем 
			Добавленная = ДобавлениеНового(Новый Структура("ИмяКандидат,ЭтоВыражение,ЗначениеПараметра","НавСсылка",Ложь,Ссылка), Форма);
			Если Не Добавленная = Неопределено Тогда
				Возврат Добавленная.ИмяПараметра;	
			КонецЕсли;	
		Иначе
			ПоказатьПредупреждение(,"В буфере обмена не найдена навигационная ссылка");			
		КонецЕсли;
	КонецЕсли;		
КонецФункции

#КонецОбласти

// Вставить параметры.
// 
// Параметры:
//  ТекД   		см. КонструкторКлиентСервер_Ei.ПолучитьПереопределяемыйОбъектОбработки
//  Параметры 	см. ПараметрыВызовСервера_Ei.ПолучитьПараметры
Процедура ВставитьПараметры(ТекД, Параметры) Экспорт
	Перем ОписаниеПараметра;
	Перем СтрокаПараметров;
	Для Каждого ОписаниеПараметра ИЗ Параметры Цикл
		ПараметрыКлиентСервер_Ei.ДобавитьПараметр(ТекД,ОписаниеПараметра);
	КонецЦикла;
	Для Каждого ОписаниеПараметра ИЗ Параметры Цикл
		Для Каждого СтрокаПараметров ИЗ ТекД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",ОписаниеПараметра.Имя)) Цикл
			Пока ТекД.ПараметрыЗапроса.Индекс(СтрокаПараметров)> Параметры.Найти(ОписаниеПараметра) Цикл
				ТекД.ПараметрыЗапроса.Сдвинуть(ТекД.ПараметрыЗапроса.Индекс(СтрокаПараметров),-1);	
			КонецЦикла;
			Пока ТекД.ПараметрыЗапроса.Индекс(СтрокаПараметров)< Параметры.Найти(ОписаниеПараметра) Цикл
				ТекД.ПараметрыЗапроса.Сдвинуть(ТекД.ПараметрыЗапроса.Индекс(СтрокаПараметров),1);	
			КонецЦикла;
			Прервать;
		КонецЦикла;	
	КонецЦикла;
КонецПроцедуры

// Вызывается обработчиком оповещения из
// См. ВыборКлиент_Ei.ПараметрыСтроки
// 
// Параметры:
//  Результат 		- Неопределено - Возвращаемый параметр
//  ДопПараметры 	- Структура - Задается в см. НаборВариантовКлиент_Ei.ДополнитьДоступныеПеременные:
//						*Аргументы	- Строка 
Процедура Параметры(Результат, ДопПараметры) Экспорт
	Результат  = Неопределено; //Получаем только из серверной процедуры одноименнная в см. ПараметрыВызовСервера_Ei
КонецПроцедуры

#Область ОбработчикиСобытий

Процедура АвтоПодбор(Форма, Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка) Экспорт
	Если Ожидание>0 и Не ПустаяСтрока(Текст) Тогда
		ТекД = КоллекцияПараметров(Форма).ТекущиеДанные;
		Если Не ТекД = Неопределено Тогда
			Ссылка = ОбщегоНазначенияВызовСервера_Ei.ПолучитьСсылкуИзНавСсылки(Текст);
			Если Не Ссылка = Неопределено Тогда
				СтандартнаяОбработка = Ложь;
				ДанныеВыбора = Новый СписокЗначений();
				ДанныеВыбора.Добавить(Ссылка);
			КонецЕсли;					
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Процедура НачалоВыбора(Форма, Элемент, СтандартнаяОбработка) Экспорт
	ТекД 						= КоллекцияПараметров(Форма).ТекущиеДанные;
	Если Не ТекД = Неопределено Тогда
		СтруктураПеременных 	= ОбщегоНазначенияКлиент_Ei.ПолучитьСтруктуруПеременных(Форма,ТекД);
		Контейнер				= Форма.Элементы.Выбор;
		ФормаРодитель 			= ВыборКлиент_Ei.НаследоватьВыбор(Форма,Контейнер,Форма.Элементы.Право);
		ВыборКлиент_Ei.ИзменитьВидимость(Форма,Ложь); //наследуем пока невидимый, дальше решаем как с ним быть, показывать или нет	
		ЗавершениеВыбора 		= Новый ОписаниеОповещения("ЗавершениеВыбора",ЭтотОбъект,Новый Структура("Форма,Идентификатор",Форма,ТекД.ПолучитьИдентификатор()));
		ВыборКлиент_Ei.НачалоВыбора(ЗавершениеВыбора,ФормаРодитель.Выбор,Форма,Элемент,СтруктураПеременных,СтандартнаяОбработка);
	КонецЕсли;	
КонецПроцедуры

Процедура Очистка(Форма, Элемент, СтандартнаяОбработка) Экспорт
	КоллекцияПараметров(Форма).ТекущиеДанные.ЗначениеПараметра =  Неопределено;
КонецПроцедуры

Процедура ЭтоВыражениеПриИзменении(Форма,Элемент) Экспорт 
	ТекД = КоллекцияПараметров(Форма).ТекущиеДанные;
	Если ТекД.ЭтоВыражение Тогда
		сНовыйАлгоритм = ТекстМодуляКлиент_Ei.ПреобразоватьЗначениеКВыражению(ТекД.ЗначениеПараметра);
		Если ТипЗнч(сНовыйАлгоритм) = Тип("Строка") Тогда
			ТекД.ЗначениеПараметра = сНовыйАлгоритм;
		Иначе
			//может вернуться неопределено, тогда мы просто ничего не посчитали
			ТекД.ЭтоВыражение = Ложь;
		КонецЕсли;	
	Иначе
		//КонтекстВыполнения 		= ВариантыКлиент_Ei.ПолучитьСтруктуруДоступныхПеременных(ЭтаФорма,Элементы.ДеревоЗапросов.ТекущиеДанные,Ложь);
        ТекД.ЗначениеПараметра 	= ВыполнитьКлиентСервер_Ei.Выражение(ТекД.ЗначениеПараметра);//,,,КонтекстВыполнения);
	КонецЕсли;
КонецПроцедуры

Процедура ПриНачалеРедактирования(Форма, Элемент, НоваяСтрока, Копирование) Экспорт
	Если НоваяСтрока Тогда
		ТекД = Элемент.ТекущиеДанные;
		Если Не Копирование Тогда
			ИмяКадидат = "Параметр";
		Иначе
			ИмяКадидат = ТекД.ИмяПараметра;
		КонецЕсли;
		ТекД.ИмяПараметра 	= ОбщегоНазначенияКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("ИмяПараметра",СокрЛП(ИмяКадидат)),Форма.ПолучитьПереопределяемыйОбъектОбработки().ПараметрыЗапроса); //вПолучитьУникальноеИмяПараметра(СокрЛП(ИмяКадидат));
		ТекД.Ключ 			= ПараметрыКлиентСервер_Ei.ПолучитьНовыйКлюч();
		КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
	КонецЕсли;
КонецПроцедуры

Процедура ПриИзменении(Форма, Элемент) Экспорт
	Если Элемент = КоллекцияПараметров(Форма) Тогда
		Набор			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
		Если Не Набор = Неопределено Тогда
			Если Набор.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра","")).Количество() Тогда
				//это добавление пустой строки, ей еще будем устанавливать имя см. ПриНачалеРедактирования
				//и только потом имеет смысл сравнивать и сохранять
			Иначе	
				КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
			КонецЕсли;
		КонецЕсли;
	Иначе
		ПриИзмененииВРедакторе(Форма, Элемент)			
	КонецЕсли;	
КонецПроцедуры

Процедура ПередОкончаниемРедактирования(Форма, Элемент, НоваяСтрока, ОтменаРедактирования, Отказ) Экспорт
	ТекД 			= КоллекцияПараметров(Форма).ТекущиеДанные;
	Набор			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не Набор = Неопределено Тогда
		Причина 		= "";
		ИмяПараметра	= СтрЗаменить(ТекД.ИмяПараметра," ","");
		Если Не ОбщегоНазначенияКлиентСервер_Ei.ВозможностьКлючСтруктуры(ИмяПараметра) Тогда
			Причина = СтрШаблон("Имя '%1' не соответствует правилу именования ключа структуры",ИмяПараметра);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Причина) Тогда
			ДублиСтрок =  Набор.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",ИмяПараметра));
			Если ДублиСтрок.Количество()> 1 Тогда
				Причина = СтрШаблон("Параметр с именем '%1' уже существует",ИмяПараметра);	
			КонецЕсли;	
		КонецЕсли;	
		Если ЗначениеЗаполнено(Причина) Тогда
			Если НоваяСтрока И ОтменаРедактирования Тогда
				//тут разрешаем отказаться 
			Иначе
				ПоказатьПредупреждение(,Причина,20,"Ошибка в имени параметра");	
				Отказ = Истина;
			КонецЕсли;	
		Иначе
			//без лишних пробелов
			Изменили = Не (ТекД.ИмяПараметра = ИмяПараметра);
			ТекД.ИмяПараметра = ИмяПараметра;
			Если Изменили Тогда
				КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры


Процедура ПроверкаПеретаскивания(Форма,Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле) Экспорт
	Если ФоновоеВыполнениеКлиент_Ei.ПараметрыЗаблокированы(Форма) Тогда
		СтандартнаяОбработка 			= Ложь;
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
		Возврат;
	КонецЕсли;	
	Если Не Строка = Неопределено Тогда
		Строка 	= Форма.ПолучитьПереопределяемыйОбъектОбработки().ПараметрыЗапроса.НайтиПоИдентификатору(Строка);
	КонецЕсли;	
	ПеретаскиваниеКлиент_Ei.ПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
КонецПроцедуры


// Перетаскивание.
// 
// Параметры:
//  Форма см. Обработка.Ei.Форма.Форма
//  Элемент Элемент
//  ПараметрыПеретаскивания Параметры перетаскивания
//  СтандартнаяОбработка Стандартная обработка
//  Строка Строка
//  Поле Поле
Процедура Перетаскивание(Форма,Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле) Экспорт
	ДобавлениеНового = Новый ОписаниеОповещения("ДобавлениеНового",ЭтотОбъект,Форма); 
	Если Не Строка = Неопределено Тогда
		Строка 			= Форма.ПолучитьПереопределяемыйОбъектОбработки().ПараметрыЗапроса.НайтиПоИдентификатору(Строка);
	КонецЕсли;	
	ПеретаскиваниеКлиент_Ei.Перетаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле, Форма, ДобавлениеНового);
КонецПроцедуры

// Открытие.
// 
// Параметры:
//  Форма см. Обработка.Ei.Форма.Форма
//  Элемент  - ПолеФормы
//  СтандартнаяОбработка - Булево
Процедура Открытие(Форма, Элемент, СтандартнаяОбработка) Экспорт
	ТекД = КоллекцияПараметров(Форма).ТекущиеДанные;
	Если ТекД.ЭтоВыражение Тогда
		СтандартнаяОбработка =  Ложь;
		ЗавершениеРедактированияАлгоритма 	= Новый ОписаниеОповещения("ЗавершениеРедактированияАлгоритма",ЭтотОбъект,Новый Структура("Форма,Идентификатор",Форма,ТекД.ПолучитьИдентификатор()));
		ФормаВыражения = ОткрытьФорму("ОбщаяФорма.ПараметрыАлгоритм_Ei", Новый Структура("Имя,ТекстМодуля",ТекД.ИмяПараметра,ТекД.ЗначениеПараметра),Форма,,,,ЗавершениеРедактированияАлгоритма,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
		Если Не ФормаВыражения = Неопределено И ФоновоеВыполнениеКлиент_Ei.ПараметрыЗаблокированы(Форма) Тогда
			ФормаВыражения.ТолькоПросмотр = Истина; //выражение можно посмотреть, но не изменить
		КонецЕсли;	
	КонецЕсли;		
КонецПроцедуры

#КонецОбласти

	

// Функция обратная
// См. ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру
// 
// Параметры:
//  Строка  		- ДанныеФормыЭлементДерева - Элемент набора 
//  СтрПараметров 	- Массив ИЗ см. ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру
//  Каталог			- Строка
//  ИмяПроекта 		- Строка
Процедура ЗагрузитьДанные(Строка,СтрПараметров,Каталог,ИмяПроекта) Экспорт
	Для Каждого ЭлСтруктуры ИЗ 	стрПараметров Цикл
		НовыйПараметр = Строка.ПараметрыЗапроса.Добавить();
		НовыйПараметр.ИмяПараметра 		= ЭлСтруктуры.Ключ;
		НовыйПараметр.ЭтоВыражение 		= ЭлСтруктуры.Значение.ЭтоВыражение;
		//ключ из файла сохраняем: по нему файл параметра связан с параметром, см. НайтиПараметр
		КлючИзФайла = Неопределено;
		ЭлСтруктуры.Значение.Свойство("Ключ", КлючИзФайла);
		НовыйПараметр.Ключ 				= ?(ЗначениеЗаполнено(КлючИзФайла), КлючИзФайла, ПараметрыКлиентСервер_Ei.ПолучитьНовыйКлюч());
		НовыйПараметр.ЗначениеПараметра	= ЗначениеИзФайла(НовыйПараметр.ЭтоВыражение, ЭлСтруктуры.Значение.ЗначениеПараметра);
	КонецЦикла;		
КонецПроцедуры	

// Параметр набора, которому принадлежит сохраненный файл
// 
// Параметры:
//  СтрокаНабора 	- ДанныеФормыЭлементДерева - строка дерева наборов
//  КлючФайла 		- Строка - ключ из ссылки на файл см. ФайлыКлиент_Ei.РезультатСохранения
// 
// Возвращаемое значение:
//  ДанныеФормыЭлементКоллекции, Неопределено - строка ПараметрыЗапроса или Неопределено, если файл не параметра
Функция НайтиПараметр(СтрокаНабора, КлючФайла) Экспорт
	Результат = Неопределено;
	Для Каждого Параметр Из СтрокаНабора.ПараметрыЗапроса Цикл
		Если Строка(ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(СтрокаНабора.КлючНастроек, Параметр.Ключ)) = КлючФайла Тогда
			Результат = Параметр;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Признак, что файл параметра - модуль формы (параметр-выражение), а не макет со значением
// 
// Параметры:
//  СсылкаНаФайл - см. ФайлыКлиент_Ei.РезультатСохранения
// 
// Возвращаемое значение:
//  Булево
Функция ЭтоФайлВыражения(СсылкаНаФайл) Экспорт
	Возврат СтрНачинаетсяС(СсылкаНаФайл.Окончание, EDTКлиент_Ei.ТипыМетаданных().Формы + "\");
КонецФункции

// Есть ли у параметра несохраненные изменения относительно его файла
// 
// Параметры:
//  Параметр 		- ДанныеФормыЭлементКоллекции - строка ПараметрыЗапроса
//  СсылкаНаФайл 	- см. ФайлыКлиент_Ei.РезультатСохранения
//  ИмяОбработки 	- Строка - имя обработки набора: текст формы выражения ссылается на модуль объекта, см. СодержимоеФайла
// 
// Возвращаемое значение:
//  Булево
Функция Модифицированность(Параметр, СсылкаНаФайл, ИмяОбработки = "") Экспорт
	Если Не Параметр.ЭтоВыражение = ЭтоФайлВыражения(СсылкаНаФайл) Тогда
		Результат = Истина; //тип параметра сменили после сохранения
	ИначеЕсли СсылкаНаФайл.Свойство("КлючБлока") Тогда
		Результат = СсылкаНаФайл.Хэш <> КодНабораКлиентСервер_Ei.КлючКода(Параметр.ЗначениеПараметра);
	Иначе
		Строки = Новый Массив;
		Строки.Добавить(Параметр);
		//в файл параметр пишется в виде ПолучитьСтруктуру, она же готовит значение к сохранению
		СтруктураПараметра	= ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру(Строки)[Параметр.ИмяПараметра];
		Содержимое			= СодержимоеФайла(СтруктураПараметра, ИмяОбработки, Параметр.ИмяПараметра);
		Результат			= Не СсылкаНаФайл.Хэш = ОбщегоНазначенияВызовСервера_Ei.ПолучитьХешСтроки(Содержимое);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Загрузить параметр из текста его файла; тип параметра определяется видом файла
// 
// Параметры:
//  Параметр 		- ДанныеФормыЭлементКоллекции - строка ПараметрыЗапроса
//  СсылкаНаФайл 	- см. ФайлыКлиент_Ei.РезультатСохранения
//  Текст 			- Строка - текст файла параметра
Процедура ЗагрузитьИзФайла(Параметр, СсылкаНаФайл, Текст) Экспорт
	Параметр.ЭтоВыражение		= ЭтоФайлВыражения(СсылкаНаФайл);
	Параметр.ЗначениеПараметра	= ЗначениеИзФайла(Параметр.ЭтоВыражение, Текст);
КонецПроцедуры

Процедура ОбновитьКлючи(ТекД) Экспорт
	Для Каждого Параметр ИЗ ТекД.ПараметрыЗапроса Цикл
		Параметр.Ключ = ПараметрыКлиентСервер_Ei.ПолучитьНовыйКлюч();		
	КонецЦикла;		
КонецПроцедуры

// Признак в идентификаторе определяющий параметр
// 
// Возвращаемое значение:
//  Строка 
Функция ПризнакВКомментраии() Экспорт
	Возврат "Параметр"; 	
КонецФункции	

#Область Сохранение_Чтение

// Сохранить в каталог исходников EDT параметр. 
// Либом как общий модуль если параметр является вычисляемым либо как макет если задано его значение
// Чтение  см. ЗаполнитьИзXDTO
// 
// Параметры:
//  ПутьИсходники 	- Строка - Путь к каталогу  исходников
//  Набор 			- см. ВариантыКлиентСервер_Ei.ПолучитьВариант
//  ИмяОбработки	- Неопределено,Строка - Имя обработки
// 
// Возвращаемое значение:
//  Массив Из см. ФайлыКлиент_Ei.РезультатСохранения
//
Асинх Функция СохранитьВКаталог(ПутьИсходники, Набор, ИмяОбработки = "", ОбщаяФорма = Неопределено) Экспорт
	Результат = Новый Массив;
	Для Каждого фСтрПараметра ИЗ Набор.Параметры Цикл
		Параметр	= фСтрПараметра.Значение; 
		Ключ 		= Строка(ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(Набор.КлючНастроек,Параметр.Ключ));
		ИмяПараметра= фСтрПараметра.Ключ;
		Имя 		= СтрШаблон("%1_%2_%3",Набор.Имя,ПризнакВКомментраии(),ИмяПараметра);
		ДопСвойства = Новый Структура("Синоним",ИмяПараметра);
		сСодержание	= СодержимоеФайла(Параметр, ИмяОбработки, ИмяПараметра);
		Если Параметр.ЭтоВыражение И ОбщаяФорма <> Неопределено Тогда
			ОписаниеБлока = КодНабораКлиентСервер_Ei.ОписаниеБлока(Ключ, Строка(Набор.КлючНастроек), Набор.Имя, "",
				ИмяПараметра, Параметр.Ключ);
			ДопСвойства.Вставить("Комментарий", ПризнакВКомментраии());
			Результат.Добавить(ФормаНабораКлиент_Ei.ДобавитьБлок(ОбщаяФорма, ОписаниеБлока, сСодержание, Имя, ДопСвойства));
			Продолжить;
		ИначеЕсли Параметр.ЭтоВыражение Тогда
			ПолноеИмя	= Ждать EDTКлиент_Ei.СоздатьФормуОбработки(ПутьИсходники, сСодержание, Имя, Ключ, ИмяПараметра, ИмяОбработки);
		Иначе
			ТипМакета =  "TextDocument";
			ДопСвойства.Вставить("ТипМакета", ТипМакета);
			ПолноеИмя	= Ждать EDTКлиент_Ei.СоздатьМакетОбработки(ПутьИсходники, сСодержание, Имя, Ключ, EDTКлиент_Ei.ТипыМакетов()[ТипМакета], ИмяПараметра);
		КонецЕсли;
		ДопСвойства.Вставить("Комментарий", ПризнакВКомментраии());
		СтрСохранения = ФайлыКлиент_Ei.РезультатСохранения(Имя, ПутьИсходники, сСодержание, Ключ, Новый Файл(ПолноеИмя), ДопСвойства);
		Результат.Добавить(СтрСохранения);						
	КонецЦикла;
	Возврат Результат; 
КонецФункции

// Текст файла, в который сохраняется параметр: модуль формы для выражения или сериализованное значение для макета.
// Значение, которое хранится в параметре строкой XML (таблица значений), записывается этим XML, без второй сериализации,
// см. ПараметрыВызовСервера_Ei.СодержимоеФайлаЗначения. Обратное преобразование см. ЗначениеИзФайла.
// Тип Результат формы выражения - ссылка на Параметры__Имя() модуля объекта, где он описан по последнему вычислению,
// без имени обработки - Произвольный, см. ВариантАлгоритмКлиентСервер_Ei.ОписаниеРезультатаФормы
// 
// Параметры:
//  Параметр - ФиксированнаяСтруктура - параметр в виде см. ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру
//  ИмяОбработки - Строка - имя обработки набора
//  ИмяПараметра - Строка - имя параметра
// 
// Возвращаемое значение:
//  Строка
Функция СодержимоеФайла(Параметр, ИмяОбработки = "", ИмяПараметра = "") Экспорт
	Если Параметр.ЭтоВыражение Тогда
		ОписаниеРезультата = ВариантАлгоритмКлиентСервер_Ei.ОписаниеРезультатаФормы(?(ЗначениеЗаполнено(ИмяПараметра), ИмяОбработки, ""),
			ВариантАлгоритмКлиентСервер_Ei.ИмяФункцииПараметра(ИмяПараметра));
		Результат = ВариантАлгоритмКлиентСервер_Ei.ПодготовитьМодуль(ВыполнитьКлиентСервер_Ei.ПолучитьМодуль(Параметр.ЗначениеПараметра),
			Истина, ОписаниеРезультата);
	Иначе
		Результат = ПараметрыВызовСервера_Ei.СодержимоеФайлаЗначения(Параметр.ЗначениеПараметра);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Значение параметра из текста его файла, обратное см. СодержимоеФайла.
// Значение, которое нельзя передать на клиент (таблица значений), остается строкой XML - Ei восстанавливает его
// при вычислении. До 3.2.8.5 такие значения записывались строкой с XML внутри: из нее XML значения читается еще раз
// 
// Параметры:
//  ЭтоВыражение 	- Булево - параметр-выражение
//  Текст 			- Строка - текст файла параметра
// 
// Возвращаемое значение:
//  Строка, Произвольный - текст выражения или значение параметра
Функция ЗначениеИзФайла(ЭтоВыражение, Текст) Экспорт
	Если ЭтоВыражение Тогда
		Результат = ВариантАлгоритмКлиентСервер_Ei.ПолучитьВыражениеИзМодуля(Текст);
	Иначе
		Результат = ОбщегоНазначенияКлиентСервер_Ei.ПопыткаСтруктурировать(Текст);
		Если ТипЗнч(Результат) = Тип("Строка") И Результат <> Текст И СтрНачинаетсяС(СокрЛ(Результат), "<") Тогда
			Результат = ОбщегоНазначенияКлиентСервер_Ei.ПопыткаСтруктурировать(Результат);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции


// Прочитать параметр. Добавление в варианты всех параметров (элементов структур аналогичных см. ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру )
// 
// Параметры:
//  Элемент 		- ОбъектXDTO - 
//  НаборВаринатов 	- Структура Из см. ВариантыКлиентСервер_Ei.ПолучитьВариант
//  Объект 			- ОбъектXDTO - 
//  сооКлючей 		- Соответствие из КлючИЗначение:
//		*Ключ 		- УникальныйИдентификатор -
//		*Значение 	- Строка
//	Тип				- Строка - Имя типа метаданных, см. EDTКлиент_Ei.ТипыМетаданных 
Процедура ПрочитатьОбъект(Элемент, НаборВаринатов, Объект, СооКлючей, Тип) Экспорт
	Перем Вариант;
	Параметр = Новый Структура; //см. ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру
	КлючНастроек = ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(Элемент.uuid,Объект.uuid);
	ИмяВарианта = сооКлючей.Получить(КлючНастроек);
	Если Не ИмяВарианта = Неопределено Тогда
		Если НаборВаринатов.Свойство(ИмяВарианта,Вариант) Тогда
			Вариант.Параметры.Вставить(Элемент.synonym.value,Параметр);
			Параметр.Вставить("Ключ",			Прав(Элемент.uuid,12));
			Параметр.Вставить("ЭтоВыражение", 	(Тип = EDTКлиент_Ei.ТипыМетаданных().Формы));
			Параметр.Вставить("Путь", 			EDTКлиент_Ei.ПолучитьПуть(Тип, Элемент));
		КонецЕсли;	  
	КонецЕсли;
КонецПроцедуры

// Свойство пути указано, значит файл нужно считать
// Заменяет свойство Путь на ЗначениеПараметра
// по аналоги с см. EDTКлиент_Ei.ПрочитатьСоставОбработки
// 
// Параметры:
//  Структура  	- Структура - Формируется процедурой см. ПрочитатьОбъект
//  Каталог  	- Строка - Путь к каталогу проекта - C:\Users\g.kudiakov\Documents\Ei_Настройка\New folder (2)  
//  ИмяПроекта  - Строка - Например: Набор
//  Путь  		- Строка - относительный полный путь  - Templates\Набор_Параметр_Особенность\Template.txt
//  Ключ 		- Строка - 55a4e36a-d2be-4a18-bbb0-c13c4a1ec5c5
//  
// Возвращаемое значение:
// 	см. ФайлыКлиент_Ei.РезультатСохранения 
Функция ПрочитатьЗначение(Структура,Каталог, ИмяПроекта,Путь,Ключ) Экспорт
	Перем Результат;
	ПолноеИмя 	= СтрШаблон("%1%6%5%6%2s%6%3%6%4",Каталог,EDTКлиент_Ei.ВнешОбработка(),ИмяПроекта,Путь,ФайлыКлиентСервер_Ei.КаталогИсходников(),ПолучитьРазделительПути());
	ТекстФайла 	= ФайлыКлиент_Ei.ПрочитатьТекст(ПолноеИмя);
	Структура.Вставить("ЗначениеПараметра",ТекстФайла);
	Если Структура.Свойство("Путь") Тогда	
		Структура.Удалить("Путь");		
	КонецЕсли;
	//все сделали теперь подготовим ответ
	Файл				= Новый Файл(ПолноеИмя);
	ПутьККорневойПапаке = СтрШаблон("%1%5%4%5%2s%5%3",Каталог,EDTКлиент_Ei.ВнешОбработка(),ИмяПроекта,ФайлыКлиентСервер_Ei.КаталогИсходников(),ПолучитьРазделительПути());
	Результат 			= ФайлыКлиент_Ei.РезультатСохранения("", ПутьККорневойПапаке, ТекстФайла, Ключ, Файл); // возможно придется убрать / в конце Файл.Путь 
	Возврат Результат;
КонецФункции	

#КонецОбласти

#Область Редактор_кода
	
Процедура ПриНажатии(Форма,Элемент, ДанныеСобытия, СтандартнаяОбработка) Экспорт
	Событие=ДанныеСобытия.Event.eventData1C;
	Если Не Событие=Неопределено И Событие.event="EVENT_CONTENT_CHANGED" Тогда
		ПриИзмененииВРедакторе(Форма,Элемент);
	Иначе		
		РедакторКодаКлиент_Ei.ПолеHTML_ПриНажатии(Форма, Элемент, ДанныеСобытия, СтандартнаяОбработка, ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

Процедура ДокументСформирован(Форма,Элемент,Режим = "bsl") Экспорт
	РедакторКодаКлиент_Ei.ПолеHTML_ДокументСформирован(Форма, Элемент, Режим);
	ПриИзмененииДанных(Форма); //выполняется только один раз при загрузке
КонецПроцедуры


// Функция обратная
// См. ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру
// 
// Параметры:
//  Строка  		- ДанныеФормыЭлементДерева - Элемент набора 
//  СтрПараметров 	- Массив ИЗ см. ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру
//  Каталог			- Строка
//  ИмяПроекта 		- Строка
Процедура ЗагрузитьДанные(Строка,СтрПараметров,Каталог,ИмяПроекта) Экспорт
	Для Каждого ЭлСтруктуры ИЗ 	стрПараметров Цикл
		НовыйПараметр = Строка.ПараметрыЗапроса.Добавить();
		НовыйПараметр.ИмяПараметра 		= ЭлСтруктуры.Ключ;
		НовыйПараметр.ЭтоВыражение 		= ЭлСтруктуры.Значение.ЭтоВыражение;
		НовыйПараметр.Ключ 				= ПараметрыКлиентСервер_Ei.ПолучитьНовыйКлюч();	
		Если НовыйПараметр.ЭтоВыражение Тогда
			НовыйПараметр.ЗначениеПараметра	= ВариантАлгоритмКлиентСервер_Ei.ПолучитьВыражениеИзМодуля(ЭлСтруктуры.Значение.ЗначениеПараметра);	
		Иначе	 
			НовыйПараметр.ЗначениеПараметра	= ОбщегоНазначенияКлиентСервер_Ei.ПопыткаСтруктурировать(ЭлСтруктуры.Значение.ЗначениеПараметра);	
		КонецЕсли;	
	КонецЦикла;		


Процедура ОбновитьПараметрыТекстаЗапроса(ТД) Экспорт
	Если Не ПустаяСтрока(ТД.ТекстЗапроса) Тогда
		мПараметров = ОбщийМодульВызовСервера_Ei.ПолучитьПараметрыИзЗапроса(ТД.ТекстЗапроса);		
		Для Каждого ОписаниеПараметра ИЗ мПараметров Цикл
			вДобавитьПараметр(ТД,ОписаниеПараметра);
		КонецЦикла;
		Для Каждого ОписаниеПараметра ИЗ мПараметров Цикл
			Для Каждого СтрокаПараметров ИЗ ТД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",ОписаниеПараметра.Имя)) Цикл
				Пока ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров)> мПараметров.Найти(ОписаниеПараметра) Цикл
					ТД.ПараметрыЗапроса.Сдвинуть(ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров),-1);	
				КонецЦикла;
				Пока ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров)< мПараметров.Найти(ОписаниеПараметра) Цикл
					ТД.ПараметрыЗапроса.Сдвинуть(ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров),1);	
				КонецЦикла;
				Прервать;
			КонецЦикла;	
		КонецЦикла;	
	КонецЕсли;
Конецпроцедуры	

Процедура вДобавитьПараметр(ТД,ПараметрЗапроса)
	СтрокиПараметров = ТД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",ПараметрЗапроса.Имя));
	Если Не СтрокиПараметров.Количество() Тогда
		СтрокаПараметров = ТД.ПараметрыЗапроса.Добавить();
		СтрокаПараметров.ИмяПараметра = ПараметрЗапроса.Имя;
		Если Не СтрокаПараметров.ЭтоВыражение Тогда
			ТипЗначения = ПараметрЗапроса.ТипЗначения; 
			Если ТипЗначения.СодержитТип(Тип("Тип")) Тогда //#СпецОбработкаТипа
				ТипЗначения =  Новый ОписаниеТипов("ОписаниеТипов");		
			КонецЕсли;	
			СтрокаПараметров.ЗначениеПараметра = ТипЗначения.ПривестиЗначение(СтрокаПараметров.ЗначениеПараметра);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры
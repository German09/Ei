Функция КоллекцияПараметров(Форма)
	Возврат Форма.Элементы.ДеревоЗапросовПараметрыЗапроса;
КонецФункции	

Процедура Установить(Форма) Экспорт
	ТД 			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		Вариант = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
		Если Не Вариант = Неопределено Тогда
			Вариант.УстановитьПараметры(Форма);		
		КонецЕсли;
	КонецЕсли;			
КонецПроцедуры

Процедура ВставитьПараметры(ТД, мПараметров) Экспорт
	Перем ОписаниеПараметра;
	Перем СтрокаПараметров;
	Для Каждого ОписаниеПараметра ИЗ мПараметров Цикл
		ПараметрыКлиентСервер_Ei.ДобавитьПараметр(ТД,ОписаниеПараметра);
	КонецЦикла;
	Для Каждого ОписаниеПараметра ИЗ мПараметров Цикл
		Для Каждого СтрокаПараметров ИЗ ТД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",ОписаниеПараметра.Имя)) Цикл
			Пока ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров)> мПараметров.Найти(ОписаниеПараметра) Цикл
				ТД.ПараметрыЗапроса.Сдвинуть(ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров),-1);	
			КонецЦикла;
			Пока ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров)< мПараметров.Найти(ОписаниеПараметра) Цикл
				ТД.ПараметрыЗапроса.Сдвинуть(ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров),1);	
			КонецЦикла;
			Прервать;
		КонецЦикла;	
	КонецЦикла;
КонецПроцедуры

Процедура ИзменитьВидимость(Форма,Видимость) Экспорт
	КоллекцияПараметров(Форма).Видимость = Видимость;
КонецПроцедуры	

//Обработка оповещения формируется процедурой ВариантыКлиент_Ei.ДополнитьДоступныеПеременныеВарината()
//
Процедура Параметры(Результат, ДопПараметры) Экспорт
	Результат  = Неопределено; //Получаем только из серверной процедуры одноименнная в ПараметрыВызовСервера_Ei()
КонецПроцедуры

#Область ОбработчикиСобытий

Процедура НачалоВыбора(Форма, Элемент, СтандартнаяОбработка) Экспорт
	ТД 						= КоллекцияПараметров(Форма).ТекущиеДанные;
	Если Не ТД = Неопределено Тогда
		СтруктураПеременных 	= ОбщийМодульКлиент_Ei.ПолучитьСтруктуруПеременных(Форма,ТД);
		ФормаРодитель 			= ВыборКлиент_Ei.НаследоватьВыбор(Форма,Форма.Элементы.Выбор,Форма.Элементы.Право);
		ОО_ВыбораПараметра 		= Новый ОписаниеОповещения("ЗавершениеВыбора",ЭтотОбъект,Новый Структура("Форма,Идентификатор",Форма,ТД.ПолучитьИдентификатор()));
		ВыборКлиент_Ei.НачалоВыбора(ОО_ВыбораПараметра,ФормаРодитель.Выбор,Форма,Элемент,СтруктураПеременных,СтандартнаяОбработка);
	КонецЕсли;	
КонецПроцедуры

Процедура Очистка(Форма, Элемент, СтандартнаяОбработка) Экспорт
	КоллекцияПараметров(Форма).ТекущиеДанные.ЗначениеПараметра =  Неопределено;
КонецПроцедуры

Процедура ЭтоВыражениеПриИзменении(Форма,Элемент) Экспорт 
	ТД = КоллекцияПараметров(Форма).ТекущиеДанные;
	Если ТД.ЭтоВыражение Тогда
		сНовыйАлгоритм = ТекстМодуляКлиент_Ei.ПреобразоватьЗначениеКВыражению(ТД.ЗначениеПараметра);
		Если ТипЗнч(сНовыйАлгоритм) = Тип("Строка") Тогда
			ТД.ЗначениеПараметра = сНовыйАлгоритм;
		Иначе
			//может вернуться неопределено, тогда мы просто ничего не посчитали
			ТД.ЭтоВыражение = Ложь;
		КонецЕсли;	
	Иначе
		//КонтекстВыполнения 		= ВариантыКлиент_Ei.ПолучитьСтруктуруДоступныхПеременных(ЭтаФорма,Элементы.ДеревоЗапросов.ТекущиеДанные,Ложь);
        ТД.ЗначениеПараметра 	= ВыполнитьКлиентСервер_Ei.Выражение(ТД.ЗначениеПараметра);//,,,КонтекстВыполнения);
	КонецЕсли;
КонецПроцедуры

Процедура ПриНачалеРедактирования(Форма, Элемент, НоваяСтрока, Копирование) Экспорт
	Если НоваяСтрока Тогда
		Если Не Копирование Тогда
			ИмяКадидат = "Параметр";
		Иначе
			ИмяКадидат = Элемент.ТекущиеДанные.ИмяПараметра;
		КонецЕсли;
		Элемент.ТекущиеДанные.ИмяПараметра = ОбщийМодульКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("ИмяПараметра",СокрЛП(ИмяКадидат)),Форма.ПолучитьПереопределяемыйОбъектОбработки().ПараметрыЗапроса); //вПолучитьУникальноеИмяПараметра(СокрЛП(ИмяКадидат));
	КонецЕсли;
	//Форма.сДоИзмененияИмяПараметра = Элемент.ТекущиеДанные.ИмяПараметра
КонецПроцедуры

Процедура ПередОкончаниемРедактирования(Форма, Элемент, НоваяСтрока, ОтменаРедактирования, Отказ) Экспорт
	ТД 				= КоллекцияПараметров(Форма).ТекущиеДанные;
	Набор			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не Набор = Неопределено Тогда
		сПричина 		= "";
		сИмяПараметра	= СтрЗаменить(ТД.ИмяПараметра," ","");
		Попытка 
			вр = Новый Структура;
			вр.Вставить(сИмяПараметра);
		Исключение
			сПричина = "Имя '"+сИмяПараметра+"' не соответствует правилу именования ключа структуры";
		КонецПопытки;
		Если Не ЗначениеЗаполнено(сПричина) Тогда
			ДублиСтрок =  Набор.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",сИмяПараметра));
			Если ДублиСтрок.Количество()> 1 Тогда
				сПричина = "Параметр с именем '"+сИмяПараметра+"' уже существует";	
			КонецЕсли;	
		КонецЕсли;	
		Если ЗначениеЗаполнено(сПричина) Тогда
			Если НоваяСтрока И ОтменаРедактирования Тогда
				//тут разрешаем отказаться 
			Иначе
				ПоказатьПредупреждение(,сПричина,20,"Ошибка в имени параметра");	
				Отказ = Истина;
			КонецЕсли;	
		Иначе
			//без лишних пробелов
			ТД.ИмяПараметра = сИмяПараметра;
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры


Процедура ПроверкаПеретаскивания(Форма,Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле) Экспорт
	Если Не Строка = Неопределено Тогда
		Строка 	= Форма.ПолучитьПереопределяемыйОбъектОбработки().ПараметрыЗапроса.НайтиПоИдентификатору(Строка);
	КонецЕсли;	
	ПеретаскиваниеКлиент_Ei.ПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
КонецПроцедуры


Процедура Перетаскивание(Форма,Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле) Экспорт
	ОО_ДобавлениеНового = Новый ОписаниеОповещения("ДеревоЗапросовПараметрыДобавлениеНового",Форма);
	Если Не Строка = Неопределено Тогда
		Строка 				= Форма.ПолучитьПереопределяемыйОбъектОбработки().ПараметрыЗапроса.НайтиПоИдентификатору(Строка);
	КонецЕсли;	
	ПеретаскиваниеКлиент_Ei.Перетаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле, Форма, ОО_ДобавлениеНового);
КонецПроцедуры


Процедура ДобавлениеНового(Форма, Результат, ДопПараметры) Экспорт
	ТД 			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		НоваяСтрока 				= ТД.ПараметрыЗапроса.Добавить();
		НоваяСтрока.ИмяПараметра 	= ОбщийМодульКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("ИмяПараметра",СокрЛП(Результат.ИмяКадидат)),ТД.ПараметрыЗапроса);//вПолучитьУникальноеИмяПараметра(Результат.ИмяКандидат);
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Результат);
	КонецЕсли;	
КонецПроцедуры


#КонецОбласти

Процедура ЗавершениеВыбора(ВыбранноеЗначение, ДопПараметры) Экспорт
	Форма 		= ДопПараметры.Форма;
	ИДСтроки 	= ДопПараметры.Идентификатор;	
	ТД 			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		СтрокаПараметра = ТД.ПараметрыЗапроса.НайтиПоИдентификатору(ИДСтроки);
		Если Не СтрокаПараметра = Неопределено Тогда 
			ЗаполнитьЗначенияСвойств(СтрокаПараметра,ВыбранноеЗначение,,"ИмяПараметра");
			Если ТипЗнч(СтрокаПараметра.ЗначениеПараметра) = Тип("СписокЗначений") И СтрокаПараметра.ЗначениеПараметра.Количество()>0 Тогда
				СтрокаПараметра.ЗначениеПараметра.ТипЗначения =  ТипыКлиентСервер_Ei.СоздатьОписаниеИзКолекции(ТипЗнч(СтрокаПараметра.ЗначениеПараметра[0].Значение));
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;		
Конецпроцедуры

Процедура ВСписок(Форма) Экспорт
	ТД = КоллекцияПараметров(Форма).ТекущиеДанные;
	Если НЕ ТД = Неопределено И Не ТД.ЭтоВыражение Тогда
		Если ТипЗнч(ТД.ЗначениеПараметра) = Тип("СписокЗначений") Тогда
			Для Каждого ЭлСЗ ИЗ ТД.ЗначениеПараметра Цикл
				ТД.ЗначениеПараметра = ЭлСЗ.Значение;
				Прервать;
			КонецЦикла;	
		Иначе	
			Список = Новый СписокЗначений;
			Список.Добавить(ТД.ЗначениеПараметра);
			ТД.ЗначениеПараметра = Список;
		КонецЕсли;
		КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
	КонецЕсли;	
КонецПроцедуры

Процедура УстановитьПериод(Форма,Команда) Экспорт
	ТД = КоллекцияПараметров(Форма).ТекущиеДанные;
	Если НЕ ТД = Неопределено И Не ТД.ЭтоВыражение Тогда
		ВыбранныйПериод = Новый СтандартныйПериод;
		СтрукПериода 	= вПолучитьСтруктуруПериода(Форма,ТД);
		Если ТипЗнч(СтрукПериода) =  Тип("Структура") Тогда
			// Устанавливаем начальные данные
			ВыбранныйПериод.ДатаНачала 		= СтрукПериода.ДатаНачала.ЗначениеПараметра;
			ВыбранныйПериод.ДатаОкончания 	= СтрукПериода.ДатаОкончания.ЗначениеПараметра;
			
			Диалог = Новый ДиалогРедактированияСтандартногоПериода();
			Диалог.Период = ВыбранныйПериод;
			// Не модальный вызов диалога выбора периода
			Диалог.Показать(Новый ОписаниеОповещения("ОО_ВыборПериодаЗавершение", ПараметрыКлиент_Ei, СтрукПериода));
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

//Определяет дату начали и окончания в зависмости от положения строк относительно друг друга
//Параметры:
//	ТекущиеДанные -СтрокаТаблицыЗначений- Выделенная строка	
Функция вПолучитьСтруктуруПериода(Форма,ТекущиеДанные)
	СтрукПериода 	= Новый Структура("ДатаНачала,ДатаОкончания");
	ПЗ 				= Форма.ПолучитьПереопределяемыйОбъектОбработки().ПараметрыЗапроса;
	Если ТипЗнч(ТекущиеДанные.ЗначениеПараметра) = Тип("Дата") Тогда
		ТекИндекс = ПЗ.Индекс(ТекущиеДанные);
		Если ТекИндекс > 0 И  ТипЗнч(ПЗ.Получить(ТекИндекс-1).ЗначениеПараметра) = Тип("Дата") Тогда
			СтрукПериода.ДатаНачала 	= ПЗ.Получить(ТекИндекс-1);
			СтрукПериода.ДатаОкончания	= ТекущиеДанные;
			Возврат СтрукПериода;
		ИначеЕсли ТекИндекс < ПЗ.Количество()-1 И  ТипЗнч(ПЗ.Получить(ТекИндекс+1).ЗначениеПараметра) = Тип("Дата") Тогда
			СтрукПериода.ДатаНачала 	= ТекущиеДанные;
			СтрукПериода.ДатаОкончания	= ПЗ.Получить(ТекИндекс+1);
			Возврат СтрукПериода;
		КонецЕсли;	
	КонецЕсли;	
КонецФункции

Процедура ОО_ВыборПериодаЗавершение(Период,ДополнительныеПараметры) Экспорт
	Если Не Период = Неопределено Тогда
		ДополнительныеПараметры.ДатаНачала.ЗначениеПараметра 	= Период.ДатаНачала;	
		ДополнительныеПараметры.ДатаОкончания.ЗначениеПараметра = Период.ДатаОкончания;
	КонецЕсли;	
КонецПроцедуры

//Функция обратная ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру()
//
Процедура ЗагрузитьДанные(Строка,стрПараметров) Экспорт
	Для Каждого ЭлСтруктуры ИЗ 	стрПараметров Цикл
		НовыйПараметр = Строка.ПараметрыЗапроса.Добавить();
		НовыйПараметр.ИмяПараметра 		= ЭлСтруктуры.Ключ;
		НовыйПараметр.ЭтоВыражение 		= ЭлСтруктуры.Значение.ЭтоВыражение;
		Если НовыйПараметр.ЭтоВыражение Тогда
			НовыйПараметр.ЗначениеПараметра	= ЭлСтруктуры.Значение.ЗначениеПараметра;	
		Иначе	 
			НовыйПараметр.ЗначениеПараметра	= ОбщийМодульКлиентСервер_Ei.ПопыткаСтруктурировать(ЭлСтруктуры.Значение.ЗначениеПараметра);	
		КонецЕсли;	
	КонецЦикла;		
КонецПроцедуры	
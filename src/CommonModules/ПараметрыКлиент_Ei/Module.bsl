#Область ПрограммныйИнтерфейс

// Коллекция параметров.
// 
// Параметры:
//  Форма 	см. ОбщаяФорма.Ei
// 
// Возвращаемое значение:
//  ТаблицаФормы - Коллекция параметров
Функция КоллекцияПараметров(Форма) Экспорт
	Возврат Форма.Элементы.Найти("ДеревоЗапросовПараметрыЗапроса");
КонецФункции	

#Область ОбработчикиКоманд

// Приводит к вызову
// См. ВставитьПараметры
// 
// Параметры:
//  Форма 	см. ОбщаяФорма.Ei
//  Команда - КомандаФормы
Процедура Установить(Форма,Команда = Неопределено) Экспорт
	ТекД 			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТекД = Неопределено Тогда
		Вариант = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТекД);
		Если Не Вариант = Неопределено Тогда
			Вариант.УстановитьПараметры(Форма);		
		КонецЕсли;
	КонецЕсли;			
КонецПроцедуры

// В список.
// 
// Параметры:
//  Форма 	см. ОбщаяФорма.Ei
//  Команда - КомандаФормы
Процедура ВСписок(Форма,Команда) Экспорт
	ТекД = КоллекцияПараметров(Форма).ТекущиеДанные;
	Если НЕ ТекД = Неопределено И Не ТекД.ЭтоВыражение Тогда
		Если ТипЗнч(ТекД.ЗначениеПараметра) = Тип("СписокЗначений") Тогда
			Для Каждого ЭлСЗ ИЗ ТекД.ЗначениеПараметра Цикл
				ТекД.ЗначениеПараметра = ЭлСЗ.Значение;
				Прервать;
			КонецЦикла;	
		Иначе	
			Список = Новый СписокЗначений;
			Если ТипЗнч(ТекД.ЗначениеПараметра) = Тип("Строка") И СтрЧислоСтрок(ТекД.ЗначениеПараметра)>1 Тогда
				//многострочну строку разложим в массив строк
				Для Ном = 1 По СтрЧислоСтрок(ТекД.ЗначениеПараметра) Цикл	
					Список.Добавить(СтрПолучитьСтроку(ТекД.ЗначениеПараметра,Ном));
				КонецЦикла;	
			Иначе	
				Список.Добавить(ТекД.ЗначениеПараметра);
			КонецЕсли;	
			ТекД.ЗначениеПараметра = Список;
		КонецЕсли;
		КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
	КонецЕсли;	
КонецПроцедуры

// Установить период.
// 
// Параметры:
//  Форма 	см. ОбщаяФорма.Ei
//  Команда - КомандаФормы
Асинх Процедура УстановитьПериод(Форма,Команда) Экспорт
	ТекД = КоллекцияПараметров(Форма).ТекущиеДанные;
	Если НЕ ТекД = Неопределено И Не ТекД.ЭтоВыражение Тогда
		ВыбранныйПериод = Новый СтандартныйПериод;
		СтрукПериода 	= ПолучитьСтруктуруПериода(Форма,ТекД);
		Если ТипЗнч(СтрукПериода) =  Тип("Структура") Тогда
			// Устанавливаем начальные данные
			ВыбранныйПериод.ДатаНачала 		= СтрукПериода.ДатаНачала.ЗначениеПараметра;
			ВыбранныйПериод.ДатаОкончания 	= СтрукПериода.ДатаОкончания.ЗначениеПараметра;
			
			Диалог = Новый ДиалогРедактированияСтандартногоПериода();
			Диалог.Период = ВыбранныйПериод;
			Период =  Ждать Диалог.РедактироватьАсинх();
			Если Не Период = Неопределено Тогда
				СтрукПериода.ДатаНачала.ЗначениеПараметра 		= Период.ДатаНачала;	
				СтрукПериода.ДатаОкончания.ЗначениеПараметра 	= Период.ДатаОкончания;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

// Из буфера.
// 
// Параметры:
//  Форма 	см. ОбщаяФорма.Ei
//  Команда - КомандаФормы
//
// Возвращаемое значение:
//  Строка, Неопределено - Добавленное или существующее имя параметра
Асинх Функция ИзБуфера(Форма,Команда) Экспорт
	Текст = Ждать ОбщегоНазначенияКлиент_Ei.ТекстИзБуфераОбмена();
	Если ЗначениеЗаполнено(Текст) Тогда
		//@skip-check bsl-legacy-check-expression-type
		Ссылка = ОбщегоНазначенияВызовСервера_Ei.ПолучитьСсылкуИзНавСсылки(Текст);
		Если Не Ссылка = Неопределено Тогда	
			//Попробуем найти
			ТекД 			= Форма.ПолучитьПереопределяемыйОбъектОбработки(); 
			Если Не ТекД = Неопределено Тогда
				Для Каждого Найденная ИЗ ТекД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ЗначениеПараметра",Ссылка)) Цикл
					КоллекцияПараметров(Форма).ТекущаяСтрока = Найденная.ПолучитьИдентификатор();
					Возврат Найденная.ИмяПараметра; //нашли просто активизируем	
				КонецЦикла;
			КонецЕсли;	
			//не нашли добавляем 
			Добавленная = ДобавлениеНового(Новый Структура("ИмяКандидат,ЭтоВыражение,ЗначениеПараметра","НавСсылка",Ложь,Ссылка), Форма);
			Если Не Добавленная = Неопределено Тогда
				Возврат Добавленная.ИмяПараметра;	
			КонецЕсли;	
		Иначе
			ПоказатьПредупреждение(,"В буфере обмена не найдена навигационная ссылка");			
		КонецЕсли;
	КонецЕсли;		
КонецФункции

#КонецОбласти

// Вставить параметры.
// 
// Параметры:
//  ТекД   		см. КонструкторКлиентСервер_Ei.ПолучитьПереопределяемыйОбъектОбработки
//  Параметры 	см. ПараметрыВызовСервера_Ei.ПолучитьПараметры
Процедура ВставитьПараметры(ТекД, Параметры) Экспорт
	Перем ОписаниеПараметра;
	Перем СтрокаПараметров;
	Для Каждого ОписаниеПараметра ИЗ Параметры Цикл
		ПараметрыКлиентСервер_Ei.ДобавитьПараметр(ТекД,ОписаниеПараметра);
	КонецЦикла;
	Для Каждого ОписаниеПараметра ИЗ Параметры Цикл
		Для Каждого СтрокаПараметров ИЗ ТекД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",ОписаниеПараметра.Имя)) Цикл
			Пока ТекД.ПараметрыЗапроса.Индекс(СтрокаПараметров)> Параметры.Найти(ОписаниеПараметра) Цикл
				ТекД.ПараметрыЗапроса.Сдвинуть(ТекД.ПараметрыЗапроса.Индекс(СтрокаПараметров),-1);	
			КонецЦикла;
			Пока ТекД.ПараметрыЗапроса.Индекс(СтрокаПараметров)< Параметры.Найти(ОписаниеПараметра) Цикл
				ТекД.ПараметрыЗапроса.Сдвинуть(ТекД.ПараметрыЗапроса.Индекс(СтрокаПараметров),1);	
			КонецЦикла;
			Прервать;
		КонецЦикла;	
	КонецЦикла;
КонецПроцедуры

// Устанавливаем видимость панели  и командной панели
// 
// Параметры:
//  Форма см. ОбщаяФорма.Ei
//  Видимость - Булево
Процедура ИзменитьВидимость(Форма,Видимость) Экспорт
	ПанельПараметров =  Форма.Элементы.Найти("СтраницыПараметры");
	Если Не ПанельПараметров =  Неопределено Тогда
		ПанельПараметров.Видимость = Видимость;
	КонецЕсли; 
	КППараметров =  Форма.Элементы.Найти("ПараметрыКП");
	Если Не КППараметров =  Неопределено Тогда
		КППараметров.Видимость = Видимость;
	КонецЕсли; 
КонецПроцедуры


// Вызывается обработчиком оповещения из
// См. ВыборКлиент_Ei.ПараметрыСтроки
// 
// Параметры:
//  Результат 		- Неопределено - Возвращаемый параметр
//  ДопПараметры 	- Структура - Задается в см. НаборВариантовКлиент_Ei.ДополнитьДоступныеПеременные:
//						*Аргументы	- Строка 
Процедура Параметры(Результат, ДопПараметры) Экспорт
	Результат  = Неопределено; //Получаем только из серверной процедуры одноименнная в см. ПараметрыВызовСервера_Ei
КонецПроцедуры

#Область ОбработчикиСобытий

Процедура АвтоПодбор(Форма, Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка) Экспорт
	Если Ожидание>0 и Не ПустаяСтрока(Текст) Тогда
		ТекД = КоллекцияПараметров(Форма).ТекущиеДанные;
		Если Не ТекД = Неопределено Тогда
			Ссылка = ОбщегоНазначенияВызовСервера_Ei.ПолучитьСсылкуИзНавСсылки(Текст);
			Если Не Ссылка = Неопределено Тогда
				СтандартнаяОбработка = Ложь;
				ДанныеВыбора = Новый СписокЗначений();
				ДанныеВыбора.Добавить(Ссылка);
			КонецЕсли;					
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Процедура НачалоВыбора(Форма, Элемент, СтандартнаяОбработка) Экспорт
	ТекД 						= КоллекцияПараметров(Форма).ТекущиеДанные;
	Если Не ТекД = Неопределено Тогда
		СтруктураПеременных 	= ОбщегоНазначенияКлиент_Ei.ПолучитьСтруктуруПеременных(Форма,ТекД);
		Контейнер				= Форма.Элементы.Выбор;
		ФормаРодитель 			= ВыборКлиент_Ei.НаследоватьВыбор(Форма,Контейнер,Форма.Элементы.Право);
		ВыборКлиент_Ei.ИзменитьВидимость(Форма,Ложь); //наследуем пока невидимый, дальше решаем как с ним быть, показывать или нет	
		ЗавершениеВыбора 		= Новый ОписаниеОповещения("ЗавершениеВыбора",ЭтотОбъект,Новый Структура("Форма,Идентификатор",Форма,ТекД.ПолучитьИдентификатор()));
		ВыборКлиент_Ei.НачалоВыбора(ЗавершениеВыбора,ФормаРодитель.Выбор,Форма,Элемент,СтруктураПеременных,СтандартнаяОбработка);
	КонецЕсли;	
КонецПроцедуры

Процедура Очистка(Форма, Элемент, СтандартнаяОбработка) Экспорт
	КоллекцияПараметров(Форма).ТекущиеДанные.ЗначениеПараметра =  Неопределено;
КонецПроцедуры

Процедура ЭтоВыражениеПриИзменении(Форма,Элемент) Экспорт 
	ТекД = КоллекцияПараметров(Форма).ТекущиеДанные;
	Если ТекД.ЭтоВыражение Тогда
		сНовыйАлгоритм = ТекстМодуляКлиент_Ei.ПреобразоватьЗначениеКВыражению(ТекД.ЗначениеПараметра);
		Если ТипЗнч(сНовыйАлгоритм) = Тип("Строка") Тогда
			ТекД.ЗначениеПараметра = сНовыйАлгоритм;
		Иначе
			//может вернуться неопределено, тогда мы просто ничего не посчитали
			ТекД.ЭтоВыражение = Ложь;
		КонецЕсли;	
	Иначе
		//КонтекстВыполнения 		= ВариантыКлиент_Ei.ПолучитьСтруктуруДоступныхПеременных(ЭтаФорма,Элементы.ДеревоЗапросов.ТекущиеДанные,Ложь);
        ТекД.ЗначениеПараметра 	= ВыполнитьКлиентСервер_Ei.Выражение(ТекД.ЗначениеПараметра);//,,,КонтекстВыполнения);
	КонецЕсли;
КонецПроцедуры

Процедура ПриНачалеРедактирования(Форма, Элемент, НоваяСтрока, Копирование) Экспорт
	Если НоваяСтрока Тогда
		ТекД = Элемент.ТекущиеДанные;
		Если Не Копирование Тогда
			ИмяКадидат = "Параметр";
		Иначе
			ИмяКадидат = ТекД.ИмяПараметра;
		КонецЕсли;
		ТекД.ИмяПараметра 	= ОбщегоНазначенияКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("ИмяПараметра",СокрЛП(ИмяКадидат)),Форма.ПолучитьПереопределяемыйОбъектОбработки().ПараметрыЗапроса); //вПолучитьУникальноеИмяПараметра(СокрЛП(ИмяКадидат));
		ТекД.Ключ 			= ПараметрыКлиентСервер_Ei.ПолучитьНовыйКлюч();
		КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
	КонецЕсли;
КонецПроцедуры

Процедура ПриИзменении(Форма, Элемент) Экспорт
	Если Элемент = КоллекцияПараметров(Форма) Тогда
		Набор			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
		Если Не Набор = Неопределено Тогда
			Если Набор.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра","")).Количество() Тогда
				//это добавление пустой строки, ей еще будем устанавливать имя см. ПриНачалеРедактирования
				//и только потом имеет смысл сравнивать и сохранять
			Иначе	
				КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
			КонецЕсли;
		КонецЕсли;
	Иначе
		ПриИзмененииВРедакторе(Форма, Элемент)			
	КонецЕсли;	
КонецПроцедуры

Процедура ПередОкончаниемРедактирования(Форма, Элемент, НоваяСтрока, ОтменаРедактирования, Отказ) Экспорт
	ТекД 			= КоллекцияПараметров(Форма).ТекущиеДанные;
	Набор			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не Набор = Неопределено Тогда
		Причина 		= "";
		ИмяПараметра	= СтрЗаменить(ТекД.ИмяПараметра," ","");
		Если Не ОбщегоНазначенияКлиентСервер_Ei.ВозможностьКлючСтруктуры(ИмяПараметра) Тогда
			Причина = СтрШаблон("Имя '%1' не соответствует правилу именования ключа структуры",ИмяПараметра);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Причина) Тогда
			ДублиСтрок =  Набор.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",ИмяПараметра));
			Если ДублиСтрок.Количество()> 1 Тогда
				Причина = СтрШаблон("Параметр с именем '%1' уже существует",ИмяПараметра);	
			КонецЕсли;	
		КонецЕсли;	
		Если ЗначениеЗаполнено(Причина) Тогда
			Если НоваяСтрока И ОтменаРедактирования Тогда
				//тут разрешаем отказаться 
			Иначе
				ПоказатьПредупреждение(,Причина,20,"Ошибка в имени параметра");	
				Отказ = Истина;
			КонецЕсли;	
		Иначе
			//без лишних пробелов
			Изменили = Не (ТекД.ИмяПараметра = ИмяПараметра);
			ТекД.ИмяПараметра = ИмяПараметра;
			Если Изменили Тогда
				КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры


Процедура ПроверкаПеретаскивания(Форма,Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле) Экспорт
	Если Не Строка = Неопределено Тогда
		Строка 	= Форма.ПолучитьПереопределяемыйОбъектОбработки().ПараметрыЗапроса.НайтиПоИдентификатору(Строка);
	КонецЕсли;	
	ПеретаскиваниеКлиент_Ei.ПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
КонецПроцедуры


// Перетаскивание.
// 
// Параметры:
//  Форма см. ОбщаяФорма.Ei
//  Элемент Элемент
//  ПараметрыПеретаскивания Параметры перетаскивания
//  СтандартнаяОбработка Стандартная обработка
//  Строка Строка
//  Поле Поле
Процедура Перетаскивание(Форма,Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле) Экспорт
	ДобавлениеНового = Новый ОписаниеОповещения("ДобавлениеНового",ЭтотОбъект,Форма); 
	Если Не Строка = Неопределено Тогда
		Строка 			= Форма.ПолучитьПереопределяемыйОбъектОбработки().ПараметрыЗапроса.НайтиПоИдентификатору(Строка);
	КонецЕсли;	
	ПеретаскиваниеКлиент_Ei.Перетаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле, Форма, ДобавлениеНового);
КонецПроцедуры

// Открытие.
// 
// Параметры:
//  Форма см. ОбщаяФорма.Ei
//  Элемент  - ПолеФормы
//  СтандартнаяОбработка - Булево
Процедура Открытие(Форма, Элемент, СтандартнаяОбработка) Экспорт
	ТекД = КоллекцияПараметров(Форма).ТекущиеДанные;
	Если ТекД.ЭтоВыражение Тогда
		СтандартнаяОбработка =  Ложь;
		ЗавершениеРедактированияАлгоритма 	= Новый ОписаниеОповещения("ЗавершениеРедактированияАлгоритма",ЭтотОбъект,Новый Структура("Форма,Идентификатор",Форма,ТекД.ПолучитьИдентификатор()));
		ОткрытьФорму("ОбщаяФорма.ПараметрыАлгоритм_Ei", Новый Структура("Имя,ТекстМодуля",ТекД.ИмяПараметра,ТекД.ЗначениеПараметра),Форма,,,,ЗавершениеРедактированияАлгоритма,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	КонецЕсли;		
КонецПроцедуры


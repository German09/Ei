// Добавление нового.
// 
// Параметры:
//  Результат - Структура:
//  	*ЭтоВыражение 		- Булево
//  	*ЗначениеПараметра	- Произвольный
//  	*ИмяКандидат		- Строка  
//  Форма см. Обработка.Ei.Форма.Форма
//
// Возвращаемое значение:
//  ДанныеФормыЭлементКоллекции,Неопределено  
Функция ДобавлениеНового(Результат, Форма) Экспорт
	ТекД 			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если ФоновоеВыполнениеКлиент_Ei.ПараметрыЗаблокированы(Форма) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Параметр не добавлен'"), , НСтр("ru = 'Строка выполняется в фоне'"), ОбщегоНазначенияКлиент_Ei.КартинкаОповещения());
	ИначеЕсли Не ТекД = Неопределено Тогда
		НоваяСтрока 				= ТекД.ПараметрыЗапроса.Добавить();
		НоваяСтрока.Ключ 			= ПараметрыКлиентСервер_Ei.ПолучитьНовыйКлюч();
		НоваяСтрока.ИмяПараметра 	= ОбщегоНазначенияКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("ИмяПараметра",СокрЛП(Результат.ИмяКандидат)),ТекД.ПараметрыЗапроса);//вПолучитьУникальноеИмяПараметра(Результат.ИмяКандидат);
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Результат);
		Возврат НоваяСтрока;
	КонецЕсли;	
КонецФункции

Процедура ЗавершениеВыбора(ВыбранноеЗначение, ДопПараметры) Экспорт
	Форма 		= ДопПараметры.Форма;
	ИДСтроки 	= ДопПараметры.Идентификатор;	
	ТекД 		= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТекД = Неопределено Тогда
		СтрокаПараметра = ТекД.ПараметрыЗапроса.НайтиПоИдентификатору(ИДСтроки);
		Если Не СтрокаПараметра = Неопределено Тогда 
			ЗаполнитьЗначенияСвойств(СтрокаПараметра,ВыбранноеЗначение,,"ИмяПараметра");
			Если ТипЗнч(СтрокаПараметра.ЗначениеПараметра) = Тип("СписокЗначений") И СтрокаПараметра.ЗначениеПараметра.Количество()>0 Тогда
				СтрокаПараметра.ЗначениеПараметра.ТипЗначения =  ТипыКлиентСервер_Ei.СоздатьОписаниеИзКолекции(ТипЗнч(СтрокаПараметра.ЗначениеПараметра[0].Значение));
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;		
Конецпроцедуры

Процедура ЗавершениеРедактированияАлгоритма(Выражение, ДопПараметры) Экспорт
	Если Не Выражение = Неопределено И Не ФоновоеВыполнениеКлиент_Ei.ПараметрыЗаблокированы(ДопПараметры.Форма) Тогда
		Форма 		= ДопПараметры.Форма;
		ИДСтроки 	= ДопПараметры.Идентификатор;	
		ТекД 		= Форма.ПолучитьПереопределяемыйОбъектОбработки();
		Если Не ТекД = Неопределено Тогда
			СтрокаПараметра = ТекД.ПараметрыЗапроса.НайтиПоИдентификатору(ИДСтроки);
			Если Не СтрокаПараметра = Неопределено Тогда
				СтрокаПараметра.ЗначениеПараметра = Выражение;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;			 	
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//@skip-check constructor-function-return-section
// Определяет дату начали и окончания в зависмости от положения строк относительно друг друга
// 
// Параметры:
//  Форма см. Обработка.Ei.Форма.Форма
//  ТекущиеДанные - ДанныеФормыЭлементКоллекции
// 
// Возвращаемое значение:
//  Структура - В получить структуру периода:
// * ДатаНачала 	- Дата
// * ДатаОкончания 	- Дата
Функция ПолучитьСтруктуруПериода(Форма,ТекущиеДанные)
	СтрукПериода 	= Новый Структура("ДатаНачала,ДатаОкончания");
	Парметры 		= Форма.ПолучитьПереопределяемыйОбъектОбработки().ПараметрыЗапроса;
	Если ТипЗнч(ТекущиеДанные.ЗначениеПараметра) = Тип("Дата") Тогда
		ТекИндекс = Парметры.Индекс(ТекущиеДанные);
		Если ТекИндекс > 0 И  ТипЗнч(Парметры.Получить(ТекИндекс-1).ЗначениеПараметра) = Тип("Дата") Тогда
			СтрукПериода.ДатаНачала 	= Парметры.Получить(ТекИндекс-1);
			СтрукПериода.ДатаОкончания	= ТекущиеДанные;
			Возврат СтрукПериода;
		ИначеЕсли ТекИндекс < Парметры.Количество()-1 И  ТипЗнч(Парметры.Получить(ТекИндекс+1).ЗначениеПараметра) = Тип("Дата") Тогда
			СтрукПериода.ДатаНачала 	= ТекущиеДанные;
			СтрукПериода.ДатаОкончания	= Парметры.Получить(ТекИндекс+1);		
			Возврат СтрукПериода;
		КонецЕсли;	
	КонецЕсли;	
КонецФункции

Процедура ПриИзмененииДанных(Форма)
	ЭлементИнструкции = ОбщегоНазначенияКлиент_Ei.ЭлементИнструкции(Форма);	
	Если Не ЭлементИнструкции = Неопределено И ЭлементИнструкции.Доступность Тогда
		РедакторКодаКлиент_Ei.ЗаменитьТекст(ЭлементИнструкции,Форма.ТекстМодуля);
	КонецЕсли;
КонецПроцедуры

// Параметр текущей строки по ссылке на параметр Ei (НавигационныеСсылкиКлиент_Ei.СкопироватьСсылкуНаПараметр):
// параметр своей строки становится текущим, параметр другой строки добавляется выражением
// Наборы("Строка").Параметры("Имя") с именем исходного параметра, уже добавленный - становится текущим
//
// Параметры:
//  Форма 			- см. Обработка.Ei.Форма.Форма
//  ДанныеСсылки 	- см. НавигационныеСсылкиКлиентСервер_Ei.ДанныеСсылки
//
// Возвращаемое значение:
//  Строка, Неопределено - имя параметра текущей строки
//
Функция ИзСсылкиНаПараметр(Форма, ДанныеСсылки)
	
	Результат 	= Неопределено;
	ТекД 		= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Источник 	= НавигационныеСсылкиКлиент_Ei.ПараметрПоСсылке(Форма, ДанныеСсылки);
	Если Источник = Неопределено Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'В буфере обмена ссылка Ei не на параметр, или этого параметра нет в открытой форме Ei.'"));
	ИначеЕсли ТекД = Неопределено Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Выберите строку набора, в которую вставить параметр.'"));
	ИначеЕсли Источник.СтрокаНабора.КлючНастроек = ТекД.КлючНастроек Тогда
		КоллекцияПараметров(Форма).ТекущаяСтрока 	= Источник.Параметр.ПолучитьИдентификатор();
		Результат 									= Источник.Параметр.ИмяПараметра;
	Иначе
		Выражение = СтрШаблон("Наборы(""%1"").Параметры(""%2"")", Источник.СтрокаНабора.ИмяНабора, Источник.Параметр.ИмяПараметра);
		Для Каждого Найденная Из ТекД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ЭтоВыражение, ЗначениеПараметра", Истина, Выражение)) Цикл
			КоллекцияПараметров(Форма).ТекущаяСтрока 	= Найденная.ПолучитьИдентификатор();
			Результат 									= Найденная.ИмяПараметра;
			Прервать;
		КонецЦикла;
		Если Результат = Неопределено Тогда
			Добавленная = ДобавлениеНового(Новый Структура("ИмяКандидат, ЭтоВыражение, ЗначениеПараметра",
				Источник.Параметр.ИмяПараметра, Истина, Выражение), Форма);
			Если Не Добавленная = Неопределено Тогда
				КоллекцияПараметров(Форма).ТекущаяСтрока 	= Добавленная.ПолучитьИдентификатор();
				Результат 									= Добавленная.ИмяПараметра;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

#КонецОбласти

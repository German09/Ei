Функция КоллекцияПараметров(Форма)
	Возврат Форма.Элементы.ДеревоЗапросовПараметрыЗапроса;
КонецФункции	

Процедура Установить(Форма) Экспорт
	ТД 			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		Вариант = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
		Если Не Вариант = Неопределено Тогда
			Вариант.УстановитьПараметры(Форма);		
		КонецЕсли;
	КонецЕсли;			
КонецПроцедуры

Процедура ВставитьПараметры(ТД, мПараметров) Экспорт
	Перем ОписаниеПараметра;
	Перем СтрокаПараметров;
	Для Каждого ОписаниеПараметра ИЗ мПараметров Цикл
			ПараметрыКлиентСервер_Ei.ДобавитьПараметр(ТД,ОписаниеПараметра);
		КонецЦикла;
		Для Каждого ОписаниеПараметра ИЗ мПараметров Цикл
			Для Каждого СтрокаПараметров ИЗ ТД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",ОписаниеПараметра.Имя)) Цикл
				Пока ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров)> мПараметров.Найти(ОписаниеПараметра) Цикл
					ТД.ПараметрыЗапроса.Сдвинуть(ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров),-1);	
				КонецЦикла;
				Пока ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров)< мПараметров.Найти(ОписаниеПараметра) Цикл
					ТД.ПараметрыЗапроса.Сдвинуть(ТД.ПараметрыЗапроса.Индекс(СтрокаПараметров),1);	
				КонецЦикла;
				Прервать;
			КонецЦикла;	
		КонецЦикла;
КонецПроцедуры

Процедура ИзменитьВидимость(Форма,Видимость) Экспорт
	КоллекцияПараметров(Форма).Видимость = Видимость;
КонецПроцедуры	

//Обработка оповещения формируется процедурой ВариантыКлиент_Ei.ДополнитьДоступныеПеременныеВарината()
//
Процедура Параметры(Результат, ДопПараметры) Экспорт
	Результат  = Неопределено; //Получаем только из серверной процедуры одноименнная в ПараметрыВызовСервера_Ei()
КонецПроцедуры

#Область ОбработчикиСобытий

Процедура НачалоВыбора(Форма, Элемент, СтандартнаяОбработка) Экспорт
	ТД 						= КоллекцияПараметров(Форма).ТекущиеДанные;
	СтруктураПеременных 	= ОбщийМодульКлиент_Ei.ПолучитьСтруктуруПеременных(Форма,ТД);
	ФормаРодитель 			= ВыборКлиент_Ei.НаследоватьВыбор(Форма,Форма.Элементы.Выбор,Форма.Элементы.Право);
	ОО_ВыбораПараметра 		= Новый ОписаниеОповещения("ВыборПараметра",Форма);
	ВыборКлиент_Ei.НачалоВыбора(ОО_ВыбораПараметра,ФормаРодитель.Выбор,Форма,Элемент,СтруктураПеременных,СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти
#Область Сохранение_Чтение

// Сохранить в каталог исходников EDT параметр. 
// Либом как общий модуль если параметр является вычисляемым либо как макет если задано его значение
// Чтение  см. ЗаполнитьИзXDTO
// 
// Параметры:
//  ПутьИсходники 	- Строка - Путь к каталогу  исходников
//  Набор 			- см. ВариантыКлиентСервер_Ei.ПолучитьВариант
//  ИмяОбработки	- Неопределено,Строка - Имя обработки
// 
// Возвращаемое значение:
//  Массив Из см. ФайлыКлиент_Ei.РезультатСохранения
//
Асинх Функция СохранитьВКаталог(ПутьИсходники, Набор, ИмяОбработки = "") Экспорт
	Результат = Новый Массив;
	Для Каждого фСтрПараметра ИЗ Набор.Параметры Цикл
		Параметр	= фСтрПараметра.Значение; 
		Ключ 		= Строка(ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(Набор.КлючНастроек,Параметр.Ключ));
		ИмяПараметра= фСтрПараметра.Ключ;
		Имя 		= СтрШаблон("%1_%2_%3",Набор.Имя,ПризнакВКомментраии(),ИмяПараметра);
		ДопСвойства = Новый Структура("Синоним",ИмяПараметра);
		Если Параметр.ЭтоВыражение Тогда
			сСодержание	= ВариантАлгоритмКлиентСервер_Ei.ПодготовитьМодуль(ВыполнитьКлиентСервер_Ei.ПолучитьМодуль(Параметр.ЗначениеПараметра)); 
			//КаталогПуть	= Ждать EDTКлиент_Ei.СоздатьОбшийМодуль(ПутьИсходники, сСодержание, Имя, Ключ, ИмяПараметра);
			ПолноеИмя	= Ждать EDTКлиент_Ei.СоздатьФормуОбработки(ПутьИсходники, сСодержание, Имя, Ключ, ИмяПараметра, ИмяОбработки);
			Алгоритм    = СтрШаблон("Возврат ПолучитьФорму(""%1"").%2())",Имя,ВыполнитьКлиентСервер_Ei.ИмяГлавнойФункции());	
		Иначе
			сСодержание	= ОбщегоНазначенияВызовСервера_Ei.Сериализовать(Параметр.ЗначениеПараметра);
			//КаталогПуть = Ждать EDTКлиент_Ei.СоздатьОбшийМакет(ПутьИсходники, сСодержание, Имя, Ключ, ИмяПараметра);
			ТипМакета =  "TextDocument";
			ДопСвойства.Вставить("ТипМакета", ТипМакета);
			ПолноеИмя	= Ждать EDTКлиент_Ei.СоздатьМакетОбработки(ПутьИсходники, сСодержание, Имя, Ключ, EDTКлиент_Ei.ТипыМакетов()[ТипМакета], ИмяПараметра);
			Алгоритм    = СтрШаблон("Возврат  ОбщегоНазначенияКлиентСервер_Ei.Структурировать(ПолучитьМакет(""%1"").ПолучитьТекст())",Имя); //см. ОбщегоНазначенияКлиентСервер_Ei.Структурировать
		КонецЕсли;
		ДопСвойства.Вставить("Комментарий", ПризнакВКомментраии());
		СтрСохранения = ФайлыКлиент_Ei.РезультатСохранения(Имя, ПутьИсходники, сСодержание, Ключ, Новый Файл(ПолноеИмя), ДопСвойства);
		СтрСохранения.Вставить("Получение", СтрШаблон("Функция %1__%5_%2() Экспорт%3%4%3КонецФункции",Набор.Имя,ИмяПараметра,Символы.ПС,Символы.Таб+Алгоритм, ПризнакВКомментраии()));
		СтрСохранения.Вставить("Описание", 	"");
		Результат.Добавить(СтрСохранения);						
	КонецЦикла;
	Возврат Результат; 
КонецФункции


// Прочитать параметр. Добавление в варианты всех параметров (элементов структур аналогичных см. ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру )
// 
// Параметры:
//  Элемент 		- ОбъектXDTO - 
//  НаборВаринатов 	- Структура Из см. ВариантыКлиентСервер_Ei.ПолучитьВариант
//  Объект 			- ОбъектXDTO - 
//  сооКлючей 		- Соответствие из КлючИЗначение:
//		*Ключ 		- УникальныйИдентификатор -
//		*Значение 	- Строка
//	Тип				- Строка - Имя типа метаданных см.EDTКлиент_Ei.ТипыМетаданных 
Процедура ПрочитатьОбъект(Элемент, НаборВаринатов, Объект, СооКлючей, Тип) Экспорт
	Перем Вариант;
	Параметр = Новый Структура; //см. ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру
	КлючНастроек = ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(Элемент.uuid,Объект.uuid);
	ИмяВарианта = сооКлючей.Получить(КлючНастроек);
	Если Не ИмяВарианта = Неопределено Тогда
		Если НаборВаринатов.Свойство(ИмяВарианта,Вариант) Тогда
			Вариант.Параметры.Вставить(Элемент.synonym.value,Параметр);
			Параметр.Вставить("Ключ",			Прав(Элемент.uuid,12));
			Параметр.Вставить("ЭтоВыражение", 	(Тип = EDTКлиент_Ei.ТипыМетаданных().Формы));
			Параметр.Вставить("Путь", 			EDTКлиент_Ei.ПолучитьПуть(Тип, Элемент));
		КонецЕсли;	  
	КонецЕсли;
КонецПроцедуры

// Свойство пути указано, значит файл нужно считать
// Заменяет свойство Путь на ЗначениеПараметра
// по аналоги с см. EDTКлиент_Ei.ПрочитатьСоставОбработки
// 
// Параметры:
//  Структура  	- Структура - Формируется процедурой см. ПрочитатьОбъект
//  Каталог  	- Строка - Путь к каталогу проекта - C:\Users\g.kudiakov\Documents\Ei_Настройка\New folder (2)  
//  ИмяПроекта  - Строка - Например: Набор
//  Путь  		- Строка - относительный полный путь  - Templates\Набор_Параметр_Особенность\Template.txt
//  Ключ 		- Строка - 55a4e36a-d2be-4a18-bbb0-c13c4a1ec5c5
//  
// Возвращаемое значение:
// 	см. ФайлыКлиент_Ei.РезультатСохранения 
Функция ПрочитатьЗначение(Структура,Каталог, ИмяПроекта,Путь,Ключ) Экспорт
	Перем Результат;
	ПолноеИмя 	= СтрШаблон("%1%6%5%6%2s%6%3%6%4",Каталог,EDTКлиент_Ei.ВнешОбработка(),ИмяПроекта,Путь,ФайлыКлиентСервер_Ei.КаталогИсходников(),ПолучитьРазделительПути());
	ТекстФайла 	= ФайлыКлиент_Ei.ПрочитатьТекст(ПолноеИмя);
	Структура.Вставить("ЗначениеПараметра",ТекстФайла);
	Если Структура.Свойство("Путь") Тогда	
		Структура.Удалить("Путь");		
	КонецЕсли;
	//все сделали теперь подготовим ответ
	Файл				= Новый Файл(ПолноеИмя);
	ПутьККорневойПапаке = СтрШаблон("%1%5%4%5%2s%5%3",Каталог,EDTКлиент_Ei.ВнешОбработка(),ИмяПроекта,ФайлыКлиентСервер_Ei.КаталогИсходников(),ПолучитьРазделительПути());
	Результат 			= ФайлыКлиент_Ei.РезультатСохранения("", ПутьККорневойПапаке, ТекстФайла, Ключ, Файл); // возможно придется убрать / в конце Файл.Путь 
	Возврат Результат;
КонецФункции	


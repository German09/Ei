#Область ИнтерфейсРезультатов

Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",			ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТабличныйДокумент);
	Результат.Вставить("Синоним",		"Таб.док.");
	Результат.Вставить("Картинка",		БиблиотекаКартинок.ТабДокумент_Ei);
	Результат.Вставить("КартинкаСсылка",ПоместитьВоВременноеХранилище(Результат.Картинка,Новый УникальныйИдентификатор));
	Результат.Вставить("ИмяРеквизита",	"РезультатЗапросаТД");
	Результат.Вставить("ТипРеквизита",	""); //для динамоческих реквизитов, в данном случае не используем 
	Результат.Вставить("Типы",			Новый Массив); //поддерживаемые типы, помимо имени
		Результат.Типы.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().РезультатЗапроса);
		Результат.Типы.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().МакетКомпоновкиДанных);
		//Результат.Типы.Добавить(ОбщийМодульКлиентСервер_Ei.ПолучитьИмяТипЗнч(ТипЗнч(Новый Структура)));
	Возврат Результат;
КонецФункции

// Выполняется до выполнения варианта для данноготипа результата
// Варинат не всегда нужно выполнять для некоторых результатов, например в Динамическом списке, не нужно выполнять запрос
// 
// Параметры:
//  Вариант  - общий модуль - модуль варианта
//  ОписаниеЗначения - Описание значения - возвращаемый параметр, тут мы можем переопределить результат в зависимости от того как будем его отображать, если задуматся глубоко то ДС вообше не должно существовать
// 
// Возвращаемое значение:
//  Булево - Выполнять вариант или нет
Функция ПереопределитьВыполнение(УникальныйИдентификатор,ДопПараметры,Вариант,ОписаниеЗначения) Экспорт
	Перем СтрРасшифровки;
	Результат = Истина;
	Если Вариант = ВариантКлиентСервер_СКД_Ei Тогда
		ТекстСКД =  ВариантКлиентСервер_СКД_Ei.ПолучитьТекстСКД();//Форма, ТД);	
		Если ЗначениеЗаполнено(ТекстСКД) Тогда
			ДопПараметры.Свойство("СтрРасшифровки",СтрРасшифровки);					
			ОписаниеЗначения		= ВыполнитьКлиентСервер_Ei.СКД(ТекстСКД,УникальныйИдентификатор,"ГенераторМакетаКомпоновкиДанных",СтрРасшифровки);
		КонецЕсли;
		Результат = Ложь;
	КонецЕсли;		
	Возврат Результат;
КонецФункции	

Процедура ПослеЗагрузкиРезультата(Форма) Экспорт
	Возврат;	
КонецПроцедуры

#Если Сервер Тогда
	
Функция Загрузить(Форма,ВариантИД,Результат,ИмяРеквизита,мКолонокРезультата) Экспорт	
	Форма.РезультатЗапросаТД.Очистить();
	Если Не Результат = Неопределено Тогда
		Форма.РезультатЗапросаТД.Вывести(Результат);
	КонецЕсли;		
	Возврат Истина;
КонецФункции

// Привести результат к типу, который возможно показать
// 
// Параметры:
//  СохраненныйРезультат - Произвольное значение - значение которые мы птыемся показать данным обработчиком
// 
// Возвращаемое значение:
//	Произвольное значение - Значение приведенное к типу	который можно тут отобразить   
Функция ПривестиРезультат(СохраненныйРезультат) Экспорт
	Возврат РезультатВызовСервера_ТД_Ei.ПривестиРезультат(СохраненныйРезультат);		
КонецФункции

Функция ОпределитьРазмерность(Результат) Экспорт
	Перем ОбъемКоллекции;
	Если ТипЗнч(Результат) = Тип("ТабличныйДокумент") Тогда
		Если Результат.ВысотаТаблицы > 1 Тогда 
			ОбъемКоллекции = ""+(Результат.ВысотаТаблицы - 1)+"/"+Результат.ШиринаТаблицы; //Шапка выводится в таблицу убираем ее
		КонецЕсли;
	КонецЕсли;	
	Возврат ОбъемКоллекции;		
КонецФункции

Функция ПолучитьДопустимыеСвойства(Значение, УникальныйИдентификатор) Экспорт
	Возврат РезультатВызовСервера_ТД_Ei.ПолучитьДопустимыеСвойства(Значение, УникальныйИдентификатор);		
КонецФункции


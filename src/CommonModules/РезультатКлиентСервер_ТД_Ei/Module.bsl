#Область ИнтерфейсРезультатов

Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",			ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТабличныйДокумент);
	Результат.Вставить("Синоним",		"Таб.док.");
	Результат.Вставить("Картинка",		БиблиотекаКартинок.ТабличныйДокументОтображатьЗаголовки);
	Результат.Вставить("ИмяРеквизита",	"РезультатЗапросаТД");
	Результат.Вставить("Типы",			Новый Массив); //поддерживаемые типы, помимо имени
		Результат.Типы.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().РезультатЗапроса);
		Результат.Типы.Добавить(ОбщийМодульКлиентСервер_Ei.ПолучитьИмяТипЗнч(ТипЗнч(Новый Структура)));
	Возврат Результат;
КонецФункции

// Выполняется до выполнения варианта для данноготипа результата
// Варинат не всегда нужно выполнять для некоторых результатов, например в Динамическом списке, не нужно выполнять запрос
// 
// Параметры:
//  Вариант  - общий модуль - модуль варианта
//  ОписаниеЗначения - Описание значения - возвращаемый параметр, тут мы можем переопределить результат в зависимости от того как будем его отображать, если задуматся глубоко то ДС вообше не должно существовать
// 
// Возвращаемое значение:
//  Булево - Выполнять вариант или нет
Функция ПереопределитьВыполнение(Форма,УникальныйИдентификатор,ТД,Параметры,ДопПараметры,Вариант,ОписаниеЗначения) Экспорт
	Возврат  РезультатыКлиентСервер_Ei.ВыполнятьВаринатПоУмолчанию();	
КонецФункции	

#Если Сервер Тогда
	
Функция Загрузить(Форма,ВариантИД,Результат,ИмяРеквизита,мКолонокРезультата) Экспорт
	Форма.РезультатЗапросаТД.Очистить();
	Форма.РезультатЗапросаТД.Вывести(Результат);	
	Возврат Истина;
КонецФункции

// Привести результат к типу, который возможно показать
// 
// Параметры:
//  СохраненныйРезультат - Произвольное значение - значение которые мы птыемся показать данным обработчиком
// 
// Возвращаемое значение:
//	Произвольное значение - Значение приведенное к типу	который можно тут отобразить   
Функция ПривестиРезультат(СохраненныйРезультат) Экспорт
	ОписаниеТипаРезультата 	= Новый ОписаниеТипов(Свойства().Имя);
	Результат 				= ОписаниеТипаРезультата.ПривестиЗначение(Неопределено);
	Если ТипЗнч(СохраненныйРезультат) = Тип("Структура") 
		И СохраненныйРезультат.Свойство("АдресМакета")  Тогда	
		//Это СКД с расшифровкой для макета ТД (выводится только в таб документ)
		ПроцессорКомпоновки 	= Новый ПроцессорКомпоновкиДанных;
		МакетКомпоновкиДанных	= ПолучитьИзВременногоХранилища(СохраненныйРезультат.АдресМакета);
		ДанныеРасшифровки		= ПолучитьИзВременногоХранилища(СохраненныйРезультат.АдресДанныхРасшифровки);
		//заполним внешние источники
		ВнешниеНаборыДанныхСКД = Новый Структура();
		//Для Каждого Параметр Из ПараметрыЗапроса Цикл
		//	Если ТипЗнч(Параметр.Значение) = Тип("ТаблицаЗначений") Тогда
		//		ВнешниеНаборыДанныхСКД.Вставить(Параметр.Ключ,Параметр.Значение);			
		//	КонецЕсли;	
		//КонецЦикла;
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновкиДанных,ВнешниеНаборыДанныхСКД,ДанныеРасшифровки);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
		ПроцессорВывода.УстановитьДокумент(Результат);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки);
		ПоместитьВоВременноеХранилище(ДанныеРасшифровки,СохраненныйРезультат.АдресДанныхРасшифровки); //обновим адрес для заполнения расшифровки
	ИначеЕсли ТипЗнч(СохраненныйРезультат) = Тип("РезультатЗапроса") Тогда
		Результат = Новый ТабличныйДокумент;
		РезТз 			= СохраненныйРезультат.Выгрузить();
	    Заголовки		= Новый Структура;
	    ОбластьВывода 	= Результат.ПолучитьОбласть(1, 1, 1, РезТз.Колонки.Количество());
	    Для Счетчик = 1 по РезТз.Колонки.Количество() Цикл
	        ОбластьЗаполнения = ОбластьВывода.Область(1, Счетчик, 1, Счетчик);
	        Колонка = РезТз.Колонки[Счетчик-1];
	        ОбластьЗаполнения.Параметр 				= Колонка.Имя;
	        ОбластьЗаполнения.Заполнение 			= ТипЗаполненияОбластиТабличногоДокумента.Параметр;
			ОбластьЗаполнения.ПараметрРасшифровки 	= Колонка.Имя;
	        Заголовки.Вставить(Колонка.Имя, Колонка.Имя);
		КонецЦикла;
	    ОбластьВывода.Параметры.Заполнить(Заголовки);
	    Результат.Вывести(ОбластьВывода);
		Результат.НачатьАвтогруппировкуСтрок();
			Выборка	= СохраненныйРезультат.Выбрать();
		    Пока Выборка.Следующий() Цикл
		        ОбластьВывода.Параметры.Заполнить(Выборка);
		        Результат.Вывести(ОбластьВывода);
			КонецЦикла;
		Результат.ЗакончитьАвтогруппировкуСтрок();;			
	КонецЕсли;
	Возврат Результат;		
КонецФункции


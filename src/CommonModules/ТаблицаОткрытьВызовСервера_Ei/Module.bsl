Процедура ДобавитьРеквизитыТЗ(Форма, ИмяОсновногоРеквизита,Результат) Экспорт
	мРеквизитовДобавление 		= Новый Массив;
	мРеквизитовУдаление 		= Новый Массив;
	мСуществующихРеквизитов     = Форма.ПолучитьРеквизиты(ИмяОсновногоРеквизита);
	мКолонкиРезультата			= ОбщийМодульСервер_Ei.ПолучитьКолонкиРезультата(Результат);
	Для Каждого Колонка Из мКолонкиРезультата Цикл
		СушРеквизит = Ложь;
		Для Каждого рФормы ИЗ мСуществующихРеквизитов Цикл
			Если 	рФормы.Имя 			= Колонка.Колонка.Имя Тогда
				Если рФормы.ТипЗначения	= Колонка.Колонка.ТипЗначения Тогда
					СушРеквизит = Истина;
					Прервать;
				Иначе
					//расходятся по типу их нужно добавить в удаляемые, ниже их отловить не удастся
					мРеквизитовУдаление.Добавить(рФормы.Путь+"."+рФормы.Имя);
				КонецЕсли;						
			КонецЕсли;	
		КонецЦикла;	
		Если Не СушРеквизит Тогда
			ДобавитьРеквизитТЗ(мРеквизитовДобавление,Колонка,ИмяОсновногоРеквизита);
		КонецЕсли;	
	КонецЦикла;

	//ОбщийМодульВызовСервера_Ei.ПроверитьСодержаниеКолонкиСПометкой(Результат);
	//удалим из реквизитов все те что есть на форме но нет в ТЗ (с большой долейвероятности они были раньше)
	Для каждого КолонкаФормы ИЗ  Форма.Элементы[ИмяОсновногоРеквизита].ПодчиненныеЭлементы Цикл
		Если ТипЗнч(КолонкаФормы) = Тип("ПолеФормы") Тогда
			Если Результат.Колонки.Найти(СтрРазделить(КолонкаФормы.ПутьКДанным,".")[1])=Неопределено Тогда
				мРеквизитовУдаление.Добавить(КолонкаФормы.ПутьКданным);			
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	//в том числе, вложенные ТЧ
	Для Каждого Эл_Страницы ИЗ Форма.Элементы[ИмяОсновногоРеквизита].Родитель.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(Эл_Страницы) = Тип("ГруппаФормы") Тогда
			Для Каждого Эл_Страница ИЗ Эл_Страницы.ПодчиненныеЭлементы Цикл
				Если ТипЗнч(Эл_Страница) = Тип("ГруппаФормы") Тогда
					Для Каждого Эл_Таблица ИЗ Эл_Страница.ПодчиненныеЭлементы Цикл
						Если ТипЗнч(Эл_Таблица) = Тип("ТаблицаФормы") Тогда
							ИмяКолонкиСВложеннойТаб = СтрРазделить(Эл_Таблица.ПутьКДанным,".")[3];
							Если Результат.Колонки.Найти(ИмяКолонкиСВложеннойТаб)=Неопределено Тогда
								мРеквизитовУдаление.Добавить(ИмяОсновногоРеквизита+"."+ИмяКолонкиСВложеннойТаб);
								Форма.Элементы.Удалить(Эл_Таблица);
							КонецЕсли;			
						КонецЕсли;	
					КонецЦикла;	
				КонецЕсли;			
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;
	Форма.ИзменитьРеквизиты(мРеквизитовДобавление,мРеквизитовУдаление);
КонецПроцедуры

Процедура ДобавитьРеквизитТЗ(мРеквизитовДобавление,Колонка,ИмяОсновногоРеквизита)
	ТипЗначения =  Колонка.Колонка.ТипЗначения;
	Если ТипЗначения.СодержитТип(Тип("Тип")) Тогда
		ТипЗначения =  Новый ОписаниеТипов(); //пустой тип это произвольный, не все типы можно добавлять на форму, к таким например относится Тип, на форму можно добавлять описание типов  #СпецОбработкаТипа
	КонецЕсли;	
	мРеквизитовДобавление.Добавить(Новый РеквизитФормы(Колонка.Колонка.Имя, ТипЗначения,ИмяОсновногоРеквизита));
	Для Каждого ВложеннаяКолонка ИЗ Колонка.мКолонкиРезультата Цикл
		ДобавитьРеквизитТЗ(мРеквизитовДобавление,ВложеннаяКолонка,ИмяОсновногоРеквизита+"."+Колонка.Колонка.Имя);
		//мРеквизитовДобавление.Добавить(Новый РеквизитФормы(ВложеннаяКолонка.Колонка.Имя, ВложеннаяКолонка.Колонка.ТипЗначения,ИмяОсновногоРеквизита+"."+Колонка.Колонка.Имя));	
	КонецЦикла;	
Конецпроцедуры	

Процедура ДобавитьКолонкиВЭлемент(Форма,ИдентификаторКолонок,ИмяОсновногоРеквизита,ПутьКДанным,мКолонокРезультата) Экспорт
	Ном 			= мКолонокРезультата.Количество()-1;
	ПредКолонка 	= Неопределено;
	Пока Ном>=0 Цикл  //обязательно обходим с конца чтобы можно было вставлять колонки
		Колонка 			= мКолонокРезультата.Получить(Ном).Колонка;
		мВложенныхКолонок   = мКолонокРезультата.Получить(Ном).мКолонкиРезультата;
		стрИмя 				= ИмяОсновногоРеквизита+Колонка.Имя;
		НовыйЭлемент 		= Форма.Элементы[ИмяОсновногоРеквизита].ПодчиненныеЭлементы.Найти(стрИмя);
		Если НовыйЭлемент = Неопределено Тогда
			Если Колонка.ТипЗначения.СодержитТип(Тип("ТаблицаЗначений")) Тогда //=  Новый ОписаниеТипов("ТаблицаЗначений") Тогда
				Если мВложенныхКолонок.Количество() Тогда
					Эл_СтраницыИмя 	= ИмяОсновногоРеквизита+"_"+Формат(ИдентификаторКолонок,"ЧН=0; ЧГ=")+"_ВложенныеТаблицы";
					Эл_Страницы 	= Форма.Элементы[ИмяОсновногоРеквизита].Родитель.ПодчиненныеЭлементы.Найти(Эл_СтраницыИмя);//Элементы[ИмяОсновногоРеквизита].Родитель.Имя);
					Если Эл_Страницы = Неопределено Тогда
						Форма.Элементы[ИмяОсновногоРеквизита].Родитель.Группировка =  ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
						Эл_Страницы 					= Форма.Элементы.Добавить(Эл_СтраницыИмя, Тип("ГруппаФормы"), Форма.Элементы[ИмяОсновногоРеквизита].Родитель);
						Эл_Страницы.Вид					= ВидГруппыФормы.Страницы;
						Эл_Страницы.ОтображениеСтраниц 	= ОтображениеСтраницФормы.ЗакладкиСнизу;
					КонецЕсли;
					Эл_СтраницаИмя	= Эл_СтраницыИмя+"_"+Колонка.Имя;
					Эл_Страница 	= Эл_Страницы.ПодчиненныеЭлементы.Найти(Эл_СтраницаИмя);//Элементы[ИмяОсновногоРеквизита].Родитель.Имя);
					Если Эл_Страница = Неопределено Тогда
						Эл_Страница = Форма.Элементы.Добавить(Эл_СтраницаИмя, Тип("ГруппаФормы"), Эл_Страницы);
						Эл_Страница.Вид			= ВидГруппыФормы.Страница;
						Эл_Страница.Заголовок 	= Колонка.Имя;//+?(ВложеннаяТЗ.Количество()," ("+ВложеннаяТЗ.Количество()+")",""); Кол-во нужно считать при активизации строки
					КонецЕсли;
					ИмяВложенногоРеквизита         	= ИмяОсновногоРеквизита+"_"+Формат(ИдентификаторКолонок,"ЧН=0; ЧГ=")+"_"+Колонка.Имя;
					ПутьКДаннымВложенногоРеквизита 	= "Элементы."+ИмяОсновногоРеквизита+".ТекущиеДанные."+Колонка.Имя;
					эл_Таблица 	= Эл_Страница.ПодчиненныеЭлементы.Найти(ИмяВложенногоРеквизита);
					Если эл_Таблица = Неопределено Тогда
						эл_Таблица 							= Форма.Элементы.Добавить(ИмяВложенногоРеквизита, Тип("ТаблицаФормы"), Эл_Страница);
						Попытка
				    		эл_Таблица.ПутьКДанным      		= ПутьКДаннымВложенногоРеквизита;
						Исключение
							Прервать;
						КонецПопытки;	
						эл_Таблица.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
					КонецЕсли;	
					ДобавитьКолонкиВЭлемент(Форма,ИдентификаторКолонок,ИмяВложенногоРеквизита,ПутьКДаннымВложенногоРеквизита,мВложенныхКолонок);
				КонецЕсли;	
			Иначе	
				НовыйЭлемент 				= Форма.Элементы.Вставить(стрИмя, Тип("ПолеФормы"),Форма.Элементы[ИмяОсновногоРеквизита],ПредКолонка);       
				НовыйЭлемент.Вид 			= ВидПоляФормы.ПолеВвода;
				НовыйЭлемент.Заголовок 		= Колонка.Имя; //имя используется при адресации при выборе
				НовыйЭлемент.ПутьКДанным 	= ПутьКДанным +"."+ Колонка.Имя;
				//Колонка Пометка_Ei тут не добавлется она расположена на форме таблиц и дерева по умолчанию, закрепил ее там с левой фиксацией
				НовыйЭлемент.Ширина 		= 10;
			КонецЕсли;	
		КонецЕсли;
		ПредКолонка = НовыйЭлемент;
		Ном = Ном-1;
	КонецЦикла;
Конецпроцедуры	

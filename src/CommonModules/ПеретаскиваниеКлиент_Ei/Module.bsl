//			Если Не Строка.ОграничениеТипа.СодержитТип(ТипЗнч(вБуферПеретаскивания.Значение)) Тогда
//				ПараметрыПеретаскивания.Действие =  ДействиеПеретаскивания.Отмена;	
//			КонецЕсли;	
//		КонецЕсли;
//		Если Не ПараметрыПеретаскивания.Действие =  ДействиеПеретаскивания.Отмена И
//			 Не Строка.Владелец().Колонки.Найти("ЭтоВыражение") = Неопределено И
//			 Строка.ЭтоВыражение И 
//			 Колонка.Данные = "ЗначениеПараметра" Тогда
//			 НачалоВыбора(Новый Структура("Значение",Строка.ЗначениеПараметра), Истина, ВладелецФормы.вСформироватьСтруктуруДляФормыВыбораТипа(Строка),Ложь);
//      КонецЕсли;
	КонецЕсли;

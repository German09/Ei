//Все значение преобразуем в текст, для мозможности перетаскивание на текстовое поле, 
//а значение кладем в буфер перетаскивания
//Параметры:
//	СтандартныеПараметры
//	сзЗначенияЯчеек	- СписокЗначений из Произвольный - Преобразованный список значений, строк переданных в ПараметрыПеретаскивания.Значение. чтобы не заниматся их различным вычислением для обычных таблиц и динамических списков
//
Процедура НачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение, сзЗначенияЯчеек) Экспорт
	СтруктураПеретаскивания 				= Новый Структура("Значение,ИмяКандидат",Новый СписокЗначений,Элемент.ТекущийЭлемент.Заголовок);
	СтрокаПредставления   	= "";
	Для Каждого ЭлСписка ИЗ сзЗначенияЯчеек Цикл
		Если Ложь Тогда
			//Не Значение.Владелец().Колонки.Найти("ЭтоВыражение") = Неопределено И Значение.ЭтоВыражение Тогда
			//Выражение		= ВладелецФормы.ПолучитьСтр(ПараметрыПеретаскив0ания.Значение);
			//вБуферПеретаскивания.Значение.Добавить(Выражение);
			//СтрокаПредставления	= СтрокаПредставления+" "+Символы.ПС+Выражение;
		Иначе
			//сНовыйАлгоритм = ОбщийМодульЗакрытыйКлиент_Ei.ПреобразоватьЗначениеКВыражению(Значение);
			//Если ТипЗнч(сНовыйАлгоритм) = Тип("Строка") Тогда
			//	ТД.ЗначениеПараметра = сНовыйАлгоритм;
			//Иначе
			//	//может вернуться неопределено, тогда мы просто ничего не посчитали
			//	ТД.ЭтоВыражение = Ложь;
			//КонецЕсли;	

			СтруктураПеретаскивания.Значение.Добавить(ЭлСписка.Значение);
			Выражение 	= ЭлСписка.Представление; //при перетаскивание из дерва выбора типа 	
			Если ПустаяСтрока(Выражение) Тогда
				Выражение = ТекстМодуляКлиент_Ei.ПреобразоватьЗначениеКВыражению(ЭлСписка.Значение); //м.б неопределено
			КонецЕсли;
			СтрокаПредставления	= СтрокаПредставления+", "+ Выражение
		КонецЕсли;
	КонецЦикла;                                                                                                                                  
	ПараметрыПеретаскивания.Значение = ?(ПустаяСтрока(СтрокаПредставления),СтрокаПредставления,Сред(СтрокаПредставления,3));
	Если СтруктураПеретаскивания.Значение.Количество() = 1 Тогда
		СтруктураПеретаскивания.Значение =  СтруктураПеретаскивания.Значение[0].Значение;		
	КонецЕсли;
	КэшПользователяКлиентСерверПовтИсп_Ei.Значения().Вставить(ПараметрыПеретаскивания.Значение,СтруктураПеретаскивания)
КонецПроцедуры

Процедура ПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле) Экспорт

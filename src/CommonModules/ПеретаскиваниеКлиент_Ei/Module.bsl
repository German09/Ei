				КонецЕсли;	
				СписокПодМеню.Добавить(Неопределено,"Отмена");
				ОО_ПеретаскиваниеВыбор = Новый ОписаниеОповещения("ПеретаскиваниеВыбор",ПеретаскиваниеКлиент_Ei,Новый Структура("Результат,Строка",стрРезультат,Строка)); 

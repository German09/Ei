Процедура ПеретаскиваниеВыбор(Знач Значение,ДопПараметры) Экспорт
	Если Не Значение = Неопределено Тогда
		//элемент списка значений
		Значение = Значение.Значение;
		Если Значение = 1 Тогда
			//Обновить значение
			ЗаполнитьЗначенияСвойств(ДопПараметры.Строка,ДопПараметры.Результат); 
		ИначеЕсли Значение = 2 Тогда	
			//Добавить к значению
			Если Не ТипЗнч(ДопПараметры.Строка.ЗначениеПараметра) = Тип("СписокЗначений") Тогда
				сзЗначениеПараметра =  Новый СписокЗначений();
				сзЗначениеПараметра.Добавить(ДопПараметры.Строка.ЗначениеПараметра);
				ДопПараметры.Строка.ЗначениеПараметра = сзЗначениеПараметра;
			КонецЕсли;
			ДопПараметры.Строка.ЗначениеПараметра.Добавить(ДопПараметры.Результат.ЗначениеПараметра);
		КонецЕСли;	
	КонецЕсли;	
КонецПроцедуры

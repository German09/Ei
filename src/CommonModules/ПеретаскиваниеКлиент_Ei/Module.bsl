Процедура Перетаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле, Форма, ОО_ДобавлениеНового) Экспорт
	Если Не ПараметрыПеретаскивания.Действие =  ДействиеПеретаскивания.Отмена Тогда
		СтруктураПеретаскивания = КэшПользователяКлиентСерверПовтИсп_Ei.Значения().Получить(ПараметрыПеретаскивания.Значение);
		Если СтруктураПеретаскивания =  Неопределено Тогда
			//Ничего не нашли могли туда перетащить обычный текст для которого не выполнялись обработчики Начала перетаскивания
			ПараметрыПеретаскивания.Значение = СтрШаблон("""%1""",ПараметрыПеретаскивания.Значение);
			СтруктураПеретаскивания = Новый Структура("Значение", ПараметрыПеретаскивания.Значение);
		КонецЕсли;
		стрРезультат = Новый Структура();
		стрРезультат.Вставить("ЭтоВыражение",(ПараметрыПеретаскивания.Значение = СтруктураПеретаскивания.Значение));
		стрРезультат.Вставить("ЗначениеПараметра",СтруктураПеретаскивания.Значение);

		Если Строка = Неопределено 	Тогда
			СтандартнаяОбработка = Ложь;
			стрРезультат.Вставить("ИмяКандидат");
			СтруктураПеретаскивания.Свойство("ИмяКандидат",стрРезультат.ИмяКандидат);
			ВыполнитьОбработкуОповещения(ОО_ДобавлениеНового,стрРезультат);
		Иначе
			СтандартнаяОбработка = Ложь;
			Если Не ЗначениеЗаполнено(Строка.ЗначениеПараметра) Тогда
				ЗаполнитьЗначенияСвойств(Строка,стрРезультат);  
			Иначе
				СписокПодМеню = Новый СписокЗначений;   

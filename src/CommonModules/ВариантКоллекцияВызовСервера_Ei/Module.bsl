#Область ПрограммныйИнтерфейс

Процедура Инициализировать(Форма, Контейнер) Экспорт
	КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,ВариантКоллекцияКлиентСервер_Ei);
	ДобавляемыеРеквизиты	= Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя, Новый ОписаниеТипов("Строка"),КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента(),,Истина));
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
КонецПроцедуры	

// Добавить реквизиты.
// 
// Параметры:
//  Форма 			- см. ВариантКоллекцияКлиентСервер_Ei.Форма
//  Идентификатор	- см. ВариантКоллекцияКлиентСервер_Ei.Идентификатор
//
Процедура ДобавитьРеквизиты(Форма, Идентификатор) Экспорт
	Перем ИмяРеквизита;
	Обработчик	= ВариантКоллекцияКлиентСервер_Ei;
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработкиСервер(Идентификатор);
	Если Не ТекД = Неопределено Тогда
		Коллекция = КоллекцияИзДанных(ТекД[Обработчик.Свойства().Имя]);
		ОписаниеТипа 	= ТипыКлиентСервер_Ei.СоздатьОписаниеИзКолекции(ТипЗнч(Коллекция));
		ЭлФормы			= РезультатыСервер_Ei.ДобавитьРеквизитыКоллекции(Форма,Обработчик,ТекД,ИмяРеквизита,ОписаниеТипа); 	
		Загрузить(Форма,Коллекция,ИмяРеквизита,Идентификатор);
		ЭлФормы.УстановитьДействие("ПриИзменении","ПриИзменении_ТаблицаФормы");
		
		Префикс 			= ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя;
		КонтейнерКПВарианта	= ВариантыКлиентСервер_Ei.КонтейнерКПВарианта(Форма,Обработчик,Идентификатор);
		//КонтейнерКПВарианта 	= элФормы.КоманднаяПанель;
		
		//Добавление кнопок
		ПодменюЗагрузить = Форма.Элементы.Добавить(Префикс+"ПодменюЗагрузить"+Идентификатор, Тип("ГруппаФормы"), КонтейнерКПВарианта);
		ПодменюЗагрузить.Вид 		= ВидГруппыФормы.Подменю;
		ПодменюЗагрузить.Заголовок 	= "Загрузить";
		ПодменюЗагрузить.Картинка 	= БиблиотекаКартинок.Загрузить_Ei;
			ДобавитьКнопку(Форма, ЭлФормы,"Загрузить",ПодменюЗагрузить);
			ДобавитьКнопку(Форма, ЭлФормы,"ЗагрузитьФайл",ПодменюЗагрузить);
		ПодменюКолонки = Форма.Элементы.Добавить(Префикс+"ПодменюКолонки"+Идентификатор, Тип("ГруппаФормы"), КонтейнерКПВарианта);
		ПодменюКолонки.Вид 			= ВидГруппыФормы.Подменю;
		ПодменюКолонки.Заголовок 	= "Колонки";
		ПодменюКолонки.Картинка 	= БиблиотекаКартинок.Колонки_Ei;
			ДобавитьКнопку(Форма, ЭлФормы,"СкопироватьКолонку",ПодменюКолонки);
			ДобавитьКнопку(Форма, ЭлФормы,"Колонки",ПодменюКолонки);
		ДобавитьКнопку(Форма, ЭлФормы,"ТекущееЗначение",КонтейнерКПВарианта);
		ДобавитьКнопку(Форма, ЭлФормы,"ИзБуфера",КонтейнерКПВарианта);	
	КонецЕсли;							
КонецПроцедуры 	

Процедура ДополнитьДинамическийЭлементФормы(Форма,элФормы) Экспорт
	элФормы.ПоложениеКоманднойПанели		= ПоложениеКоманднойПанелиЭлементаФормы.Верх;
КонецПроцедуры

Процедура СохранитьКоллекцию(Форма,ИД) Экспорт
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработкиСервер(ИД);
	Если Не ТД = Неопределено Тогда
		Обработчик		= ВариантКоллекцияКлиентСервер_Ei;
		ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Форма,ТД,Обработчик);
		ТД[Обработчик.Свойства().Имя] = ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(Форма.РеквизитФормыВЗначение(ИмяРеквизита));	
	КонецЕсли;			
КонецПроцедуры

Процедура ЗагрузитьКоллекцию(Форма,КоллекцияИлиОписание,Идентификатор) Экспорт
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработкиСервер(Идентификатор);
	Если Не ТекД = Неопределено Тогда
		Обработчик		= ВариантКоллекцияКлиентСервер_Ei;
		ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Форма,ТекД, Обработчик);
		Коллекция		= ПривестиКоллекцию(КоллекцияИлиОписание);
		Загрузить(Форма,Коллекция,ИмяРеквизита,Идентификатор);
		СохранитьКоллекцию(Форма,Идентификатор);
	КонецЕсли;
КонецПроцедуры

// Перечитывает таблицу коллекции строки из данных строки: их задал код варианта, см. ВариантКоллекцияКлиент_Ei.ЗагрузитьЗаданныеДанные
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  Идентификатор - Число - идентификатор строки набора
//
Процедура ПрочитатьКоллекцию(Форма,Идентификатор) Экспорт
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработкиСервер(Идентификатор);
	Если Не ТекД = Неопределено Тогда
		Обработчик		= ВариантКоллекцияКлиентСервер_Ei;
		ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Форма,ТекД, Обработчик);
		Коллекция		= КоллекцияИзДанных(ТекД[Обработчик.Свойства().Имя]);
		Загрузить(Форма,Коллекция,ИмяРеквизита,Идентификатор);
		СохранитьКоллекцию(Форма,Идентификатор);
	КонецЕсли;
КонецПроцедуры

// Коллекция строки из ее данных. Пока коллекцию не меняли, данные строки пустые, а в форме
// таблица по умолчанию с одной колонкой: ее же получают и другие формы, например «Изменить структуру».
//
// Параметры:
//  Данные - Строка - сериализованная коллекция строки набора
//
// Возвращаемое значение:
//  ТаблицаЗначений, ДеревоЗначений
//
Функция КоллекцияИзДанных(Данные) Экспорт
	Коллекция = ОбщегоНазначенияКлиентСервер_Ei.Структурировать(Данные);
	Если Не ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") И Не ТипЗнч(Коллекция) = Тип("ДеревоЗначений") Тогда
		//значение по умолчанию
		Коллекция = Новый ТаблицаЗначений();
		Коллекция.Колонки.Добавить("Колонка");
	КонецЕсли;
	Возврат Коллекция;
КонецФункции

// Приводит источник к коллекции варианта, как команда «Загрузить»: таблица и дерево значений остаются как есть,
// остальное преобразуется в таблицу, см. РезультатТаблицаВызовСервера_Ei.ПривестиРезультат
//
// Параметры:
//  КоллекцияИлиОписание - Произвольный, см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
// Возвращаемое значение:
//  ТаблицаЗначений, ДеревоЗначений
//
Функция ПривестиКоллекцию(КоллекцияИлиОписание) Экспорт
	Коллекция		= ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(КоллекцияИлиОписание);
	Если ТипЗнч(Коллекция) = Тип("ОбработкаОбъект.ВариантЗапрос_Ei") Тогда
		//результат запроса, выполненного в фоне, см. ВариантыВызовСервера_Ei.ЗаменительВыгрузки
		Коллекция = Коллекция.Выгрузить();
	КонецЕсли;
	Если ТипЗнч(Коллекция) =  Тип("ТаблицаЗначений") ИЛИ ТипЗнч(Коллекция) =  Тип("ДеревоЗначений") Тогда
		//то что нужно, ничего не делаем
	Иначе
		Коллекция = РезультатТаблицаВызовСервера_Ei.ПривестиРезультат(Коллекция);
	КонецЕсли;
	Если ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
		Коллекция = БулевыКолонкиБезNull(Коллекция);
	КонецЕсли;
	Возврат Коллекция;
КонецФункции

// Убирает Null из типа булевых колонок: выгрузка результата запроса добавляет Null к типу каждой колонки, даже у ИСТИНА КАК Поле,
// а флажком в коллекции показывается только колонка Булево, см. КоллекцияВызовСервера_Ei.ЗаполнитьСвостваЭлемента.
// Значения Null в таких колонках становятся Ложь. Таблица источника не меняется: колонки меняются в копии
//
// Параметры:
//  Таблица - ТаблицаЗначений
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция БулевыКолонкиБезNull(Таблица) Экспорт
	ТипБулево		= Новый ОписаниеТипов("Булево");
	ИменаКолонок	= Новый Массив; // Массив из Строка
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Если 	Колонка.ТипЗначения <> ТипБулево
				И Новый ОписаниеТипов(Колонка.ТипЗначения, , "Null") = ТипБулево Тогда
			ИменаКолонок.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	Если ИменаКолонок.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;
	Результат = Таблица.Скопировать();
	Для Каждого ИмяКолонки Из ИменаКолонок Цикл
		Колонка		= Результат.Колонки[ИмяКолонки];
		Индекс		= Результат.Колонки.Индекс(Колонка);
		Заголовок	= Колонка.Заголовок;
		Значения	= Новый Массив; // Массив из Булево
		Для Каждого Значение Из Результат.ВыгрузитьКолонку(ИмяКолонки) Цикл
			Значения.Добавить(ТипБулево.ПривестиЗначение(Значение));
		КонецЦикла;
		Результат.Колонки.Удалить(Колонка);
		Результат.Колонки.Вставить(Индекс, ИмяКолонки, ТипБулево, Заголовок);
		Результат.ЗагрузитьКолонку(Значения, ИмяКолонки);
	КонецЦикла;
	Возврат Результат;
КонецФункции

//Изменяем структуру коллекции (добавляем колонки) в случае корректировки структуры
//
Процедура ИзменитьКоллекцию(Форма,мКоллекцияИСостсав,ИД) Экспорт
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработкиСервер(ИД);
	Если Не ТД = Неопределено Тогда
		Обработчик		= ВариантКоллекцияКлиентСервер_Ei;
		ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Форма,ТД,Обработчик);
		Коллекция		= Форма.РеквизитФормыВЗначение(ИмяРеквизита);
		КоллекцияСтруктураВызовСервера_Ei.ИзменитьКоллекцию(Коллекция,мКоллекцияИСостсав);
		Загрузить(Форма,Коллекция,ИмяРеквизита,ИД);
		СохранитьКоллекцию(Форма,ИД);
	КонецЕсли;			
КонецПроцедуры

Процедура Загрузить(Форма,Коллекция,ИмяРеквизита,ИД=0,Местонахождение=Неопределено) Экспорт
	Перем КолонокиРезультата;
	РезультатыСервер_Ei.ЗагрузитьТаблицуИлиДерево(Форма,Коллекция,КолонокиРезультата,ИмяРеквизита);
	КоллекцияВызовСервера_Ei.ДобавитьКолонкиВЭлемент(Форма,ИД,ИмяРеквизита,ИмяРеквизита,КолонокиРезультата,Местонахождение);	
КонецПроцедуры
#КонецОбласти


#Область СлужебныеПроцедурыИФункции
Процедура ДобавитьКнопку(Форма, ЭлФормы, ОкончаниеКоманды, КоманднаяПанель)
	Кнопка = Форма.Элементы.Добавить(ОкончаниеКоманды+элФормы.Имя, Тип("КнопкаФормы"), КоманднаяПанель);
	Кнопка.ИмяКоманды = ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя+НаследованиеФормКлиентСервер_Ei.стрРазделительИмени()+ОкончаниеКоманды;
КонецПроцедуры
#КонецОбласти

	

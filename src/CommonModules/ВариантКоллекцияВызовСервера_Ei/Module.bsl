Процедура ДобавитьРеквизиты(Форма, ИД) Экспорт
	Перем ИмяРеквизита;
	Перем мКолонокРезультата;
	Обработчик	= ВариантКоллекцияКлиентСервер_Ei;
	Если ИД = Неопределено Тогда
		//это первичное заполнение, на этапе инициализации
		КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,Обработчик);
		ДобавляемыеРеквизиты	= Новый Массив;
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя, Новый ОписаниеТипов("Строка"),КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента()));
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);	
	Иначе
		ТД = Форма.ПолучитьПереопределяемыйОбъектОбработкиСервер(ИД);
		Если Не ТД = Неопределено Тогда
			Результат = Новый ТаблицаЗначений();
			Результат.Колонки.Добавить("Колонка"+ИД);
			
			элФормы		= РезультатыСервер_Ei.ДобавитьРеквизиты(Форма,Обработчик,ТД,ИмяРеквизита,Новый ОписаниеТипов("ТаблицаЗначений")); 	
			РезультатыСервер_Ei.ЗагрузитьТаблицуИлиДерево(Форма,Результат,мКолонокРезультата,ИмяРеквизита);
			ТаблицаОткрытьВызовСервера_Ei.ДобавитьКолонкиВЭлемент(Форма,ИД,ИмяРеквизита,ИмяРеквизита,мКолонокРезультата);
			
			ОкончаниеКоманды = "Колонки";
			Кнопка = Форма.Элементы.Добавить(ОкончаниеКоманды+элФормы.Имя, Тип("КнопкаФормы"), элФормы.КоманднаяПанель);
			Кнопка.ИмяКоманды = ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя+НаследованиеФормКлиентСервер_Ei.стрРазделительИмени()+ОкончаниеКоманды;
		КонецЕсли;
	КонецЕсли;							
КонецПроцедуры 	

Процедура ДополнитьДинамическийЭлементФормы(элФормы) Экспорт
	элФормы.ПоложениеКоманднойПанели		= ПоложениеКоманднойПанелиЭлементаФормы.Верх;
КонецПроцедуры

Функция ПолучитьКолонки(Коллекция) Экспорт
	Результат 		= Новый Массив;
	ТекущийНабор 	= Неопределено;
	Если ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
		ТекущийНабор 	=  Коллекция
	ИначеЕсли ТипЗнч(Коллекция) = Тип("ДеревоЗначений") Тогда
		ТекущийНабор 	=  Коллекция.Строки;	
	КонецЕсли;	
	Для Каждого Колонка ИЗ Коллекция.Колонки Цикл
		мВложенныхКолонок =  Новый Массив;
		Если ТипыВызовСервера_Ei.ОписаниеВложеннойКоллекции(Колонка.ТипЗначения) Тогда
			Если Не ТекущийНабор = Неопределено Тогда
				Для Каждого Подстрока ИЗ ТекущийНабор Цикл
					Если Подстрока[Колонка.Имя].Количество() Тогда
						мВложенныхКолонок = ПолучитьКолонки(Подстрока[Колонка.Имя]);
						Прервать;
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Колонка,мКолонки",Новый Структура("Имя,ТипЗначения",Колонка.Имя,Колонка.ТипЗначения),мВложенныхКолонок)); //объект возвращается на клиент для создания граф схемы поэтому приводим к простому типу
	КонецЦикла;	
	Возврат Результат;
КонецФункции	
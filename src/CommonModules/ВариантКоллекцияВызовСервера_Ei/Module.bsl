Процедура Инициализировать(Форма, Контейнер) Экспорт
	КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,ВариантКоллекцияКлиентСервер_Ei);
	ДобавляемыеРеквизиты	= Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя, Новый ОписаниеТипов("Строка"),КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента(),,Истина));
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
КонецПроцедуры	

Процедура ДобавитьРеквизиты(Форма, ИД) Экспорт
	Перем ИмяРеквизита;
	Обработчик	= ВариантКоллекцияКлиентСервер_Ei;
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработкиСервер(ИД);
	Если Не ТД = Неопределено Тогда
		Если ЗначениеЗаполнено(ТД[Обработчик.Свойства().Имя]) Тогда
			Коллекция = ОбщегоНазначенияКлиентСервер_Ei.Структурировать(ТД[Обработчик.Свойства().Имя]);
		Иначе
			//значение по умолчанию
			Коллекция = Новый ТаблицаЗначений();
			Коллекция.Колонки.Добавить("Колонка");
		КонецЕсли;
		ОписаниеТипа 	= ТипыКлиентСервер_Ei.СоздатьОписаниеИзКолекции(ТипЗнч(Коллекция));
		элФормы			= РезультатыСервер_Ei.ДобавитьРеквизитыКоллекции(Форма,Обработчик,ТД,ИмяРеквизита,ОписаниеТипа); 	
		Загрузить(Форма,Коллекция,ИмяРеквизита,ИД);
		элФормы.УстановитьДействие("ПриИзменении","ПриИзменении_ТаблицаФормы");
		
		Префикс 			= ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя;
		КонтейнерКПВарианта	= ВариантыКлиентСервер_Ei.КонтейнерКПВарианта(Форма,Обработчик,ИД);
		//КонтейнерКПВарианта 	= элФормы.КоманднаяПанель;
		//Добавление кнопок
		ПодменюЗагрузить = Форма.Элементы.Добавить(Префикс+"ПодменюЗагрузить"+ИД, Тип("ГруппаФормы"), КонтейнерКПВарианта);
		ПодменюЗагрузить.Вид 		= ВидГруппыФормы.Подменю;
		ПодменюЗагрузить.Заголовок 	= "Загрузить";
		ПодменюЗагрузить.Картинка 	= БиблиотекаКартинок.Загрузить_Ei;
			ДобавитьКнопку(Форма, элФормы,"Загрузить",ПодменюЗагрузить);
			ДобавитьКнопку(Форма, элФормы,"ЗагрузитьФайл",ПодменюЗагрузить);
		ПодменюКолонки = Форма.Элементы.Добавить(Префикс+"ПодменюКолонки"+ИД, Тип("ГруппаФормы"), КонтейнерКПВарианта);
		ПодменюКолонки.Вид 			= ВидГруппыФормы.Подменю;
		ПодменюКолонки.Заголовок 	= "Колонки";
		ПодменюКолонки.Картинка 	= БиблиотекаКартинок.Колонки_Ei;
			ДобавитьКнопку(Форма, элФормы,"СкопироватьКолонку",ПодменюКолонки);
			ДобавитьКнопку(Форма, элФормы,"Колонки",ПодменюКолонки);
		ДобавитьКнопку(Форма, элФормы,"ТекущееЗначение",КонтейнерКПВарианта);	
	КонецЕсли;							
КонецПроцедуры 	

Процедура ДобавитьКнопку(Форма, элФормы, ОкончаниеКоманды, КоманднаяПанель)
	Кнопка = Форма.Элементы.Добавить(ОкончаниеКоманды+элФормы.Имя, Тип("КнопкаФормы"), КоманднаяПанель);
	Кнопка.ИмяКоманды = ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя+НаследованиеФормКлиентСервер_Ei.стрРазделительИмени()+ОкончаниеКоманды;
КонецПроцедуры

Процедура ДополнитьДинамическийЭлементФормы(Форма,элФормы) Экспорт
	элФормы.ПоложениеКоманднойПанели		= ПоложениеКоманднойПанелиЭлементаФормы.Верх;
КонецПроцедуры

Процедура СохранитьКоллекцию(Форма,ИД) Экспорт
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработкиСервер(ИД);
	Если Не ТД = Неопределено Тогда
		Обработчик		= ВариантКоллекцияКлиентСервер_Ei;
		ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Форма,ТД,Обработчик);
		ТД[Обработчик.Свойства().Имя] = ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(Форма.РеквизитФормыВЗначение(ИмяРеквизита));	
	КонецЕсли;			
КонецПроцедуры

Процедура ЗагрузитьКоллекцию(Форма,КоллекцияИлиОписание,ИД) Экспорт
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработкиСервер(ИД);
	Если Не ТД = Неопределено Тогда
		Обработчик		= ВариантКоллекцияКлиентСервер_Ei;
		ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Форма,ТД, Обработчик);
		Коллекция		= ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(КоллекцияИлиОписание);
		Если ТипЗнч(Коллекция) =  Тип("ТаблицаЗначений") ИЛИ ТипЗнч(Коллекция) =  Тип("ДеревоЗначений") Тогда
			//то что нужно, ничего не делаем	
		Иначе	
			Коллекция = РезультатТаблицаВызовСервера_Ei.ПривестиРезультат(Коллекция);
		КонецЕсли;	
		Загрузить(Форма,Коллекция,ИмяРеквизита,ИД);
		СохранитьКоллекцию(Форма,ИД);
	КонецЕсли;			
КонецПроцедуры

//Изменяем структуру коллекции (добавляем колонки) в случае корректировки структуры
//
Процедура ИзменитьКоллекцию(Форма,мКоллекцияИСостсав,ИД) Экспорт
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработкиСервер(ИД);
	Если Не ТД = Неопределено Тогда
		Обработчик		= ВариантКоллекцияКлиентСервер_Ei;
		ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Форма,ТД,Обработчик);
		Коллекция		= Форма.РеквизитФормыВЗначение(ИмяРеквизита);
		КоллекцияСтруктураВызовСервера_Ei.ИзменитьКоллекцию(Коллекция,мКоллекцияИСостсав);
		Загрузить(Форма,Коллекция,ИмяРеквизита,ИД);
		СохранитьКоллекцию(Форма,ИД);
	КонецЕсли;			
КонецПроцедуры

Процедура Загрузить(Форма,Коллекция,ИмяРеквизита,ИД=0,Местонахождение=Неопределено) Экспорт
	Перем КолонокиРезультата;
	РезультатыСервер_Ei.ЗагрузитьТаблицуИлиДерево(Форма,Коллекция,КолонокиРезультата,ИмяРеквизита);
	КоллекцияВызовСервера_Ei.ДобавитьКолонкиВЭлемент(Форма,ИД,ИмяРеквизита,ИмяРеквизита,КолонокиРезультата,Местонахождение);	
КонецПроцедуры

	
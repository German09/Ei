Процедура ДобавитьРеквизиты(Форма, ИД) Экспорт
	Перем ИмяРеквизита;
	Перем мКолонокРезультата;
	Обработчик	= ВариантКоллекцияКлиентСервер_Ei;
	Если ИД = Неопределено Тогда
		//это первичное заполнение, на этапе инициализации
		КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,Обработчик);
		ДобавляемыеРеквизиты	= Новый Массив;
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя, Новый ОписаниеТипов("Строка"),КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента()));
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);	
	Иначе
		ТД = Форма.ПолучитьПереопределяемыйОбъектОбработкиСервер(ИД);
		Если Не ТД = Неопределено Тогда
			Результат = Новый ТаблицаЗначений();
			Результат.Колонки.Добавить("Колонка"+ИД);
			
			элФормы		= РезультатыСервер_Ei.ДобавитьРеквизитыКоллекции(Форма,Обработчик,ТД,ИмяРеквизита,Новый ОписаниеТипов("ТаблицаЗначений")); 	
			РезультатыСервер_Ei.ЗагрузитьТаблицуИлиДерево(Форма,Результат,мКолонокРезультата,ИмяРеквизита);
			КоллекцияВызовСервера_Ei.ДобавитьКолонкиВЭлемент(Форма,ИД,ИмяРеквизита,ИмяРеквизита,мКолонокРезультата);
			элФормы.УстановитьДействие("ПриИзменении","ПриИзменении_ТаблицаФормы");
			
			ОкончаниеКоманды = "Колонки";
			Кнопка = Форма.Элементы.Добавить(ОкончаниеКоманды+элФормы.Имя, Тип("КнопкаФормы"), элФормы.КоманднаяПанель);
			Кнопка.ИмяКоманды = ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя+НаследованиеФормКлиентСервер_Ei.стрРазделительИмени()+ОкончаниеКоманды;
		КонецЕсли;
	КонецЕсли;							
КонецПроцедуры 	

Процедура ДополнитьДинамическийЭлементФормы(элФормы) Экспорт
	элФормы.ПоложениеКоманднойПанели		= ПоложениеКоманднойПанелиЭлементаФормы.Верх;
КонецПроцедуры

Процедура СохранитьКоллекцию(Форма,ИД) Экспорт
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработкиСервер(ИД);
	Если Не ТД = Неопределено Тогда
		Обработчик		= ВариантКоллекцияКлиентСервер_Ei;
		ИмяРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Обработчик,ТД);
		ТД[Обработчик.Свойства().Имя] = ОбщийМодульКлиентСервер_Ei.Сериализовать(Форма.РеквизитФормыВЗначение(ИмяРеквизита));	
	КонецЕсли;			
КонецПроцедуры	
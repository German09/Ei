// Переопределемая процедура - Выполнить обработку
//
// Параметры:
//  ОписаниеПотока	 - Структура 	- Структура формируемая процедурой ПроцессыКлиент_Ei.ВыполнитьПоток()
//										- сзВызовов 	- СписокЗначений 	- Последовательность подготовленных ОписанийОповещений вызова обоработок, первой располагется следующая к запуску обработка
//										- Контекст  	- Структура  		- Аналог структуры "ДоступныеСтруктуры" из переменной формы СтруктураПеременных
//  ВозврЗначение	 - Структура - Описание возврашаемого значения, в который нужно поместить результат выполнения, своства структуры формируются функцией ОписаниеЗначенияВызовСервера_Ei.Получить()
//
Функция ВыполнитьОбработку(Настройка)
	СтрНастройка = ПолучитьДанныеНастройки(Настройка);
	Возврат ВыполнитьКлиентСервер_Ei.Выражение(СтрНастройка.ТекстМодуля);
КонецФункции

// Загружает текущую настройку, выполняется самой первой как при интерактивном открытии так и при выполнении
//
// Параметры:
//  Настройка - Строка- Настройка обработки.
//Возвращаемое значение:
//   Структура
//   	* ТекстМодуля
//   	* ВозвращаемоеЗначение
//
Функция ПолучитьДанныеНастройки(Настройка) Экспорт
	Результат = Новый Структура;
	Если Не Настройка = Неопределено Тогда
		сооНастройка 			= ОбщийМодульВызовСервера_Ei.Структурировать(Настройка,Новый Соответствие);
		Результат.Вставить("ТекстМодуля", 			сооНастройка.Получить("Algoritm.bsl"));
		Результат.Вставить("ВозвращаемоеЗначение", 	сооНастройка.Получить("Return.xml"));		
	Иначе
		//настройка по умолчанию	
		//ВозврЗначениеКлиент_Ei.ПоУмолчанию(ЭтаФорма);
	КонецЕсли;
	Возврат Результат;	
КонецФункции

// Функция - получить значение, которое будет интрпретированна как настройка формы
// 
// Возвращаемое значение:
//   Соответствие из Строка
//
Функция ПолучитьНастройку(Форма) Экспорт
	Результат = Новый Соответствие;
	Результат.Вставить("Algoritm.bsl",	Форма.ТекстМодуля);
	Результат.Вставить("Return.xml",	Форма.ВозвращаемоеЗначение);
	Возврат Результат;
КонецФункции	


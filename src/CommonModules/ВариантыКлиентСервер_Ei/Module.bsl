Функция ПолучитьТекущийОбработчик(Форма,ТД) Экспорт
	ИмяОбработчика = НастройкиПользователяКлиентСервер_Ei.ПолучитьИмяТекущегоОбработчика(ТД,Форма.НастройкиПользователя,ВариантыКлиентСерверПовторноеИспользование_Ei.Ключ());
	Возврат ВариантыКлиентСерверПовторноеИспользование_Ei.ПолучитьВарианты().Получить(ИмяОбработчика);	
КонецФункции

Функция ПолучитьДекорациюОшибки(Форма) Экспорт
	Возврат Форма.Элементы.Найти("ОшибкаВариантаТекст");
КонецФункции

Функция ПолучитьВариант(Форма,Строка)	Экспорт
	ВложеннаяСтруктура  = Новый Структура;
	ВложеннаяСтруктура.Вставить("КлючНастроек",	Строка.КлючНастроек);
	ВложеннаяСтруктура.Вставить("Имя",			Строка.Запрос);
	ВложеннаяСтруктура.Вставить("Параметры",	Новый ФиксированнаяСтруктура(ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру(Строка.ПараметрыЗапроса)));
	ВложеннаяСтруктура.Вставить("Результаты",	Новый ФиксированнаяСтруктура(ПолучитьСтруктуруРезультатов(Форма,Строка)));
	ВложеннаяСтруктура.Вставить("Данные",		Новый ФиксированнаяСтруктура(ПолучитьСтруктуруДанных(Форма,Строка)));
	Возврат Новый ФиксированнаяСтруктура(ВложеннаяСтруктура); 	
КонецФункции

Функция ПолучитьСтруктуруРезультатов(Форма,Строка) Экспорт
	ВложеннаяСтруктура  = Новый Структура;
	Для Каждого ЭлВарианта ИЗ ВариантыКлиентСерверПовторноеИспользование_Ei.ПолучитьВарианты() Цикл
		ОписаниеЗначения 		= КэшПользователяКлиентСервер_Ei.ПолучитьОписаниеРезультата(Строка,Форма.КэшПользователя,ЭлВарианта.Ключ);
		ВложеннаяСтруктура.Вставить(ЭлВарианта.Ключ,ОписаниеЗначения);	
	КонецЦикла;
	Возврат ВложеннаяСтруктура;		
КонецФункции

Функция ПолучитьСтруктуруДанных(Форма,Строка) Экспорт
	ВложеннаяСтруктура  = Новый Структура;
	Если ТипЗнч(Строка) = Тип("ФиксированнаяСтруктура") Тогда
		//это уже готовая с структура варианта котору мы получили из параметров сеанса
		Если Строка.Свойство("Данные") Тогда
			//По сути преобразовываем фиксированную структуру в обычную
			Для Каждого ЭлФиксСтруктуры ИЗ Строка.Данные Цикл
				ВложеннаяСтруктура.Вставить(ЭлФиксСтруктуры.Ключ,ЭлФиксСтруктуры.Значение);	
			КонецЦикла;
		КонецЕсли;	
	Иначе
		//это строка набора вариантов		
		Для Каждого ЭлВарианта ИЗ ВариантыКлиентСерверПовторноеИспользование_Ei.ПолучитьВарианты() Цикл
			Вариант = ЭлВарианта.Значение;
			ВложеннаяСтруктура.Вставить(ЭлВарианта.Ключ,Вариант.ПодготовитьДанные(Форма,Строка));	
		КонецЦикла;
	КонецЕсли;	
	Возврат ВложеннаяСтруктура;		
КонецФункции		

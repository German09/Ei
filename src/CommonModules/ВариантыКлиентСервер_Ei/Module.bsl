Процедура Инициализировать(Форма) Экспорт
	Для Каждого ЭлВарианта ИЗ ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
		ОбщийМодульКлиентСервер_Ei.Инициализировать(Форма, ЭлВарианта.Значение);
	КонецЦикла;	
Конецпроцедуры

Функция Ключ() Экспорт
	Возврат "Варианты_Ei";	
КонецФункции

Функция ПолучитьТекущийОбработчик(Форма,ТД) Экспорт
	ИмяОбработчика = НастройкиПользователяКлиентСервер_Ei.ПолучитьИмяТекущегоОбработчика(ТД,Форма.НастройкиПользователя,ВариантыКлиентСервер_Ei.Ключ(),Неопределено);
	Возврат ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(ИмяОбработчика);	
КонецФункции

Функция ПолучитьДекорациюОшибки(Форма) Экспорт
	Возврат Форма.Элементы.Найти("ОшибкаВариантаТекст");
КонецФункции

Функция Контейнер(Форма) Экспорт
	Возврат Форма.Элементы.ПанельТекстаЗапроса;	
КонецФункции

Функция Данные(ИмяНабора, ИмяВарианта) Экспорт
	Перем Результат;
	ИсходныеДанные = ПолучитьИзНабора("Данные",ИмяНабора,ИмяВарианта);
	Обработчик = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(ИмяВарианта);
	Если Не Обработчик = Неопределено Тогда
		Результат = Обработчик.Данные(ИсходныеДанные);
	Иначе
		Результат = ИсходныеДанные;		
	КонецЕсли;
	Возврат Результат;				
КонецФункции	

//Функции заполнения параметра сеанса НаборВариантов_Ei
#Область ЗаполнениеПраметраСеанса

Функция ПолучитьВариант(Форма,Строка,ИспРезультаты = Истина)	Экспорт
	ВложеннаяСтруктура  = Новый Структура;
	Родитель			= Строка.ПолучитьРодителя();  
	ВложеннаяСтруктура.Вставить("КлючНастроек",	Строка.КлючНастроек);
	ВложеннаяСтруктура.Вставить("Имя",			Строка.Запрос);
	ВложеннаяСтруктура.Вставить("Родитель",		?(Родитель = Неопределено,Неопределено,Родитель.Запрос));
	ВложеннаяСтруктура.Вставить("Параметры",	Новый ФиксированнаяСтруктура(ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру(Строка.ПараметрыЗапроса)));
	Если ИспРезультаты Тогда
		ВложеннаяСтруктура.Вставить("Результаты",	Новый ФиксированнаяСтруктура(ПолучитьСтруктуруРезультатов(Форма,Строка)));
	КонецЕсли;	
	ВложеннаяСтруктура.Вставить("Данные",		Новый ФиксированнаяСтруктура(ПолучитьСтруктуруДанных(Строка)));
	Возврат Новый ФиксированнаяСтруктура(ВложеннаяСтруктура); 	
КонецФункции

Функция ПолучитьСтруктуруРезультатов(Форма,Набор)
	ВложеннаяСтруктура  = Новый Структура;
	Для Каждого ЭлВарианта ИЗ ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
		ОписаниеЗначения 		= КэшПользователяКлиентСервер_Ei.ПолучитьОписаниеРезультата(Набор,Форма.КэшПользователя,ЭлВарианта.Ключ);
		ВложеннаяСтруктура.Вставить(ЭлВарианта.Ключ,ОписаниеЗначения);	
	КонецЦикла;
	Возврат ВложеннаяСтруктура;		
КонецФункции

Функция ПолучитьСтруктуруДанных(Набор)
	ВложеннаяСтруктура  = Новый Структура;
	//это строка набора вариантов		
	Для Каждого ЭлВарианта ИЗ ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
		Вариант = ЭлВарианта.Значение;
		ВложеннаяСтруктура.Вставить(ЭлВарианта.Ключ,Вариант.ПодготовитьДанные(Набор));	
	КонецЦикла;
	Возврат ВложеннаяСтруктура;		
КонецФункции

//Получает данные из фиксированной структуры сохраняемой в параметрах сеанса
//
Функция ПолучитьИзСтруктуры(Набор, Свойтсво1, Свойтсво2 = "") Экспорт
	Перем Результат;
	ВсеДанныеНабора = НаборВариантовКлиентСервер_Ei.ПолучитьДанныеНабора(Набор);
	Если Не ВсеДанныеНабора = Неопределено Тогда
		ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ВсеДанныеНабора,Свойтсво1,Результат);
		Если ЗначениеЗаполнено(Свойтсво2) Тогда
			ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(Результат,Свойтсво2,Результат);
		КонецЕсли;		
	КонецЕсли;
	Возврат Результат;	
КонецФункции	

#КонецОбласти		

Функция ПолучитьИзНабора(ИмяСвойства,ИмяНабора, ИмяВарианта) Экспорт 
	Перем Результат;
	Перем Набор;
	Перем Значение;
	Если НаборВариантовВызовСервера_Ei.Получить().Свойство(ИмяНабора,Набор) Тогда	
		Если Набор.Свойство(ИмяСвойства,Значение) Тогда
			Значение.Свойство(ИмяВарианта,Результат);				
		КонецЕсли;	
	КонецЕсли;
	Возврат Результат; 
КонецФункции

Функция ПолучитьИнструкцию(Набор,Вариант) Экспорт 
	Возврат ПолучитьСвойство(Набор,Вариант,"Инструкция");	
КонецФункции

Функция ПолучитьСвойство(Набор,Вариант,стрСвойство) Экспорт 
	Перем Результат; 
	ДанныеВарианта = ПолучитьИзСтруктуры(Неопределено,"Данные",Вариант);
	Если Не ДанныеВарианта = Неопределено Тогда
		ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ДанныеВарианта,стрСвойство,Результат);	
	КонецЕсли;
	Возврат Результат;	
КонецФункции

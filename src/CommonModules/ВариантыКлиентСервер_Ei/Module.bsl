Функция Данные(ИмяНабора, ИмяВарианта) Экспорт
	Перем Результат;
	ИсходныеДанные = ПолучитьИзНабора("Данные",ИмяНабора,ИмяВарианта);
	Обработчик = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(ИмяВарианта);
	Если Не Обработчик = Неопределено Тогда
		Результат = Обработчик.Данные(ИсходныеДанные);
	Иначе
		Результат = ИсходныеДанные;		
	КонецЕсли;
	Возврат Результат;				
КонецФункции	

//Функции заполнения параметра сеанса НаборВариантов_Ei
#Область ЗаполнениеПраметраСеанса

// Получить описание варианта.
// 
// Параметры:
//  Форма 	- Форма - см. ОбщаяФорма.Ei
//  Строка 	- ДанныеФормыЭлементДерева - Строка дерева варинатов
//  ИспРезультаты - Булево - Вставить результаты или нет
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура:
// * КлючНастроек 	- УникальныйИдентификатор
// * Имя 			- Строка - Имя варианта
// * Родитель 		- Строка - Имя родителя варината 
// * Параметры 		- см. ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру
// * Результаты 	- см. ПолучитьСтруктуруРезультатов
// * Данные 		- см. ПолучитьСтруктуруДанных
//
Функция ПолучитьВариант(Форма,Строка,ИспРезультаты = Истина)	Экспорт
	ВложеннаяСтруктура  = Новый Структура;
	Родитель			= Строка.ПолучитьРодителя();  
	ВложеннаяСтруктура.Вставить("КлючНастроек",	Строка.КлючНастроек);
	ВложеннаяСтруктура.Вставить("Имя",			Строка.ИмяНабора);
	ВложеннаяСтруктура.Вставить("Родитель",		?(Родитель = Неопределено,Неопределено,Родитель.ИмяНабора));
	ВложеннаяСтруктура.Вставить("Параметры",	Новый ФиксированнаяСтруктура(ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру(Строка.ПараметрыЗапроса)));
	Если ИспРезультаты Тогда
		ВложеннаяСтруктура.Вставить("Результаты",	Новый ФиксированнаяСтруктура(ПолучитьСтруктуруРезультатов(Форма,Строка)));
	КонецЕсли;	
	ВложеннаяСтруктура.Вставить("Данные",		Новый ФиксированнаяСтруктура(ПолучитьСтруктуруДанных(Строка)));
	Возврат Новый ФиксированнаяСтруктура(ВложеннаяСтруктура); 	
КонецФункции

// Получить структуру результатов варианта.
// 
// Параметры:
//  Форма - Форма - см. ОбщаяФорма.Ei
//  Набор - ДанныеФормыЭлементДерева - Варинат, строка дерева наборов
// 
// Возвращаемое значение:
//  Структура ИЗ КлючИЗначение:
//	*Ключ - Строка - Имя Варианта
//	*Значение - Произвольный - Результат
// 
Функция ПолучитьСтруктуруРезультатов(Форма,Набор)
	ВложеннаяСтруктура  = Новый Структура;
	Для Каждого ЭлВарианта ИЗ ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
		ОписаниеЗначения 		= КэшПользователяКлиентСервер_Ei.ПолучитьОписаниеРезультата(Набор,Форма.КэшПользователя,ЭлВарианта.Ключ);
		ВложеннаяСтруктура.Вставить(ЭлВарианта.Ключ,ОписаниеЗначения);	
	КонецЦикла;
	Возврат ВложеннаяСтруктура;		
КонецФункции

// Получить структуру результатов.
// 
// Параметры:
//  Набор - ДанныеФормыЭлементДерева - Варианта, строка дерева наборов
// 
// Возвращаемое значение:
//  Структура ИЗ КлючИЗначение:
//	*Ключ - Строка - Имя Варианта
//	*Значение - Произвольный - Результат в зависимости от того что реализовано в обработчиках варинтов
// 
Функция ПолучитьСтруктуруДанных(Набор)
	ВложеннаяСтруктура  = Новый Структура;
	//это строка набора вариантов		
	Для Каждого ЭлВарианта ИЗ ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
		Вариант = ЭлВарианта.Значение;
		ВложеннаяСтруктура.Вставить(ЭлВарианта.Ключ,Вариант.ПодготовитьДанные(Набор));	
	КонецЦикла;
	Возврат ВложеннаяСтруктура;		
КонецФункции

//Получает данные из фиксированной структуры сохраняемой в параметрах сеанса
//
Функция ПолучитьИзСтруктуры(Набор, Свойтсво1, Свойтсво2 = "") Экспорт
	Перем Результат;
	ВсеДанныеНабора = НаборВариантовКлиентСервер_Ei.ПолучитьДанныеНабора(Набор);
	Если Не ВсеДанныеНабора = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(ВсеДанныеНабора,Свойтсво1,Результат);
		Если ЗначениеЗаполнено(Свойтсво2) Тогда
			ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(Результат,Свойтсво2,Результат);
		КонецЕсли;		
	КонецЕсли;
	Возврат Результат;	
КонецФункции	

#КонецОбласти		

Функция ПолучитьИзНабора(ИмяСвойства,ИмяНабора, ИмяВарианта) Экспорт 
	Перем Результат;
	Перем Набор;
	Перем Значение;
	Если НаборВариантовВызовСервера_Ei.Получить().Свойство(ИмяНабора,Набор) Тогда	
		Если Набор.Свойство(ИмяСвойства,Значение) Тогда
			Значение.Свойство(ИмяВарианта,Результат);				
		КонецЕсли;	
	КонецЕсли;
	Возврат Результат; 
КонецФункции

Функция ПолучитьИнструкцию(Набор,Вариант,ДопПараметры =  Неопределено) Экспорт
	Перем Результат;
	сИнструкция  = "Инструкция";
	Если ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,сИнструкция,Результат) Тогда
	
	Иначе		 
		Результат = ПолучитьСвойство(Набор,Вариант,сИнструкция);
	КонецЕсли;
	Возврат Результат;	
КонецФункции

Функция ПолучитьСвойство(Набор,Вариант,стрСвойство) Экспорт 
	Перем Результат; 
	ДанныеВарианта = ПолучитьИзСтруктуры(Неопределено,"Данные",Вариант);
	Если Не ДанныеВарианта = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(ДанныеВарианта,стрСвойство,Результат);	
	КонецЕсли;
	Возврат Результат;	
КонецФункции

// Загрузить данные из файла
// 
// Параметры:
//  Объект		-ДанныеФормыКоллекцияЭлементовДерева - Строка в которую грузим настройку
//  Настройка  	-ФиксированнаяСтруктура,Структура - Сохраненная настройка
//
Процедура ЗагрузитьДанныеПоИмени(Объект,Настройка,Обработчик) Экспорт
	Если ТипЗнч(Настройка) =  Тип("ФиксированнаяСтруктура") ИЛИ ТипЗнч(Настройка) =  Тип("Структура") Тогда
		Объект[Обработчик.Свойства().Имя]		= Настройка.Инструкция;
	КонецЕсли;	
КонецПроцедуры

Функция ВыполнитьВариант(Набор,Варинат,УникальныйИдентификатор =  Неопределено, ДанныеКлиента = Неопределено,ЗаменПараметры = Неопределено) Экспорт
	Перем Результат; 
	ОбработчикВарианта 		= ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(Варинат);
	Если Не ОбработчикВарианта = Неопределено Тогда 
		ИмяНабораДоВызова = НаборВариантовВызовСервера_Ei.ПолучитьТекущийНабор();
		Если Не ИмяНабораДоВызова = Набор Тогда
			//обновим имя набора чтобы могли вычисляться вложенные параметры
			НаборВариантовВызовСервера_Ei.УстановитьТекущийНабор(Набор);
		КонецЕсли;
		Если ТипЗнч(ЗаменПараметры) = Тип("Структура") Тогда
			//земеним определенные параметры в параметрах сеанса
			//Распаровываем
			Структура 			= Новый Структура(НаборВариантовВызовСервера_Ei.Получить());
			ВариантСтруктура  	= Новый Структура(Структура[Набор]); 
			ОригПараметры 		= ВариантСтруктура.Параметры; //Их потом восстанавливаем
			ПараметрыСтруктура	= Новый Структура(ОригПараметры);
			
			//Подготовим структуру новых параметров
			НовыеПараметры = Новый Структура;
			Для Каждого ЭлСтруктуры ИЗ  ЗаменПараметры Цикл
				СтрНовоеЗначение = Новый Структура("ЭтоВыражение,ЗначениеПараметра",Ложь,ЭлСтруктуры.Значение);	
				НовыеПараметры.Вставить(ЭлСтруктуры.Ключ,Новый ФиксированнаяСтруктура(СтрНовоеЗначение));		
			КонецЦикла;	
			
			//Замняем пересекающиеся
			ЗаполнитьЗначенияСвойств(ПараметрыСтруктура,НовыеПараметры); //ЗначениеПараметра, ЭтоВыражение	
			
			//Упаковываем
			ВариантСтруктура.Вставить("Параметры",Новый ФиксированнаяСтруктура(ПараметрыСтруктура));
			Структура.Вставить(Набор,Новый ФиксированнаяСтруктура(ВариантСтруктура));
			НаборВариантовВызовСервера_Ei.Обновить(Новый ФиксированнаяСтруктура(Структура));  
		КонецЕсли;	
		
			ДопПараметры 	= Новый Структура; 
			Результат 		= ОбработчикВарианта.ВыполнитьВариант(УникальныйИдентификатор,ДопПараметры,Неопределено,ДанныеКлиента);
		
		Если Не ИмяНабораДоВызова = Набор Тогда
			//Вернем обратно
			НаборВариантовВызовСервера_Ei.УстановитьТекущийНабор(ИмяНабораДоВызова);
		КонецЕсли;
		Если ТипЗнч(ЗаменПараметры) = Тип("Структура") Тогда
			//Возвращаем параметры
			//Распаровываем
			Структура 			= Новый Структура(НаборВариантовВызовСервера_Ei.Получить());
			ВариантСтруктура  	= Новый Структура(Структура[Набор]); 
			//Упаковываем
			ВариантСтруктура.Вставить("Параметры",ОригПараметры);
			Структура.Вставить(Набор,Новый ФиксированнаяСтруктура(ВариантСтруктура));
			НаборВариантовВызовСервера_Ei.Обновить(Новый ФиксированнаяСтруктура(Структура));  
		КонецЕсли;	
		
	КонецЕсли;
	Возврат Результат; 		
КонецФункции	
	
#Область ПодготовкаКСохранениюВФайл

// Получить идентификатор.
// 
// Параметры:
//  НаборКлюч  - Строка - 
//  Обработчик - ОбщийМодуль -
// 
// Возвращаемое значение:
//  Строка - Получить идентификатор
Функция ПолучитьИдентификатор(НаборКлюч,Обработчик) Экспорт
	Результат = ПолучитьПрослеживаемыйИдентификатор(НаборКлюч,Обработчик.Свойства().Код);
	Возврат Строка(Результат); 				
КонецФункции

// Получить имя.
// 
// Параметры:
//  НаборИмя - Строка
//  Обработчик - ОбщийМодуль
// 
// Возвращаемое значение:
// 	Строка 
Функция ПолучитьИмя(НаборИмя,Обработчик) Экспорт
	Результат = НаборИмя+"_"+Обработчик.Свойства().Имя;
	Возврат Результат; 		
КонецФункции

// Формируем прослеживаемый идентификатор от главного ключа. В основоном необходимо для правильного чтения из формата EDT
// 
// Параметры:
//  Лев 	- Строка,УникальныйИдентификатор 
//  Прав 	- Строка
// 
// Возвращаемое значение:
//  УникальныйИдентификатор
Функция ПолучитьПрослеживаемыйИдентификатор(Лев,Прав) Экспорт
	Прослеживаемый = Лев(Лев,24)+Прав(Прав,12);
	Возврат Новый УникальныйИдентификатор(Прослеживаемый);
КонецФункции

#КонецОбласти		
	

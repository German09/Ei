Функция ПолучитьТекущийОбработчик(Форма,ТД) Экспорт
	ИмяОбработчика = НастройкиПользователяКлиентСервер_Ei.ПолучитьИмяТекущегоОбработчика(ТД,Форма.НастройкиПользователя,ВариантыКлиентСерверПовторноеИспользование_Ei.Ключ());
	Возврат ВариантыКлиентСерверПовторноеИспользование_Ei.ПолучитьВарианты().Получить(ИмяОбработчика);	
КонецФункции

Функция ПолучитьДекорациюОшибки(Форма) Экспорт
	Возврат Форма.Элементы.Найти("ОшибкаВариантаТекст");
КонецФункции

Функция ПолучитьВариант(Строка)	Экспорт
	ВложеннаяСтруктура  = Новый Структура;
	ВложеннаяСтруктура.Вставить("КлючНастроек",	Строка.КлючНастроек);
	ВложеннаяСтруктура.Вставить("Имя",			Строка.Запрос);
	ВложеннаяСтруктура.Вставить("Параметры",	ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру(Строка.ПараметрыЗапроса));
	Возврат Новый ФиксированнаяСтруктура(ВложеннаяСтруктура); 	
КонецФункции

Процедура Варианты(Результат, ИмяВарианта = Неопределено) Экспорт
	#Если Сервер Тогда
		//Вызов из модуля ВыполнитьВызовСервера_Ei при выполнении
		//тут вызов только по конкретному имени
		Если Не ИмяВарианта = Неопределено Тогда
			Результат = ВариантыВызовСервера_Ei.ПолучитьОбъектВарианта(ИмяВарианта);
		Иначе
			Результат = Неопределено;
			////Тут просто вызовем исключение это повторный вызов из формы выбора для разворачивания свойств, но они у нас уже развернуты
			//ВызватьИсключение "Вызов при открытии формы выбора";
		КонецЕсли;		
	#Иначе
		//Вызов из обработки оповещения (Форма выбора) для подсказкли следующих действий с результатом 
		//Вернем Структуру Структур описаний оповещений
		Результат  = ВариантыКлиент_Ei.ПолучитьВарианты();		
	#КонецЕсли		
КонецПроцедуры	
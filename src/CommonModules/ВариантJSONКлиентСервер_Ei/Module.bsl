//Процедура запоминает (не! сохраняет данные)
//запоминание данных необходимо для того чтобы, произошло сохранение данных выведенных на форму
//в типовом варианте они сохраняться только после изменения контекста.
//
Процедура ЗапомнитьДанные(Форма,ТД) Экспорт
	ЭлементИнструкции = ЭлементИнструкции(Форма);	
	Если Не ЭлементИнструкции = Неопределено Тогда
		ТД[Свойства().Имя] =  РедакторJSONКлиент_Ei.ПолучитьТекст(ЭлементИнструкции);
	КонецЕсли;				
КонецПроцедуры

Функция ЭлементИнструкции(Форма) Экспорт 
	Возврат ВариантJSONКлиент_Ei.ЭлементИнструкции(Форма);			
КонецФункции

// Сохранить данные настройки на диск в формате EDT
// 
// Параметры:
//  Путь - Строка 	- Путь к папаке src
//  НаборИмя 		- Строка - Имя варианта набора
//  НаборКлюч 		- УникальныйИдентификатор - Ключ варината набора 
//  Данные			- ФиксированнаяСтруктура - Фиксированная структура подготовленная функцией ПодготовитьДанные()  
Асинх Функция Сохранить(Путь, НаборИмя, НаборКлюч, Данные) Экспорт
	Перем Результат;
	Обработчик  =  ВариантJSONКлиентСервер_Ei;
	Если ЗначениеЗаполнено(Данные.Инструкция) Тогда
		Результат = ФайлыКлиент_Ei.СохранитьОбщее(Обработчик,Путь, НаборИмя, НаборКлюч, Данные);
	Иначе
		УдалитьФайлыАсинх(Путь+"\"+НаборИмя+"_"+Обработчик.Свойства().Имя);
	КонецЕсли;	
	Возврат Результат;
КонецФункции


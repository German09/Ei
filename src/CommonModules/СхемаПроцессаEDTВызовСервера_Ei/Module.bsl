// Перевод графической схемы процесса между форматом платформы (FlowchartContextType, так ее хранит вариант Процессы
// и читает СериализаторXDTO) и форматом EDT (Template.scheme макета типа «Графическая схема», его EDT показывает схемой).
// Сопоставление видов и свойств проверено на картах маршрутов бизнес-процессов УТ: платформа отдает их
// ПолучитьКартуМаршрута, а в репозитории конфигурации они лежат в формате EDT (Flowchart.scheme).
// Точки контура фигур (point) EDT не хранит, платформа читает схему и без них; у линий точки переносятся.
// Здесь же раскладка варианта «Процессы» по файлам проекта EDT и сборка его обратно, см. ФайлыПроцесса, ДанныеПроцесса:
// пишет и читает файлы клиент, тексты собирает и разбирает сервер одним вызовом.

#Область ПрограммныйИнтерфейс

// Файлы, в которые раскладывается процесс: схема - макет «Графическая схема» (главный файл варианта), у каждой
// настроенной обработки свой файл - алгоритм формой с кодом в модуле, ссылка «Выполнить» текстовым макетом,
// «Для Каждого» своей схемой со своими файлами, изначальный объект процесса - формой с выражением.
// Части процесса связаны с владельцем комментарием, см. EDTКлиент_Ei.КомментарийЧасти: имя части - имя владельца
// и через «_» имя обработки, ключ - ключ строки и ключ настроек обработки, у изначального объекта - см. КлючОбъекта
//
// Параметры:
//  Данные - см. ВариантПроцессыКлиентСервер_Ei.ПодготовитьДанные
//  ИмяСтроки - Строка - строка набора
//  КлючСтроки - УникальныйИдентификатор, Строка - ключ настроек строки набора
//
// Возвращаемое значение:
//  Массив из Структура - первым идет главный файл:
//   * Имя - Строка - имя формы или макета обработки
//   * Ключ - Строка - uuid
//   * Синоним - Строка
//   * Текст - Строка - текст модуля формы или макета
//   * Хэш - Строка - хэш текста
//   * Форма - Булево - форма, иначе макет
//   * ТипМакета - Строка - см. EDTКлиент_Ei.ТипыМакетов, у формы пустой
//   * Владелец - Строка - uuid владельца части, у главного файла пустой
//   * Вариант - Строка - ключ варианта, которому принадлежит файл
//
Функция ФайлыПроцесса(Данные, ИмяСтроки, КлючСтроки) Экспорт
	
	Обработчик = ВариантПроцессыКлиентСервер_Ei;
	Ключ = ВариантыКлиентСервер_Ei.ПолучитьИдентификатор(КлючСтроки, Обработчик);
	Результат = Новый Массив;
	ДобавитьФайлыПроцесса(Результат, Данные, ВариантыКлиентСервер_Ei.ПолучитьИмя(ИмяСтроки, Обработчик), Ключ, ИмяСтроки, "",
		Ключ, Строка(КлючСтроки));
	Возврат Результат;
	
КонецФункции

// Данные процесса по текстам его файлов, обратное см. ФайлыПроцесса.
//
// Параметры:
//  Описание - Структура - главный файл процесса, части сгруппированы по владельцам на клиенте:
//   * Ключ - Строка - uuid
//   * Имя - Строка - имя макета схемы
//   * Текст - Строка - текст Template.scheme
//   * Части - Массив из Структура - части, которыми владеет файл:
//    ** Ключ - Строка - uuid
//    ** Имя - Строка
//    ** Синоним - Строка
//    ** Текст - Строка
//    ** Форма - Булево
//    ** ТипМакета - Строка
//    ** Части - Массив из Структура - у вложенной схемы «Для Каждого» ее части
//
// Возвращаемое значение:
//  см. ВариантПроцессыКлиентСервер_Ei.ПодготовитьДанные
//
Функция ДанныеПроцесса(Описание) Экспорт
	
	Инструкция = ИзФорматаEDT(Описание.Текст);
	ИзначальныйОбъект = "";
	//не Обработки: это свойство глобального контекста, ему нельзя присвоить значение
	НастройкиОбработок = Новый Соответствие;
	Для Каждого Часть Из Описание.Части Цикл
		Если Часть.Имя = Описание.Имя + СуффиксОбъекта() Тогда
			ИзначальныйОбъект = ВариантАлгоритмКлиентСервер_Ei.ПолучитьВыражениеИзМодуля(Часть.Текст);
			Продолжить;
		КонецЕсли;
		Если Часть.ТипМакета = ТипСхемы() Тогда
			Обработчик = ОбработкаДляКаждогоКлиентСервер_Ei.Свойства().Имя;
			Настройка = ДанныеПроцесса(Часть);
		ИначеЕсли Часть.Форма Тогда
			Обработчик = ОбработкаАлгоритмКлиентСервер_Ei.Свойства().Имя;
			Настройка = Новый Соответствие;
			Настройка.Вставить("Algoritm.bsl", ВариантАлгоритмКлиентСервер_Ei.ПолучитьВыражениеИзМодуля(Часть.Текст));
		Иначе
			Обработчик = ОбработкаВыполнитьКлиентСервер_Ei.Свойства().Имя;
			Настройка = НастройкаВыполнить(Часть.Текст);
		КонецЕсли;
		НастройкаОбработки = Новый Структура("Настройка, КлючНастроек, Обработчик",
			ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(Настройка), Новый УникальныйИдентификатор(Часть.Ключ), Обработчик);
		НастройкаОбработки.Вставить("Представление", Часть.Синоним);
		НастройкиОбработок.Вставить(Сред(Часть.Имя, СтрДлина(Описание.Имя) + 2), Новый ФиксированнаяСтруктура(НастройкаОбработки));
	КонецЦикла;
	Инструкция = СхемаСКартинками(Инструкция, НастройкиОбработок);
	Возврат Новый ФиксированнаяСтруктура("Инструкция, Обработки, ИзначальныйОбъект", Инструкция,
		Новый ФиксированноеСоответствие(НастройкиОбработок), ИзначальныйОбъект);
	
КонецФункции

// Схема в формате EDT.
//
// Параметры:
//  ТекстПлатформы - Строка - XML схемы в формате платформы (FlowchartContextType)
//
// Возвращаемое значение:
//  Строка - текст Template.scheme
//
Функция ВФорматEDT(ТекстПлатформы) Экспорт
	
	//документ держим в переменной до конца: узлы освобожденного документа DOM роняют процесс сервера
	Документ = ДокументИзСтроки(ТекстПлатформы);
	Корень = Документ.ЭлементДокумента;
	Запись = НоваяЗапись();
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("GraphicalSchema");
	Запись.ЗаписатьСоответствиеПространстваИмен("", ПространствоEDT());
	Для Каждого КлючИЗначение Из Префиксы() Цикл
		Запись.ЗаписатьСоответствиеПространстваИмен(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	ЗаписатьСвойствоEDT(Запись, Корень, "backColor", "BackColor", Истина);
	ЗаписатьСвойствоEDT(Запись, Корень, "enableGrid", "GridEnabled");
	ЗаписатьСвойствоEDT(Запись, Корень, "drawGridMode", "DrawGridMode");
	ЗаписатьСвойствоEDT(Запись, Корень, "gridHorizontalStep", "GridHorizontalStep");
	ЗаписатьСвойствоEDT(Запись, Корень, "gridVerticalStep", "GridVerticalStep");
	ЗаписатьПараметрыПечатиEDT(Запись, Корень);
	
	Элементы = Дочерние(Корень, "item");
	ИменаПоНомеру = Новый Соответствие;
	Для Каждого Элемент Из Элементы Цикл
		ИменаПоНомеру.Вставить(Текст(Элемент, "itemId"), Текст(Элемент, "itemCode"));
	КонецЦикла;
	Запись.ЗаписатьНачалоЭлемента("Items");
	Для Каждого Элемент Из Элементы Цикл
		ЗаписатьЭлементEDT(Запись, Элемент, ИменаПоНомеру);
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();
	
	Возврат Запись.Закрыть();
	
КонецФункции

// Схема в формате платформы.
//
// Параметры:
//  ТекстEDT - Строка - текст Template.scheme
//
// Возвращаемое значение:
//  Строка - XML схемы в формате платформы (FlowchartContextType), читается СериализаторXDTO
//
Функция ИзФорматаEDT(ТекстEDT) Экспорт
	
	Документ = ДокументИзСтроки(ТекстEDT); //держим до конца перевода, см. ВФорматEDT
	Корень = Документ.ЭлементДокумента;
	Запись = НоваяЗапись();
	Запись.ЗаписатьНачалоЭлемента("FlowchartContextType");
	Запись.ЗаписатьСоответствиеПространстваИмен("", ПространствоСхемы());
	Для Каждого КлючИЗначение Из Префиксы() Цикл
		Запись.ЗаписатьСоответствиеПространстваИмен(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Запись.ЗаписатьАтрибут("xsi:type", "FlowchartContextType");
	ЗаписатьСвойствоПлатформы(Запись, Корень, "BackColor", "backColor");
	ЗаписатьСвойствоПлатформы(Запись, Корень, "GridEnabled", "enableGrid");
	ЗаписатьСвойствоПлатформы(Запись, Корень, "DrawGridMode", "drawGridMode");
	ЗаписатьСвойствоПлатформы(Запись, Корень, "GridHorizontalStep", "gridHorizontalStep");
	ЗаписатьСвойствоПлатформы(Запись, Корень, "GridVerticalStep", "gridVerticalStep");
	ЗаписатьЗначение(Запись, "bpUUID", "00000000-0000-0000-0000-000000000000");
	ЗаписатьЗначение(Запись, "useOutput", "Auto");
	ЗаписатьПараметрыПечатиПлатформы(Запись, Корень);
	
	Элементы = Новый Массив;
	КонтейнерЭлементов = Дочерний(Корень, "Items");
	Если КонтейнерЭлементов <> Неопределено Тогда
		Для Каждого Узел Из КонтейнерЭлементов.ДочерниеУзлы Цикл
			Если Узел.ТипУзла = ТипУзлаDOM.Элемент Тогда
				Элементы.Добавить(Узел);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	НомераПоИмени = Новый Соответствие;
	Для Каждого Элемент Из Элементы Цикл
		НомераПоИмени.Вставить(Текст(Дочерний(Элемент, "Properties"), "Name", ""), Элемент.ПолучитьАтрибут("id"));
	КонецЦикла;
	Для Каждого Элемент Из Элементы Цикл
		ЗаписатьЭлементПлатформы(Запись, Элемент, НомераПоИмени);
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();
	
	Возврат Запись.Закрыть();
	
КонецФункции

// Текст схемы в формате EDT, а не платформы.
//
// Параметры:
//  Текст - Строка - XML схемы
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоФорматEDT(Текст) Экспорт
	
	Возврат СтрНайти(Лев(Текст, 1000), "<GraphicalSchema") > 0;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Общее

Функция ПространствоСхемы()
	Возврат "http://v8.1c.ru/8.2/data/graphscheme";
КонецФункции

Функция ПространствоEDT()
	Возврат "http://v8.1c.ru/8.3/xcf/scheme";
КонецФункции

Функция ПространствоЯдра()
	Возврат "http://v8.1c.ru/8.1/data/core";
КонецФункции

Функция ПространствоEDTЧитаемое()
	Возврат "http://v8.1c.ru/8.3/xcf/readable";
КонецФункции

// Префиксы пространств имен, как их объявляет EDT в Template.scheme
//
// Возвращаемое значение:
//  Структура из КлючИЗначение:
//   * Ключ - Строка - префикс
//   * Значение - Строка - пространство имен
//
Функция Префиксы()
	Результат = Новый Структура;
	Результат.Вставить("sch",	ПространствоСхемы());
	Результат.Вставить("style",	"http://v8.1c.ru/8.1/data/ui/style");
	Результат.Вставить("v8",	ПространствоЯдра());
	Результат.Вставить("v8ui",	"http://v8.1c.ru/8.1/data/ui");
	Результат.Вставить("web",	"http://v8.1c.ru/8.1/data/ui/colors/web");
	Результат.Вставить("win",	"http://v8.1c.ru/8.1/data/ui/colors/windows");
	Результат.Вставить("xs",	"http://www.w3.org/2001/XMLSchema");
	Результат.Вставить("xsi",	"http://www.w3.org/2001/XMLSchema-instance");
	Возврат Результат;
КонецФункции

// Виды элементов схемы: номер вида платформы (itemType), тег EDT и события, которые EDT пишет у элемента.
// Тег и события вложенного процесса (10, им рисуется «Для Каждого») взяты из модели схемы EDT
// (com._1c.g5.v8.dt.bp.scheme): в картах маршрутов УТ его нет. Выбор варианта (6, Switch) Ei не рисует,
// он пока не переводится
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Вид - Строка - itemType
//   * Тег - Строка - тег EDT
//   * События - Строка - имена событий через запятую
//
Функция ВидыЭлементов()
	Результат = Новый Массив;
	Результат.Добавить(Новый Структура("Вид,Тег,События", "0", "Decoration", ""));
	Результат.Добавить(Новый Структура("Вид,Тег,События", "1", "ConnectionLine", ""));
	Результат.Добавить(Новый Структура("Вид,Тег,События", "2", "Start", "BeforeStart"));
	Результат.Добавить(Новый Структура("Вид,Тег,События", "3", "Completion", "OnComplete"));
	Результат.Добавить(Новый Структура("Вид,Тег,События", "4", "Condition", "ConditionCheck"));
	Результат.Добавить(Новый Структура("Вид,Тег,События", "5", "Activity",
		"InteractiveActivationProcessing,BeforeCreateTasks,OnCreateTask,OnExecute,CheckExecutionProcessing,BeforeExecute,BeforeExecuteInteractively"));
	Результат.Добавить(Новый Структура("Вид,Тег,События", "7", "Split", ""));
	Результат.Добавить(Новый Структура("Вид,Тег,События", "8", "Join", ""));
	Результат.Добавить(Новый Структура("Вид,Тег,События", "9", "Processing", "Processing"));
	Результат.Добавить(Новый Структура("Вид,Тег,События", "10", "SubBusinessProcess",
		"BeforeCreateTasks,OnCreateTask,OnCreateSubBusinessProcesses,OnExecute,BeforeExecute,BeforeCreateSubBusinessProcesses"));
	Возврат Результат;
КонецФункции

// Описание вида элемента по номеру платформы или тегу EDT
//
// Параметры:
//  Свойство - Строка - Вид или Тег
//  Значение - Строка
//
// Возвращаемое значение:
//  Структура, Неопределено - см. ВидыЭлементов
//
Функция НайтиВид(Свойство, Значение)
	Результат = Неопределено;
	Для Каждого Вид Из ВидыЭлементов() Цикл
		Если Вид[Свойство] = Значение Тогда
			Результат = Вид;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ДокументИзСтроки(Текст)
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(Текст);
	Построитель = Новый ПостроительDOM;
	Возврат Построитель.Прочитать(Чтение);
КонецФункции

Функция НоваяЗапись()
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиXML("UTF-8", "1.0", Истина, Ложь, Символы.Таб));
	Возврат Запись;
КонецФункции

Функция Дочерний(Узел, Имя)
	Результат = Неопределено;
	Если Узел <> Неопределено Тогда
		Для Каждого Дочерний Из Узел.ДочерниеУзлы Цикл
			Если Дочерний.ТипУзла = ТипУзлаDOM.Элемент И Дочерний.ЛокальноеИмя = Имя Тогда
				Результат = Дочерний;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция Дочерние(Узел, Имя)
	Результат = Новый Массив;
	Если Узел <> Неопределено Тогда
		Для Каждого Дочерний Из Узел.ДочерниеУзлы Цикл
			Если Дочерний.ТипУзла = ТипУзлаDOM.Элемент И Дочерний.ЛокальноеИмя = Имя Тогда
				Результат.Добавить(Дочерний);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция Текст(Узел, Имя, ПоУмолчанию = Неопределено)
	Дочерний = Дочерний(Узел, Имя);
	Возврат ?(Дочерний = Неопределено, ПоУмолчанию, Дочерний.ТекстовоеСодержимое);
КонецФункции

// Значение с префиксом пространства имен (стиль, цвет) с префиксом из см. Префиксы: в исходном XML префикс
// бывает любым (d3p1), а пишется объявленный в корне
//
// Параметры:
//  Узел - ЭлементDOM - узел, в котором объявлен префикс
//  Значение - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяСПрефиксом(Узел, Значение)
	Результат = Значение;
	Позиция = СтрНайти(Значение, ":");
	Если Позиция > 1 И Не СтрНачинаетсяС(Значение, "#") Тогда
		Пространство = Узел.НайтиURIПространстваИмен(Лев(Значение, Позиция - 1));
		Для Каждого КлючИЗначение Из Префиксы() Цикл
			Если КлючИЗначение.Значение = Пространство Тогда
				Результат = КлючИЗначение.Ключ + Сред(Значение, Позиция);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура ЗаписатьЗначение(Запись, Имя, Значение)
	Запись.ЗаписатьНачалоЭлемента(Имя);
	Запись.ЗаписатьТекст(Строка(Значение));
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура ЗаписатьТочку(Запись, Имя, Абсцисса, Ордината)
	Запись.ЗаписатьНачалоЭлемента(Имя);
	Запись.ЗаписатьАтрибут("x", Абсцисса);
	Запись.ЗаписатьАтрибут("y", Ордината);
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

// Атрибуты узла без объявлений пространств имен; у ссылки на шрифт (ref="sys:...") объявляется ее префикс
Процедура СкопироватьАтрибуты(Запись, Узел)
	Для Каждого Атрибут Из Узел.Атрибуты Цикл
		Если Атрибут.URIПространстваИмен = "http://www.w3.org/2000/xmlns/" Тогда
			Продолжить;
		КонецЕсли;
		Значение = Атрибут.Значение;
		Позиция = СтрНайти(Значение, ":");
		Если Атрибут.ЛокальноеИмя = "ref" И Позиция > 1 Тогда
			Префикс = Лев(Значение, Позиция - 1);
			Запись.ЗаписатьСоответствиеПространстваИмен(Префикс, Узел.НайтиURIПространстваИмен(Префикс));
		КонецЕсли;
		Запись.ЗаписатьАтрибут(Атрибут.ЛокальноеИмя, Значение);
	КонецЦикла;
КонецПроцедуры

// Рамка или линия: у платформы border, у EDT Border или Line; стиль - v8ui:style типа sch:ConnectorLineType
Процедура ЗаписатьРамку(Запись, Узел, ИмяЭлемента)
	Если Узел <> Неопределено Тогда
		Запись.ЗаписатьНачалоЭлемента(ИмяЭлемента);
		СкопироватьАтрибуты(Запись, Узел);
		Стиль = Дочерний(Узел, "style");
		Если Стиль <> Неопределено Тогда
			Запись.ЗаписатьНачалоЭлемента("v8ui:style");
			Тип = Стиль.ПолучитьАтрибут("http://www.w3.org/2001/XMLSchema-instance", "type");
			Если ЗначениеЗаполнено(Тип) Тогда
				Запись.ЗаписатьАтрибут("xsi:type", ИмяСПрефиксом(Стиль, Тип));
			КонецЕсли;
			Запись.ЗаписатьТекст(Стиль.ТекстовоеСодержимое);
			Запись.ЗаписатьКонецЭлемента();
		КонецЕсли;
		Запись.ЗаписатьКонецЭлемента();
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьШрифт(Запись, Узел, ИмяЭлемента)
	Если Узел <> Неопределено Тогда
		Запись.ЗаписатьНачалоЭлемента(ИмяЭлемента);
		СкопироватьАтрибуты(Запись, Узел);
		Запись.ЗаписатьКонецЭлемента();
	КонецЕсли;
КонецПроцедуры

// Картинка элемента: у платформы picture со ссылкой ref="v8ui:Имя" и признаком t, у EDT Picture
// с xr:Ref «CommonPicture.Имя» и xr:LoadTransparent. Элементы Ei рисуются общими картинками расширения,
// картинка из файла (своя картинка обработки) пока не переводится
//
// Параметры:
//  Запись - ЗаписьXML
//  Элемент - ЭлементDOM - элемент схемы платформы
//
Процедура ЗаписатьКартинкуEDT(Запись, Элемент)
	Узел = Дочерний(Элемент, "picture");
	Ссылка = ?(Узел = Неопределено, "", Узел.ПолучитьАтрибут("ref"));
	ИмяКартинки = Сред(Ссылка, СтрНайти(Ссылка, ":") + 1);
	// Служебные картинки шагов расширения недоступны внешней обработке.
	// При чтении их восстанавливает СхемаСКартинками по виду обработки.
	Если ИмяКартинки = "Алгоритм_Ei" Или ИмяКартинки = "Цикл_Ei" Или ИмяКартинки = "Выполнить_Ei" Тогда
		Ссылка = "";
	КонецЕсли;
	Запись.ЗаписатьНачалоЭлемента("Picture");
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Запись.ЗаписатьСоответствиеПространстваИмен("xr", ПространствоEDTЧитаемое());
		ИмяКартинки = Сред(Ссылка, СтрНайти(Ссылка, ":") + 1);
		ЗаписатьЗначение(Запись, "xr:Ref", ?(СтрНачинаетсяС(ИмяКартинки, ПрефиксСтандартнойКартинки()), ИмяКартинки,
			ПрефиксОбщейКартинки() + ИмяКартинки));
		ЗаписатьЗначение(Запись, "xr:LoadTransparent", ?(Узел.ПолучитьАтрибут("t") = "true", "true", "false"));
	ИначеЕсли Узел <> Неопределено И Узел.ЕстьДочерниеУзлы() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Картинка элемента %1 графической схемы не из библиотеки картинок, она пока не переводится в формат EDT'"),
			Текст(Элемент, "itemCode", ""));
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

// Картинка элемента в формате платформы, см. ЗаписатьКартинкуEDT
//
// Параметры:
//  Запись - ЗаписьXML
//  Свойства - ЭлементDOM - Properties элемента схемы EDT
//
Процедура ЗаписатьКартинкуПлатформы(Запись, Свойства)
	Узел = Дочерний(Свойства, "Picture");
	Ссылка = Текст(Узел, "Ref", "");
	Запись.ЗаписатьНачалоЭлемента("picture");
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Запись.ЗаписатьАтрибут("t", Текст(Узел, "LoadTransparent", "false"));
		Запись.ЗаписатьАтрибут("ref", "v8ui:" + ?(СтрНачинаетсяС(Ссылка, ПрефиксОбщейКартинки()),
			Сред(Ссылка, СтрДлина(ПрефиксОбщейКартинки()) + 1), Ссылка));
	ИначеЕсли Дочерний(Узел, "Abs") <> Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Картинка элемента %1 графической схемы EDT не из библиотеки картинок, она пока не переводится в формат платформы'"),
			Текст(Свойства, "Name", ""));
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Функция ПрефиксОбщейКартинки()
	Возврат "CommonPicture.";
КонецФункции

Функция ПрефиксСтандартнойКартинки()
	Возврат "StdPicture.";
КонецФункции

#КонецОбласти

#Область ВФорматEDT

Процедура ЗаписатьСвойствоEDT(Запись, Элемент, ИмяПлатформы, ИмяEDT, ЭтоИмяСПрефиксом = Ложь)
	Узел = Дочерний(Элемент, ИмяПлатформы);
	Если Узел <> Неопределено Тогда
		ЗаписатьЗначение(Запись, ИмяEDT, ?(ЭтоИмяСПрефиксом, ИмяСПрефиксом(Узел, Узел.ТекстовоеСодержимое), Узел.ТекстовоеСодержимое));
	КонецЕсли;
КонецПроцедуры

// Многоязычная строка: itemTitle, tipText -> Title, ToolTip; язык по умолчанию # -> ru
Процедура ЗаписатьСтрокуEDT(Запись, Элемент, ИмяПлатформы, ИмяEDT)
	Запись.ЗаписатьНачалоЭлемента(ИмяEDT);
	Для Каждого НаЯзыке Из Дочерние(Дочерний(Элемент, ИмяПлатформы), "item") Цикл
		Язык = Текст(НаЯзыке, "lang", "");
		Запись.ЗаписатьНачалоЭлемента("v8:item");
		ЗаписатьЗначение(Запись, "v8:lang", ?(Язык = "#", "ru", Язык));
		ЗаписатьЗначение(Запись, "v8:content", Текст(НаЯзыке, "content", ""));
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура ЗаписатьОбщиеСвойстваEDT(Запись, Элемент)
	ЗаписатьСвойствоEDT(Запись, Элемент, "itemCode", "Name");
	ЗаписатьСтрокуEDT(Запись, Элемент, "itemTitle", "Title");
	ЗаписатьСтрокуEDT(Запись, Элемент, "tipText", "ToolTip");
	ЗаписатьСвойствоEDT(Запись, Элемент, "itemTabOrder", "TabOrder");
	ЗаписатьСвойствоEDT(Запись, Элемент, "backColor", "BackColor", Истина);
	ЗаписатьСвойствоEDT(Запись, Элемент, "textColor", "TextColor", Истина);
	ЗаписатьСвойствоEDT(Запись, Элемент, "lineColor", "LineColor", Истина);
	ЗаписатьСвойствоEDT(Запись, Элемент, "groupNum", "GroupNumber");
	ЗаписатьСвойствоEDT(Запись, Элемент, "zOrder", "ZOrder");
	ЗаписатьСвойствоEDT(Запись, Элемент, "hyperlink", "Hyperlink");
	ЗаписатьСвойствоEDT(Запись, Элемент, "transparent", "Transparent");
	ЗаписатьШрифт(Запись, Дочерний(Элемент, "textFont"), "Font");
	ЗаписатьСвойствоEDT(Запись, Элемент, "alignHor", "HorizontalAlign");
	ЗаписатьСвойствоEDT(Запись, Элемент, "alignVer", "VerticalAlign");
	ЗаписатьСвойствоEDT(Запись, Элемент, "picturePlacement", "PictureLocation");
КонецПроцедуры

Процедура ЗаписатьКонецЛинииEDT(Запись, Имя, ИмяЭлемента, Порт)
	Запись.ЗаписатьНачалоЭлемента(Имя);
	ЗаписатьЗначение(Запись, "Item", ?(ИмяЭлемента = Неопределено, "", ИмяЭлемента));
	ЗаписатьЗначение(Запись, "PortIndex", Порт);
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура ЗаписатьЛиниюEDT(Запись, Элемент, ИменаПоНомеру)
	Запись.ЗаписатьНачалоЭлемента("PivotPoints");
	Для Каждого Точка Из Дочерние(Элемент, "point") Цикл
		ЗаписатьТочку(Запись, "Point", Текст(Точка, "x"), Текст(Точка, "y"));
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();
	Сегменты = Дочерние(Элемент, "userSegment");
	Если Сегменты.Количество() > 0 Тогда
		Запись.ЗаписатьНачалоЭлемента("ManualyMovedSegments");
		Для Каждого Сегмент Из Сегменты Цикл
			Запись.ЗаписатьНачалоЭлемента("Segment");
			Запись.ЗаписатьАтрибут("index", Текст(Сегмент, "startIndex", "0"));
			ЗаписатьТочку(Запись, "Start", Текст(Сегмент, "startX"), Текст(Сегмент, "startY"));
			ЗаписатьТочку(Запись, "End", Текст(Сегмент, "endX"), Текст(Сегмент, "endY"));
			Запись.ЗаписатьКонецЭлемента();
		КонецЦикла;
		Запись.ЗаписатьКонецЭлемента();
	КонецЕсли;
	Запись.ЗаписатьНачалоЭлемента("Connect");
	ЗаписатьКонецЛинииEDT(Запись, "From", ИменаПоНомеру.Получить(Текст(Элемент, "connectFromItemId", "-1")), Текст(Элемент, "portIndexFrom", "0"));
	ЗаписатьКонецЛинииEDT(Запись, "To", ИменаПоНомеру.Получить(Текст(Элемент, "connectToItemId", "-1")), Текст(Элемент, "portIndexTo", "0"));
	Запись.ЗаписатьКонецЭлемента();
	ЗаписатьРамку(Запись, Дочерний(Элемент, "border"), "Line");
	ЗаписатьСвойствоEDT(Запись, Элемент, "decorativeLine", "DecorativeLine");
	ЗаписатьСвойствоEDT(Запись, Элемент, "textPos", "TextLocation");
	ЗаписатьСвойствоEDT(Запись, Элемент, "beginArrowStyle", "BeginArrow");
	ЗаписатьСвойствоEDT(Запись, Элемент, "endArrowStyle", "EndArrow");
КонецПроцедуры

Процедура ЗаписатьФигуруEDT(Запись, Элемент, Тег)
	Запись.ЗаписатьНачалоЭлемента("Location");
	Запись.ЗаписатьАтрибут("top", Текст(Элемент, "rectTop", "0"));
	Запись.ЗаписатьАтрибут("left", Текст(Элемент, "rectLeft", "0"));
	Запись.ЗаписатьАтрибут("bottom", Текст(Элемент, "rectBottom", "0"));
	Запись.ЗаписатьАтрибут("right", Текст(Элемент, "rectRight", "0"));
	Запись.ЗаписатьКонецЭлемента();
	Если Тег <> "Decoration" Тогда
		ЗаписатьРамку(Запись, Дочерний(Элемент, "border"), "Border");
	КонецЕсли;
	ЗаписатьКартинкуEDT(Запись, Элемент);
	РазмерКартинкиСхемы = Текст(Элемент, "pictureStyle");
	Если РазмерКартинкиСхемы <> Неопределено Тогда
		ЗаписатьЗначение(Запись, "PictureSize", ?(РазмерКартинкиСхемы = "4", "AutoSize", РазмерКартинкиСхемы));
	КонецЕсли;
	Если Тег = "Decoration" Тогда
		ЗаписатьСвойствоEDT(Запись, Элемент, "shape", "Shape");
		ЗаписатьСвойствоEDT(Запись, Элемент, "flipMode", "FlipMode");
		Угол = Дочерний(Элемент, "angle");
		Если Угол <> Неопределено Тогда
			Запись.ЗаписатьНачалоЭлемента("Angle");
			Запись.ЗаписатьАтрибут("xsi:type", "xs:decimal");
			Запись.ЗаписатьТекст(Угол.ТекстовоеСодержимое);
			Запись.ЗаписатьКонецЭлемента();
		КонецЕсли;
	ИначеЕсли Тег = "Condition" Тогда
		ЗаписатьСвойствоEDT(Запись, Элемент, "truePortIndex", "TruePortIndex");
		ЗаписатьСвойствоEDT(Запись, Элемент, "falsePortIndex", "FalsePortIndex");
	ИначеЕсли Тег = "Activity" Тогда
		ЗаписатьЗначение(Запись, "TaskDescription", Текст(Элемент, "taskDescription", ""));
		ЗаписатьЗначение(Запись, "Explanation", Текст(Элемент, "explanation", ""));
		ЗаписатьЗначение(Запись, "Group", Текст(Элемент, "groupAddressing", "false"));
	ИначеЕсли Тег = "SubBusinessProcess" Тогда
		//вложенный процесс Ei не ссылается на бизнес-процесс конфигурации: subprocessUUID у него нулевой
		Запись.ЗаписатьНачалоЭлемента("Subprocess");
		Запись.ЗаписатьКонецЭлемента();
		ЗаписатьЗначение(Запись, "TaskDescription", Текст(Элемент, "taskDescription", ""));
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьЭлементEDT(Запись, Элемент, ИменаПоНомеру)
	Вид = НайтиВид("Вид", Текст(Элемент, "itemType", ""));
	Если Вид = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Элемент %1 графической схемы (вид %2) пока не переводится в формат EDT'"),
			Текст(Элемент, "itemCode", ""), Текст(Элемент, "itemType", ""));
	КонецЕсли;
	Запись.ЗаписатьНачалоЭлемента(Вид.Тег);
	Запись.ЗаписатьАтрибут("id", Текст(Элемент, "itemId", "0"));
	Идентификатор = Текст(Элемент, "pointUUID");
	Если Идентификатор <> Неопределено Тогда
		Запись.ЗаписатьАтрибут("uuid", Идентификатор);
	КонецЕсли;
	Запись.ЗаписатьНачалоЭлемента("Properties");
	ЗаписатьОбщиеСвойстваEDT(Запись, Элемент);
	Если Вид.Тег = "ConnectionLine" Тогда
		ЗаписатьЛиниюEDT(Запись, Элемент, ИменаПоНомеру);
	Иначе
		ЗаписатьФигуруEDT(Запись, Элемент, Вид.Тег);
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента();
	Если ЗначениеЗаполнено(Вид.События) Тогда
		Запись.ЗаписатьНачалоЭлемента("Events");
		Для Каждого Событие Из СтрРазделить(Вид.События, ",") Цикл
			Запись.ЗаписатьНачалоЭлемента("Event");
			Запись.ЗаписатьАтрибут("name", Событие);
			Запись.ЗаписатьКонецЭлемента();
		КонецЦикла;
		Запись.ЗаписатьКонецЭлемента();
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

// Параметры печати: у платформы - пары printPropItem (6-9 поля, 13 черно-белая, 16 режим размещения на странице)
Процедура ЗаписатьПараметрыПечатиEDT(Запись, Корень)
	Значения = Новый Соответствие;
	Для Каждого Свойство Из Дочерние(Корень, "printPropItem") Цикл
		Значения.Вставить(Текст(Свойство, "key"), Текст(Свойство, "val"));
	КонецЦикла;
	Запись.ЗаписатьНачалоЭлемента("PrintParameters");
	ЗаписатьЗначение(Запись, "TopMargin", ?(Значения["6"] = Неопределено, "10", Значения["6"]));
	ЗаписатьЗначение(Запись, "LeftMargin", ?(Значения["7"] = Неопределено, "10", Значения["7"]));
	ЗаписатьЗначение(Запись, "BottomMargin", ?(Значения["8"] = Неопределено, "10", Значения["8"]));
	ЗаписатьЗначение(Запись, "RightMargin", ?(Значения["9"] = Неопределено, "10", Значения["9"]));
	ЗаписатьЗначение(Запись, "BlackAndWhite", ?(Значения["13"] = "1", "true", "false"));
	ЗаписатьЗначение(Запись, "FitPageMode", "Auto");
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

#КонецОбласти

#Область ИзФорматаEDT

Процедура ЗаписатьСвойствоПлатформы(Запись, Элемент, ИмяEDT, ИмяПлатформы)
	Узел = Дочерний(Элемент, ИмяEDT);
	Если Узел <> Неопределено Тогда
		ЗаписатьЗначение(Запись, ИмяПлатформы, ИмяСПрефиксом(Узел, Узел.ТекстовоеСодержимое));
	КонецЕсли;
КонецПроцедуры

// Многоязычная строка: Title, ToolTip -> itemTitle, tipText; ru -> язык по умолчанию #
Процедура ЗаписатьСтрокуПлатформы(Запись, Свойства, ИмяEDT, ИмяПлатформы)
	Запись.ЗаписатьНачалоЭлемента(ИмяПлатформы);
	Для Каждого НаЯзыке Из Дочерние(Дочерний(Свойства, ИмяEDT), "item") Цикл
		Язык = Текст(НаЯзыке, "lang", "");
		Запись.ЗаписатьНачалоЭлемента("v8:item");
		ЗаписатьЗначение(Запись, "v8:lang", ?(Язык = "ru", "#", Язык));
		ЗаписатьЗначение(Запись, "v8:content", Текст(НаЯзыке, "content", ""));
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура ЗаписатьОбщиеСвойстваПлатформы(Запись, Свойства)
	ЗаписатьСтрокуПлатформы(Запись, Свойства, "Title", "itemTitle");
	ЗаписатьСтрокуПлатформы(Запись, Свойства, "ToolTip", "tipText");
	ЗаписатьСвойствоПлатформы(Запись, Свойства, "Name", "itemCode");
	ЗаписатьСвойствоПлатформы(Запись, Свойства, "TabOrder", "itemTabOrder");
	ЗаписатьСвойствоПлатформы(Запись, Свойства, "BackColor", "backColor");
	ЗаписатьСвойствоПлатформы(Запись, Свойства, "TextColor", "textColor");
	ЗаписатьСвойствоПлатформы(Запись, Свойства, "LineColor", "lineColor");
	ЗаписатьСвойствоПлатформы(Запись, Свойства, "GroupNumber", "groupNum");
	ЗаписатьСвойствоПлатформы(Запись, Свойства, "ZOrder", "zOrder");
	ЗаписатьСвойствоПлатформы(Запись, Свойства, "Hyperlink", "hyperlink");
	ЗаписатьСвойствоПлатформы(Запись, Свойства, "Transparent", "transparent");
	ЗаписатьШрифт(Запись, Дочерний(Свойства, "Font"), "textFont");
	ЗаписатьСвойствоПлатформы(Запись, Свойства, "HorizontalAlign", "alignHor");
	ЗаписатьСвойствоПлатформы(Запись, Свойства, "VerticalAlign", "alignVer");
	ЗаписатьСвойствоПлатформы(Запись, Свойства, "PictureLocation", "picturePlacement");
КонецПроцедуры

Процедура ЗаписатьЛиниюПлатформы(Запись, Свойства, НомераПоИмени)
	Для Каждого Точка Из Дочерние(Дочерний(Свойства, "PivotPoints"), "Point") Цикл
		Запись.ЗаписатьНачалоЭлемента("point");
		ЗаписатьЗначение(Запись, "x", Точка.ПолучитьАтрибут("x"));
		ЗаписатьЗначение(Запись, "y", Точка.ПолучитьАтрибут("y"));
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Для Каждого Сегмент Из Дочерние(Дочерний(Свойства, "ManualyMovedSegments"), "Segment") Цикл
		Начало = Дочерний(Сегмент, "Start");
		Конец = Дочерний(Сегмент, "End");
		Запись.ЗаписатьНачалоЭлемента("userSegment");
		ЗаписатьЗначение(Запись, "startX", Начало.ПолучитьАтрибут("x"));
		ЗаписатьЗначение(Запись, "startY", Начало.ПолучитьАтрибут("y"));
		ЗаписатьЗначение(Запись, "endX", Конец.ПолучитьАтрибут("x"));
		ЗаписатьЗначение(Запись, "endY", Конец.ПолучитьАтрибут("y"));
		ЗаписатьЗначение(Запись, "startIndex", Сегмент.ПолучитьАтрибут("index"));
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	ЗаписатьРамкуПлатформы(Запись, Дочерний(Свойства, "Line"));
	Соединение = Дочерний(Свойства, "Connect");
	Откуда = Дочерний(Соединение, "From");
	Куда = Дочерний(Соединение, "To");
	ЗаписатьЗначение(Запись, "connectFromItemId", НомерЭлемента(НомераПоИмени, Текст(Откуда, "Item", "")));
	ЗаписатьЗначение(Запись, "connectFromPortIndex", "0");
	ЗаписатьЗначение(Запись, "connectToItemId", НомерЭлемента(НомераПоИмени, Текст(Куда, "Item", "")));
	ЗаписатьСвойствоПлатформы(Запись, Свойства, "DecorativeLine", "decorativeLine");
	ЗаписатьЗначение(Запись, "portIndexFrom", Текст(Откуда, "PortIndex", "0"));
	ЗаписатьЗначение(Запись, "portIndexTo", Текст(Куда, "PortIndex", "0"));
	ЗаписатьСвойствоПлатформы(Запись, Свойства, "TextLocation", "textPos");
	ЗаписатьСвойствоПлатформы(Запись, Свойства, "BeginArrow", "beginArrowStyle");
	ЗаписатьСвойствоПлатформы(Запись, Свойства, "EndArrow", "endArrowStyle");
КонецПроцедуры

Функция НомерЭлемента(НомераПоИмени, Имя)
	Номер = ?(ЗначениеЗаполнено(Имя), НомераПоИмени.Получить(Имя), Неопределено);
	Возврат ?(Номер = Неопределено, "-1", Номер);
КонецФункции

// Точки контура фигуры. EDT их не хранит, а платформа без них рисует фигуру только до первой перезаписи схемы:
// после добавления элемента на схему в Ei (схема пишется в XDTO и читается обратно) фигуры без точек пропадали.
// Контур - как его пишет сама платформа (сверено на картах маршрутов УТ): у старта и завершения треугольник
// высотой ширина·tg30°/2, у условия скос половина высоты·tg30°, у разделения и слияния треугольник, у остальных - прямоугольник
//
// Параметры:
//  Запись - ЗаписьXML
//  Тег - Строка - тег EDT вида элемента
//  Лево, Верх, Право, Низ - Число - прямоугольник фигуры
//
Процедура ЗаписатьТочкиКонтура(Запись, Тег, Лево, Верх, Право, Низ)
	Ширина 		= Право - Лево;
	Высота 		= Низ - Верх;
	Тангенс30 	= 0.57735;
	Точки 		= Новый Массив;
	Если Тег = "Start" Тогда
		Треугольник = Цел(Ширина * Тангенс30 / 2);
		Точки.Добавить(Новый Структура("x,y", Лево, Верх));
		Точки.Добавить(Новый Структура("x,y", Право - 1, Верх));
		Точки.Добавить(Новый Структура("x,y", Право - 1, Низ - Треугольник));
		Точки.Добавить(Новый Структура("x,y", Лево + Цел(Ширина / 2), Низ - 1));
		Точки.Добавить(Новый Структура("x,y", Лево, Низ - Треугольник));
	ИначеЕсли Тег = "Completion" Тогда
		Треугольник = Цел(Ширина * Тангенс30 / 2);
		Точки.Добавить(Новый Структура("x,y", Лево + Цел(Ширина / 2), Верх));
		Точки.Добавить(Новый Структура("x,y", Право - 1, Верх + Треугольник));
		Точки.Добавить(Новый Структура("x,y", Право - 1, Низ - 1));
		Точки.Добавить(Новый Структура("x,y", Лево, Низ - 1));
		Точки.Добавить(Новый Структура("x,y", Лево, Верх + Треугольник));
	ИначеЕсли Тег = "Condition" Тогда
		Скос = Цел(Высота / 2 * Тангенс30);
		Точки.Добавить(Новый Структура("x,y", Лево, Верх + Цел(Высота / 2)));
		Точки.Добавить(Новый Структура("x,y", Лево + Скос, Верх));
		Точки.Добавить(Новый Структура("x,y", Право - 1 - Скос, Верх));
		Точки.Добавить(Новый Структура("x,y", Право - 1, Верх + Цел(Высота / 2)));
		Точки.Добавить(Новый Структура("x,y", Право - 1 - Скос, Низ - 1));
		Точки.Добавить(Новый Структура("x,y", Лево + Скос, Низ - 1));
	ИначеЕсли Тег = "Split" Тогда
		Точки.Добавить(Новый Структура("x,y", Лево, Верх));
		Точки.Добавить(Новый Структура("x,y", Право - 2, Верх));
		Точки.Добавить(Новый Структура("x,y", Лево + Цел((Ширина - 2) / 2), Низ - 1));
	ИначеЕсли Тег = "Join" Тогда
		Точки.Добавить(Новый Структура("x,y", Лево, Низ - 1));
		Точки.Добавить(Новый Структура("x,y", Право - 2, Низ - 1));
		Точки.Добавить(Новый Структура("x,y", Лево + Цел((Ширина - 2) / 2), Верх));
	ИначеЕсли Тег <> "Decoration" Тогда
		Точки.Добавить(Новый Структура("x,y", Лево, Верх));
		Точки.Добавить(Новый Структура("x,y", Право - 1, Верх));
		Точки.Добавить(Новый Структура("x,y", Право - 1, Низ - 1));
		Точки.Добавить(Новый Структура("x,y", Лево, Низ - 1));
	КонецЕсли;
	Для Каждого Точка Из Точки Цикл
		Запись.ЗаписатьНачалоЭлемента("point");
		ЗаписатьЗначение(Запись, "x", Формат(Точка.x, "ЧГ=0; ЧН=0"));
		ЗаписатьЗначение(Запись, "y", Формат(Точка.y, "ЧГ=0; ЧН=0"));
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
КонецПроцедуры

// Рамка у платформы всегда border, стиль в пространстве v8ui без префикса
Процедура ЗаписатьРамкуПлатформы(Запись, Узел)
	Если Узел <> Неопределено Тогда
		Запись.ЗаписатьНачалоЭлемента("border");
		СкопироватьАтрибуты(Запись, Узел);
		Стиль = Дочерний(Узел, "style");
		Если Стиль <> Неопределено Тогда
			Запись.ЗаписатьНачалоЭлемента("v8ui:style");
			Тип = Стиль.ПолучитьАтрибут("http://www.w3.org/2001/XMLSchema-instance", "type");
			Если ЗначениеЗаполнено(Тип) Тогда
				Запись.ЗаписатьАтрибут("xsi:type", ИмяСПрефиксом(Стиль, Тип));
			КонецЕсли;
			Запись.ЗаписатьТекст(Стиль.ТекстовоеСодержимое);
			Запись.ЗаписатьКонецЭлемента();
		КонецЕсли;
		Запись.ЗаписатьКонецЭлемента();
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьФигуруПлатформы(Запись, Элемент, Свойства, Тег)
	Положение = Дочерний(Свойства, "Location");
	ЗаписатьЗначение(Запись, "rectLeft", Положение.ПолучитьАтрибут("left"));
	ЗаписатьЗначение(Запись, "rectRight", Положение.ПолучитьАтрибут("right"));
	ЗаписатьЗначение(Запись, "rectTop", Положение.ПолучитьАтрибут("top"));
	ЗаписатьЗначение(Запись, "rectBottom", Положение.ПолучитьАтрибут("bottom"));
	ЗаписатьТочкиКонтура(Запись, Тег, Число(Положение.ПолучитьАтрибут("left")), Число(Положение.ПолучитьАтрибут("top")),
		Число(Положение.ПолучитьАтрибут("right")), Число(Положение.ПолучитьАтрибут("bottom")));
	Если Тег <> "Decoration" Тогда
		ЗаписатьРамкуПлатформы(Запись, Дочерний(Свойства, "Border"));
	КонецЕсли;
	ЗаписатьКартинкуПлатформы(Запись, Свойства);
	РазмерКартинкиСхемы = Текст(Свойства, "PictureSize");
	Если РазмерКартинкиСхемы <> Неопределено Тогда
		ЗаписатьЗначение(Запись, "pictureStyle", ?(РазмерКартинкиСхемы = "AutoSize", "4", РазмерКартинкиСхемы));
	КонецЕсли;
	Если Тег = "Decoration" Тогда
		ЗаписатьСвойствоПлатформы(Запись, Свойства, "Shape", "shape");
		ЗаписатьСвойствоПлатформы(Запись, Свойства, "FlipMode", "flipMode");
		Угол = Дочерний(Свойства, "Angle");
		Если Угол <> Неопределено Тогда
			Запись.ЗаписатьНачалоЭлемента("angle");
			Запись.ЗаписатьАтрибут("xsi:type", "xs:decimal");
			Запись.ЗаписатьТекст(Угол.ТекстовоеСодержимое);
			Запись.ЗаписатьКонецЭлемента();
		КонецЕсли;
	Иначе
		ЗаписатьЗначение(Запись, "pointUUID", Элемент.ПолучитьАтрибут("uuid"));
		ЗаписатьЗначение(Запись, "passageState", "0");
		ЗаписатьЗначение(Запись, "tableCode", "0");
		Если Тег = "Condition" Тогда
			ЗаписатьСвойствоПлатформы(Запись, Свойства, "TruePortIndex", "truePortIndex");
			ЗаписатьСвойствоПлатформы(Запись, Свойства, "FalsePortIndex", "falsePortIndex");
		ИначеЕсли Тег = "Activity" Тогда
			ЗаписатьСвойствоПлатформы(Запись, Свойства, "TaskDescription", "taskDescription");
			ЗаписатьСвойствоПлатформы(Запись, Свойства, "Explanation", "explanation");
			ЗаписатьСвойствоПлатформы(Запись, Свойства, "Group", "groupAddressing");
		ИначеЕсли Тег = "SubBusinessProcess" Тогда
			ЗаписатьЗначение(Запись, "subprocessUUID", "00000000-0000-0000-0000-000000000000");
			ЗаписатьЗначение(Запись, "taskDescription", Текст(Свойства, "TaskDescription", ""));
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьЭлементПлатформы(Запись, Элемент, НомераПоИмени)
	Вид = НайтиВид("Тег", Элемент.ЛокальноеИмя);
	Свойства = Дочерний(Элемент, "Properties");
	Если Вид = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Элемент %1 графической схемы EDT (%2) пока не переводится в формат платформы'"),
			Текст(Свойства, "Name", ""), Элемент.ЛокальноеИмя);
	КонецЕсли;
	Запись.ЗаписатьНачалоЭлемента("item");
	ЗаписатьЗначение(Запись, "itemType", Вид.Вид);
	ЗаписатьЗначение(Запись, "itemId", Элемент.ПолучитьАтрибут("id"));
	ЗаписатьЗначение(Запись, "currentLanguage", "#");
	ЗаписатьОбщиеСвойстваПлатформы(Запись, Свойства);
	Если Вид.Тег = "ConnectionLine" Тогда
		ЗаписатьЛиниюПлатформы(Запись, Свойства, НомераПоИмени);
	Иначе
		ЗаписатьФигуруПлатформы(Запись, Элемент, Свойства, Вид.Тег);
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура ЗаписатьПараметрыПечатиПлатформы(Запись, Корень)
	Параметры = Дочерний(Корень, "PrintParameters");
	Значения = Новый Массив;
	Значения.Добавить(Новый Структура("Ключ,Значение", "6", Текст(Параметры, "TopMargin", "10")));
	Значения.Добавить(Новый Структура("Ключ,Значение", "7", Текст(Параметры, "LeftMargin", "10")));
	Значения.Добавить(Новый Структура("Ключ,Значение", "8", Текст(Параметры, "BottomMargin", "10")));
	Значения.Добавить(Новый Структура("Ключ,Значение", "9", Текст(Параметры, "RightMargin", "10")));
	Значения.Добавить(Новый Структура("Ключ,Значение", "13", ?(Текст(Параметры, "BlackAndWhite", "false") = "true", "1", "0")));
	Значения.Добавить(Новый Структура("Ключ,Значение", "16", "0"));
	Для Каждого Значение Из Значения Цикл
		Запись.ЗаписатьНачалоЭлемента("printPropItem");
		ЗаписатьЗначение(Запись, "key", Значение.Ключ);
		ЗаписатьЗначение(Запись, "val", Значение.Значение);
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ФайлыПроцесса

// Добавляет файлы процесса или вложенного процесса «Для Каждого», см. ФайлыПроцесса
//
// Параметры:
//  Файлы - Массив из Структура - см. ФайлыПроцесса
//  Данные - см. ВариантПроцессыКлиентСервер_Ei.ПодготовитьДанные
//  Имя - Строка - имя макета схемы
//  Ключ - Строка - uuid макета схемы
//  Синоним - Строка
//  Владелец - Строка - uuid владельца схемы, у главного файла пустой
//  Вариант - Строка - ключ варианта
//  КлючСтроки - Строка - ключ настроек строки набора
//
Процедура ДобавитьФайлыПроцесса(Файлы, Данные, Имя, Ключ, Синоним, Владелец, Вариант, КлючСтроки)
	
	Файлы.Добавить(ОписаниеФайла(Имя, Ключ, Синоним, ВФорматEDT(Данные.Инструкция), ТипСхемы(), Владелец, Вариант));
	Если ЗначениеЗаполнено(Данные.ИзначальныйОбъект) Тогда
		Файлы.Добавить(ОписаниеФайла(Имя + СуффиксОбъекта(), КлючОбъекта(Ключ), НСтр("ru = 'Изначальный объект'"),
			ТекстМодуля(Данные.ИзначальныйОбъект), "", Ключ, Вариант));
	КонецЕсли;
	Для Каждого Обработка Из Данные.Обработки Цикл
		ИмяЧасти = Имя + "_" + Обработка.Ключ;
		КлючЧасти = Строка(ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(КлючСтроки, Строка(Обработка.Значение.КлючНастроек)));
		Представление = Обработка.Значение.Представление;
		Если Не ЗначениеЗаполнено(Представление) Тогда
			Представление = Обработка.Ключ;
		КонецЕсли;
		Обработчик = Обработка.Значение.Обработчик;
		Если Обработчик = ОбработкаДляКаждогоКлиентСервер_Ei.Свойства().Имя Тогда
			//без схемы у вложенного процесса - схема по умолчанию, ее же показывает форма настройки «Для Каждого»
			ДобавитьФайлыПроцесса(Файлы, ОбработкаДляКаждогоКлиентСервер_Ei.ПолучитьДанныеНастройки(Обработка.Значение.Настройка),
				ИмяЧасти, КлючЧасти, Представление, Ключ, Вариант, КлючСтроки);
		ИначеЕсли Обработчик = ОбработкаАлгоритмКлиентСервер_Ei.Свойства().Имя Тогда
			Код = ОбработкаАлгоритмКлиентСервер_Ei.ПолучитьДанныеНастройки(Обработка.Значение.Настройка).ТекстМодуля;
			Файлы.Добавить(ОписаниеФайла(ИмяЧасти, КлючЧасти, Представление, ТекстМодуля(Строка(Код)), "", Ключ, Вариант));
		ИначеЕсли Обработчик = ОбработкаВыполнитьКлиентСервер_Ei.Свойства().Имя Тогда
			Ссылка = ОбработкаВыполнитьКлиентСервер_Ei.ПолучитьДанныеНастройки(Обработка.Значение.Настройка);
			Файлы.Добавить(ОписаниеФайла(ИмяЧасти, КлючЧасти, Представление,
				СтрШаблон("Наборы(""%1"").Варианты(""%2"")", Ссылка.Вариант, Ссылка.Тип), "TextDocument", Ключ, Вариант));
		Иначе
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Обработка %1 вида %2 пока не сохраняется в файлы процесса'"), Обработка.Ключ, Обработчик);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Описание файла процесса, см. ФайлыПроцесса. Переводы строк - только ПС: так текст читается с диска,
// и хэш прочитанного совпадает с хэшем записанного
//
// Параметры:
//  Имя - Строка
//  Ключ - Строка
//  Синоним - Строка
//  Текст - Строка
//  ТипМакета - Строка - пустой у формы
//  Владелец - Строка
//  Вариант - Строка
//
// Возвращаемое значение:
//  Структура - см. ФайлыПроцесса
//
Функция ОписаниеФайла(Имя, Ключ, Синоним, Знач Текст, ТипМакета, Владелец, Вариант)
	
	Текст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	Результат = Новый Структура("Имя, Ключ, Синоним, Текст", Имя, Ключ, Синоним, Текст);
	Результат.Вставить("Хэш", ОбщегоНазначенияВызовСервера_Ei.ПолучитьХешСтроки(Текст));
	Результат.Вставить("Форма", Не ЗначениеЗаполнено(ТипМакета));
	Результат.Вставить("ТипМакета", ТипМакета);
	Результат.Вставить("Владелец", Владелец);
	Результат.Вставить("Вариант", Вариант);
	Возврат Результат;
	
КонецФункции

// Модуль формы с кодом Ei: алгоритм или выражение, как у параметра-выражения без типа результата,
// см. ПараметрыКлиент_Ei.СодержимоеФайла
//
// Параметры:
//  Код - Строка - код Ei
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстМодуля(Код)
	Возврат ВариантАлгоритмКлиентСервер_Ei.ПодготовитьМодуль(ВыполнитьКлиентСервер_Ei.ПолучитьМодуль(Код), Истина,
		ВариантАлгоритмКлиентСервер_Ei.ОписаниеРезультатаФормы("", ""));
КонецФункции

// Настройка обработки «Выполнить» по тексту ее макета: Наборы("Строка").Варианты("Вариант")
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - см. ОбработкаВыполнитьКлиентСервер_Ei.ПолучитьНастройку
//
Функция НастройкаВыполнить(Текст)
	Части = СтрРазделить(Текст, """");
	Результат = Новый Соответствие;
	Результат.Вставить("Variant.xml", ?(Части.Количество() > 1, Части.Получить(1), ""));
	Результат.Вставить("Type.xml", ?(Части.Количество() > 3, Части.Получить(3), ""));
	Возврат Результат;
КонецФункции

// Схема, у элементов обработок которой есть картинки: элемент без картинки получает картинку вида своей обработки.
// В файле схемы картинка - ссылка на общую картинку расширения, проект внешних обработок EDT ее не находит
// (базовый проект - конфигурация без Ei), показывает пустой и при правке схемы в EDT может ее потерять
//
// Параметры:
//  Инструкция - Строка - схема в формате платформы
//  НастройкиОбработок - Соответствие из КлючИЗначение - настройки обработок процесса по именам
//
// Возвращаемое значение:
//  Строка - схема в формате платформы
//
Функция СхемаСКартинками(Инструкция, НастройкиОбработок)
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(Инструкция);
	Схема = СериализаторXDTO.ПрочитатьXML(Чтение);
	ВсеОбработки = ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки();
	Изменена = Ложь;
	Для Каждого Элемент Из Схема.ЭлементыГрафическойСхемы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементГрафическойСхемыСоединительнаяЛиния")
			Или ТипЗнч(Элемент) = Тип("ЭлементГрафическойСхемыДекорация") Тогда
			Продолжить;
		КонецЕсли;
		//имя элемента - имя обработки, разделитель и номер элемента, см. ПроцессыКлиентСервер_Ei.ПолучитьОбработчикВыполнения
		Ключ = ОбщегоНазначенияКлиентСервер_Ei.СтрНачалоДо(Элемент.Имя, ПроцессыКлиентСервер_Ei.стрРазделительИмени());
		Если Ключ = Неопределено Или Не Элемент.Картинка.Вид = ВидКартинки.Пустая Тогда
			Продолжить;
		КонецЕсли;
		НастройкаОбработки = НастройкиОбработок.Получить(Ключ);
		Обработчик = ВсеОбработки.Получить(?(НастройкаОбработки = Неопределено, Ключ, НастройкаОбработки.Обработчик));
		Если Обработчик <> Неопределено Тогда
			Элемент.Картинка = Обработчик.Свойства().Картинка;
			Изменена = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ?(Изменена, ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(Схема), Инструкция);
	
КонецФункции

// Ключ формы изначального объекта: ключ ее схемы с перевернутыми последними 12 знаками. Свой ключ у формы
// должен быть постоянным, а хранить его негде; обработки так не пересекутся - у них последние знаки свои
//
// Параметры:
//  КлючСхемы - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция КлючОбъекта(КлючСхемы)
	Хвост = Прав(КлючСхемы, 12);
	Перевернутый = "";
	Для Номер = 1 По СтрДлина(Хвост) Цикл
		Перевернутый = Сред(Хвост, Номер, 1) + Перевернутый;
	КонецЦикла;
	Возврат Лев(КлючСхемы, СтрДлина(КлючСхемы) - 12) + Перевернутый;
КонецФункции

// Окончание имени формы изначального объекта после имени ее схемы
//
// Возвращаемое значение:
//  Строка
//
Функция СуффиксОбъекта()
	Возврат "__Объект";
КонецФункции

Функция ТипСхемы()
	Возврат "GraphicalSchema";
КонецФункции

#КонецОбласти

#КонецОбласти

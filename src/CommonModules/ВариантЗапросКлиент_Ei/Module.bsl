Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ТекстМодуляКлиент_Ei.ВыделитьОшибкуВТексте(Форма,Элемент,Форма.Элементы.Запрос);			
КонецПроцедуры

Процедура УстановитьПараметры(Форма) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ПустаяСтрока(ТД.Запрос) Тогда
		мПараметров = ВариантЗапросВызовСервера_Ei.ПолучитьПараметры(ТД.Запрос);		
		ПараметрыКлиент_Ei.ВставитьПараметры(ТД, мПараметров);	
	КонецЕсли;
Конецпроцедуры
	
#КонецОбласти

Процедура КонструкторЗапроса(Форма) Экспорт 
	Элемент 			= ВариантЗапросКлиент_Ei.ЭлементИнструкции(Форма);
	ПараметрыЗапроса 	= РедакторКодаКлиент_Ei.ПолучитьТекст(Элемент);
	 
	РедакторКодаКлиент_Ei.КонструкторЗапросаВызвать(Форма,Элемент,ПараметрыЗапроса,ЭтотОбъект);
КонецПроцедуры

//Формирует выражение на втроенном языке на основе текста запроса
//
Процедура ПреобразоватьВВыражение(Форма,ПараметрыКакСсылки) Экспорт
	ТД 					= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		ТекстЗапроса 	= ТД.Запрос;
		СтрокаЗапроса	= СтрЗаменить(ТекстЗапроса,Символы.ПС,Символы.ПС+Символы.Таб+"|");
		СтрокаЗапроса	= СтрЗаменить(СтрокаЗапроса,"""","""""");//так же заменим кавычки запроса одну меняем на 2 
		Строка			= "Запрос = Новый Запрос;
							|Запрос.Текст = """+СтрокаЗапроса+""";";
		Если Найти(Нрег(СтрокаЗапроса),"поместить ")> 0 Тогда
			//Используем временные таблицы 
			Строка=Строка+Символы.ПС+"МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			|Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;";
		КонецЕсли;
		
		//{Начало изменений Кудяков Г.А.  24 января 2008 г. 11:38:50
		//параметры можно выводить по разному можно ссылкой а можно и явно преобразовать в выражение
		Если ПараметрыКакСсылки Тогда 
			Для каждого ПараметрЗапроса Из ТД.ПараметрыЗапроса Цикл
				ИмяПараметра 	= СокрЛП(ПараметрЗапроса.ИмяПараметра);
				Строка			= Строка+Символы.ПС+"Запрос.УстановитьПараметр("""+ИмяПараметра+""", Параметры("""+ИмяПараметра+"""));";
			КонецЦикла;
		Иначе
			Для Каждого ПараметрЗапроса Из ТД.ПараметрыЗапроса Цикл
				ИмяПараметра 	= СокрЛП(ПараметрЗапроса.ИмяПараметра);
				Если ПараметрЗапроса.ЭтоВыражение Тогда
					ТекстДанных = ПараметрЗапроса.ЗначениеПараметра;
				Иначе
					ТекстДанных = ТекстМодуляКлиент_Ei.ПреобразоватьЗначениеКВыражению(ОбщийМодульКлиентСервер_Ei.АдаптироватьЗначениеПараметраЗапроса(ПараметрЗапроса.ЗначениеПараметра));
				КонецЕсли;
	        	Если  Найти(нрег(СтрЗаменить(ТекстДанных," ","")),Нрег(ТекстМодуляКлиент_Ei.РезультатРавно()))>0 Тогда
					//значение возвращается в переменную Результат
					Строка =Строка+"
							|//Начало вычисления параметра <"+ИмяПараметра+">";
							Для Ном = 1 По СтрЧислоСтрок(ТекстДанных) Цикл
								Строка =Строка+Символы.ПС+Символы.Таб+СтрПолучитьСтроку(ТекстДанных,Ном);		
							КонецЦикла;	
					Строка =Строка+"		
							|Запрос.УстановитьПараметр("""+ИмяПараметра+""",Результат);
							|"+ТекстМодуляКлиент_Ei.РезультатРавно()+" Неопределено; //Конец вычисления параметра  <"+ИмяПараметра+">";
				Иначе
					Строка =Строка+"
							|Запрос.УстановитьПараметр("""+ИмяПараметра+""", "+ТекстДанных+");";
				КонецЕсли;
			КонецЦикла;			
		КонецЕсли;	
		//Свормируем строку заголовка с учетом родителей Родитель.Родлителя\Родитель\Строка
		//СтрокаДерева=Элементыформы.ДеревоЗапросов.ТекущаяСтрока;
		//ПутьКЗапросу=СтрокаДерева.Запрос;
		//Пока не СтрокаДерева.Родитель=Неопределено Цикл
		//	ОбработкаПрерыванияПользователя();
		//	СтрокаДерева=СтрокаДерева.Родитель;
		//	ПутьКЗапросу=СтрокаДерева.Запрос+"\"+ПутьКЗапросу;
		//КонецЦикла;
		Имя 	= ВариантАлгоритмКлиентСервер_Ei.Свойства().Имя;
		ТД[Имя] = Строка+Символы.ПС+"Результат = Запрос.Выполнить();";
		//|//ВнешниеОбработки.Создать("""+ЭтотОбъект.ИспользуемоеИмяФайла+""").Отладка(Запрос,,"""+СтрЗаменить(ПутьКЗапросу,"""","""""")+""")
		//|//Сгенерировано EI "+Формат(ТекущаяДата(),"ДЛФ=DDT")+" "+?(ПустаяСтрока(мИмяФайла),"файл запросов не сохранен",мИмяФайла));
		
		ВариантАлгоритмКлиентСервер_Ei.ПриИзмененииДанных(Форма);
		
		//Форма.Элементы.ПанельТекстаЗапроса.ТекущаяСтраница = СтраницаАлгоритма;
		ВариантыКлиент_Ei.АктуализироватьОбработчик(Форма,Имя);
		
		//ТУТ НУЖНО ДОБАВИТЬ ПРОЦЕДУРУ ИЗМЕНЕНИЯ
		//ДеревоЗапросовЯзыкПриИзменении(Элементы.Язык);
	КонецЕсли;	
КонецПроцедуры

Процедура ВыполнитьИЗ(Форма) Экспорт
	// ТУТ ВЫГОДНЕЕ ПОКАЗЫВАТЬ В ДИН СПИСКЕ пока не придумал как
	ЭлементИнструкции = ЭлементИнструкции(Форма);
	Если Не ЭлементИнструкции =  Неопределено Тогда
		Инструкция = "Выбрать * Из " + ТекстМодуляКлиент_Ei.ПолучитьВыделенныйТекст(ЭлементИнструкции);
		ВариантыКлиент_Ei.ВыполнитьВарианты(Форма,Новый Структура("Инструкция",Инструкция));
	КонецЕсли;	
КонецПроцедуры

#Область Редактор_кода

Процедура ПриИзменении(Форма,Элемент) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если НЕ ТД = Неопределено Тогда
		ПараметрыКлиент_Ei.Установить(Форма);	
		ВариантЗапросКлиентСервер_Ei.ЗапомнитьДанные(Форма,ТД);
		//КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
	КонецЕсли;	
КонецПроцедуры

Функция ЭлементИнструкции(Форма) Экспорт 
	Возврат Форма.Элементы.Найти("HTML_Запрос");			
КонецФункции	

Процедура ПриНажатии(Форма,Элемент, ДанныеСобытия, СтандартнаяОбработка) Экспорт
	Событие=ДанныеСобытия.Event.eventData1C;
	Если Не Событие=Неопределено И Событие.event="EVENT_CONTENT_CHANGED" Тогда
		ПриИзменении(Форма,Элемент);
	Иначе		
		РедакторКодаКлиент_Ei.ПолеHTML_ПриНажатии(Форма, Элемент, ДанныеСобытия, СтандартнаяОбработка, ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

Процедура ДокументСформирован(Форма,Элемент) Экспорт
	Если РедакторКодаКлиент_Ei.ЭтоНеВебКлиент() Тогда
		РедакторКодаКлиент_Ei.ИнициализацияРедактора(Форма, Элемент, "bsl_query");
		РедакторКодаКлиент_Ei.View(Элемент).hideLineNumbers();
	КонецЕсли;
	Элемент.Доступность = Истина; 
	ПриИзмененииДанных(Форма); //ожидаю что это выполняется только один раз при загрузке
КонецПроцедуры

#КонецОбласти	


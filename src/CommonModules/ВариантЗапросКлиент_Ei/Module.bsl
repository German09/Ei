#Область ИнтерфейсВариантовКонкструктра

//Возьмем выделенный текст если в ДопПараметры не объявлена инструкция
//
Асинх Процедура ПередВыполнением(Форма,ДопПараметры) Экспорт
	стрИнструкция =  "Инструкция";	
	Если Не ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,стрИнструкция) Тогда
		ЭлементИнструкции = ЭлементИнструкции(Форма);
		Если Не ЭлементИнструкции =  Неопределено Тогда
			ВыделенныйТекст = ТекстМодуляКлиент_Ei.ПолучитьВыделенныйТекст(ЭлементИнструкции);
			Если ЗначениеЗаполнено(ВыделенныйТекст) Тогда
				Фагмент = "Фрагмент";
				Кнопки = Новый СписокЗначений();
				Кнопки.Добавить(Фагмент,"Только фрагмен");
				Кнопки.Добавить("Весь","Всё");
				Ответ = Ждать ВопросАсинх("Выполнить только выделенный фрагмент?",Кнопки, 20, Фагмент,,Фагмент);
				Если Ответ = Фагмент Тогда 
					ДопПараметры = ?(ДопПараметры = Неопределено,ДопПараметры = Новый Структура,ДопПараметры);
					ДопПараметры.Вставить(стрИнструкция,ВыделенныйТекст);	
				КонецЕсли;			
			КонецЕсли;
		КонецЕсли;			
	КонецЕсли;		
КонецПроцедуры

Процедура ПриИзмененииДанных(Форма) Экспорт
	ВариантыКлиент_Ei.ПриИзмененииДанныхВариантаСРедактором(Форма,ВариантЗапросКлиентСервер_Ei);	
Конецпроцедуры

Процедура ПриОтображении(Форма) Экспорт
	ВариантыКлиент_Ei.ПриОтображенииВариантаСРедактором(Форма,ВариантЗапросКлиентСервер_Ei);	
Конецпроцедуры


	Если Не ПустаяСтрока(ТекД.Запрос) Тогда
		Параметры = ВариантЗапросВызовСервера_Ei.ПолучитьПараметры(ТекД.Запрос);		
		ПараметрыКлиент_Ei.ВставитьПараметры(ТекД, Параметры);	
	КонецЕсли;
Конецпроцедуры

// Сохранить данные настройки на диск в формате EDT
// 
// Параметры:
//  Настройки 	- см. ВариантыКлиент_Ei.НастройкиСохранения
// 
// Возвращаемое значение:
// 	см. ФайлыКлиент_Ei.СохранитьВМакет  
Асинх Функция Сохранить(Настройки) Экспорт
	Перем Результат;
	Данные = Настройки.Данные; //см. ВариантЗапросКлиентСервер_Ei.ПодготовитьДанные
	Если ЗначениеЗаполнено(Данные.Инструкция) Тогда
		Обработчик	= ВариантЗапросКлиентСервер_Ei;
		ВариантКлюч	= ВариантыКлиентСервер_Ei.ПолучитьИдентификатор(Настройки.ВариантыКлюч,Обработчик);
		ВариантИмя	= ВариантыКлиентСервер_Ei.ПолучитьИмя(Настройки.ВариантыКлюч,Обработчик);
		Содержание 	= Обработчик.ПолучитьСодержание(Данные.Инструкция); 
		//КаталогПуть = Ждать EDTКлиент_Ei.СоздатьОбшийМодуль(Путь, сМодуль, ВариантИмя, ВариантКлюч);
		//КаталогПуть = Ждать EDTКлиент_Ei.СоздатьФормуОбработки(Путь, сМодуль, ВариантИмя, ВариантКлюч);
		//Результат 	= ФайлыКлиент_Ei.РезультатСохранения(ВариантИмя, Путь, сМодуль, ВариантКлюч, КаталогПуть, Новый Структура("Синоним",НаборИмя));
		Результат 	= ФайлыКлиент_Ei.СохранитьВМакет("DataCompositionSchema",Настройки.ВариантыИмя, Настройки.Путь, Содержание, ВариантИмя, ВариантКлюч);
	Иначе
		//думаю удаления файлов нужно избежать
		//пустой файл лучшем чем его отсутсвтие как кажется
		УдалитьФайлыАсинх(СтрШаблон("%1\%2_%3",Настройки.Путь,Настройки.ВариантыИмя,ВариантЗапросКлиентСервер_Ei.Свойства().Имя));
	КонецЕсли;
	Возврат Результат;	
КонецФункции

// Прочитать данные из файла
// 
// Параметры:
//  Путь - Строка 	- Путь к файлы с данными
// 
// Возвращаемое значение:
// 	см. ВариантЗапросКлиентСервер_Ei.ПодготовитьДанные	
Функция Прочитать(Путь) Экспорт
	Запрос = "";
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(Путь);
	Объект 	= ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	Если Не Объект.Свойства().Получить("DataSet") = Неопределено Тогда
		НаборЗапросов = Объект.Получить("DataSet");
		Если Не НаборЗапросов.Свойства().Получить("query") = Неопределено Тогда
			Запрос = НаборЗапросов.Получить("query");	
		КонецЕсли;		
	КонецЕсли;	
	Результат = Новый Структура;
	Результат.Вставить("Инструкция",Запрос);
	Возврат Результат;	
КонецФункции	


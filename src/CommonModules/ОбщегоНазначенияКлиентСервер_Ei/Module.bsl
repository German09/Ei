// Преобразует объект XDTO в структуру.
//
// Параметры:
//  ОбьектXDTO - ОбъектXDTO - Объект XDTO, который необходимо преобразовать в структуру.
//
// Возвращаемое значение:
//  Структура - Структура, соответствующая объекту XDTO.
//
Функция ОбьектXDTOВСтруктуру(ОбьектXDTO) Экспорт
	Результат = Новый Структура; 
	Для Каждого Свойство ИЗ ОбьектXDTO.Свойства() Цикл 
		Результат.Вставить(Свойство.Имя,ОбьектXDTO[Свойство.Имя]);		
	КонецЦикла;
	Возврат Результат;		
КонецФункции

// Получить нав ссылку на запись РС.
// 
// Параметры:
//  ИмяРС 				- Строка
//  ИзмеренияИПериод 	- СписокЗначений из Произвольный - Помеченные элементы добавляются в представление
//  ДопПредставления	- Строка
// 
// Возвращаемое значение:
//  Строка - Получить нав ссылку на запись РС
Функция ПолучитьНавСсылкуНаЗаписьРС(ИмяРС,ИзмеренияИПериод,ДопПредставления = "") Экспорт
	Параметры = Новый Массив;
	Описания = Новый Массив(); 
	Для Каждого Измерение ИЗ ИзмеренияИПериод Цикл
		Значение 		= Измерение.Значение;
		Представление	= Измерение.Значение;
		Если ТипЗнч(Измерение.Значение)	= Тип("Дата") Тогда
			Значение 		= Формат(Измерение.Значение,"ДФ=yyyyMMddHHmmss;");
			Представление	= Формат(Измерение.Значение,"ДЛФ=T;");		
		ИначеЕсли ТипЗнч(Измерение.Значение)= Тип("Строка") Тогда
			//тут все как и было, но наличие условия важно чтобы не попасть в последнее Иначе
		ИначеЕсли ТипЗнч(Измерение.Значение)= Тип("Число") Тогда
			Значение 		= Формат(Измерение.Значение,"ЧГ=;");
		ИначеЕсли ТипЗнч(Измерение.Значение)= Тип("Булево") Тогда
			Значение 		= Число(Измерение.Значение);	
		Иначе
			//тут ссылки	
			Значение 		= нРег(вПреобразоватьИдентификатор(Измерение.Значение.УникальныйИдентификатор(),Ложь));	
		КонецЕсли;
		Параметры.Добавить(СтрШаблон("%1=%2",Измерение.Представление,Значение));
		Если Измерение.Пометка Тогда
			Описания.Добавить(Представление);
		КонецЕсли;			
	КонецЦикла;	
	Результат =  СтрШаблон("%1%4: e1cib/data/РегистрСведений.%2?%3",СтрСоединить(Описания," "),ИмяРС,СтрСоединить(Параметры,"&"),ДопПредставления);
	Возврат Результат;	
КонецФункции

// Проверяет наличие реквизита или свойства у произвольного объекта без обращения к метаданным.
//
// Параметры:
//  Объект       - Произвольный - объект, у которого нужно проверить наличие реквизита или свойства;
//  ИмяРеквизита - Строка       - имя реквизита или свойства.
//
// Возвращаемое значение:
//  Булево - Истина, если есть.
//
Функция ЕстьРеквизитИлиСвойствоОбъекта(Объект, ИмяРеквизита) Экспорт
	
	КлючУникальности   = Новый УникальныйИдентификатор;
	СтруктураРеквизита = Новый Структура(ИмяРеквизита, КлючУникальности);
	ЗаполнитьЗначенияСвойств(СтруктураРеквизита, Объект);
	
	Возврат СтруктураРеквизита[ИмяРеквизита] <> КлючУникальности;
	
КонецФункции

#КонецОбласти
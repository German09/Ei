// Функция - Получает структуру описания метаданных переданного значения (пустого)
//
// Параметры:
//  Значение - Произвольный - произволная ссылка, важен тип значения 
// 
// Возвращаемое значение:
//   Неопределено,Структура: 
//		*ПолноеИмя 		- Строка - Имя.
//		*Тип 			- Строка - Тип.
//		*ТипДляЗапроса	- Строка - Тип в запросе.
//
Функция ПолучитьОписаниеЗначения(Значение) Экспорт
	Результат = Новый Структура("ПолноеИмя,Тип,ТипДляЗапроса");
	Попытка
		ИмяТипа = ПолучитьИмяТипЗнч(ТипЗнч(Значение));
		Для Каждого Эл ИЗ ТипыКлиентСервер_Ei.Ключевые() Цикл
			Если СтрНачинаетсяС(ИмяТипа,Эл.Ключ+".") Тогда
				Результат.Тип 			= СтрРазделить(Эл.Значение,";").Получить(0);
				Результат.ТипДляЗапроса = СтрРазделить(Эл.Значение,";").Получить(1);
				Результат.ПолноеИмя 	= СтрЗаменить(ИмяТипа,Эл.Ключ+".","");
				Если Результат.Тип = сВнешниеИсточникиДанных() Тогда
					Результат.ПолноеИмя = СтрЗаменить(Результат.ПолноеИмя,".",".Таблица.");	 
				КонецЕсли;	
				//@skip-check constructor-function-return-section
				Возврат Результат;
			КонецЕсли;	
		КонецЦикла;	
	Исключение
		Возврат Неопределено;
	КонецПопытки;	
КонецФункции


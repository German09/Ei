// Получаем все свойства объекта данных на основе таблицы результатов запроса
//
// Параметры:
//  Объект	 					- Произвольный	- 	Объект данных, свойства которого необходимо получить
//  УникальныйИдентификатор	 	- УникальныйИдентификатор	 - Уникальный идентифкатор формы, используется для формирования описания значения, если не указан то табличные части и таблицы значений в объекте игнорируются
//
// 
// Возвращаемое значение:
//  см. ОбщегоНазначенияВызовСервера_Ei.вСформироватьСписокПоСтруктуреКолонок
//
Функция ПолучитьСвойстваОбъектаМетаданных(Объект,УникальныйИдентификатор = Неопределено) Экспорт
	СписокСвойств	= Новый СписокЗначений;
	Если Не Объект = Неопределено Тогда
		ОписаниеЗначения 	= ПолучитьОписаниеМетаданных(ТипЗнч(Объект));
		ПолноеИмяДляЗапроса	= ОписаниеЗначения.ТипДляЗапроса+"."+ОписаниеЗначения.ПолноеИмя;
		СобытиеОтладки 		= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Получение свойств объекта метаданных "+ПолноеИмяДляЗапроса,"Объекты БД");
		Попытка
			ТекстЗапроса 		= СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ 0 _Т.* ИЗ %1 КАК _Т",ПолноеИмяДляЗапроса);
			АдресКеша			= ВыполнитьКлиентСервер_Ei.Запрос(ТекстЗапроса,Неопределено); // тут уникальный идентификатор не передаем, потому что расчитываем на возврат именно адреса Кеша					
			СписокСвойств		= ОбщегоНазначенияВызовСервера_Ei.вСформироватьСписокПоСтруктуреКолонок(АдресКеша,Объект,УникальныйИдентификатор);
		Исключение
			ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке());
			//ВызватьИсключение "Не удалось получить свойства";
		КонецПопытки;
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	КонецЕсли;	
	Возврат СписокСвойств;
КонецФункции	

//Заменяет строку по соотвесвию переданному в списке
//Параметры:
//	ИсходнояСтрока		-Строка- Строка в которой делаем замену.
//	СоотвесвтиеЗамены   -Соответствие из Строка - Соответвие замены
//	Окончание			-Строка - Дополнение искомой строки
//	ТолькоОднаЗамена	-Булево - Признак только одной замены все остальнгые игнорируются
//Возвращаемое значение:
//	Строка
Функция СтрЗаменитьИзСписка(Знач ИсходнояСтрока,СоотвесвтиеЗамены,Окончание="",ТолькоОднаЗамена = Ложь)Экспорт
	Для Каждого Элемент ИЗ СоотвесвтиеЗамены Цикл
		ИсходнояСтрока = СтрЗаменить(ИсходнояСтрока,Элемент.Ключ+Окончание,Элемент.Значение+Окончание);
		Если ТолькоОднаЗамена И Не ИсходнояСтрока = ИсходнояСтрока Тогда
			Прервать;
		КонецЕсли	
	КонецЦикла;
	Возврат ИсходнояСтрока;
КонецФункции

// Функция - Определяет что это структура и унее есть свойство
//
// Параметры:
//  Значение	 - Произвольный	 	- Значение которое нужно проверить на содержание свойства
//  Свойство	 - Строка	 		- Имя свойства
//  Результат	 - Произвольный		- Возвращаемая переменная в которую передается значений свойства	
// 
// Возвращаемое значение:
//   - Булево - есть или нет свойства у структуры
//
Функция ЕстьСвойство(Значение,Свойство, Результат = Неопределено) Экспорт
	Перем ЗначСвойства;
	ЕстьСвойство = (ТипЗнч(Значение) = Тип("Структура") или ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура"))
					И Значение.Свойство(Свойство,ЗначСвойства);
	Если ЕстьСвойство Тогда
		Результат = ЗначСвойства; //только так, есть делать без переменной ЗначСвойства, то Результат может обнулится из-за отсутсвующего свойства
	КонецЕсли;
	Возврат ЕстьСвойство;	 	 					
КонецФункции	

//Убирает из строки проблеы и другие сиволы и после них символы ставит в верхнем регистре
//Параметры:
//	Строка  - Строка - Исходная строка например "Уникальный идентификатор"
//Возвращаемое значение:
//	- Строка -  Например "УникальныйИдентификатор"
//
Функция вВрегПослеПробела(Знач Строка) Экспорт
	Результат 		= "";
	АлфавитРус		= "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЫЬЪЭЮЯ";
	АлфавитАнгл		= "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	Цифры 			= "1234567890";
	Символ			= "_";
	ТолькоБуквы		= Истина; //для первого прохода
	ВерехнийРег		= Истина; //для первого символа и для следующего после не буквы не цифры и не символа 
	Для Сч = 1 По СтрДлина(Строка) Цикл
	    ПроверяемыйСимвол = Сред(Строка, Сч, 1);
	    Если СтрНайти(нРег(АлфавитРус), нРег(ПроверяемыйСимвол)) ИЛИ СтрНайти(нРег(АлфавитАнгл), нРег(ПроверяемыйСимвол))  Тогда
	        //Буква	      
	        Если ТолькоБуквы Тогда
	    		ТолькоБуквы		= Ложь;
	    	КонецЕсли;	
	    ИначеЕсли СтрНайти(Цифры, ПроверяемыйСимвол) Тогда
	    	//Цифра
	    	Если ТолькоБуквы Тогда
	    		Продолжить;	
	    	КонецЕсли;	
	    ИначеЕсли СтрНайти(Символ, ПроверяемыйСимвол) Тогда
	    	//Символ
	    	Если ТолькоБуквы Тогда
	    		Продолжить;
	    	КонецЕсли;
	    Иначе
	    	ВерехнийРег		= Истина; //следующий делаем с в верхнем регистре
	    	Продолжить;				    
	    КонецЕсли;
	    Если ВерехнийРег Тогда
	    	Результат = Результат+Врег(ПроверяемыйСимвол);
	    	ВерехнийРег	= Ложь;		
	    Иначе
	    	Результат = Результат+ПроверяемыйСимвол;
	    КонецЕсли;				    	    
	КонецЦикла;
	Возврат Результат;
//	Пока Найти(Строка," ")>0 Цикл
//		позПробела = Найти(Строка," ");
//		Строка = СтрЗаменить(Строка,Сред(Строка,позПробела,2),ВРег(СокрЛП(Сред(Строка,позПробела,2))));
//	КонецЦикла;
//	Возврат Строка;
КонецФункции

Функция вСоединить(Значение1, Значение2) Экспорт
	Если ТипЗнч(Значение1) = Тип("Массив") Тогда
		Для каждого Элемент ИЗ Значение2 Цикл
			Значение1.Добавить(Элемент);		
		КонецЦикла;	
		Возврат Значение1;
	ИначеЕсли ТипЗнч(Значение1) = Тип("Структура") Тогда
		Для Каждого Элемент ИЗ Значение2 Цикл
			Значение1.Вставить(Элемент.Ключ,Элемент.Значение);
		КонецЦикла;	
	    Возврат Значение1;
	Иначе
		Возврат ?(Значение1=Неопределено,Значение2,Значение1);
	КонецЕсли;
КонецФункции	


// Найти в коллекции
// 
// Параметры:
//  СтрПоиска  		- Структура - 							Структура Поиска
//  КоллекцияСтрок 	- ДанныеФормыКоллекцияЭлементовДерева - Коллекция строк
//  ПоВсейИерарахии - Булево - 								По всей иерарахии
// 
// Возвращаемое значение:
//  Массив из ДанныеФормыКоллекцияЭлементовДерева
Функция НайтиВКоллекцииДерева(СтрПоиска,КоллекцияСтрок,ПоВсейИерарахии = Истина) Экспорт
	Результат 	= Новый Массив;
	Если ТипЗнч(КоллекцияСтрок) = Тип("ДанныеФормыКоллекцияЭлементовДерева") Тогда
		Для Каждого ЭлПоиска ИЗ СтрПоиска Цикл
			Для Каждого Строка ИЗ КоллекцияСтрок Цикл
				Если нРег(Строка[ЭлПоиска.Ключ]) = нРег(ЭлПоиска.Значение) Тогда
					Результат.Добавить(Строка);
				КонецЕсли;
				Если ПоВсейИерарахии Тогда
					Для Каждого ВложенныйРезультат ИЗ НайтиВКоллекцииДерева(СтрПоиска,Строка.ПолучитьЭлементы()) Цикл
						Результат.Добавить(ВложенныйРезультат);		
					КонецЦикла;
				КонецЕсли		
			КонецЦикла;
			Прервать;
		КонецЦикла;
	Иначе
		//Это если дерево
		Результат = КоллекцияСтрок.НайтиСтроки(СтрПоиска,Истина);	
	КонецЕсли;	
	Возврат Результат;
КонецФункции


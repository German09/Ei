// Разделяет строки по длинному слову, а не по каждой букве этого слова 
// 
// Параметры:
//  Строка 		- Строка - Строка
//  Разделитель - Строка - Разделитель
// 
// Возвращаемое значение:
//  Массив из Строка
Функция СтрРазделитьПолный(Строка,Разделитель) Экспорт
	Если СтрДлина(Строка)=1 Тогда
		Результат = СтрРазделить(Строка,Разделитель);
	Иначе
		Результат 			= Новый Массив;	
		НачальнаяПозиция	= 1;
		ПозицияЗапятой = СтрНайти(Строка,Разделитель,НаправлениеПоиска.СНачала,НачальнаяПозиция);
		Пока ПозицияЗапятой<>0 Цикл		
			Результат.Добавить(Сред(Строка,НачальнаяПозиция,ПозицияЗапятой-НачальнаяПозиция));					
			НачальнаяПозиция	= ПозицияЗапятой + СтрДлина(Разделитель);			
			ПозицияЗапятой		= СтрНайти(Строка,Разделитель,НаправлениеПоиска.СНачала,НачальнаяПозиция);
		КонецЦикла; 
		Результат.Добавить(Сред(Строка,НачальнаяПозиция));
	КонецЕсли;
	Возврат Результат;
КонецФункции	

// Функция - Получает структуру описания метаданных типа

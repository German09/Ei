#Область ПрограммныйИнтерфейс
// Функция - Получить события элемента
//
// Параметры:
//  Тип			 - Строка	 -  Универсальный тип элемента формы
//  Расширение	 - Строка	 -  Тип расширения
// 
// Возвращаемое значение:
//   Массив Из Структура:
//   	*Значение -  Строка
//   	*Аргументы - Строка
//
Функция ПолучитьСобытияЭлемента(Тип,Расширение =  "") Экспорт
	Результат = ПолучитьВсеСобытия().НайтиСтроки(Новый Структура("Тип,Расширение",Тип,""));   
	Если Не ПустаяСтрока(Расширение) Тогда
		Для Каждого Свойство ИЗ ПолучитьВсеСобытия().НайтиСтроки(Новый Структура("Тип,Расширение",Тип,Расширение)) Цикл
			Результат.Добавить(Свойство);		
		КонецЦикла;	
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Функция - Получить свойства элемента
//
// Параметры:
//  Тип			 - Строка	 -  Универсальный тип элемента формы
//  Расширение	 - Строка	 -  Тип расширения
// 
// Возвращаемое значение:
//   -  Массив Из Строка
//
Функция ПолучитьСвойстваЭлемента(Тип,Расширение =  "") Экспорт
	Результат = Новый Массив;
	//вначале именно унаследованные от родителя там Имя и другие "важные"
	Для Каждого Свойство ИЗ ПолучитьВсеСвойства().НайтиСтроки(Новый Структура("Тип,Расширение",Тип,"")) Цикл
		Результат.Добавить(Свойство.Значение);		
	КонецЦикла;	   
	Если Не ПустаяСтрока(Расширение) Тогда
		Для Каждого Свойство ИЗ ПолучитьВсеСвойства().НайтиСтроки(Новый Структура("Тип,Расширение",Тип,Расширение)) Цикл
			Результат.Добавить(Свойство.Значение);		
		КонецЦикла;	
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Функция - Получатет таблицу событий элементов формы
// 
// Возвращаемое значение:
//   см. ПолучитьСобытияИлиСвойства
//
Функция ПолучитьВсеСобытия() Экспорт
	Возврат НаследованиеФормСерверПовтИсп_Ei.ПолучитьСобытияИлиСвойства("События",4);	
КонецФункции

// Функция - Получает таблицу событий или свойств из макета
//
// Параметры:
//  Тип		 - Строка	 - Суффикс макета 
//  Ширина	 - Число	 - Число колонок
// 
// Возвращаемое значение:
//   ТаблицаЗначений:
//   	*Тип 		- Строка
//   	*Расширение - Строка
//   	*Значение 	- Строка
//   	*Аргументы	- Строка - В случае событий 
//
Функция ПолучитьСобытияИлиСвойства(Тип = "События",Ширина = 3) Экспорт 
	ТД = ПолучитьОбщийМакет(СтрШаблон("НаследованиеФорм%1_Ei",Тип));
	ПЗ = Новый ПостроительЗапроса;
	ПЗ.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТД.Область(1,1,ТД.ВысотаТаблицы,Ширина)); 
	ПЗ.Выполнить();
	Возврат ПЗ.Результат.Выгрузить();
КонецФункции


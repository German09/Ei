Функция ПолучитьСвойстваЭлемента(Тип,Расширение =  "") Экспорт
	Результат = ПолучитьВсеСвойства().НайтиСтроки(Новый Структура("Тип,Расширение",Тип,""));  //вначале именно унаследованные от родителя там Имя и другие "важные" 
	Если Не ПустаяСтрока(Расширение) Тогда
		Для Каждого Свойство ИЗ ПолучитьВсеСвойства().НайтиСтроки(Новый Структура("Тип,Расширение",Тип,Расширение)) Цикл
			Результат.Добавить(Свойство);		
		КонецЦикла;	
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Функция - Получатет таблицу событий элементов формы
// 
// Возвращаемое значение:
//   - Таблица значений
//
Функция ПолучитьВсеСобытия() Экспорт
	Возврат НаследованиеФормСерверПовтИсп_Ei.ПолучитьСобытияИлиСвойства("События",4);	
КонецФункции

// Функция - Получает таблицу свойств элементов формы
// 
// Возвращаемое значение:
//   - Таблица значений
//
Функция ПолучитьВсеСвойства()
	Возврат НаследованиеФормСерверПовтИсп_Ei.ПолучитьСобытияИлиСвойства("Свойства");	
КонецФункции

// Функция - Получает таблицу событий или свойст из макета
//
// Параметры:
//  Тип		 - Строка	 - Суффикс макета 
//  чШирина	 - Число	 - Число колонок
// 
// Возвращаемое значение:
//   -  Таблица значений
//
Функция ПолучитьСобытияИлиСвойства(Тип = "События",чШирина = 3) Экспорт 
	ТД = ПолучитьОбщийМакет("НаследованиеФорм"+Тип+"_Ei");
	ПЗ = Новый ПостроительЗапроса;
	ПЗ.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТД.Область(1,1,ТД.ВысотаТаблицы,чШирина)); 
	ПЗ.Выполнить();
	Возврат ПЗ.Результат.Выгрузить();
КонецФункции


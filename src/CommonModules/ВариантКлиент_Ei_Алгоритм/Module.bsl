Процедура ВыполнитьВариант(Форма,ТД,Параметры,ДопПараметры) Экспорт
	ТекстВыполняемогоКода = ВариантыКлиент_Ei.ПолучитьТекстДляВыполнения(Форма,ТД,"Язык");
	Если ЗначениеЗаполнено(ТекстВыполняемогоКода) Тогда
		КонтекстВыполнения 		= ВариантыКлиент_Ei.ПолучитьСтруктуруДоступныхПеременных(Форма,ТД,Ложь);
		мсТипов 				= Новый Массив;
		мсТипов.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().РезультатЗапроса);
		мсТипов.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТаблицаЗначений);
		мсТипов.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ДеревоЗначений);
		мсТипов.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТабличныйДокумент);
		ОписаниеЗначения		= ОбщийМодульКлиентСервер_Ei.__ВычислитьЗначение(ТекстВыполняемогоКода,Форма.УникальныйИдентификатор,мсТипов,КонтекстВыполнения);
		сооАдресРезультата 		= Новый Соответствие;
		мсТипов.Удалить(0); 	//Уберем результат запроса, он может быть преобразован к типу/возвращен, но дальше нигде явно не учитываться и его нужно убрать
		сооАдресРезультата.Вставить(ОписаниеЗначения.ОписаниеТипов, ОписаниеЗначения);
		Если Не мсТипов.Найти(ОписаниеЗначения.ОписаниеТипов) = Неопределено Тогда
			ТД.ПоказателиВыполнения.ВидРезультата = ОписаниеЗначения.ОписаниеТипов; //выровняем либо таблицу, либо дерево если найдено, чтобы автоматом переключится на нужную закладку
		ИначеЕсли мсТипов.Найти(ТД.ПоказателиВыполнения.ВидРезультата) = Неопределено Тогда	
			//тут вообще не поддерживаемый тип, установим = таблице
			ТД.ПоказателиВыполнения.ВидРезультата = ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТаблицаЗначений;
		КонецЕсли;
		ТД.ПоказателиРезультата.сооАдресовРезультатов = сооАдресРезультата;
		Параметры = КонтекстВыполнения.Параметры; // для передачи через входной параметры в ПоказатьРезультат
	КонецЕсли;	
КонецПроцедуры

Процедура ПоказатьРезультат(Форма,ТД,Параметры) Экспорт
	РезультатыКлиент_Ei.АктуализироватьСтраницуРезультата(Форма,ТД);
	ТД.ТекстВыполняемогоЗапроса = ""; //обунулим текст если он выполнялся до этого используется при выводе произвольной таблицы в динамический список
	РезультатыКлиент_Ei.Загрузить(Форма,ТД.ПолучитьИдентификатор(),Параметры);
КонецПроцедуры

Процедура ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
	ТекстМодуляКлиент_Ei.ПоказатьОшибкиКодов(Форма.Элементы.ОшибкаВыраженияТекст,ИнфоОбОшибке);
КонецПроцедуры

#КонецОбласти

Процедура ТекстПриИзменении(Форма,Элемент) Экспорт
	Форма.ВычислитьМодифицированность();
КонецПроцедуры

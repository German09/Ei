// Хранение истории запусков Ei в хранилище общих настроек пользователя:
// список последних запусков по ключу истории и снимки результатов отдельно по идентификатору запуска.
// Описание запуска и ключи см. ИсторияКлиентСервер_Ei
// Без @strict-types: значения из хранилища настроек и снимки результатов типизировать нечем.

#Область ПрограммныйИнтерфейс

// Записывает завершенный запуск варианта и сбрасывает текущий запуск в параметрах сеанса.
//
// Параметры:
//  Запуск - см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//  ОписаниеЗначения - ФиксированнаяСтруктура, Произвольный, Неопределено - результат варианта,
//                     см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
Процедура ЗавершитьЗапускВарианта(Знач Запуск, Знач ОписаниеЗначения) Экспорт
	
	ПараметрыСеанса.ЗапускВарианта_Ei = "";
	ЗаписатьЗапуск(Запуск, ЗначениеРезультата(ОписаниеЗначения), ОписаниеЗначения <> Неопределено);
	
КонецПроцедуры

// Записывает фоновый запуск варианта: при старте - выполняющимся, без результата, по завершении -
// с результатом или ошибкой на место выполняющегося с тем же идентификатором.
// Текущий запуск в параметрах сеанса не меняется: фоновый запуск идет в другом сеансе, см. ФоновоеВыполнениеСервер_Ei
//
// Параметры:
//  Запуск - см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//  ОписаниеЗначения - ФиксированнаяСтруктура, Произвольный, Неопределено - результат варианта,
//                     см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
Процедура ЗаписатьФоновыйЗапуск(Знач Запуск, Знач ОписаниеЗначения = Неопределено) Экспорт
	
	ЗаписатьЗапуск(Запуск, ЗначениеРезультата(ОписаниеЗначения), ОписаниеЗначения <> Неопределено);
	
КонецПроцедуры

// Начинает вычисление параметра как вложенный запуск: внешний запуск (варианта или другого параметра)
// берется из параметра сеанса ЗапускВарианта_Ei, а на время вычисления текущим становится сам параметр.
// Так параметр, вызванный из выражения другого параметра, попадает в историю как вложенный в него.
// После вычисления обязательно вызвать ЗавершитьЗапускПараметра, в том числе при ошибке.
//
// Возвращаемое значение:
//  Структура:
//   * Ид - Строка - идентификатор запуска параметра
//   * Родитель - Строка - внешний запуск или пустая строка
//   * Начало - Число - универсальное время начала в миллисекундах
//
Функция НачатьЗапускПараметра() Экспорт
	
	Начатый = Новый Структура("Ид, Родитель, Начало", Строка(Новый УникальныйИдентификатор),
		ПараметрыСеанса.ЗапускВарианта_Ei, ТекущаяУниверсальнаяДатаВМиллисекундах());
	ПараметрыСеанса.ЗапускВарианта_Ei = Начатый.Ид;
	
	Возврат Начатый;
	
КонецФункции

// Завершает вычисление параметра: возвращает внешний запуск в параметр сеанса и записывает запуск параметра.
// Ошибки записи не передаются наружу: история не должна мешать вычислению.
//
// Параметры:
//  Начатый - см. НачатьЗапускПараметра
//  КлючСтроки - УникальныйИдентификатор - КлючНастроек строки набора
//  ИмяПараметра - Строка
//  Свойства - ФиксированнаяСтруктура - свойства параметра, см. ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру
//  Значение - Произвольный - вычисленное значение
//  ИнформацияОбОшибке - Неопределено, ИнформацияОбОшибке - ошибка вычисления
//
Процедура ЗавершитьЗапускПараметра(Начатый, КлючСтроки, ИмяПараметра, Свойства, Значение, ИнформацияОбОшибке = Неопределено) Экспорт
	
	ПараметрыСеанса.ЗапускВарианта_Ei = Начатый.Родитель;
	
	Попытка
		Запуск = ИсторияКлиентСервер_Ei.НовыйЗапуск(Начатый.Ид,
			ИсторияКлиентСервер_Ei.КлючПараметра(КлючСтроки, ИмяПараметра), ИмяПараметра, Свойства.ЗначениеПараметра);
		Запуск.ЭтоВыражение = Свойства.ЭтоВыражение;
		Запуск.ЗапускВарианта = Начатый.Родитель;
		Запуск.Начало = Начатый.Начало;
		Запуск.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начатый.Начало;
		Если ИнформацияОбОшибке <> Неопределено Тогда
			Запуск.Статус = ИсторияКлиентСервер_Ei.СтатусыЗапуска().Ошибка;
			Запуск.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		КонецЕсли;
		ЗаписатьЗапуск(Запуск, Значение, ИнформацияОбОшибке = Неопределено, Не ЗначениеЗаполнено(Запуск.ЗапускВарианта));
	Исключение
		ЗаписьЖурналаРегистрации(ЖурналКлиентСервер_Ei.ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			"История: запуск параметра " + ИмяПараметра + " не записан" + Символы.ПС
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// Запуски по ключу истории, последние сначала. Запуски, записанные прежними версиями Ei,
// дополняются полями, которых в них еще не было.
//
// Параметры:
//  Ключ - Строка - см. ИсторияКлиентСервер_Ei.КлючВарианта
//
// Возвращаемое значение:
//  Массив из см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//
Функция Запуски(Знач Ключ) Экспорт
	
	Запуски = Новый Массив;
	Сохраненные = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаЗапусков(), Ключ);
	Если ТипЗнч(Сохраненные) = Тип("Массив") Тогда
		Для Каждого Сохраненный Из Сохраненные Цикл
			Если ТипЗнч(Сохраненный) = Тип("Структура") Тогда
				Запуск = ИсторияКлиентСервер_Ei.НовыйЗапуск("", Ключ, "", Неопределено);
				ЗаполнитьЗначенияСвойств(Запуск, Сохраненный);
				Запуски.Добавить(Запуск);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Запуски;
	
КонецФункции

// Запуски параметров строки, вычисленных внутри запуска: прямо в нем и во вложенных в него
// вычислениях параметров, когда один параметр вызывает другой.
//
// Параметры:
//  КлючСтроки - УникальныйИдентификатор - КлючНастроек строки набора
//  ИменаПараметров - Массив из Строка - параметры строки, среди которых искать
//  ИдЗапуска - Строка - запуск варианта или параметра
//
// Возвращаемое значение:
//  Массив из см. ИсторияКлиентСервер_Ei.НовыйЗапуск - не больше одного запуска на параметр
//
Функция ЗапускиПараметров(Знач КлючСтроки, Знач ИменаПараметров, Знач ИдЗапуска) Экспорт
	
	ЗапускиПоИмени = Новый Соответствие;
	Для Каждого ИмяПараметра Из ИменаПараметров Цикл
		ЗапускиПоИмени.Вставить(ИмяПараметра, Запуски(ИсторияКлиентСервер_Ei.КлючПараметра(КлючСтроки, ИмяПараметра)));
	КонецЦикла;
	
	Результат = Новый Массив;
	Найденные = Новый Соответствие;
	ВнешниеЗапуски = Новый Массив;
	ВнешниеЗапуски.Добавить(ИдЗапуска);
	
	Пока ВнешниеЗапуски.Количество() > 0 Цикл
		ВнешнийЗапуск = ВнешниеЗапуски.Получить(0);
		ВнешниеЗапуски.Удалить(0);
		Для Каждого ЭлементЗапусков Из ЗапускиПоИмени Цикл
			Если Найденные.Получить(ЭлементЗапусков.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Запуск Из ЭлементЗапусков.Значение Цикл
				Если Запуск.ЗапускВарианта = ВнешнийЗапуск Тогда
					Результат.Добавить(Запуск);
					Найденные.Вставить(ЭлементЗапусков.Ключ, Истина);
					ВнешниеЗапуски.Добавить(Запуск.Ид);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Восстанавливает сохраненный результат запуска в виде описания значения для панели результатов Ei.
//
// Параметры:
//  ИдЗапуска - Строка
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор формы для временного хранилища
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить;
//  Неопределено, если снимка нет
//
Функция ОписаниеРезультата(Знач ИдЗапуска, Знач УникальныйИдентификатор) Экспорт
	
	Описание = Неопределено;
	Снимок = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаСнимков(), ИдЗапуска);
	Если ТипЗнч(Снимок) = Тип("ХранилищеЗначения") Тогда
		Описание = ОписаниеЗначенияКлиентСервер_Ei.Подготовить(Снимок.Получить(), УникальныйИдентификатор);
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

// Достает значение результата по описанию: из временного хранилища, серверного кеша Ei или самого описания.
// Используется и для ответа на запрос MCP, см. ЗапросыMCPВызовСервера_Ei.ЗаписатьОтветЗапуска
//
// Параметры:
//  ОписаниеЗначения - Произвольный - описание значения или само значение
//
// Возвращаемое значение:
//  Произвольный
//
Функция ЗначениеРезультата(ОписаниеЗначения) Экспорт
	
	Значение = ОписаниеЗначения;
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ОписаниеЗначения) Тогда
		Ссылка = ОписаниеЗначения.Ссылка;
		Если ТипЗнч(Ссылка) = Тип("Строка") И ЭтоАдресВременногоХранилища(Ссылка) Тогда
			Значение = ПолучитьИзВременногоХранилища(Ссылка);
		ИначеЕсли ТипЗнч(Ссылка) = Тип("УникальныйИдентификатор") Тогда
			Значение = КэшПользователяКлиентСерверПовтИсп_Ei.Значения().Получить(Ссылка);
		Иначе
			Значение = ОписаниеЗначения.Значение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сохраняет снимок результата и добавляет запуск в начало списка по его ключу.
// Запуск с тем же идентификатором заменяется: так завершенный фоновый запуск встает на место выполняющегося.
// Запуски сверх лимита удаляются вместе со снимками.
//
// Параметры:
//  Запуск - см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//  Значение - Произвольный
//  ЕстьЗначение - Булево - запуск вернул результат, его нужно сохранить
//  ЗаменятьПовтор - Булево - запуск вместо добавления заменяет последний, если тот тоже отдельный
//                   и с той же инструкцией: повторные вычисления параметра без запуска варианта
//                   не вытесняют запуски, связанные с вариантами
//
Процедура ЗаписатьЗапуск(Запуск, Значение, ЕстьЗначение, ЗаменятьПовтор = Ложь)
	
	Запуск.Дата = ТекущаяДатаСеанса();
	Запуск.Завершен = Запуск.Статус <> ИсторияКлиентСервер_Ei.СтатусыЗапуска().Выполняется;
	
	Если ЕстьЗначение Тогда
		Снимок = СнимокЗначения(Значение, Запуск);
		Если Снимок <> Неопределено Тогда
			ХранилищеОбщихНастроек.Сохранить(КлючОбъектаСнимков(), Запуск.Ид, Снимок);
			Запуск.ЕстьСнимок = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Запуски = Запуски(Запуск.Ключ);
	Для Каждого Записанный Из Запуски Цикл
		Если Записанный.Ид = Запуск.Ид Тогда
			Запуски.Удалить(Запуски.Найти(Записанный));
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЗаменятьПовтор И Запуски.Количество() > 0 Тогда
		Последний = Запуски.Получить(0);
		Если Не ЗначениеЗаполнено(Последний.ЗапускВарианта)
			И Последний.ЭтоВыражение = Запуск.ЭтоВыражение
			И Последний.Инструкция = Запуск.Инструкция Тогда
			УдалитьСнимок(Последний);
			Запуски.Удалить(0);
		КонецЕсли;
	КонецЕсли;
	
	Запуски.Вставить(0, Запуск);
	Пока Запуски.Количество() > ИсторияКлиентСервер_Ei.КоличествоЗапусков() Цикл
		УдалитьСнимок(Запуски.Получить(Запуски.ВГраница()));
		Запуски.Удалить(Запуски.ВГраница());
	КонецЦикла;
	
	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаЗапусков(), Запуск.Ключ, Запуски);
	
КонецПроцедуры

// Параметры:
//  Запуск - см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//
Процедура УдалитьСнимок(Запуск)
	
	Если Запуск.ЕстьСнимок Тогда
		ХранилищеОбщихНастроек.Удалить(КлючОбъектаСнимков(), Запуск.Ид, ИмяПользователя());
	КонецЕсли;
	
КонецПроцедуры

// Готовит сжатый снимок значения. Не помещающаяся в лимит таблица сохраняется первыми строками,
// остальное большое или несериализуемое - только представлением в запуске.
//
// Параметры:
//  Значение - Произвольный
//  Запуск - см. ИсторияКлиентСервер_Ei.НовыйЗапуск - дополняется представлением и признаком усечения
//
// Возвращаемое значение:
//  ХранилищеЗначения, Неопределено
//
Функция СнимокЗначения(Знач Значение, Запуск)
	
	Если ТипЗнч(Значение) = Тип("РезультатЗапроса") Тогда
		Значение = Значение.Выгрузить();
	КонецЕсли;
	
	Попытка
		Запуск.ПредставлениеРезультата = Лев(ОписаниеЗначенияКлиентСервер_Ei.ПолучитьПредставление(Значение), 300);
	Исключение
		Запуск.ПредставлениеРезультата = Лев(Строка(ТипЗнч(Значение)), 300);
	КонецПопытки;
	
	Снимок = Неопределено;
	Попытка
		Хранилище = Новый ХранилищеЗначения(Значение, Новый СжатиеДанных(9));
		Если РазмерХранилища(Хранилище) <= ИсторияКлиентСервер_Ei.РазмерСнимка() Тогда
			Снимок = Хранилище;
		ИначеЕсли ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
			Хранилище = Новый ХранилищеЗначения(ПервыеСтроки(Значение), Новый СжатиеДанных(9));
			Если РазмерХранилища(Хранилище) <= ИсторияКлиентСервер_Ei.РазмерСнимка() Тогда
				Снимок = Хранилище;
				Запуск.СнимокУсечен = Истина;
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Значение не сериализуется: в истории останется только его представление.
		Снимок = Неопределено;
	КонецПопытки;
	
	Возврат Снимок;
	
КонецФункции

// Параметры:
//  Таблица - ТаблицаЗначений
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция ПервыеСтроки(Таблица)
	
	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если Строки.Количество() = СтрокУсеченногоСнимка() Тогда
			Прервать;
		КонецЕсли;
		Строки.Добавить(СтрокаТаблицы);
	КонецЦикла;
	
	Возврат Таблица.Скопировать(Строки);
	
КонецФункции

// Размер сжатых данных: внутреннее представление хранилища - это base64 сжатых данных.
//
// Параметры:
//  Хранилище - ХранилищеЗначения
//
// Возвращаемое значение:
//  Число - байт
//
Функция РазмерХранилища(Хранилище)
	
	Возврат СтрДлина(ЗначениеВСтрокуВнутр(Хранилище)) * 3 / 4;
	
КонецФункции

Функция СтрокУсеченногоСнимка()
	Возврат 1000;
КонецФункции

Функция КлючОбъектаЗапусков()
	Возврат "Ei.История";
КонецФункции

Функция КлючОбъектаСнимков()
	Возврат "Ei.ИсторияРезультаты";
КонецФункции

#КонецОбласти

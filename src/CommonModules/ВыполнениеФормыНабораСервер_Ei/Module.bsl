#Область ПрограммныйИнтерфейс



// Выполняет общую форму в ее текущем серверном вызове. Ссылка на форму
// удаляется из контекста до завершения вызова, в том числе при исключении.
// Никакие параметры или вложенные алгоритмы заранее не вычисляются.
//
// Параметры:
//  Форма - Произвольный - текущая общая форма внешней обработки
//  Отказ - Булево - отказ от создания формы после получения результата
Процедура ВыполнитьФорму(Форма, Отказ) Экспорт
	АдресРезультата = Неопределено;
	Если Не Форма.Параметры.Свойство("АдресРезультата", АдресРезультата) Тогда
		Возврат;
	КонецЕсли;
	КэшФорм = ОбщегоНазначенияПовтИсп_Ei.Формы();
	ПрежняяФорма = КэшФорм.Получить(КлючКонтекста());
	КэшФорм.Вставить(КлючКонтекста(), Форма);
	Попытка
		Значение = Форма.Результат();
		ИдентификаторФормыEi = Неопределено;
		Если Форма.Параметры.Свойство("ИдентификаторФормыEi", ИдентификаторФормыEi) Тогда
			Значение = ВыполнитьКлиентСервер_Ei.ПослеВычисленияЗначения(Значение, Неопределено, ИдентификаторФормыEi);
		КонецЕсли;
		ПоместитьВоВременноеХранилище(Значение, АдресРезультата);
	Исключение
		ВосстановитьФорму(КэшФорм, ПрежняяФорма);
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьФорму(КэшФорм, ПрежняяФорма);
	Отказ = Истина;
КонецПроцедуры

// Возвращает параметр клиентскому блоку через серверный вызов этой же формы.
//
// Параметры:
//  Форма - Произвольный - общая форма набора
//  Имя - Строка - имя параметра текущей строки
//
// Возвращаемое значение:
//  Произвольный
Функция ПараметрФормы(Форма, Имя) Экспорт
	КэшФорм = ОбщегоНазначенияПовтИсп_Ei.Формы();
	ПрежняяФорма = КэшФорм.Получить(КлючКонтекста());
	КэшФорм.Вставить(КлючКонтекста(), Форма);
	Попытка
		Результат = ВыполнитьКлиентСервер_Ei.Параметры(Имя);
	Исключение
		ВосстановитьФорму(КэшФорм, ПрежняяФорма);
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьФорму(КэшФорм, ПрежняяФорма);
	Возврат Результат;
КонецФункции

// Перенаправляет вложенное выражение в скомпилированную функцию текущей формы.
// Если форма активна, отсутствие блока считается ошибкой, динамического
// выполнения или повторного запуска алгоритма не происходит.
//
// Параметры:
//  Код - Строка - код Ei
//  ИдентификаторФормы - УникальныйИдентификатор, Неопределено - форма владельца результата
//  ОписаниеТипов - Произвольный - приведение результата
//  Обработано - Булево - выходной признак текущего выполнения через общую форму
//
// Возвращаемое значение:
//  Произвольный - значение в том же формате, что у обычного выполнения Ei
Функция ВыполнитьВыражение(Код, ИдентификаторФормы, ОписаниеТипов, Обработано) Экспорт
	Форма = ОбщегоНазначенияПовтИсп_Ei.Формы().Получить(КлючКонтекста());
	Обработано = Форма <> Неопределено;
	Результат = Неопределено;
	Если Обработано Тогда
		Значение = Форма.ВыполнитьКодEi(КодНабораКлиентСервер_Ei.КлючКода(Код));
		Результат = ВыполнитьКлиентСервер_Ei.ПослеВычисленияЗначения(Значение, ОписаниеТипов, ИдентификаторФормы);
		Если ОбщегоНазначенияВызовСервера_Ei.ЭтоАдресКешаЗначений(Результат) Тогда
			Результат = ОбщегоНазначенияВызовСервера_Ei.ПодготовитьОписаниеЗначенияВызовСервера(
				Результат, Новый УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлючКонтекста()
	Возврат "Ei.ТекущаяОбщаяФорма";
КонецФункции

Процедура ВосстановитьФорму(КэшФорм, ПрежняяФорма)
	Если ПрежняяФорма = Неопределено Тогда
		КэшФорм.Удалить(КлючКонтекста());
	Иначе
		КэшФорм.Вставить(КлючКонтекста(), ПрежняяФорма);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

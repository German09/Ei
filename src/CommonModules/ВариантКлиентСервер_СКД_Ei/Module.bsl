#Область ИнтерфейсВариантов

Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",		ВариантыКлиентСерверПовторноеИспользование_Ei.ИмяЭлементаСКД());
	Результат.Вставить("Синоним",	"СКД");
	Результат.Вставить("Картинка",	БиблиотекаКартинок.СКД_Ei);
	Возврат Результат;
КонецФункции

Функция ВыполнитьВариант(Форма,УникальныйИдентификатор,ТД,Параметры,ДопПараметры,ОбработчикРезультата = Неопределено) Экспорт
	Перем ОписаниеЗначения,СтрРасшифровки;
	ТекстСКД =  ПолучитьТекстСКД(Форма, ТД);	
	Если ЗначениеЗаполнено(ТекстСКД) Тогда
		ДопПараметры.Свойство("СтрРасшифровки",СтрРасшифровки);
		ПараметрыКлиентСервер_Ei.УточнитьПараметры(ТД, УникальныйИдентификатор, Параметры);					
		Если ОбработчикРезультата =  Неопределено ИЛИ  
			 ОбработчикРезультата.ПереопределитьВыполнение(Форма,УникальныйИдентификатор,ТД,Параметры,ДопПараметры,ВариантКлиентСервер_СКД_Ei,ОписаниеЗначения) Тогда
			ОписаниеЗначения		= ВыполнитьКлиентСервер_Ei.СКД(ТекстСКД,Параметры,УникальныйИдентификатор,,СтрРасшифровки);
		КонецЕсли;	
	КонецЕсли;
	Возврат ОписаниеЗначения;	
КонецФункции	

// Подготовить данные для помещения их в параметры сеанса Варианты_Ei
// 
// Параметры:
//  Форма Форма конструктора
//  Строка Строка дерева вариантов
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Подготовить данные:
// * Инструкция 
Функция ПодготовитьДанные(Форма, Строка) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Инструкция",Строка.ТекстСКД);
	Возврат Новый ФиксированнаяСтруктура(Результат);		
КонецФункции

#Если Клиент Тогда

Функция ПолучитьРазмерность(Форма,ТД) Экспорт
	ТекстЗапроса = ПолучитьТекстСКД(Форма, ТД);
	Возврат ТекстМодуляКлиент_Ei.ПолучитьЧислоСтрок(ТекстЗапроса)
КонецФункции
	
Процедура Инициализировать(Форма, Контейнер) Экспорт
	ВариантКлиент_СКД_Ei.Инициализировать(Форма, Контейнер);
КонецПроцедуры

Процедура ПриИзмененииДанных(Форма) Экспорт
	ВариантКлиент_СКД_Ei.ПриИзмененииДанных(Форма);
Конецпроцедуры

Процедура ПриОтображении(Форма) Экспорт
	ВариантКлиент_СКД_Ei.ПриОтображении(Форма);	
Конецпроцедуры

Процедура ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ВариантКлиент_СКД_Ei.ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке);
КонецПроцедуры

Процедура УстановитьПараметры(Форма) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если НЕ ТД = Неопределено Тогда
		мПараметров = ВариантВызовСервера_СКД_Ei.ПолучитьПараметры(ПолучитьТекстСКД(Форма, ТД));		
		ПараметрыКлиент_Ei.ВставитьПараметры(ТД, мПараметров);	
	КонецЕсли;			
КонецПроцедуры

Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ВариантКлиент_СКД_Ei.РасшифровкаОшибки(Форма,Элемент);			
КонецПроцедуры	

#КонецЕсли

#КонецОбласти

 Функция ПолучитьТекстСКД(Форма, ТД) Экспорт
 	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ТД,"Инструкции") Тогда
		//такая структура данных специфична для вызова из обработки выполнения
		Возврат ТД.Инструкции.СКД;	
	Иначе
		#Если Клиент Тогда
			//получим текст алгорима это при интерактивном выполненнии
			Возврат ВариантыКлиент_Ei.ПолучитьТекстДляВыполнения(Форма,ТД,"ТекстСКД");
		#КонецЕсли	
	КонецЕсли;		
 КонецФункции	

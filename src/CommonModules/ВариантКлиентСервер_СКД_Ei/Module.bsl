#Область ИнтерфейсВариантов

Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",		ВариантыКлиентСерверПовторноеИспользование_Ei.ИмяЭлементаСКД());
	Результат.Вставить("Синоним",	"СКД");
	Результат.Вставить("Картинка",	Новый Картинка);
	Возврат Результат;
КонецФункции

Функция ВыполнитьВариант(Форма,УникальныйИдентификатор,ТД,Параметры,ДопПараметры,ОбработчикРезультата = Неопределено) Экспорт
	Перем ОписаниеЗначения;
	ТекстСКД =  ПолучитьТекстСКД(Форма, ТД, ДопПараметры);	
	Если ЗначениеЗаполнено(ТекстСКД) Тогда
		СтрРасшифровки = Неопределено;// нужно задать					
		Если ОбработчикРезультата =  Неопределено ИЛИ  
			 ОбработчикРезультата.ПереопределитьВыполнение(Форма,УникальныйИдентификатор,ТД,Параметры,ДопПараметры,ВариантКлиентСервер_СКД_Ei,ОписаниеЗначения) Тогда
			ОписаниеЗначения		= ОбщийМодульВызовСервера_Ei.__ВыполнитьСКД(ТекстСКД,Параметры,УникальныйИдентификатор,,СтрРасшифровки);
		КонецЕсли;	
	КонецЕсли;
	Возврат ОписаниеЗначения;	
КонецФункции	

#Если Клиент Тогда

Процедура Инициализировать(Форма, Контейнер) Экспорт
	ВариантКлиент_СКД_Ei.Инициализировать(Форма, Контейнер);
КонецПроцедуры

Процедура ПриИзмененииДанных(Форма) Экспорт
	ВариантКлиент_СКД_Ei.ПриИзмененииДанных(Форма);
Конецпроцедуры

Процедура ПриОтображении(Форма) Экспорт
	ВариантКлиент_СКД_Ei.ПриОтображении(Форма);	
Конецпроцедуры

Процедура ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ВариантКлиент_СКД_Ei.ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке);
КонецПроцедуры

Процедура УстановитьПараметры(Форма) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если НЕ ТД = Неопределено Тогда
		ВариантВызовСервера_СКД_Ei.УстановитьПараметры(Форма,ТД.ПолучитьИдентификатор());
	КонецЕсли;			
КонецПроцедуры	

#КонецЕсли

#КонецОбласти

 Функция ПолучитьТекстСКД(Форма, ТД, ДопПараметры) Экспорт
 	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ТД,"Инструкции") Тогда
		//такая структура данных специфична для вызова из обработки выполнения
		Возврат ТД.Инструкции.СКД;	
	Иначе
		#Если Клиент Тогда
			//получим текст алгорима это при интерактивном выполненнии
			Возврат ВариантыКлиент_Ei.ПолучитьТекстДляВыполнения(Форма,ТД,"ТекстСКД");
		#КонецЕсли	
	КонецЕсли;		
 КонецФункции	

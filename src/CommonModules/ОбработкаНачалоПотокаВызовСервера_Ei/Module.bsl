// Функция - Запускает фоновое задание
//
// Параметры:
//  мНаправления	 		- Массив					- Представление маршрута (имя соединительной линии)
//	НастройкиОбработок		- СписокЗначений	 		- Последовательность подготовленных Дополнительных параметров ОписанийОповещений
//  Контекст		 - Структура		 			- Структура контекста выполнения 
//													Параметры
//													ЭтаФорма
//													Объект
// 
// Возвращаемое значение:
//   - ФиксированнаяСтруктура  
//		* Идентификатор - Строка 					- Идентифкатор запущенного фонового задания.
//		* Ключ 			- УникальныйИдентификатор 	- Ключ фонового задания по кторому можно получить промежуточный результат через хранилище системных настроек	
//
Функция ЗапуститьПоток(мНаправления, НастройкиОбработок, ДанныеКлиента) Экспорт
	ИмяНабора 		= НаборВариантовВызовСервера_Ei.ПолучитьТекущийНабор();
	АдресРезультата	= ПоместитьВоВременноеХранилище(Неопределено);
	Если мНаправления.Количество() Тогда
		Наименование 		= мНаправления[0].Условие;
		ПолноеНаименование 	= ИмяНабора + " - " + Наименование;
	КонецЕсли;	 	
	Результат 		= Новый Структура;
	Результат.Вставить("Наименование",			Наименование);
	Результат.Вставить("Ключ",					АдресРезультата); 
		//запускаем
		мПараметров = Новый Массив;
		мПараметров.Добавить(АдресРезультата);
		мПараметров.Добавить(мНаправления);
		мПараметров.Добавить(НастройкиОбработок);
			мОбъекты = ОбъектыСервер_Ei.ПолучитьВсе(); //получим явные значения, по другомы мы никак их не передадим
		мПараметров.Добавить(мОбъекты);
		мПараметров.Добавить(НаборВариантовВызовСервера_Ei.Получить());
		мПараметров.Добавить(ИмяНабора);
		ФЗ = ФоновыеЗадания.Выполнить("ОбработкаНачалоПотокаВызовСервера_Ei.ВыполнитьПоток",мПараметров,АдресРезультата,"Выполнение фонового потока по маршруту "+ПолноеНаименование+"->");
	Результат.Вставить("Идентификатор", ФЗ.УникальныйИдентификатор);
	Возврат Новый ФиксированнаяСтруктура(Результат);
КонецФункции

Процедура ВыполнитьПоток(АдресРезультата, мНаправления, НастройкиОбработок, мОбъекты, НаборВариантов_Ei, Набор_Ei) Экспорт
	ДанныеКлиента 	=  	Новый Соответствие();
	ИндексНовых		=	мОбъекты.Вграница()+1;
	НаборВариантовВызовСервера_Ei.Обновить(НаборВариантов_Ei);
	НаборВариантовВызовСервера_Ei.УстановитьТекущийНабор(Набор_Ei);
	ОбъектыСервер_Ei.Преобразовать(мОбъекты); //Преобразуем массив из явных значений в ОписаниеЗначений	
	Результат 	= ПроцессыКлиентСервер_Ei.ВыполнитьПоток(Новый УникальныйИдентификатор(), мНаправления, НастройкиОбработок, ДанныеКлиента, мОбъекты, Неопределено);
	ХранилищеСистемныхНастроек.Сохранить(ОбщегоНазначенияКлиентСервер_Ei.Постфикс(), АдресРезультата, ДанныеКлиента);
	//вернем результаты всех обработок за исключением ранее присутствующих
	мОбъекты = ОбъектыСервер_Ei.ПолучитьВсе(ИндексНовых);			
	ПоместитьВоВременноеХранилище(мОбъекты, АдресРезультата); //#1 
КонецПроцедуры 
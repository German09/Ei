#Область ПрограммныйИнтерфейс

// Запускает фоновое задание выполнения потока процесса.
//
// Параметры:
//  Направления			- см. ПроцессыВызовСервера_Ei.ПолучитьМассивНаправления
//  НастройкиОбработок	- см. ОбработкиКлиентСервер_Ei.ПолучитьДанныеОбработок
//  ДанныеКлиента		- Соответствие из КлючИЗначение - данные для клиента, при запуске потока не используются
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура:
//   * Наименование 	- Строка - условие первого направления потока
//   * Ключ 			- Строка - адрес во временном хранилище для результата фонового задания,
//                                 он же ключ данных клиента в хранилище системных настроек
//   * Идентификатор 	- УникальныйИдентификатор - идентификатор запущенного фонового задания
//
Функция ЗапуститьПоток(Направления, НастройкиОбработок, ДанныеКлиента) Экспорт
	ИмяНабора 			= НаборВариантовВызовСервера_Ei.ПолучитьТекущийНабор();
	АдресРезультата		= ПоместитьВоВременноеХранилище(Неопределено);
	Наименование 		= "";
	ПолноеНаименование 	= ИмяНабора;
	Если Направления.Количество() Тогда
		Наименование 		= Направления[0].Условие;
		ПолноеНаименование 	= ИмяНабора + " - " + Наименование;
	КонецЕсли;	 	
	Результат 		= Новый Структура;
	Результат.Вставить("Наименование",	Наименование);
	Результат.Вставить("Ключ",			АдресРезультата); 
	//запускаем
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(АдресРезультата);
	ПараметрыЗадания.Добавить(Направления);
	ПараметрыЗадания.Добавить(НастройкиОбработок);
	Объекты = ОбъектыСервер_Ei.ПолучитьВсе(); //получим явные значения, по другомы мы никак их не передадим
	ПараметрыЗадания.Добавить(Объекты);
	ПараметрыЗадания.Добавить(НаборВариантовВызовСервера_Ei.Получить());
	ПараметрыЗадания.Добавить(ИмяНабора);
	ФоновоеЗадание = ФоновыеЗадания.Выполнить("ОбработкаНачалоПотокаВызовСервера_Ei.ВыполнитьПоток",ПараметрыЗадания,АдресРезультата,"Выполнение фонового потока по маршруту "+ПолноеНаименование+"->");
	Результат.Вставить("Идентификатор", ФоновоеЗадание.УникальныйИдентификатор);
	Возврат Новый ФиксированнаяСтруктура(Результат);
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Выполняет поток процесса в фоновом задании, запускается из см. ЗапуститьПоток
//
// Параметры:
//  АдресРезультата		- Строка - адрес во временном хранилище для объектов, полученных потоком
//  Направления			- см. ПроцессыВызовСервера_Ei.ПолучитьМассивНаправления
//  НастройкиОбработок	- см. ОбработкиКлиентСервер_Ei.ПолучитьДанныеОбработок
//  Объекты				- Массив из Структура - объекты процесса сеанса запуска, см. ОбъектыСервер_Ei.ПолучитьВсе
//  НаборВариантов		- см. НаборВариантовВызовСервера_Ei.Получить
//  ИмяНабора			- Строка - имя текущего набора сеанса запуска
//
Процедура ВыполнитьПоток(АдресРезультата, Направления, НастройкиОбработок, Объекты, НаборВариантов, ИмяНабора) Экспорт
	ДанныеКлиента 	=  	Новый Соответствие();
	ИндексНовых		=	Объекты.Вграница()+1;
	НаборВариантовВызовСервера_Ei.Обновить(НаборВариантов);
	НаборВариантовВызовСервера_Ei.УстановитьТекущийНабор(ИмяНабора);
	ОбъектыСервер_Ei.Преобразовать(Объекты); //Преобразуем массив из явных значений в ОписаниеЗначений	
	ПроцессыКлиентСервер_Ei.ВыполнитьПоток(Новый УникальныйИдентификатор(), Направления, НастройкиОбработок, ДанныеКлиента, Объекты, Неопределено);
	ХранилищеСистемныхНастроек.Сохранить(ОбщегоНазначенияКлиентСервер_Ei.Постфикс(), АдресРезультата, ДанныеКлиента);
	//вернем результаты всех обработок за исключением ранее присутствующих
	НовыеОбъекты = ОбъектыСервер_Ei.ПолучитьВсе(ИндексНовых);			
	ПоместитьВоВременноеХранилище(НовыеОбъекты, АдресРезультата); //#1 
КонецПроцедуры 

#КонецОбласти

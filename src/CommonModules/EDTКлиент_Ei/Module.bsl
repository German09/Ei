// Прочитать состав обработки.
// 
// Параметры:
//  Каталог 		- Строка 
//  ИмяПроекта		- Строка
//  СсылкиНаФайлы	- Структура - возвращаемый параметр
//  СообщатьОбОтсутствии - Булево - показать предупреждение, если исходный .mdo не найден
// 
// Возвращаемое значение:
//  Структура - см. ВариантыКлиент_Ei.ПолучитьСтруктуруВариантов
Асинх Функция ПрочитатьСоставОбработки(Каталог,ИмяПроекта,СсылкиНаФайлы, СообщатьОбОтсутствии = Истина) Экспорт
	Перем Результат;
	ФайлОбработки = Новый Файл(Каталог+СтрШаблон("%4%3%4%1s%4%2%4%2.mdo",ВнешОбработка(),ИмяПроекта,ФайлыКлиентСервер_Ei.КаталогИсходников(),ПолучитьРазделительПути()));
	Если Ждать ФайлОбработки.СуществуетАсинх() Тогда
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьФайл(ФайлОбработки.ПолноеИмя);
		Объект 		= ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
		СооКлючей	= Новый Соответствие; //вспомогательное соответсвие для поиска по идентифкатору
		Результат 	= ПолучитьВаринаты(сооКлючей, Объект);
		ПутьОбщейФормы = "";
		СнимокОбщейФормы = Неопределено;
		Для Каждого ОписаниеОбъекта Из ОбъектыОбработки(ФайлОбработки.ПолноеИмя) Цикл
			Если ОписаниеОбъекта.Комментарий = ФормаНабораКлиент_Ei.ИмяФормы() Тогда
				ПутьОбщейФормы = ОписаниеОбъекта.ПолноеИмя;
				СнимокОбщейФормы = ФормаНабораКлиент_Ei.ПрочитатьСтроки(ПутьОбщейФормы, Результат);
				Для Каждого СтрокаОбщейФормы Из Результат Цикл
					СооКлючей.Вставить(СтрокаОбщейФормы.Значение.КлючНастроек, СтрокаОбщейФормы.Ключ);
				КонецЦикла;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Части		= Новый Массив; //части вариантов из нескольких файлов, см. КомментарийЧасти
		//заполнили пути ко всем вложенным файлам
		Для Каждого Тип ИЗ ТипыМетаданных() Цикл
			Если Не Объект.Свойства().Получить(Тип.Значение) = Неопределено Тогда
				Если Не Объект.Свойства().Получить(Тип.Значение) = Неопределено Тогда
					Для Каждого Элемент ИЗ ЭлементыКоллекцииXDTO(Объект, Тип.Значение) Цикл 
						Родитель=""; //Строка
						Если Не Элемент.Свойства().Получить("comment") = Неопределено Тогда
							Родитель = Элемент.comment;
						КонецЕсли;	 
						Если Родитель = ФормаНабораКлиент_Ei.ИмяФормы() Тогда
							Продолжить;
						ИначеЕсли Родитель = ПараметрыКлиент_Ei.ПризнакВКомментраии() Тогда
							ПараметрыКлиент_Ei.ПрочитатьОбъект(Элемент, Результат, Объект, СооКлючей, Тип.Значение);
						ИначеЕсли ВладелецЧасти(Родитель) <> Неопределено Тогда
							Части.Добавить(Новый Структура("Элемент,Тип", Элемент, Тип.Значение));
						ИначеЕсли ЭтоОбъектНабора(Строка(Элемент.uuid), Родитель) Тогда
							ВариантыКлиент_Ei.ПрочитатьОбъект(Элемент, Результат, Объект, СооКлючей, Тип.Значение);			
						КонецЕсли;				
					КонецЦикла;
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;
		//прочитаем все вложенные файлы и заполним список файлов в каждом наборе
		Для Каждого Набор ИЗ Результат Цикл
			мСостава 	= Новый Массив;	
			СсылкиНаФайлы.Вставить(Набор.Значение.Имя,мСостава);						
			//варинаты
			Для Каждого СтрВаринат ИЗ Набор.Значение.Данные Цикл
				Путь 	= Неопределено;
				Если СтрВаринат.Значение.Свойство("Путь",Путь) Тогда					
					//свойство пути указано, значит файл нужно считать
					мСостава.Добавить(ВариантыКлиент_Ei.ПрочитатьЗначение(Набор.Значение.Данные,СтрВаринат,Каталог,ИмяПроекта,Путь,Набор.Значение.КлючНастроек));
				КонецЕсли;				
			КонецЦикла;	
			//параметры
			Для Каждого СтрПараметр ИЗ Набор.Значение.Параметры Цикл
				Путь 	= Неопределено;
				Если СтрПараметр.Значение.Свойство("Путь",Путь) Тогда
					//свойство пути указано, значит файл нужно считать
					Ключ = Строка(ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(Набор.Значение.КлючНастроек,СтрПараметр.Значение.Ключ));
					мСостава.Добавить(ПараметрыКлиент_Ei.ПрочитатьЗначение(СтрПараметр.Значение,Каталог,ИмяПроекта,Путь,Ключ));
				КонецЕсли;			
			КонецЦикла			
		КонецЦикла;	 		 
		Ждать ДобавитьСсылкиНаЧасти(Части, СсылкиНаФайлы, Объект, СооКлючей, Каталог, ИмяПроекта);
		Если СнимокОбщейФормы <> Неопределено Тогда
			ФормаНабораКлиент_Ei.Прочитать(ПутьОбщейФормы, Результат, СсылкиНаФайлы, СнимокОбщейФормы);
		КонецЕсли;
	ИначеЕсли СообщатьОбОтсутствии Тогда
		ПоказатьПредупреждение(,СтрШаблон("В каталоге %1 не найден файл %2",ФайлОбработки.Путь,ФайлОбработки.Имя));		
	КонецЕсли;
	Возврат Результат;		
КонецФункции	




// Получить путь.
// 
// Параметры:
//	Тип			- Строка - Имя типа метаданных см. ТипыМетаданных
//  Элемент 	- ОбъектXDTO -
// 
// Возвращаемое значение:
//  Строка -  Получить путь
Функция ПолучитьПуть(Тип, Элемент) Экспорт
	Перем ФайлМакета;
	Пути = Новый Массив;
	Пути.Добавить(Тип);
	Пути.Добавить(Элемент.name);
	ТипМакета = Элемент.Свойства().Получить("templateType");
	Если ТипМакета = Неопределено Тогда
		Пути.Добавить(ИмяМодуля());
	Иначе
		Если ТипыМакетов().Свойство(Элемент.templateType,ФайлМакета) Тогда	
			Пути.Добавить(ФайлМакета);
		Иначе
			Пути.Добавить(ТипыМакетов().TextDocument);	
		КонецЕсли;			
	КонецЕсли;			
	Возврат СтрСоединить(Пути,"\");
КонецФункции


// Получить имя проекта.
// 
// Параметры:
//  Каталог - Строка - Каталог
// 
// Возвращаемое значение:
//  Обещание, Строка - Имя проекта
Асинх Функция ПолучитьИмяПроекта(Каталог) Экспорт
	Результат = "";
	ФайлПроекта = Новый Файл(Каталог+"\"+ИмяГлФайлаПроекта());
	Если Ждать ФайлПроекта.СуществуетАсинх() Тогда
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьФайл(ФайлПроекта.ПолноеИмя);
		Объект 		= ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
		Результат 	= Объект.Name;	
	Иначе
		ПоказатьПредупреждение(,СтрШаблон("В каталоге %1 не найден файл %2",Каталог,ИмяГлФайлаПроекта()));		
	КонецЕсли;
	Возврат Результат;			
КонецФункции

#КонецОбласти

// Прочитать состав обработки.
// 
// Параметры:
//  Каталог 	- Строка 
//  ИмяПроекта	- Строка
// 
// Возвращаемое значение:
//  Структура - см. ВариантыКлиент_Ei.Получить
Асинх Функция ПрочитатьСоставОбработки(Каталог,ИмяПроекта) Экспорт
	Перем Результат;
	ФайлОбработки = Новый Файл(Каталог+СтрШаблон("\src\%1s\%2\%2.mdo",ВнешОбработка(),ИмяПроекта));
	Если Ждать ФайлОбработки.СуществуетАсинх() Тогда
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьФайл(ФайлОбработки.ПолноеИмя);
		Объект 		= ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
		СооКлючей	= Новый Соответствие; //вспомогательное соответсвие для поиска по идентифкатору
		Результат 	= ПолучитьВаринаты(сооКлючей, Объект);
		//заполнили пути ко всем вложенным файлам
		Для Каждого Тип ИЗ ТипыМетаданных() Цикл
			Если Не Объект.Свойства().Получить(Тип.Значение) = Неопределено Тогда
				Если Не Объект.Свойства().Получить(Тип.Значение) = Неопределено Тогда
					Для Каждого Элемент ИЗ Объект[Тип.Значение] Цикл 
						Родитель=""; //Строка
						Если Не Элемент.Свойства().Получить("comment") = Неопределено Тогда
							Родитель = Элемент.comment;
						КонецЕсли;	 
						Если Родитель = ПараметрыКлиент_Ei.ПризнакВКомментраии() Тогда
							ПараметрыКлиент_Ei.ПрочитатьОбъект(Элемент, Результат, Объект, СооКлючей, Тип.Значение);
						Иначе
							ВариантыКлиент_Ei.ПрочитатьОбъект(Элемент, Результат, Объект, СооКлючей, Тип.Значение);			
						КонецЕсли;				
					КонецЦикла;
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;
		//прочитаем все вложенные файлы и заполним список файлов в каждом наборе
		Для Каждого Набор ИЗ Результат Цикл
			//варинаты
			Для Каждого СтрВаринат ИЗ Набор.Значение.Данные Цикл
				Вариант = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(СтрВаринат.Ключ);
				Путь 	= Неопределено;
				Если СтрВаринат.Значение.Свойство("Путь",Путь) Тогда
					//свойство пути указано, значит файл нужно считать
					Если Не Вариант = Неопределено Тогда
						Набор.Значение.Данные.Вставить(СтрВаринат.Ключ,Вариант.Прочитать(СтрШаблон("%1\src\%2s\%3\%4",Каталог,ВнешОбработка(),ИмяПроекта,Путь)));
					КонецЕсли;
				КонецЕсли;				
			КонецЦикла;	
			//параметры
			Для Каждого СтрПараметр ИЗ Набор.Значение.Параметры Цикл
				Путь 	= Неопределено;
				Если СтрПараметр.Свойство("Путь",Путь) Тогда
					//свойство пути указано, значит файл нужно считать
					ПараметрыКлиент_Ei.ПрочитатьЗначение(СтрПараметр,СтрШаблон("%1\src\%2s\%3\%4",Каталог,ВнешОбработка(),ИмяПроекта,Путь));
				КонецЕсли;			
			КонецЦикла			
		КонецЦикла;	
		//Нужно заполмнить ссылки на считанные файлы см. НаборВариантовКлиент_Ei.ЗапомнитьСсылкиНаФайлы 		 
	Иначе
		ПоказатьПредупреждение(,СтрШаблон("В каталоге %1 не найден файл %2",ФайлОбработки.Путь,ФайлОбработки.Имя));		
	КонецЕсли;
	Возврат Результат;		
КонецФункции	

// Получаем варинты без параметров
// 
// Параметры:
//  сооКлючей 		- Соответствие из КлючИЗначение:
//		*Ключ 		- УникальныйИдентификатор - Ключ найстройки 
//		*Значение 	- Строка - Имя варианта
//  Объект 			- ОбъектXDTO -
// 
// Возвращаемое значение:
//  Структура - см. ВариантыКлиент_Ei.Получить
Функция ПолучитьВаринаты(сооКлючей, Объект)
	Результат 	= Новый Структура;	
	Для Каждого Тип ИЗ ТипыМетаданных() Цикл
		Если Не Объект.Свойства().Получить(Тип.Значение) = Неопределено Тогда 
			Для Каждого Элемент ИЗ Объект[Тип.Значение] Цикл 
				ПрочитатьВариант(Элемент, Результат, Объект, сооКлючей);		
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;
	//Заменим идентификатор родителя на имя
	Для Каждого КлючЗначение ИЗ Результат Цикл
		Вложенная 	= КлючЗначение.Значение;
		Попытка
			КлючВарианта = Новый УникальныйИдентификатор(Вложенная.Родитель);
		Исключение
			//в комментарии не уникальный идентифкатор
			КлючВарианта = Неопределено;		 
		КонецПопытки;			 
		Вложенная.Вставить("Родитель",сооКлючей.Получить(КлючВарианта));	
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Прочитать элемент коллекции.
// 
// Параметры:
//  Каталог			- Строка
//  Элемент 		- ОбъектXDTO - 
//  НаборВаринатов 	- Структура Из см. ВариантыКлиентСервер_Ei.ПолучитьВариант
//  Объект 			- ОбъектXDTO - 
//  сооКлючей 		- Соответствие из КлючИЗначение:
//		*Ключ 		- УникальныйИдентификатор - Ключ найстройки 
//		*Значение 	- Строка - Имя варианта
Асинх Процедура ПрочитатьВариант(Элемент, НаборВаринатов, Объект, сооКлючей)
	Перем Родитель;
	стрВариант = Новый Структура; // см. ВариантыКлиентСервер_Ei.ПолучитьВариант
	Если Не Элемент.Свойства().Получить("comment") = Неопределено Тогда
		Родитель = Элемент.comment;
	КонецЕсли;	 
	Если Родитель = ПараметрыКлиент_Ei.ПризнакВКомментраии() Тогда
		//это параметр его обрабатываем в см. ПолучитьПараметры	
	Иначе	 
		стрВариант.Вставить("КлючНастроек",	ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(Элемент.uuid,Объект.uuid));
		стрВариант.Вставить("Имя",			Элемент.synonym.value);
		стрВариант.Вставить("Родитель",		Родитель);
		стрВариант.Вставить("Параметры",	Новый Структура);
		стрВариант.Вставить("Данные",		Новый Структура);
		НаборВаринатов.Вставить(стрВариант.Имя,стрВариант);
		сооКлючей.Вставить(стрВариант.КлючНастроек, стрВариант.Имя);
	КонецЕсли;	
КонецПроцедуры


// Получить путь.
// 
// Параметры:
//	Тип			- Строка - Имя типа метаданных см.ТипыМетаданных
//  Элемент 	- ОбъектXDTO -
// 
// Возвращаемое значение:
//  Строка -  Получить путь
Функция ПолучитьПуть(Тип, Элемент) Экспорт
	Перем ФайлМакета;
	мПуть = Новый Массив;
	мПуть.Добавить(Тип);
	мПуть.Добавить(Элемент.name);
	ТипМакета = Элемент.Свойства().Получить("templateType");
	Если ТипМакета = Неопределено Тогда
		мПуть.Добавить(ИмяМоудля());
	Иначе
		Если ТипыМакетов().Свойство(Элемент.templateType,ФайлМакета) Тогда	
			мПуть.Добавить(ФайлМакета);
		Иначе
			мПуть.Добавить(ТипыМакетов().TextDocument);	
		КонецЕсли;			
	КонецЕсли;			
	Возврат СтрСоединить(мПуть,"\");
КонецФункции

#КонецОбласти



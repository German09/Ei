Асинх Функция ПолучитьСвойстваОпределениеПроекта(Каталог) Экспорт
	Результат = Новый Соответствие();
	Если ЗначениеЗаполнено(Каталог) Тогда
		ФайлПроекта = Новый Файл(СтрШаблон("%1\%2\%3",Каталог,ОпределениеПроекта().Каталог,ОпределениеПроекта().ИмяФайла));
		Если Ждать ФайлПроекта.СуществуетАсинх() Тогда
			Текст = ФайлыКлиент_Ei.ПрочитатьТекст(ФайлПроекта.ПолноеИмя);
			Для Каждого ЗначениеПредставление ИЗ РазобратьСвойства(Текст) Цикл
				Результат.Вставить(ЗначениеПредставление.Представление,ЗначениеПредставление.Значение);		
			КонецЦикла;			
		КонецЕсли;
	КонецЕсли;	
	Возврат Результат;			

		ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст("ПриОткрытии");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЕсли;

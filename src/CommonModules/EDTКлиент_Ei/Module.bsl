	ЗаписьXML.ЗаписатьАтрибут("xmlns:mdclassExtension",	"http://g5.1c.ru/v8/dt/metadata/mdclass/extension");
	СоздатьЗаголовокМетаданных(ЗаписьXML, Ключ, Имя, Имя);

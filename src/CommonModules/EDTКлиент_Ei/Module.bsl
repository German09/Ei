// Создать макет обработки
// 
// Параметры:
//  Путь 		- Строка
//  Содержание 	- Строка
//  Имя 		- Строка
//  Ключ 		- Строка
//  ТипМакета 	- Строка - см. ТипыМакетов
//  Синоним 	- Неопределено - Синоним
// 
// Возвращаемое значение:
//  см.  ЗаписатьМакет
Асинх Функция СоздатьМакетОбработки(Путь, Содержание, Имя, Ключ, ТипМакета, Синоним = Неопределено) Экспорт
	КаталогМакетов 	= Ждать СоздатьКаталогАсинх(СтрШаблон("%1\%2",Путь,ТипыМетаданных().Макеты));
	Каталог 		= Ждать СоздатьКаталогАсинх(СтрШаблон("%1\%2",КаталогМакетов,Имя));
	Возврат ЗаписатьМакет(Каталог, Содержание, ТипМакета);
КонецФункции


// Записать состав обработки.
// 
// Параметры:
//  ЗаписьXML 		- ЗаписьXML - Метаданные обработки
//  СтрРезультат 	см. ФайлыКлиент_Ei.РезультатСохранения
//	СтрНаборов 		см. ВариантыКлиентСервер_Ei.ПолучитьВариант  
//
Процедура ЗаписатьСоставОбработки(ЗаписьXML,СтрРезультат,СтрНаборов) Экспорт
	Перем Набор, НаборРодитель;
	Для Каждого Набор ИЗ СтрРезультат Цикл
		Состав = Набор.Значение;
		Для Каждого СтрСохранения ИЗ Состав Цикл
			КлассСсылки = ПолучитьКлассСсылки(ОбщегоНазначенияКлиентСервер_Ei.СтрНачалоДо(СтрСохранения.Ссылка,"."));
			ЗаписьXML.ЗаписатьНачалоЭлемента(КлассСсылки);
			ЗаписьXML.ЗаписатьАтрибут("uuid", СтрСохранения.Ключ);
			ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст(СтрСохранения.Имя);ЗаписьXML.ЗаписатьКонецЭлемента();
			Если СтрСохранения.Свойство("Синоним") Тогда
				ЗаписатьСиноним(ЗаписьXML,СтрСохранения.Синоним);	
			КонецЕсли;
			Если СтрСохранения.Свойство("Комментарий") Тогда
				ЗаписатьКомментарий(ЗаписьXML,СтрСохранения.Комментарий); //признак параметра
			Иначе	
				//если у набора есть родитель укажем его ключ настроек в комментариях		
				Если СтрНаборов.Свойство(СтрСохранения.Синоним,Набор) И ЗначениеЗаполнено(Набор.Родитель) Тогда
					//для сохранения идентификатора родителя в комментариях
					Если СтрНаборов.Свойство(Набор.Родитель,НаборРодитель) Тогда
						ЗаписатьКомментарий(ЗаписьXML,Строка(НаборРодитель.КлючНастроек));	
					КонецЕсли;		
				КонецЕсли;
			КонецЕсли;		 		
			Если нРег(КлассСсылки) = нРег(ТипыМетаданных().Формы) Тогда
				ЗаписатьМетаданныеФормыОбработки(ЗаписьXML,СтрСохранения);	
			ИначеЕсли нРег(КлассСсылки) = нРег(ТипыМетаданных().Макеты) Тогда
				ЗаписатьМетаданныеМакетаОбработки(ЗаписьXML,СтрСохранения);	
			КонецЕсли;		
			ЗаписьXML.ЗаписатьКонецЭлемента();	
		КонецЦикла;	
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область Расширение

Асинх Функция СоздатьМетаданныеПодсистемы(Каталог, Ключ, Имя,  мСостав, СтрНаборов) Экспорт
	Заголовок = Ждать ПолучитьЗаголовокМетаданных(Подсистема(),Каталог, Ключ, Имя);
	ЗаписьXML = Заголовок.ЗаписьXML;
	Для Каждого СтрСохранения ИЗ мСостав Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("content");ЗаписьXML.ЗаписатьТекст(СтрСохранения.Ссылка);ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Для Каждого СтрНабор ИЗ СтрНаборов Цикл
		Набор 		= СтрНабор.Значение;
		Если Набор.Родитель =  Имя Тогда
			КлассПодсистемы = ПолучитьКлассСсылки(Подсистема());
			ЗаписьXML.ЗаписатьНачалоЭлемента(КлассПодсистемы);ЗаписьXML.ЗаписатьТекст(Набор.Имя);ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЕсли;	
	КонецЦикла;	 
	ЗаписьXML.ЗаписатьКонецЭлемента();	
	ЗаписьXML.Закрыть();		
	Возврат Заголовок.Каталог;	
КонецФункции



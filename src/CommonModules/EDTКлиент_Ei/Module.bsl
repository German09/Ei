// Элементы коллекции объекта XDTO.
// При чтении без схемы одиночный элемент возвращается как ОбъектXDTO, а не СписокXDTO.
// 
// Параметры:
//  Объект 	- ОбъектXDTO -
//  Имя 		- Строка - имя свойства
// 
// Возвращаемое значение:
//  Массив Из ОбъектXDTO
Функция ЭлементыКоллекцииXDTO(Объект, Имя)
	Результат 	= Новый Массив;
	Значение 	= Объект[Имя];
	Если ТипЗнч(Значение) = Тип("СписокXDTO") Тогда
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(Элемент);
		КонецЦикла;
	ИначеЕсли Значение <> Неопределено Тогда
		Результат.Добавить(Значение);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ТипКласса()
	Возврат "mdclass:";
КонецФункции

// Получаем варинты без параметров
// 
// Параметры:
//  СооКлючей 		- Соответствие из КлючИЗначение:
//		*Ключ 		- УникальныйИдентификатор - Ключ найстройки 
//		*Значение 	- Строка - Имя варианта
//  Объект 			- ОбъектXDTO -
// 
// Возвращаемое значение:
//  Структура - см. ВариантыКлиент_Ei.ПолучитьСтруктуруВариантов
Функция ПолучитьВаринаты(СооКлючей, Объект)
	Результат 	= Новый Структура;	
	Для Каждого Тип ИЗ ТипыМетаданных() Цикл
		Если Не Объект.Свойства().Получить(Тип.Значение) = Неопределено Тогда 
			Для Каждого Элемент ИЗ ЭлементыКоллекцииXDTO(Объект, Тип.Значение) Цикл 
				ПрочитатьВариант(Элемент, Результат, Объект, СооКлючей);		
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;
	//Заменим идентификатор родителя на имя
	Для Каждого КлючЗначение ИЗ Результат Цикл
		Вложенная 	= КлючЗначение.Значение;
		Если ОбщегоНазначенияКлиентСервер_Ei.ЭтоУникальныйИдентификатор(Вложенная.Родитель) Тогда
			КлючВарианта = Новый УникальныйИдентификатор(Вложенная.Родитель);
		Иначе
			//в комментарии не уникальный идентифкатор
			КлючВарианта = Неопределено;		 
		КонецЕсли;			 
		Вложенная.Вставить("Родитель",сооКлючей.Получить(КлючВарианта));	
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Прочитать элемент коллекции.
// 
// Параметры:
//  Каталог			- Строка
//  Элемент 		- ОбъектXDTO - 
//  НаборВаринатов 	- Структура Из см. ВариантыКлиентСервер_Ei.ПолучитьВариант
//  Объект 			- ОбъектXDTO - 
//  СооКлючей 		- Соответствие из КлючИЗначение:
//		*Ключ 		- УникальныйИдентификатор - Ключ найстройки 
//		*Значение 	- Строка - Имя варианта
Асинх Процедура ПрочитатьВариант(Элемент, НаборВаринатов, Объект, СооКлючей)
	Перем Родитель;
	СтрВариант = Новый Структура; // см. ВариантыКлиентСервер_Ei.ПолучитьВариант
	Если Не Элемент.Свойства().Получить("comment") = Неопределено Тогда
		Родитель = Элемент.comment;
	КонецЕсли;	 
	Если Не ЭтоОбъектНабора(Строка(Элемент.uuid), Родитель) Тогда
		Возврат;
	КонецЕсли;
	Если Родитель = ФормаНабораКлиент_Ei.ИмяФормы() Тогда
		//Строки общей формы читаются из описания состава в модуле.
	ИначеЕсли Родитель = ПараметрыКлиент_Ei.ПризнакВКомментраии() Тогда
		//это параметр его обрабатываем в см. ПолучитьПараметры	
	ИначеЕсли ВладелецЧасти(Родитель) <> Неопределено Тогда
		//часть варианта из нескольких файлов: строку набора задает главный файл варианта, см. КомментарийЧасти
	Иначе	 
		СтрВариант.Вставить("КлючНастроек",	ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(Элемент.uuid,Объект.uuid));
		СтрВариант.Вставить("Имя",			Элемент.synonym.value);
		СтрВариант.Вставить("Родитель",		Родитель);
		СтрВариант.Вставить("Параметры",	Новый Структура);
		СтрВариант.Вставить("Данные",		Новый Структура);
		НаборВаринатов.Вставить(СтрВариант.Имя,СтрВариант);
		СооКлючей.Вставить(СтрВариант.КлючНастроек, СтрВариант.Имя);
	КонецЕсли;	
КонецПроцедуры

// Добавить к ссылкам на файлы строк набора файлы частей вариантов, см. КомментарийЧасти.
// Данные частей читает главный файл варианта, здесь только ссылки: по их хэшам видны изменения, по путям - слежение.
// Ссылка части знает свой вариант (Владелец): от части идем по владельцам до главного файла
// 
// Параметры:
//  Части 			- Массив из Структура - части, найденные в составе обработки:
//   * Элемент 		- ОбъектXDTO - форма или макет обработки
//   * Тип 			- Строка - см. ТипыМетаданных
//  СсылкиНаФайлы 	- Структура - ссылки на файлы строк, см. ПрочитатьСоставОбработки
//  Объект 			- ОбъектXDTO - обработка
//  СооКлючей 		- Соответствие из КлючИЗначение - имена строк по ключам, см. ПолучитьВаринаты
//  Каталог 		- Строка - папка проекта
//  ИмяПроекта 		- Строка - имя обработки
// 
// Возвращаемое значение:
//  Булево - Истина
Асинх Функция ДобавитьСсылкиНаЧасти(Части, СсылкиНаФайлы, Объект, СооКлючей, Каталог, ИмяПроекта)
	Разделитель 		= ПолучитьРазделительПути();
	ПутьККорневойПапаке = СтрШаблон("%1%5%4%5%2s%5%3", Каталог, ВнешОбработка(), ИмяПроекта, ФайлыКлиентСервер_Ei.КаталогИсходников(), Разделитель);
	Владельцы 			= Новый Соответствие;
	Для Каждого Часть Из Части Цикл
		Владельцы.Вставить(Строка(Часть.Элемент.uuid), ВладелецЧасти(Часть.Элемент.comment));
	КонецЦикла;
	Для Каждого Часть Из Части Цикл
		Ключ 	= Строка(Часть.Элемент.uuid);
		Вариант = Владельцы.Получить(Ключ);
		Шагов 	= 0; //владельцы не должны зацикливаться, но файл могли поправить руками
		Пока Владельцы.Получить(Вариант) <> Неопределено И Шагов < Части.Количество() Цикл
			Вариант = Владельцы.Получить(Вариант);
			Шагов 	= Шагов + 1;
		КонецЦикла;
		ИмяНабора = СооКлючей.Получить(ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(Вариант, Объект.uuid));
		мСостава  = Неопределено;
		Если ИмяНабора = Неопределено Или Не СсылкиНаФайлы.Свойство(ИмяНабора, мСостава) Тогда
			Продолжить;
		КонецЕсли;
		ПолноеИмя = ПутьККорневойПапаке + Разделитель + ПолучитьПуть(Часть.Тип, Часть.Элемент);
		Файл 	  = Новый Файл(ПолноеИмя);
		Если Ждать Файл.СуществуетАсинх() Тогда
			Текст = ФайлыКлиент_Ei.ПрочитатьТекст(ПолноеИмя);
			мСостава.Добавить(ФайлыКлиент_Ei.РезультатСохранения("", ПутьККорневойПапаке, Текст, Ключ, Файл, Новый Структура("Владелец", Вариант)));
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Процедура ЗаписатьСиноним(ЗаписьXML, Синоним)
	ЗаписьXML.ЗаписатьНачалоЭлемента("synonym");
		ЗаписьXML.ЗаписатьНачалоЭлемента("key");ЗаписьXML.ЗаписатьТекст("ru");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("value");ЗаписьXML.ЗаписатьТекст(Синоним);ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура ЗаписатьКомментарий(ЗаписьXML, Комментарий)
	ЗаписьXML.ЗаписатьНачалоЭлемента("comment");
		ЗаписьXML.ЗаписатьТекст(Комментарий);
	ЗаписьXML.ЗаписатьКонецЭлемента();
КонецПроцедуры

// Добавляет только именные методы с описаниями типов, нужными EDT.
// Методы делегируют работу общей обвязке. Форма ссылается на их комментарии.
Процедура ДобавитьОписанияТиповEDT(Строки, СтрНаборов)
	ТипОбъекта = ВозвращаетОбъектОбработки();
	ИменаСтрок			= Новый Массив; // Массив из Строка
	ПараметрыСтрок		= Новый Массив; // Массив из Структура
	СтрокиАлгоритмов	= Новый Массив; // Массив из Структура
	ИмяАлгоритма		= ВариантАлгоритмКлиентСервер_Ei.Свойства().Имя;
	Для Каждого СтрНабор Из СтрНаборов Цикл
		Набор = СтрНабор.Значение;
		Если ИменаСтрок.Найти(Набор.Имя) = Неопределено Тогда
			ИменаСтрок.Добавить(Набор.Имя);
		КонецЕсли;
		Для Каждого ОписаниеПараметра Из Набор.Параметры Цикл
			ПараметрСтроки = Новый Структура("Строка,Имя", Набор.Имя, ОписаниеПараметра.Ключ);
			ПараметрСтроки.Вставить("КлючСтроки",			Набор.КлючНастроек);
			ПараметрСтроки.Вставить("ЭтоВыражение",		ОписаниеПараметра.Значение.ЭтоВыражение);
			ПараметрСтроки.Вставить("ЗначениеПараметра",	ОписаниеПараметра.Значение.ЗначениеПараметра);
			ПараметрыСтрок.Добавить(ПараметрСтроки);
		КонецЦикла;
		//у строки с алгоритмом есть его форма: тип ее Результат - по последнему выполнению, см. Алгоритм__Строка() ниже
		ДанныеАлгоритма	= Неопределено;
		Инструкция		= Неопределено;
		Если Набор.Данные.Свойство(ИмяАлгоритма, ДанныеАлгоритма)
			И ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(ДанныеАлгоритма, "Инструкция", Инструкция)
			И ЗначениеЗаполнено(Инструкция) Тогда
			СтрокиАлгоритмов.Добавить(Новый Структура("Строка,КлючСтроки", Набор.Имя, Набор.КлючНастроек));
		КонецЕсли;
	КонецЦикла;
	ТипыПараметров	= ПараметрыВызовСервера_Ei.ТипыДляEDT(ПараметрыСтрок);
	ТипыАлгоритмов	= ПараметрыВызовСервера_Ei.ТипыРезультатовДляEDT(СтрокиАлгоритмов, ИмяАлгоритма);
	Строки.Добавить("#Область ОписанияТиповEDT");
	Для Каждого ТипПараметра Из ТипыПараметров Цикл
		ДобавитьОписаниеФункции(Строки, СтрШаблон("Параметры__%1()", ТипПараметра.Ключ),
			СтрШаблон("Параметр %1, в Ei Параметры(""%1""). Строки набора: %2.", ТипПараметра.Ключ, ТипПараметра.Значение.Строки),
			"", ТипПараметра.Значение.Тип, СтрШаблон("Возврат ЗначениеПараметра(""%1"");", ТипПараметра.Ключ));
	КонецЦикла;

	Для Каждого ИмяСтроки Из ИменаСтрок Цикл
		ДобавитьОписаниеФункции(Строки, СтрШаблон("Наборы__%1()", ИмяСтроки),
			СтрШаблон("Строка набора %1, в Ei Наборы(""%1"").", ИмяСтроки), "", ТипОбъекта,
			СтрШаблон("Возврат Наборы(""%1"");", ИмяСтроки));
	КонецЦикла;

	//тип результата алгоритма знает только модуль объекта (его пересобирают при сохранении), форма алгоритма ссылается
	//на него через «см.»: так выполнение алгоритма не меняет файлы, по которым Ei считает изменения набора
	Для Каждого СтрокаАлгоритма Из СтрокиАлгоритмов Цикл
		ДобавитьОписаниеФункции(Строки, ВариантАлгоритмКлиентСервер_Ei.ИмяФункцииАлгоритма(СтрокаАлгоритма.Строка) + "()",
			СтрШаблон("Результат алгоритма строки набора %1, в Ei Наборы(""%1"").Варианты(""%2"").Результат(). Тип - по последнему выполнению, Произвольный - если алгоритм не выполнялся.",
				СтрокаАлгоритма.Строка, ИмяАлгоритма),
			"", ТипыАлгоритмов.Получить(СтрокаАлгоритма.Строка),
			СтрШаблон("Возврат МодульEi(""ВариантыВызовСервера_Ei"").Результат(""%1"", ""%2"", 1200);",
				СтрокаАлгоритма.Строка, ИмяАлгоритма));
	КонецЦикла;

	Строки.Добавить("#КонецОбласти");
	Строки.Добавить("");
КонецПроцедуры

// Добавить в текст модуля объекта экспортную функцию обвязки с документирующим комментарием, см. ТекстМодуляОбъекта.
// Тип объекта внешней обработки EDT в комментарии не понимает (ни ВнешняяОбработка.Имя, ни ВнешняяОбработкаОбъект.Имя),
// поэтому у функции, которая возвращает объект обработки, типа в комментарии нет - EDT выводит его из кода (НовыйОбъект)
//
// Параметры:
//  Строки 				- Массив из Строка - строки модуля
//  Объявление 			- Строка - имя и параметры, например Параметры__Склады()
//  Описание 			- Строка - первая строка комментария
//  ОписаниеПараметров 	- Строка - описания параметров через точку с запятой
//  Тип 				- Строка - тип возвращаемого значения; пустой - процедура; см. ВозвращаетОбъектОбработки - объект обработки
//  Тело 				- Строка - операторы функции, строки через перевод строки
Процедура ДобавитьОписаниеФункции(Строки, Объявление, Описание, ОписаниеПараметров, Тип, Тело)
	ОбъектОбработки = (Тип = ВозвращаетОбъектОбработки());
	Строки.Добавить("");
	Строки.Добавить("// " + Описание + ?(ОбъектОбработки, " Возвращает объект этой обработки.", ""));
	Если ЗначениеЗаполнено(ОписаниеПараметров) Тогда
		Строки.Добавить("//");
		Строки.Добавить("// Параметры:");
		Для Каждого ОписаниеПараметра Из СтрРазделить(ОписаниеПараметров, ";") Цикл
			Строки.Добавить("//  " + ОписаниеПараметра);
		КонецЦикла;
	КонецЕсли;
	Строки.Добавить("//");
	Если ОбъектОбработки Тогда
		Строки.Добавить("//@skip-check doc-comment-export-function-return-section");
		Строки.Добавить(СтрШаблон("Функция %1 Экспорт", Объявление));
	ИначеЕсли ЗначениеЗаполнено(Тип) Тогда
		Строки.Добавить("// Возвращаемое значение:");
		//у структуры и таблицы значений после типа идут поля «* Имя - Тип», несколько типов - строки «- Тип - значение»,
		//см. ПараметрыВызовСервера_Ei.ТипЗначенияДляEDT. Тип с полями EDT принимает только с описанием после « - »
		//(проверено 2026-11-13)
		СтрокиТипа 		= СтрРазделить(Тип, Символы.ПС, Ложь);
		ПерваяСтрока 	= СтрокиТипа.Получить(0);
		НесколькоТипов 	= СтрНачинаетсяС(ПерваяСтрока, "- ");
		Если СтрокиТипа.Количество() > 1 И Не НесколькоТипов Тогда
			ПерваяСтрока = ПерваяСтрока + " - значение:";
		КонецЕсли;
		Строки.Добавить("//  " + ПерваяСтрока);
		Для Номер = 1 По СтрокиТипа.ВГраница() Цикл
			Строки.Добавить(?(НесколькоТипов, "//  ", "//   ") + СтрокиТипа.Получить(Номер));
		КонецЦикла;
		Строки.Добавить("//");
		Строки.Добавить(СтрШаблон("Функция %1 Экспорт", Объявление));
	Иначе
		Строки.Добавить(СтрШаблон("Процедура %1 Экспорт", Объявление));
	КонецЕсли;
	Для Каждого СтрокаТела Из СтрРазделить(Тело, Символы.ПС) Цикл
		Строки.Добавить(Символы.Таб + СтрокаТела);
	КонецЦикла;
	Строки.Добавить(?(ЗначениеЗаполнено(Тип), "КонецФункции", "КонецПроцедуры"));
КонецПроцедуры

// Признак для см. ДобавитьОписаниеФункции: функция возвращает объект обработки
//
// Возвращаемое значение:
//  Строка
Функция ВозвращаетОбъектОбработки()
	Возврат "ЭтотОбъект";
КонецФункции

// Служебная область модуля объекта обработки набора, см. ТекстМодуляОбъекта. Проверено в EDT и выполнением в базе 2026-11-13:
// у ЗначениеПараметра нет типа в комментарии, поэтому у Параметры__Имя() остается только тип из их комментариев;
// НовыйОбъект возвращает ЭтотОбъект или новый объект, полученный через Вычислить, - EDT выводит из него тип обработки.
//
// Возвращаемое значение:
//  Строка
Функция СлужебныеФункцииМодуляОбъекта()
	Возврат "#Область СлужебныеПроцедурыИФункции
	|
	|// Значение параметра строки, с которой работает объект: его вычисляет Ei, когда до него доходит код алгоритма.
	|// Типа в комментарии нет: у Параметры__Имя() остается тип из их комментариев
	|//
	|// Параметры:
	|//  ИмяПараметра - Строка, Неопределено - имя параметра
	|//  ИмяНабора - Строка, Неопределено - строка набора
	|//  Форма - Произвольный - общая форма для регистрации контекста серверного вызова
	|//
	|Функция ЗначениеПараметра(ИмяПараметра, ИмяНабора = Неопределено, Форма = Неопределено)
	|	Если Форма <> Неопределено Тогда
	|		Значение = МодульEi(""ВыполнениеФормыНабораСервер_Ei"").ПараметрФормы(Форма, ИмяПараметра, ИмяНабора);
	|	ИначеЕсли ОбъектEi = Неопределено Тогда
	|		Значение = МодульEi(""ВыполнитьКлиентСервер_Ei"").Параметры(ИмяПараметра, ИмяНабора);
	|	Иначе
	|		Значение = ОбъектEi.Параметры(ИмяПараметра);
	|	КонецЕсли;
	|	Возврат Значение;
	|КонецФункции
	|
	|// Объект этой обработки для строки или варианта Ei. Тип объекта внешней обработки в комментарии EDT не знает,
	|// поэтому тип строк и вариантов EDT выводит из кода - из ЭтотОбъект. Обработка, подключенная из временного
	|// хранилища (так ее выполняет Ei), создается по имени: файла у нее нет
	|//
	|// Параметры:
	|//  СтрокаИлиВариант - Произвольный - объект строки или варианта Ei
	|//
	|Функция НовыйОбъект(СтрокаИлиВариант)
	|	Если СтрокаИлиВариант = ОбъектEi Тогда
	|		Объект = ЭтотОбъект;
	|	Иначе
	|		//не Обработки: это свойство глобального контекста, ему нельзя присвоить значение
	|		МенеджерОбработок = МодульEi(""ВнешниеОбработки"");
	|		Если СтрНачинаетсяС(ИспользуемоеИмяФайла, ""e1cib"") Тогда
	|			Объект = МенеджерОбработок.Создать(Метаданные().Имя);
	|		Иначе
	|			Защита = Новый ОписаниеЗащитыОтОпасныхДействий;
	|			Защита.ПредупреждатьОбОпасныхДействиях = Ложь;
	|			Объект = МенеджерОбработок.Создать(ИспользуемоеИмяФайла, БезопасныйРежим(), Защита);
	|		КонецЕсли;
	|		Объект.ОбъектEi = СтрокаИлиВариант;
	|	КонецЕсли;
	|	Возврат Объект;
	|КонецФункции
	|
	|// Общий модуль Ei или свойство глобального контекста: модулей расширения в проекте внешних обработок нет, поэтому через Вычислить
	|//
	|// Параметры:
	|//  Имя - Строка - имя общего модуля или свойства глобального контекста
	|//
	|// Возвращаемое значение:
	|//  Произвольный
	|//
	|Функция МодульEi(Имя)
	|	//@skip-check server-execution-safe-mode
	|	Возврат Вычислить(Имя);
	|КонецФункции
	|
	|#КонецОбласти";
КонецФункции


#Область ЗаписьФайловEDT
// Получить заголовок метаданных.
// 
// Параметры:
//  Класс - Строка - Класс
//  Каталог - Строка - Каталог
//  Ключ - Строка - Уникальный ключ
//  Имя - Строка - Имя
//  Синоним - Строка, Неопределено - Синоним
// 
// Возвращаемое значение:
//  Структура -Получить заголовок метаданных:
// * ЗаписьXML - ЗаписьXML - Объект записи
// * Каталог - Строка - Созданный каталог
Асинх Функция ПолучитьЗаголовокМетаданных(Класс, Каталог, Ключ, Имя, Синоним = Неопределено)
	Синоним 		= ?(Синоним = Неопределено,Имя,Синоним);
	КаталогОбъекта 	= Ждать СоздатьКаталогАсинх(Каталог+"\"+Класс+ОкончаниеКласса()+Имя);	
	ЗаписьXML 		= Новый ЗаписьXML;
	Результат 		= Новый Структура("ЗаписьXML,Каталог",ЗаписьXML,КаталогОбъекта);
	ЗаписьXML.ОткрытьФайл(СтрШаблон("%1\%2.mdo",КаталогОбъекта,Имя));
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("mdclass:"+Класс);
	СоздатьЗаголовокМетаданных(ЗаписьXML, Ключ, Имя, Синоним);
	Возврат Результат;
КонецФункции

Процедура СоздатьЗаголовокМетаданных(ЗаписьXML, Знач Ключ, Имя, Синоним)
	ЗаписьXML.ЗаписатьАтрибут("xmlns:mdclass", 	"http://g5.1c.ru/v8/dt/metadata/mdclass");
	ЗаписьXML.ЗаписатьАтрибут("uuid", ""+Ключ); 
	ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст(Имя);ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписатьСиноним(ЗаписьXML, Синоним);
КонецПроцедуры

Процедура ЗаписатьСиноним(ЗаписьXML, Синоним)
	ЗаписьXML.ЗаписатьНачалоЭлемента("synonym");
		ЗаписьXML.ЗаписатьНачалоЭлемента("key");ЗаписьXML.ЗаписатьТекст("ru");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("value");ЗаписьXML.ЗаписатьТекст(Синоним);ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура ЗаписатьКомментарий(ЗаписьXML, Комментарий)
	ЗаписьXML.ЗаписатьНачалоЭлемента("comment");
		ЗаписьXML.ЗаписатьТекст(Комментарий);
	ЗаписьXML.ЗаписатьКонецЭлемента();
КонецПроцедуры

Функция ТипыМакетов() Экспорт
	Результат =  Новый Структура;
	Результат.Вставить("TextDocument","Template.txt");
	Возврат Результат;	
КонецФункции	

Функция ОкончаниеКласса() Экспорт
	Возврат Окончание()+"\";
КонецФункции

Функция Окончание()
	Возврат "s"; 		
КонецФункции		

//Первую букву делаем строчную и в конец добавляем "s"
//
Функция ПолучитьКлассСсылки(Знач Ссылка)
	Результат = нРег(Лев(Ссылка,1))+Сред(Ссылка,2)+Окончание();
	Возврат Результат;
КонецФункции

Процедура ЗаписатьСтроку(Знач Каталог,Строка)
	ЗТ 		= Новый ЗаписьТекста(Каталог);
	ЗТ.ЗаписатьСтроку(Строка);
	ЗТ.Закрыть();
КонецПроцедуры	

#Область Проект
// Создать файл проекта, содержимое файла .project
// 
// Параметры:
//  Путь 	- Строка - 
//  Имя 	- Строка -
//	сТип	- Строка - Тип проекта V8ExtensionNature или V8ExternalObjectsNature
//
Процедура СоздатьФайлПроекта(Путь, Имя, сТип = "V8ExtensionNature") Экспорт
	ЗаписьXML 		= Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(Путь +ИмяГлФайлаПроекта());
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента(ОписаниеПроекта());
		ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст(Имя);ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("buildSpec");
		ЗаписьXML.ЗаписатьНачалоЭлемента("buildCommand");
			ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст("org.eclipse.xtext.ui.shared.xtextBuilder");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("natures");
			ЗаписьXML.ЗаписатьНачалоЭлемента("nature");ЗаписьXML.ЗаписатьТекст("org.eclipse.xtext.ui.shared.xtextNature");ЗаписьXML.ЗаписатьКонецЭлемента();
			ЗаписьXML.ЗаписатьНачалоЭлемента("nature");ЗаписьXML.ЗаписатьТекст("com._1c.g5.v8.dt.core."+сТип);ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();	
	ЗаписьXML.Закрыть();			
КонецПроцедуры

Функция ОписаниеПроекта()
	Возврат "projectDescription";
КонецФункции

Функция ПолучитьИмяБазовогоПроекта()
	Результат = "";
	Возврат Результат;	
КонецФункции

Асинх Процедура СоздатьОпределение(Путь) Экспорт
	Текст = 
	"Manifest-Version: 1.0
	|Runtime-Version: %1
	|Base-Project: %2";
	Версия 			= ВерсияПлатформы();
	БазовыйПроект 	= ПолучитьИмяБазовогоПроекта();
	Текст  			= СтрШаблон(Текст,Версия,БазовыйПроект);
	КаталогОпределение 	= Ждать СоздатьКаталогАсинх(Путь+"DT-INF");
	ЗТ 					= Новый ЗаписьТекста(КаталогОпределение+"\PROJECT.PMF");
	ЗТ.ЗаписатьСтроку(Текст);
	ЗТ.Закрыть();		
КонецПроцедуры
#КонецОбласти




#Область Обработка
// Получить метаданные обработки.
// 
// Параметры:
//  Каталог - Строка - Каталог
//  Ключ 	- Строка - Уникальный ключ
//  Имя 	- Строка - Имя
// 
// Возвращаемое значение:
//  Структура:
//	* ЗаписьXML - ЗаписьXML - Объект записи
//	* Каталог - Строка- Созданный каталог
Асинх Функция ПолучитьМетаданныеОбработки(Каталог,Ключ, Имя) Экспорт
	Заголовок = Ждать ПолучитьЗаголовокМетаданных(ВнешОбработка(),Каталог, Ключ, Имя);
	ЗаписьXML = Заголовок.ЗаписьXML;
	ЗаписьXML.ЗаписатьНачалоЭлемента("producedTypes");
		ЗаписьXML.ЗаписатьНачалоЭлемента("objectType");
			ЗаписьXML.ЗаписатьАтрибут("typeId", 		"84b95e37-cdd8-4e7c-a768-5383fe41da0a"); 
			ЗаписьXML.ЗаписатьАтрибут("valueTypeId", 	"248e5668-d58d-45f5-abe1-a29717d7428b"); 
		ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();	
	ЗаписьXML.ЗаписатьНачалоЭлемента("containedObjects");
		ЗаписьXML.ЗаписатьАтрибут("classId", 	"c3831ec8-d8d5-4f93-8a22-f9bfae07327f"); 
		ЗаписьXML.ЗаписатьАтрибут("objectId", 	"c03af5f4-81e2-4203-887c-2834653e1866"); 
	ЗаписьXML.ЗаписатьКонецЭлемента();			
	Возврат Заголовок;	
КонецФункции


// Зписываем метаданные формы в метаданные обработки
// 
// Параметры:
//  ЗаписьXML  - ЗаписьXML-
//  СтрСохранения - См. ФайлыКлиент_Ei.РезультатСохранения
Процедура ЗаписатьМетаданныеФормыОбработки(ЗаписьXML,СтрСохранения)
    ЗаписьXML.ЗаписатьНачалоЭлемента("usePurposes");ЗаписьXML.ЗаписатьТекст("PersonalComputer");ЗаписьXML.ЗаписатьКонецЭлемента();
    ЗаписьXML.ЗаписатьНачалоЭлемента("usePurposes");ЗаписьXML.ЗаписатьТекст("MobileDevice");ЗаписьXML.ЗаписатьКонецЭлемента();	
КонецПроцедуры

// Зписываем метаданные макета в метаданные обработки
// 
// Параметры:
// 	ЗаписьXML  - ЗаписьXML-
//  СтрСохранения - см. ФайлыКлиент_Ei.РезультатСохранения
//
Процедура ЗаписатьМетаданныеМакетаОбработки(ЗаписьXML, СтрСохранения)

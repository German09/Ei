КонецПроцедуры

	

Асинх Функция СоздатьФормуОбработки(Путь, сМодуль, Имя, Ключ, Синоним = Неопределено) Экспорт
	Каталог	= Ждать СоздатьОписаниеФормы(Путь,Ключ,Имя,Синоним);
	ЗаписатьМодуль(Каталог,сМодуль);
	Возврат Каталог;
КонецФункции

Асинх Функция СоздатьМакетОбработки(Путь, сМакет, Имя, Ключ, ТипМакета, Синоним = Неопределено) Экспорт
	КаталогМакетов 	= Ждать СоздатьКаталогАсинх(СтрШаблон("%1\%2",Путь,ТипыМетаданных().Макеты));
	Каталог 		= Ждать СоздатьКаталогАсинх(СтрШаблон("%1\%2",КаталогМакетов,Имя));
	ЗаписатьМакет(Каталог, сМакет, ТипМакета);
	Возврат Каталог;
КонецФункции

Асинх Функция СоздатьОписаниеФормы(Каталог,Ключ, Имя, Синоним)
	Синоним 		= ?(Синоним = Неопределено,Имя,Синоним);
	КаталогФорм 	= Ждать СоздатьКаталогАсинх(СтрШаблон("%1\%2",Каталог,ТипыМетаданных().Формы));
	КаталогОбъекта 	= Ждать СоздатьКаталогАсинх(СтрШаблон("%1\%2",КаталогФорм,Имя));	
	ЗаписьXML 		= Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(КаталогОбъекта +"\Form.form");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("form:Form");
		ЗаписьXML.ЗаписатьАтрибут("xmlns:form", "http://g5.1c.ru/v8/dt/form");
		ОписатьКоманднуюПанель(ЗаписьXML);
		ОписатьОбработчики(ЗаписьXML);
		ЗаписьXML.ЗаписатьНачалоЭлемента("autoTitle");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("autoUrl");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("group");ЗаписьXML.ЗаписатьТекст("Vertical");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("autoFillCheck");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("allowFormCustomize");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("enabled");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("showTitle");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("showCloseButton");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("commandInterface");
			ЗаписьXML.ЗаписатьНачалоЭлемента("navigationPanel");ЗаписьXML.ЗаписатьКонецЭлемента();
			ЗаписьXML.ЗаписатьНачалоЭлемента("commandBar");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();	 
	ЗаписьXML.ЗаписатьКонецЭлемента();	
	ЗаписьXML.Закрыть();
	Возврат КаталогОбъекта;	
КонецФункции

// Записать состав обработки.
// 
// Параметры:
//  ЗаписьXML 		- ЗаписьXML - Метаданные обработки
//  СтрРезультат 	- см. ФайлыКлиент_Ei.РезультатСохранения
//	СтрНаборов 		- см. ВариантыКлиентСервер_Ei.ПолучитьВариант (для сохранения идентификатора родителя в комментариях)
//
Процедура ЗаписатьСоставОбработки(ЗаписьXML,СтрРезультат,СтрНаборов) Экспорт
	Перем Набор, НаборРодитель;
	Для Каждого Набор ИЗ СтрРезультат Цикл
		Состав = Набор.Значение;
		Для Каждого СтрСохранения ИЗ Состав Цикл
			КлассСсылки = ПолучитьКлассСсылки(ОбщийМодульКлиентСервер_Ei.СтрНачалоДо(СтрСохранения.Ссылка,"."));
			ЗаписьXML.ЗаписатьНачалоЭлемента(КлассСсылки);
			ЗаписьXML.ЗаписатьАтрибут("uuid", СтрСохранения.Ключ);
			ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст(СтрСохранения.Имя);ЗаписьXML.ЗаписатьКонецЭлемента();
			Если СтрСохранения.Свойство("Синоним") Тогда
				ЗаписатьСиноним(ЗаписьXML,СтрСохранения.Синоним);	
			КонецЕсли;
			Если СтрСохранения.Свойство("Комментарий") Тогда
				ЗаписатьКомментарий(ЗаписьXML,СтрСохранения.Комментарий); //признак параметра
			Иначе	
				//если у набора есть родитель укажем его ключ настроек в комментариях
				Если СтрНаборов.Свойство(СтрСохранения.Синоним,Набор) И ЗначениеЗаполнено(Набор.Родитель) Тогда
					Если СтрНаборов.Свойство(Набор.Родитель,НаборРодитель) Тогда
						ЗаписатьКомментарий(ЗаписьXML,Строка(НаборРодитель.КлючНастроек));	
					КонецЕсли;		
				КонецЕсли;
			КонецЕсли;		 		
			Если нРег(КлассСсылки) = нРег(ТипыМетаданных().Формы) Тогда
				ЗаписатьМетаданныеФормыОбработки(ЗаписьXML,СтрСохранения);	
			ИначеЕсли нРег(КлассСсылки) = нРег(ТипыМетаданных().Макеты) Тогда
				ЗаписатьМетаданныеМакетаОбработки(ЗаписьXML,СтрСохранения);	
			КонецЕсли;		
			ЗаписьXML.ЗаписатьКонецЭлемента();	
		КонецЦикла;	
	КонецЦикла;
КонецПроцедуры

Процедура ОписатьКоманднуюПанель(ЗаписьXML)
	ЗаписьXML.ЗаписатьНачалоЭлемента("autoCommandBar");
		ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст("ФормаКоманднаяПанель");ЗаписьXML.ЗаписатьКонецЭлемента();	
		ЗаписьXML.ЗаписатьНачалоЭлемента("id");ЗаписьXML.ЗаписатьТекст("-1");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("visible");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("enabled");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("userVisible");
			ЗаписьXML.ЗаписатьНачалоЭлемента("common");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("horizontalAlign");ЗаписьXML.ЗаписатьТекст("Left");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("autoFill");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();	
КонецПроцедуры

Процедура ОписатьОбработчики(ЗаписьXML)
	ЗаписьXML.ЗаписатьНачалоЭлемента("handlers");	
		ЗаписьXML.ЗаписатьНачалоЭлемента("event");ЗаписьXML.ЗаписатьТекст("OnCreateAtServer");ЗаписьXML.ЗаписатьКонецЭлемента();	
		ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст("ПриСозданииНаСервере");ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();	
КонецПроцедуры
#КонецОбласти





#Область Расширение
Асинх Функция СоздатьМетаданныеПодсистемы(Каталог, Ключ, Имя,  мСостав, СтрНаборов) Экспорт
	Заголовок = Ждать ПолучитьЗаголовокМетаданных(Подсистема(),Каталог, Ключ, Имя);
	ЗаписьXML = Заголовок.ЗаписьXML;
	Для Каждого СтрСохранения ИЗ мСостав Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("content");ЗаписьXML.ЗаписатьТекст(СтрСохранения.Ссылка);ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Для Каждого СтрНабор ИЗ СтрНаборов Цикл
		Набор 		= СтрНабор.Значение;
		Если Набор.Родитель =  Имя Тогда
			КлассПодсистемы = ПолучитьКлассСсылки(Подсистема());
			ЗаписьXML.ЗаписатьНачалоЭлемента(КлассПодсистемы);ЗаписьXML.ЗаписатьТекст(Набор.Имя);ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЕсли;	
	КонецЦикла;	 
	ЗаписьXML.ЗаписатьКонецЭлемента();	
	ЗаписьXML.Закрыть();		
	Возврат Заголовок.Каталог;	
КонецФункции

Асинх Функция СоздатьМетаданныеОбщегоМодуля(Каталог,Ключ, Имя, Синоним)

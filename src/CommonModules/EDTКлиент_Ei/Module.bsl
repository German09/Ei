Асинх Функция ПолучитьЗаголовокМетаданных(Класс, Каталог, Ключ, Имя, Синоним = Неопределено)
	Синоним 		= ?(Синоним = Неопределено,Имя,Синоним);
	КаталогОбъекта 	= Ждать СоздатьКаталогАсинх(Каталог+"\"+Класс+ОкончаниеКласса()+Имя);	
	ЗаписьXML 		= Новый ЗаписьXML;
	Результат 		= Новый Структура("ЗаписьXML,Каталог",ЗаписьXML,КаталогОбъекта);
	ЗаписьXML.ОткрытьФайл(КаталогОбъекта +"\"+Имя+".mdo");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("mdclass:"+Класс);
	СоздатьЗаголовокМетаданных(ЗаписьXML, Ключ, Имя, Синоним);
	Возврат Результат;
КонецФункции

Процедура СоздатьЗаголовокМетаданных(ЗаписьXML, Знач Ключ, Имя, Синоним)
	ЗаписьXML.ЗаписатьАтрибут("xmlns:mdclass", 	"http://g5.1c.ru/v8/dt/metadata/mdclass");
	ЗаписьXML.ЗаписатьАтрибут("uuid", ""+Ключ); 
	ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст(Имя);ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("synonym");
		ЗаписьXML.ЗаписатьНачалоЭлемента("key");ЗаписьXML.ЗаписатьТекст("ru");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("value");ЗаписьXML.ЗаписатьТекст(Синоним);ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
КонецПроцедуры

Асинх Функция СоздатьМетаданныеОбщегоМодуля(Каталог,Ключ, Имя, Синоним)
	Заголовок = Ждать ПолучитьЗаголовокМетаданных("CommonModule",Каталог, Ключ, Имя);
	ЗаписьXML = Заголовок.ЗаписьXML;
	ЗаписьXML.ЗаписатьНачалоЭлемента("server");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("serverCall");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();	 
	ЗаписьXML.ЗаписатьКонецЭлемента();	
	ЗаписьXML.Закрыть();
	Возврат Заголовок.Каталог;	
КонецФункции

Асинх Функция СоздатьМетаданныеОбщегоМакета(Каталог,Ключ, Имя, Синоним)
	Заголовок = Ждать ПолучитьЗаголовокМетаданных("CommonTemplate",Каталог, Ключ, Имя);
	ЗаписьXML = Заголовок.ЗаписьXML;
	ЗаписьXML.ЗаписатьНачалоЭлемента("templateType");ЗаписьXML.ЗаписатьТекст("TextDocument");ЗаписьXML.ЗаписатьКонецЭлемента(); 
	ЗаписьXML.ЗаписатьКонецЭлемента();	
	ЗаписьXML.Закрыть();		
	Возврат Заголовок.Каталог;	
КонецФункции

Асинх Функция СоздатьМетаданныеПодсистемы(Каталог, Ключ, Имя,  мСостав, СтрНаборов) Экспорт
	Заголовок = Ждать ПолучитьЗаголовокМетаданных(Подсистема(),Каталог, Ключ, Имя);
	ЗаписьXML = Заголовок.ЗаписьXML;
	Для Каждого Ссылка ИЗ мСостав Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("content");ЗаписьXML.ЗаписатьТекст(Ссылка);ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Для Каждого СтрНабор ИЗ СтрНаборов Цикл
		Набор 		= СтрНабор.Значение;
		Если Набор.Родитель =  Имя Тогда
			КлассПодсистемы = ПолучитьКлассСсылки(Подсистема());
			ЗаписьXML.ЗаписатьНачалоЭлемента(КлассПодсистемы);ЗаписьXML.ЗаписатьТекст(Набор.Имя);ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЕсли;	
	КонецЦикла;	 
	ЗаписьXML.ЗаписатьКонецЭлемента();	
	ЗаписьXML.Закрыть();		
	Возврат Заголовок.Каталог;	
КонецФункции

Функция Подсистема()
	Возврат "Subsystem";
КонецФункции

Функция ОкончаниеКласса()
	Возврат "s\";
КонецФункции	

Функция ПутьВСсылку(Путь,ПутьККорневойПапаке) Экспорт
	Стр 		= СтрЗаменить(Путь,ПутьККорневойПапаке+"\","");
	Результат 	= СтрЗаменить(Стр,ОкончаниеКласса(),".");
	Возврат Результат;	
КонецФункции

//Первую букву делаем строчную и в конец добавляем "s"
//
Функция ПолучитьКлассСсылки(Знач Ссылка)
	Результат = нРег(Лев(Ссылка,1))+Сред(Ссылка,2)+"s";
	Возврат Результат;
КонецФункции	

Процедура СоздатьФайлПроекта(Путь, Имя) Экспорт
	ЗаписьXML 		= Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(Путь +".project");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("projectDescription");
		ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст(Имя);ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("buildSpec");
		ЗаписьXML.ЗаписатьНачалоЭлемента("buildCommand");
			ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст("org.eclipse.xtext.ui.shared.xtextBuilder");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("natures");
			ЗаписьXML.ЗаписатьНачалоЭлемента("nature");ЗаписьXML.ЗаписатьТекст("org.eclipse.xtext.ui.shared.xtextNature");ЗаписьXML.ЗаписатьКонецЭлемента();
			ЗаписьXML.ЗаписатьНачалоЭлемента("nature");ЗаписьXML.ЗаписатьТекст("com._1c.g5.v8.dt.core.V8ExtensionNature");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();	
	ЗаписьXML.Закрыть();			
КонецПроцедуры

Асинх Процедура СоздатьОпределение(Путь) Экспорт
	Текст = 
	"Manifest-Version: 1.0
	|Runtime-Version: "+ВерсияПлатформы()+"
	|Base-Project: ";
	КаталогОпределение 	= Ждать СоздатьКаталогАсинх(Путь+"DT-INF");
	ЗТ 					= Новый ЗаписьТекста(КаталогОпределение+"\PROJECT.PMF");
	ЗТ.ЗаписатьСтроку(Текст);
	ЗТ.Закрыть();		
КонецПроцедуры			

Асинх Функция СоздатьОбшийМодуль(Путь, сМодуль, Имя, Ключ, Синоним = Неопределено) Экспорт
	ПутьВариант	= Ждать СоздатьМетаданныеОбщегоМодуля(Путь,Ключ,Имя,Синоним);
	ЗТ 			= Новый ЗаписьТекста(ПутьВариант+"\Module.bsl");
	ЗТ.ЗаписатьСтроку(сМодуль);
	ЗТ.Закрыть();
	Результат = EDTКлиент_Ei.ПутьВСсылку(ПутьВариант,Путь);
	Возврат Результат;
КонецФункции

Асинх Функция СоздатьОбшийМакет(Путь, сМакет, Имя, Ключ, Синоним = Неопределено) Экспорт
	ПутьВариант	= Ждать СоздатьМетаданныеОбщегоМакета(Путь,Ключ,Имя,Синоним);
	ЗТ 			= Новый ЗаписьТекста(ПутьВариант+"\Template.txt");
	ЗТ.ЗаписатьСтроку(сМакет);
	ЗТ.Закрыть();
	Результат = EDTКлиент_Ei.ПутьВСсылку(ПутьВариант,Путь);
	Возврат Результат;
КонецФункции

Асинх Процедура СоздатьФайлКонфигурации(Каталог, Имя, Ключ, СтрРезультат, СтрНаборов) Экспорт
	Класс 			= "Configuration";
	КаталогОбъекта 	= Ждать СоздатьКаталогАсинх(Каталог+"\"+Класс);
	ЗаписьXML 		= Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(КаталогОбъекта +"\"+Класс+".mdo");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("mdclass:"+Класс);
	ЗаписьXML.ЗаписатьАтрибут("xmlns:xsi", 				"http://www.w3.org/2001/XMLSchema-instance");
	ЗаписьXML.ЗаписатьАтрибут("xmlns:mdclassExtension",	"http://g5.1c.ru/v8/dt/metadata/mdclass/extension");
	СоздатьЗаголовокМетаданных(ЗаписьXML, Ключ, Имя, Имя);
	ЗаписьXML.ЗаписатьНачалоЭлемента("objectBelonging");ЗаписьXML.ЗаписатьТекст("Adopted");ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("extension");
		ЗаписьXML.ЗаписатьАтрибут("xsi:type", "mdclassExtension:ConfigurationExtension");
		ЗаписьXML.ЗаписатьНачалоЭлемента("defaultRunMode");				ЗаписьXML.ЗаписатьТекст("Checked");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("usePurposes");				ЗаписьXML.ЗаписатьТекст("Checked");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("managedApplicationModule");	ЗаписьXML.ЗаписатьТекст("Checked");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("sessionModule");				ЗаписьXML.ЗаписатьТекст("Checked");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("defaultLanguage");			ЗаписьXML.ЗаписатьТекст("Checked");ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("keepMappingToExtendedConfigurationObjectsByIDs");	ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("namePrefix");	ЗаписьXML.ЗаписатьТекст(Имя);ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("configurationExtensionCompatibilityMode");ЗаписьXML.ЗаписатьТекст(ВерсияПлатформы());ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("configurationExtensionPurpose");	ЗаписьXML.ЗаписатьТекст("AddOn");ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("defaultRunMode");	ЗаписьXML.ЗаписатьТекст("ManagedApplication");ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("usePurposes");	ЗаписьXML.ЗаписатьТекст("PersonalComputer");ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("scriptVariant");	ЗаписьXML.ЗаписатьТекст("Russian");ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("vendor");	ЗаписьXML.ЗаписатьТекст("http://main.1c-ei.ru/");ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("version");	ЗаписьXML.ЗаписатьТекст("2.1.2");ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("defaultLanguage");	ЗаписьXML.ЗаписатьТекст("Language.Русский");ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("languages");
		ЗаписьXML.ЗаписатьАтрибут("uuid", "5f7ce907-b1f8-452c-8747-c4c867d711eb");
		ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст("Русский");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("objectBelonging");ЗаписьXML.ЗаписатьТекст("Adopted");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("extension");
			ЗаписьXML.ЗаписатьАтрибут("xsi:type", "mdclassExtension:LanguageExtension");	
			ЗаписьXML.ЗаписатьНачалоЭлемента("languageCode");ЗаписьXML.ЗаписатьТекст("Checked");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("languageCode");ЗаписьXML.ЗаписатьТекст("ru");ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();
	//Запишем состав
	Для Каждого Набор ИЗ СтрРезультат Цикл
		Состав = Набор.Значение;
		Для Каждого Ссылка ИЗ Состав Цикл
			КлассСсылки = ПолучитьКлассСсылки(ОбщийМодульКлиентСервер_Ei.СтрНачалоДо(Ссылка,"."));
			ЗаписьXML.ЗаписатьНачалоЭлемента(КлассСсылки);ЗаписьXML.ЗаписатьТекст(Ссылка);ЗаписьXML.ЗаписатьКонецЭлемента();	
		КонецЦикла;	
	КонецЦикла;
	//Теперь подсистему верхнего уровня
	КлассПодсистемы = ПолучитьКлассСсылки(Подсистема());
	ЗаписьXML.ЗаписатьНачалоЭлемента(КлассПодсистемы);ЗаписьXML.ЗаписатьТекст(Подсистема()+"."+Имя);ЗаписьXML.ЗаписатьКонецЭлемента();	
	ЗаписьXML.ЗаписатьКонецЭлемента();	
	ЗаписьXML.Закрыть();		  	
КонецПроцедуры


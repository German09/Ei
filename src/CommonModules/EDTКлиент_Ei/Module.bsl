// Возвращаемое значение:
//  Строка - Полное имя записанного файла 
Функция ЗаписатьМакет(Знач Каталог, Содержание, ТипаМакета)
	ПолноеИмя = СтрШаблон("%1\%2",Каталог,ТипаМакета);
	Если СтрЗаканчиваетсяНа(ТипаМакета,"txt") Тогда
		ФайлыКлиентСервер_Ei.ЗаписатьСтроку(ПолноеИмя,Содержание);
	Иначе
		ФайлыКлиент_Ei.ЗаписатьXMLСтроку(ПолноеИмя,Содержание);
	КонецЕсли;	
	Возврат ПолноеИмя;				

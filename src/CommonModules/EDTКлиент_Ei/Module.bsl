Асинх Функция СоздатьОписаниеФормы(Каталог,Ключ, Имя, Синоним, ИмяОбработки)
	Синоним 		= ?(Синоним = Неопределено,Имя,Синоним);
	КаталогФорм 	= Ждать СоздатьКаталогАсинх(СтрШаблон("%1\%2",Каталог,ТипыМетаданных().Формы));
	КаталогОбъекта 	= Ждать СоздатьКаталогАсинх(СтрШаблон("%1\%2",КаталогФорм,Имя));	
	ЗаписьXML 		= Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(СтрШаблон("%1\Form.form",КаталогОбъекта));
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("form:Form");
		ЗаписьXML.ЗаписатьАтрибут("xmlns:form", "http://g5.1c.ru/v8/dt/form");
		ОписатьКоманднуюПанель(ЗаписьXML);
		ОписатьОбработчики(ЗаписьXML);
		ЗаписьXML.ЗаписатьНачалоЭлемента("group");				ЗаписьXML.ЗаписатьТекст("Vertical");ЗаписьXML.ЗаписатьКонецЭлемента();
		Для Каждого Свойство ИЗ СтрРазделить("autoTitle,autoUrl,autoFillCheck,allowFormCustomize,enabled,showTitle,showCloseButton",",") Цикл
			ЗаписьXML.ЗаписатьНачалоЭлемента(Свойство);			ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЦикла;
		ЗаписьXML.ЗаписатьНачалоЭлемента("attributes");
			Если Не ИмяОбработки = Неопределено Тогда
				ЗаписьXML.ЗаписатьНачалоЭлемента("name");		ЗаписьXML.ЗаписатьТекст(ВариантАлгоритмКлиентСервер_Ei.ИмяРеквизитаФормыОбработки());ЗаписьXML.ЗаписатьКонецЭлемента();
				ЗаписьXML.ЗаписатьНачалоЭлемента("id");	ЗаписьXML.ЗаписатьТекст("1");ЗаписьXML.ЗаписатьКонецЭлемента();			
				ЗаписьXML.ЗаписатьНачалоЭлемента("valueType");
					ЗаписьXML.ЗаписатьНачалоЭлемента("types");	ЗаписьXML.ЗаписатьТекст(СтрШаблон("%1.%2",ВнешОбработка(),ИмяОбработки));ЗаписьXML.ЗаписатьКонецЭлемента();	
				ЗаписьXML.ЗаписатьКонецЭлемента();
				Для Каждого Свойство ИЗ СтрРазделить("view,edit",",") Цикл
					ЗаписьXML.ЗаписатьНачалоЭлемента(Свойство);
						ЗаписьXML.ЗаписатьНачалоЭлемента("common");	ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
					ЗаписьXML.ЗаписатьКонецЭлемента();
				КонецЦикла;	
			КонецЕсли;		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("commandInterface");
			ЗаписьXML.ЗаписатьНачалоЭлемента("navigationPanel");ЗаписьXML.ЗаписатьКонецЭлемента();
			ЗаписьXML.ЗаписатьНачалоЭлемента("commandBar");		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();	 
	ЗаписьXML.ЗаписатьКонецЭлемента();	
	ЗаписьXML.Закрыть();
	Возврат КаталогОбъекта;	
КонецФункции

Процедура ОписатьКоманднуюПанель(ЗаписьXML)
	ЗаписьXML.ЗаписатьНачалоЭлемента("autoCommandBar");
		ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст("ФормаКоманднаяПанель");ЗаписьXML.ЗаписатьКонецЭлемента();	
		ЗаписьXML.ЗаписатьНачалоЭлемента("id");ЗаписьXML.ЗаписатьТекст("-1");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("visible");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("enabled");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("userVisible");
			ЗаписьXML.ЗаписатьНачалоЭлемента("common");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("horizontalAlign");ЗаписьXML.ЗаписатьТекст("Left");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("autoFill");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();	
КонецПроцедуры

Процедура ОписатьОбработчики(ЗаписьXML)
	ЗаписьXML.ЗаписатьНачалоЭлемента("handlers");	
		ЗаписьXML.ЗаписатьНачалоЭлемента("event");ЗаписьXML.ЗаписатьТекст("OnCreateAtServer");ЗаписьXML.ЗаписатьКонецЭлемента();	
		ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст("ПриСозданииНаСервере");ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();	
КонецПроцедуры

// Элементы коллекции объекта XDTO.
// При чтении без схемы одиночный элемент возвращается как ОбъектXDTO, а не СписокXDTO.
// 
// Параметры:
//  Объект 	- ОбъектXDTO -
//  Имя 		- Строка - имя свойства
// 
// Возвращаемое значение:
//  Массив Из ОбъектXDTO
Функция ЭлементыКоллекцииXDTO(Объект, Имя)
	Результат 	= Новый Массив;
	Значение 	= Объект[Имя];
	Если ТипЗнч(Значение) = Тип("СписокXDTO") Тогда
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(Элемент);
		КонецЦикла;
	ИначеЕсли Значение <> Неопределено Тогда
		Результат.Добавить(Значение);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ТипКласса()
	Возврат "mdclass:";
КонецФункции

// Получаем варинты без параметров
// 
// Параметры:
//  СооКлючей 		- Соответствие из КлючИЗначение:
//		*Ключ 		- УникальныйИдентификатор - Ключ найстройки 
//		*Значение 	- Строка - Имя варианта
//  Объект 			- ОбъектXDTO -
// 
// Возвращаемое значение:
//  Структура - см. ВариантыКлиент_Ei.Получить
Функция ПолучитьВаринаты(СооКлючей, Объект)
	Результат 	= Новый Структура;	
	Для Каждого Тип ИЗ ТипыМетаданных() Цикл
		Если Не Объект.Свойства().Получить(Тип.Значение) = Неопределено Тогда 
			Для Каждого Элемент ИЗ ЭлементыКоллекцииXDTO(Объект, Тип.Значение) Цикл 
				ПрочитатьВариант(Элемент, Результат, Объект, СооКлючей);		
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;
	//Заменим идентификатор родителя на имя
	Для Каждого КлючЗначение ИЗ Результат Цикл
		Вложенная 	= КлючЗначение.Значение;
		Если ОбщегоНазначенияКлиентСервер_Ei.ЭтоУникальныйИдентификатор(Вложенная.Родитель) Тогда
			КлючВарианта = Новый УникальныйИдентификатор(Вложенная.Родитель);
		Иначе
			//в комментарии не уникальный идентифкатор
			КлючВарианта = Неопределено;		 
		КонецЕсли;			 
		Вложенная.Вставить("Родитель",сооКлючей.Получить(КлючВарианта));	
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Прочитать элемент коллекции.
// 
// Параметры:
//  Каталог			- Строка
//  Элемент 		- ОбъектXDTO - 
//  НаборВаринатов 	- Структура Из см. ВариантыКлиентСервер_Ei.ПолучитьВариант
//  Объект 			- ОбъектXDTO - 
//  СооКлючей 		- Соответствие из КлючИЗначение:
//		*Ключ 		- УникальныйИдентификатор - Ключ найстройки 
//		*Значение 	- Строка - Имя варианта
Асинх Процедура ПрочитатьВариант(Элемент, НаборВаринатов, Объект, СооКлючей)
	Перем Родитель;
	СтрВариант = Новый Структура; // см. ВариантыКлиентСервер_Ei.ПолучитьВариант
	Если Не Элемент.Свойства().Получить("comment") = Неопределено Тогда
		Родитель = Элемент.comment;
	КонецЕсли;	 
	Если Родитель = ПараметрыКлиент_Ei.ПризнакВКомментраии() Тогда
		//это параметр его обрабатываем в см. ПолучитьПараметры	
	Иначе	 
		СтрВариант.Вставить("КлючНастроек",	ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(Элемент.uuid,Объект.uuid));
		СтрВариант.Вставить("Имя",			Элемент.synonym.value);
		СтрВариант.Вставить("Родитель",		Родитель);
		СтрВариант.Вставить("Параметры",	Новый Структура);

	ЗаписьXML.ЗаписатьНачалоЭлемента(КлассПодсистемы);ЗаписьXML.ЗаписатьТекст(Подсистема()+"."+Имя);ЗаписьXML.ЗаписатьКонецЭлемента();	
	ЗаписьXML.ЗаписатьКонецЭлемента();	

// Разобрать свойства.
// 
// Параметры:
//  Описание см. СобратьСвойства
// 
// Возвращаемое значение:
//  СписокЗначений ИЗ Строка
Функция РазобратьСвойства(Описание)
	Результат = Новый СписокЗначений(); //важен порядок свойств, поэтому список
	Если Не ПустаяСтрока(Описание) Тогда
		Для Каждого Строка ИЗ СтрРазделить(Описание,Символы.ПС) Цикл
			ИмяСвойства = Неопределено;
			Для Каждого КлючЗначение ИЗ СтрРазделить(Строка,": ") Цикл
				Если ИмяСвойства = Неопределено И Не ПустаяСтрока(КлючЗначение) Тогда
					ИмяСвойства = КлючЗначение;
				ИначеЕсли Не ИмяСвойства = Неопределено Тогда
					Результат.Добавить(КлючЗначение,ИмяСвойства);
				КонецЕсли;			
			КонецЦикла;			
		КонецЦикла;	
	КонецЕсли;	
	Возврат Результат;	
КонецФункции

// Собрать свойства.
// 
// Параметры:
//  Свойства см. РазобратьСвойства 
// 
// Возвращаемое значение:
//  Строка - Собрать свойства
Функция СобратьСвойства(Свойства)
	Строки = Новый Массив;
	Для Каждого	ПредставлениеЗначение ИЗ Свойства Цикл
		Если ЗначениеЗаполнено(ПредставлениеЗначение.Значение) Тогда
			Строки.Добавить(СтрШаблон("%1: %2",ПредставлениеЗначение.Представление,ПредставлениеЗначение.Значение));
		КонецЕсли;		
	КонецЦикла;
	Возврат СтрСоединить(Строки,Символы.ПС);
КонецФункции
#КонецОбласти

// Получить заголовок метаданных.
// 
// Параметры:
//  Класс - Строка - Класс
//  Каталог - Строка - Каталог
//  Ключ - Строка - Уникальный ключ
//  Имя - Строка - Имя
//  Синоним - Строка, Неопределено - Синоним
// 
// Возвращаемое значение:
//  Структура -Получить заголовок метаданных:
// * ЗаписьXML - ЗаписьXML - Объект записи
// * Каталог - Строка - Созданный каталог
Асинх Функция ПолучитьЗаголовокМетаданных(Класс, Каталог, Ключ, Имя, Синоним = Неопределено)
	Синоним 		= ?(Синоним = Неопределено,Имя,Синоним);
	КаталогОбъекта 	= Ждать СоздатьКаталогАсинх(СтрШаблон("%1\%2%3%4",Каталог,Класс,ОкончаниеКласса(),Имя));	
	ЗаписьXML 		= Новый ЗаписьXML;
	Результат 		= Новый Структура("ЗаписьXML,Каталог",ЗаписьXML,КаталогОбъекта);
	ЗаписьXML.ОткрытьФайл(СтрШаблон("%1\%2.mdo",КаталогОбъекта,Имя));
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("mdclass:"+Класс);
	СоздатьЗаголовокМетаданных(ЗаписьXML, Ключ, Имя, Синоним);
	Возврат Результат;
КонецФункции

Процедура СоздатьЗаголовокМетаданных(ЗаписьXML, Знач Ключ, Имя, Синоним)
	ЗаписьXML.ЗаписатьАтрибут("xmlns:mdclass", 	"http://g5.1c.ru/v8/dt/metadata/mdclass");
	ЗаписьXML.ЗаписатьАтрибут("uuid", ""+Ключ); 
	ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст(Имя);ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписатьСиноним(ЗаписьXML, Синоним);
КонецПроцедуры	

// Останавливает сохранение при совпадении имени с посторонним объектом, прежде чем затронуты его файлы.
// Прежний состав обработки остается на диске до окончания сохранения.
//
// Параметры:
//  Путь - Строка - каталог обработки
//  Имя - Строка - имя создаваемой формы или макета
//  Форма - Булево - проверяется форма, иначе макет
//
// Возвращаемое значение:
//  Булево - проверка пройдена
Асинх Функция ПроверитьПринадлежностьОбъекта(Знач Путь, Имя, Форма)
	Если СтрЗаканчиваетсяНа(Путь, ПолучитьРазделительПути()) Тогда
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЕсли;
	Каталог		= Новый Файл(Путь);
	ФайлМетаданных	= Новый Файл(Путь + ПолучитьРазделительПути() + Каталог.Имя + ".mdo");
	Если Ждать ФайлМетаданных.СуществуетАсинх() Тогда
		Для Каждого Объект Из ОбъектыОбработки(ФайлМетаданных.ПолноеИмя) Цикл
			Если Объект.Форма = Форма И НРег(Объект.Имя) = НРег(Имя)
				И Не ЭтоОбъектНабора(Объект.Ключ, Объект.Комментарий) Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Имя %1 занято посторонним объектом обработки. Сохранение остановлено, его файлы не изменены.'"), Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Истина;
КонецФункции

#КонецОбласти

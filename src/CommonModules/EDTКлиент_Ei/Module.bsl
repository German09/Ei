// Получить имя проекта.
// 
// Параметры:
//  Каталог 					- Строка - Каталог
//  ПоказыватьПредупреждение	- Булево -
// 
// Возвращаемое значение:
//  Обещание, Строка - Имя проекта
Асинх Функция ПолучитьИмяПроекта(Каталог,ПоказыватьПредупреждение = Истина) Экспорт
	Результат = "";
	ФайлПроекта = Новый Файл(СтрШаблон("%1\%2",Каталог,ИмяГлФайлаПроекта()));
	Если Ждать ФайлПроекта.СуществуетАсинх() Тогда
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьФайл(ФайлПроекта.ПолноеИмя);
		Объект 		= ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
		Результат 	= Объект.Name;	
	ИначеЕсли ПоказыватьПредупреждение Тогда
		ПоказатьПредупреждение(,СтрШаблон("В каталоге %1 не найден файл %2",Каталог,ИмяГлФайлаПроекта()));		
	КонецЕсли;
	Возврат Результат;			
КонецФункции

// Получить свойства определение проекта.

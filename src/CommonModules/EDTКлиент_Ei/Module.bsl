#Область ПрограммныйИнтерфейс
#Область ЗаписьФайловEDT

// Типы макетов.
// 
// Возвращаемое значение:
//  Структура - Типы макетов:
// * TextDocument - Строка - 
// * DataCompositionSchema - Строка - 
// * GraphicalSchema - Строка - графическая схема, см. СхемаПроцессаEDTВызовСервера_Ei
Функция ТипыМакетов() Экспорт
	Результат =  Новый Структура;
	Результат.Вставить("TextDocument",			"Template.txt");
	Результат.Вставить("DataCompositionSchema",	"Template.dcs");
	Результат.Вставить("GraphicalSchema",		"Template.scheme");
	Возврат Результат;	
КонецФункции	

// Комментарий объекта обработки - части варианта: вариант лежит в нескольких файлах (процесс - схема, формы алгоритмов,
// макеты), главный файл - объект варианта, остальные - части. Владелец части - главный файл или другая часть
// (вложенный процесс «Для Каждого»), в комментарии - его uuid. Строку набора часть не задает, см. ПолучитьВаринаты
// 
// Параметры:
//  КлючВладельца - Строка - uuid объекта владельца
// 
// Возвращаемое значение:
//  Строка
Функция КомментарийЧасти(КлючВладельца) Экспорт
	Возврат ПризнакЧасти() + " " + КлючВладельца;
КонецФункции

// Владелец части варианта по комментарию объекта, см. КомментарийЧасти
// 
// Параметры:
//  Комментарий - Строка, Неопределено - комментарий объекта обработки
// 
// Возвращаемое значение:
//  Строка, Неопределено - uuid владельца, Неопределено - объект не часть
Функция ВладелецЧасти(Комментарий) Экспорт
	Результат = Неопределено;
	Начало = ПризнакЧасти() + " ";
	Если ТипЗнч(Комментарий) = Тип("Строка") И СтрНачинаетсяС(Комментарий, Начало) Тогда
		Результат = СокрЛП(Сред(Комментарий, СтрДлина(Начало) + 1));
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Объекты (формы и макеты) обработки по ее файлу .mdo: из них вариант из нескольких файлов собирает свои части
// 
// Параметры:
//  ФайлОбработки - Строка - полное имя файла .mdo обработки
// 
// Возвращаемое значение:
//  Массив из Структура:
//   * Ключ - Строка - uuid
//   * Имя - Строка
//   * Синоним - Строка
//   * Комментарий - Строка
//   * Форма - Булево - форма, иначе макет
//   * ТипМакета - Строка - см. ТипыМакетов, у формы пустой
//   * ПолноеИмя - Строка - полное имя файла объекта: модуля формы или содержимого макета
Функция ОбъектыОбработки(ФайлОбработки) Экспорт
	Результат = Новый Массив;
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ФайлОбработки);
	Объект = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	ЧтениеXML.Закрыть();
	Файл = Новый Файл(ФайлОбработки);
	Каталог = Лев(ФайлОбработки, СтрДлина(ФайлОбработки) - СтрДлина(Файл.Имя));
	Для Каждого Тип Из ТипыМетаданных() Цикл
		Если Объект.Свойства().Получить(Тип.Значение) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Элемент Из ЭлементыКоллекцииXDTO(Объект, Тип.Значение) Цикл
			Описание = Новый Структура("Ключ,Имя,Синоним,Комментарий", Строка(Элемент.uuid), Элемент.name, "", "");
			Если Элемент.Свойства().Получить("synonym") <> Неопределено И ТипЗнч(Элемент.synonym) = Тип("ОбъектXDTO") Тогда
				Описание.Синоним = Элемент.synonym.value;
			КонецЕсли;
			Если Элемент.Свойства().Получить("comment") <> Неопределено Тогда
				Описание.Комментарий = Строка(Элемент.comment);
			КонецЕсли;
			ТипМакета = ?(Элемент.Свойства().Получить("templateType") = Неопределено, Неопределено, Элемент.templateType);
			Описание.Вставить("Форма",		ТипМакета = Неопределено);
			Описание.Вставить("ТипМакета",	?(ТипМакета = Неопределено, "", Строка(ТипМакета)));
			Описание.Вставить("ПолноеИмя",	Каталог + ПолучитьПуть(Тип.Значение, Элемент));
			Результат.Добавить(Описание);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Принадлежность формы или макета набору Ei: параметры и части имеют явный комментарий,
// у вариантов последние 12 знаков uuid совпадают с постоянным кодом вида варианта.
// Имя не используется: посторонний макет с похожим именем не становится объектом Ei.
//
// Параметры:
//  Ключ - Строка - uuid объекта
//  Комментарий - Строка, Неопределено - комментарий объекта
//
// Возвращаемое значение:
//  Булево
Функция ЭтоОбъектНабора(Ключ, Комментарий) Экспорт
	Результат = Комментарий = ПараметрыКлиент_Ei.ПризнакВКомментраии()
		Или Комментарий = ФормаНабораКлиент_Ei.ИмяФормы()
		Или ВладелецЧасти(Комментарий) <> Неопределено;
	Если Не Результат Тогда
		Для Каждого ВидВарианта Из ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
			Если НРег(Прав(Ключ, 12)) = НРег(Прав(ВидВарианта.Значение.Свойства().Код, 12)) Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Читает прежний состав до перезаписи .mdo. Посторонние объекты и свойства сохраняются как XML,
// а список объектов Ei ограничивает очистку каталогов.
//
// Параметры:
//  Текст - Строка - прежний XML обработки
//
// Возвращаемое значение:
//  Структура:
//   * Комментарий - Строка - комментарий корня обработки
//   * СохраняемыеЭлементы - Массив из Строка - XML свойств и посторонних объектов
//   * ОбъектыEi - Массив из Структура - только прежние объекты Ei:
//    ** Тип - Строка - Forms или Templates
//    ** Имя - Строка - имя каталога объекта
Функция СоставОбработкиПередСохранением(Текст) Экспорт
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(Текст);
	ОписаниеОбработки = ФабрикаXDTO.ПрочитатьXML(Чтение);
	Чтение.Закрыть();
	КлючиОбъектовEi	= Новый Массив;
	Состав			= Новый Структура("СохраняемыеЭлементы,ОбъектыEi", Новый Массив, Новый Массив);
	Состав.Вставить("Комментарий", ?(ОписаниеОбработки.Свойства().Получить("comment") = Неопределено,
		"", Строка(ОписаниеОбработки.comment)));
	Для Каждого ТипОбъекта Из ТипыМетаданных() Цикл
		Если ОписаниеОбработки.Свойства().Получить(ТипОбъекта.Значение) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Объект Из ЭлементыКоллекцииXDTO(ОписаниеОбработки, ТипОбъекта.Значение) Цикл
			Комментарий = ?(Объект.Свойства().Получить("comment") = Неопределено, "", Строка(Объект.comment));
			Если Не ЭтоОбъектНабора(Строка(Объект.uuid), Комментарий) Тогда
				Продолжить;
			КонецЕсли;
			Имя = Строка(Объект.name);
			Если ПустаяСтрока(Имя) Или Имя = "." Или Имя = ".."
				Или СтрНайти(Имя, "\") > 0 Или СтрНайти(Имя, "/") > 0 Или СтрНайти(Имя, ":") > 0 Тогда
				ВызватьИсключение НСтр("ru = 'В составе обработки указано недопустимое имя объекта Ei'");
			КонецЕсли;
			КлючиОбъектовEi.Добавить(НРег(Строка(Объект.uuid)));
			Состав.ОбъектыEi.Добавить(Новый Структура("Тип,Имя", ТипОбъекта.Значение, Имя));
		КонецЦикла;
	КонецЦикла;
	Состав.СохраняемыеЭлементы = ВыполнитьВызовСервера_Ei.МетаданныеБезОбъектовEi(Текст, КлючиОбъектовEi);
	Возврат Состав;
КонецФункции

// Окончание класса.
// 
// Возвращаемое значение:
//  Строка - Окончание класса
Функция ОкончаниеКласса() Экспорт
	Возврат Окончание()+"\";
КонецФункции

// Записать модуль.
// 
// Параметры:
//  Каталог 	- Строка - Каталог
//  Содержание	- Строка
//  ТипМодуля	- Строка - Например для модуля объекта
// Возвращаемое значение:
//  Строка - Полное имя записанного файла 
Функция ЗаписатьМодуль(Знач Каталог, Содержание,ТипМодуля = "") Экспорт
	ПолноеИмя = СтрШаблон("%1\%2%3",Каталог,ТипМодуля,ИмяМодуля());
	ФайлыКлиентСервер_Ei.ЗаписатьСтроку(ПолноеИмя,Содержание);
	Возврат ПолноеИмя;
КонецФункции

#Область Проект
// Создать файл проекта, содержимое файла .project
// 
// Параметры:
//  Путь 	- Строка - 
//  Имя 	- Строка -
//	Тип		- Строка - Тип проекта V8ExtensionNature или V8ExternalObjectsNature
//
Процедура СоздатьФайлПроекта(Путь, Имя, Тип = "V8ExtensionNature") Экспорт
	ЗаписьXML 		= Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(Путь +ИмяГлФайлаПроекта());
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента(ОписаниеПроекта());
		ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст(Имя);ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("buildSpec");
		ЗаписьXML.ЗаписатьНачалоЭлемента("buildCommand");
			ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст("org.eclipse.xtext.ui.shared.xtextBuilder");ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("natures");
			ЗаписьXML.ЗаписатьНачалоЭлемента("nature");ЗаписьXML.ЗаписатьТекст("org.eclipse.xtext.ui.shared.xtextNature");ЗаписьXML.ЗаписатьКонецЭлемента();
			ЗаписьXML.ЗаписатьНачалоЭлемента("nature");ЗаписьXML.ЗаписатьТекст("com._1c.g5.v8.dt.core."+Тип);ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьКонецЭлемента();	
	ЗаписьXML.Закрыть();			
КонецПроцедуры

// Создать определение.
// 
// Параметры:
//  Форма 	см. Обработка.Ei.Форма.Форма
//  Путь 	-Строка - имя папки сохранения проекта
//
// Возвращаемое значение:
//  Строка - путь к файлу определения проекта
Асинх Функция СоздатьОпределение(Форма,Путь) Экспорт
	Свойства 				= Новый СписокЗначений();
	КаталогИсходныхКодов 	= НастройкиПользователяКлиентСервер_Ei.ПолучитьКаталогИсходногоКода(Форма.НастройкиПользователя);	
	СвойстваОпределения 	= Ждать ПолучитьСвойстваОпределениеПроекта(КаталогИсходныхКодов);
	Свойства.Добавить("1.0", 															"Manifest-Version");
	Свойства.Добавить(ВерсияПлатформы(СвойстваОпределения.Получить("Runtime-Version")), "Runtime-Version");
	Свойства.Добавить(Ждать ПолучитьИмяПроекта(КаталогИсходныхКодов,Ложь),				"Base-Project"); 
	Текст = СобратьСвойства(Свойства);
	КаталогОпределение 	= Ждать СоздатьКаталогАсинх(Путь+ОпределениеПроекта().Каталог);
	ФайлОпределения = СтрШаблон("%1\%2", КаталогОпределение, ОпределениеПроекта().ИмяФайла);
	ФайлыКлиентСервер_Ei.ЗаписатьСтроку(ФайлОпределения, Текст);
	Возврат ФайлОпределения;
КонецФункции

#КонецОбласти




#Область Обработка
// Подготавливает XML обработки в памяти, сохраняя посторонние объекты и свойства.
// Прежний .mdo остается на диске до окончания сохранения всех файлов.
//
// Параметры:
//  Каталог - Строка - каталог исходников
//  Ключ - Строка, УникальныйИдентификатор - ключ обработки
//  Имя - Строка - имя обработки
//  КаталогПроекта - Строка - каталог, из которого Ei открывает исходники
//
// Возвращаемое значение:
//  Структура:
//   * ЗаписьXML - ЗаписьXML - запись нового XML в строку
//   * Каталог - Строка - каталог обработки
//   * ИмяФайла - Строка - путь к .mdo
//   * ОбъектыEi - Массив из Структура - прежние объекты Ei:
//    ** Тип - Строка - Forms или Templates
//    ** Имя - Строка - имя каталога
Асинх Функция ПолучитьМетаданныеОбработки(Каталог, Ключ, Имя, КаталогПроекта = "") Экспорт
	КаталогОбъекта	= Ждать СоздатьКаталогАсинх(СтрШаблон("%1\%2%3%4", Каталог, ВнешОбработка(), ОкончаниеКласса(), Имя));
	ФайлМетаданных	= Новый Файл(СтрШаблон("%1\%2.mdo", КаталогОбъекта, Имя));
	СоставДоСохранения = Неопределено;
	Если Ждать ФайлМетаданных.СуществуетАсинх() Тогда
		//EDT пишет UTF-8 без BOM: автоматическое определение ЧтениеТекста выбирает системную кодировку.
		ЧтениеМетаданных = Новый ЧтениеТекста(ФайлМетаданных.ПолноеИмя, КодировкаТекста.UTF8);
		ТекстМетаданных = ЧтениеМетаданных.Прочитать();
		ЧтениеМетаданных.Закрыть();
		СоставДоСохранения = СоставОбработкиПередСохранением(ТекстМетаданных);
	КонецЕсли;
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("mdclass:" + ВнешОбработка());
	СоздатьЗаголовокМетаданных(ЗаписьXML, Ключ, Имя, Имя);
	Комментарий = ?(СоставДоСохранения = Неопределено, "", СоставДоСохранения.Комментарий);
	Если Не ПустаяСтрока(КаталогПроекта) Тогда
		СтрокиКомментария = Новый Массив;
		Для Каждого СтрокаКомментария Из СтрРазделить(СтрЗаменить(Комментарий, Символы.ВК, ""), Символы.ПС, Ложь) Цикл
			Если Не СтрНачинаетсяС(СтрокаКомментария, "Ei.Source=") Тогда
				СтрокиКомментария.Добавить(СтрокаКомментария);
			КонецЕсли;
		КонецЦикла;
		СтрокиКомментария.Добавить("Ei.Source=" + КаталогПроекта);
		ЗаписатьКомментарий(ЗаписьXML, СтрСоединить(СтрокиКомментария, Символы.ПС));
	КонецЕсли;
	Результат = Новый Структура("ЗаписьXML,Каталог,ИмяФайла", ЗаписьXML, КаталогОбъекта, ФайлМетаданных.ПолноеИмя);
	Результат.Вставить("ОбъектыEi", Новый Массив);
	Если СоставДоСохранения <> Неопределено Тогда
		Результат.ОбъектыEi = СоставДоСохранения.ОбъектыEi;
		Для Каждого ЭлементXML Из СоставДоСохранения.СохраняемыеЭлементы Цикл
			Если Не СтрНачинаетсяС(СокрЛП(ЭлементXML), "<defaultForm")
				И (ПустаяСтрока(КаталогПроекта) Или Не СтрНачинаетсяС(СокрЛП(ЭлементXML), "<comment")) Тогда
				ЗаписьXML.ЗаписатьБезОбработки(ЭлементXML);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ЗаписьXML.ЗаписатьНачалоЭлемента("producedTypes");
		ЗаписьXML.ЗаписатьНачалоЭлемента("objectType");
		ЗаписьXML.ЗаписатьАтрибут("typeId", "84b95e37-cdd8-4e7c-a768-5383fe41da0a");
		ЗаписьXML.ЗаписатьАтрибут("valueTypeId", "248e5668-d58d-45f5-abe1-a29717d7428b");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("containedObjects");
		ЗаписьXML.ЗаписатьАтрибут("classId", "c3831ec8-d8d5-4f93-8a22-f9bfae07327f");
		ЗаписьXML.ЗаписатьАтрибут("objectId", "c03af5f4-81e2-4203-887c-2834653e1866");
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЕсли;
	Возврат Результат;
КонецФункции


// Создать форму обработки
// 
// Параметры:
//  Путь 		- Строка
//  Содержание 	- Строка
//  Имя 		- Строка
//  Ключ 		- Строка
//  Синоним 		- Неопределено,Строка-
//  ИмяОбработки	- Неопределено,Строка 
// 
// Возвращаемое значение:
//  см.  ЗаписатьМодуль
Асинх Функция СоздатьФормуОбработки(Путь, Содержание, Имя, Ключ, Синоним = Неопределено,ИмяОбработки) Экспорт
	Ждать ПроверитьПринадлежностьОбъекта(Путь, Имя, Истина);
	Каталог	= Ждать СоздатьОписаниеФормы(Путь,Ключ,Имя,Синоним,ИмяОбработки);
	Возврат ЗаписатьМодуль(Каталог,Содержание);
КонецФункции

// Создать макет обработки
// 
// Параметры:
//  Путь 		- Строка
//  Содержание 	- Строка
//  Имя 		- Строка
//  Ключ 		- Строка
//  ТипМакета 	- Строка - см. ТипыМакетов
//  Синоним 	- Неопределено - Синоним
// 
// Возвращаемое значение:
//  см.  ЗаписатьМакет
Асинх Функция СоздатьМакетОбработки(Путь, Содержание, Имя, Ключ, ТипМакета, Синоним = Неопределено) Экспорт
	Ждать ПроверитьПринадлежностьОбъекта(Путь, Имя, Ложь);
	КаталогМакетов 	= Ждать СоздатьКаталогАсинх(СтрШаблон("%1\%2",Путь,ТипыМетаданных().Макеты));
	Каталог 		= Ждать СоздатьКаталогАсинх(СтрШаблон("%1\%2",КаталогМакетов,Имя));
	Возврат ЗаписатьМакет(Каталог, Содержание, ТипМакета);
КонецФункции


// Записать состав обработки.
// 
// Параметры:
//  ЗаписьXML 		- ЗаписьXML - Метаданные обработки
//  СтрРезультат 	см. ФайлыКлиент_Ei.РезультатСохранения
//	СтрНаборов 		см. ВариантыКлиентСервер_Ei.ПолучитьВариант  
//
Процедура ЗаписатьСоставОбработки(ЗаписьXML,СтрРезультат,СтрНаборов) Экспорт
	Перем Набор, НаборРодитель;
	ИмяОбработки = НаборВариантовКлиентСервер_Ei.ПолучитьИмяНабора(СтрНаборов);
	Если ЗначениеЗаполнено(ИмяОбработки) Тогда
		ЗаписьXML.ЗаписатьНачалоЭлемента("defaultForm");
		ЗаписьXML.ЗаписатьТекст(СтрШаблон("%1.%2.Form.%3", ВнешОбработка(), ИмяОбработки, ФормаНабораКлиент_Ei.ИмяФормы()));
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЕсли;
	Для Каждого Набор ИЗ СтрРезультат Цикл
		Состав = Набор.Значение;
		Для Каждого СтрСохранения ИЗ Состав Цикл
			Если СтрСохранения.Свойство("КлючБлока") Тогда
				Продолжить;
			КонецЕсли;
			КлассСсылки = ПолучитьКлассСсылки(ОбщегоНазначенияКлиентСервер_Ei.СтрНачалоДо(СтрСохранения.Ссылка,"."));
			ЗаписьXML.ЗаписатьНачалоЭлемента(КлассСсылки);
			ЗаписьXML.ЗаписатьАтрибут("uuid", СтрСохранения.Ключ);
			ЗаписьXML.ЗаписатьНачалоЭлемента("name");ЗаписьXML.ЗаписатьТекст(СтрСохранения.Имя);ЗаписьXML.ЗаписатьКонецЭлемента();
			Если СтрСохранения.Свойство("Синоним") Тогда
				ЗаписатьСиноним(ЗаписьXML,СтрСохранения.Синоним);	
			КонецЕсли;
			Если СтрСохранения.Свойство("Комментарий") Тогда
				ЗаписатьКомментарий(ЗаписьXML,СтрСохранения.Комментарий); //признак параметра
			Иначе	
				//если у набора есть родитель укажем его ключ настроек в комментариях		
				Если СтрНаборов.Свойство(СтрСохранения.Синоним,Набор) И ЗначениеЗаполнено(Набор.Родитель) Тогда
					//для сохранения идентификатора родителя в комментариях
					Если СтрНаборов.Свойство(Набор.Родитель,НаборРодитель) Тогда
						ЗаписатьКомментарий(ЗаписьXML,Строка(НаборРодитель.КлючНастроек));	
					КонецЕсли;		
				КонецЕсли;
			КонецЕсли;		 		
			Если нРег(КлассСсылки) = нРег(ТипыМетаданных().Формы) Тогда
				ЗаписатьМетаданныеФормыОбработки(ЗаписьXML,СтрСохранения);	
			ИначеЕсли нРег(КлассСсылки) = нРег(ТипыМетаданных().Макеты) Тогда
				ЗаписатьМетаданныеМакетаОбработки(ЗаписьXML,СтрСохранения);	
			КонецЕсли;		
			ЗаписьXML.ЗаписатьКонецЭлемента();	
		КонецЦикла;	
	КонецЦикла;
КонецПроцедуры

// Записать восстановленную обработку как самостоятельный проект EDT.
//
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
//  КаталогПроекта - Строка - новый каталог проекта
//  ИмяОбработки - Строка
//  Исходники - см. ВыполнитьВызовСервера_Ei.ВосстановитьНаборИзEPF
//
// Возвращаемое значение:
//  Строка - каталог записанного проекта
Асинх Функция ЗаписатьВосстановленныйПроект(Форма, КаталогПроекта, ИмяОбработки, Исходники) Экспорт
	ПутьПроекта = КаталогПроекта + ПолучитьРазделительПути();
	ИсходныйКаталог = Ждать СоздатьКаталогАсинх(ПутьПроекта + ФайлыКлиентСервер_Ei.КаталогИсходников());
	Запись = Ждать ПолучитьМетаданныеОбработки(ИсходныйКаталог, Исходники.Ключ, ИмяОбработки, КаталогПроекта);
	Объекты = Новый Массив;
	Для Каждого Объект Из Исходники.Объекты Цикл
		Если ПустаяСтрока(Объект.ТипМакета) Тогда
			Ждать СоздатьФормуОбработки(Запись.Каталог, Объект.Текст, Объект.Имя,
				Объект.Ключ, Объект.Синоним, ИмяОбработки);
			Ссылка = "Form." + Объект.Имя;
		Иначе
			Ждать СоздатьМакетОбработки(Запись.Каталог, Объект.Текст, Объект.Имя, Объект.Ключ,
				ТипыМакетов()[Объект.ТипМакета], Объект.Синоним);
			Ссылка = "Template." + Объект.Имя;
		КонецЕсли;
		Объекты.Добавить(Новый Структура("Имя,Ключ,Ссылка,Синоним,Комментарий,ТипМакета",
			Объект.Имя, Объект.Ключ, Ссылка, Объект.Синоним, Объект.Комментарий, Объект.ТипМакета));
	КонецЦикла;
	Наборы = Новый Структура(ИмяОбработки, Новый Структура("Родитель", Неопределено));
	ЗаписатьСоставОбработки(Запись.ЗаписьXML, Новый Структура(ИмяОбработки, Объекты), Наборы);
	Запись.ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписатьМодуль(Запись.Каталог, Исходники.МодульОбъекта, "Object");
	ФайлПроекта = Новый Файл(КаталогПроекта);
	СоздатьФайлПроекта(ПутьПроекта, ФайлПроекта.Имя, "V8ExternalObjectsNature");
	Ждать СоздатьОпределение(Форма, ПутьПроекта);
	ФайлыКлиент_Ei.ЗаписатьXMLСтроку(Запись.ИмяФайла, Запись.ЗаписьXML.Закрыть());
	Возврат КаталогПроекта;
КонецФункции

// Модуль объекта общей формы: общая обвязка запуска и типы для EDT.
// Выбор и вызов блоков находятся в модуле формы КодНабораEi.
//
// Параметры:
//  СтрНаборов - Структура из КлючИЗначение - строки набора
//
// Возвращаемое значение:
//  Строка
Функция ТекстМодуляОбъекта(СтрНаборов) Экспорт
	ТипОбъекта			= ВозвращаетОбъектОбработки(); //строки и варианты набора - объект этой же обработки
	ВидыВариантов	= Новый СписокЗначений;
	Для Каждого ЭлВарианта Из ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
		ВидыВариантов.Добавить(ЭлВарианта.Ключ);
	КонецЦикла;
	ВидыВариантов.СортироватьПоЗначению();
	
	Строки = Новый Массив; // Массив из Строка
	Строки.Добавить("//Формируется см. ФайлыКлиент_Ei.СохранитьВКаталогОбработки");
	Строки.Добавить("//Общая обвязка запуска Ei. Код набора находится в форме КодНабораEi.");
	Строки.Добавить("#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда");
	Строки.Добавить("");
	Строки.Добавить("#Область ОписаниеПеременных");
	Строки.Добавить("");
	//объект строки или варианта передается новому объекту обработки этой переменной, см. НовыйОбъект в СлужебныеФункцииМодуляОбъекта
	Строки.Добавить("//@skip-check object-module-export-variable");
	Строки.Добавить("Перем ОбъектEi Экспорт; // строка или вариант Ei, с которыми работает объект; Неопределено - текущая строка набора");
	Строки.Добавить("");
	Строки.Добавить("#КонецОбласти");
	Строки.Добавить("");
	Строки.Добавить("#Область ПрограммныйИнтерфейс");

	ДобавитьОписаниеФункции(Строки, "ХешИсходниковEi()",
		"SHA-256 исходников этой сборки. Ei обновляет значение до сборки в EDT.",
		"", "Строка", "Возврат """"; //<EiХешИсходников>");
	
	ДобавитьОписаниеФункции(Строки, "Параметры(ИмяПараметра = Неопределено, ИмяНабора = Неопределено, Форма = Неопределено)",
		"Значение параметра строки набора, выражение параметра вычисляется при обращении.",
		"ИмяПараметра - Строка, Неопределено - имя параметра, без имени - структура всех параметров строки;"
		+ "ИмяНабора - Строка, Неопределено - строка набора;"
		+ "Форма - Произвольный - общая форма для регистрации контекста серверного вызова",
		"Произвольный", "Возврат ЗначениеПараметра(ИмяПараметра, ИмяНабора, Форма);");

	ДобавитьОписаниеФункции(Строки, "Наборы(ИмяНабора = Неопределено)",
		"Строка дерева наборов: .Параметры__Имя(), .Варианты__Вид().",
		"ИмяНабора - Строка - имя строки набора", ТипОбъекта,
		"Набор = Неопределено;
		|МодульEi(""НаборВариантовВызовСервера_Ei"").Наборы(Набор, ИмяНабора);
		|Возврат НовыйОбъект(Набор);");

	ДобавитьОписаниеФункции(Строки, "Варианты(ИмяВарианта = Неопределено)",
		"Вариант строки набора: .Результат(), .Данные(), .Выполнить_().",
		"ИмяВарианта - Строка - " + СтрСоединить(ВидыВариантов.ВыгрузитьЗначения(), ", "), ТипОбъекта,
		"Если ОбъектEi = Неопределено Тогда
		|	ИмяНабора	= МодульEi(""НаборВариантовВызовСервера_Ei"").ПолучитьТекущийНабор();
		|	Вариант		= МодульEi(""ВариантыВызовСервера_Ei"").Варианты(ИмяНабора, ИмяВарианта);
		|Иначе
		|	Вариант		= ОбъектEi.Варианты(ИмяВарианта);
		|КонецЕсли;
		|Возврат НовыйОбъект(Вариант);");
	Для Каждого ВидВарианта Из ВидыВариантов Цикл
		ДобавитьОписаниеФункции(Строки, СтрШаблон("Варианты__%1()", ВидВарианта.Значение),
			СтрШаблон("Вариант %1 строки набора, в Ei Варианты(""%1"").", ВидВарианта.Значение), "", ТипОбъекта,
			СтрШаблон("Возврат Варианты(""%1"");", ВидВарианта.Значение));
	КонецЦикла;

	ДобавитьОписаниеФункции(Строки, "Результат(СрокЖизниИлиИмяЭлемента = 1200)",
		"Результат варианта не старше СрокЖизни секунд (0 - выполнить заново) или результат элемента процесса по имени.",
		"СрокЖизниИлиИмяЭлемента - Число, Строка - срок жизни результата варианта или имя элемента процесса", "Произвольный",
		"Если ОбъектEi = Неопределено Тогда
		|	Значение = МодульEi(""ОбъектыВызовСервера_Ei"").ПолучитьРезультат(СрокЖизниИлиИмяЭлемента);
		|Иначе
		|	Значение = ОбъектEi.Результат(СрокЖизниИлиИмяЭлемента);
		|КонецЕсли;
		|Возврат Значение;");
	ДобавитьОписаниеФункции(Строки, "Данные(Источник = Неопределено)",
		"Данные варианта, с источником - задать данные коллекции, как команда «Загрузить».",
		"Источник - Произвольный - новые данные варианта", "Произвольный", "Возврат ОбъектEi.Данные(Источник);");
	ДобавитьОписаниеФункции(Строки, "Выполнить_(ЗаменПараметры = Неопределено)",
		"Выполнить вариант с подмененными параметрами, результат не запоминается.",
		"ЗаменПараметры - Структура, Неопределено - параметры, которые заменяются на время выполнения", "Произвольный",
		"Возврат ОбъектEi.Выполнить_(ЗаменПараметры);");
	ДобавитьОписаниеФункции(Строки, "Объект()", "Объект элемента варианта Процессы.", "", "Произвольный",
		"Возврат МодульEi(""ОбъектыВызовСервера_Ei"").Получить();");
	ДобавитьОписаниеФункции(Строки, "Клиент()",
		"Сеанс пользователя: .История(НавСсылка), .Избранное(НавСсылка), .Формы(УИД).Реквизиты(Имя).", "", "Произвольный",
		"Возврат МодульEi(""Обработки"").ОбъектКлиент_Ei.Создать();");
	ДобавитьОписаниеФункции(Строки, "Пауза(Секунд)", "Пауза выполнения.", "Секунд - Число - длительность паузы", "",
		"МодульEi(""ОбщегоНазначенияКлиентСервер_Ei"").Ожидать(Секунд);");
	//одно тело на обработку вместо копии в каждой форме: форма вызывает его из ПриСозданииНаСервере одной строкой,
	//см. ВариантАлгоритмКлиентСервер_Ei.ОбработчикСозданияФормы. Форма без типа: у формы внешней обработки он неизвестен EDT
	ДобавитьОписаниеФункции(Строки, "ВыполнитьФорму(Форма, Отказ)",
		"Выполнить форму алгоритма или параметра-выражения для Ei (команда «Выполнить в обработке EDT»), вызывается из ее ПриСозданииНаСервере:"
			+ " с параметром формы АдресРезультата форма вычисляет Результат и кладет туда значение (с ИдентификаторФормыEi - описание результата для формы Ei),"
			+ " а сама не создается. Во временное хранилище кладется только значение.",
		"Форма - Произвольный - форма алгоритма или параметра-выражения этой обработки;Отказ - Булево - отказ от создания формы",
		"",
		"АдресРезультата = Неопределено;
		|Если Форма.Параметры.Свойство(""АдресРезультата"", АдресРезультата) Тогда
		|	Значение = Форма.Результат();
		|	ИдентификаторФормыEi = Неопределено;
		|	Если Форма.Параметры.Свойство(""ИдентификаторФормыEi"", ИдентификаторФормыEi) Тогда
		|		Значение = МодульEi(""ВыполнитьКлиентСервер_Ei"").ПослеВычисленияЗначения(Значение, Неопределено, ИдентификаторФормыEi);
		|	КонецЕсли;
		|	ПоместитьВоВременноеХранилище(Значение, АдресРезультата);
		|	Отказ = Истина;
		|КонецЕсли;");
	ДобавитьОписаниеФункции(Строки, "ВыполнитьОбщуюФорму(Форма, Отказ)",
		"Выполняет код общей формы набора в ее текущем серверном вызове.",
		"Форма - Произвольный - общая форма набора;Отказ - Булево - отказ от создания формы", "",
		"МодульEi(""ВыполнениеФормыНабораСервер_Ei"").ВыполнитьФорму(Форма, Отказ);");
	
	Строки.Добавить("");
	ДобавитьОписанияТиповEDT(Строки, СтрНаборов);
	Строки.Добавить("#КонецОбласти");
	Строки.Добавить("");
	Строки.Добавить(СлужебныеФункцииМодуляОбъекта());
	Строки.Добавить("");
	Строки.Добавить("#Иначе");
	Строки.Добавить("ВызватьИсключение НСтр(""ru = 'Недопустимый вызов объекта на клиенте.'"");");
	Строки.Добавить("#КонецЕсли");
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область Расширение

Асинх Функция СоздатьМетаданныеПодсистемы(Каталог, Ключ, Имя,  мСостав, СтрНаборов) Экспорт
	Заголовок = Ждать ПолучитьЗаголовокМетаданных(Подсистема(),Каталог, Ключ, Имя);
	ЗаписьXML = Заголовок.ЗаписьXML;
	Для Каждого СтрСохранения ИЗ мСостав Цикл
		ЗаписьXML.ЗаписатьНачалоЭлемента("content");ЗаписьXML.ЗаписатьТекст(СтрСохранения.Ссылка);ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Для Каждого СтрНабор ИЗ СтрНаборов Цикл
		Набор 		= СтрНабор.Значение;
		Если Набор.Родитель =  Имя Тогда
			КлассПодсистемы = ПолучитьКлассСсылки(Подсистема());
			ЗаписьXML.ЗаписатьНачалоЭлемента(КлассПодсистемы);ЗаписьXML.ЗаписатьТекст(Набор.Имя);ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЕсли;	

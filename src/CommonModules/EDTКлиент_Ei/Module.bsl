Асинх Функция СоздатьМетаданныеОбщегоМодуля(Каталог,Ключ, Имя, Синоним)
	Заголовок = Ждать ПолучитьЗаголовокМетаданных("CommonModule",Каталог, Ключ, Имя);
	ЗаписьXML = Заголовок.ЗаписьXML;
	ЗаписьXML.ЗаписатьНачалоЭлемента("server");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("serverCall");ЗаписьXML.ЗаписатьТекст("true");ЗаписьXML.ЗаписатьКонецЭлемента();	 
	ЗаписьXML.ЗаписатьКонецЭлемента();	
	ЗаписьXML.Закрыть();
	Возврат Заголовок.Каталог;	
КонецФункции

Асинх Функция СоздатьМетаданныеОбщегоМакета(Каталог,Ключ, Имя, Синоним)
	Заголовок = Ждать ПолучитьЗаголовокМетаданных("CommonTemplate",Каталог, Ключ, Имя);
	ЗаписьXML = Заголовок.ЗаписьXML;
	ЗаписьXML.ЗаписатьНачалоЭлемента("templateType");ЗаписьXML.ЗаписатьТекст("TextDocument");ЗаписьXML.ЗаписатьКонецЭлемента(); 
	ЗаписьXML.ЗаписатьКонецЭлемента();	
	ЗаписьXML.Закрыть();		
	Возврат Заголовок.Каталог;	
КонецФункции

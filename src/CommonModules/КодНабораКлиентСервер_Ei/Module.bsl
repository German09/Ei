#Область ПрограммныйИнтерфейс

// Читает описание строк и виртуальных частей из общей формы.
//
// Параметры:
//  Текст - Строка - модуль формы
//
// Возвращаемое значение:
//  Структура, Неопределено - состав набора, Неопределено у старого формата
Функция ПрочитатьСостав(Текст) Экспорт
	Результат = Неопределено;
	Для Каждого Лексема Из Лексемы(Текст) Цикл
		Если Лексема.Вид = "Комментарий" И СтрНачинаетсяС(Лексема.Текст, "//<EiСостав ") Тогда
			Если Результат <> Неопределено Тогда
				ВызватьИсключение НСтр("ru = 'В общей форме Ei повторяется описание состава набора'");
			КонецЕсли;
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(Сред(Лексема.Текст, СтрДлина("//<EiСостав ") + 1));
			Результат = ПрочитатьJSON(Чтение);
			Чтение.Закрыть();
			Если ТипЗнч(Результат) <> Тип("Структура") Тогда
				ВызватьИсключение НСтр("ru = 'Некорректное описание состава общей формы Ei'");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции


// Устойчивый ключ содержимого выражения для диспетчера общей формы.
// Не содержит копии пользовательского кода.
//
// Параметры:
//  Код - Строка - текст Ei
//
// Возвращаемое значение:
//  Строка
Функция КлючКода(Код) Экспорт
	Модуль = ВыполнитьКлиентСервер_Ei.ПолучитьМодуль(СтрЗаменить(Код, Символы.ВК, ""));
	Текст = СокрЛП(Модуль.СодержимоеГлавнойФункции);
	Если ЗначениеЗаполнено(Модуль.ПроцедурыФункции) Тогда
		Текст = Текст + Символы.ПС + СокрЛП(Модуль.ПроцедурыФункции);
	КонецЕсли;
	Возврат ОбщегоНазначенияВызовСервера_Ei.ПолучитьХешСтроки(Текст);
КонецФункции

// Собирает общий модуль формы из самостоятельных блоков кода.
// Диспетчер вызывает функции непосредственно, без исполнения текста.
//
// Параметры:
//  Блоки - Массив из Строка - результаты ТекстБлока
//  Состав - Структура, Неопределено - описание строк и логических частей набора
//
// Возвращаемое значение:
//  Строка
Функция ТекстМодуля(Блоки, Состав = Неопределено) Экспорт
	Строки = Новый Массив;
	Если Состав <> Неопределено Тогда
		Строки.Добавить("//<EiСостав " + СтрокаJSON(Состав));
	КонецЕсли;
	Строки.Добавить("//Общая форма набора Ei. Пользовательский код сгруппирован по строкам набора.");
	Строки.Добавить("#Область ОбработчикиСобытийФормы");
	Строки.Добавить("&НаСервере");
	Строки.Добавить("Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)");
	Строки.Добавить("	Адрес = Неопределено;");
	Строки.Добавить("	Если Параметры.Свойство(""АдресКонтекстаEi"", Адрес) Тогда");
	Строки.Добавить("		АдресКонтекстаEi = Адрес;");
	Строки.Добавить("	КонецЕсли;");
	Строки.Добавить("	ОбработкаEi = РеквизитФормыВЗначение(""ОбъектОбработкиEi"");");
	Строки.Добавить("	Если Адрес <> Неопределено Или Параметры.Свойство(""АдресРезультата"") Тогда");
	Строки.Добавить("		ОбработкаEi.ВыполнитьОбщуюФорму(ЭтотОбъект, Отказ);");
	Строки.Добавить("	Иначе");
	Строки.Добавить("		МетаданныеEi = ОбработкаEi.Метаданные();");
	Строки.Добавить("		ИмяНабораEi = МетаданныеEi.Имя;");
	Строки.Добавить("		Для Каждого СтрокаКомментария Из СтрРазделить(СтрЗаменить(МетаданныеEi.Комментарий, Символы.ВК, """"), Символы.ПС) Цикл");
	Строки.Добавить("			Если СтрНачинаетсяС(СтрокаКомментария, ""Ei.Source="") Тогда");
	Строки.Добавить("				КаталогНабораEi = Сред(СтрокаКомментария, СтрДлина(""Ei.Source="") + 1);");
	Строки.Добавить("				Прервать;");
	Строки.Добавить("			КонецЕсли;");
	Строки.Добавить("		КонецЦикла;");
	Строки.Добавить("	КонецЕсли;");
	Строки.Добавить("КонецПроцедуры");
	Строки.Добавить("");
	Строки.Добавить("&НаКлиенте");
	Строки.Добавить("Процедура ПриОткрытии(Отказ)");
	Строки.Добавить("	Если ЗначениеЗаполнено(КаталогНабораEi) Тогда");
	Строки.Добавить("		ПараметрыEi = Новый Структура(""КаталогНабораEi,ИмяНабораEi"", КаталогНабораEi, ИмяНабораEi);");
	Строки.Добавить("		ИмяФормыEi = ""Обработка.Ei.Форма.Форма"";");
	Строки.Добавить("		ОткрытьФорму(ИмяФормыEi, ПараметрыEi, , Новый УникальныйИдентификатор);");
	Строки.Добавить("		Отказ = Истина;");
	Строки.Добавить("	КонецЕсли;");
	Строки.Добавить("КонецПроцедуры");
	Строки.Добавить("");
	Строки.Добавить("#КонецОбласти");
	Строки.Добавить("#Область СлужебныеПроцедурыИФункции");
	ВсеБлоки = ПрочитатьБлоки(СтрСоединить(Блоки, Символы.ПС));
	Если ВсеБлоки.Количество() > 0 Тогда
		ДобавитьГруппыБлоков(Строки, ВсеБлоки, Состав);
	КонецЕсли;
	Строки.Добавить("#Область ВыполнениеEi");
	Строки.Добавить("//@skip-check export-method-in-command-form-module");
	Строки.Добавить("// Возвращаемое значение:");
	Строки.Добавить("//  Произвольный");
	Строки.Добавить("&НаСервере");
	Строки.Добавить("Функция Результат() Экспорт");
	Строки.Добавить("	КлючБлока = Неопределено;");
	Строки.Добавить("	Если Не Параметры.Свойство(""КлючБлока"", КлючБлока) Тогда");
	Строки.Добавить("		ВызватьИсключение НСтр(""ru = 'Не указан блок общей формы для выполнения'"");");
	Строки.Добавить("	КонецЕсли;");
	Строки.Добавить("	Возврат ВыполнитьБлокEi(КлючБлока);");
	Строки.Добавить("КонецФункции");
	ПоКлючу = Новый Массив;
	КлиентскиеБлоки = Новый Массив;
	Для Каждого Блок Из ВсеБлоки Цикл
		Режим = Неопределено;
		Если Блок.Значение.Описание.Свойство("РежимКомпиляции", Режим) Тогда
			КлиентскиеБлоки.Добавить(Блок.Значение);
		КонецЕсли;
		Вызов = ИмяМетода(Блок.Ключ) + ?(Режим = "КлиентСервер", "(ЭтотОбъект)", "()");
		ПоКлючу.Добавить("	" + ?(ПоКлючу.Количество() = 0, "Если", "ИначеЕсли")
			+ " Ключ = """ + Блок.Ключ + """ Тогда");
		Если Режим = "Клиент" Тогда
			Сообщение = СтрШаблон(НСтр("ru = 'Алгоритм строки %1 компилируется только на клиенте'"), Блок.Значение.Описание.ИмяСтроки);
			ПоКлючу.Добавить("		ВызватьИсключение " + ("""" + СтрЗаменить(Сообщение, """", """""") + """") + ";");
		Иначе
			ПоКлючу.Добавить("		Значение = " + Вызов + ";");
		КонецЕсли;
	КонецЦикла;
	ДобавитьДиспетчер(Строки, "ВыполнитьБлокEi", ПоКлючу);
	Строки.Добавить("//@skip-check export-method-in-command-form-module");
	Строки.Добавить("// Параметры:");
	Строки.Добавить("//  Ключ - Строка - ключ содержимого выражения");
	Строки.Добавить("// Возвращаемое значение:");
	Строки.Добавить("//  Произвольный");
	Строки.Добавить("&НаСервере");
	Строки.Добавить("Функция ВыполнитьКодEi(Ключ) Экспорт");
	Строки.Добавить("	КлючиКода = Неопределено;");
	Строки.Добавить("	Если Не Параметры.Свойство(""КлючиКодаEi"", КлючиКода) Тогда");
	Строки.Добавить("		КлючиКода = ПолучитьИзВременногоХранилища(АдресКонтекстаEi);");
	Строки.Добавить("	КонецЕсли;");
	Строки.Добавить("	Возврат ВыполнитьБлокEi(КлючиКода.Получить(Ключ));");
	Строки.Добавить("КонецФункции");
	Если КлиентскиеБлоки.Количество() > 0 Тогда
		ДобавитьКлиентскоеВыполнение(Строки, КлиентскиеБлоки);
	КонецЕсли;
	ДобавитьПараметрыФормы(Строки, ВсеБлоки, Состав);
	Строки.Добавить("#КонецОбласти");
	Строки.Добавить("#КонецОбласти");
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции



// Описание части кода общей формы. Ключ не меняется при переименовании.
// Ссылка формируется штатным механизмом навигации Ei.
//
// Параметры:
//  Ключ - Строка - прослеживаемый идентификатор части
//  КлючСтроки - Строка - ключ настроек строки
//  ИмяСтроки - Строка - имя строки
//  КодВарианта - Строка - код варианта
//  Имя - Строка - имя параметра или части
//  КлючПараметра - Строка - ключ параметра, пустой у варианта
//  Владелец - Строка - ключ схемы процесса, пустой у самостоятельного блока
//
// Возвращаемое значение:
//  Структура - описание блока:
 //  * Версия - Число
 //  * Ключ - Строка
 //  * КлючСтроки - Строка
 //  * ИмяСтроки - Строка
 //  * КодВарианта - Строка
 //  * Имя - Строка
 //  * КлючПараметра - Строка
 //  * Владелец - Строка
 //  * Ссылка - Строка
Функция ОписаниеБлока(Ключ, КлючСтроки, ИмяСтроки, КодВарианта, Имя, КлючПараметра = "", Владелец = "") Экспорт
	Идентификатор = НавигационныеСсылкиКлиентСервер_Ei.Идентификатор(КлючСтроки, КодВарианта, КлючПараметра);
	Результат = Новый Структура;
	Результат.Вставить("Версия", 1);
	Результат.Вставить("Ключ", НРег(Строка(Ключ)));
	Результат.Вставить("КлючСтроки", Строка(КлючСтроки));
	Результат.Вставить("ИмяСтроки", ИмяСтроки);
	Результат.Вставить("КодВарианта", КодВарианта);
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("КлючПараметра", КлючПараметра);
	Результат.Вставить("Владелец", Владелец);
	Результат.Вставить("Ссылка", НавигационныеСсылкиВызовСервера_Ei.Ссылка(Идентификатор, ИмяСтроки + ": " + Имя));
	Возврат Результат;
КонецФункции

// Текст отдельного блока общей формы. Пользовательский код хранится только здесь.
// Имена собственных методов изолированы ключом блока. Строки, комментарии и
// обращения к методам других объектов при преобразовании не меняются.
//
// Параметры:
//  Описание - см. ОписаниеБлока
//  Код - Строка - исходный код Ei
//  ОписаниеРезультата - Строка - ссылка на тип в модуле объекта
//
// Возвращаемое значение:
//  Строка
Функция ТекстБлока(Описание, Код, ОписаниеРезультата = "Произвольный") Экспорт
	ПроверитьОписание(Описание);
	Модуль = ВыполнитьКлиентСервер_Ei.ПолучитьМодуль(Код);
	Если ЗначениеЗаполнено(Модуль.ПроцедурыФункции) Тогда
		Модуль.ПроцедурыФункции = КонтекстВспомогательныхМетодов(Модуль.ПроцедурыФункции);
	КонецЕсли;
	Текст = ВариантАлгоритмКлиентСервер_Ei.ПодготовитьМодуль(Модуль, Истина, ОписаниеРезультата, Ложь);
	Режим = Неопределено;
	Если Описание.Свойство("РежимКомпиляции", Режим) Тогда
		Текст = СтрЗаменить(Текст, Символы.Таб + "//@skip-check module-unused-local-variable" + Символы.ПС
			+ Символы.Таб + "Модуль = РеквизитФормыВЗначение(""ОбъектОбработкиEi"");" + Символы.ПС, "");
		Если Режим = "КлиентСервер" Тогда
			СлужебнаяГраница = СтрНайти(Текст, "//Ei>");
			ЗаголовокФункции = Лев(Текст, СлужебнаяГраница - 1);
			ТелоФункции = Сред(Текст, СлужебнаяГраница);
			ЗаголовокФункции = СтрЗаменить(ЗаголовокФункции, "//Возвращаемое значение:",
				"// Параметры:" + Символы.ПС + "//  Модуль - Произвольный - обвязка текущего контекста" + Символы.ПС
				+ "//" + Символы.ПС + "//Возвращаемое значение:");
			ЗаголовокФункции = СтрЗаменить(ЗаголовокФункции, "&НаСервере" + Символы.ПС + "Функция Результат() Экспорт",
				"//@skip-check bsl-legacy-check-dynamic-feature-access" + Символы.ПС
				+ "&НаКлиентеНаСервереБезКонтекста" + Символы.ПС + "Функция Результат(Модуль) Экспорт");
			Текст = ЗаголовокФункции + ТелоФункции;
		Иначе
			Текст = СтрЗаменить(Текст, "&НаСервере" + Символы.ПС, "&НаКлиенте" + Символы.ПС);
		КонецЕсли;
	КонецЕсли;
	Если Режим <> "КлиентСервер" Тогда
		Текст = ПрямыеВызовыПараметров(Текст);
	КонецЕсли;
	Текст = ПреобразоватьМетоды(Текст, ПрефиксМетодов(Описание.Ключ), Ложь);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, ""));
	ЗаписатьJSON(Запись, Описание);
	Заголовок = Запись.Закрыть();
	Возврат НачалоБлока() + Заголовок + Символы.ПС
		+ "// " + Описание.Ссылка + Символы.ПС
		+ "#Область " + ИмяОбластиБлока(Описание) + Символы.ПС
		+ Текст + Символы.ПС
		+ "#КонецОбласти" + Символы.ПС
		+ КонецБлока() + Символы.ПС;
КонецФункции

// Читает блоки единого модуля формы. Маркеры внутри строковых литералов
// не являются разметкой. Поврежденная или неоднозначная разметка отклоняется.
//
// Параметры:
//  Текст - Строка - полный модуль формы
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - ключ блока
//   * Значение - Структура:
//    ** Описание - см. ОписаниеБлока
//    ** Текст - Строка - полный текст блока
//    ** Код - Строка - код в формате Ei
Функция ПрочитатьБлоки(Текст) Экспорт
	Результат = Новый Соответствие;
	Открытый = Неопределено;
	Для Каждого Лексема Из Лексемы(Текст) Цикл
		Если Лексема.Вид <> "Комментарий" Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(Лексема.Текст, НачалоБлока()) Тогда
			Если Открытый <> Неопределено Тогда
				ВызватьИсключение НСтр("ru = 'Блок кода Ei начат до окончания предыдущего блока'");
			КонецЕсли;
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(Сред(Лексема.Текст, СтрДлина(НачалоБлока()) + 1));
			Описание = ПрочитатьJSON(Чтение);
			Чтение.Закрыть();
			ПроверитьОписание(Описание);
			Если Результат.Получить(Описание.Ключ) <> Неопределено Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'В модуле формы повторяется ключ блока %1'"), Описание.Ключ);
			КонецЕсли;
			Открытый = Новый Структура("Описание,Начало,НачалоТела", Описание, Лексема.Начало, Лексема.Начало + Лексема.Длина);
		ИначеЕсли Лексема.Текст = КонецБлока() Тогда
			Если Открытый = Неопределено Тогда
				ВызватьИсключение НСтр("ru = 'Окончание блока кода Ei не имеет начала'");
			КонецЕсли;
			ПолныйТекст = Сред(Текст, Открытый.Начало, Лексема.Начало + Лексема.Длина - Открытый.Начало);
			Тело = Сред(Текст, Открытый.НачалоТела, Лексема.Начало - Открытый.НачалоТела);
			Тело = ТелоБлока(Тело);
			Тело = ПреобразоватьМетоды(Тело, ПрефиксМетодов(Открытый.Описание.Ключ), Истина);
			Код = ВариантАлгоритмКлиентСервер_Ei.ПолучитьВыражениеИзМодуля(Тело);
			Результат.Вставить(Открытый.Описание.Ключ, Новый Структура("Описание,Текст,Код", Открытый.Описание, ПолныйТекст, Код));
			Открытый = Неопределено;
		КонецЕсли;
	КонецЦикла;
	Если Открытый <> Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'В модуле формы не закончен блок кода Ei'");
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Проверяет тело блока компилятором текущего контекста.
// Условие Ложь исключает выполнение пользовательских операторов.
//
// Параметры:
//  Код - Строка - код алгоритма Ei
//  ПроверятьОбвязку - Булево - доступность интерфейса Ei на клиенте
//
// Возвращаемое значение:
//  Булево
Функция Компилируется(Код, ПроверятьОбвязку) Экспорт
	Результат = Ложь;
	Попытка
		Текст = ТекстПробыКомпиляции(Код, ПроверятьОбвязку);
		Если ЗначениеЗаполнено(Текст) Тогда
			ВыполнитьКлиентСервер_Ei.ВычислитьБезопасно(Текст, Ложь);
			Результат = Истина;
		КонецЕсли;
	Исключение
		Результат = Ложь; // ошибка компиляции определяет место запуска
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Имя входной функции блока в общей форме.
//
// Параметры:
//  Ключ - Строка - ключ блока
//
// Возвращаемое значение:
//  Строка
Функция ИмяМетода(Ключ) Экспорт
	Возврат ПрефиксМетодов(Ключ) + "Результат";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавляет клиентский вход для выбранных блоков формы.
Процедура ДобавитьКлиентскоеВыполнение(Строки, Блоки)
	Строки.Добавить("");
	Строки.Добавить("//@skip-check export-method-in-command-form-module");
	Строки.Добавить("// Параметры:");
	Строки.Добавить("//  Ключ - Строка - идентификатор выбранного алгоритма");
	Строки.Добавить("// Возвращаемое значение:");
	Строки.Добавить("//  Произвольный");
	Строки.Добавить("&НаКлиенте");
	Строки.Добавить("Функция ВыполнитьНаКлиентеEi(Ключ) Экспорт");
	НачалоВетви = "Если";
	Для Каждого Блок Из Блоки Цикл
		Ключ = Блок.Описание.Ключ;
		Строки.Добавить(СтрШаблон(Символы.Таб + "%1 Ключ = ""%2"" Тогда", НачалоВетви, Ключ));
		Вызов = ИмяМетода(Ключ) + ?(Блок.Описание.РежимКомпиляции = "КлиентСервер", "(ЭтотОбъект)", "()");
		Строки.Добавить(Символы.Таб + Символы.Таб + "Значение = " + Вызов + ";");
		НачалоВетви = "ИначеЕсли";
	КонецЦикла;
	Строки.Добавить("	Иначе");
	Строки.Добавить("		ВызватьИсключение НСтр(""ru = 'У выбранного алгоритма нет клиентского входа'"");");
	Строки.Добавить("	КонецЕсли;");
	Строки.Добавить("	Возврат Значение;");
	Строки.Добавить("КонецФункции");
	
КонецПроцедуры

// Именованные параметры доступны из клиентских и серверных блоков формы.
Процедура ДобавитьПараметрыФормы(Строки, Блоки, Состав)
	ИменаПараметров = Новый СписокЗначений;
	Для Каждого Блок Из Блоки Цикл
		Текст = ВариантАлгоритмКлиентСервер_Ei.ВидДляEDT(Блок.Значение.Код);
		Предыдущий = "";
		ПередПредыдущим = "";
		Для Каждого Токен Из Лексемы(Текст) Цикл
			Если Токен.Вид = "Комментарий" Тогда
				Продолжить;
			КонецЕсли;
			Слово = НРег(Токен.Текст);
			Если Токен.Вид = "Имя" И Предыдущий = "." И ПередПредыдущим = "модуль" Тогда
				Если СтрНачинаетсяС(Слово, "параметры__") Тогда
					Имя = Сред(Токен.Текст, СтрДлина("Параметры__") + 1);
					Если ИменаПараметров.НайтиПоЗначению(НРег(Имя)) = Неопределено Тогда
						ИменаПараметров.Добавить(НРег(Имя), Имя);
					КонецЕсли;

				КонецЕсли;
			КонецЕсли;
			ПередПредыдущим = Предыдущий;
			Предыдущий = Слово;
		КонецЦикла;
	КонецЦикла;
	Если ИменаПараметров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ИменаПараметров.СортироватьПоЗначению();
	Строки.Добавить("");
	Строки.Добавить("#Область ПараметрыEi");
	Для Каждого Параметр Из ИменаПараметров Цикл
		ИмяФункции = ВариантАлгоритмКлиентСервер_Ei.ИмяФункцииПараметра(Параметр.Представление);
		Тип = "Произвольный";
		Если Состав <> Неопределено И Состав.Свойство("ИмяОбработки") Тогда
			Тип = ВариантАлгоритмКлиентСервер_Ei.ОписаниеРезультатаФормы(Состав.ИмяОбработки, ИмяФункции);
		КонецЕсли;
		Строки.Добавить("");
		Строки.Добавить("//@skip-check export-method-in-command-form-module");
		Строки.Добавить("// Возвращаемое значение:");
		Строки.Добавить("//  " + Тип);
		Строки.Добавить("&НаСервере");
		Строки.Добавить("Функция " + ИмяФункции + "() Экспорт");
		Строки.Добавить(СтрШаблон("	Возврат ПараметрНаСервереEi(""%1"");", Параметр.Представление));
		Строки.Добавить("КонецФункции");
	КонецЦикла;
	Строки.Добавить("");
	Строки.Добавить("&НаСервере");
	Строки.Добавить("Функция ПараметрНаСервереEi(Имя)");
	Строки.Добавить("	ОбработкаEi = РеквизитФормыВЗначение(""ОбъектОбработкиEi"");");
	Строки.Добавить("	Возврат ОбработкаEi.Параметры(Имя, Неопределено, ЭтотОбъект);");
	Строки.Добавить("КонецФункции");
	Строки.Добавить("#КонецОбласти");
КонецПроцедуры

Процедура ДобавитьДиспетчер(Строки, Имя, Ветви)
	Строки.Добавить("//@skip-check export-method-in-command-form-module");
	Строки.Добавить("// Параметры:");
	Строки.Добавить("//  Ключ - Строка - идентификатор сохраненного блока");
	Строки.Добавить("// Возвращаемое значение:");
	Строки.Добавить("//  Произвольный");
	Строки.Добавить("&НаСервере");
	Строки.Добавить("Функция " + Имя + "(Ключ) Экспорт");
	Для Каждого Ветвь Из Ветви Цикл
		Строки.Добавить(Ветвь);
	КонецЦикла;
	Если Ветви.Количество() > 0 Тогда
		Строки.Добавить("	Иначе");
	КонецЕсли;
	Строки.Добавить("		ВызватьИсключение НСтр(""ru = 'Выражение отсутствует в общей форме набора: сохраните набор и дождитесь сборки EDT'"");");
	Если Ветви.Количество() > 0 Тогда
		Строки.Добавить("	КонецЕсли;");
		Строки.Добавить("	Возврат Значение;");
	Иначе
		Строки.Добавить("	Возврат Неопределено;");
	КонецЕсли;
	Строки.Добавить("КонецФункции");
	Строки.Добавить("");
КонецПроцедуры

Функция КонтекстВспомогательныхМетодов(Текст)
	Токены = Лексемы(Текст);
	Части = Новый Массив;
	Позиция = 1;
	Индекс = 0;
	КлиентскийМетод = Ложь;
	Пока Индекс < Токены.Количество() Цикл
		Токен = Токены.Получить(Индекс);
		Если Токен.Вид = "Имя" И Индекс > 0
			И Токены.Получить(Индекс - 1).Текст = "&" Тогда
			КлиентскийМетод = СтрНачинаетсяС(НРег(Токен.Текст), "наклиенте")
				Или СтрНачинаетсяС(НРег(Токен.Текст), "atclient");
		КонецЕсли;
		Если Токен.Вид <> "Имя" Или (НРег(Токен.Текст) <> "функция" И НРег(Токен.Текст) <> "процедура"
			И НРег(Токен.Текст) <> "function" И НРег(Токен.Текст) <> "procedure") Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Скобки = 0;
		БылаСкобка = Ложь;
		Пока Индекс < Токены.Количество() Цикл
			Токен = Токены.Получить(Индекс);
			Если Токен.Текст = "(" Тогда
				Скобки = Скобки + 1;
				БылаСкобка = Истина;
			ИначеЕсли Токен.Текст = ")" Тогда
				Скобки = Скобки - 1;
			КонецЕсли;
			Индекс = Индекс + 1;
			Если БылаСкобка И Скобки = 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не БылаСкобка Или Скобки <> 0 Тогда
			ВызватьИсключение НСтр("ru = 'Не закончено объявление вспомогательного метода Ei'");
		КонецЕсли;
		Если Индекс < Токены.Количество() Тогда
			Следующий = Токены.Получить(Индекс);
			Если НРег(Следующий.Текст) = "экспорт" Или НРег(Следующий.Текст) = "export" Тогда
				Токен = Следующий;
				Индекс = Индекс + 1;
			КонецЕсли;
		КонецЕсли;
		НачалоТела = Токен.Начало + Токен.Длина;
		Части.Добавить(Сред(Текст, Позиция, НачалоТела - Позиция));
		Если Не КлиентскийМетод Тогда
		Части.Добавить(Символы.ПС + "//<Ei" + Символы.ПС
			+ "	//@skip-check module-unused-local-variable" + Символы.ПС
			+ "	Модуль = РеквизитФормыВЗначение(""ОбъектОбработкиEi"");" + Символы.ПС + "//Ei>");
		КонецЕсли;
		КонецТела = 0;
		Пока Индекс < Токены.Количество() Цикл
			Токен = Токены.Получить(Индекс);
			Если Токен.Вид = "Имя" И (НРег(Токен.Текст) = "конецфункции" Или НРег(Токен.Текст) = "конецпроцедуры"
				Или НРег(Токен.Текст) = "endfunction" Или НРег(Токен.Текст) = "endprocedure") Тогда
				КонецТела = Токен.Начало;
				Прервать;
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла;
		Если КонецТела = 0 Тогда
			ВызватьИсключение НСтр("ru = 'Не закончен вспомогательный метод Ei'");
		КонецЕсли;
		Тело = Сред(Текст, НачалоТела, КонецТела - НачалоТела);
		Части.Добавить(?(КлиентскийМетод, Тело, ВариантАлгоритмКлиентСервер_Ei.ВидДляEDT(Тело)));
		КлиентскийМетод = Ложь;
		Позиция = КонецТела;
		Индекс = Индекс + 1;
	КонецЦикла;
	Части.Добавить(Сред(Текст, Позиция));
	Возврат СтрСоединить(Части, "");
КонецФункции

// Вызывает типизированный метод этой формы. На сервере он использует тот же контекст выполнения.
Функция ПрямыеВызовыПараметров(Текст)
	Части = Новый Массив;
	Позиция = 1;
	Кандидат = 0;
	Предыдущий = "";
	Для Каждого Токен Из Лексемы(Текст) Цикл
		Слово = НРег(Токен.Текст);
		Если Токен.Вид = "Имя" И Слово = "модуль" И Предыдущий <> "." Тогда
			Кандидат = Токен.Начало;
		ИначеЕсли Кандидат > 0 И Предыдущий = "." И СтрНачинаетсяС(Слово, "параметры__") Тогда
			Части.Добавить(Сред(Текст, Позиция, Кандидат - Позиция));
			Позиция = Токен.Начало;
			Кандидат = 0;
		ИначеЕсли Слово <> "." Тогда
			Кандидат = 0;
		КонецЕсли;
		Предыдущий = Слово;
	КонецЦикла;
	Части.Добавить(Сред(Текст, Позиция));
	Возврат СтрСоединить(Части, "");
КонецФункции

// Запрещает переходы и директивы, которые могли бы изменить границы пробы.
// Отдельно проверяет, что Иначе и закрывающие операторы относятся к исходному телу.
Функция ТекстПробыКомпиляции(Код, ПроверятьОбвязку)
	Разбор = ВыполнитьКлиентСервер_Ei.ПолучитьМодуль(Код);
	Текст = ВариантАлгоритмКлиентСервер_Ei.ТелоПробыКомпиляции(Разбор.СодержимоеГлавнойФункции);
	Допустим = Не ЗначениеЗаполнено(Разбор.ПроцедурыФункции);
	Уровень = 0;
	Предыдущий = "";
	ПередПредыдущим = "";
	Для Каждого Токен Из Лексемы(Текст) Цикл
		Если Токен.Вид = "Комментарий" Тогда
			Продолжить;
		КонецЕсли;
		Слово = НРег(Токен.Текст);
		Если Слово = "#" Или Слово = "&" Или Слово = "~" Тогда
			Допустим = Ложь;
			Прервать;
		КонецЕсли;
		Если Токен.Вид = "Имя" И Предыдущий <> "." Тогда
			Если Слово = "если" Или Слово = "if" Тогда
				Уровень = Уровень + 1;
			ИначеЕсли Слово = "конецесли" Или Слово = "endif" Тогда
				Уровень = Уровень - 1;
			ИначеЕсли Уровень = 0 И (Слово = "иначе" Или Слово = "else" Или Слово = "иначеесли" Или Слово = "elsif") Тогда
				Допустим = Ложь;
				Прервать;
			КонецЕсли;
			Если Уровень < 0 Тогда
				Допустим = Ложь;
				Прервать;
			КонецЕсли;
		ИначеЕсли ПроверятьОбвязку И Токен.Вид = "Имя" И Предыдущий = "." И ПередПредыдущим = "модуль"
			И Не СтрНачинаетсяС(Слово, "параметры__") Тогда
			Допустим = Ложь;
			Прервать;
		КонецЕсли;
		ПередПредыдущим = Предыдущий;
		Предыдущий = Слово;
	КонецЦикла;
	Возврат ?(Допустим И Уровень = 0, "Модуль = Неопределено;" + Символы.ПС
		+ "Если Ложь Тогда" + Символы.ПС + Текст + Символы.ПС + ";КонецЕсли;", "");
КонецФункции

Функция СтрокаJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, ""));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция НачалоБлока()
	Возврат "//<EiБлок ";
КонецФункции

Функция КонецБлока()
	Возврат "//EiБлок>";
КонецФункции

Функция ПрефиксМетодов(Ключ)
	Возврат "Ei_" + СтрЗаменить(НРег(Строка(Ключ)), "-", "") + "__";
КонецФункции

Процедура ПроверитьОписание(Описание)
	Если ТипЗнч(Описание) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Описание блока кода Ei должно быть структурой'");
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("Версия,Ключ,КлючСтроки,ИмяСтроки,КодВарианта,Имя,КлючПараметра,Владелец,Ссылка", ",") Цикл
		Если Не Описание.Свойство(Имя) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'В описании блока кода Ei отсутствует поле %1'"), Имя);
		КонецЕсли;
	КонецЦикла;
	Если Описание.Версия <> 1
		Или Не ОбщегоНазначенияКлиентСервер_Ei.ЭтоУникальныйИдентификатор(Описание.Ключ)
		Или Не ОбщегоНазначенияКлиентСервер_Ei.ЭтоУникальныйИдентификатор(Описание.КлючСтроки)
		Или НавигационныеСсылкиКлиентСервер_Ei.ДанныеСсылки(Описание.Ссылка) = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Некорректное описание блока кода Ei'");
	КонецЕсли;
КонецПроцедуры

// Области повторяют дерево строк набора и сохраняют порядок строк в Ei.
Процедура ДобавитьГруппыБлоков(Строки, Блоки, Состав)
	Узлы = Новый Соответствие;
	Порядок = Новый Массив;
	Если Состав <> Неопределено Тогда
		Для Каждого СтрокаНабора Из Состав.Строки Цикл
			Ключ = СтрокаНабора.КлючНастроек;
			Узел = УзелГруппировки(СтрокаНабора.Имя, СтрокаНабора.Родитель);
			Узлы.Вставить(Ключ, Узел);
			Порядок.Добавить(Узел);
		КонецЦикла;
	КонецЕсли;
	Для Каждого Блок Из Блоки Цикл
		Описание = Блок.Значение.Описание;
		Узел = Узлы.Получить(Описание.КлючСтроки);
		Если Узел = Неопределено Тогда
			Узел = УзелГруппировки(Описание.ИмяСтроки, Неопределено);
			Узлы.Вставить(Описание.КлючСтроки, Узел);
			Порядок.Добавить(Узел);
		КонецЕсли;
		Узел.Блоки.Добавить(Блок.Значение);
	КонецЦикла;
	Имена = Новый Соответствие;
	Для Каждого Узел Из Порядок Цикл
		Имена.Вставить(Узел.Имя, Узел);
	КонецЦикла;
	Корни = Новый Массив;
	Для Каждого Узел Из Порядок Цикл
		Родитель = Имена.Получить(Узел.Родитель);
		Если Родитель = Неопределено Тогда
			Корни.Добавить(Узел);
		Иначе
			Родитель.Дети.Добавить(Узел);
		КонецЕсли;
	КонецЦикла;
	Строки.Добавить("#Область Наборы");
	Для Каждого Узел Из Корни Цикл
		ДобавитьОбластьНабора(Строки, Узел);
	КонецЦикла;
	// В старых или неполных данных строка может не быть достижима от корня.
	Для Каждого Узел Из Порядок Цикл
		ДобавитьОбластьНабора(Строки, Узел);
	КонецЦикла;
	Строки.Добавить("#КонецОбласти");
КонецПроцедуры

Функция УзелГруппировки(Имя, Родитель)
	Узел = Новый Структура("Имя,Родитель,Блоки", Имя, Родитель, Новый Массив);
	Узел.Вставить("Дети", Новый Массив);
	Возврат Узел;
КонецФункции

// Записывает код строки и области ее подчиненных строк.
Процедура ДобавитьОбластьНабора(Строки, Узел)
	Если Узел.Свойство("Обработан") Тогда
		Возврат;
	КонецЕсли;
	Узел.Вставить("Обработан", Истина);
	НачалоОбласти = Строки.Количество();
	Строки.Добавить("#Область " + ИмяОбласти("", Узел.Имя));
	Группа = Новый Структура("Параметры,Алгоритмы,Процессы",
		Новый СписокЗначений, Новый СписокЗначений, Новый СписокЗначений);
	Для Каждого Блок Из Узел.Блоки Цикл
		Описание = Блок.Описание;
		Если ЗначениеЗаполнено(Описание.КлючПараметра) Тогда
			Группа.Параметры.Добавить(Блок, Описание.Имя);
		ИначеЕсли ЗначениеЗаполнено(Описание.Владелец) Тогда
			Группа.Процессы.Добавить(Блок, Описание.Имя);
		Иначе
			Группа.Алгоритмы.Добавить(Блок, Описание.Имя);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Вид Из Группа Цикл
		Части = Вид.Значение;
		Если Части.Количество() > 0 Тогда
			Части.СортироватьПоПредставлению();
			Строки.Добавить("#Область " + Вид.Ключ);
			Для Каждого Часть Из Части Цикл
				Строки.Добавить(Часть.Значение.Текст);
			КонецЦикла;
			Строки.Добавить("#КонецОбласти");
		КонецЕсли;
	КонецЦикла;
	Для Каждого ДочернийУзел Из Узел.Дети Цикл
		ДобавитьОбластьНабора(Строки, ДочернийУзел);
	КонецЦикла;
	Если Строки.Количество() = НачалоОбласти + 1 Тогда
		Строки.Удалить(НачалоОбласти);
	Иначе
		Строки.Добавить("#КонецОбласти");
	КонецЕсли;
КонецПроцедуры

Функция ИмяОбластиБлока(Описание)
	Если ЗначениеЗаполнено(Описание.КлючПараметра) Тогда
		Имя = ИмяОбласти("Параметр_", Описание.Имя);
	ИначеЕсли ЗначениеЗаполнено(Описание.Владелец) Тогда
		Имя = ИмяОбласти("Шаг_", Описание.Имя);
	Иначе
		Имя = ИмяОбласти("Вариант_", Описание.Имя);
	КонецЕсли;
	Возврат Имя;
КонецФункции

Функция ИмяОбласти(Префикс, Представление)
	Результат = Префикс;
	Для Позиция = 1 По СтрДлина(Представление) Цикл
		Символ = Сред(Представление, Позиция, 1);
		Результат = Результат + ?(СимволИмени(Символ), Символ, "_");
	КонецЦикла;
	Если ПустаяСтрока(Результат) Или СтрНайти("0123456789", Лев(Результат, 1)) > 0 Тогда
		Результат = "_" + Результат;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ТелоБлока(Текст)
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	НомерНачала = Неопределено;
	НомерОкончания = Неопределено;
	Для Номер = 0 По Строки.ВГраница() Цикл
		СтрокаТекста = СокрЛП(Строки.Получить(Номер));
		Если СтрНачинаетсяС(СтрокаТекста, "#Область ") И НомерНачала = Неопределено Тогда
			НомерНачала = Номер;
		КонецЕсли;
		Если СтрокаТекста = "#КонецОбласти" Тогда
			НомерОкончания = Номер;
		КонецЕсли;
	КонецЦикла;
	Если НомерНачала = Неопределено Или НомерОкончания = Неопределено Или НомерНачала >= НомерОкончания Тогда
		ВызватьИсключение НСтр("ru = 'В блоке кода Ei повреждена внешняя область'");
	КонецЕсли;
	Результат = Новый Массив;
	Для Номер = НомерНачала + 1 По НомерОкончания - 1 Цикл
		Результат.Добавить(Строки.Получить(Номер));
	КонецЦикла;
	Возврат СтрСоединить(Результат, Символы.ПС);
КонецФункции

Функция ПреобразоватьМетоды(Текст, Префикс, Обратно)
	Токены = Лексемы(Текст);
	Имена = Новый Соответствие;
	Предыдущий = "";
	Для Каждого Токен Из Токены Цикл
		Если Токен.Вид = "Комментарий" Тогда
			Продолжить;
		КонецЕсли;
		Если Токен.Вид = "Имя" И (Предыдущий = "функция" Или Предыдущий = "процедура"
			Или Предыдущий = "function" Или Предыдущий = "procedure") Тогда
			ИсходноеИмя = Токен.Текст;
			Если Обратно Тогда
				Если Не СтрНачинаетсяС(НРег(ИсходноеИмя), НРег(Префикс)) Тогда
					ВызватьИсключение НСтр("ru = 'Имя метода блока Ei не содержит ключ блока'");
				КонецЕсли;
				НовоеИмя = Сред(ИсходноеИмя, СтрДлина(Префикс) + 1);
			Иначе
				НовоеИмя = Префикс + ИсходноеИмя;
			КонецЕсли;
			Если Имена.Получить(НРег(ИсходноеИмя)) <> Неопределено Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'В блоке Ei повторяется метод %1'"), ИсходноеИмя);
			КонецЕсли;
			Имена.Вставить(НРег(ИсходноеИмя), НовоеИмя);
		КонецЕсли;
		Предыдущий = НРег(Токен.Текст);
	КонецЦикла;
	Части = Новый Массив;
	Позиция = 1;
	Предыдущий = "";
	Для Номер = 0 По Токены.ВГраница() Цикл
		Токен = Токены.Получить(Номер);
		Если Токен.Вид = "Комментарий" Тогда
			Продолжить;
		КонецЕсли;
		НовоеИмя = ?(Токен.Вид = "Имя", Имена.Получить(НРег(Токен.Текст)), Неопределено);
		СледующаяПозиция = Токен.Начало + Токен.Длина;
		Пока СледующаяПозиция <= СтрДлина(Текст) И (Сред(Текст, СледующаяПозиция, 1) = " "
			Или Сред(Текст, СледующаяПозиция, 1) = Символы.Таб Или Сред(Текст, СледующаяПозиция, 1) = Символы.ПС
			Или Сред(Текст, СледующаяПозиция, 1) = Символы.ВК) Цикл
			СледующаяПозиция = СледующаяПозиция + 1;
		КонецЦикла;
		Если НовоеИмя <> Неопределено И Предыдущий <> "." И Сред(Текст, СледующаяПозиция, 1) = "(" Тогда
			Части.Добавить(Сред(Текст, Позиция, Токен.Начало - Позиция));
			Части.Добавить(НовоеИмя);
			Позиция = Токен.Начало + Токен.Длина;
		КонецЕсли;
		Предыдущий = НРег(Токен.Текст);
	КонецЦикла;
	Части.Добавить(Сред(Текст, Позиция));
	Возврат СтрСоединить(Части, "");
КонецФункции

// Минимальный лексический разбор для разметки и изоляции имен.
// Строковые литералы, включая многострочные, читаются целиком.
Функция Лексемы(Текст)
	Результат = Новый Массив;
	Позиция = 1;
	ДлинаТекста = СтрДлина(Текст);
	Пока Позиция <= ДлинаТекста Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = " " Или Символ = Символы.Таб Или Символ = Символы.ПС Или Символ = Символы.ВК Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Начало = Позиция;
		Вид = "Символ";
		Если Сред(Текст, Позиция, 2) = "//" Тогда
			Вид = "Комментарий";
			Пока Позиция <= ДлинаТекста И Сред(Текст, Позиция, 1) <> Символы.ПС И Сред(Текст, Позиция, 1) <> Символы.ВК Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
		ИначеЕсли Символ = """" Тогда
			Вид = "Строка";
			Позиция = Позиция + 1;
			Закрыта = Ложь;
			Пока Позиция <= ДлинаТекста Цикл
				Если Сред(Текст, Позиция, 1) = """" Тогда
					Если Сред(Текст, Позиция + 1, 1) = """" Тогда
						Позиция = Позиция + 2;
						Продолжить;
					КонецЕсли;
					Позиция = Позиция + 1;
					Закрыта = Истина;
					Прервать;
				КонецЕсли;
				Позиция = Позиция + 1;
			КонецЦикла;
			Если Не Закрыта Тогда
				ВызватьИсключение НСтр("ru = 'В модуле формы не закрыт строковый литерал'");
			КонецЕсли;
		ИначеЕсли СимволИмени(Символ) Тогда
			Вид = "Имя";
			Позиция = Позиция + 1;
			Пока Позиция <= ДлинаТекста И СимволИмени(Сред(Текст, Позиция, 1)) Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
		Иначе
			Позиция = Позиция + 1;
		КонецЕсли;
		Лексема = Новый Структура("Начало,Длина,Текст", Начало, Позиция - Начало, Сред(Текст, Начало, Позиция - Начало));
		Лексема.Вставить("Вид", Вид);
		Результат.Добавить(Лексема);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СимволИмени(Символ)
	Возврат ЗначениеЗаполнено(Символ) И (Символ = "_" Или Символ >= "0" И Символ <= "9"
		Или Символ >= "a" И Символ <= "z" Или Символ >= "A" И Символ <= "Z"
		Или Символ >= "а" И Символ <= "я" Или Символ >= "А" И Символ <= "Я");
КонецФункции

#КонецОбласти

// Проверка кода, который модель присылает в инструменты MCP см. ИнструментыMCPСервер_Ei
// Опасные конструкции в рабочей базе выполняются только после подтверждения человеком в клиенте,
// запрещенные - не выполняются никогда: через них модель могла бы подделать запрос или ответ агента.
// Проверка видит только текст кода: вызовы методов конфигурации она не раскрывает.

#Область ПрограммныйИнтерфейс

// Ищет в коде конструкции, ради которых клиентский агент должен спросить человека:
// опасные для контекста и запрещенные в рабочей базе.
//
// Параметры:
//  Код - Строка - фрагмент BSL; для проверки параметров-выражений - их тексты вместе с кодом
//  Контекст - Строка - server или client
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ОпасныеКонструкции(Знач Код, Знач Контекст) Экспорт
	
	Найденные = ОпасныеКлючевыеСлова(Код, Контекст);
	Для Каждого Слово Из ЗапрещенныеКлючевыеСлова(Код) Цикл
		ДобавитьУникальное(Найденные, Слово);
	КонецЦикла;
	
	Возврат Найденные;
	
КонецФункции

// Ищет опасные ключевые слова в коде.
//
// Параметры:
//  Код - Строка
//  Контекст - Строка - server или client: для клиента список шире
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ОпасныеКлючевыеСлова(Знач Код, Знач Контекст) Экспорт
	
	Найденные = Новый Массив; // Массив из Строка
	КодВРег = ВРег(Код);
	
	Слова = ОпасныеКлючевыеСловаПоУмолчанию();
	Если Контекст = "client" Тогда
		Для Каждого Слово Из ОпасныеКлючевыеСловаКлиента() Цикл
			Слова.Добавить(Слово);
		КонецЦикла;
	КонецЕсли;
	
	ДобавитьНайденныеСлова(Найденные, КодВРег, Слова, Ложь);
	
	// Вложенный Выполнить/Вычислить обходит черный список строкой - блокируем,
	// но разрешаем методы вида Запрос.Выполнить().
	ДобавитьНайденныеСлова(Найденные, КодВРег, ОпасныеКлючевыеСловаБезТочки(), Истина);
	
	// .Результат() выполняет вариант, если результата нет или он устарел. По слову искать нельзя:
	// Результат - обязательная переменная кода MCP, поэтому ищем вызов метода, пробелы и переводы строк его не скроют.
	КодСлитно = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(КодВРег, " ", ""), Символы.Таб, ""), Символы.ПС, ""), Символы.ВК, "");
	Если СтрНайти(КодСлитно, ".РЕЗУЛЬТАТ(") > 0 Тогда
		ДобавитьУникальное(Найденные, ".Результат()");
	КонецЕсли;
	
	Возврат Найденные;
	
КонецФункции

// Ищет конструкции, которые в рабочей базе запрещены даже с подтверждением.
//
// Параметры:
//  Код - Строка
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ЗапрещенныеКлючевыеСлова(Знач Код) Экспорт
	
	Найденные = Новый Массив; // Массив из Строка
	ДобавитьНайденныеСлова(Найденные, ВРег(Код), СписокЗапрещенных(), Ложь);
	
	Возврат Найденные;
	
КонецФункции

// Определяет, можно ли выполнять опасные операции (запись, удаление и т.п.) без черного списка.
// Разрешено, если база на БСП и в ней включена блокировка работы с внешними ресурсами:
// БСП устанавливает ее при явном запрете администратора и при распознавании базы как копии.
// В такой базе безопасно менять данные - это нужно, например, для подготовки эталонной базы.
//
// Возвращаемое значение:
//  Булево
//
Функция ОпасныеОперацииРазрешены() Экспорт
	
	Разрешены = Ложь;
	
	Если Метаданные.ОбщиеМодули.Найти("БлокировкаРаботыСВнешнимиРесурсами") <> Неопределено Тогда
		Попытка
			// Ei не зависит от БСП: модуль вызывается по имени.
			//@skip-check server-execution-safe-mode
			Разрешены = Вычислить("БлокировкаРаботыСВнешнимиРесурсами.РаботаСВнешнимиРесурсамиЗаблокирована()") = Истина;
		Исключение
			// Версия БСП без нужного API или недоступен параметр сеанса - остаемся в безопасном режиме.
			Разрешены = Ложь;
		КонецПопытки;
	КонецЕсли;
	
	Возврат Разрешены;
	
КонецФункции

// Описание опасных конструкций для описания инструмента - из тех же списков, что и проверка кода.
//
// Параметры:
//  ОпасныеРазрешены - Булево - база-копия: черный список не действует, описание пустое
//
// Возвращаемое значение:
//  Строка
//
Функция ОписаниеОпасныхКонструкций(ОпасныеРазрешены) Экспорт
	
	Если ОпасныеРазрешены Тогда
		Возврат "";
	КонецЕсли;
	
	Описание = "Опасными считаются (и их английские аналоги): "
		+ ПредставлениеКлючевыхСлов(ОпасныеКлючевыеСловаПоУмолчанию())
		+ "; " + ПредставлениеКлючевыхСлов(ОпасныеКлючевыеСловаБезТочки())
		+ " без точки перед именем (Запрос.Выполнить() можно); вызов .Результат() варианта; а также в client: "
		+ ПредставлениеКлючевыхСлов(ОпасныеКлючевыеСловаКлиента()) + "."
		+ " Запрещено даже с подтверждением: "
		+ ПредставлениеКлючевыхСлов(СписокЗапрещенных()) + ".";
	
	Возврат Описание;
	
КонецФункции

// Требование к вызову методов конфигурации: черный список видит только текст кода,
// а не то, что метод делает внутри.
//
// Возвращаемое значение:
//  Строка
//
Функция ОписаниеВызововКонфигурации() Экспорт
	
	Возврат "Вызовы методов конфигурации (общих модулей, модулей менеджеров и объектов) проверка видит только по имени: что метод делает внутри, в том числе через несколько уровней вложенных вызовов, ей неизвестно. "
		+ "Отсутствие отказа и запроса подтверждения не означает, что код только читает данные. "
		+ "Вызывайте метод конфигурации, только если вам доступен исходный код этой конфигурации (MCP-сервер с исходниками или файлы выгрузки) и вы прошли всю цепочку вызовов: в ней нет записи, удаления, проведения и пометки удаления данных, работы с файлами, внешними ресурсами и фоновыми заданиями. "
		+ "Если исходников нет, цепочку не удалось пройти до конца или в ней есть вызовы по имени-строке (Выполнить, Вычислить, вызов метода или общего модуля по имени, ОписаниеОповещения), считайте, что метод изменяет данные, и не вызывайте его без явного согласия пользователя. "
		+ "Для чтения данных используйте execute_query.";
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьНайденныеСлова(Найденные, КодВРег, Слова, ТолькоБезТочкиСпереди)
	
	Для Каждого Слово Из Слова Цикл
		Если СодержитИдентификатор(КодВРег, ВРег(Слово), ТолькоБезТочкиСпереди) Тогда
			ДобавитьУникальное(Найденные, Слово);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУникальное(Массив, Значение)
	
	Если Массив.Найти(Значение) = Неопределено Тогда
		Массив.Добавить(Значение);
	КонецЕсли;
	
КонецПроцедуры

// Ищет целое слово-идентификатор, чтобы ЗаписатьJSON не считался Записать.
//
// Параметры:
//  ТекстВРег - Строка
//  ИдентификаторВРег - Строка
//  ТолькоБезТочкиСпереди - Булево - игнорировать вызовы вида Объект.Метод()
//
// Возвращаемое значение:
//  Булево
//
Функция СодержитИдентификатор(ТекстВРег, ИдентификаторВРег, ТолькоБезТочкиСпереди)
	
	Найден = Ложь;
	ДлинаИд = СтрДлина(ИдентификаторВРег);
	Позиция = 1;
	
	Пока ДлинаИд > 0 И Не Найден Цикл
		
		Позиция = СтрНайти(ТекстВРег, ИдентификаторВРег, , Позиция);
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		
		СимволДо = "";
		Если Позиция > 1 Тогда
			СимволДо = Сред(ТекстВРег, Позиция - 1, 1);
		КонецЕсли;
		СимволПосле = Сред(ТекстВРег, Позиция + ДлинаИд, 1);
		
		ЭтоЦелыйИдентификатор = Не ЭтоСимволИдентификатора(СимволДо) И Не ЭтоСимволИдентификатора(СимволПосле);
		Если ЭтоЦелыйИдентификатор И Не (ТолькоБезТочкиСпереди И СимволДо = ".") Тогда
			Найден = Истина;
		Иначе
			Позиция = Позиция + ДлинаИд;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Найден;
	
КонецФункции

// Параметры:
//  Символ - Строка
//
// Возвращаемое значение:
//  Булево - символ - цифра, латинская или русская буква или подчеркивание
//
Функция ЭтоСимволИдентификатора(Символ)
	
	ЭтоИдентификатор = Ложь;
	
	Если ЗначениеЗаполнено(Символ) Тогда
		КодСимвола = КодСимвола(Символ);
		ЭтоИдентификатор = (КодСимвола >= 48 И КодСимвола <= 57)
			Или (КодСимвола >= 65 И КодСимвола <= 90)
			Или КодСимвола = 95
			Или ЭтоКириллица(КодСимвола);
	КонецЕсли;
	
	Возврат ЭтоИдентификатор;
	
КонецФункции

// Параметры:
//  КодСимвола - Число
//
// Возвращаемое значение:
//  Булево - русская буква любого регистра, включая Ё
//
Функция ЭтоКириллица(КодСимвола)
	
	Возврат (КодСимвола >= 1040 И КодСимвола <= 1103) Или КодСимвола = 1025 Или КодСимвола = 1105;
	
КонецФункции


		//		Для Каждого НайденнаяСтрока ИЗ ТаблицаДоступныхПолей.НайтиСтроки(Новый Структура("Имя,ТипЗначения",Строка(Поле),Колонка.ТипЗначения)) Цикл
		//			Результат.ОсновнаяТаблица = НайденнаяСтрока.ИмяТаблицы;
		//			Прервать;
		//		КонецЦикла;	
		//	КонецЦикла;
		//КонецЕсли;	
	КонецЦикла;
	Возврат мКолонки;
КонецФункции

Функция ПолучитьДопустимыеСвойства(Значение, УникальныйИдентификатор) Экспорт
	Результат 				= Новый СписокЗначений;
	Результат.Добавить(Значение.Текст,					"Текст");
	Результат.Добавить(Значение.Параметры, 				"Параметры");	
	Результат.Добавить(Значение.МенеджерВременныхТаблиц,"МенеджерВременныхТаблиц");	
	Возврат Результат;		
КонецФункции

Функция АдаптироватьЗначениеПараметраДС(Значение)
	Результат = Значение;
	Если ТипЗнч(Значение) =  Тип("СписокЗначений") Тогда //Динамический список не понимает параметров в виде списка, только массив
		Результат = Значение.ВыгрузитьЗначения(); 	
	КонецЕсли;
	Возврат Результат; 
КонецФункции		

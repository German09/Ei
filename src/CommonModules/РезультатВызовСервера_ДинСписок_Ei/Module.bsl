		ОТипа				= Новый ОписаниеТипов;
		Если ТипЗнч(Колонка) =  Тип("КолонкаСхемыЗапроса") Тогда
			ОТипа = Колонка.ТипЗначения;
		ИначеЕсли ТипЗнч(Колонка) =  Тип("КолонкаВложеннаяТаблицаСхемыЗапроса") Тогда
			//вложенная колонка
			мВложенныхКолонок 	= ПолучитьКолонкиЗапроса(Колонка.Колонки);
			ОТипа				= Новый ОписаниеТипов("ТаблицаЗначений");
		КонецЕсли;
		мКолонки.Добавить(Новый Структура("Колонка,мКолонки",Новый Структура("Имя,ТипЗначения",Колонка.Псевдоним,ОТипа),мВложенныхКолонок));
	
		//Если Не ЗначениеЗаполнено(Результат) Тогда

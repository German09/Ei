Функция ПодготовитьЗапрос(ТекстЗапроса,УникальныйИдентификатор) Экспорт
	ОбъектЗапрос = ОбщийМодульВызовСервера_Ei.СоздатьЗапрос(ТекстЗапроса);
	Результат = ОписаниеЗначенияСервер_Ei.Подготовить(ОбъектЗапрос,УникальныйИдентификатор);	
	Возврат Результат;
КонецФункции

Функция Загрузить(Форма,ВариантИД,Результат,мКолонокРезультата) Экспорт
	Перем ИмяРеквизита;
	Перем ЗапросДС;
	Перем элФормы;
	ПоказалиДС 		= Ложь; 
	ВариантТД 		= Форма.ПолучитьПереопределяемыйОбъектОбработкиСервер(ВариантИД); //не условие не проверяем потому что уже проверяли, по другому сюда не попасть
	//сИмяЭлДинСписка = РезультатКлиентСервер_ДинСписок_Ei.ПолучитьИмяРеквизитаДинСписка(ВариантИД); 
	Если ТипЗнч(Результат) = Тип("Запрос") Тогда
		ЗапросДС 				= Результат.Текст;
		Параметры				= Результат.Параметры; 		
		стрДанныхТекстаЗапроса 	= ПолучитьКолонкиИОсновнуюТаблицу(ЗапросДС);
	КонецЕсли;
	Обработчик		= РезультатКлиентСервер_ДинСписок_Ei;
	Если ЗначениеЗаполнено(ЗапросДС) Тогда
		ОписаниеТиповРеквизита							= Новый ОписаниеТипов(Обработчик.Свойства().ТипРеквизита);
		элФормы 										= РезультатыСервер_Ei.ДобавитьРеквизитыКоллекции(Форма,Обработчик,ВариантТД,ИмяРеквизита,ОписаниеТиповРеквизита); 
		РеквизитДС 										= Форма[ИмяРеквизита];	
		РеквизитДС.ПроизвольныйЗапрос   				= Истина;
		РеквизитДС.ТекстЗапроса							= ЗапросДС;
		РеквизитДС.КлючТекущихПользовательскихНастроек	= ВариантТД.КлючНастроек;//КлючПользовательскихНастроекДС;
		
		Попытка
			//Установим переданные параметры
			Если ТипЗнч(Параметры) = Тип("Структура") Тогда
				Для Каждого ДоступныйПараметр ИЗ РеквизитДС.Параметры.ДоступныеПараметры.Элементы Цикл
					УстЗначение =  Неопределено; 
					Если Параметры.Свойство(ДоступныйПараметр.Параметр,УстЗначение) Тогда 
						РеквизитДС.Параметры.УстановитьЗначениеПараметра(ДоступныйПараметр.Параметр, АдаптироватьЗначениеПараметраДС(УстЗначение));
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;
			
			//Установим другие свойства дин. списка
			мКолонокРезультата								=стрДанныхТекстаЗапроса.мКолонки;
			РеквизитДС.ОсновнаяТаблица						= стрДанныхТекстаЗапроса.ОсновнаяТаблица;
			Если Не ЗначениеЗаполнено(РеквизитДС.ОсновнаяТаблица) И ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(Параметры,"ОсновнаяТаблица") Тогда
				Если ТипЗнч(Параметры.ОсновнаяТаблица) = Тип("Строка") Тогда
					РеквизитДС.ОсновнаяТаблица = Параметры.ОсновнаяТаблица;		
				КонецЕсли;	 
			КонецЕсли;
			ПоказалиДС = Истина;
		Исключение
			ПоказалиДС = Ложь;
			Если ТипЗнч(ИнформацияОбОшибке().Причина) 			=  Тип("ИнформацияОбОшибке") И
				 ТипЗнч(ИнформацияОбОшибке().Причина.Причина) 	=  Тип("ИнформацияОбОшибке") Тогда
				//это ошибка в запросе, остальное не интересно
				сДополнениеОшибки = ИнформацияОбОшибке().Причина.Причина.Описание;
			Иначе
				сДополнениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());	
			КонецЕсли;	
			ВызватьИсключение сДополнениеОшибки;
		КонецПопытки;
	КонецЕсли;
	Логотип			= КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,Обработчик);
	Если Не Логотип = Неопределено Тогда
		Логотип.Видимость 	= Не ПоказалиДС;
	КонецЕсли;
	Если Не элФормы = Неопределено Тогда
		элФормы.Видимость 	= ПоказалиДС;
	КонецЕсли;				
	Возврат Истина;
КонецФункции

Процедура ДополнитьДинамическийЭлементФормы(Форма,элФормы) Экспорт
	элФормы.ПоложениеСтрокиПоиска			= ПоложениеСтрокиПоиска.Низ;
	элФормы.ПоложениеСостоянияПросмотра		= ПоложениеСостоянияПросмотра.Верх;
	элФормы.ПоложениеУправленияПоиском		= ПоложениеУправленияПоиском.Авто;
	элФормы.Отображение         			= ОтображениеТаблицы.ИерархическийСписок;
	элФормы.МаксимальнаяВысота 				= 8;
	элФормы.Высота 							= 8;
	//Кнопка
	Кнопка = Форма.Элементы.Добавить("ДСВКоллекцию_"+элФормы.Имя, Тип("КнопкаФормы"), элФормы.КоманднаяПанель);
	Кнопка.ИмяКоманды = "ДСВКоллекцию";
КонецПроцедуры


// На основании текста запрроса и определяет оснвную таблицу и формирует список колонок в правильном порядке
//  пока основную таблицу не получается правильно определить
//
// Параметры:
//  ТекстЗапроса - Стркоа - Текст запрос
// 
// Возвращаемое значение:
//   -  Структура со свойствами Колонки - Массив, ОсновнаяТаблица - Строка
//
Функция  ПолучитьКолонкиИОсновнуюТаблицу(ТекстЗапроса)
	мКолонки		= Новый Массив;
	Результат 		= Новый Структура("мКолонки,ОсновнаяТаблица",мКолонки,"");
	СхемаЗапроса 	= Новый СхемаЗапроса;
	ПоследнийПакет 	= Неопределено;	
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	//ТаблицаДоступныхПолей = Новый ТаблицаЗначений;
	//ТаблицаДоступныхПолей.Колонки.Добавить("ИмяТаблицы");
	//ТаблицаДоступныхПолей.Колонки.Добавить("Псевдоним");
	//ТаблицаДоступныхПолей.Колонки.Добавить("Имя"); //Имя колонки
	//ТаблицаДоступныхПолей.Колонки.Добавить("ТипЗначения");
	//
	Для Каждого Пакет ИЗ СхемаЗапроса.ПакетЗапросов Цикл
		Если ТипЗнч(Пакет) = Тип("ЗапросВыбораСхемыЗапроса") Тогда
			ПоследнийПакет = Пакет;
		КонецЕсли;
		Если Пакет.КонтрольныеТочкиИтогов.Количество() ИЛИ Пакет.ОбщиеИтоги Тогда
			ВызватьИсключение "В динамическом списке невозможно использовать ИТОГИ";	
		КонецЕсли;	
		Для Каждого Оператор ИЗ Пакет.Операторы Цикл 
			Для Каждого Источник ИЗ Оператор.Источники Цикл
				Если Оператор.Источники.Количество() = 1 И ТипЗнч(Источник.Источник) = Тип("ТаблицаСхемыЗапроса") Тогда //подразумеваем что просто выполнили ВЫБРАТЬ * ИЗ .... в остальных случаях таблицу пока получита не умеем
					Результат.ОсновнаяТаблица = Источник.Источник.ИмяТаблицы; 	
				ИначеЕсли 	Не ТипЗнч(Источник.Источник) = Тип("ВложенныйЗапросСхемыЗапроса") 
							И Лев(Источник.Источник.ИмяТаблицы,1) = "&"	Тогда
					ВызватьИсключение "В динамическом списке невозможно передать таблицу значений как параметр";	
				КонецЕсли;	
				//Для Каждого ДостпуноеПоле ИЗ Источник.Источник.ДоступныеПоля Цикл
				//	НоваяСтрока = ТаблицаДоступныхПолей.Добавить();
				//    ЗаполнитьЗначенияСвойств(НоваяСтрока,Источник.Источник); //ИмяТаблицы,Псевдоним					
				//	ЗаполнитьЗначенияСвойств(НоваяСтрока,ДостпуноеПоле); //Имя,ТипЗначения
				//	НоваяСтрока.Имя = НоваяСтрока.Псевдоним + "." + НоваяСтрока.Имя;
				//КонецЦикла;	
			КонецЦикла;	
		КонецЦикла;		
	КонецЦикла;	
	Если Не ПоследнийПакет = Неопределено Тогда
		Результат.Вставить("мКолонки",ПолучитьКолонкиЗапроса(ПоследнийПакет.Колонки));
	КонецЕсли;	
	Возврат Результат; 
КонецФункции

Функция ПолучитьКолонкиЗапроса(Колонки)
	мКолонки		= Новый Массив;
	Для Каждого Колонка ИЗ Колонки Цикл

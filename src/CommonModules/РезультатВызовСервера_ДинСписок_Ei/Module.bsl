Функция ПодготовитьЗапрос(ТекстЗапроса,ПараметрыЗапроса,УникальныйИдентификатор) Экспорт
	ОбъектЗапрос = ОбщийМодульВызовСервера_Ei.СоздатьЗапрос(ТекстЗапроса, ПараметрыЗапроса);
	Результат = ОписаниеЗначенияВызовСервера_Ei.Подготовить(ОбъектЗапрос,УникальныйИдентификатор);	
	Возврат Результат;
КонецФункции

Функция  ДобавитьРеквизитыДС(Форма,ДеревоЗапросовИД) Экспорт
	сИмяРеквизитаДинСписка 	= РезультатКлиентСервер_ДинСписок_Ei.ПолучитьИмяРеквизитаДинСписка(ДеревоЗапросовИД);
	эл_Список 				= Форма.Элементы.Найти(сИмяРеквизитаДинСписка); 
	Если эл_Список = Неопределено Тогда
		ДобавляемыеРеквизиты	= Новый Массив;
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(сИмяРеквизитаДинСписка, Новый ОписаниеТипов("ДинамическийСписок")));
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		эл_Страница = Форма.Элементы.Добавить(Форма.Элементы.ГруппаДинСписков.Имя + сИмяРеквизитаДинСписка, Тип("ГруппаФормы"), Форма.Элементы.ГруппаДинСписков);//добавляем страницу и все на нее
		эл_Список = Форма.Элементы.Добавить(сИмяРеквизитаДинСписка, Тип("ТаблицаФормы"), эл_Страница);
	    эл_Список.ПутьКДанным         	= сИмяРеквизитаДинСписка;
	    эл_Список.Отображение         	= ОтображениеТаблицы.ИерархическийСписок;
		эл_Список.МаксимальнаяВысота 	= 8;
		эл_Список.Высота 				= 8;
		эл_Список.УстановитьДействие("Выбор","РезультатЗапросаВыбор");
		эл_Список.РазрешитьНачалоПеретаскивания = Ложь;  //перетаскивание из ДС слишком сложное, лучше передать данные в коллекцию
		//эл_Список.УстановитьДействие("НачалоПеретаскивания","РезультатЗапросаДСНачалоПеретаскивания");
		//Кнопка
		Кнопка = Форма.Элементы.Добавить("ДСВКоллекцию_"+ДеревоЗапросовИД, Тип("КнопкаФормы"), эл_Список.КоманднаяПанель);
   		Кнопка.ИмяКоманды = "ДСВКоллекцию";
	КонецЕсли;
	эл_Список.Видимость =  Истина;
	Возврат эл_Список;
КонецФункции
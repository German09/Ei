Процедура ПриОтображении(Форма) Экспорт
	ПараметрыКлиент_Ei.ИзменитьВидимость(Форма,Истина);
	Заполнитель 	= КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,ВариантКлиентСервер_Запрос_Ei);	
	Если Заполнитель.Видимость Тогда
		Заполнитель.Видимость = Ложь;
		Контейнер 	= КонструкторКлиентСервер_Ei.Контейнер(Форма,ВариантКлиентСервер_Запрос_Ei);	
		ФормаРодитель 	= ПолучитьФорму("ОбщаяФорма.Запрос_Ei");
			ПереопредПутиРеквизитов  = Новый Соответствие;
			ПереопредПутиРеквизитов.Вставить("ТекстЗапроса",КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента());
		НаследованиеФормКлиент_Ei.Дополнить(ФормаРодитель,Форма,Контейнер,ПереопредПутиРеквизитов);
	КонецЕсли;	
Конецпроцедуры


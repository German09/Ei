Процедура УстановитьПараметры(Форма) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ПустаяСтрока(ТД.ТекстЗапроса) Тогда
		мПараметров = ВариантВызовСервера_Запрос_Ei.ПолучитьПараметры(ТД.ТекстЗапроса);		
		ПараметрыКлиент_Ei.ВставитьПараметры(ТД, мПараметров);	
	КонецЕсли;
Конецпроцедуры
	
#КонецОбласти


//Формирует выражение на втроенном языке на основе текста запроса
//
Процедура ПреобразоватьВВыражение(Форма,ПараметрыКакСсылки) Экспорт
	ТД 					= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	СтраницаАлгоритма 	= Форма.Элементы.Найти(ВариантКлиентСервер_Ei_Алгоритм.Свойства().Имя);
	Если Не ТД = Неопределено И Не СтраницаАлгоритма = Неопределено Тогда
		ТекстЗапроса 	= ТД.ТекстЗапроса;
		СтрокаЗапроса	= СтрЗаменить(ТекстЗапроса,Символы.ПС,Символы.ПС+Символы.Таб+"|");
		СтрокаЗапроса	= СтрЗаменить(СтрокаЗапроса,"""","""""");//так же заменим кавычки запроса одну меняем на 2 
		Строка			= "Запрос = Новый Запрос;
							|Запрос.Текст = """+СтрокаЗапроса+""";";
		Если Найти(Нрег(СтрокаЗапроса),"поместить ")> 0 Тогда
			//Используем временные таблицы 
			Строка=Строка+Символы.ПС+"МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			|Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;";
		КонецЕсли;
		
		//{Начало изменений Кудяков Г.А.  24 января 2008 г. 11:38:50
		//параметры можно выводить по разному можно ссылкой а можно и явно преобразовать в выражение
		Если ПараметрыКакСсылки Тогда 
			Для каждого ПараметрЗапроса Из ТД.ПараметрыЗапроса Цикл
				ИмяПараметра 	= СокрЛП(ПараметрЗапроса.ИмяПараметра);
				Строка			= Строка+Символы.ПС+"Запрос.УстановитьПараметр("""+ИмяПараметра+""", Параметры."+ИмяПараметра+");";
			КонецЦикла;
		Иначе
			Для Каждого ПараметрЗапроса Из ТД.ПараметрыЗапроса Цикл
				ИмяПараметра 	= СокрЛП(ПараметрЗапроса.ИмяПараметра);
				Если ПараметрЗапроса.ЭтоВыражение Тогда
					ТекстДанных = ПараметрЗапроса.ЗначениеПараметра;
				Иначе
					ТекстДанных = ТекстМодуляКлиент_Ei.ПреобразоватьЗначениеКВыражению(ОбщийМодульКлиентСервер_Ei.АдаптироватьЗначениеПараметраЗапроса(ПараметрЗапроса.ЗначениеПараметра));
				КонецЕсли;
	        	Если  Найти(нрег(СтрЗаменить(ТекстДанных," ","")),Нрег(ПеречисленияКлиентСерверПовторноеИспользование_Ei.РезультатРавно()))>0 Тогда
					//значение возвращается в переменную Результат
					Строка =Строка+"
							|//Начало вычисления параметра <"+ИмяПараметра+">";
							Для Ном = 1 По СтрЧислоСтрок(ТекстДанных) Цикл
								Строка =Строка+Символы.ПС+Символы.Таб+СтрПолучитьСтроку(ТекстДанных,Ном);		
							КонецЦикла;	
					Строка =Строка+"		
							|Запрос.УстановитьПараметр("""+ИмяПараметра+""",Результат);
							|"+ПеречисленияКлиентСерверПовторноеИспользование_Ei.РезультатРавно()+" Неопределено; //Конец вычисления параметра  <"+ИмяПараметра+">";
				Иначе
					Строка =Строка+"
							|Запрос.УстановитьПараметр("""+ИмяПараметра+""", "+ТекстДанных+");";
				КонецЕсли;
			КонецЦикла;			
		КонецЕсли;	
		//Свормируем строку заголовка с учетом родителей Родитель.Родлителя\Родитель\Строка
		//СтрокаДерева=Элементыформы.ДеревоЗапросов.ТекущаяСтрока;
		//ПутьКЗапросу=СтрокаДерева.Запрос;
		//Пока не СтрокаДерева.Родитель=Неопределено Цикл
		//	ОбработкаПрерыванияПользователя();
		//	СтрокаДерева=СтрокаДерева.Родитель;
		//	ПутьКЗапросу=СтрокаДерева.Запрос+"\"+ПутьКЗапросу;
		//КонецЦикла;
		 ТД.Язык = Строка+Символы.ПС+"Результат = Запрос.Выполнить();";
		//|//ВнешниеОбработки.Создать("""+ЭтотОбъект.ИспользуемоеИмяФайла+""").Отладка(Запрос,,"""+СтрЗаменить(ПутьКЗапросу,"""","""""")+""")
		//|//Сгенерировано EI "+Формат(ТекущаяДата(),"ДЛФ=DDT")+" "+?(ПустаяСтрока(мИмяФайла),"файл запросов не сохранен",мИмяФайла));
		
		Форма.Элементы.ПанельТекстаЗапроса.ТекущаяСтраница = СтраницаАлгоритма;
		
		//ТУТ НУЖНО ДОБАВИТЬ ПРОЦЕДУРУ ИЗМЕНЕНИЯ
		//ДеревоЗапросовЯзыкПриИзменении(Элементы.Язык);
	КонецЕсли;	
КонецПроцедуры

#Область КонструкторЗапроса

//
Процедура ОткрытьКонструкторНачало(Форма) Экспорт
	Перем НачалоСтрока,КолонкаНач,СтрокаКон,КолонкаКон;
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		Если ПустаяСтрока(Форма.ТекущийЭлемент.ВыделенныйТекст) Тогда
			лТекстДляКонструктора = ТД.ТекстЗапроса;
		Иначе
			лТекстДляКонструктора = Форма.ТекущийЭлемент.ВыделенныйТекст;
		КонецЕсли;
		
		ПараметрыОповещения = Новый Структура("СтруктураГраницВыделения");
		ПараметрыОповещения.Вставить("Модифицированность",Форма.Модифицированность);
		ПараметрыОповещения.Вставить("Форма",Форма);
		Если Не ПустаяСтрока(Форма.ТекущийЭлемент.ВыделенныйТекст) Тогда 
			Форма.ТекущийЭлемент.ПолучитьГраницыВыделения(НачалоСтрока,КолонкаНач,СтрокаКон,КолонкаКон);
			ПараметрыОповещения.СтруктураГраницВыделения = Новый Структура("НачалоСтрока,КолонкаНач,СтрокаКон,КолонкаКон", НачалоСтрока,КолонкаНач,СтрокаКон,КолонкаКон);
		КонецЕсли;
		
		Конструктор = Новый КонструкторЗапроса; 
		Если ЗначениеЗаполнено(лТекстДляКонструктора) Тогда
			Попытка
				Конструктор.Текст = СокрЛП(лТекстДляКонструктора); 
			Исключение
				ОтладкаКлиент_Ei.ПоказатьИсключение(Форма,ИнформацияОбОшибке(),ВариантыКлиентСервер_Ei,ВариантКлиентСервер_Запрос_Ei);
				Возврат;
			КонецПопытки;	
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ОткрытьКонструкторЗавершение",ЭтотОбъект, ПараметрыОповещения); 
		Конструктор.Показать(Оповещение);
	КонецЕсли;	
КонецПроцедуры

Процедура ОткрытьКонструкторЗавершение(Текст, ДополнительныеПараметры) Экспорт 
	Форма = ДополнительныеПараметры.Форма;
	Если ДополнительныеПараметры.СтруктураГраницВыделения <> Неопределено Тогда 
		лГраницыВыделения = ДополнительныеПараметры.СтруктураГраницВыделения;
		Форма.ТекущийЭлемент.УстановитьГраницыВыделения(лГраницыВыделения.НачалоСтрока,лГраницыВыделения.КолонкаНач,лГраницыВыделения.СтрокаКон,лГраницыВыделения.КолонкаКон);
	КонецЕсли;
	
	Если Текст <> Неопределено Тогда 
		Если ДополнительныеПараметры.СтруктураГраницВыделения = Неопределено Тогда 
			Форма.Элементы.ТекстЗапроса.УстановитьГраницыВыделения(1,СтрДлина(Форма.ПолучитьПереопределяемыйОбъектОбработки().ТекстЗапроса) + 1);
			Форма.Элементы.ТекстЗапроса.ВыделенныйТекст = Текст
		Иначе
			Форма.ТекущийЭлемент.ВыделенныйТекст = Текст;
		КонецЕсли;
	Иначе
		Форма.Модифицированность = ДополнительныеПараметры.Модифицированность;
	КонецЕсли; 
	
	Если ДополнительныеПараметры.СтруктураГраницВыделения <> Неопределено Тогда 
		Форма.ТекущийЭлемент.УстановитьГраницыВыделения(лГраницыВыделения.НачалоСтрока,лГраницыВыделения.КолонкаНач, лГраницыВыделения.НачалоСтрока + СтрЧислоСтрок(Текст) - 1, СтрДлина(СтрПолучитьСтроку(Текст,СтрЧислоСтрок(Текст))) + 1);
	КонецЕсли;
	
	//ТУТ НУЖНО ДОБАВИТЬ ПРОЦЕДУРУ ИЗМЕНЕНИЯ
	//ТекстЗапросаПриИзменении(Элементы.ТекстЗапроса);
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеПроцедуры

// Получает актуальный текст запроса из формы конструктора
// 
// Параметры:
//  Форма Форма
//  ТД ТД
//  ДопПараметры Доп параметры
Функция ПолучитьАктуальныйТекстЗапроса(Форма, ТД, ДопПараметры) Экспорт
	ПрефиксЗапроса 	= "";
	ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,"ПрефиксЗапроса",ПрефиксЗапроса);
	Результат 		= ""+ПрефиксЗапроса+ВариантыКлиент_Ei.ПолучитьТекстДляВыполнения(Форма,ТД,"ТекстЗапроса");
	Если Найти(Нрег(Результат),"выбрать") ИЛИ Найти(Нрег(Результат),"select") Тогда
		//Тут все ОК запрос можно выполнять	
	Иначе
		//возьмем весь текст запроса
		Результат = ТД.ТекстЗапроса;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

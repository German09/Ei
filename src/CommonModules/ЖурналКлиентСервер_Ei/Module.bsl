// @strict-types

// Журнал выполнения Ei: замеры операций с вложенностью, на клиенте и на сервере.
// Корневой замер вместе с вложенными пишется одной записью журнала регистрации.
// На клиенте корневые замеры копятся в буфере и уходят на сервер пакетом, см. ЖурналКлиент_Ei
// Запись и чтение журнала регистрации см. ЖурналВызовСервера_Ei

#Область ПрограммныйИнтерфейс

// Начинает замер операции.
//
// Параметры:
//  Операция - Строка - что выполняется
//  Тип - Строка, Неопределено - вид операции: Конструктор, Запрос, Встроенный язык и т.п.
//  Родитель - Структура, Неопределено - замер, в который вложить новый; по умолчанию последний незавершенный
//  Сообщать - Булево - показать пользователю оповещение, если замер завершится ошибкой
//  Ид - Строка, Неопределено - идентификатор замера, если он должен совпасть с другим объектом,
//       например с запуском в истории; по умолчанию новый
//  Внешний - Строка, Неопределено - для корневого замера: операция, внутри которой он выполняется
//            (запуск варианта, вычисление параметра). По умолчанию на сервере берется из параметра сеанса
//            ЗапускВарианта_Ei, на клиенте пустая
//
// Возвращаемое значение:
//  Структура - замер:
//   * Ид - Строка - идентификатор замера
//   * Внешний - Строка - идентификатор внешней операции корневого замера
//   * Контекст - Структура, Неопределено - данные операции для просмотра журнала, сериализуемые в JSON
//   * Операция - Строка
//   * Тип - Строка
//   * Начало - Число - универсальное время начала в миллисекундах
//   * Длительность - Число - миллисекунды
//   * Статус - Строка - см. СтатусыЗамера
//   * Ошибка - Строка - подробное представление ошибки или сообщение
//   * Сообщать - Булево
//   * ЭтоКорень - Булево
//   * Завершен - Булево
//   * События - Массив из см. НачатьЗамер - вложенные замеры
//
Функция НачатьЗамер(Операция, Тип = Неопределено, Родитель = Неопределено, Сообщать = Истина,
	Ид = Неопределено, Внешний = Неопределено) Экспорт
	
	Стек = СостояниеЖурнала().Стек;
	РодительЗамера = Родитель;
	Если РодительЗамера = Неопределено И Стек.Количество() > 0 Тогда
		РодительЗамера = Стек.Получить(Стек.ВГраница());
	КонецЕсли;
	
	ВнешняяОперация = "";
	Если РодительЗамера = Неопределено Тогда
		ВнешняяОперация = ?(Внешний = Неопределено, ТекущаяВнешняяОперация(), Строка(Внешний));
	КонецЕсли;
	
	Замер = Новый Структура;
	Замер.Вставить("Ид", ?(ЗначениеЗаполнено(Ид), Строка(Ид), Строка(Новый УникальныйИдентификатор)));
	Замер.Вставить("Внешний", ВнешняяОперация);
	Замер.Вставить("Контекст", Неопределено);
	Замер.Вставить("Операция", Строка(Операция));
	Замер.Вставить("Тип", ?(Тип = Неопределено, ТипыОпераций().Общие, Строка(Тип)));
	Замер.Вставить("Начало", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Замер.Вставить("Длительность", 0);
	Замер.Вставить("Статус", "");
	Замер.Вставить("Ошибка", "");
	Замер.Вставить("Сообщать", Сообщать);
	Замер.Вставить("ЭтоКорень", РодительЗамера = Неопределено);
	Замер.Вставить("Завершен", Ложь);
	Замер.Вставить("События", Новый Массив); // Массив из Структура
	
	Если РодительЗамера <> Неопределено Тогда
		ДобавитьВложенный(РодительЗамера, Замер);
	КонецЕсли;
	Стек.Добавить(Замер);
	
	Возврат Замер;
	
КонецФункции

// Завершает замер. Завершенный корневой замер записывается в журнал регистрации.
// Повторное завершение замера ничего не делает.
//
// Параметры:
//  Замер - см. НачатьЗамер
//  Статус - Строка, Неопределено - см. СтатусыЗамера; при ошибке всегда Ошибка
//  Ошибка - Строка, ИнформацияОбОшибке - ошибка или сообщение. Сообщение с признаком см. ПризнакТолькоДляОтладки
//           не показывается пользователю
//
Процедура ЗавершитьЗамер(Замер, Статус = Неопределено, Знач Ошибка = "") Экспорт
	
	Если Замер.Завершен Тогда
		Возврат;
	КонецЕсли;
	
	ИнформацияОбОшибке = Неопределено;
	Если ТипЗнч(Ошибка) = Тип("ИнформацияОбОшибке") Тогда
		ИнформацияОбОшибке = Ошибка;
		Замер.Статус = СтатусыЗамера().Ошибка;
		Замер.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	Иначе
		Замер.Статус = ?(Статус = Неопределено, СтатусыЗамера().БезСтатуса, Строка(Статус));
		Замер.Ошибка = Строка(Ошибка);
	КонецЕсли;
	
	ТолькоДляОтладки = СтрНайти(Замер.Ошибка, ПризнакТолькоДляОтладки()) > 0;
	Замер.Ошибка = СтрЗаменить(Замер.Ошибка, ПризнакТолькоДляОтладки(), "");
	Замер.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Замер.Начало;
	Замер.Завершен = Истина;
	УбратьИзСтека(Замер);
	
	#Если Клиент Тогда
		Если ИнформацияОбОшибке <> Неопределено Тогда
			ЖурналКлиент_Ei.ЗапомнитьОшибку(Замер, ИнформацияОбОшибке);
		КонецЕсли;
		Если ИнформацияОбОшибке <> Неопределено И Замер.Сообщать И Не ТолькоДляОтладки Тогда
			ЖурналКлиент_Ei.ОповеститьОбОшибке(Замер, ИнформацияОбОшибке);
		КонецЕсли;
		Если Замер.ЭтоКорень Тогда
			ЖурналКлиент_Ei.ПриЗавершенииКорня(Замер);
		КонецЕсли;
	#Иначе
		Если Замер.ЭтоКорень Тогда
			ЖурналВызовСервера_Ei.ЗаписатьЗамер(Замер);
		КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

// Проверяет, завершился ли ошибкой замер или один из вложенных.
//
// Параметры:
//  Замер - см. НачатьЗамер
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьОшибка(Замер) Экспорт
	
	Есть = Замер.Статус = СтатусыЗамера().Ошибка;
	Если Не Есть Тогда
		Для Каждого Вложенный Из Замер.События Цикл // см. НачатьЗамер
			Если ЕстьОшибка(Вложенный) Тогда
				Есть = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Есть;
	
КонецФункции

// Статусы завершения замера.
//
// Возвращаемое значение:
//  Структура:
//   * БезСтатуса - Строка
//   * Информация - Строка
//   * Ошибка - Строка
//   * НеЗавершен - Строка - замер не завершили до завершения внешнего
//
Функция СтатусыЗамера() Экспорт
	
	Статусы = Новый Структура;
	Статусы.Вставить("БезСтатуса", "Без статуса");
	Статусы.Вставить("Информация", "Информация");
	Статусы.Вставить("Ошибка", "Ошибка");
	Статусы.Вставить("НеЗавершен", "Не завершен");
	
	Возврат Статусы;
	
КонецФункции

// Виды операций по умолчанию.
//
// Возвращаемое значение:
//  Структура:
//   * Общие - Строка
//   * Конструктор - Строка - действие пользователя в Ei, такие замеры уходят на сервер сразу
//
Функция ТипыОпераций() Экспорт
	
	Возврат Новый Структура("Общие, Конструктор", "Общие задачи", "Конструктор");
	
КонецФункции

// Признак в сообщении замера: замер пишется в журнал, но пользователю не показывается.
//
// Возвращаемое значение:
//  Строка
//
Функция ПризнакТолькоДляОтладки() Экспорт
	
	Возврат "#debug_only";
	
КонецФункции

// Событие журнала регистрации, в которое пишутся замеры Ei.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяСобытияЖурнала() Экспорт
	
	Возврат "Ei.Журнал";
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Операция, внутри которой выполняется серверный вызов: запуск варианта или вычисление параметра.
// Клиент передает ее на сервер через параметр сеанса, см. ИсторияВызовСервера_Ei
//
// Возвращаемое значение:
//  Строка
//
Функция ТекущаяВнешняяОперация()
	
	#Если Клиент Тогда
		Возврат "";
	#Иначе
		Возврат ПараметрыСеанса.ЗапускВарианта_Ei;
	#КонецЕсли
	
КонецФункции

// Параметры:
//  Родитель - см. НачатьЗамер
//  Замер - см. НачатьЗамер
//
Процедура ДобавитьВложенный(Родитель, Замер)
	
	Родитель.События.Добавить(Замер);
	
КонецПроцедуры

// Возвращаемое значение:
//  Структура:
//   * Стек - Массив из Структура - незавершенные замеры, см. НачатьЗамер
//
Функция СостояниеЖурнала()
	
	#Если Клиент Тогда
		Возврат ЖурналКлиентПовтИсп_Ei.СостояниеЖурнала();
	#Иначе
		Возврат ЖурналСерверПовтИсп_Ei.СостояниеЖурнала();
	#КонецЕсли
	
КонецФункции

// Убирает замер из стека незавершенных. Замеры, начатые после него и не завершенные,
// вложены в него и уже не будут завершены: они помечаются статусом см. СтатусыЗамера
//
// Параметры:
//  Замер - см. НачатьЗамер
//
Процедура УбратьИзСтека(Замер)
	
	Стек = СостояниеЖурнала().Стек;
	Индекс = Стек.Найти(Замер);
	Если Индекс = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока Стек.ВГраница() >= Индекс Цикл
		Незавершенный = Стек.Получить(Стек.ВГраница()); // см. НачатьЗамер
		Если Незавершенный <> Замер Тогда
			Незавершенный.Статус = СтатусыЗамера().НеЗавершен;
			Незавершенный.Длительность = ТекущееВремя - Незавершенный.Начало;
			Незавершенный.Завершен = Истина;
		КонецЕсли;
		Стек.Удалить(Стек.ВГраница());
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

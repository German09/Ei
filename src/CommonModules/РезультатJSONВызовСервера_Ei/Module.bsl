// Привести результат к типу, который возможно показать
// 
// Параметры:
//  Значение 			- Произвольный - значение которые мы птыемся показать данным обработчиком
// Возвращаемое значение:
//	Произвольный - Значение приведенное к типу	который можно тут отобразить   
Функция ПривестиРезультат(Значение) Экспорт
	ОписаниеТипаРезультата 	= Новый ОписаниеТипов(РезультатJSONКлиентСервер_Ei.Свойства().ТипРеквизита);
	Результат 				= ОписаниеТипаРезультата.ПривестиЗначение(Неопределено);
	Если 	ТипЗнч(Значение) = Тип("Соответствие")ИЛИ
			ТипЗнч(Значение) = Тип("ФиксированноеСоответствие")ИЛИ
			ТипЗнч(Значение) = Тип("Структура") ИЛИ 
			ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") ИЛИ 
			ТипЗнч(Значение) = Тип("Массив") ИЛИ 
			ТипЗнч(Значение) = Тип("ФиксированныйМассив") Тогда
		Попытка			
			Результат = ОбщийМодульКлиентСервер_Ei.СериализоватьJSON(Значение);
		Исключение
			//видимо вложены элементы которые не могут пройти сериализацию
			Результат = ОбщийМодульКлиентСервер_Ei.СериализоватьJSON(Значение,Истина);	
		КонецПопытки					
	ИначеЕсли 	ТипЗнч(Значение) = Тип("Строка") Тогда
		//тут уже преобразовали
	Иначе
		Результат = ОбщийМодульКлиентСервер_Ei.СериализоватьJSON(Значение,Истина);				
	КонецЕсли;
	Возврат Результат; 			
КонецФункции	
// @strict-types

// Фоновое выполнение вариантов Ei: состояния фонового запуска, ключ уведомления о его завершении
// и признак варианта, который можно выполнять в фоне.
// Запуск, остановка и показ результата см. ФоновоеВыполнениеКлиент_Ei
// Фоновое задание и учет запусков см. ФоновоеВыполнениеСервер_Ei

#Область ПрограммныйИнтерфейс

// Состояния фонового запуска.
//
// Возвращаемое значение:
//  Структура:
//   * Выполняется - Строка - фоновое задание идет
//   * Выполнено - Строка - вариант выполнен, результат ждет показа в строке набора
//   * Ошибка - Строка - вариант завершился ошибкой или задание прервано
//   * Остановлено - Строка - выполнение остановил пользователь
//
Функция Состояния() Экспорт
	
	Состояния = Новый Структура;
	Состояния.Вставить("Выполняется", 	"Выполняется");
	Состояния.Вставить("Выполнено", 	"Выполнено");
	Состояния.Вставить("Ошибка", 		"Ошибка");
	Состояния.Вставить("Остановлено", 	"Остановлено");
	
	Возврат Состояния;
	
КонецФункции

// Можно ли выполнять вариант в фоне: в фоновом задании вариант выполняется только на сервере,
// а его результат передается в сеанс пользователя. Признак задает модуль варианта свойством ФоновоеВыполнение.
//
// Параметры:
//  СвойстваВарианта - Структура - свойства модуля варианта, например см. ВариантЗапросКлиентСервер_Ei.Свойства
//
// Возвращаемое значение:
//  Булево
//
Функция ВариантВыполняетсяВФоне(СвойстваВарианта) Экспорт
	
	ВФоне = Ложь;
	СвойстваВарианта.Свойство("ФоновоеВыполнение", ВФоне);
	
	Возврат ВФоне = Истина;
	
КонецФункции

// Ключ уведомления клиента о завершении фонового запуска.
//
// Возвращаемое значение:
//  Строка
//
Функция КлючУведомления() Экспорт
	
	Возврат "ФоновоеВыполнение" + ОбщегоНазначенияКлиентСервер_Ei.Постфикс();
	
КонецФункции

// Ключ уведомления клиента о том, что фоновому заданию нужно значение сеанса запуска.
//
// Возвращаемое значение:
//  Строка
//
Функция КлючЗапросаЗначения() Экспорт
	
	Возврат "ФоновоеВыполнениеЗначение" + ОбщегоНазначенияКлиентСервер_Ei.Постфикс();
	
КонецФункции

#КонецОбласти

Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",					"Выполнить");
	Результат.Вставить("Синоним",				"Выполнить");
	Результат.Вставить("Картинка",				БиблиотекаКартинок.Выполнить_Ei);
	Результат.Вставить("ИспользоватьНастройки",	Истина);
	Результат.Вставить("Форма",					"ОбщаяФорма.Выполнить_Обработка_Ei");

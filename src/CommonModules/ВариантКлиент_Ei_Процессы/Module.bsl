// ПРОЦЕДУРЫ - ИНТЕРФЕЙСА ВАРИАНТОВ КОНСТРУКТОРА 
#Область ИнтерфейсВариантов

Процедура Инициализировать(Форма, Контейнер) Экспорт
	ФормаРодитель 	= ПолучитьФорму(ПроцессыКлиент_Ei.ИмяМодальнойФормы());
		ПереопредПутиРеквизитов  = Новый Соответствие;
		ПереопредПутиРеквизитов.Вставить("ДоступныеОбработки",	ПеречисленияКлиентСерверПовторноеИспользование_Ei.ИмяОсновногоЭлмента());
		ПереопредПутиРеквизитов.Вставить("ГрафСхемаXDTO",		ПеречисленияКлиентСерверПовторноеИспользование_Ei.ИмяОсновногоЭлмента());
		
		ПереопредПутиРеквизитов.Вставить("Процессы_Объект",		ПеречисленияКлиентСерверПовторноеИспользование_Ei.ИмяОсновногоЭлмента());
	НаследованиеФормКлиент_Ei.Дополнить(ФормаРодитель,Форма,Контейнер,ПереопредПутиРеквизитов);
	//специфичные свойства элементов форм 
	Форма.Элементы.Процессы_ГрафСхема.Подсказка = "Если процесс заканчивается блоком ""Завершение"" он может возвращать результат";
КонецПроцедуры

Процедура ПриИзмененииДанных(Форма) Экспорт
	ПроцессыКлиент_Ei.ВосстановитьГрафСхему(Форма); //Перенес из ВосстановитьЗначениеЭлементов()	
Конецпроцедуры

Процедура ПриОтображении(Форма) Экспорт
	ПараметрыКлиент_Ei.ИзменитьВидимость(Форма,Ложь);
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		ПроцессыКлиент_Ei.вЗагрузитьГрупповыеОбработки(Форма.ВсеДоступныеОбработки,ТД.ДоступныеОбработки.ПолучитьЭлементы(),Форма.УникальныйИдентификатор);
		ЗагрузитьНастройки(Форма,ТД);
		ПроцессыКлиент_Ei.ОбновитьЗаголовокОбъекта(Форма,ТД);
	КонецЕсли;
	Если Не Форма.Процессы_ГрафСхема.ЭлементыГрафическойСхемы.Количество() Тогда
		Форма.Процессы_ГрафСхема = ПроцессыВызовСервера_Ei.ПолучитьМакетСхемыПоУмолчанию();		
	КонецЕсли;		
Конецпроцедуры

Процедура ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
	ОтладкаКлиент_Ei.ПоказатьИсключение(Форма,ИнфоОбОшибке,ВариантыКлиентСервер_Ei,ВариантКлиентСервер_Ei_Процессы);
КонецПроцедуры

Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ПроцессыКлиент_Ei.ВыделитьОшибкуВПроцессе(Форма,Элемент);	
КонецПроцедуры

Функция ПолучитьРазмерность(Форма,ТД) Экспорт
	Возврат Форма.Процессы_ГрафСхема.ЭлементыГрафическойСхемы.Количество(); //ТОВО Более точно заполнить
КонецФункции

#КонецОбласти

Процедура ЗагрузитьНастройки(Форма,ТД)
	Перем ОтобразитьПоказателиПроцесса;
	Настройки = НастройкиПользователяКлиентСервер_Ei.ПолучитьНастройкиОбработчика(ТД,Форма.НастройкиПользователя,ВариантКлиентСервер_Ei_Процессы);
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Настройки.Свойство("ОтобразитьПоказателиПроцесса",ОтобразитьПоказателиПроцесса);		
	КонецЕсли;
	ПроцессыКлиент_Ei.ОтобразитьПоказателиПроцесса(Форма,ОтобразитьПоказателиПроцесса = Истина);		
КонецПроцедуры

Процедура СохранитьНастройки(Форма,ТД) Экспорт 
	Настройки = Новый Структура; 
	ЭлементФормы = Форма.Элементы.Найти("ОтобразитьПоказателиПроцесса");
	Если Не ЭлементФормы = Неопределено Тогда
		Настройки.Вставить("ОтобразитьПоказателиПроцесса",ЭлементФормы.Пометка);			
	КонецЕсли;	
	НастройкиПользователяКлиентСервер_Ei.СохранитьНастройкиОбработчика(ТД,Форма.НастройкиПользователя,ВариантКлиентСервер_Ei_Процессы,Настройки);
КонецПроцедуры		



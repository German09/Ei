&НаКлиенте
Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",		"Процессы");
	Результат.Вставить("Синоним",	"Процессы");
	Возврат Результат;
КонецФункции	

&НаКлиенте
Процедура Инициализировать(Форма, Контейнер) Экспорт
	ФормаРодитель 	= ПолучитьФорму(ПроцессыКлиент_Ei.ИмяМодальнойФормы());
		ПереопредПутиРеквизитов  = Новый Соответствие;
		ПереопредПутиРеквизитов.Вставить("ДоступныеОбработки","ДеревоЗапросов");
		ПереопредПутиРеквизитов.Вставить("ГрафСхемаXDTO","ДеревоЗапросов");
	НаследованиеФормКлиент_Ei.Дополнить(ФормаРодитель,Форма,Контейнер,ПереопредПутиРеквизитов);
	//специфичные свойства элементов форм 
	Форма.Элементы.Процессы_ГрафСхема.Подсказка = "Если процесс заканчивается блоком ""Завершение"" он может возвращать результат";
КонецПроцедуры

Функция ПолучитьГруппуОтображенияОшибок(Форма) Экспорт 
	Возврат Форма.Элементы.Найти("ОшибкаПроцессы");		
КонецФункции	
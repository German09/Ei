#Область ИнтерфейсВариантов

Процедура Инициализировать(Форма, Контейнер) Экспорт
	ФормаРодитель 	= ПолучитьФорму(ПроцессыКлиент_Ei.ИмяМодальнойФормы());
		ПереопредПутиРеквизитов  = Новый Соответствие;
		ПереопредПутиРеквизитов.Вставить("ДоступныеОбработки",	ПеречисленияКлиентСерверПовторноеИспользование_Ei.ИмяОсновногоЭлмента());
		ПереопредПутиРеквизитов.Вставить("ГрафСхемаXDTO",		ПеречисленияКлиентСерверПовторноеИспользование_Ei.ИмяОсновногоЭлмента());
	НаследованиеФормКлиент_Ei.Дополнить(ФормаРодитель,Форма,Контейнер,ПереопредПутиРеквизитов);
	//специфичные свойства элементов форм 
	Форма.Элементы.Процессы_ГрафСхема.Подсказка = "Если процесс заканчивается блоком ""Завершение"" он может возвращать результат";
КонецПроцедуры

Процедура ПриИзмененииДанных(Форма) Экспорт
	ВариантыКлиент_Ei.ПриИзмененииДанных(Форма,"ОшибкаПроцессы");	
Конецпроцедуры

Процедура ПриОтображении(Форма) Экспорт
	ПараметрыКлиент_Ei.ИзменитьВидимость(Форма,Ложь);
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		ПроцессыКлиент_Ei.вЗагрузитьГрупповыеОбработки(Форма.ВсеДоступныеОбработки,ТД.ДоступныеОбработки.ПолучитьЭлементы(),Форма.УникальныйИдентификатор);
	КонецЕсли;
	Если Не Форма.Процессы_ГрафСхема.ЭлементыГрафическойСхемы.Количество() Тогда
		Форма.Процессы_ГрафСхема = ПроцессыВызовСервера_Ei.ПолучитьМакетСхемыПоУмолчанию();		
	КонецЕсли;
Конецпроцедуры

Процедура ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
	ОтладкаКлиент_Ei.ПоказатьИсключение(Форма,ИнфоОбОшибке,ВариантыКлиентСервер_Ei,ВариантКлиентСервер_Ei_Процессы);
КонецПроцедуры


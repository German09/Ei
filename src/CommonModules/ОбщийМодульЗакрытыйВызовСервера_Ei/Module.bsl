//Полчает строки таблицы значений или дерева с определенным отбором.
//Параметры:
//	сРезультатЗапроса_Показатели		- <Структура>. Структура данных содержит  структуры ПоказателиВыполнения и ПоказателиРезультата
//	Значение							- <Булево,Число>. Значение колонки пометки
//	ИскатьПодчиненные   				- <Булево>. Искать подчиненые, только для источника с типом ДеревоЗначений
//	КолонкаПометки						- <Строка>. Имя колонки пометки
//	ДополнительноеУсловие   			- <Структура>. Дополнительная структура отбора
//Возвращаемое значение
//Массив указателей на нужные строки
Функция ПолучитьСтрокиРезультата(сРезультатЗапроса_Показатели, Значение, ИскатьПодчиненные = Истина, КолонкаПометки = Неопределено, ДополнительноеУсловие = Неопределено) Экспорт
	Строки			= Новый Массив;
	ОбработчикРезультата = РезультатыКлиентСерверПовторноеИспользование_Ei.ПолучитьРезультаты().Получить(сРезультатЗапроса_Показатели.ПоказателиВыполнения.ВидРезультата);
	Если Не ОбработчикРезультата = Неопределено Тогда
		Источник		= РезультатыСервер_Ei.ПолучитьСохраненныйРезультат(сРезультатЗапроса_Показатели.ПоказателиРезультата,ОбработчикРезультата);
		Если ТипЗнч(Источник) = Тип("ДеревоЗначений") ИЛИ ТипЗнч(Источник) = Тип("ТаблицаЗначений") Тогда
			ОбщийМодульВызовСервера_Ei.ПроверитьСодержаниеКолонкиСПометкой(Источник,КолонкаПометки);
			КолонкаПометки 	= ?(КолонкаПометки = Неопределено,ПеречисленияКлиентСерверПовторноеИспользование_Ei.Пометка(),КолонкаПометки);
			Если Не Источник.Колонки[КолонкаПометки].ТипЗначения.СодержитТип(Тип("Булево")) Тогда
				Значение = Число(Значение);
			КонецЕсли;
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить(КолонкаПометки,Значение);
			Если ТипЗнч(ДополнительноеУсловие)= Тип("Структура") Тогда
				//пополняем структуру
				Для Каждого Элемент ИЗ ДополнительноеУсловие Цикл
					СтруктураОтбора.Вставить(Элемент.Ключ,Элемент.Значение);		
				КонецЦикла;	
			КонецЕсли;	
			Если Источник.Колонки.Количество() > 0 Тогда
				Если ТипЗнч(Источник)=Тип("ТаблицаЗначений") Тогда 
					Строки	= Источник.НайтиСтроки(СтруктураОтбора);		
				Иначе
					Строки	= Источник.Строки.НайтиСтроки(СтруктураОтбора, ИскатьПодчиненные);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Источник) = Тип("ТабличныйДокумент") Тогда
			Если Значение = Ложь И Источник.ВысотаТаблицы > 1 Тогда 
				Строки = Новый Массив(Источник.ВысотаТаблицы - 1); //Шапка выводится в таблицу убираем ее
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;		
	Возврат Строки;
КонецФункции

// На основании текста запрроса и определяет оснвную таблицу и формирует список колонок в правильном порядке
//  пока основную таблицу не получается правильно определить
//
// Параметры:
//  ТекстЗапроса - Стркоа - Текст запрос
// 
// Возвращаемое значение:
//   -  Структура со свойствами Колонки - Массив, ОсновнаяТаблица - Строка
//
Функция  ПолучитьКолонкиИОсновнуюТаблицу(ТекстЗапроса) Экспорт
	мКолонки		= Новый Массив;
	Результат 		= Новый Структура("мКолонки,ОсновнаяТаблица",мКолонки,"");
	СхемаЗапроса 	= Новый СхемаЗапроса;
	ПоследнийПакет 	= Неопределено;	
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	//ТаблицаДоступныхПолей = Новый ТаблицаЗначений;
	//ТаблицаДоступныхПолей.Колонки.Добавить("ИмяТаблицы");
	//ТаблицаДоступныхПолей.Колонки.Добавить("Псевдоним");
	//ТаблицаДоступныхПолей.Колонки.Добавить("Имя"); //Имя колонки
	//ТаблицаДоступныхПолей.Колонки.Добавить("ТипЗначения");
	//
	Для Каждого Пакет ИЗ СхемаЗапроса.ПакетЗапросов Цикл
		Если ТипЗнч(Пакет) = Тип("ЗапросВыбораСхемыЗапроса") Тогда
			ПоследнийПакет = Пакет;
		КонецЕсли;
		Если Пакет.КонтрольныеТочкиИтогов.Количество() ИЛИ Пакет.ОбщиеИтоги Тогда
			ВызватьИсключение "В динамическом списке невозможно использовать ИТОГИ";	
		КонецЕсли;	
		Для Каждого Оператор ИЗ Пакет.Операторы Цикл 
			Для Каждого Источник ИЗ Оператор.Источники Цикл
				Если Оператор.Источники.Количество() = 1 И ТипЗнч(Источник.Источник) = Тип("ТаблицаСхемыЗапроса") Тогда //подразумеваем что просто выполнили ВЫБРАТЬ * ИЗ .... в остальных случаях таблицу пока получита не умеем
					Результат.ОсновнаяТаблица = Источник.Источник.ИмяТаблицы; 	
				ИначеЕсли 	Не ТипЗнч(Источник.Источник) = Тип("ВложенныйЗапросСхемыЗапроса") 
							И Лев(Источник.Источник.ИмяТаблицы,1) = "&"	Тогда
					ВызватьИсключение "В динамическом списке невозможно передать таблицу значений как параметр";	
				КонецЕсли;	
				//Для Каждого ДостпуноеПоле ИЗ Источник.Источник.ДоступныеПоля Цикл
				//	НоваяСтрока = ТаблицаДоступныхПолей.Добавить();
				//    ЗаполнитьЗначенияСвойств(НоваяСтрока,Источник.Источник); //ИмяТаблицы,Псевдоним					
				//	ЗаполнитьЗначенияСвойств(НоваяСтрока,ДостпуноеПоле); //Имя,ТипЗначения
				//	НоваяСтрока.Имя = НоваяСтрока.Псевдоним + "." + НоваяСтрока.Имя;
				//КонецЦикла;	
			КонецЦикла;	
		КонецЦикла;		
	КонецЦикла;	
	Если Не ПоследнийПакет = Неопределено Тогда
		Результат.Вставить("мКолонки",ПолучитьКолонкиЗапроса(ПоследнийПакет.Колонки));
	КонецЕсли;	
	Возврат Результат; 
КонецФункции


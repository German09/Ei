// Запись замеров Ei в журнал регистрации и чтение их для просмотра.
// Замеры ведет см. ЖурналКлиентСервер_Ei
// Без @strict-types: колонки выгрузки журнала регистрации и прочитанный JSON типизировать нечем.

#Область ПрограммныйИнтерфейс

// Записывает корневые замеры, накопленные на клиенте.
//
// Параметры:
//  Замеры - Массив из см. ЖурналКлиентСервер_Ei.НачатьЗамер
//
Процедура ЗаписатьЗамеры(Знач Замеры) Экспорт
	
	Для Каждого Замер Из Замеры Цикл
		ЗаписатьЗамер(Замер);
	КонецЦикла;
	
КонецПроцедуры

// Записывает корневой замер вместе с вложенными одной записью журнала регистрации.
// Первая строка комментария - краткое описание для стандартного просмотра журнала, дальше JSON замера.
//
// Параметры:
//  Замер - см. ЖурналКлиентСервер_Ei.НачатьЗамер
//
Процедура ЗаписатьЗамер(Знач Замер) Экспорт
	
	Уровень = ?(ЖурналКлиентСервер_Ei.ЕстьОшибка(Замер), УровеньЖурналаРегистрации.Ошибка,
		УровеньЖурналаРегистрации.Информация);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеЗамера(Замер));
	
	Заголовок = СтрШаблон("%1 (%2 мс)", СтрПолучитьСтроку(Замер.Операция, 1), Формат(Замер.Длительность, "ЧН=0; ЧГ=0"));
	ЗаписьЖурналаРегистрации(ЖурналКлиентСервер_Ei.ИмяСобытияЖурнала(), Уровень, , ,
		Заголовок + Символы.ПС + ЗаписьJSON.Закрыть());
	
КонецПроцедуры

// Читает замеры текущего пользователя из журнала регистрации. Фоновый запуск варианта идет в сеансе
// фонового задания: при отборе по текущему сеансу его замер читается вместе с сеансом, из которого он запущен,
// см. ФоновоеВыполнениеСервер_Ei.ВыполнитьЗадание
//
// Параметры:
//  ДатаНачала - Дата
//  ДатаОкончания - Дата - пустая дата - без ограничения
//  ТолькоТекущийСеанс - Булево
//  КоличествоЗаписей - Число
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Дата - Дата
//   * Сеанс - Число
//   * Приложение - Строка
//   * Замер - см. ЖурналКлиентСервер_Ei.НачатьЗамер
//
Функция ПрочитатьЗамеры(Знач ДатаНачала, Знач ДатаОкончания, Знач ТолькоТекущийСеанс, Знач КоличествоЗаписей = 1000) Экспорт
	
	Отбор = Новый Структура;
	Отбор.Вставить("Событие", ЖурналКлиентСервер_Ei.ИмяСобытияЖурнала());
	Отбор.Вставить("ДатаНачала", ДатаНачала);
	Если ЗначениеЗаполнено(ДатаОкончания) Тогда
		Отбор.Вставить("ДатаОкончания", ДатаОкончания);
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяПользователя()) Тогда
		Отбор.Вставить("Пользователь", ИмяПользователя());
	КонецЕсли;
	Если ТолькоТекущийСеанс Тогда
		Отбор.Вставить("Сеанс", НомерСеансаИнформационнойБазы());
	КонецЕсли;
	
	Результат = Новый Массив; // Массив из Структура
	ДобавитьЗамеры(Результат, Отбор, КоличествоЗаписей);
	
	Если ТолькоТекущийСеанс Тогда
		Отбор.Удалить("Сеанс");
		Отбор.Вставить("Приложение", "BackgroundJob");
		ДобавитьЗамеры(Результат, Отбор, КоличествоЗаписей, НомерСеансаИнформационнойБазы());
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Дописывает замеры из журнала регистрации по отбору.
//
// Параметры:
//  Результат - Массив из Структура - прочитанные замеры, см. ПрочитатьЗамеры
//  Отбор - Структура - отбор журнала регистрации
//  КоличествоЗаписей - Число
//  СеансЗапуска - Число, Неопределено - оставить только замеры фоновых запусков из этого сеанса
//
Процедура ДобавитьЗамеры(Результат, Отбор, КоличествоЗаписей, СеансЗапуска = Неопределено)
	
	Записи = Новый ТаблицаЗначений;
	УстановитьПривилегированныйРежим(Истина);
	ВыгрузитьЖурналРегистрации(Записи, Отбор, "Дата, Сеанс, ПредставлениеПриложения, Комментарий", , КоличествоЗаписей);
	УстановитьПривилегированныйРежим(Ложь);
	
	Для Каждого Запись Из Записи Цикл
		Замер = ЗамерИзКомментария(Запись.Комментарий);
		Если Замер = Неопределено Или СеансЗапуска <> Неопределено И СеансЗапускаЗамера(Замер) <> СеансЗапуска Тогда
			Продолжить;
		КонецЕсли;
		Прочитанный = Новый Структура;
		Прочитанный.Вставить("Дата", Запись.Дата);
		Прочитанный.Вставить("Сеанс", Запись.Сеанс);
		Прочитанный.Вставить("Приложение", Запись.ПредставлениеПриложения);
		Прочитанный.Вставить("Замер", Замер);
		Результат.Добавить(Прочитанный);
	КонецЦикла;
	
КонецПроцедуры

// Сеанс, из которого запущен фоновый запуск варианта: его пишет в контекст замера фоновое задание.
//
// Параметры:
//  Замер - Структура - прочитанный замер
//
// Возвращаемое значение:
//  Число, Неопределено - Неопределено, если замер не фонового запуска
//
Функция СеансЗапускаЗамера(Замер)
	
	Сеанс = Неопределено;
	Контекст = Неопределено;
	Если Замер.Свойство("Контекст", Контекст) И ТипЗнч(Контекст) = Тип("Структура") Тогда
		Контекст.Свойство("СеансЗапуска", Сеанс);
	КонецЕсли;
	
	Возврат Сеанс;
	
КонецФункции

// Оставляет только то, что нужно хранить: без служебных признаков замера.
//
// Параметры:
//  Замер - см. ЖурналКлиентСервер_Ei.НачатьЗамер
//
// Возвращаемое значение:
//  Структура
//
Функция ДанныеЗамера(Замер)
	
	Вложенные = Новый Массив; // Массив из Структура
	Для Каждого Вложенный Из Замер.События Цикл
		Вложенные.Добавить(ДанныеЗамера(Вложенный));
	КонецЦикла;
	
	Данные = Новый Структура;
	Данные.Вставить("Ид", Замер.Ид);
	Данные.Вставить("Внешний", Замер.Внешний);
	Данные.Вставить("Контекст", Замер.Контекст);
	Данные.Вставить("Операция", Замер.Операция);
	Данные.Вставить("Тип", Замер.Тип);
	Данные.Вставить("Начало", Замер.Начало);
	Данные.Вставить("Длительность", Замер.Длительность);
	Данные.Вставить("Статус", Замер.Статус);
	Данные.Вставить("Ошибка", Замер.Ошибка);
	Данные.Вставить("События", Вложенные);
	
	Возврат Данные;
	
КонецФункции

// Параметры:
//  Комментарий - Строка - комментарий записи журнала, см. ЗаписатьЗамер
//
// Возвращаемое значение:
//  Структура, Неопределено - замер в формате см. ЖурналКлиентСервер_Ei.НачатьЗамер
//  или Неопределено, если это не замер Ei
//
Функция ЗамерИзКомментария(Комментарий)
	
	Замер = Неопределено;
	НачалоJSON = СтрНайти(Комментарий, "{");
	Если НачалоJSON > 0 Тогда
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Сред(Комментарий, НачалоJSON));
		Попытка
			Замер = ПрочитатьJSON(ЧтениеJSON);
		Исключение
			// Комментарий изменен или обрезан - такую запись в просмотре пропускаем.
			Замер = Неопределено;
		КонецПопытки;
		ЧтениеJSON.Закрыть();
	КонецЕсли;
	
	Если ТипЗнч(Замер) <> Тип("Структура") Тогда
		Замер = Неопределено;
	КонецЕсли;
	
	Возврат Замер;
	
КонецФункции

#КонецОбласти

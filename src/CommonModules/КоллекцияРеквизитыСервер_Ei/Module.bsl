#Область ПрограммныйИнтерфейс
// Получем не только сам состав колонок, но и элемент верхнего уровня, саму коллекцию
// 
// Параметры:
//  РеквизитКоллекции - Строка - Реквизит коллекции
//  Коллекция 			- ТаблицаЗначений, ДеревоЗначений - Коллекция
// 
// Возвращаемое значение:
//  см. КоллекцияВызовСервера_Ei.ПолучитьКолонки
Функция ПолучитьКоллекциюИСостав(РеквизитКоллекции, Коллекция) Экспорт
	Значение 		= ТипыКлиентСервер_Ei.СоздатьОписаниеИзКолекции(ТипЗнч(Коллекция));
	СтрокаТип		= ТипыКлиентСервер_Ei.ПолучитьИмяОписанияТипов(Значение);
	Результат 		= Новый Массив();
	Результат.Добавить(КоллекцияВызовСервера_Ei.ПолучитьКолонку(РеквизитКоллекции,СтрокаТип,КоллекцияВызовСервера_Ei.ПолучитьКолонки(Коллекция)));
	Возврат Результат;			
КонецФункции

// Изменить реквизиты.
// 
// Параметры:
//  Форма 					- Форма
//  ИмяОсновногоРеквизита	- Строка
//  Результат				- ТаблицаЗначений, ДеревоЗначений -
Процедура ИзменитьРеквизиты(Форма, ИмяОсновногоРеквизита, Результат) Экспорт
	Добавление 		= Новый Массив;
	Удаление 		= Новый Массив;
	Колонки 		= ПолучитьКоллекциюИСостав(ИмяОсновногоРеквизита, Результат);
	ИзменитьРеквизитыПути(Форма,Добавление,Удаление,Колонки);
	Форма.ИзменитьРеквизиты(Добавление, Удаление);
КонецПроцедуры
#КонецОбласти


#Область СлужебныеПроцедурыИФункции
// Рекурсивно заполняем параметры мРеквизитовДобавление и мРеквизитовУдаление
// 
// Параметры:
//  Форма 		- ФормаКлиентскогоПриложения- Форма, состав реквизитов которой нужно изменить
//  Добавление 	- Массив из РеквизитФормы - Выходной параметр, массив реквизитов, которые нудно добавить
//  Удаление 	- Массив из Строка - Выходной параметр, массимв полных имен реквизитов, которые необходимо удалить
//  Колонки 	см. КоллекцияВызовСервера_Ei.ПолучитьКолонки
//  Путь 		- Строка - Путь
//  Проверять 	- Булево - Проверять сущесвующие реквизиты 
Процедура ИзменитьРеквизитыПути(Форма,Добавление,Удаление,Колонки,Путь="",Проверять = Истина)
	Существующие = НОвый Массив;
	Если Колонки.Количество() Тогда
		Если Проверять И Удаление.Найти(Путь) = Неопределено Тогда //нужно проверять и не собираемся удалять 
			Существующие     = Форма.ПолучитьРеквизиты(Путь);
		КонецЕсли;		
		Для Каждого Колонка Из Колонки Цикл
			СушРеквизит = Ложь;
			Для Каждого рФормы Из Существующие Цикл
				Если СтрСравнить(рФормы.Имя,Колонка.Колонка.Имя)=0 Тогда
					Если рФормы.ТипЗначения = ТипыКлиентСервер_Ei.ПроверитьОписание(Колонка.Колонка.ТипЗначения) Тогда
						СушРеквизит = Истина;
						Прервать;
					Иначе
						//расходятся по типу их нужно добавить в удаляемые, ниже их отловить не удастся
						УдалитьРеквизит(Удаление,Путь(Путь,рФормы.Имя));
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если Не СушРеквизит Тогда
				ДобавитьРеквизит(Добавление, Колонка, Путь);
			КонецЕсли;
			ИзменитьРеквизитыПути(Форма,Добавление,Удаление,Колонка.мКолонки,Путь(Путь,Колонка.Колонка.Имя),СушРеквизит);		
		КонецЦикла;
		
		//Удалим ранее сущесвующие реквизиты, которых нет в описании
		Если ЗначениеЗаполнено(Путь) Тогда
			Для Каждого рФормы Из Существующие Цикл
				СушРеквизит = Ложь;
				Для Каждого Колонка Из Колонки Цикл
					Если СтрСравнить(рФормы.Имя,Колонка.Колонка.Имя)=0 Тогда
						СушРеквизит = Истина; //Реквизит есть в описании
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если Не СушРеквизит Тогда
					УдалитьРеквизит(Удаление,Путь(рФормы.Путь,рФормы.Имя));
				КонецЕсли;		
			КонецЦикла;
		КонецЕсли;		
	КонецЕсли;	
КонецПроцедуры

Функция Путь(Путь,Окончание)
	Результат = Окончание;
	Если ЗначениеЗаполнено(Путь) Тогда
		Результат = Путь+"."+Результат;		
	КонецЕсли;
	Возврат Результат;		
КонецФункции		

Процедура ДобавитьРеквизит(Добавление, Колонка, Путь)
	ТипЗначения =  ТипыКлиентСервер_Ei.ПроверитьОписание(Колонка.Колонка.ТипЗначения);
	Если ТипЗначения.СодержитТип(Тип("Тип")) Тогда
		ТипЗначения =  Новый ОписаниеТипов; //пустой тип это произвольный, не все типы можно добавлять на форму, к таким например относится Тип, на форму можно добавлять описание типов  #СпецОбработкаТипа
	КонецЕсли;
	Добавление.Добавить(Новый РеквизитФормы(Колонка.Колонка.Имя, ТипЗначения, Путь));
КонецПроцедуры

//Добавляет реквизит в массив, реквизиты не должны дублироваться
//
Процедура УдалитьРеквизит(Удаление,Путь)
	Если Удаление.Найти(Путь) = Неопределено Тогда
		Удаление.Добавить(Путь);
	КонецЕсли;			
КонецПроцедуры
#КонецОбласти
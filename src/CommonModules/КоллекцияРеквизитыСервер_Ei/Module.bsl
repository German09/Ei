//Получем не только сам состав колонок, но и элемент верхнего уровня, саму коллекцию
//
Функция ПолучитьКоллекциюИСостав(РеквизитКоллекции, Коллекция) Экспорт
	Значение 		= ТипыКлиентСервер_Ei.СоздатьОписаниеИзКолекции(ТипЗнч(Коллекция));
	сТип			= ТипыКлиентСервер_Ei.ПолучитьИмяОписанияТипов(Значение);
	Результат 	= Новый Массив();
		Колонка 	= Новый Структура("Имя,ТипЗначения",РеквизитКоллекции,сТип);
	Результат.Добавить(Новый Структура("Колонка,мКолонки",Колонка, КоллекцияВызовСервера_Ei.ПолучитьКолонки(Коллекция)));
	Возврат Результат;			
КонецФункции

Процедура ИзменитьРеквизиты(Форма, ИмяОсновногоРеквизита, Результат) Экспорт
	мРеквизитовДобавление 		= Новый Массив;
	мРеквизитовУдаление 		= Новый Массив;
	мКолонки = ПолучитьКоллекциюИСостав(ИмяОсновногоРеквизита, Результат);
	ИзменитьРеквизитыПути(Форма,мРеквизитовДобавление,мРеквизитовУдаление,мКолонки);
	Форма.ИзменитьРеквизиты(мРеквизитовДобавление, мРеквизитовУдаление);
КонецПроцедуры


// Рекурсивно заполняем параметры мРеквизитовДобавление и мРеквизитовУдаление
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения- Форма, состав реквизитов которой нужно изменить
//  мРеквизитовДобавление - Массив из РеквизитФормы - Выходной параметр, массив реквизитов, которые нудно добавить
//  мРеквизитовУдаление - Массив из Строка - Выходной параметр, массимв полных имен реквизитов, которые необходимо удалить
//  мКолонки - Массив из Структура - Описание структуры колонок
//  Путь - Строка - Путь
//  Проверять - Булево - Проверять сущесвующие реквизиты 
Процедура ИзменитьРеквизитыПути(Форма,мРеквизитовДобавление,мРеквизитовУдаление,мКолонки,Путь="",Проверять = Истина)
	мСуществующихРеквизитов = НОвый Массив;
	Если мКолонки.Количество() Тогда
		Если Проверять И мРеквизитовУдаление.Найти(Путь) = Неопределено Тогда //нужно проверять и не собираемся удалять 
			мСуществующихРеквизитов     = Форма.ПолучитьРеквизиты(Путь);
		КонецЕсли;		
		Для Каждого Колонка Из мКолонки Цикл
			СушРеквизит = Ложь;
			Для Каждого рФормы Из мСуществующихРеквизитов Цикл
				Если СтрСравнить(рФормы.Имя,Колонка.Колонка.Имя)=0 Тогда
					Если рФормы.ТипЗначения = ТипыКлиентСервер_Ei.ПроверитьОписание(Колонка.Колонка.ТипЗначения) Тогда
						СушРеквизит = Истина;
						Прервать;
					Иначе
						//расходятся по типу их нужно добавить в удаляемые, ниже их отловить не удастся
						УдалитьРеквизит(мРеквизитовУдаление,Путь(Путь,рФормы.Имя));
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если Не СушРеквизит Тогда
				ДобавитьРеквизит(мРеквизитовДобавление, Колонка, Путь);
			КонецЕсли;
			ИзменитьРеквизитыПути(Форма,мРеквизитовДобавление,мРеквизитовУдаление,Колонка.мКолонки,Путь(Путь,Колонка.Колонка.Имя),СушРеквизит);		
		КонецЦикла;
		
		//Удалим ранее сущесвующие реквизиты, которых нет в описании
		Если ЗначениеЗаполнено(Путь) Тогда
			Для Каждого рФормы Из мСуществующихРеквизитов Цикл
				СушРеквизит = Ложь;
				Для Каждого Колонка Из мКолонки Цикл
					Если СтрСравнить(рФормы.Имя,Колонка.Колонка.Имя)=0 Тогда
						СушРеквизит = Истина; //Реквизит есть в описании
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если Не СушРеквизит Тогда
					УдалитьРеквизит(мРеквизитовУдаление,Путь(рФормы.Путь,рФормы.Имя));
				КонецЕсли;		
			КонецЦикла;
		КонецЕсли;		
	КонецЕсли;	
КонецПроцедуры

Функция Путь(Путь,Окончание)
	Результат = Окончание;
	Если ЗначениеЗаполнено(Путь) Тогда
		Результат = Путь+"."+Результат;		
	КонецЕсли;
	Возврат Результат;		
КонецФункции		

Процедура ДобавитьРеквизит(мРеквизитовДобавление, Колонка, Путь)
	ТипЗначения =  ТипыКлиентСервер_Ei.ПроверитьОписание(Колонка.Колонка.ТипЗначения);
	Если ТипЗначения.СодержитТип(Тип("Тип")) Тогда
		ТипЗначения =  Новый ОписаниеТипов; //пустой тип это произвольный, не все типы можно добавлять на форму, к таким например относится Тип, на форму можно добавлять описание типов  #СпецОбработкаТипа
	КонецЕсли;
	мРеквизитовДобавление.Добавить(Новый РеквизитФормы(Колонка.Колонка.Имя, ТипЗначения, Путь));
КонецПроцедуры

//Добавляет реквизит в массив, реквизиты не должны дублироваться
//
Процедура УдалитьРеквизит(мРеквизитовУдаление,Путь)
	Если мРеквизитовУдаление.Найти(Путь) = Неопределено Тогда
		мРеквизитовУдаление.Добавить(Путь);
	КонецЕсли;			
КонецПроцедуры
#Область ПрограммныйИнтерфейс

// При запуске.
// 
// Параметры:
//  Форма см. ОбщаяФорма.Ei
//  Отказ - Булево
Процедура ПриЗапуске(Форма,Отказ) Экспорт 
	//чТекущаяСтрока = Неопределено;
	ОтладкаКлиент_Ei.Инициализировать(Форма); 
	УстановитьЗаголовок(Форма);
	Форма.ПодключитьОбработчикОжидания("СкрытьВсплывающиеГруппы",1, Ложь);
	Набор = НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма);
	Если Не Набор.Количество() Тогда
		ФайлыКлиент_Ei.СоздатьНовый(Неопределено, Новый Структура("Форма",Форма));
	ИначеЕсли Набор.Количество() = 1 Тогда
		ЭлементФормыНабора	= Форма.Элементы.Найти(КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента());
		Если Не ЭлементФормыНабора = Неопределено Тогда
			ЭлементФормыНабора.Развернуть(Набор[0].ПолучитьИдентификатор());
		КонецЕсли;			
	КонецЕсли;
	Форма.НастройкиПользователя = ОбщегоНазначенияКлиентСервер_Ei.Структурировать(Форма.СтрНастройкиПользователя);
	ВариантыКлиент_Ei.ОбновитьВаринаты(Форма,Набор); //Чтобы заполнились параметры сеанса, а то при попытке выполнения все будет пусто
	АктивизироватьПоследнийВариант(Форма);
	ФайлыКлиент_Ei.ПодписатьсяНаИзменениеФайлов(); 
КонецПроцедуры	

Процедура ПриЗакрытии(Форма,ЗавершениеРаботы) Экспорт
	Возврат;		
КонецПроцедуры

Процедура ПередЗакрытием(Форма, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка) Экспорт
	ЗапомнитьНастройки(Форма);
КонецПроцедуры

//Реквизит профмы с произволным типов не сохрается заворачиваем все в строку, конечно м.б. через список,
//но это бы сильно замедлило работу, тут не такие критичные данные, их можно и потерять
//
Процедура ЗапомнитьНастройки(Форма) Экспорт
	Форма.СтрНастройкиПользователя = ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(Форма.НастройкиПользователя);
КонецПроцедуры

Процедура ОбновитьЗаголовкиЗакладок(Форма) Экспорт
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		ВариантыКлиент_Ei.ОбновитьЗаголовки(Форма,ТД);
		РезультатыКлиент_Ei.ОбновитьЗаголовки(Форма,ТД);
	КонецЕсли;
	ЗапомнитьНастройки(Форма);	
КонецПроцедуры

Процедура СкрытьВсплывающиеГруппы(Форма) Экспорт
	мЭлементов = Новый Массив;
	мЭлементов.Добавить(ПроцессыКлиент_Ei.ВсплываемаяГруппа(Форма));
	мЭлементов.Добавить(ВариантыКлиент_Ei.ВсплываемаяГруппа(Форма));
	Для Каждого Элемент Из мЭлементов Цикл
		Если Не Элемент = Неопределено
			И Элемент.Видимость 
			И Элемент.Поведение = ПоведениеОбычнойГруппы.Всплывающая Тогда
			Если Элемент.Скрыта() Тогда
				Элемент.Видимость = Ложь;
				Форма.ОтключитьОбработчикОжидания("СкрытьВсплывающиеГруппы");		
			КонецЕсли;	 		
		КонецЕсли;		
	КонецЦикла;	  	
КонецПроцедуры

//Если динамический элемент сткрыть, то может скрыться и закладка если на ней больше нет ничего видимого.
//Для отобраджения закладки в обработчиках в серверных функциях загрузки на основе наличия данных мы определяем нужно ли показывать Логотип.
// 
Процедура ВидимостьДинЭлементов(Форма,Обработчик,ТД) Экспорт
	Если Не ТД = Неопределено Тогда
		ИмяОсновногоРеквизита 	= КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Форма, ТД, Обработчик);
		ПодГруппа 				= КонструкторКлиентСервер_Ei.ГруппаКонтейнера(Форма,Обработчик);
		Если Не ПодГруппа = Неопределено Тогда
			Для Каждого Страница ИЗ ПодГруппа.ПодчиненныеЭлементы Цикл                                    
				Если Страница.Имя = КонструкторКлиентСервер_Ei.ИмяСтраницыКонтейнера(ПодГруппа,ИмяОсновногоРеквизита) Тогда
					Страница.Видимость 			= Истина;
					ПодГруппа.ТекущаяСтраница 	= Страница;
					//Прервать;
				Иначе
					Страница.Видимость 			= Ложь;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

Процедура ВычислитьМодифицированность(Форма,Сохранять = Истина) Экспорт
	//не очень понятно для чего обновление вариантов делать тут, к.м.к. достаточно только при запуске 
	ВариантыКлиент_Ei.ОбновитьВаринаты(Форма,НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма));
	СохраняемыйОбраз 			= СокрЛП(ФайлыКлиент_Ei.вПолучитьСохраняемыйОбраз(Форма));
	Форма.Модифицированность 	= Не (СокрЛП(Форма.СохраненныйОбраз) = СохраняемыйОбраз);
	Форма.ЗапомнитьДанные(СохраняемыйОбраз);
//		//сохраним данные консоли во временный файл
//		Если Сохранять Тогда
//			ФайлыКлиент_Ei.СохранитьВКаталог(ФайлыКлиент_Ei.ПолучитьИмяВременногоФайлаНастройки(Форма.ИмяФайлаНастройки),Новый Структура("Форма",Форма));
//			Форма.ДатаИзменения		= ТекущаяДата(); //перенес сюда, а то без условия постоянно менялась дата изменения
//		КонецЕсли;	
//	КонецЕсли;	
КонецПроцедуры

// Устанавливает заголовок формы по имени файла запросов
// 
// Параметры: Нет.
//  Форма 				- Форма - см. ОбщаяФорма.Ei
//  ПроверятьДатыФайла 	- Булево - Проверять даты файла
//  ЭтоВременныйФайл 	- Булево - Это временный файл
Процедура УстановитьЗаголовок(Форма, ПроверятьДатыФайла = Истина, ЭтоВременныйФайл = Ложь) Экспорт
	Файл = Новый Файл(Форма.ИмяФайлаНастройки);
	Если ЗначениеЗаполнено(Форма.ИмяФайлаНастройки) Тогда
		Окончание = Файл.ИмяБезРасширения;
	Иначе
		Окончание = СтрШаблон("~%1",НаборВариантовКлиентСервер_Ei.ПолучитьИмяНабора(ВариантыКлиент_Ei.Получить(Форма)));
	КонецЕсли;		
	//https://symbl.cc/ru/1F6E0/
	Форма.Заголовок = СтрШаблон("%2 %1", Окончание,ОбщегоНазначенияКлиентСерверПовтИсп_Ei.ПолучитьСтрокуUniCode(128736));
	
//	Форма.Заголовок = ОбщегоНазначенияКлиентСервер_Ei.Постфикс();	
//	Если ЗначениеЗаполнено(Форма.ИмяФайлаНастройки) Тогда
//		Файл = Новый Файл(Форма.ИмяФайлаНастройки);
//		ДопПараметры = Новый Структура("ИмяБезРасширения,ПроверятьДатыФайла,ЭтоВременныйФайл,Форма",Файл.ИмяБезРасширения,ПроверятьДатыФайла,ЭтоВременныйФайл,Форма);
//		Файл.НачатьПроверкуСуществования(Новый ОписаниеОповещения("УстановитьЗаголовокЗавершение",ЭтотОбъект,ДопПараметры));
//	КонецЕсли;
КонецПроцедуры	

//Активизирует вариант с которым последним раз велась работа
//
Процедура АктивизироватьПоследнийВариант(Форма) Экспорт
	КлючНабора			= НаборВариантовКлиент_Ei.Ключ(Форма);
	КлючНастроек 		= НастройкиПользователяКлиентСервер_Ei.ПолучитьТекущийВариант(Форма.НастройкиПользователя,КлючНабора);
	ЭлементФормыНабора	= Форма.Элементы.Найти(КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента());
	Если Не ЭлементФормыНабора = Неопределено Тогда
		Если НЕ КлючНастроек = Неопределено Тогда
			Для Каждого Строка ИЗ ОбщегоНазначенияКлиентСервер_Ei.НайтиВКоллекцииДерева(Новый Структура("КлючНастроек",КлючНастроек),НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма)) Цикл
				ЭлементФормыНабора.ТекущаяСтрока = Строка.ПолучитьИдентификатор();
				//Нужно развернуть все вышестоящие, а то не понятно где текущая
				Пока Не Строка.ПолучитьРодителя() = Неопределено Цикл
					Строка = Строка.ПолучитьРодителя(); //поднимаемся на уровень выше
					ЭлементФормыНабора.Развернуть(Строка.ПолучитьИдентификатор());						
				КонецЦикла;	
				Прервать;
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда 
		НаборВариантовКлиент_Ei.ВосстановитьВариант(Форма,ТД);
	КонецЕсли;		
КонецПроцедуры

//Изменяем  видимость Таблицы Параметров
//
Процедура ИзменитьВидимостьТаблицыПараметры(Форма) Экспорт
	ИзменитьВидимостьЭлемента(Форма,"ПараметрыВидимостьТаблицы",ПараметрыКлиент_Ei.КоллекцияПараметров(Форма).Имя)
КонецПроцедуры

Процедура ИзменитьВидимостьЭлемента(Форма,ИмяКнопкиВидимости,ИмяЭлемента) Экспорт
	КнопкаВидимости =  Форма.Элементы.Найти(ИмяКнопкиВидимости);
	Если Не КнопкаВидимости =  Неопределено Тогда
		КнопкаВидимости.Пометка = Не КнопкаВидимости.Пометка;
		Элемент = Форма.Элементы.Найти(ИмяЭлемента);
		Если Не Элемент =  Неопределено Тогда
			Элемент.Видимость = КнопкаВидимости.Пометка;
		КонецЕсли;		
	КонецЕсли;		
КонецПроцедуры

Процедура АктивизироватьКП(Форма,Обработчик) Экспорт
	ОбщийКонтейнер		= Обработчик.Свойства().Класс.ГруппаКонтейнераКП(Форма);
	Если Не ОбщийКонтейнер = Неопределено Тогда
		ИмяТекущего = КонструкторКлиентСервер_Ei.ПолучитьИмяКПОбработчика(Обработчик);
		Для Каждого ГруппаВарианта ИЗ ОбщийКонтейнер.ПодчиненныеЭлементы Цикл
			Если  Не ГруппаВарианта.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели Тогда //Обычные кнопки трогать не будем, только группы
				ГруппаВарианта.Видимость = 	(ГруппаВарианта.Имя = ИмяТекущего);		
			КонецЕсли;	
		КонецЦикла;		
	КонецЕсли;		
КонецПроцедуры
#КонецОбласти


#Область СлужебныеПроцедурыИФункции
//Устарела
Процедура УстановитьЗаголовокЗавершение(Результат,ДопПараметры)
	Форма 			= ДопПараметры.Форма;
	Форма.Заголовок = ОбщегоНазначенияКлиентСервер_Ei.Постфикс() + " : " + ?(ДопПараметры.ЭтоВременныйФайл,"~","")+ДопПараметры.ИмяБезРасширения;
	Возврат;
	Если Результат Тогда
		Форма.СохраненныйОбраз 	= ФайлыКлиент_Ei.ПрочитатьТекст(Форма.ИмяФайлаНастройки);  
		// тут не очень понятно насколько данные в файле свежее тех что мы видим
		Если ДопПараметры.ПроверятьДатыФайла Тогда
			Файл = Новый Файл(Форма.ИмяФайлаНастройки);
			Файл.НачатьПолучениеВремениИзменения(Новый ОписаниеОповещения("ОО_ПолучениеВремениИзмененияСохраненногоФайла",ФайлыКлиент_Ei,Новый Структура("Форма,ДатаИзменения,ИмяФайла",Форма,Форма.ДатаИзменения,Форма.ИмяФайлаНастройки)));
		КонецЕсли;
		ВычислитьМодифицированность(Форма,Ложь); 
	КонецЕсли;	
Конецпроцедуры
#КонецОбласти	
	
Процедура ОткрытьСтруктуру(Форма) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		Параметры = Новый Структура("Коллекция",ТД[ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя]);
		ОткрытьФорму("ОбщаяФорма.КоллекцияСтруктура_Ei",Параметры,Форма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	КонецЕсли;	
КонецПроцедуры

Процедура Загрузить(Форма) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		СтруктураВызова = ОбщийМодульКлиент_Ei.ПолучитьСтруктуруПеременных(Форма,Неопределено,Неопределено,Ложь,,Ложь);
		СтруктураВызова.Вставить("ОграничениеТипа",Новый ОписаниеТипов("ТаблицаЗначений,ДеревоЗначений"));
		ОО_Выбора 		= Новый ОписаниеОповещения("ЗагрузитьЗавершениеВыбора",ЭтотОбъект, Новый Структура("Форма",Форма));
		ВыборКлиент_Ei.НачалоВыбора(ОО_Выбора,,Форма,,СтруктураВызова,Ложь,Ложь,"Выберите источник");	
	КонецЕсли;	
КонецПроцедуры

Процедура ЗагрузитьЗавершениеВыбора(Результат,ДопПараметры) Экспорт
	Форма = ДопПараметры.Форма;
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		Форма.ЗагрузитьКоллекцию(Результат.Значение,ТД.ПолучитьИдентификатор());
	КонецЕсли;	
КонецПроцедуры

Процедура ПриИзменении(Форма, Элемент) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		Форма.СохранитьКоллекцию(ТД.ПолучитьИдентификатор());
		Форма.ВычислитьМодифицированность();
	КонецЕсли;	
КонецПроцедуры
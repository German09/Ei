Процедура ЗагрузитьФайл(Форма) Экспорт
	Загрузка = Истина;
	ТекД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТекД = Неопределено Тогда
		Длг 					= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		Длг.Заголовок 			= "Выберите файл для импорта данных";
		Длг.Расширение 			= "xls";
		Длг.МножественныйВыбор	= Ложь;
		Длг.Фильтр 				= "Книга Excel (*.xls)|*.xls?|Табличный документ (*.mxl)|*.mxl|OpenOffice Calc ( *.ods)|*.ods|Все файлы (*.*)|*.*";
		ДопПараметры 			= Новый Структура("Форма,ТД",Форма,ТекД);
		Если Загрузка Тогда
			ОО = Новый ОписаниеОповещения("Excel_Загрузка",ЭтотОбъект,ДопПараметры);	
		Иначе
			ОО = Новый ОписаниеОповещения("Excel_ФормированиеТекста",ЭтотОбъект,ДопПараметры);	
		КонецЕсли;	
		Длг.Показать(ОО);
	КонецЕсли;	
КонецПроцедуры

Процедура ЗагрузитьЗавершениеВыбора(Результат,ДопПараметры) Экспорт
	Форма = ДопПараметры.Форма;
	ТекД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТекД = Неопределено Тогда
		Форма.ЗагрузитьКоллекцию(Результат.Значение,ТекД.ПолучитьИдентификатор());
		//см. ВариантКоллекцияВызовСервера_Ei.ЗагрузитьКоллекцию
	КонецЕсли;	
КонецПроцедуры

// Переносит в строки набора коллекции, заданные кодом вариантов: Варианты("Коллекция").Данные(Источник),
// см. ВариантыВызовСервера_Ei.УстановитьДанные. Таблица строки, уже показанная в форме, перечитывается на сервере.
//
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
//  ЗаданныеДанные - см. ВариантыВызовСервера_Ei.ЗаданныеДанные
//
Процедура ЗагрузитьЗаданныеДанные(Форма, ЗаданныеДанные) Экспорт
	Если ЗаданныеДанные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Обработчик = ВариантКоллекцияКлиентСервер_Ei;
	Для Каждого Заданные Из ЗаданныеДанные Цикл
		Строки = ОбщегоНазначенияКлиентСервер_Ei.НайтиВКоллекцииДерева(Новый Структура("ИмяНабора", Заданные.ИмяНабора),
			НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма));
		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаНабора = Строки.Получить(0);
		Обработчик.ЗагрузитьДанные(СтрокаНабора, Заданные.Данные);
		ИмяРеквизита = КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита(Форма, СтрокаНабора, Обработчик);
		Если Не Форма.Элементы.Найти(ИмяРеквизита) = Неопределено Тогда
			Форма.ПрочитатьКоллекцию(СтрокаНабора.ПолучитьИдентификатор());
		КонецЕсли;
		СтрокаНабора[НаборВариантовКлиентСервер_Ei.ИмяКолонкиСимволов()] = ВариантыКлиент_Ei.СимволыВариантов(Форма, СтрокаНабора);
	КонецЦикла;
	КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
	Форма.ПодключитьОбработчикОжидания("ОбновитьЗаголовкиЗакладок", 0.1, Истина);
КонецПроцедуры

Процедура ПриИзменении(Форма, Элемент) Экспорт
	ТекД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТекД = Неопределено Тогда
		Форма.СохранитьКоллекцию(ТекД.ПолучитьИдентификатор());
		КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма)
	КонецЕсли;	
КонецПроцедуры

Асинх Процедура ИзБуфера(Форма) Экспорт
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТекД = Неопределено Тогда
		Текст = Ждать ОбщегоНазначенияКлиент_Ei.ТекстИзБуфераОбмена(СтандартныйФорматДанныхБуфераОбмена.HTML);
		Если Не ЗначениеЗаполнено(Текст) Тогда
			//видимо просто строки
			Текст = Ждать ОбщегоНазначенияКлиент_Ei.ТекстИзБуфераОбмена();
		КонецЕсли;		
		Форма.ЗагрузитьКоллекцию(Текст,ТекД.ПолучитьИдентификатор());
	КонецЕсли;		
КонецПроцедуры	

//Вызывается при закрытии окна структура Коллекции
//
Процедура ИзменитьСтруктуру(Результат,ДопПараметры) Экспорт
	Если Не Результат = Неопределено Тогда
		Форма = ДопПараметры.Форма;
		ТекД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
		Если Не ТекД = Неопределено Тогда
			Форма.ИзменитьКоллекцию(Результат,ТекД.ПолучитьИдентификатор());;
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры

Процедура Excel_Загрузка(ВыбранныеФайлы, ДопПараметры) Экспорт
	Форма	= ДопПараметры.Форма;
	ТД		= ДопПараметры.ТД;	
	Если Не ВыбранныеФайлы = Неопределено Тогда
		Для Каждого сИмяФайла ИЗ ВыбранныеФайлы	Цикл
			ТабДок = РезультатТДКлиент_Ei.ЗагрузитьИзФайла(сИмяФайла);
			Форма.ЗагрузитьКоллекцию(ТабДок,ТД.ПолучитьИдентификатор());
			Прервать;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры


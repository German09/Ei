Процедура ОткрытьСтруктуру(Форма) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		Параметры = Новый Структура("Коллекция",ТД[ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя]);
		ОткрытьФорму("ОбщаяФорма.КоллекцияСтруктура_Ei",Параметры,Форма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	КонецЕсли;	
КонецПроцедуры

Процедура ПриИзменении(Форма, Элемент) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		Форма.СохранитьКоллекцию(ТД.ПолучитьИдентификатор());
		Форма.ВычислитьМодифицированность();
	КонецЕсли;	
КонецПроцедуры
Процедура ОткрытьСтруктуру(Форма) Экспорт
	ТекД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТекД = Неопределено Тогда
		Параметры 	= Новый Структура(КоллекцияСтруктураКлиентСервер_Ei.РеквизитКоллекции(),ТекД[ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя]);
		ОО_Закрытия	= Новый ОписаниеОповещения("ИзменитьСтруктуру",ЭтотОбъект,Новый Структура("Форма",Форма));
		ОткрытьФорму("Обработка.Коллекция_Ei.Форма.Структура",Параметры,Форма,,,,ОО_Закрытия,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	КонецЕсли;	
КонецПроцедуры

Процедура Загрузить(Форма) Экспорт
	ТекД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТекД = Неопределено Тогда
		СтруктураВызова = ОбщегоНазначенияКлиент_Ei.ПолучитьСтруктуруПеременных(Форма,Неопределено,Неопределено,Ложь,,Ложь);
		//тип ограничивать не будем поскольку будем, все автоматически преобразуется в см. ВариантКоллекцияВызовСервера_Ei.ЗагрузитьКоллекцию
		//СтруктураВызова.Вставить("ОграничениеТипа",Новый ОписаниеТипов("ТаблицаЗначений,ДеревоЗначений"));
		ОО_Выбора 		= Новый ОписаниеОповещения("ЗагрузитьЗавершениеВыбора",ЭтотОбъект, Новый Структура("Форма",Форма));
		ВыборКлиент_Ei.НачалоВыбора(ОО_Выбора,,Форма,,СтруктураВызова,Ложь,Ложь,"Выберите источник");	
	КонецЕсли;	
КонецПроцедуры


//Функция получает список! типов которы возможно использовать на форме
//
Функция СписокДоступныхТипов() Экспорт 
	СписокТипов	= СписокТиповВыбора();
	Для Каждого ЭлементСЗ Из СписокТипов Цикл
		Если ЭлементСЗ.Пометка Тогда
			ЭлементСЗ.Значение = ТипыВызовСервера_Ei.ВсеСсылки(ЭлементСЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат СписокТипов;
КонецФункции

// Список типов формы выбора. Группа ссылочных типов представлена своим именем, а не описанием типов:
// каждый ссылочный тип, впервые попавший на клиент, платформа догружает отдельным серверным вызовом.
//
// Возвращаемое значение:
//  СписокЗначений - с пометкой группы ссылочных типов, значение - имя для см. ТипыКлиентСерверПовтИсп_Ei.ВсеСсылки
//    у остальных значение - ОписаниеТипов
//
Функция СписокТиповВыбора() Экспорт 
	СписокТипов	= Новый СписокЗначений;
	СписокТипов.Добавить(Новый ОписаниеТипов("Число"),					"Число");
	СписокТипов.Добавить(Новый ОписаниеТипов("Строка"),					"Строка");
	СписокТипов.Добавить(Новый ОписаниеТипов("Дата"),					"Дата");
	СписокТипов.Добавить(Новый ОписаниеТипов("Булево"),					"Булево");
    СписокТипов.Добавить(Новый ОписаниеТипов("СписокЗначений"),			"Список значений");
	ДобавитьГруппуСсылок(СписокТипов,"Справочники");
	ДобавитьГруппуСсылок(СписокТипов,"Перечисления");
	ДобавитьГруппуСсылок(СписокТипов,"Документы");
	ДобавитьГруппуСсылок(СписокТипов,"ПланыВидовХарактеристик");
	ДобавитьГруппуСсылок(СписокТипов,"ПланыСчетов");
	ДобавитьГруппуСсылок(СписокТипов,"ПланыВидовРасчета");
	ДобавитьГруппуСсылок(СписокТипов,"ПланыОбмена");
	ДобавитьГруппуСсылок(СписокТипов,"БизнесПроцессы");
	ДобавитьГруппуСсылок(СписокТипов,ОбщегоНазначенияКлиентСервер_Ei.сВнешниеИсточникиДанных());
	//СписокТипов.Добавить(БизнесПроцессы.ТипВсеСсылкиТочекМаршрутаБизнесПроцессов(),	"ТочкиМаршрута",			Истина);
	ДобавитьГруппуСсылок(СписокТипов,"Задачи");
    СписокТипов.Добавить(Новый ОписаниеТипов("ОписаниеТипов"),			"Описание типов");
	СписокТипов.Добавить(Новый ОписаниеТипов("ВидДвиженияНакопления"),	"Вид движения накопления");
	СписокТипов.Добавить(Новый ОписаниеТипов("ВидДвиженияБухгалтерии"),	"Вид движения бухгалтерии");
	СписокТипов.Добавить(Новый ОписаниеТипов("ВидСчета"),				"Вид счета");
	СписокТипов.Добавить(Новый ОписаниеТипов("УникальныйИдентификатор"),"Уникальный идентификатор");
	//СписокТипов.Добавить(ТипыКлиентСервер_Ei.Универсальные().ТаблицаЗначений,		"Таблица значений");		
	Возврат СписокТипов;
КонецФункции

Процедура ДобавитьГруппуСсылок(СписокТипов, ИмяГруппы)
	Если ТипыВызовСервера_Ei.ВсеСсылки(ИмяГруппы).Типы().Количество() Тогда
		СписокТипов.Добавить(ИмяГруппы, ИмяГруппы, Истина);
	КонецЕсли;
КонецПроцедуры

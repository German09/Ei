#Область ПрограммныйИнтерфейс
Функция ПолучитьОбъект(ИмяНабора,ИмяВарианта) Экспорт
	ОбработкаОбъект = Обработки.ОбъектВарианта_Ei.Создать();
	ОбработкаОбъект.ИмяНабора 	= ИмяНабора;
	ОбработкаОбъект.ИмяВарианта = ИмяВарианта;
	Возврат ОбработкаОбъект; 	
КонецФункции

Функция Варианты(ИмяНабора, ИмяВарианта = Неопределено) Экспорт
	Перем Результат;
	//тут вызов только по конкретному имени
	Если Не ИмяВарианта = Неопределено Тогда
		Результат = ПолучитьОбъект(ИмяНабора, ИмяВарианта);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция Данные(ИмяНабора, ИмяВарианта) Экспорт
	Возврат ВариантыКлиентСервер_Ei.ПолучитьИзНабора("Данные",ИмяНабора,ИмяВарианта);			
КонецФункции

// Результат варианта. Результат, которого нет в этом сеансе или который старше срока жизни, получается выполнением варианта.
// Результат сеанса запуска фоновое задание запрашивает у клиента, см. ФоновоеВыполнениеСервер_Ei.ОписаниеИзСеансаЗапуска
//
// Параметры:
//  ИмяНабора - Строка
//  ИмяВарианта - Строка
//  СрокЖизни - Число - сколько секунд результат считается актуальным, 0 - выполнить вариант заново
//
// Возвращаемое значение:
//  Произвольный - у варианта Запрос результат запроса или его заменитель, см. Обработка.ВариантЗапрос_Ei
//
Функция Результат(ИмяНабора,ИмяВарианта,СрокЖизни) Экспорт
	Значение			= Неопределено;
	ОписаниеЗначения 	= ВариантыКлиентСервер_Ei.ПолучитьИзНабора("Результаты",ИмяНабора,ИмяВарианта);
	Актуален			= РезультатНеИстек(ОписаниеЗначения,СрокЖизни);
	Если Актуален Тогда
		Значение	= ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОписаниеЗначения);
		Актуален	= Значение <> Неопределено Или ОписаниеЗначения.Ссылка = Неопределено;
		Если Не Актуален Тогда
			ОписаниеИзСеанса = ФоновоеВыполнениеСервер_Ei.ОписаниеИзСеансаЗапуска(ОписаниеЗначения);
			Если ОписаниеИзСеанса <> Неопределено Тогда
				ЗапомнитьРезультат(ИмяНабора,ИмяВарианта,ОписаниеИзСеанса);
				Значение	= ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОписаниеИзСеанса);
				Актуален	= Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если Не Актуален И ВариантЗаполнен(ИмяНабора,ИмяВарианта) Тогда
		ОписаниеЗначения 	= ВариантыКлиентСервер_Ei.ВыполнитьВариант(ИмяНабора,ИмяВарианта,Новый УникальныйИдентификатор);
		ЗапомнитьРезультат(ИмяНабора,ИмяВарианта,ОписаниеЗначения);
		Значение			= ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОписаниеЗначения);
	КонецЕсли;
	Если ИмяВарианта = "Запрос" Тогда
		Значение = ЗаменительВыгрузки(Значение);
	КонецЕсли;
	Возврат Значение;	
КонецФункции

// Описание результата варианта для панели результатов и формы выбора. Запрос, выполненный в фоне или взятый из истории,
// приходит таблицей: тип результата запроса в описании дает ему те же представления и свойства, что после обычного выполнения.
//
// Параметры:
//  Значение - Произвольный
//  ИмяВарианта - Строка, Неопределено
//  УникальныйИдентификатор - УникальныйИдентификатор
//
// Возвращаемое значение:
//  см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
Функция ОписаниеРезультата(Значение,ИмяВарианта,УникальныйИдентификатор) Экспорт
	ОписаниеТипов = Неопределено;
	Если ИмяВарианта = "Запрос" И ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
		ОписаниеТипов = ТипыКлиентСервер_Ei.Универсальные().РезультатЗапроса;
	КонецЕсли;
	Возврат ОписаниеЗначенияКлиентСервер_Ei.Подготовить(Значение,УникальныйИдентификатор,ОписаниеТипов);
КонецФункции

// Добавить реквизиты.
// 
// Параметры:
//  Форма 			- См. ОбщаяФорма.Ei 
//  ОбработчикИмя 	- Строка - Имя обработчика (модуля) варианта
//  Идентификатор	- Число,Неопределено -
Процедура ДобавитьРеквизиты(Форма,ОбработчикИмя,Идентификатор) Экспорт
	Обработчик = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(ОбработчикИмя);
	Если Не Обработчик = Неопределено Тогда
		Обработчик.ДобавитьРеквизиты(Форма,Идентификатор);
	КонецЕсли;		
КонецПроцедуры

Процедура ИнициализироватьПоИмени(Форма, Обработчик) Экспорт
	Перем Родитель;
	КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,Обработчик);
	Если Обработчик.Свойства().Класс = ВариантыКлиентСервер_Ei Тогда
		Родитель = КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента();
	КонецЕсли;	
	ДобавляемыеРеквизиты	= Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Обработчик.Свойства().Имя, Новый ОписаниеТипов("Строка"),Родитель,,Истина));
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
КонецПроцедуры
#КонецОбласти	

#Область СлужебныеПроцедурыИФункции

Функция РезультатНеИстек(ОписаниеЗначения,СрокЖизни)
	Перем Получен;
	Результат = Ложь;
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ОписаниеЗначения) И ОписаниеЗначения.Свойство("Получен",Получен) Тогда
		Результат = ТекущаяУниверсальнаяДатаВМиллисекундах() - Получен < СрокЖизни * 1000;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ВариантЗаполнен(ИмяНабора,ИмяВарианта)
	Перем Инструкция;
	ДанныеВарианта = ВариантыКлиентСервер_Ei.ПолучитьИзНабора("Данные",ИмяНабора,ИмяВарианта);
	Возврат ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(ДанныеВарианта,"Инструкция",Инструкция) И ЗначениеЗаполнено(Инструкция);
КонецФункции

// Запоминает результат в снимке наборов сеанса, чтобы следующее обращение не выполняло вариант снова.
//
Процедура ЗапомнитьРезультат(ИмяНабора,ИмяВарианта,ОписаниеЗначения)
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ОписаниеЗначения) Тогда
		Снимок 		= Новый Структура(НаборВариантовВызовСервера_Ei.Получить());
		Набор 		= Новый Структура(Снимок[ИмяНабора]);
		Результаты	= Новый Структура;
		Если Набор.Свойство("Результаты") Тогда
			Результаты = Новый Структура(Набор.Результаты);
		КонецЕсли;
		Результаты.Вставить(ИмяВарианта,ОписаниеЗначения);
		Набор.Вставить("Результаты",Новый ФиксированнаяСтруктура(Результаты));
		Снимок.Вставить(ИмяНабора,Новый ФиксированнаяСтруктура(Набор));
		НаборВариантовВызовСервера_Ei.Обновить(Новый ФиксированнаяСтруктура(Снимок));
	КонецЕсли;
КонецПроцедуры

// Результат запроса, выполненного в фоне, приходит таблицей значений: для него обработка с методами результата запроса.
//
Функция ЗаменительВыгрузки(Значение) Экспорт
	Результат = Значение;
	Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
		Результат = Обработки.ВариантЗапрос_Ei.Создать();
		Результат.Заполнить_(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		//Пакет запроса
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ЗаменительВыгрузки(Элемент));
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс
Функция ПолучитьОбъект(ИмяНабора,ИмяВарианта) Экспорт
	ОбработкаОбъект = Обработки.ОбъектВарианта_Ei.Создать();
	ОбработкаОбъект.ИмяНабора 	= ИмяНабора;
	ОбработкаОбъект.ИмяВарианта = ИмяВарианта;
	Возврат ОбработкаОбъект; 	
КонецФункции

Функция Варианты(ИмяНабора, ИмяВарианта = Неопределено) Экспорт
	Перем Результат;
	//тут вызов только по конкретному имени
	Если Не ИмяВарианта = Неопределено Тогда
		Результат = ПолучитьОбъект(ИмяНабора, ИмяВарианта);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция Данные(ИмяНабора, ИмяВарианта) Экспорт
	Возврат ВариантыКлиентСервер_Ei.ПолучитьИзНабора("Данные",ИмяНабора,ИмяВарианта);
КонецФункции

// Задает данные варианта из кода: Варианты("Коллекция").Данные(Источник). Пока только у Коллекции.
// Данные сразу видны в снимке наборов этого сеанса, а форма Ei забирает их после выполнения, см. ЗаданныеДанные
//
// Параметры:
//  ИмяНабора - Строка
//  ИмяВарианта - Строка
//  Источник - Произвольный - то же, что принимает команда «Загрузить», см. ВариантКоллекцияВызовСервера_Ei.ПривестиКоллекцию
//
Процедура УстановитьДанные(ИмяНабора,ИмяВарианта,Знач Источник) Экспорт
	Обработчик = ВариантКоллекцияКлиентСервер_Ei;
	Если ИмяВарианта <> Обработчик.Свойства().Имя Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Данные из кода можно задать только варианту %1, а не %2'"),Обработчик.Свойства().Имя,ИмяВарианта);
	КонецЕсли;
	Снимок = Новый Структура(НаборВариантовВызовСервера_Ei.Получить());
	Если Не Снимок.Свойство(ИмяНабора) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Строка набора %1 не найдена'"),ИмяНабора);
	КонецЕсли;

	ИсходныеДанные = Новый Структура;
	ИсходныеДанные.Вставить(Обработчик.Свойства().Имя,ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(ВариантКоллекцияВызовСервера_Ei.ПривестиКоллекцию(Источник)));
	ИсходныеДанные = Новый ФиксированнаяСтруктура(ИсходныеДанные);

	Набор		= Новый Структура(Снимок[ИмяНабора]);
	ДанныеНабора	= Новый Структура;
	Если Набор.Свойство("Данные") Тогда
		ДанныеНабора = Новый Структура(Набор.Данные);
	КонецЕсли;
	ДанныеНабора.Вставить(ИмяВарианта,ИсходныеДанные);
	Набор.Вставить("Данные",Новый ФиксированнаяСтруктура(ДанныеНабора));
	Заданные	= Новый Структура;
	Если Набор.Свойство(КлючЗаданныхДанных()) Тогда
		Заданные = Новый Структура(Набор[КлючЗаданныхДанных()]);
	КонецЕсли;
	Заданные.Вставить(ИмяВарианта,ИсходныеДанные);
	Набор.Вставить(КлючЗаданныхДанных(),Новый ФиксированнаяСтруктура(Заданные));
	Снимок.Вставить(ИмяНабора,Новый ФиксированнаяСтруктура(Набор));
	НаборВариантовВызовСервера_Ei.Обновить(Новый ФиксированнаяСтруктура(Снимок));
КонецПроцедуры

// Данные вариантов, заданные кодом после последнего обновления снимка наборов, см. УстановитьДанные.
// Перед каждым запуском клиент обновляет снимок, поэтому это данные, заданные последним запуском.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * ИмяНабора - Строка
//   * ИмяВарианта - Строка
//   * Данные - ФиксированнаяСтруктура - как у ПодготовитьДанные варианта
//
Функция ЗаданныеДанные() Экспорт
	Результат = Новый Массив;
	Для Каждого ЭлНабора Из НаборВариантовВызовСервера_Ei.Получить() Цикл
		Заданные = Неопределено;
		Если ЭлНабора.Значение.Свойство(КлючЗаданныхДанных(),Заданные) Тогда
			Для Каждого ЭлДанных Из Заданные Цикл
				Результат.Добавить(Новый Структура("ИмяНабора, ИмяВарианта, Данные",ЭлНабора.Ключ,ЭлДанных.Ключ,ЭлДанных.Значение));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Итоги кода вариантов для формы Ei одним серверным вызовом: вложенные запуски и заданные данные.
//
// Параметры:
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор формы Ei, см. ВложенныеЗапуски
//
// Возвращаемое значение:
//  Структура:
//   * Вложенные - см. ВложенныеЗапуски
//   * ЗаданныеДанные - см. ЗаданныеДанные
//
Функция ИтогиКодаВариантов(Знач УникальныйИдентификатор) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Вложенные",			ВложенныеЗапуски(УникальныйИдентификатор));
	Результат.Вставить("ЗаданныеДанные",	ЗаданныеДанные());
	Возврат Результат;
КонецФункции

// Результат варианта. Результат, которого нет в этом сеансе или который старше срока жизни, получается выполнением варианта.
// Результат сеанса запуска фоновое задание запрашивает у клиента, см. ФоновоеВыполнениеСервер_Ei.ОписаниеИзСеансаЗапуска
//
// Параметры:
//  ИмяНабора - Строка
//  ИмяВарианта - Строка
//  СрокЖизни - Число - сколько секунд результат считается актуальным, 0 - выполнить вариант заново
//
// Возвращаемое значение:
//  Произвольный - у варианта Запрос результат запроса или его заменитель, см. Обработка.ВариантЗапрос_Ei
//
Функция Результат(ИмяНабора,ИмяВарианта,СрокЖизни) Экспорт
	Значение			= Неопределено;
	ОписаниеЗначения 	= ВариантыКлиентСервер_Ei.ПолучитьИзНабора("Результаты",ИмяНабора,ИмяВарианта);
	Актуален			= РезультатНеИстек(ОписаниеЗначения,СрокЖизни);
	Если Актуален Тогда
		Значение	= ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОписаниеЗначения);
		Актуален	= Значение <> Неопределено Или ОписаниеЗначения.Ссылка = Неопределено;
		Если Не Актуален Тогда
			ОписаниеИзСеанса = ФоновоеВыполнениеСервер_Ei.ОписаниеИзСеансаЗапуска(ОписаниеЗначения);
			Если ОписаниеИзСеанса <> Неопределено Тогда
				ЗапомнитьРезультат(ИмяНабора,ИмяВарианта,ОписаниеИзСеанса);
				Значение	= ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОписаниеИзСеанса);
				Актуален	= Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если Не Актуален И ВариантЗаполнен(ИмяНабора,ИмяВарианта) Тогда
		ОписаниеЗначения 	= ВыполнитьВложенный(ИмяНабора,ИмяВарианта);
		ЗапомнитьРезультат(ИмяНабора,ИмяВарианта,ОписаниеЗначения);
		Значение			= ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОписаниеЗначения);
	КонецЕсли;
	Если ИмяВарианта = "Запрос" Тогда
		Значение = ЗаменительВыгрузки(Значение);
	КонецЕсли;
	Возврат Значение;	
КонецФункции

// Выполняет вариант из кода другого варианта как отдельный запуск, вложенный в текущий: он попадает в историю
// и журнал выполнения, а его результат и время забирает форма Ei, см. ВложенныеЗапуски
// Запуск с подменой параметров попадает только в историю и журнал: его результат - не результат строки.
//
// Параметры:
//  ИмяНабора - Строка
//  ИмяВарианта - Строка
//  ЗаменПараметры - Структура, Неопределено - значения параметров на время выполнения
//
// Возвращаемое значение:
//  см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
Функция ВыполнитьВложенный(ИмяНабора,ИмяВарианта,ЗаменПараметры = Неопределено) Экспорт
	ДанныеНабора = НаборВариантовКлиентСервер_Ei.ПолучитьДанныеНабора(ИмяНабора);
	Если ДанныеНабора = Неопределено Тогда
		Возврат ВариантыКлиентСервер_Ei.ВыполнитьВариант(ИмяНабора,ИмяВарианта,Новый УникальныйИдентификатор,,ЗаменПараметры);
	КонецЕсли;
	
	Инструкция = Неопределено;
	ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(ВариантыКлиентСервер_Ei.ПолучитьИзНабора("Данные",ИмяНабора,ИмяВарианта),"Инструкция",Инструкция);
	
	Контекст = Новый Структура;
	Контекст.Вставить("ИмяНабора",		ИмяНабора);
	Контекст.Вставить("ИмяВарианта",	ИмяВарианта);
	Контекст.Вставить("КлючСтроки",		ДанныеНабора.КлючНастроек);
	Контекст.Вставить("СЗаменой",		ТипЗнч(ЗаменПараметры) = Тип("Структура"));
	Контекст.Вставить("Инструкция",		Инструкция);
	Контекст.Вставить("ПервоеСообщение",	ПолучитьСообщенияПользователю(Ложь).Количество());
	Контекст.Вставить("Начатый",		ИсторияВызовСервера_Ei.НачатьЗапускПараметра());
	Контекст.Вставить("Замер",			НачатьЗамерВложенного(Контекст));
	
	НаборДоВызова = НаборВариантовВызовСервера_Ei.ПолучитьТекущийНабор();
	Попытка
		ОписаниеЗначения = ВариантыКлиентСервер_Ei.ВыполнитьВариант(ИмяНабора,ИмяВарианта,Новый УникальныйИдентификатор,,ЗаменПараметры);
	Исключение
		//при ошибке ВыполнитьВариант текущий набор не возвращает
		НаборВариантовВызовСервера_Ei.УстановитьТекущийНабор(НаборДоВызова);
		ЗавершитьВложенный(Контекст,Неопределено,ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	ЗавершитьВложенный(Контекст,ОписаниеЗначения);
	
	Возврат ОписаниеЗначения;
КонецФункции

// Запуски вариантов, вызванных из кода других вариантов после последнего обновления снимка наборов:
// последний запуск на вариант строки. Перед каждым запуском клиент обновляет снимок, поэтому это запуски последнего запуска.
//
// Параметры:
//  УникальныйИдентификатор - УникальныйИдентификатор, Неопределено - идентификатор формы Ei: результат переносится
//    в ее временное хранилище. Неопределено - без результата: фоновое задание передает клиенту только описание
//    запуска, а результат клиент получает из снимка истории, см. ФоновоеВыполнениеВызовСервера_Ei.ВложенныеЗапуски
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Ид - Строка - идентификатор запуска в истории
//   * ИмяНабора - Строка
//   * ИмяВарианта - Строка
//   * Длительность - Число - миллисекунды
//   * Ошибка - Строка
//   * ЕстьСнимок - Булево - результат есть в истории
//   * СнимокУсечен - Булево - в снимке только часть результата
//   * ПредставлениеРезультата - Строка
//   * ОписаниеЗначения - см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
Функция ВложенныеЗапуски(Знач УникальныйИдентификатор = Неопределено) Экспорт
	Результат = Новый Массив;
	Для Каждого ЭлНабора Из НаборВариантовВызовСервера_Ei.Получить() Цикл
		Запуски = Неопределено;
		Если ЭлНабора.Значение.Свойство(КлючВложенных(),Запуски) Тогда
			Для Каждого ЭлЗапуска Из Запуски Цикл
				Вложенный = Новый Структура(ЭлЗапуска.Значение);
				Если УникальныйИдентификатор = Неопределено Тогда
					Вложенный.ОписаниеЗначения = Неопределено;
				Иначе
					Вложенный.ОписаниеЗначения = ОписаниеДляФормы(Вложенный.ОписаниеЗначения,Вложенный.ИмяВарианта,УникальныйИдентификатор);
				КонецЕсли;
				Результат.Добавить(Вложенный);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Описание результата варианта для панели результатов и формы выбора. Запрос, выполненный в фоне или взятый из истории,
// приходит таблицей: тип результата запроса в описании дает ему те же представления и свойства, что после обычного выполнения.
//
// Параметры:
//  Значение - Произвольный
//  ИмяВарианта - Строка, Неопределено
//  УникальныйИдентификатор - УникальныйИдентификатор
//
// Возвращаемое значение:
//  см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
Функция ОписаниеРезультата(Значение,ИмяВарианта,УникальныйИдентификатор) Экспорт
	ОписаниеТипов = Неопределено;
	Если ИмяВарианта = "Запрос" И ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
		ОписаниеТипов = ТипыКлиентСервер_Ei.Универсальные().РезультатЗапроса;
	КонецЕсли;
	Возврат ОписаниеЗначенияКлиентСервер_Ei.Подготовить(Значение,УникальныйИдентификатор,ОписаниеТипов);
КонецФункции

// Добавить реквизиты.
// 
// Параметры:
//  Форма 			- См. ОбщаяФорма.Ei 
//  ОбработчикИмя 	- Строка - Имя обработчика (модуля) варианта
//  Идентификатор	- Число,Неопределено -
Процедура ДобавитьРеквизиты(Форма,ОбработчикИмя,Идентификатор) Экспорт
	Обработчик = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(ОбработчикИмя);
	Если Не Обработчик = Неопределено Тогда
		Обработчик.ДобавитьРеквизиты(Форма,Идентификатор);
	КонецЕсли;		
КонецПроцедуры

Процедура ИнициализироватьПоИмени(Форма, Обработчик) Экспорт
	Перем Родитель;
	КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,Обработчик);
	Если Обработчик.Свойства().Класс = ВариантыКлиентСервер_Ei Тогда
		Родитель = КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента();
	КонецЕсли;	
	ДобавляемыеРеквизиты	= Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Обработчик.Свойства().Имя, Новый ОписаниеТипов("Строка"),Родитель,,Истина));
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
КонецПроцедуры
#КонецОбласти	

#Область СлужебныеПроцедурыИФункции

Функция РезультатНеИстек(ОписаниеЗначения,СрокЖизни)
	Перем Получен;
	Результат = Ложь;
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ОписаниеЗначения) И ОписаниеЗначения.Свойство("Получен",Получен) Тогда
		Результат = ТекущаяУниверсальнаяДатаВМиллисекундах() - Получен < СрокЖизни * 1000;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ВариантЗаполнен(ИмяНабора,ИмяВарианта)
	Перем Инструкция;
	ДанныеВарианта = ВариантыКлиентСервер_Ei.ПолучитьИзНабора("Данные",ИмяНабора,ИмяВарианта);
	Возврат ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(ДанныеВарианта,"Инструкция",Инструкция) И ЗначениеЗаполнено(Инструкция);
КонецФункции

// Запоминает результат в снимке наборов сеанса, чтобы следующее обращение не выполняло вариант снова.
//
Процедура ЗапомнитьРезультат(ИмяНабора,ИмяВарианта,ОписаниеЗначения)
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ОписаниеЗначения) Тогда
		Снимок 		= Новый Структура(НаборВариантовВызовСервера_Ei.Получить());
		Набор 		= Новый Структура(Снимок[ИмяНабора]);
		Результаты	= Новый Структура;
		Если Набор.Свойство("Результаты") Тогда
			Результаты = Новый Структура(Набор.Результаты);
		КонецЕсли;
		Результаты.Вставить(ИмяВарианта,ОписаниеЗначения);
		Набор.Вставить("Результаты",Новый ФиксированнаяСтруктура(Результаты));
		Снимок.Вставить(ИмяНабора,Новый ФиксированнаяСтруктура(Набор));
		НаборВариантовВызовСервера_Ei.Обновить(Новый ФиксированнаяСтруктура(Снимок));
	КонецЕсли;
КонецПроцедуры

Функция НачатьЗамерВложенного(Контекст)
	Обработчик 	= ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(Контекст.ИмяВарианта);
	Синоним		= ?(Обработчик = Неопределено,Контекст.ИмяВарианта,Обработчик.Свойства().Синоним);
	Начатый		= Контекст.Начатый;
	Замер		= ЖурналКлиентСервер_Ei.НачатьЗамер(СтрШаблон("%1 / %2",Контекст.ИмяНабора,Синоним) + Символы.ПС + Строка(Контекст.Инструкция),
		ЖурналКлиентСервер_Ei.ТипыОпераций().Конструктор, , ЖурналКлиентСервер_Ei.НастройкиЗамера(Начатый.Ид, Начатый.Родитель, Ложь));
	Замер.Контекст = Новый Структура("КлючСтроки, Вариант, Запуск",Строка(Контекст.КлючСтроки),Контекст.ИмяВарианта,Начатый.Ид);
	Возврат Замер;
КонецФункции

// Записывает вложенный запуск в историю и журнал и оставляет его в снимке наборов для формы Ei, см. ВложенныеЗапуски
//
// Параметры:
//  Контекст - Структура - см. ВыполнитьВложенный
//  ОписаниеЗначения - ФиксированнаяСтруктура, Неопределено - результат варианта
//  ИнформацияОбОшибке - Неопределено, ИнформацияОбОшибке - ошибка выполнения
//
Процедура ЗавершитьВложенный(Контекст,ОписаниеЗначения,ИнформацияОбОшибке = Неопределено)
	Сообщения	= ФоновоеВыполнениеСервер_Ei.ТекстыСообщений(ПолучитьСообщенияПользователю(Ложь),Контекст.ПервоеСообщение);
	Запуск 		= ИсторияВызовСервера_Ei.ЗавершитьВложенныйЗапуск(Контекст.Начатый,Контекст.КлючСтроки,Контекст.ИмяВарианта,
		Контекст.Инструкция,ОписаниеЗначения,Сообщения,ИнформацияОбОшибке);
	Если ИнформацияОбОшибке = Неопределено Тогда
		ЖурналКлиентСервер_Ei.ЗавершитьЗамер(Контекст.Замер);
	Иначе
		ЖурналКлиентСервер_Ei.ЗавершитьЗамер(Контекст.Замер, ,ИнформацияОбОшибке);
	КонецЕсли;
	Если Не Контекст.СЗаменой Тогда
		Вложенный = Новый Структура;
		Вложенный.Вставить("Ид",						Запуск.Ид);
		Вложенный.Вставить("ИмяНабора",					Контекст.ИмяНабора);
		Вложенный.Вставить("ИмяВарианта",				Контекст.ИмяВарианта);
		Вложенный.Вставить("Длительность",				Запуск.Длительность);
		Вложенный.Вставить("Ошибка",					Запуск.Ошибка);
		Вложенный.Вставить("ЕстьСнимок",				Запуск.ЕстьСнимок);
		Вложенный.Вставить("СнимокУсечен",				Запуск.СнимокУсечен);
		Вложенный.Вставить("ПредставлениеРезультата",	Запуск.ПредставлениеРезультата);
		Вложенный.Вставить("ОписаниеЗначения",			ОписаниеЗначения);
		ЗапомнитьВложенный(Контекст.ИмяНабора,Контекст.ИмяВарианта,Новый ФиксированнаяСтруктура(Вложенный));
		//в фоне результат нужен клиенту сразу, а не с итогом запуска
		ФоновоеВыполнениеСервер_Ei.УведомитьОВложенном(Вложенный);
	КонецЕсли;
КонецПроцедуры

Процедура ЗапомнитьВложенный(ИмяНабора,ИмяВарианта,Вложенный)
	Снимок 	= Новый Структура(НаборВариантовВызовСервера_Ei.Получить());
	Набор 	= Новый Структура(Снимок[ИмяНабора]);
	Запуски	= Новый Структура;
	Если Набор.Свойство(КлючВложенных()) Тогда
		Запуски = Новый Структура(Набор[КлючВложенных()]);
	КонецЕсли;
	Запуски.Вставить(ИмяВарианта,Вложенный);
	Набор.Вставить(КлючВложенных(),Новый ФиксированнаяСтруктура(Запуски));
	Снимок.Вставить(ИмяНабора,Новый ФиксированнаяСтруктура(Набор));
	НаборВариантовВызовСервера_Ei.Обновить(Новый ФиксированнаяСтруктура(Снимок));
КонецПроцедуры

// Результат вложенного запуска во временном хранилище формы Ei: адрес вложенного запуска не привязан к форме
// и жил бы до конца сеанса.
//
Функция ОписаниеДляФормы(ОписаниеЗначения,ИмяВарианта,УникальныйИдентификатор)
	Результат = ОписаниеЗначения;
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ОписаниеЗначения) И ТипЗнч(ОписаниеЗначения.Ссылка) = Тип("Строка")
		И ЭтоАдресВременногоХранилища(ОписаниеЗначения.Ссылка) Тогда
		Результат = ОписаниеРезультата(ПолучитьИзВременногоХранилища(ОписаниеЗначения.Ссылка),ИмяВарианта,УникальныйИдентификатор);
		УдалитьИзВременногоХранилища(ОписаниеЗначения.Ссылка);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция КлючВложенных()
	Возврат "Вложенные";
КонецФункции

Функция КлючЗаданныхДанных()
	Возврат "ЗаданныеДанные";
КонецФункции

// Результат запроса, выполненного в фоне, приходит таблицей значений: для него обработка с методами результата запроса.
//
Функция ЗаменительВыгрузки(Значение) Экспорт
	Результат = Значение;
	Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
		Результат = Обработки.ВариантЗапрос_Ei.Создать();
		Результат.Заполнить_(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		//Пакет запроса
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ЗаменительВыгрузки(Элемент));
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

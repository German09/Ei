#Область ПрограммныйИнтерфейс
Функция ПолучитьОбъект(ИмяНабора,ИмяВарианта) Экспорт
	ОбработкаОбъект = Обработки.ОбъектВарианта_Ei.Создать();
	ОбработкаОбъект.ИмяНабора 	= ИмяНабора;
	ОбработкаОбъект.ИмяВарианта = ИмяВарианта;
	Возврат ОбработкаОбъект; 	
КонецФункции

Функция Варианты(ИмяНабора, ИмяВарианта = Неопределено) Экспорт
	Перем Результат;
	//тут вызов только по конкретному имени
	Если Не ИмяВарианта = Неопределено Тогда
		Результат = ПолучитьОбъект(ИмяНабора, ИмяВарианта);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция Данные(ИмяНабора, ИмяВарианта) Экспорт
	Возврат ВариантыКлиентСервер_Ei.ПолучитьИзНабора("Данные",ИмяНабора,ИмяВарианта);			
КонецФункции

Функция Результат(ИмяНабора,ИмяВарианта) Экспорт
	ОписаниеЗначения 	= ВариантыКлиентСервер_Ei.ПолучитьИзНабора("Результаты",ИмяНабора,ИмяВарианта);
	Результат			= ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОписаниеЗначения);
	Возврат Результат;	
КонецФункции

Процедура ДобавитьРеквизиты(Форма,ОбработчикИмя,ИД) Экспорт
	Обработчик = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(ОбработчикИмя);
	Если Не Обработчик = Неопределено Тогда
		Обработчик.ДобавитьРеквизиты(Форма,ИД);
	КонецЕсли;		
КонецПроцедуры

Процедура ИнициализироватьПоИмени(Форма, Обработчик) Экспорт
	Перем Родитель;
	КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,Обработчик);
	Если Обработчик.Свойства().Класс = ВариантыКлиентСервер_Ei Тогда
		Родитель = КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента();
	КонецЕсли;	
	ДобавляемыеРеквизиты	= Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Обработчик.Свойства().Имя, Новый ОписаниеТипов("Строка"),Родитель,,Истина));
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
КонецПроцедуры
#КонецОбласти	
Процедура ОбновитьВарианты(Варианты) Экспорт
	ПараметрыСеанса.Варианты_Ei = Варианты; 
КонецПроцедуры

Процедура ОбновитьВариант(Вариант) Экспорт
	ПараметрыСеанса.Вариант_Ei = Вариант; 
КонецПроцедуры

Функция ПолучитьВарианты() Экспорт
	Возврат ПараметрыСеанса.Варианты_Ei;
КонецФункции

Функция ПолучитьОбъектВарианта(ИмяВарианта) Экспорт
	ОбработкаОбъект = Обработки.ОбъектВарианта_Ei.Создать();
	ОбработкаОбъект.ИмяВарианта = ИмяВарианта;
	Возврат ОбработкаОбъект; 	
КонецФункции

Процедура Варианты(Результат, ИмяВарианта = Неопределено) Экспорт
	//тут вызов только по конкретному имени
	Если Не ИмяВарианта = Неопределено Тогда
		Результат = ВариантыВызовСервера_Ei.ПолучитьОбъектВарианта(ИмяВарианта);
	Иначе
		Результат = Неопределено;
	КонецЕсли;			
КонецПроцедуры

Процедура Данные(Результат, ИмяВарианта = Неопределено) Экспорт
	//тут вызов только по конкретному имени
	Если Не ИмяВарианта = Неопределено Тогда
		Результат = 1;
	Иначе
		Результат = Неопределено;
	КонецЕсли;			
КонецПроцедуры	

Функция Результаты(ИмяВарианта,ТипВарианта) Экспорт
	Перем Вариант;
	Перем ОписаниеЗначения;
	Перем Результат;
	Если ИмяВарианта = Неопределено Тогда
		ПараметрыСеанса.Вариант_Ei.Свойство("Имя",ИмяВарианта);	
	КонецЕсли;
	Если Не ИмяВарианта = Неопределено Тогда
		ПараметрыСеанса.Варианты_Ei.Свойство(ИмяВарианта,Вариант);
		Если Не Вариант = Неопределено Тогда
			РезультатыВарианта =  Вариант.Результаты;
			Если ТипВарианта = Неопределено Тогда
				//Это возврат всех вариантов он выполняется только на клиенте см. ВариантыКлиент_Ei.Результаты()
				Результат =  Неопределено; 
			Иначе
				//Вычисляем определенный параметр
				Если РезультатыВарианта.Свойство(ТипВарианта,ОписаниеЗначения) Тогда
					Результат	= СтруктурыЗначенийВызовСервера_Ei.ПереопределитьЗначение(ОписаниеЗначения);			
				КонецЕсли;	
			КонецЕсли;		
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;	
КонецФункции	
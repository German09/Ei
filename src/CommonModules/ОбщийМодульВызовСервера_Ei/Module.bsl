#Область ФункцииВыполненияВычисления

//Функция расчтывает значение на встроенном языке
//Параметры:
//	СлужебныеДанные		- <Структура>. Данные определяюшие вычсление(выполнение) значения:(Выражение,ОписаниеТипов)
//	Параметры			- <Структура>. Структура достпных параметров.		
//	ЭтаФорма			- <Форма>. Обычно конструктор запроса. Достпуны другие переменные(РезультатЗапроса,ИндексСтроки,КоличествоСтрок)
//	Объект 				- <Произвольный объект>. Обрабатываемый объект, в контексте групповой обработки
//	ТекущиеДанные 		- <Строка таблицы(дерева) значений>. Текущие данные строки результатов запроса, в контексте групповой обработки
//	СтрокаТЧ 			- <СтрокаТабличнойЧасти>. Строка табличной части объекта в случае обработки ТЧ документа,
//	Запись				- <ЗаписьРегистра>. Элемент коллекции набора записей в случае обработки набора записей
//	ЗагружаемыйОбъект	- <СсылочныйОбъект>. Загружаемый текущей обработкой ссылочный элемент  http://code.google.com/p/enterprise-integrator/issues/detail?id=42
//
Функция __ВычислитьЗначение(СлужебныеДанные__,Параметры_,ЭтаФорма,Объект,ТекущиеДанные,СтрокаТЧ, Запись, ЗагружаемыйОбъект) Экспорт
	Параметры 	= ПолучитьЧистыеПераметры(Параметры_);
	Значение	= Вычислить(СлужебныеДанные__.Выражение);
	
	ОписаниеТипов 			= Неопределено;
	УникальныйИдентификатор	= Неопределено;
	СлужебныеДанные__.Свойство("ОписаниеТипов",ОписаниеТипов); 
	СлужебныеДанные__.Свойство("УникальныйИдентификатор",УникальныйИдентификатор);
	Результат		= ОбщийМодульСервер_Ei.ПослеВычисленияЗначения(Значение,ОписаниеТипов,УникальныйИдентификатор);
	Возврат Результат;
КонецФункции	

//Функция выполняет выражение на встроенном языке и возвращает занчение в переменную "Результат"
//Параметры: 
//	Выражение 			- <Строка>. Выражение на встроенном языке. 
//	Параметры			- <Структура>. Структура достпных параметров.		
//	ЭтаФорма			- <Форма>. Обычно конструктор запроса. Достпуны другие переменные.
//	Объект 				- <Произвольный объект>. Обрабатываемый объект
//	ТекущиеДанные 		- <Строка таблицы(дерева) значений>. Текущие данные строки результатов запроса
//	СтрокаТЧ 			- <СтрокаТабличнойЧасти>. Строка табличной части объекта в случае обработки ТЧ документа.
//	Запись				- <ЗаписьРегистра>. Элемент коллекции набора записей в случае обработки набора записей
//
Функция __ВыполнитьЗначение(СлужебныеДанные__,ЭтаФорма,Параметры_,Объект,ТекущиеДанные,СтрокаТЧ, Запись) Экспорт
	Перем Результат;
	Параметры = ПолучитьЧистыеПераметры(Параметры_);
	Выполнить(СлужебныеДанные__.Выражение);
	Значение = Результат;
	
	ОписаниеТипов 			= Неопределено;
	УникальныйИдентификатор	= Неопределено;
	СлужебныеДанные__.Свойство("ОписаниеТипов",ОписаниеТипов); 
	СлужебныеДанные__.Свойство("УникальныйИдентификатор",УникальныйИдентификатор);
	Результат =  ОбщийМодульСервер_Ei.ПослеВычисленияЗначения(Значение,ОписаниеТипов,УникальныйИдентификатор);
	Возврат Результат;
КонецФункции

Функция __ВыполнитьЗапрос(ТекстЗапроса,ПараметрыЗапроса,УникальныйИдентификатор) Экспорт
	ОбъектЗапрос 			= Новый Запрос;
	ОбъектЗапрос.Текст 		= ТекстЗапроса;
	Для Каждого Свойство ИЗ ОбщийМодульКлиентСервер_Ei.ПолучитьМодифицирПараметрыДляЗапроса(ПолучитьЧистыеПераметры(ПараметрыЗапроса)) Цикл
		Значение = Свойство.Значение;
		ОбъектЗапрос.УстановитьПараметр(Свойство.Ключ,Значение);
	КонецЦикла;
	Значение = ОбъектЗапрос.Выполнить();
	
	Результат = ОбщийМодульСервер_Ei.ПослеВычисленияЗначения(Значение,,УникальныйИдентификатор);
	Возврат Результат;	
КонецФункции

Функция __ВыполнитьСКД(ТекстСКД, ПараметрыЗапроса,УникальныйИдентификатор = Неопределено,ТипГенератора,СтрРасшифровки) Экспорт
	КомпоновщикМакета 		= Новый КомпоновщикМакетаКомпоновкиДанных;
	СхемаКомпоновкиДанных 	= ОбщийМодульКлиентСервер_Ei.Структурировать(ТекстСКД,Новый СхемаКомпоновкиДанных);
	Для Каждого Свойство ИЗ ОбщийМодульКлиентСервер_Ei.ПолучитьМодифицирПараметрыДляЗапроса(ПолучитьЧистыеПераметры(ПараметрыЗапроса)) Цикл
	//	Значение = Свойство.Значение;
	//	ОбъектЗапрос.УстановитьПараметр(Свойство.Ключ,Значение);
	КонецЦикла;
	ДанныеРасшифровки 		= Неопределено;
	тТипГенератора          = Тип(ТипГенератора);
	Если СтрРасшифровки = Неопределено Тогда
		ИсполняемыеНастройки 	= СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	Иначе
		//вызываем расшифровку
		ОбработкаРасшифровки =  Новый ОбработкаРасшифровкиКомпоновкиДанных(СтрРасшифровки.АдресДанныхРасшифровки, Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
        ИсполняемыеНастройки = ОбработкаРасшифровки.ПрименитьНастройки(СтрРасшифровки.ОписаниеОбработкиРасшифровки.Идентификатор, СтрРасшифровки.ОписаниеОбработкиРасшифровки.ПрименяемыеНастройки);
	КонецЕсли;
	
	Для Каждого ПараметрКомпановки ИЗ ИсполняемыеНастройки.ПараметрыДанных.Элементы Цикл
		ПараметрКомпановки.Использование	= ПараметрыЗапроса.Свойство(Строка(ПараметрКомпановки.Параметр),ПараметрКомпановки.Значение);
	КонецЦикла;
	Значение 	= КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, ИсполняемыеНастройки,ДанныеРасшифровки,,тТипГенератора);
	Если тТипГенератора = Тип("ГенераторМакетаКомпоновкиДанных") Тогда
		АдресСхемыКомпоновкиДанных  =  ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных,	Новый УникальныйИдентификатор);
		АдресДанныхРасшифровки  	=  ПоместитьВоВременноеХранилище(ДанныеРасшифровки,		Новый УникальныйИдентификатор); 
		АдресМакета					=  ПоместитьВоВременноеХранилище(Значение,				Новый УникальныйИдентификатор);
		Значение 					=  Новый Структура("АдресСхемыКомпоновкиДанных,АдресДанныхРасшифровки,АдресМакета",АдресСхемыКомпоновкиДанных,АдресДанныхРасшифровки,АдресМакета);
	КонецЕсли;	
	Результат 	=  ОбщийМодульСервер_Ei.ПослеВычисленияЗначения(Значение,,УникальныйИдентификатор);
	Возврат Результат;		
КонецФункции

#КонецОбласти

Функция ПолучитьЧистыеПераметры(Параметры_) Экспорт
	Результат = Новый Структура;
	Если Не Параметры_ = Неопределено Тогда
		Для Каждого Свойство ИЗ Параметры_ Цикл
			Значение = Свойство.Значение;
			Если ТипЗнч(Значение) = Тип("Строка") И ЭтоАдресВременногоХранилища(Значение) Тогда
				Значение = ПолучитьИзВременногоХранилища(Значение);
			КонецЕсли;	
			Результат.Вставить(Свойство.Ключ, Значение);
		КонецЦикла;
	КонецЕсли;	
	Возврат Результат;	
КонецФункции	

//Формирует представление встроенного языка, для вывода отладочных сообщений
//Параметры:
//	СлужебныеДанные		- <Структура>. Данные определяюшие вычсление(выполнение) значения:(Выражение,ОписаниеТипов)
//	ДоступныеПеременные - <Структура>. Структура доступныех переменных
Функция вПолучитьОписаниеВыражения(СлужебныеДанные,ДоступныеПеременные) Экспорт
	СообщениеОтладки	= "выражения на встроенном языке: "+Символы.ПС+Символы.Таб+СлужебныеДанные.Выражение;
	СообщениеОтладки    = СообщениеОтладки+Символы.ПС+"Доступные переменные:";	
	Для Каждого Переменная Из ДоступныеПеременные Цикл
		Если Не Переменная.Значение=Неопределено Тогда
			СообщениеОтладки	= СообщениеОтладки+Символы.ПС+Символы.Таб+Переменная.Ключ+"		-	"+Переменная.Значение;		
		КонецЕсли;
	КонецЦикла;
	Если СлужебныеДанные.Свойство("ОписаниеТипов") Тогда
		СообщениеОтладки	= СообщениеОтладки+Символы.ПС+"Результат, вычисление преобразуется к типу: "+ОбщийМодульКлиентСервер_Ei.ПроверитьОписаниеТипов(СлужебныеДанные.ОписаниеТипов);
	КонецЕсли;
	Возврат СообщениеОтладки; 
КонецФункции

#Область РаботаСРезультатом

// Функция - Получает сохраненный результат для строки дерева значений?
//
// Параметры:
//  сПоказателиРезультата		 - 	Структура - Структура данных ПоказателиРезультата создаваемая процедурой ОбщийМодульКлиентСервер_Ei.ПроверитьПоказателиРезультата
//  СпособВыгрузки				 - 	Число - Способ выгрузки данных в коллекцию
// 
// Возвращаемое значение:
//   - Таблица значение, Дерево значений, Результат запроса, Табличный документ
//
Функция ПолучитьСохраненныйРезультат(ПоказателиРезультата,СпособВыгрузки) Экспорт 
	Результат 		= Неопределено;
	Если ТипЗнч(СпособВыгрузки) = Тип("Строка") Тогда
		ОписаниеТипаРезультата 	= Новый ОписаниеТипов(СпособВыгрузки);
		РезультатПустой 		= ОписаниеТипаРезультата.ПривестиЗначение(Неопределено);
		Если Не ПоказателиРезультата = Неопределено Тогда
			ОписаниеЗначенияТаблицаДерево 	= ПоказателиРезультата.сооАдресовРезультатов.Получить(СпособВыгрузки);
			Если ОписаниеЗначенияТаблицаДерево = Неопределено Тогда
				ОписаниеЗначенияРезультатаЗапроса = ПоказателиРезультата.сооАдресовРезультатов.Получить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().РезультатЗапроса); //РезультатЗапроса  
				Результат 	=  РезультатПустой;
				Если Не ОписаниеЗначенияРезультатаЗапроса = Неопределено Тогда
					СохраненныйРезультат	= ПолучитьИзВременногоХранилища(ОписаниеЗначенияРезультатаЗапроса.Ссылка);
					Если ТипЗнч(СохраненныйРезультат) = Тип("МакетКомпоновкиДанных")
								И (ТипЗнч(Результат) = Тип("ТаблицаЗначений") ИЛИ ТипЗнч(Результат) = Тип("ДеревоЗначений")) Тогда
						ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
						ПроцессорКомпоновки.Инициализировать(СохраненныйРезультат);
						ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
						ПроцессорВывода.УстановитьОбъект(Результат);
						ПроцессорВывода.Вывести(ПроцессорКомпоновки);
					ИначеЕсли ТипЗнч(СохраненныйРезультат) = Тип("Структура") 
								И СохраненныйРезультат.Свойство("АдресМакета") 
								И ТипЗнч(Результат) = Тип("ТабличныйДокумент")  Тогда	
						//Это СКД с расшифровкой для макета ТД (выводится только в таб документ)
						ПроцессорКомпоновки 	= Новый ПроцессорКомпоновкиДанных;
						МакетКомпоновкиДанных	= ПолучитьИзВременногоХранилища(СохраненныйРезультат.АдресМакета);
						ДанныеРасшифровки		= ПолучитьИзВременногоХранилища(СохраненныйРезультат.АдресДанныхРасшифровки);
						//заполним внешние источники
						ВнешниеНаборыДанныхСКД = Новый Структура();
						//Для Каждого Параметр Из ПараметрыЗапроса Цикл
						//	Если ТипЗнч(Параметр.Значение) = Тип("ТаблицаЗначений") Тогда
						//		ВнешниеНаборыДанныхСКД.Вставить(Параметр.Ключ,Параметр.Значение);			
						//	КонецЕсли;	
						//КонецЦикла;
						ПроцессорКомпоновки.Инициализировать(МакетКомпоновкиДанных,ВнешниеНаборыДанныхСКД,ДанныеРасшифровки);
						ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
						ПроцессорВывода.УстановитьДокумент(Результат);
						ПроцессорВывода.Вывести(ПроцессорКомпоновки);
						ПоместитьВоВременноеХранилище(ДанныеРасшифровки,СохраненныйРезультат.АдресДанныхРасшифровки); //обновим адрес для заполнения расшифровки
					ИначеЕсли ТипЗнч(СохраненныйРезультат) = Тип("РезультатЗапроса") Тогда
						Если СпособВыгрузки = ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТаблицаЗначений Тогда
							Результат 	= СохраненныйРезультат.Выгрузить(ОбходРезультатаЗапроса.Прямой);
						ИначеЕсли СпособВыгрузки = ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ДеревоЗначений Тогда
							Результат 	= СохраненныйРезультат.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
						ИначеЕсли СпособВыгрузки = ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТабличныйДокумент Тогда
							Результат 	= вВыгрузитьВТабличныйДокумент(СохраненныйРезультат);
		                КонецЕсли;
					Иначе	
						//тут остается пустой результат, в зависимости от текущей закладки результата
					КонецЕсли;	
				КонецЕсли;	
			Иначе
				Если ЭтоАдресВременногоХранилища(ОписаниеЗначенияТаблицаДерево.Ссылка) Тогда
					Результат 	= ПолучитьИзВременногоХранилища(ОписаниеЗначенияТаблицаДерево.Ссылка);
				Иначе
					//не вовсех случаях есть смысл закидывать во временное хранилище, например ТАБ документ можно сохранить и так в хранилище значений
					Результат 	= ОписаниеЗначенияТаблицаДерево.Ссылка.Получить();
				КонецЕсли;	
			КонецЕсли;	
		Иначе
			//просто отдадим пустую ТЗ для обнуления
			Результат 	= РезультатПустой;
		КонецЕсли;
	КонецЕсли;	
	Возврат Результат; 
КонецФункции

//Полчает кол-во строк таблицы значений или дерева с определенным отбором.
//Параметры:
//	сРезультатЗапроса_Показатели		- <Структура>. Структура данных содержит  структуры ПоказателиВыполнения и ПоказателиРезультата
//	Значение							- <Булево,Число>. Значение колонки пометки
Функция ПолучитьКолВоСтрокРезультата(сРезультатЗапроса_Показатели, Значение) Экспорт
	Возврат ОбщийМодульЗакрытыйВызовСервера_Ei.ПолучитьСтрокиРезультата(сРезультатЗапроса_Показатели, Значение).Количество();	
КонецФункции

// Процедура - Добавляет колонку с пометкой к ТЗ или ДЗ
//
// Параметры:
//  Источник		 - 	Таблица значений Дерево значений - Коллекция к которой добавляем колонку
//  КолонкаПометки	 - 	Строка - Имя колонки пометки
//
Процедура ПроверитьСодержаниеКолонкиСПометкой(Источник,КолонкаПометки = Неопределено) Экспорт
	КолонкаПометки 	= ?(КолонкаПометки = Неопределено,ПеречисленияКлиентСерверПовторноеИспользование_Ei.Пометка(),КолонкаПометки);
	Если  Источник.Колонки.Найти(КолонкаПометки) = Неопределено Тогда
		Источник.Колонки.Вставить(0, КолонкаПометки,  //?(ЭлементыФормы.КонтМеню.Кнопки.МенюРезультататЗапроса.Кнопки.Флажки.Кнопки.ТриСостояния.Пометка,
															// 				Новый ОписаниеТипов("Число"),
																			Новый ОписаниеТипов("Булево")
															//				)
																			,ПеречисленияКлиентСерверПовторноеИспользование_Ei.Пометка());
	КонецЕсли;

//Формирует представление встроенного языка, для вывода отладочных сообщений
//Параметры:
//	СлужебныеДанные		- <Структура>. Данные определяюшие вычсление(выполнение) значения:(Выражение,ОписаниеТипов)
//	ДоступныеПеременные - <Структура>. Структура доступныех переменных
Функция вПолучитьОписаниеВыражения(СлужебныеДанные,ДоступныеПеременные) Экспорт
	СообщениеОтладки	= "выражения на встроенном языке: "+Символы.ПС+Символы.Таб+СлужебныеДанные.Выражение;
	СообщениеОтладки    = СообщениеОтладки+Символы.ПС+"Доступные переменные:";	
	Для Каждого Переменная Из ДоступныеПеременные Цикл
		Если Не Переменная.Значение=Неопределено Тогда
			СообщениеОтладки	= СообщениеОтладки+Символы.ПС+Символы.Таб+Переменная.Ключ+"		-	"+Переменная.Значение;		
		КонецЕсли;
	КонецЦикла;
	Если СлужебныеДанные.Свойство("ОписаниеТипов") Тогда
		СообщениеОтладки	= СообщениеОтладки+Символы.ПС+"Результат, вычисление преобразуется к типу: "+ОбщийМодульКлиентСервер_Ei.ПроверитьОписаниеТипов(СлужебныеДанные.ОписаниеТипов);
	КонецЕсли;
	Возврат СообщениеОтладки; 
КонецФункции


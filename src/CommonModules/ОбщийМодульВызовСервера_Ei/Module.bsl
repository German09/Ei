// Функция - Получить значения определенного перечисления
//
// Параметры:
//  стрОписаниеТипов - Строка - Универсальное строковое описание типов
// 
// Возвращаемое значение:
//   - Соответствие где:
//						Ключ	 - Имя перечисления
//						Значение - Структура:
//											Синоним
//											Значение	Само значение перечисления
//
Функция ПолучитьЗначенияПеречисления(стрОписаниеТипов) Экспорт
	Результат 		= Новый Соответствие;
	ОписаниеТипов 	= ОбщийМодульКлиентСервер_Ei.ПроверитьОписаниеТипов(стрОписаниеТипов);
	ПустоеЗначение  = ОписаниеТипов.ПривестиЗначение();
	МД 				= ПустоеЗначение.Метаданные();
	Для Каждого Значение ИЗ МД.ЗначенияПеречисления Цикл
		Синоним = ?(ПустаяСтрока(Значение.Синоним),Значение.Имя,Значение.Синоним);
		Результат.Вставить(Значение.Имя,Новый Структура("Синоним,Значение",Синоним,Перечисления[МД.Имя][Значение.Имя]));		
	КонецЦикла;	
	Возврат Результат; 
КонецФункции	

// Функция - Получить состав подсистемы
//
// Параметры:
//  СтрИмяПодсистемы - Строка - Имя подсистемы
// 
// Возвращаемое значение:
//   - Массив
//
Функция ПолучитьСоставПодсистемы(СтрИмяПодсистемы) Экспорт
	Результат = Новый Массив;
	Подсистема = Метаданные.Подсистемы.Найти(СтрИмяПодсистемы);
	Если Не Подсистема = Неопределено Тогда
		Для Каждого ЭлСостава ИЗ Подсистема.Состав Цикл
			Результат.Добавить(ЭлСостава.Имя);			
		КонецЦикла	
	КонецЕсли;	
	Возврат Результат; 
КонецФункции 

Функция СоздатьЗапрос(ТекстЗапроса, ПараметрыЗапроса) Экспорт
	Перем Свойство;
	ОбъектЗапрос 			= Новый Запрос;
	ОбъектЗапрос.Текст 		= ТекстЗапроса;
	Для Каждого Свойство ИЗ ОбщийМодульКлиентСервер_Ei.ПолучитьМодифицирПараметрыДляЗапроса(СтруктурыЗначенийВызовСервера_Ei.ПереопределитьПараметры(ПараметрыЗапроса)) Цикл
		Значение = Свойство.Значение;
		ОбъектЗапрос.УстановитьПараметр(Свойство.Ключ,Значение);
	КонецЦикла;
	Возврат ОбъектЗапрос; 
КонецФункции

				
	
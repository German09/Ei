#Область РаботаСРезультатом

// Функция - Получает сохраненный результат для строки дерева значений? 
//
// Параметры:
//  сРезультатЗапроса_Показатели		- <Структура>. Структура данных содержит  структуры ПоказателиВыполнения и ПоказателиРезультата
// 
// Возвращаемое значение:
//   - Таблица значение, Дерево значений, Результат запроса
//
Функция ПолучитьСохраненныйРезультат(сРезультатЗапроса_Показатели) Экспорт 
	Результат 		= Неопределено;
	СпособВыгрузки	= сРезультатЗапроса_Показатели.ПоказателиВыполнения.чСпособВыгрузки;
	РезультатПустой = ПеречисленияКлиентСерверПовторноеИспользование_Ei.ПолучитьКоллекцииРезультата().Получить(СпособВыгрузки);
	Если Не сРезультатЗапроса_Показатели.ПоказателиРезультата = Неопределено Тогда
		АдресРезультатаТаблицаДерево 	= сРезультатЗапроса_Показатели.ПоказателиРезультата.сооАдресовРезультатов.Получить(СпособВыгрузки);
		Если АдресРезультатаТаблицаДерево = Неопределено Тогда
			АдресРезультатаЗапроса = сРезультатЗапроса_Показатели.ПоказателиРезультата.сооАдресовРезультатов.Получить(-1); //РезультатЗапроса
			Результат 	=  РезультатПустой;
			Если Не АдресРезультатаЗапроса = Неопределено Тогда
				СохраненныйРезультат	= ПолучитьИзВременногоХранилища(АдресРезультатаЗапроса);
				Если ТипЗнч(СохраненныйРезультат) = Тип("МакетКомпоновкиДанных") Тогда
					ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
					ПроцессорКомпоновки.Инициализировать(СохраненныйРезультат);
					ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
					ПроцессорВывода.УстановитьОбъект(Результат);
					ПроцессорВывода.Вывести(ПроцессорКомпоновки);
				ИначеЕсли ТипЗнч(СохраненныйРезультат) = Тип("РезультатЗапроса") Тогда
					Если СпособВыгрузки = 1 Тогда
						Результат 	= СохраненныйРезультат.Выгрузить(ОбходРезультатаЗапроса.Прямой);
					ИначеЕсли СпособВыгрузки = 2 Тогда
						Результат 	= СохраненныйРезультат.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
					ИначеЕсли СпособВыгрузки = 3 Тогда
						Результат 	= вВыгрузитьВТабличныйДокумент(СохраненныйРезультат);
	                КонецЕсли;
				Иначе	
					//тут остается пустой результат, в зависимости от текущей закладки результата
				КонецЕсли;	
			КонецЕсли;	
		Иначе
			Результат 	= ПолучитьИзВременногоХранилища(АдресРезультатаТаблицаДерево);
		КонецЕсли;	
	Иначе
		//просто отдадим пустую ТЗ для обнуления
		Результат 	= РезультатПустой;
	КонецЕсли;
	Возврат Результат; 
КонецФункции


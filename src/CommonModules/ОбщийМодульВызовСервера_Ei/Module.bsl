//Необходимо отличать ссылочный тип от любого другого
//
Функция ВсеСсылки(Ограничение = Неопределено) Экспорт
	Если Не Ограничение = Неопределено Тогда
		Если нРег(Ограничение) = нРег(ПеречисленияКлиентСерверПовторноеИспользование_Ei.сВнешниеИсточникиДанных()) Тогда
			Результат = Новый ОписаниеТипов();
			Для Каждого ВнешнийИстоник ИЗ Вычислить(Ограничение) Цикл
				Результат = Новый ОписаниеТипов(Результат,ВнешнийИстоник.Таблицы.ТипВсеСсылки().Типы());		
			КонецЦикла;
			Возврат Результат;
		Иначе	
			Возврат Вычислить(Ограничение+".ТипВсеСсылки()");	
		КонецЕсли;	
	Иначе	
		Результат  = Новый ОписаниеТипов();    
		Результат	= Новый ОписаниеТипов(Результат,Справочники.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,Перечисления.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,Документы.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,ПланыВидовХарактеристик.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,ПланыСчетов.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,ПланыВидовРасчета.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,ПланыОбмена.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,БизнесПроцессы.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,БизнесПроцессы.ТипВсеСсылкиТочекМаршрутаБизнесПроцессов().Типы());
		Результат	= Новый ОписаниеТипов(Результат,Задачи.ТипВсеСсылки().Типы());
		Для Каждого ВнешнийИстоник ИЗ ВнешниеИсточникиДанных Цикл
			Результат = Новый ОписаниеТипов(Результат,ВнешнийИстоник.Таблицы.ТипВсеСсылки().Типы());		
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ОписаниеПростыхТипов()Экспорт
	мПростыхТипов = Новый Массив();
	Для Каждого Строка ИЗ ПеречисленияКлиентСерверПовторноеИспользование_Ei.офПолучитьТаблицуЭлУправления("ПростыеТипы") Цикл
		Попытка мПростыхТипов.Добавить(Тип(Строка.Имя)); Исключение КонецПопытки; //в попытке для совместимости с предыдущими версиями	
	КонецЦикла;	
	Возврат Новый ОписаниеТипов(мПростыхТипов);
КонецФункции	

#КонецОбласти

Функция ВыполнитьЗапросНаСервере(ТекстЗапроса,ПараметрыЗапроса,УникальныйИдентификатор = Неопределено) Экспорт
	ОбъектЗапрос 			= Новый Запрос;
	ОбъектЗапрос.Текст 		= ТекстЗапроса;
	Для Каждого Свойство ИЗ ОбщийМодульКлиентСервер_Ei.ПолучитьМодифицирПараметрыДляЗапроса(ПолучитьЧистыеПераметры(ПараметрыЗапроса)) Цикл
		Значение = Свойство.Значение;
		ОбъектЗапрос.УстановитьПараметр(Свойство.Ключ,Значение);
	КонецЦикла;
	Возврат ПоместитьВоВременноеХранилище(ОбъектЗапрос.Выполнить(), УникальныйИдентификатор);	
КонецФункции

// Формирует список значений на основе структуры колонок
//
// Параметры:
//  АдресРезультатаЗапроса	 - Строка	 	- Адрес результата запроса
//  Объект					 - Произвольное	- Значение произволного типа свойства которого мы получаем
// 
// Возвращаемое значение:
//   - СписокЗначений Список значений со структурой  ОписаниеТипов,Значение
//
Функция вСформироватьСписокПоСтруктуреКолонок(АдресРезультатаЗапроса,Объект,УникальныйИдентификатор) Экспорт
	СписокКолонок			= Новый СписокЗначений();
	Если Не АдресРезультатаЗапроса = Неопределено Тогда
		СохраненныйРезультат	= ПолучитьИзВременногоХранилища(АдресРезультатаЗапроса);
		//для всех ссылочных типов кроме перечисления добавим уникальный идентифкатор
		Если ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки().СодержитТип(ТипЗнч(Объект)) Тогда
			Если ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки("Перечисления").СодержитТип(ТипЗнч(Объект)) Тогда
		    	Возврат СписокКолонок; //тут нет свойств
			ИначеЕсли ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки(ПеречисленияКлиентСерверПовторноеИспользование_Ei.сВнешниеИсточникиДанных()).СодержитТип(ТипЗнч(Объект)) Тогда
                //у внешних ичтоников нет уникального идентифкатора, зато есть значение
				врЗначение = Объект.Значение();
				СписокКолонок.Добавить(Новый ФиксированнаяСтруктура("ОписаниеТипов,Значение,ДополнениеПредставления",ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(ТипЗнч(врЗначение)),врЗначение,ПеречисленияКлиентСерверПовторноеИспользование_Ei.Подмена()+"()"),
										"Значение");
			Иначе	
				СписокКолонок.Добавить(Новый ФиксированнаяСтруктура("ОписаниеТипов,Значение,ДополнениеПредставления",Новый ОписаниеТипов("УникальныйИдентификатор"),Объект.УникальныйИдентификатор(),ПеречисленияКлиентСерверПовторноеИспользование_Ei.Подмена()+"()"),
										"УникальныйИдентификатор");
	        КонецЕсли;
		КонецЕсли;
		ДополнитьСписокПоНаборкуКолонок(СписокКолонок,СохраненныйРезультат.Выгрузить().Колонки,Объект,УникальныйИдентификатор);
	КонецЕсли;								
	Возврат СписокКолонок;  
КонецФункции

Процедура ДополнитьСписокПоНаборкуКолонок(СписокКолонок,Колонки,Объект,УникальныйИдентификатор) Экспорт
	Для Каждого Колонка Из Колонки Цикл
		Значение				= Объект[Колонка.Имя];
		ОписаниеТипов   		= Новый ОписаниеТипов(Колонка.ТипЗначения,,"Null");
		Если ОбщийМодульКлиентСервер_Ei.вОписаниеТиповПересекаются(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ОписаниеТиповДоступныхНаКлиенте(),Колонка.ТипЗначения) Тогда
			СписокКолонок.Добавить(Новый ФиксированнаяСтруктура("ОписаниеТипов,Значение",ОписаниеТипов,Значение)										,Колонка.Имя);
		ИначеЕсли Не УникальныйИдентификатор = Неопределено Тогда	//если адреса формы нет то потом нам будет сложно/новозможно получить значение, поэтому не имеет смысла                                                                                                                	
			//Значение 				= СериализаторXDTO.ЗаписатьXDTO(Значение.Выгрузить());
			ДополнениеПредставления = "";
			ЭтоКоллекция 			= Ложь;
			Если Колонка.ТипЗначения.СодержитТип(Тип("ТаблицаЗначений")) Тогда
				Если Не ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
					//это табличная часть
					Значение 				= Значение.Выгрузить();
					ДополнениеПредставления = ПеречисленияКлиентСерверПовторноеИспользование_Ei.Подмена()+".Выгрузить()";
				КонецЕсли;	
				ЭтоКоллекция 			= Истина;
			КонецЕсли;	
			СписокКолонок.Добавить(Новый ФиксированнаяСтруктура("ЭтоКоллекция,ДополнениеПредставления,Ссылка,Значение",ЭтоКоллекция,ДополнениеПредставления,ПоместитьВоВременноеХранилище(Значение,УникальныйИдентификатор)),Колонка.Имя);	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры	

// Пытается получить ссылку или объект из навигационной ссылки
//
// Параметры:
//  сНавСсылка	 - Строка - Навигационная ссылка вида e1cib/data/Справочник.Справочник1?ref=a291a0c5895957df11e77b287dd26811
// 
// Возвращаемое значение:
//   - 
//
Функция ПолучитьСсылкуИзНавСсылки(сНавСсылка) Экспорт
	Возврат ОбщийМодульСерверПовтороноеИспользование_Ei.ПолучитьСсылкуИзНавСсылки(сНавСсылка);
КонецФункции	
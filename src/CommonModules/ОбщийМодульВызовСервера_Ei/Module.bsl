//Необходимо отличать ссылочный тип от любого другого
//
Функция ВсеСсылки(Ограничение = Неопределено) Экспорт
	Если Не Ограничение = Неопределено Тогда
		Если нРег(Ограничение) = нРег(ПеречисленияКлиентСерверПовторноеИспользование_Ei.сВнешниеИсточникиДанных()) Тогда
			Результат = Новый ОписаниеТипов();
			Для Каждого ВнешнийИстоник ИЗ Вычислить(Ограничение) Цикл
				Результат = Новый ОписаниеТипов(Результат,ВнешнийИстоник.Таблицы.ТипВсеСсылки().Типы());		
			КонецЦикла;
			Возврат Результат;
		Иначе	
			Возврат Вычислить(Ограничение+".ТипВсеСсылки()");	
		КонецЕсли;	
	Иначе	
		Результат  = Новый ОписаниеТипов();    
		Результат	= Новый ОписаниеТипов(Результат,Справочники.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,Перечисления.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,Документы.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,ПланыВидовХарактеристик.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,ПланыСчетов.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,ПланыВидовРасчета.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,ПланыОбмена.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,БизнесПроцессы.ТипВсеСсылки().Типы());
		Результат	= Новый ОписаниеТипов(Результат,БизнесПроцессы.ТипВсеСсылкиТочекМаршрутаБизнесПроцессов().Типы());
		Результат	= Новый ОписаниеТипов(Результат,Задачи.ТипВсеСсылки().Типы());
		Для Каждого ВнешнийИстоник ИЗ ВнешниеИсточникиДанных Цикл
			Результат = Новый ОписаниеТипов(Результат,ВнешнийИстоник.Таблицы.ТипВсеСсылки().Типы());		
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции


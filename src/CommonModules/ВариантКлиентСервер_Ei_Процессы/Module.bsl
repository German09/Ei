#Область ИнтерфейсВариантов

Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",			Ключ());
	Результат.Вставить("Синоним",		Ключ());
	Результат.Вставить("Картинка",		БиблиотекаКартинок.Процессы_Ei);
	Результат.Вставить("КартинкаСсылка",ПоместитьВоВременноеХранилище(Результат.Картинка,Новый УникальныйИдентификатор));
	Результат.Вставить("Класс",			ВариантыКлиентСервер_Ei);
	Результат.Вставить("Исполнение",	Истина); //Исполняется и выводит результат или просто возможно сохранение данных
	Возврат Результат;
КонецФункции	

Функция ВыполнитьВариант(УникальныйИдентификатор,ДопПараметры,ОбработчикРезультата = Неопределено, ДанныеКлиента = Неопределено) Экспорт		
	Перем ОписаниеЗначения;
	Если ОбработчикРезультата =  Неопределено ИЛИ  
		 ОбработчикРезультата.ПереопределитьВыполнение(УникальныйИдентификатор,ДопПараметры,ВариантКлиентСервер_Ei_Процессы,ОписаниеЗначения) Тогда
		//КонтекстВыполнения	= ПолучитьКонтекстВыполнения(Форма, ТД, ДопПараметры);
		
		ГрафСхемаXDTO 		= ВариантыКлиентСервер_Ei.ПолучитьИнструкцию(Неопределено,Свойства().Имя); 
		НастройкиОбработок 	= ВариантыКлиентСервер_Ei.ПолучитьСвойство(Неопределено,Свойства().Имя,"Обработки");
		ИзначальныйОбъект	= ВариантыКлиентСервер_Ei.ПолучитьСвойство(Неопределено,Свойства().Имя,"ИзначальныйОбъект");		
		ОписаниеЗначения	= ПроцессыКлиентСервер_Ei.ВыполнитьПроцесс(УникальныйИдентификатор, ГрафСхемаXDTO, НастройкиОбработок, ДанныеКлиента, Новый Массив, ИзначальныйОбъект);
		//АктуализироватьОбъект(ТД);
		
	КонецЕсли;	
	Возврат ОписаниеЗначения;	
КонецФункции

// Подготовить данные для помещения их в параметры сеанса НаборВариантов_Ei
// 
// Параметры:
//  Объект - ЭлементФормыСтрокаДереваЗначений, Форма - Строка дерева вариантов или форма обработки
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Подготовить данные:
// 		* Инструкция 		- Строка
//		* Обработки 		- ФиксированноеСоответствие из ФиксированнаяСтруктура 
//		* ИзначальныйОбъект	- Строка 
Функция ПодготовитьДанные(Объект) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Инструкция",		Объект.ГрафСхемаXDTO);
	Результат.Вставить("Обработки",			ОбработкиКлиентСервер_Ei.ПолучитьДанныеОбработок(Объект.ДоступныеОбработки));
	Результат.Вставить("ИзначальныйОбъект",	Объект.Процессы_Объект);
	Возврат Новый ФиксированнаяСтруктура(Результат);		
КонецФункции

Процедура ЗагрузитьДанные(Объект,Настройка) Экспорт
	Если ТипЗнч(Настройка) =  Тип("ФиксированнаяСтруктура") ИЛИ ТипЗнч(Настройка) =  Тип("Структура") Тогда
		Объект.ГрафСхемаXDTO		= Настройка.Инструкция;
		Объект.Процессы_Объект 		= Настройка.ИзначальныйОбъект;
		ОбработкиКлиентСервер_Ei.ДобавитьОбработкиВКоллекцию(Объект.ДоступныеОбработки.ПолучитьЭлементы(),Настройка.Обработки);
	КонецЕсли;	
КонецПроцедуры
 	


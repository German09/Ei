#Область ИнтерфейсВариантов

Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",		ВариантыКлиентСерверПовторноеИспользование_Ei.ИмяЭлементаПроцесс());
	Результат.Вставить("Синоним",	"Процессы");
	Результат.Вставить("Картинка",	Новый Картинка);
	Возврат Результат;
КонецФункции	

Функция ВыполнитьВариант(Форма,УникальныйИдентификатор,ТД,Параметры,ДопПараметры,ОбработчикРезультата = Неопределено) Экспорт
	Перем ОписаниеЗначения;
	Если ОбработчикРезультата =  Неопределено ИЛИ  
		 ОбработчикРезультата.ПереопределитьВыполнение(Форма,УникальныйИдентификатор,ТД,Параметры,ДопПараметры,ВариантКлиентСервер_Ei_Процессы,ОписаниеЗначения) Тогда
		КонтекстВыполнения	= ПолучитьКонтекстВыполнения(Форма, ТД, ДопПараметры); 	
		ОписаниеЗначения	= ПроцессыКлиентСервер_Ei.ВыполнитьПроцесс(ТД,КонтекстВыполнения);;
	КонецЕсли;	
	Возврат ОписаниеЗначения;	
КонецФункции	

#Если Клиент Тогда

Процедура Инициализировать(Форма, Контейнер) Экспорт
	ВариантКлиент_Ei_Процессы.Инициализировать(Форма, Контейнер);
КонецПроцедуры

Процедура ПриИзмененииДанных(Форма) Экспорт
	ВариантКлиент_Ei_Процессы.ПриИзмененииДанных(Форма);	
Конецпроцедуры

Процедура ПриОтображении(Форма) Экспорт
	ВариантКлиент_Ei_Процессы.ПриОтображении(Форма);
Конецпроцедуры

Процедура ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ВариантКлиент_Ei_Процессы.ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке);
КонецПроцедуры

#КонецЕсли

#КонецОбласти

Функция ПолучитьКонтекстВыполнения(Форма, ТД, ДопПараметры)
	Перем КонтекстВыполнения;
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,"КонтекстВыполнения") Тогда
		ДопПараметры.Свойство("КонтекстВыполнения",КонтекстВыполнения);	
	Иначе
		#Если Клиент Тогда
			КонтекстВыполнения 	= Форма.ПодготовитьКонтекст(ВариантыКлиент_Ei.ПолучитьСтруктуруДоступныхПеременных(Форма,ТД,Ложь));
		#КонецЕсли			
	КонецЕсли;
	Возврат КонтекстВыполнения;
КонецФункции




#Область ИнтерфейсВариантов

Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",			"Процессы");
	Результат.Вставить("Синоним",		"Процессы");
	Результат.Вставить("Картинка",		БиблиотекаКартинок.Процессы_Ei);
	Результат.Вставить("КартинкаСсылка",ПоместитьВоВременноеХранилище(Результат.Картинка,Новый УникальныйИдентификатор));
	Возврат Результат;
КонецФункции	

Функция ВыполнитьВариант(Форма,УникальныйИдентификатор,ТД,Параметры,ДопПараметры,ОбработчикРезультата = Неопределено) Экспорт
	Перем ОписаниеЗначения;
	Если ОбработчикРезультата =  Неопределено ИЛИ  
		 ОбработчикРезультата.ПереопределитьВыполнение(Форма,УникальныйИдентификатор,ТД,Параметры,ДопПараметры,ВариантКлиентСервер_Ei_Процессы,ОписаниеЗначения) Тогда
		КонтекстВыполнения	= ПолучитьКонтекстВыполнения(Форма, ТД, ДопПараметры); 	
		ОписаниеЗначения	= ПроцессыКлиентСервер_Ei.ВыполнитьПроцесс(ТД,КонтекстВыполнения);;
	КонецЕсли;	
	Возврат ОписаниеЗначения;	
КонецФункции

// Подготовить данные для помещения их в параметры сеанса НаборВариантов_Ei
// 
// Параметры:
//  Форма Форма конструктора
//  Строка Строка дерева вариантов
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Подготовить данные:
// * Инструкция 
Функция ПодготовитьДанные(Форма, Строка) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Инструкция",Строка.ГрафСхемаXDTO);
	Возврат Новый ФиксированнаяСтруктура(Результат);		
КонецФункции	


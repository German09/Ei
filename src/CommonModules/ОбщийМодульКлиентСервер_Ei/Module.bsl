// Возвращает начало строки до определенного символа
// 
// Параметры:
//  ИсходаяСтрока - Строка -Исходая строка
//  Разделитель -Строка- Символ искомый
// 
// Возвращаемое значение:
//  Строка 
Функция СтрНачалоДо(ИсходаяСтрока,Разделитель=" ") Экспорт
	Перем Результат;
	мЧастейСтроки = СтрРазделить(ИсходаяСтрока,Разделитель,Ложь);
	Для Каждого сЧасть ИЗ мЧастейСтроки Цикл
		Результат = сЧасть;
		Прервать;	
	КонецЦикла;
	Возврат Результат; 		
КонецФункции

// Возвращает окончание строки после определенного символа
// 
// Параметры:
//  ИсходаяСтрока - Строка -Исходая строка
//  Разделитель -Строка- Символ искомый
// 
// Возвращаемое значение:
//  Строка 
Функция СтрПослеОкончание(ИсходаяСтрока,Разделитель=" ") Экспорт
	Перем Результат;
	мЧастейСтроки 	= СтрРазделить(ИсходаяСтрока,Разделитель);
	Индекс 			= мЧастейСтроки.ВГраница();
	Если Индекс>=0 Тогда 
		Результат		= мЧастейСтроки[Индекс];
	КонецЕсли;
	Возврат Результат; 		
КонецФункции
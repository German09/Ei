#Область ФункцииВыполненияВычисления

// Функция - Вычисляет/выполняет выражение на встроенном языке
//
// Параметры:
//  Выражение				 - Строка - Вычисляемое выражение
//  УникальныйИдентификатор	 - УникальныйИдентификатор	 -  Идентификатор адреса, в который нужно поместить результат вычисления
//  ОписаниеТипов			 - ОписаниеТипов - Типы, к которым будет приводится вычисленное значение
//  КонтекстВыполнения		 - Структура -
//
// Возвращаемое значение:
//   -  Структура описания значения, формируемая ОбщийМодульКлиентСервер_Ei.ПолучитьОписаниеЗначения()
//	ИЛИ
//	 - 	Уникальный идентификатор значения в Кеше сервера
//  ИЛИ
//	 -  Неопределено, если не заполнено выражение
//
Функция __ВычислитьЗначение(Выражение,УникальныйИдентификатор = Неопределено,ОписаниеТипов = Неопределено,Знач КонтекстВыполнения = Неопределено,СообщатьОбОшибке = Истина) Экспорт
	Результат 			= Неопределено;
	КонтекстВыполнения	= ?(КонтекстВыполнения = Неопределено, Новый Структура,КонтекстВыполнения);
	СообщениеОтладки	= ОбщийМодульВызовСервера_Ei.вПолучитьОписаниеВыражения(Выражение,ОписаниеТипов,КонтекстВыполнения);
	СобытиеОтладкиВыч	= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Вычисление "+СообщениеОтладки,"Встроенный язык",,Ложь); //вычисление некогда не сообщаем поскольку придет сообщение о выполнении елси будет ошибка
	ОшибкаВычисления	= Неопределено;

	Попытка
		Если Не ПустаяСтрока(Выражение) Тогда
			Значение = ОбщийМодульВызовСервера_Ei.__ВычислитьЗначение(Выражение,УникальныйИдентификатор,ОписаниеТипов,КонтекстВыполнения);
		Иначе
			Значение = Неопределено;
		КонецЕсли;	
	Исключение
		Если ТипЗнч(ИнформацияОбОшибке().Причина) =  Тип("ИнформацияОбОшибке") Тогда
			ОшибкаВычисления = ИнформацияОбОшибке().Причина;
		Иначе	
			ОшибкаВычисления = ИнформацияОбОшибке();
		КонецЕсли;	
	КонецПопытки;
	Если ОшибкаВычисления	= Неопределено Тогда
		СобытиеОтладки = СобытиеОтладкиВыч;	
	Иначе	
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладкиВыч,"ОченьВажное",ОшибкаВычисления);
		//попробуем выполнить
		СобытиеОтладки		= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Выполнение "+СообщениеОтладки,"Встроенный язык",СобытиеОтладкиВыч,СообщатьОбОшибке);
		Попытка
			Значение = ОбщийМодульВызовСервера_Ei.__ВыполнитьВыражение(Выражение,УникальныйИдентификатор,ОписаниеТипов,КонтекстВыполнения);
		Исключение
			Если ТипЗнч(ИнформацияОбОшибке().Причина) 			=  Тип("ИнформацияОбОшибке") Тогда
				//это ошибка в запросе, остальное не интересно
				сДополнениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке().Причина);
				ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке().Причина);
			Иначе
				сДополнениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке());
			КонецЕсли;	
			ВызватьИсключение сДополнениеОшибки;
			//ВызватьИсключение "Не удалось вычислить и выполнить выражение на встроенном языке";
		КонецПопытки;	
	КонецЕсли;
	Если ОбщийМодульВызовСервера_Ei.ЭтоАдресКешаЗначений(Значение)  Тогда
		//если получен адрес кеша значений, тоесть процедуры выполнения/вычисления вернули явное значение попробуем получить это значение на клиент
		#Если Клиент Тогда
			Попытка
				Результат =  ОбщийМодульВызовСервера_Ei.ПолучитьЗначениеИзКеша(Значение);
			Исключение
				//если получить его нельзя нужно формировать специальную фиксированную стрктуру описания и дальше на кленете оперировать уже только с ней
				//объязательно в параметрах указываем уникальный идентифкатор иначе попытка бессмысленна ожидать его в служебных данных не стоит. если бы он был там указан мы бы не оказались в этой обработке исключений 
				Результат =  ОбщийМодульВызовСервера_Ei.ПодготовитьОписаниеЗначенияВызовСервера(Значение,Новый УникальныйИдентификатор);
			КонецПопытки
		#Иначе
			//если выполняем на сервере то тут нет возможности проверить поэтому для доступности на клиенте готовим описание
			Результат =  ОбщийМодульВызовСервера_Ei.ПодготовитьОписаниеЗначенияВызовСервера(Значение,Новый УникальныйИдентификатор);
		#КонецЕсли	
	Иначе
		Результат = Значение;
	КонецЕсли;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,"Информация","Результат = "+Строка(Результат)+ПеречисленияКлиентСерверПовторноеИспользование_Ei.ОтладкаПризнакИсключения());
	Возврат  Результат;
КонецФункции

#КонецОбласти

//Создает описание типов на сонове коллекциии с типами, или на основе единичного типа
//Параметры:
//	КоллекцияТипов	-<Произвольный>. Колекция типов или одиночный тип.
//Возвращаемое значение:
//	Описание типов.
Функция СоздатьОписаниеТиповНаОсновеКолекции(КоллекцияТипов) Экспорт
	МассивТипов = Новый Массив;
	Если ТипЗнч(КоллекцияТипов)=Тип("Тип") Тогда
		МассивТипов.Добавить(КоллекцияТипов);		
	Иначе	
		Для каждого Типы из КоллекцияТипов Цикл
			МассивТипов.Добавить(Типы.Тип);	
		КонецЦикла;
	КонецЕсли;	
	Возврат Новый ОписаниеТипов(МассивТипов);
КонецФункции

//Определят схожесть двух объектов описание типов
//Параметры:
//	ОТипов1	-<ОписаниеТипов>.
//	ОТипов2	-<ОписаниеТипов>.	
//Воращаемое значение:  Булево
//	В типах есть одинаковые значения
Функция вОписаниеТиповПересекаются(ОТипов1,ОТипов2) Экспорт
	Если ТипЗнч(ОТипов1) = Тип("ОписаниеТипов") Тогда
		ИсходноеКолвоТипов	= ОТипов1.Типы().Количество();
	Иначе
		ИсходноеКолвоТипов	= 0;
	КонецЕсли;
	
	Если ИсходноеКолвоТипов Тогда
		мИсклТипов 	= ОТипов2.Типы();
		Если мИсклТипов.Количество()=1 Тогда
			Возврат  ОТипов1.СодержитТип(мИсклТипов[0]);
		Иначе
			ОТипов				= Новый ОписаниеТипов(ОТипов1,мИсклТипов);  //складываем типы
			Возврат (ИсходноеКолвоТипов+мИсклТипов.Количество()>ОТипов.Типы().Количество());
		КонецЕсли;	
	Иначе
		Возврат Ложь;
	КонецЕсли;	
КонецФункции

//Заменяет строку по соотвесвие переданному в списке
//Параметры:
//	ИсходнояСтрока		-<Строка>. Строка в которой делаем замену.
//	СоотвесвтиеЗамены   -<Соотвесвтие>. Соответвие замены
//	сОкончание			-<Строка>. Дополнение искомой строки
//	ТолькоОднаЗамена	-<Булево>. Признак только одной замены все остальнгые игнорируются
//
Функция СтрЗаменитьИзСписка(Знач ИсходнояСтрока,СоотвесвтиеЗамены,сОкончание="",ТолькоОднаЗамена = Ложь)Экспорт
	cИсходнояСтрока = ИсходнояСтрока;
	Для Каждого Элемент ИЗ СоотвесвтиеЗамены Цикл
		cИсходнояСтрока = СтрЗаменить(cИсходнояСтрока,Элемент.Ключ+сОкончание,Элемент.Значение+сОкончание);
		Если ТолькоОднаЗамена И Не cИсходнояСтрока = ИсходнояСтрока Тогда
			Прервать;
		КонецЕсли	
	КонецЦикла;
	Возврат cИсходнояСтрока;
КонецФункции

// Функция - Определяет что это структура и унее есть свйство
//
// Параметры:
//  Значение	 - Произвольное	 	- Значение которое нужно проверить на содержание свойства
//  сСвойство	 - Строка	 		- Имя свойства 
// 
// Возвращаемое значение:
//   - Булево, есть или нет свойства у структуры
//
Функция ЕстьСвойство(Значение,сСвойство) Экспорт
	Возврат ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство(сСвойство);	
КонецФункции	

//Убирает из строки проблеы и после них символы ставит в верхнем регистре
//Параметры:
//	Строка  - <Строка>. Исходная строка например "Уникальный идентификатор"
//Возвращаемое значение:
//	Строка  Например "УникальныйИдентификатор"
//
Функция вВрегПослеПробела(Знач Строка) Экспорт
	Пока Найти(Строка," ")>0 Цикл
		позПробела = Найти(Строка," ");
		Строка = СтрЗаменить(Строка,Сред(Строка,позПробела,2),ВРег(СокрЛП(Сред(Строка,позПробела,2))));
	КонецЦикла;
	Возврат Строка;
КонецФункции

Функция вСоединить(Значение1, Значение2) Экспорт
	Если ТипЗнч(Значение1) = Тип("Массив") Тогда
		Для каждого Элемент ИЗ Значение2 Цикл
			Значение1.Добавить(Элемент);		
		КонецЦикла;	
		Возврат Значение1;
	ИначеЕсли ТипЗнч(Значение1) = Тип("Структура") Тогда
		Для Каждого Элемент ИЗ Значение2 Цикл
			Значение1.Вставить(Элемент.Ключ,Элемент.Значение);
		КонецЦикла;	
	    Возврат Значение1;
	Иначе
		Возврат ?(Значение1=Неопределено,Значение2,Значение1);
	КонецЕсли;
КонецФункции	

//Функция - Получает переданное описание типов с клиента на сервер и обратно
//не все типы можно передать поэтому иногда строкой или массивм строк  
//
// Параметры:
//  ВозможноОписаниеТипов	 - Строка,Массив,ОписаниеТипов	 - Значение которое необходимо модифицировать
// 
// Возвращаемое значение:
//   - ОписаниеТипов
//
Функция ПроверитьОписаниеТипов(ВозможноОписаниеТипов) Экспорт
	Если ТипЗнч(ВозможноОписаниеТипов) =  Тип("Строка") Тогда
		Результат = Новый ОписаниеТипов(ВозможноОписаниеТипов);
	ИначеЕсли ТипЗнч(ВозможноОписаниеТипов) =  Тип("Массив") Тогда	
		мТипов = Новый Массив;
		Для Каждого сТип ИЗ ВозможноОписаниеТипов Цикл
			Если Не ПустаяСтрока(сТип) Тогда
				мТипов.Добавить(Тип(сТип));
			КонецЕсли;	
		КонецЦикла;
		Результат = Новый ОписаниеТипов(мТипов);
	Иначе
		Результат = ВозможноОписаниеТипов;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПолучитьИмяТипЗнч(ТипЗнч) Экспорт
	мТипЗнч = СтрРазделить(СериализаторXDTO.ЗаписатьXDTO(ТипЗнч).ЛексическоеЗначение,"}");
	Возврат мТипЗнч[1];
КонецФункции	

//Выполняет преобразование из ID хранящегося в таблицах SQL в строку уникального идентификатора
//и обратно. Достигается за счет перестановки.
//Параметры:
//	Строка	<Строка> Уникальный идентификатор, который нужно преобразовать.
//	Прямое  <Булево>. Режим, если Истина, тогда  из SQL в 1С, ЛОжь- наоборот. 
//Возвращаемое значение:
//	Cтрока. Уникальный идентификатор.
Функция вПреобразоватьИдентификатор(Строка,Прямое=Истина) Экспорт
	Если Прямое Тогда
		//SQL-BE075493F99B1D424CF05D7AF8B48B42
		//Пол-F8B48B42-5D7A-4CF0-9354-07BE9BF9421D
		//Нуж-f8b48b42-5d7a-4cf0-be07-5493f99b1d42
		ЧистаяСтрока 	= СтрЗаменить(СтрЗаменить(Строка, "0X", ""), "0x", "");
		Результат		= Сред(ЧистаяСтрока, 25, 8) + "-";
		Результат		= Результат+Сред(ЧистаяСтрока, 21, 4)+ "-";
		Результат		= Результат+Сред(ЧистаяСтрока, 17, 4) + "-";
		Результат		= Результат+Сред(ЧистаяСтрока, 1, 4) + "-";
		Результат		= Результат+Сред(ЧистаяСтрока, 5, 12);
	Иначе
		//Обратное преобразование
		//1c-f8b48b42-5d7a-4cf0-be07-5493f99b1d42
		//1c-f8b48b425d7a4cf0be075493f99b1d42
		//SQL-0xBE075493F99B1D424CF05D7AF8B48B42
		ЧистаяСтрока = СтрЗаменить(Строка, "-", "");
		Результат = Сред(ЧистаяСтрока, 17, 4)+Сред(ЧистаяСтрока, 21, 12)+Сред(ЧистаяСтрока, 13, 4)+Сред(ЧистаяСтрока, 9, 4)+Сред(ЧистаяСтрока, 1, 8);
		Результат ="0x"+ВРег(Результат);
	КонецЕсли;	
	Возврат Результат;
КонецФункции

//#СпецОбработкаТипа значение описание типов невозможно использовать в запросах, только ТИП
//
Функция ПолучитьМодифицирПараметрыДляЗапроса(ПараметрыЗапроса) Экспорт
	Результат = Новый Структура;
	Если Не ПараметрыЗапроса = Неопределено Тогда 
		Для Каждого Свойство ИЗ ПараметрыЗапроса Цикл
			Результат.Вставить(Свойство.Ключ, ЛокализоватьПараметрДляЗапроса(Свойство.Значение));
		КонецЦикла;
	КонецЕсли;	
	Возврат Результат;	
КонецФункции

Функция ЛокализоватьПараметрДляЗапроса(Значение) Экспорт
	Результат = Значение;
	Если ТипЗнч(Значение) =  Тип("ОписаниеТипов")Тогда //#СпецОбработкаТипа значение описание типов невозможно использовать в запросах, только ТИП
		Если Значение.Типы().Количество() > 1 Тогда
			Результат = Значение.Типы(); //тут передаем массив типов
		Иначе
			Для Каждого Тип ИЗ Значение.Типы() Цикл
				Результат =  Тип;		
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;
	Возврат Результат; 
КонецФункции	

// Функция - преобразовывает объект в строку
//
// Параметры:
//  Объект	 - Объект - Исходная объект
// 
// Возвращаемое значение:
//   - Строка
//
Функция Сериализовать(Объект) Экспорт
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML,Объект,НазначениеТипаXML.Явное);
	Возврат ЗаписьXML.Закрыть();
КонецФункции

// Функция - преобразует строку в объект
//
// Параметры:
//  Строка	 - Строка- Сериализованная строка графической схемы
// 
// Возвращаемое значение:
//   -  Объект
//
Функция Структурировать(Строка,КонструкторОбъекта = Неопределено) Экспорт
	Результат =  КонструкторОбъекта;
	Если Не ПустаяСтрока(Строка) Тогда
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(Строка);
		Результат = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Процедура - Создает структуру показателей результата
//
// Параметры:
//  ПоказателиРезультата - Неопределено - Возвращаемый параметр структуры 
//
Процедура ПроверитьПоказателиРезультата(ПоказателиРезультата) Экспорт
	Если Не ТипЗнч(ПоказателиРезультата) = Тип("Структура") 
		//Далее показатели которые добавлялись не сразу, чтобы работали 
		ИЛИ НЕ ПоказателиРезультата.Свойство("сооВремя")
		ИЛИ НЕ ПоказателиРезультата.Свойство("сооСвойства")
		Тогда
		ПоказателиРезультата = Новый Структура("сооПометок,сооАдресовРезультатов,сооВремя,сооСвойства",Новый Соответствие,Новый Соответствие,Новый Соответствие,Новый Соответствие);
	КонецЕсли;
Конецпроцедуры

// Функция - определяет является ли переданное значение адресом кеша (клиента/сервера) в зависмости от того с какого метса была вызвана
// Повсестить в повторное использование не можем, поскольку на вход не примитивный типы
//
// Параметры:
//  Адрес	 - Пороизвольный	 - Данные которые проверяются на адрес 
// 
// Возвращаемое значение:
//   - Булево
//
Функция ЭтоАдресКешаЗначений(Адрес) Экспорт
	Результат  =  Ложь;
	Если ТипЗнч(Адрес) =  Тип("УникальныйИдентификатор") Тогда
		//ПеречисленияКлиентСерверПовторноеИспользование_Ei.Значения().Получить(Адрес) <> Неопределено); 		
		Для Каждого соо из ПеречисленияКлиентСерверПовторноеИспользование_Ei.Значения() Цикл
			Если соо.Ключ = Адрес Тогда
				Результат =  Истина;
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	Возврат Результат;
Конецфункции

// Функция - Копирует переданную структуру значений
//
// Параметры:
//  Значение - Структура	 - Структура которую нужно скопировать
// 
// Возвращаемое значение:
//   - Структура
//
Функция СкопироватьСтруктуру(Значение) Экспорт
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Результат = Новый Структура;
		Для Каждого Свойство ИЗ Значение Цикл
			Результат.Вставить(Свойство.Ключ,СкопироватьСтруктуру(Свойство.Значение));
		КонецЦикла;
	Иначе
		Результат =  Значение;
	КонецЕсли;
			
	Возврат Результат;
КонецФункции	

#Область ВыполнениеОкружения

// Функция - Выполнить команду окружения  https://infostart.ru/public/1266995/
//
// Параметры:
//  ТекстСкрипта				 - Строка	 - Текст команды
//  ТекущаяПапка				 - Строка	 - Текущая дирректория выполнения, если задана то меняется Тип команды, если не задана то старемся выполнять через батникне меняется 
//  ТаймаутВыполненияКомандыСек	 - Число	 - Таймаут выполнения
// 
// Возвращаемое значение:
//   - Структура со свойствами Вывод и Ошибки
//
Функция ВыполнитьКомандуОкружения(ТекстСкрипта, ТекущаяПапка = Неопределено, ТаймаутВыполненияКомандыСек = 0) Экспорт
	// Структура результата выполнения команды
	РезультатВыполненияСкрипта = Новый Структура;
	РезультатВыполненияСкрипта.Вставить("Вывод", "");
	РезультатВыполненияСкрипта.Вставить("Ошибки", "");

	ВременныйФайлСкрипта 			= ПолучитьИмяВременногоФайла("bat");
	ВременныйФайлСкриптаPowerShell 	= ПолучитьИмяВременногоФайла("ps1");
	
	Если ТекущаяПапка = Неопределено Тогда
		// Подготавливаем скрипт PowerShell для запуска, но для запуска используем BAT'ник, чтобы сохранить условия безопасного запуска через WScript.Shell

		ПутьКПриложению 				= ПутьКИсполняемомуФайлуPowerShell();
		БезопасныйПутьКФайлуСкрипта		= """" + ВременныйФайлСкриптаPowerShell + """";	

		ТекстСкриптаДляВыполнения 	= ПутьКПриложению +" -executionpolicy bypass -File "+БезопасныйПутьКФайлуСкрипта;
		ТекстСкриптаPowerShell 		= ТекстСкрипта;

		ЗаписьТекстаСкриптаPowerShell = Новый ТекстовыйДокумент;
		ЗаписьТекстаСкриптаPowerShell.УстановитьТекст(ТекстСкриптаPowerShell);
		ЗаписьТекстаСкриптаPowerShell.Записать(ВременныйФайлСкриптаPowerShell, КодировкаТекста.UTF8);

		ЗаписатьФайлВформатеUTF8безBOM(ТекстСкриптаДляВыполнения, ВременныйФайлСкрипта);
		МаркерЦитирования 				= БезопасныйПутьКФайлуСкрипта;
		ТекстСкриптаДляВыполнения 		= ВременныйФайлСкрипта;
	Иначе
		//это запуск через cmd, поскольку задана директория то ожидается выполнение единичной команды
		
		//Bat`ник пока не выполняем он дает очень странный эффект
		
		//ЗаписьТекстаСкрипта = Новый ТекстовыйДокумент;
		//ЗаписьТекстаСкрипта.УстановитьТекст(ТекстСкрипта);
		//ЗаписьТекстаСкрипта.Записать(ВременныйФайлСкрипта, "cp866");
		//ТекстСкриптаДляВыполнения 		= ВременныйФайлСкрипта;

		МаркерЦитирования				= ТекстСкрипта;
		ТекстСкриптаДляВыполнения 		= ТекстСкрипта;
	КонецЕсли;	
	
			
	НачалоВыполненияКоманды 	= ТекущаяДата();
	ЗавершениеВыполненияКоманды = НачалоВыполненияКоманды + ТаймаутВыполненияКомандыСек;

	// Инициализация объекта WScript.Shell
	Попытка		
		objShell = Новый COMОбъект("WScript.Shell");		
	Исключение		
		ВызватьИсключение 
			"Не удалось инициализировать WScript.Shell.
			|Подробнее:
			|" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());		
	КонецПопытки;
	// Изменение директории
	Если Не ТекущаяПапка = Неопределено Тогда
		Попытка
			objShell.CurrentDirectory = ТекущаяПапка;	
		Исключение
			ВызватьИсключение "Директория выполненения """+ТекущаяПапка+""" не существует";
		КонецПопытки	
	КонецЕсли;	
	// Выполнение команды
	objWshScriptExec 	= objShell.Exec(ТекстСкриптаДляВыполнения);
	objStdOut 			= objWshScriptExec.StdOut;
	objStdErr 			= objWshScriptExec.StdErr;

	// Проверка истечения времени таймаута
	КомандаЗавершенаПоТаймауту = Ложь;
	Пока objWshScriptExec.Status = 0 Цикл
		Ожидать(1);
		Если ЗначениеЗаполнено(ТаймаутВыполненияКомандыСек) Тогда			
			Если ЗавершениеВыполненияКоманды <= ТекущаяДата() Тогда			
				КомандаЗавершенаПоТаймауту = Истина;			
				Прервать;				
			КонецЕсли;			
		Иначе			
			Прервать;			
		КонецЕсли;		
	КонецЦикла;

	// Читаем из потока результат выполнения команды - информация
	Если НЕ КомандаЗавершенаПоТаймауту Тогда
		РезультатВыполненияСкрипта.Вывод = objStdOut.ReadAll(); //https://docs.microsoft.com/ru-ru/office/vba/language/reference/user-interface-help/readall-method
		//Пока Не objStdOut.AtEndOfStream Цикл			
		//	strLine = objStdOut.ReadLine();
		//	РезультатВыполненияСкрипта.Вывод = РезультатВыполненияСкрипта.Вывод 
		//		+ strLine 
		//		+ Символы.ВК 
		//		+ Символы.ПС;			
		//	Если ЗначениеЗаполнено(ТаймаутВыполненияКомандыСек)
		//		И ЗавершениеВыполненияКоманды <= ТекущаяДата() Тогда				
		//		КомандаЗавершенаПоТаймауту = Истина;
		//		Прервать;				
		//	КонецЕсли;			
		//КонецЦикла; 		
	КонецЕсли;
	// Читаем из потока результат выполнения команды - ошибки
	Если НЕ КомандаЗавершенаПоТаймауту Тогда
		РезультатВыполненияСкрипта.Ошибки  = objStdErr.ReadAll();	
	КонецЕсли;

	// "Насильно" завершаем процесс по завершению работы
	// и "уничтожаем" COM-объект
	Попытка		
		objWshScriptExec.Terminate();
		objWshScriptExec = Неопределено;		
	Исключение		
		objWshScriptExec = Неопределено;		
	КонецПопытки;	
	objShell = Неопределено;

	// Если команда завершена по таймауту - вызываем исключение.
	// Иначе читаем результат и удаляем временные файлы
	УдалитьФайлЕслиВозможно(ВременныйФайлСкрипта);
	УдалитьФайлЕслиВозможно(ВременныйФайлСкриптаPowerShell);
	Если КомандаЗавершенаПоТаймауту Тогда		
		ВызватьИсключение "Внимание! Выполнение остановлено по истечении времени ожидания.";		
	Иначе		
		РезультатВыполненияСкрипта.Вывод 	= СокрЛП(ПреобразоватьКодировку(РезультатВыполненияСкрипта.Вывод));
		//Уберем из вывода цитату самой команды
		чНачалоЦитированияКомнады = СтрНайти(РезультатВыполненияСкрипта.Вывод,МаркерЦитирования);
		Если чНачалоЦитированияКомнады Тогда
			РезультатВыполненияСкрипта.Вывод = СокрЛП(Сред(РезультатВыполненияСкрипта.Вывод,чНачалоЦитированияКомнады+СтрДлина(МаркерЦитирования)));		
		КонецЕсли;	
		РезультатВыполненияСкрипта.Ошибки 	= СокрЛП(ПреобразоватьКодировку(РезультатВыполненияСкрипта.Ошибки));
		#Если Сервер Тогда
			Комментарии = 	"Команада: "+ТекстСкрипта+Символы.ПС+
							"Время выполнения: "+(ТекущаяДата()-НачалоВыполненияКоманды)+" сек."+Символы.ПС+
							"Результат: "+ РезультатВыполненияСкрипта.Вывод + Символы.ПС + РезультатВыполненияСкрипта.Ошибки; 
			ЗаписьЖурналаРегистрации("Выполнение команды окружения",?(ПустаяСтрока(РезультатВыполненияСкрипта.Ошибки),УровеньЖурналаРегистрации.Информация,УровеньЖурналаРегистрации.Ошибка),,,Комментарии);	
		#КонецЕсли
	КонецЕсли;
	Возврат РезультатВыполненияСкрипта; 
КонецФункции

Функция ПреобразоватьКодировку(Текст, ИсходнаяКодировка = "windows-1251", НоваяКодировка = "cp866")
	
	ВременныйФайлИсходный = ПолучитьИмяВременногоФайла();
	
	ЗаписьТекстаИсходный = Новый ТекстовыйДокумент;
	ЗаписьТекстаИсходный.УстановитьТекст(Текст);
	ЗаписьТекстаИсходный.Записать(ВременныйФайлИсходный, ИсходнаяКодировка);
	
	ЧтениеТекстаНовый = Новый ТекстовыйДокумент;
	ЧтениеТекстаНовый.Прочитать(ВременныйФайлИсходный, НоваяКодировка); 
	КонвертированныйТекст = ЧтениеТекстаНовый.ПолучитьТекст();
	
	УдалитьФайлЕслиВозможно(ВременныйФайлИсходный);
	
	Возврат КонвертированныйТекст;	
	
КонецФункции

Функция УдалитьФайлЕслиВозможно(ПутьКФайлу)
	
	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Попытка
		
		УдалитьФайлы(ПутьКФайлу);
		Возврат Истина;
		
	Исключение
		
		Возврат Ложь;
		
	КонецПопытки;
		
КонецФункции

Функция ПутьКИсполняемомуФайлуPowerShell()
	
	Возврат "%SystemRoot%\System32\WindowsPowerShell\v1.0\PowerShell.exe";
	
КонецФункции

Функция ЗаписатьФайлВформатеUTF8безBOM(текст,полноеИмяФайла)

    // записываем в файл с символами BOM в начале файле	
    ТекстовыйФайлUTF8_Bom = Новый ТекстовыйДокумент();
    ТекстовыйФайлUTF8_Bom.ДобавитьСтроку(текст);
    ТекстовыйФайлUTF8_Bom.Записать(полноеИмяФайла,"UTF-8");
	
    // открываем файл и считываем символы после символов BOM
    Данные = Новый ДвоичныеДанные(полноеИмяФайла);
    Строка64=Base64Строка(Данные);
    Строка64=Прав(Строка64,СтрДлина(Строка64)-4);
    ДанныеНаЗапись=Base64Значение(Строка64);
    ДанныеНаЗапись.Записать(полноеИмяФайла); // записываем
	
КонецФункции

// Функция - Пауза
//
// Параметры:
//  ВремяОжидания	 - Число - секунд от 1 до 20 
// 
// Возвращаемое значение:
//   -  Булево, дождались или нет заданной паузы
//
Функция Ожидать(ВремяОжидания) Экспорт
    
    Если ВремяОжидания <> 0 Тогда
        
        НастройкиПрокси = Новый ИнтернетПрокси(Ложь);
        НастройкиПрокси.НеИспользоватьПроксиДляЛокальныхАдресов = Истина;
        НастройкиПрокси.НеИспользоватьПроксиДляАдресов.Добавить("127.0.0.0");
        
        Попытка
            Loopback = Новый HTTPСоединение(
                "127.0.0.0",,,,НастройкиПрокси,
                ВремяОжидания);
            Loopback.Получить(Новый HTTPЗапрос());
            Возврат Истина;
        Исключение
            Возврат Ложь;
        КонецПопытки;
        
    КонецЕсли;
    
КонецФункции

#КонецОбласти

Функция НайтиВКоллекцииДерева(СтрПоиска,КоллекцияСтрок) Экспорт
	Результат 	= Новый Массив;
	Если ТипЗнч(КоллекцияСтрок) = Тип("ДанныеФормыКоллекцияЭлементовДерева") Тогда
		Для Каждого ЭлПоиска ИЗ СтрПоиска Цикл
			Для Каждого Строка ИЗ КоллекцияСтрок Цикл
				Если нРег(Строка[ЭлПоиска.Ключ]) = нРег(ЭлПоиска.Значение) Тогда
					Результат.Добавить(Строка);
				КонецЕсли;
				Для Каждого ВложенныйРезультат ИЗ НайтиВКоллекцииДерева(СтрПоиска,Строка.ПолучитьЭлементы()) Цикл
					Результат.Добавить(ВложенныйРезультат);		
				КонецЦикла;	
			КонецЦикла;
			Прервать;
		КонецЦикла;
	Иначе
		Результат = КоллекцияСтрок.НайтиСтроки(СтрПоиска,Истина);	
	КонецЕсли;	
	Возврат Результат;
КонецФункции
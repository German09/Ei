Функция ПолучитьСвойстваОбъекта(Значение, УникальныйИдентификатор) Экспорт
	сооРезультат = Новый Соответствие;
	Если ТипЗнч(Значение) = Тип("ОбъектXDTO") Тогда
		Для каждого Свойство ИЗ Значение.Свойства() Цикл
			Если ЗначениеЗаполнено(Значение[Свойство.Имя]) Тогда
				сооРезультат.Вставить(Свойство.Имя,Значение[Свойство.Имя]);
			КонецЕсли;	
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
		//ОписаниеТипов			= ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(ТипЗнч(Значение));
		//сИмяОписаниеТипов 		= ОбщийМодульЗакрытыйКлиент_Ei.ПолучитьИмяОписанияТипов(ОписаниеТипов);
		//ПеречисленияКлиентСерверПовторноеИспользование_Ei.ОписаниеТиповДоступныхНаКлиенте();
		сооРезультат.Вставить("Колонки",Новый ФиксированнаяСтруктура("Значение,ЭтоКоллекция",Значение.Колонки,Истина));
		сооРезультат.Вставить("Индексы",Новый ФиксированнаяСтруктура("Значение,ЭтоКоллекция",Значение.Индексы,Истина));
	ИначеЕсли ТипЗнч(Значение) = Тип("КолонкаТаблицыЗначений") Тогда
		сооРезультат.Вставить("Заголовок"	,Значение.Заголовок);	
		сооРезультат.Вставить("Имя"			,Значение.Имя);
		сооРезультат.Вставить("ТипЗначения"	,Значение.ТипЗначения);
		сооРезультат.Вставить("Ширина"		,Значение.Ширина);
	ИначеЕсли ТипЗнч(Значение) = Тип("СтрокаТаблицыЗначений") ИЛИ ТипЗнч(Значение) = Тип("СтрокаДереваЗначений") Тогда
		СписокСвойств   = Новый СписокЗначений;
		ОбщийМодульВызовСервера_Ei.ДополнитьСписокПоНаборкуКолонок(СписокСвойств,Значение.Владелец().Колонки,Значение,УникальныйИдентификатор);
		Для Каждого ЭлСписка ИЗ СписокСвойств Цикл
			сооРезультат.Вставить(ЭлСписка.Представление,ЭлСписка.Значение);		
		КонецЦикла;	
	КонецЕсли;
  	Возврат сооРезультат;
КонецФункции	

//Выполняет преобразование из ID хранящегося в таблицах SQL в строку уникального идентификатора
//и обратно. Достигается за счет перестановки.
//Параметры:
//	Строка	<Строка> Уникальный идентификатор, который нужно преобразовать.
//	Прямое  <Булево>. Режим, если Истина, тогда  из SQL в 1С, ЛОжь- наоборот. 
//Возвращаемое значение:
//	Cтрока. Уникальный идентификатор.
Функция вПреобразоватьИдентификатор(Строка,Прямое=Истина) Экспорт
	Если Прямое Тогда
		//SQL-BE075493F99B1D424CF05D7AF8B48B42
		//Пол-F8B48B42-5D7A-4CF0-9354-07BE9BF9421D
		//Нуж-f8b48b42-5d7a-4cf0-be07-5493f99b1d42
		ЧистаяСтрока 	= СтрЗаменить(СтрЗаменить(Строка, "0X", ""), "0x", "");
		Результат		= Сред(ЧистаяСтрока, 25, 8) + "-";
		Результат		= Результат+Сред(ЧистаяСтрока, 21, 4)+ "-";
		Результат		= Результат+Сред(ЧистаяСтрока, 17, 4) + "-";
		Результат		= Результат+Сред(ЧистаяСтрока, 1, 4) + "-";
		Результат		= Результат+Сред(ЧистаяСтрока, 5, 12);
	Иначе
		//Обратное преобразование
		//1c-f8b48b42-5d7a-4cf0-be07-5493f99b1d42
		//1c-f8b48b425d7a4cf0be075493f99b1d42
		//SQL-0xBE075493F99B1D424CF05D7AF8B48B42
		ЧистаяСтрока = СтрЗаменить(Строка, "-", "");
		Результат = Сред(ЧистаяСтрока, 17, 4)+Сред(ЧистаяСтрока, 21, 12)+Сред(ЧистаяСтрока, 13, 4)+Сред(ЧистаяСтрока, 9, 4)+Сред(ЧистаяСтрока, 1, 8);
		Результат ="0x"+ВРег(Результат);
	КонецЕсли;	
	Возврат Результат;
КонецФункции

//#СпецОбработкаТипа значение описание типов невозможно использовать в запросах, только ТИП
//
Функция ПолучитьМодифицирПараметрыДляЗапроса(ПараметрыЗапроса) Экспорт
	Результат = Новый Структура;
	Для Каждого Свойство ИЗ ПараметрыЗапроса Цикл
		Результат.Вставить(Свойство.Ключ, ЛокализоватьПараметрДляЗапроса(Свойство.Значение));
	КонецЦикла;
	Возврат Результат;	
КонецФункции

Функция ЛокализоватьПараметрДляЗапроса(Значение) Экспорт
	Результат = Значение;
	Если ТипЗнч(Значение) =  Тип("ОписаниеТипов")Тогда //#СпецОбработкаТипа значение описание типов невозможно использовать в запросах, только ТИП
		Если Значение.Типы().Количество() > 1 Тогда
			Результат = Значение.Типы(); //тут передаем массив типов
		Иначе
			Для Каждого Тип ИЗ Значение.Типы() Цикл
				Результат =  Тип;		
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;
	Возврат Результат; 
КонецФункции	
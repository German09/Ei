// Функция - Получает структуру описания метаданных переданного значения (пустого)
//
// Параметры:
//  Значение - Произвольный - произволная ссылка, важен тип значения 
// 
// Возвращаемое значение:
//   -  Структура 
//			*ПолноеИмя 		- Строка - Имя.
//			*Тип 			- Строка - Тип.
//			*ТипДляЗапроса	- Строка - Тип в запросе.
//
Функция ПолучитьОписаниеМетаданных(Значение) Экспорт
	Результат = Новый Структура("ПолноеИмя,Тип,ТипДляЗапроса");
	Попытка
		ЛексическоеЗначение = СериализаторXDTO.ЗаписатьXDTO(ТипЗнч(Значение)).ЛексическоеЗначение;
		Для Каждого Эл ИЗ ТипыКлиентСервер_Ei.Ключевые() Цикл
			Если Найти(ЛексическоеЗначение,Эл.Ключ) Тогда
				Результат.Тип 			= СтрРазделить(Эл.Значение,";")[0];
				Результат.ТипДляЗапроса = СтрРазделить(Эл.Значение,";")[1];
				Результат.ПолноеИмя 	= СтрЗаменить(ЛексическоеЗначение,Эл.Ключ+".","");
				Если Результат.Тип = ОбщийМодульКлиентСервер_Ei.сВнешниеИсточникиДанных() Тогда
					Результат.ПолноеИмя = СтрЗаменить(Результат.ПолноеИмя,".",".Таблица.");	 
				КонецЕсли;	
				Возврат Результат;
			КонецЕсли;	
		КонецЦикла;	
	Исключение
		Возврат Неопределено;
	КонецПопытки;	
КонецФункции

// Получить строку uni code.
// https://infostart.ru/1c/articles/1720944/
// 
// Параметры:
//  КодоваяПозиция - Число
// 
// Возвращаемое значение:
//  Строка - Получить строку uni code
Функция ПолучитьСтрокуUniCode(КодоваяПозиция) Экспорт	
	Результат = Новый Массив;
	Результат.Добавить(Символ(ПобитовыйСдвигВправо(КодоваяПозиция, 10) + (55296 - (ПобитовыйСдвигВправо(65536, 10)))));
	Результат.Добавить(Символ(ПобитовоеИ(КодоваяПозиция, 1023) + 56320));	
	Возврат СтрСоединить(Результат);	
КонецФункции
	
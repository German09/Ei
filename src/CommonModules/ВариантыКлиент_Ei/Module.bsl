#Область ПрограммныйИнтерфейс
Процедура ПриИзмененииДанныхВариантов(Форма) Экспорт
	Для Каждого ЭлВарианта ИЗ ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
		ЭлВарианта.Значение.ПриИзмененииДанных(Форма);
	КонецЦикла;	
КонецПроцедуры

Процедура ПриИзмененииДанныхВариантаСРедактором(Форма,Обработчик) Экспорт
	ЭлементИнструкции = Обработчик.ЭлементИнструкции(Форма);	
	Если Не ЭлементИнструкции = Неопределено И ЭлементИнструкции.Доступность Тогда
		//Нужно дождаться инциализации без этого не будет выполнения методов HTML
		ТекД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
		Если НЕ ТекД = Неопределено Тогда
			Текст =  ТекД[Обработчик.Свойства().Имя];
//			РедакторКодаКлиент_Ei.ОчиститьТекст(ЭлементИнструкции);
//			ТД.Алгоритм  = Алгоритм;	
			РедакторКодаКлиент_Ei.ЗаменитьТекст(ЭлементИнструкции,Текст);;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры	

//Тут размешаем все события которые должны происходить при отображении нового варианта
//
Процедура ПриОтображенииВарианта(Форма,ВариантИмя)
	Вариант = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(ВариантИмя);
	Если Не Вариант = Неопределено Тогда
		КнопкаВыполнения = Форма.Элементы.Найти("ИсполнитьВариант");
		Если Не КнопкаВыполнения = Неопределено Тогда
			КнопкаВыполнения.Доступность = Вариант.Свойства().Исполнение;
		КонецЕсли;	
		КонструкторКлиент_Ei.АктивизироватьКП(Форма,Вариант);
		ОтладкаКлиент_Ei.ОбновитьДекорациюОшибки(Форма,ВариантыКлиентСервер_Ei,ВариантИмя);
		Вариант.ПриОтображении(Форма);
		ОбновитьДекорациюРезультатаВарианта(Форма,Вариант);	
	КонецЕсли;	
КонецПроцедуры

Процедура ПриОтображенииВариантаСРедактором(Форма,Обработчик) Экспорт
	ПараметрыКлиент_Ei.ИзменитьВидимость(Форма,Истина);
	Заполнитель = КонструкторКлиентСервер_Ei.ЗаполнительКонтейнера(Форма,Обработчик);	
	Если Заполнитель.Видимость Тогда
		Заполнитель.Видимость = Ложь;
		Контейнер 	= КонструкторКлиентСервер_Ei.Контейнер(Форма,Обработчик);			
		РедакторКодаКлиент_Ei.НаследоватьРедактор(Форма, Обработчик, Контейнер);		
	КонецЕсли;
КонецПроцедуры	

// Выполнить варианты.
// 
// Параметры:
//  Форма  см. ОбщаяФорма.Ei
//  ДопПараметры - Неопределено,Структура - Доп параметры
Асинх Процедура ВыполнитьВарианты(Форма,ДопПараметры = Неопределено) Экспорт
	Перем ДанныеКлиента;
	ТекД 			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТекД = Неопределено Тогда
		Вариант = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТекД);
		Если Не Вариант = Неопределено Тогда
			//идентификатор запуска уходит в параметры сеанса, чтобы параметры, вычисленные в запуске, попали в его историю
			//строка запроса MCP запускается с идентификатором запроса: по нему запуск находится в истории и журнале
			ИдЗапуска = ЗапросыMCPКлиент_Ei.ИдентификаторЗапуска(ТекД, Вариант);
			Если ИдЗапуска = Неопределено Тогда
				ИдЗапуска = ИсторияКлиент_Ei.НовыйИдентификаторЗапуска(Вариант);
			КонецЕсли;
			ОбновитьВаринаты(Форма,НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма),ИдЗапуска); //обновим варианты, полскольку могли изменится содержание инструкий и других блоков
			ДопПараметры = Ждать Вариант.ПередВыполнением(Форма,ДопПараметры);
			ОтладкаКлиент_Ei.СкрытьИсключение(Форма,ВариантыКлиентСервер_Ei);	
			ДатаНачала 		= ТекущаяУниверсальнаяДатаВМиллисекундах();
			ДопПараметры 	= ?(ДопПараметры = Неопределено,Новый Структура,ДопПараметры);
			ЗапросыMCPКлиент_Ei.ДополнитьПараметрыВыполнения(ТекД, Вариант, ДопПараметры);
			Запуск 			= ИсторияКлиент_Ei.НачатьЗапуск(ИдЗапуска, ТекД, Вариант, ДопПараметры);
			//замер журнала выполнения с тем же идентификатором, что у запуска в истории
			СобытиеОтладки 	= ЖурналКлиентСервер_Ei.НачатьЗамер(СтрШаблон("%1 / %2",ТекД.ИмяНабора,Вариант.Свойства().Синоним),
				ЖурналКлиентСервер_Ei.ТипыОпераций().Конструктор, , , ИдЗапуска);
			Попытка
				//Подготавливаем
				//ПроверитьПоказателиВыполнения(ТД.ПоказателиВыполнения);
				//ОбщегоНазначенияКлиентСервер_Ei.ПроверитьПоказателиРезультата(ТД.ПоказателиРезультата); //добавил, без нее возникала ошибка в новой строке запроса если е пытаться сразу выполнить в динамическом списке
				//Выполняем
				ОбработчикРезультата 	= РезультатыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТекД);
				ДатаНачалаВыполнения 	= ТекущаяУниверсальнаяДатаВМиллисекундах();
				ОписаниеЗначения 		= Вариант.ВыполнитьВариант(Форма.УникальныйИдентификатор, ДопПараметры, ОбработчикРезультата, ДанныеКлиента);
				ВремяВыполнения			= ТекущаяУниверсальнаяДатаВМиллисекундах()-ДатаНачалаВыполнения;
				Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ОписаниеЗначения) Тогда
					КэшПользователяКлиентСервер_Ei.СохранитьОписаниеРезультата(ТекД,Форма.КэшПользователя,Вариант.Свойства().Имя,ОписаниеЗначения);
					ОбновитьВаринаты(Форма,НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма));
				КонецЕсли;	
				//ИзменитьПоказателиРезультата(ТД,ТД.ПоказателиРезультата.сооАдресовРезультатов);
				НастройкиПользователяКлиентСервер_Ei.СохранитьЗатраченноеВремя(ТекД,Форма.НастройкиПользователя,Вариант,ВремяВыполнения);
				Вариант.ПослеВыполнения(Форма,ДанныеКлиента);
			Исключение
				ИнфоОбОшибке = ИнформацияОбОшибке();
				ИсторияКлиент_Ei.ЗаполнитьМетрики(Запуск, Форма, ТекД, Вариант, ТекущаяУниверсальнаяДатаВМиллисекундах()-ДатаНачала, Ложь);
				ИсторияКлиент_Ei.ЗавершитьЗапуск(Запуск, Неопределено, ИнфоОбОшибке);
				ЗапросыMCPКлиент_Ei.ПослеЗапуска(ТекД, Запуск, Неопределено, ИнфоОбОшибке);
				ИсторияКлиент_Ei.ОписатьЗамерЗапуска(СобытиеОтладки, Запуск, ТекД);
				Вариант.ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке);
				Возврат;
			КонецПопытки;
		    ОбновитьДекорациюРезультатаВарианта(Форма,Вариант);
		    
		    РезультатыКлиент_Ei.ЗагрузитьРезультат(Форма,ТекД);
		    //запуск и замер завершаются после загрузки результата: в историю попадают те же метрики, что на закладках,
		    //а отображение результата в журнале оказывается внутри выполнения варианта
			ИсторияКлиент_Ei.ЗаполнитьМетрики(Запуск, Форма, ТекД, Вариант, ВремяВыполнения, Истина);
			ИсторияКлиент_Ei.ЗавершитьЗапуск(Запуск, ОписаниеЗначения);
			ЗапросыMCPКлиент_Ei.ПослеЗапуска(ТекД, Запуск, ОписаниеЗначения);
			ИсторияКлиент_Ei.ОписатьЗамерЗапуска(СобытиеОтладки, Запуск, ТекД);
		    ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
		    	
			Форма.ПодключитьОбработчикОжидания("ОбновитьЗаголовкиЗакладок",0.1,Истина);	
		    Если ТекущаяУниверсальнаяДатаВМиллисекундах()-ДатаНачала>15*1000 Тогда 
				Сигнал();
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	

// Показывает результат варианта строки в панели результатов так же, как после выполнения.
// Нужен для результатов из истории запусков, см. ИсторияКлиент_Ei
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  ТекД - ДанныеФормыЭлементДерева - текущая строка набора
//  Вариант - ОбщийМодуль - модуль варианта
//  ОписаниеЗначения - см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
Процедура ПоказатьОписаниеРезультата(Форма, ТекД, Вариант, ОписаниеЗначения) Экспорт
	КэшПользователяКлиентСервер_Ei.СохранитьОписаниеРезультата(ТекД,Форма.КэшПользователя,Вариант.Свойства().Имя,ОписаниеЗначения);
	ОбновитьВаринаты(Форма,НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма));
	ОбновитьДекорациюРезультатаВарианта(Форма,Вариант);
	РезультатыКлиент_Ei.ЗагрузитьРезультат(Форма,ТекД);
КонецПроцедуры

Процедура ОбновитьЗаголовки(Форма,ТД) Экспорт
	Для Каждого ЭлРезультата ИЗ ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
		Обработчик 	= ЭлРезультата.Значение;
		Имя 		= Обработчик.Свойства().Имя;	
		Страница 	= Форма.Элементы.Найти(Имя);
		Если Не Страница = Неопределено Тогда
			Время 				= НастройкиПользователяКлиентСервер_Ei.ПолучитьЗатраченноеВремя(ТД,Форма.Настройкипользователя,Обработчик);
			Размерность			= Обработчик.ПолучитьРазмерность(Форма,ТД);
			стрОкнчание 		= ?(Не ЗначениеЗаполнено(Размерность),"",СтрШаблон("(%1) ",Размерность)); 
			стрОкнчание 		= стрОкнчание + ?(Не ЗначениеЗаполнено(Время),"",""+ОбщегоНазначенияКлиент_Ei.ФорматироватьВремя(Время));  // 0 не выводим поскольку может использоваться динмичский список
			Заголовок 			= СокрЛП(Обработчик.Свойства().Синоним+" "+стрОкнчание);
			Страница.Заголовок 	= ?(ТД[Имя+"_Изм"],"*","")+Заголовок;
			ТД[Имя+"_Текст"] = Размерность;
			Если ЗначениеЗаполнено(Размерность) Тогда
				КартинкаПоля = ВариантыКлиентСерверПовтИсп_Ei.КартинкаСсылка(Имя);
				ТекстПоля	 = Размерность;	
			Иначе
				КартинкаПоля = "";
				ТекстПоля	 = "";		 		
			КонецЕсли;
			ТД[Имя+"_Текст"]		= ТекстПоля;
			ТД[Имя+"_Картинка"] 	= КартинкаПоля;		 		
		КонецЕсли;
	КонецЦикла;			
КонецПроцедуры

Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ТД 			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		Вариант = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
		Если Не Вариант = Неопределено Тогда
			Вариант.РасшифровкаОшибки(Форма,Элемент);
		КонецЕсли;
	КонецЕсли;		
Конецпроцедуры 	

// Получаем текст выполняемого запроса/выражения на встроенном языке
//
// Параметры:
//  Форма			- Форма- или неопределено
//  ТД			 	- ЭлементКоллекцииДереваФормы	 - Строка дерева значений 
//  сИмяЭлемента 	- Строка	 -  Имя элемента формы и реквизита коллекции (должны свлпадать)
// 
// Возвращаемое значение:
//   - Строка- Выджеленое значение или выражение
//
Функция ПолучитьТекстДляВыполнения(Форма,ТД,сИмяЭлемента,Проверять = Истина) Экспорт
	Результат = ТД[сИмяЭлемента];
	Если Не Форма = Неопределено Тогда
		ПолеВвода = Форма.Элементы.Найти(сИмяЭлемента);
		Если Не ПолеВвода = Неопределено Тогда
			ВыделенныйТекст = ПолеВвода.ВыделенныйТекст; 
			Если ЗначениеЗаполнено(ВыделенныйТекст) Тогда
				Результат = ВыделенныйТекст;		
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;		
	Возврат Результат;
КонецФункции

Асинх Функция УточнитьРежимВыполнения(Форма, ДопПараметры, Обработчик) Экспорт
	стрИнструкция =  "Инструкция";	
	Если Не ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,стрИнструкция) Тогда
		ЭлементИнструкции = Обработчик.ЭлементИнструкции(Форма);
		Если Не ЭлементИнструкции =  Неопределено Тогда
			ВыделенныйТекст = ТекстМодуляКлиент_Ei.ПолучитьВыделенныйТекст(ЭлементИнструкции);
			Если ЗначениеЗаполнено(ВыделенныйТекст) Тогда
				Фагмент = "Фрагмент";
				Кнопки = Новый СписокЗначений();
				Кнопки.Добавить(Фагмент,"Только фрагмент");
				Кнопки.Добавить("Весь","Всё содержимое");
				Кнопки.Добавить(КодВозвратаДиалога.Отмена,"Отмена");
				Ответ = Ждать ВопросАсинх("Выполнить только выделенный фрагмент?",Кнопки, 20, Фагмент,,Фагмент);
				Если Ответ = Фагмент Тогда 
					ДопПараметры = ?(ДопПараметры = Неопределено,Новый Структура,ДопПараметры);
					ДопПараметры.Вставить(стрИнструкция,ВыделенныйТекст);
					Возврат ДопПараметры;
				ИначеЕсли  Ответ = КодВозвратаДиалога.Отмена Тогда 
					ДопПараметры = ?(ДопПараметры = Неопределено,Новый Структура,ДопПараметры);
					ДопПараметры.Вставить(стрИнструкция,""); //обнулим текст инструкции, во всех обработчиках выполнения есть проверка на полноту будет равноценно отмене
					Возврат ДопПараметры;		
				КонецЕсли;			
			КонецЕсли;
		КонецЕсли;			
	КонецЕсли;
КонецФункции

Процедура ИзменитьВидимость(Форма) Экспорт
	Класс 	= ВариантыКлиентСервер_Ei;
	Кнопка 	= КонструкторКлиентСервер_Ei.ПолучитьКнопкуВидимости(Форма,Класс);
	Панель 	= Класс.Панель(Форма);
	КонструкторКлиент_Ei.ИзменитьВидимостьЭлемента(Форма,Кнопка.Имя,Панель.Имя);
КонецПроцедуры

// Функция - Получить структуру вариантов из дерева значений
//
// 
// Параметры:
//  Форма - Форма - см. ОбщаяФорма.Ei
// 
// Возвращаемое значение:
//  Структура из см. ВариантыКлиентСервер_Ei.ПолучитьВариант
//
Функция Получить(Форма) Экспорт
	Структура 	= Новый Структура;
	Коллекция	= НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма);
	ЗаполнитьСтруктуруВариантов(Форма,Структура,Коллекция,Ложь);
	Возврат Структура;
КонецФункции	

#Область ДоступныеПеременные

// Функция - Получает структуру доступных переменных
//
// Параметры:
//  Форма 	- Форма							- см. ОбщаяФорма.Ei
//  ТД	 	- ДанныеФормыЭлементДерева	 	- Текущие данные дерева вариантов
// 
// Возвращаемое значение:
//   Структура:
//   	*История 	- ОписаниеОповещения
//   	*Наборы		- ОписаниеОповещения
//
Функция ПолучитьСтруктуруДоступныхПеременных(Форма, ТД, ИспИсторию = Истина, ИспНаборы = Истина, ИспПараметры = Истина) Экспорт
	ДоступныеПеременные = Новый Структура;
	Если ИспПараметры Тогда
		ИмяНабора = НаборВариантовВызовСервера_Ei.ПолучитьТекущийНабор();
		НаборВариантовКлиент_Ei.ДополнитьДоступныеПеременные(ДоступныеПеременные,Форма,ИмяНабора);
	КонецЕсли;
	Если ИспНаборы Тогда
		ДоступныеПеременные.Вставить("Наборы",Новый ОписаниеОповещения("Наборы",НаборВариантовКлиент_Ei,Новый Структура("Форма,Аргументы",Форма,ВыборКлиент_Ei.ОкончаниеФункции())));
	КонецЕсли;	
	Если ИспИсторию Тогда
		//Сложности возникают с анализом истории если в истории находится данные из внешних источников, а мы к этим внешним истоника не подключены
		//ДоступныеПеременные.Вставить("История",Новый ОписаниеОповещения("ОО_История",ОбщегоНазначенияКлиент_Ei,Новый Структура("Аргументы",ВыборКлиент_Ei.ОкончаниеФункции())));
		ДоступныеПеременные.Вставить("Клиент",Новый ОписаниеОповещения("ОО_Клиент",ОбщегоНазначенияКлиент_Ei,Новый Структура("Аргументы","()")));
	КонецЕсли;	
	Возврат ДоступныеПеременные; 
КонецФункции

//Процедура вызывается обработчиком оповещения из ВыборКлиент_Ei.ПараметрыСтроки() 
//
Процедура Результат(Результат, ДопПараметры) Экспорт
	Результат = ВариантыКлиентСервер_Ei.ПолучитьИзНабора("Результаты",ДопПараметры.ИмяНабора,ДопПараметры.ИмяВарианта);
КонецПроцедуры

//Процедура вызывается обработчиком оповещения из ВыборКлиент_Ei.ПараметрыСтроки() 
//
Процедура Данные(Результат, ДопПараметры) Экспорт
	Результат = ВариантыКлиентСервер_Ei.Данные(ДопПараметры.ИмяНабора,ДопПараметры.ИмяВарианта);
КонецПроцедуры

// Вызывается обработчиком оповещения из
// См. ВыборКлиент_Ei.ПараметрыСтроки
// 
// Параметры:
//  Результат 		- Неопределено - Возвращаемый параметр
//  ДопПараметры 	- Структура - Задается в см. НаборВариантовКлиент_Ei.ДополнитьДоступныеПеременные:
//						*ИмяНабора 	- Строка
//						*Аргументы	- Строка 
Процедура Варианты(Результат, ДопПараметры) Экспорт
	Перем Набор;
	Результат 	= Новый Структура;
	Если НаборВариантовВызовСервера_Ei.Получить().Свойство(ДопПараметры.ИмяНабора,Набор) Тогда
		Если Набор.Свойство("Данные") Тогда
			//По сути преобразовываем фиксированную структуру в обычную
			Для Каждого ЭлФиксСтруктуры ИЗ Набор.Данные Цикл
				ИмяВарианта 		= ЭлФиксСтруктуры.Ключ;
				Вариант 			= ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(ИмяВарианта);
				ДоступныеПеременные = Новый Структура();
				ДополнитьДоступныеПеременные(ДоступныеПеременные,ДопПараметры.ИмяНабора,ИмяВарианта);
				ДоступныеПеременные.Вставить(ОбщегоНазначенияКлиент_Ei.ИмяКлючаКартинки(),ВариантыКлиентСерверПовтИсп_Ei.КартинкаСсылка(Вариант.Свойства().Имя));	
				Результат.Вставить(ИмяВарианта,ДоступныеПеременные);		
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Процедура ДополнитьДоступныеПеременные(ДоступныеПеременные,ИмяНабора,ИмяВарианта) 
	ДоступныеПеременные.Вставить("Результат",	Новый ОписаниеОповещения("Результат",	ВариантыКлиент_Ei, 	Новый Структура("ИмяНабора,ИмяВарианта,Аргументы",ИмяНабора,ИмяВарианта,"()")));
	ДоступныеПеременные.Вставить("Данные",		Новый ОписаниеОповещения("Данные",		ВариантыКлиент_Ei, 	Новый Структура("ИмяНабора,ИмяВарианта,Аргументы",ИмяНабора,ИмяВарианта,"()")));	
КонецПроцедуры
			
// Обновляет снимок наборов в параметрах сеанса.
//
// Параметры:
//  Форма - см. ОбщаяФорма.Ei
//  Коллекция - ДанныеФормыКоллекцияЭлементовДерева
//  ЗапускВарианта - Строка, Неопределено - идентификатор начинающегося запуска варианта, см. ИсторияКлиент_Ei
//
Процедура ОбновитьВаринаты(Форма,Коллекция,ЗапускВарианта = Неопределено) Экспорт
	Структура =  Новый Структура;
	ЗаполнитьСтруктуруВариантов(Форма,Структура,Коллекция);
	НаборВариантовВызовСервера_Ei.Обновить(Новый ФиксированнаяСтруктура(Структура), ЗапускВарианта);
КонецПроцедуры

Процедура ЗаполнитьСтруктуруВариантов(Форма,Структура,Коллекция,ИспРезультаты=Истина) Экспорт
	Для Каждого Строка ИЗ Коллекция Цикл
		Если ЗначениеЗаполнено(Строка.ИмяНабора) Тогда //м.б. пустое значение при добавлении новый строки в набор она в самам начале пустая #17
			Структура.Вставить(Строка.ИмяНабора,ВариантыКлиентСервер_Ei.ПолучитьВариант(Форма,Строка,ИспРезультаты));
			ЗаполнитьСтруктуруВариантов(Форма,Структура,Строка.ПолучитьЭлементы(),ИспРезультаты);
		КонецЕсли;	
	КонецЦикла;			
КонецПроцедуры

#КонецОбласти

//Вызывается только из события
//Логика при переключении варианта явно и при возврашении к варианту для определеннйос троки набора разная.
//Идентичное поведение нужно размешать в процедуре ПриОтображенииВарианта().
//
Процедура ПриСменеОбработчика(Форма,НовыйОбработчикИмя) Экспорт
	ПриОтображенииВарианта(Форма,НовыйОбработчикИмя);
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТекД = Неопределено Тогда
		//ОтладкаКлиент_Ei.ОбновитьДекорациюОшибки(Форма,ВариантыКлиентСервер_Ei,НовыйОбработчикИмя);
		СохранитьТекущийОбработчик(Форма,ТекД,НовыйОбработчикИмя);
		ОбновитьЗаголовки(Форма,ТекД);
		ОбработчикВарианта = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(НовыйОбработчикИмя);
		Если  Не ОбработчикВарианта = Неопределено Тогда
			Если ОбработчикВарианта.Свойства().Исполнение Тогда
				//Определим какой обработчик результата был последний для данного варианта и актуализируем ее
				ОбработчикРезультата = РезультатыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма, ТекД);
				Если Не ОбработчикРезультата = Неопределено Тогда
					РезультатыКлиент_Ei.АктуализироватьОбработчик(Форма,ОбработчикРезультата.Свойства().Имя);
					РезультатыКлиент_Ei.УстановитьВидимостьЛоготипа(Форма,ТекД,ОбработчикРезультата);	
				КонецЕсли;	
			КонецЕсли;			
		КонецЕсли;	 
	КонецЕсли;		
КонецПроцедуры 		

Процедура СохранитьТекущийОбработчик(Форма,ТД,Кандидат) Экспорт
	НастройкиПользователяКлиентСервер_Ei.СохранитьИмяТекущегоОбработчика(ТД,Форма.НастройкиПользователя,ВариантыКлиентСервер_Ei.Ключ(),Неопределено,Кандидат);
КонецПроцедуры

Процедура ВосстановитьНастройки(Форма,ТД) Экспорт
	Если Не ТД = Неопределено Тогда
		СохраненныйИлиВидимыйОбработчик 	= НастройкиПользователяКлиентСервер_Ei.ПолучитьИмяТекущегоОбработчика(ТД,Форма.НастройкиПользователя,ВариантыКлиентСервер_Ei.Ключ(),Неопределено);
		Если СохраненныйИлиВидимыйОбработчик =  Неопределено Тогда
			//сохраненного нет, возьмем текущие отображаемые на форме, они могли быть наследованны при изменении строки
			СохраненныйИлиВидимыйОбработчик = ВариантыКлиентСервер_Ei.Контейнер(Форма).ТекущаяСтраница.Имя;  	
		КонецЕсли;
		СохранитьТекущийОбработчик(Форма,ТД,СохраненныйИлиВидимыйОбработчик);
		АктуализироватьОбработчик(Форма,СохраненныйИлиВидимыйОбработчик);	
	КонецЕсли;	
КонецПроцедуры	

Процедура АктуализироватьОбработчик(Форма,ОбработчикИмя) Экспорт
	Контейнер 			= ВариантыКлиентСервер_Ei.Контейнер(Форма);
	ОбщегоНазначенияКлиент_Ei.АктуализироватьСтраницу(Контейнер,ОбработчикИмя);
	ПриОтображенииВарианта(Форма,ОбработчикИмя);	
КонецПроцедуры
	
#Область РезультатВарианта

Функция ПолучитьТекущееОписаниеЗначения(Форма,ОбработчикВарианта = Неопределено)
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		Если ОбработчикВарианта = Неопределено Тогда
			ОбработчикВарианта = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
		КонецЕсли;
		ОписаниеЗначения = КэшПользователяКлиентСервер_Ei.ПолучитьОписаниеРезультата(ТД,Форма.КэшПользователя,ОбработчикВарианта.Свойства().Имя);
		Возврат ОписаниеЗначения;
	КонецЕсли;		
КонецФункции	

Процедура ОбновитьДекорациюРезультатаВарианта(Форма,ОбработчикВарианта)
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		ОписаниеЗначения = ПолучитьТекущееОписаниеЗначения(Форма,ОбработчикВарианта);
		Декорация =  Форма.Элементы.Найти("РезультатВариантаНадпись");
		Если НЕ Декорация = Неопределено Тогда
			Если ОписаниеЗначения = Неопределено Тогда
				Декорация.Родитель.Видимость 	= Ложь;
			Иначе
				Декорация.Родитель.Видимость 	= Истина;
				Декорация.Заголовок 			= Лев("Результат: " + ОписаниеЗначения.ПредставлениеЗначения,50); 
			КонецЕсли;
		КонецЕсли;				
	КонецЕсли;		
КонецПроцедуры	

#Область ПросмотрСвойствРезульатат

Функция ВсплываемаяГруппа(Форма) Экспорт
	Возврат Форма.Элементы.Найти("ВсплываемыйРезультат");	
КонецФункции	

Процедура ОткрытьРезультатВарианта(Форма,Элемент) Экспорт
	ТД 			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		Вариант = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
		Если Не Вариант = Неопределено Тогда
			сПуть 				= "Варианты"+ВыборКлиент_Ei.ОкончаниеФункции()+"."+Вариант.Свойства().Имя+".Результат()"; //для позицинирования на текущей
			СтруктураПеременных = ОбщегоНазначенияКлиент_Ei.ПолучитьСтруктуруПеременных(Форма,Неопределено,сПуть,Ложь,Ложь);
			ВспГруппа 			= ВсплываемаяГруппа(Форма);		
			ФормаРодитель		= ВыборКлиент_Ei.НаследоватьВыбор(Форма,Форма.Элементы.Выбор,ВспГруппа);
			ОО_ПоказатьРезультат= Новый ОписаниеОповещения("ЗавершениеПоказаРезультата",ЭтотОбъект,Новый Структура("Форма",Форма));
			ВыборКлиент_Ei.НачалоВыбора(ОО_ПоказатьРезультат,ФормаРодитель.Выбор,Форма,Элемент,СтруктураПеременных,Ложь,Ложь);
			ВспГруппа.Видимость = Истина; //Скрывается обработкой ожидания, чтобы не мешала
			Форма.ПодключитьОбработчикОжидания("ПоказатьРезультатВарианта",0.1,Истина); // по другому не сработает
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Процедура ПоказатьРезультатВарианта(Форма) Экспорт
	ВспГруппа 		= ВсплываемаяГруппа(Форма);
	ВспГруппа.Показать();
	Форма.ПодключитьОбработчикОжидания("СкрытьВсплывающиеГруппы",1, Ложь);	//вызывает 	
КонецПроцедуры

Процедура ЗавершениеПоказаРезультата(ВыбранноеЗначение, ДопПараметры) Экспорт
	Форма 		= ДопПараметры.Форма;
	ВспГруппа 	= ВсплываемаяГруппа(Форма);	
	ВспГруппа.Видимость = Ложь;
Конецпроцедуры

#КонецОбласти
		

#КонецОбласти

Процедура УстановитьМодифицированность(Форма,ТД,Обработчик) Экспорт
	ИмяКолонкиИзм 		= Обработчик.Свойства().Имя+"_Изм";
	ТД[ИмяКолонкиИзм] 	= Обработчик.Модифицированность(Форма,ТД);
	ОбновитьЗаголовки(Форма,ТД);	
КонецПроцедуры	

#Область Сохранение_Чтение

// Сохранить в каталог исходников EDT параметр. 
// Либом как общий модуль если параметр является вычисляемым либо как макет если задано его значение
// Чтение  см. ЗаполнитьИзXDTO
// 
// Параметры:
//  ПутьИсходники 	- Строка - Путь к каталогу  исходников
//  Варианты 		- см. ВариантыКлиентСервер_Ei.ПолучитьВариант
//  ИмяНабора		- см. НаборВариантовКлиентСервер_Ei.ПолучитьИмяНабора
// 
// Возвращаемое значение:
//  Массив Из см. ФайлыКлиент_Ei.РезультатСохранения
//
Асинх Функция СохранитьВКаталог(ПутьИсходники, Варианты, ИмяНабора) Экспорт
	Результат = Новый Массив;
	Для Каждого СтрВаринат ИЗ Варианты.Данные Цикл
		Варинат = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(СтрВаринат.Ключ);
		СтрСохранения 	= Ждать Варинат.Сохранить(НастройкиСохранения(ПутьИсходники, Варианты,СтрВаринат, ИмяНабора));
		Если Не СтрСохранения = Неопределено Тогда
			Результат.Добавить(СтрСохранения);
			СтрСохранения.Вставить("Получение", СтрШаблон("Функция %1__%2() Экспорт%3%4%3КонецФункции",Варианты.Имя,СтрВаринат.Ключ,Символы.ПС,Символы.Таб+""));
			СтрСохранения.Вставить("Описание", 	""); 
		КонецЕсли;		
	КонецЦикла;
	Возврат Результат;		
КонецФункции


// Настройки сохранения.
// 
// Параметры:
//  ПутьИсходники 	- Строка - Путь исходники
//  Варианты 		- см. ВариантыКлиентСервер_Ei.ПолучитьВариант 
//  СтрВаринат 		- Произвольный, КлючИЗначение - Стр варинат:
//  ИмяНабора 		- см. НаборВариантовКлиентСервер_Ei.ПолучитьИмяНабора
// 
// Возвращаемое значение:
//  Структура - Настройки сохранения:
//  Путь 			- Строка 	- Путь к папаке src
//  ВариантыИмя 	- Строка    - Имя варианта набора
//  ВариантыКлюч 	- УникальныйИдентификатор - Ключ варината набора 
//  Данные			- Произвольный - Возвращается процедурой обработкичка см. ПодготовитьДанные
//  ИмяНабора		- см. НаборВариантовКлиентСервер_Ei.ПолучитьИмяНабора 
Функция НастройкиСохранения(ПутьИсходники,Варианты,СтрВаринат,ИмяНабора) Экспорт
	Результат = Новый Структура("Путь,ИмяНабора",ПутьИсходники,ИмяНабора);
	Результат.Вставить("ВариантыИмя",	Варианты.Имя);
	Результат.Вставить("ВариантыКлюч",	Варианты.КлючНастроек);
	Результат.Вставить("Данные",		СтрВаринат.Значение);
	Возврат Результат;	
КонецФункции

// Прочитать параметр. Добавление в данные всех данных вариантов (элементов структур аналогичных см. ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру )
// 	
// 
// Параметры:
//  Элемент 		- ОбъектXDTO - 
//  НаборВаринатов 	- Структура Из см. ВариантыКлиентСервер_Ei.ПолучитьВариант
//  Объект 			- ОбъектXDTO - 
//  сооКлючей 		- Соответствие из КлючИЗначение:
//		*Ключ 		- УникальныйИдентификатор -
//		*Значение 	- Строка
//	Тип				- Строка - Имя типа метаданных см.EDTКлиент_Ei.ТипыМетаданных 
Процедура ПрочитатьОбъект(Элемент, НаборВаринатов, Объект, СооКлючей, Тип) Экспорт
	Перем Вариант; 		
	ДанныеВарианта  =  Новый Структура;
	КлючНастроек = ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(Элемент.uuid,Объект.uuid);
	ИмяВарианта = сооКлючей.Получить(КлючНастроек);
	Если Не ИмяВарианта = Неопределено Тогда
		Для Каждого Вариант ИЗ ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
			Обработчик  = Вариант.Значение;
			СвойстваОб 	= Обработчик.Свойства();
			Если СвойстваОб.Код  = Прав(Элемент.uuid,12) Тогда
				Если НаборВаринатов.Свойство(ИмяВарианта,Вариант) Тогда 
					Вариант.Данные.Вставить(СвойстваОб.Имя,ДанныеВарианта);	
					ДанныеВарианта.Вставить("Путь", EDTКлиент_Ei.ПолучитьПуть(Тип, Элемент));  
					//	Данные 	= Ждать Варинат.Прочитать(Каталог, стрВариант.Имя, стрВариант.КлючНастроек);
				КонецЕсли;		
				Прервать;	
			КонецЕсли;
		КонецЦикла;	 
	КонецЕсли;
КонецПроцедуры

// Свойство пути указано, значит файл нужно считать
// Заменяет свойство Путь на ЗначениеПараметра
// по аналоги с см. ПараметрыКлиент_Ei.ПрочитатьЗначение
// 
// Параметры:
//  Структура  		- Структура - Формируется процедурой см. ПрочитатьОбъект
//  Элемент			- КлючИЗначение - Элемент структуры
//  Каталог  		- Строка - Путь к каталогу проекта - C:\Users\g.kudiakov\Documents\Ei_Настройка\New folder (2)  
//  ИмяПроекта  	- Строка - Например: Набор
//  Путь  			- Строка - относительный полный путь  - Templates\Набор_Параметр_Особенность\Template.txt
//  КлючНастроек 	- Строка - 55a4e36a-d2be-4a18-bbb0-c13c4a1ec5c5
//  
// Возвращаемое значение:
// 	см. ФайлыКлиент_Ei.РезультатСохранения 
Функция ПрочитатьЗначение(Структура, Элемент, Каталог, ИмяПроекта,Путь,КлючНастроек) Экспорт
	Перем Результат;
	Вариант 	= ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты().Получить(Элемент.Ключ);
	Если Не Вариант = Неопределено Тогда
		Ключ		= Строка(ВариантыКлиентСервер_Ei.ПолучитьИдентификатор(КлючНастроек,Вариант));
		ПолноеИмя 	= СтрШаблон("%1%6%5%6%2s%6%3%6%4",Каталог,EDTКлиент_Ei.ВнешОбработка(),ИмяПроекта,Путь,ФайлыКлиентСервер_Ei.КаталогИсходников(),ПолучитьРазделительПути());
		ТекстФайла 	= ФайлыКлиент_Ei.ПрочитатьТекст(ПолноеИмя);
		Структура.Вставить(Элемент.Ключ,Вариант.Прочитать(ПолноеИмя));
		//все сделали теперь подготовим ответ
		Файл				= Новый Файл(ПолноеИмя);
		ПутьККорневойПапаке = СтрШаблон("%1%5%4%5%2s%5%3",Каталог,EDTКлиент_Ei.ВнешОбработка(),ИмяПроекта,ФайлыКлиентСервер_Ei.КаталогИсходников(),ПолучитьРазделительПути());
		Результат 			= ФайлыКлиент_Ei.РезультатСохранения("", ПутьККорневойПапаке, ТекстФайла, Ключ, Файл); // возможно придется убрать / в конце Файл.Путь
	КонецЕсли;	 
	Возврат Результат;
КонецФункции
#КонецОбласти
#КонецОбласти	

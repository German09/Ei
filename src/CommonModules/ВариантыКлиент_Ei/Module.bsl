
Процедура ИнициализироватьВарианты(Форма,Варианты,КонтейнерВариантов) Экспорт
	Варианты = ВариантыВызовСервера_Ei.ПолучитьВарианты();
	Для Каждого Вариант ИЗ Варианты Цикл
		Контейнер = Форма.Элементы.Найти(Вариант.Свойства().Имя);
		Если Контейнер = Неопределено Тогда
			СледующийКонтейнер 	= Неопределено;
			Контейнер 			= Форма.Элементы.Вставить(Вариант.Свойства().Имя, Тип("ГруппаФормы"), КонтейнерВариантов, СледующийКонтейнер);
		    Контейнер.Вид 		= ВидГруппыФормы.Страница;
		КонецЕсли;
		Контейнер.Заголовок = Вариант.Свойства().Синоним;
		
		Вариант.Инициализировать(Форма,Контейнер);
	КонецЦикла;	
Конецпроцедуры

// Процедура - скрывает панели ошибок всех типов, используется при переключении между Вариантами
//
Процедура СкрытьПанелиОшибок(Форма,Варианты) Экспорт
	Форма.Элементы.ОшибкаЗапроса.Видимость 	= Ложь;	
	Форма.Элементы.ОшибкаВыражения.Видимость 	= Ложь;	
	//Элементы.ОшибкаПроцесса.Видимость 	= Ложь;
	Для Каждого Вариант ИЗ Варианты Цикл
		ЭлементФормы = Вариант.ПолучитьГруппуОтображенияОшибок(Форма);
		Если Не ЭлементФормы = Неопределено Тогда
			ЭлементФормы.Видимость = Ложь;			
		КонецЕсли;	
	КонецЦикла	
КонецПроцедуры
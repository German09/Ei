
Процедура Инициализировать(Форма) Экспорт
	Контейнер = ПолучитьКонтейнер(Форма);
	Для Каждого ЭлВарианта ИЗ ВариантыКлиентСерверПовторноеИспользование_Ei.ПолучитьВарианты() Цикл
		ОбщийМодульКлиент_Ei.Инициализировать(Форма, Контейнер, ЭлВарианта);
	КонецЦикла;	
Конецпроцедуры

Функция ПолучитьКонтейнер(Форма)
	Возврат Форма.Элементы.ПанельТекстаЗапроса;	
КонецФункции	

Процедура ПриИзмененииДанныхВариантов(Форма) Экспорт
	Для Каждого ЭлВарианта ИЗ ВариантыКлиентСерверПовторноеИспользование_Ei.ПолучитьВарианты() Цикл
		ЭлВарианта.Значение.ПриИзмененииДанных(Форма);
	КонецЦикла;	
КонецПроцедуры	

Процедура ПриОтображенииВарианта(Форма,СтрВариант)
	Вариант = ВариантыКлиентСерверПовторноеИспользование_Ei.ПолучитьВарианты().Получить(СтрВариант);
	Если Не Вариант = Неопределено Тогда
		Вариант.ПриОтображении(Форма);	
	КонецЕсли;	
КонецПроцедуры	

Процедура ВыполнитьВарианты(Форма,ДопПараметры = Неопределено) Экспорт
	Перем Параметры;
	ТД 			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		Вариант = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
		Если Не Вариант = Неопределено Тогда
			ДатаНачала 		= ТекущаяУниверсальнаяДатаВМиллисекундах();
			ДопПараметры 	= ?(ДопПараметры = Неопределено,Новый Структура,ДопПараметры);
			СобытиеОтладки 	= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Выполнние варианта """+Вариант.Свойства().Синоним+"""","Конструктор");
			Попытка
				//Подготавливаем
				ПроверитьПоказателиВыполнения(ТД.ПоказателиВыполнения);
				ОбщийМодульКлиентСервер_Ei.ПроверитьПоказателиРезультата(ТД.ПоказателиРезультата); //добавил, без нее возникала ошибка в новой строке запроса если е пытаться сразу выполнить в динамическом списке
				//Выполняем
				ОбработчикРезультата 	= РезультатыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма,ТД);
				ДатаНачалаВыполнения 	= ТекущаяУниверсальнаяДатаВМиллисекундах();
				ОписаниеЗначения 		= Вариант.ВыполнитьВариант(Форма, Форма.УникальныйИдентификатор, ТД, Параметры, ДопПараметры, ОбработчикРезультата);
				Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ОписаниеЗначения) Тогда
					РезультатыКлиентСервер_Ei.Поместить(ТД,Вариант.Свойства().Имя,ОписаниеЗначения);
				КонецЕсли;	
				ИзменитьПоказателиРезультата(ТД,ТД.ПоказателиРезультата.сооАдресовРезультатов);
				НастройкиПользователяКлиентСервер_Ei.СохранитьЗатраченноеВремя(ТД,Форма.НастройкиПользователя,Вариант,ТекущаяУниверсальнаяДатаВМиллисекундах()-ДатаНачалаВыполнения);
			Исключение
				Вариант.ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнформацияОбОшибке());
				Возврат;
			КонецПопытки;
		    ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
		    
		    РезультатыКлиент_Ei.ЗагрузитьРезультат(Форма,ТД);
		    	
			Форма.ПодключитьОбработчикОжидания("ОО_ОбновитьЗаголовкиЗакладок",0.1,Истина);	
		    Если ТекущаяУниверсальнаяДатаВМиллисекундах()-ДатаНачала>15*1000 Тогда 
				Сигнал();
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	

Процедура ОбновитьЗаголовки(Форма,ТД) Экспорт
	Для Каждого ЭлРезультата ИЗ ВариантыКлиентСерверПовторноеИспользование_Ei.ПолучитьВарианты() Цикл
		Обработчик 	= ЭлРезультата.Значение;	
		Страница 	= Форма.Элементы.Найти(ЭлРезультата.Ключ);
		Если Не Страница = Неопределено Тогда
			Время 				= НастройкиПользователяКлиентСервер_Ei.ПолучитьЗатраченноеВремя(ТД,Форма.Настройкипользователя,Обработчик);
			стрОкнчание 		= ?(Не ЗначениеЗаполнено(Время),"",""+ОбщийМодульЗакрытыйКлиент_Ei.вФорматироватьВремя(Время));  // 0 не выводим поскольку может использоваться динмичский список
			Страница.Заголовок 	= СокрЛП(Обработчик.Свойства().Синоним+" "+стрОкнчание);		
		КонецЕсли;
	КонецЦикла;			
КонецПроцедуры

Процедура ПроверитьПоказателиВыполнения(ПоказателиВыполнения) Экспорт
	Если Не ТипЗнч(ПоказателиВыполнения) = Тип("Структура")
		ИЛИ Не ПоказателиВыполнения.Свойство("ВидРезультата") Тогда
		ПоказателиВыполнения = Новый Структура("ВидРезультата,сооВремя",ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().Запрос,Новый Соответствие); //№№ убрал 0
	КонецЕсли;
Конецпроцедуры

Процедура ПриИзмененииДанных(Форма,СтрИмяЭлементаОшибки) Экспорт
	ЭлементФормы = Форма.Элементы.Найти(СтрИмяЭлементаОшибки);	
	Если Не ЭлементФормы = Неопределено Тогда
		ЭлементФормы.Видимость = Ложь;			
	КонецЕсли;
	ЭлементФормы = Форма.Элементы.Найти("ОтобразитьПоказателиПроцесса");
	Если Не ЭлементФормы = Неопределено Тогда
		ЭлементФормы.Пометка = Ложь;			
	КонецЕсли;	
Конецпроцедуры


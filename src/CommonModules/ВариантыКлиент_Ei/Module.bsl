
Процедура ИнициализироватьВарианты(Форма,КонтейнерВариантов) Экспорт
	Для Каждого ЭлВарианта ИЗ ВариантыКлиентПовторноеИспользование_Ei.ПолучитьВарианты() Цикл
		Вариант 	= ЭлВарианта.Значение;	
		Контейнер 	= Форма.Элементы.Найти(ЭлВарианта.Ключ);
		Если Контейнер = Неопределено Тогда
			СледующийКонтейнер 	= Неопределено;
			Контейнер 			= Форма.Элементы.Вставить(ЭлВарианта.Ключ, Тип("ГруппаФормы"), КонтейнерВариантов, СледующийКонтейнер);
		    Контейнер.Вид 		= ВидГруппыФормы.Страница;
		КонецЕсли;
		Контейнер.Заголовок = Вариант.Свойства().Синоним;
		Вариант.Инициализировать(Форма,Контейнер);
	КонецЦикла;	
Конецпроцедуры

Процедура ПриИзмененииДанныхВариантов(Форма) Экспорт
	Для Каждого ЭлВарианта ИЗ ВариантыКлиентПовторноеИспользование_Ei.ПолучитьВарианты() Цикл
		ЭлВарианта.Значение.ПриИзмененииДанных(Форма);
	КонецЦикла;	
КонецПроцедуры	

Процедура ПриОтображенииВарианта(Форма,СтрВариант) Экспорт
	Вариант = ВариантыКлиентПовторноеИспользование_Ei.ПолучитьВарианты().Получить(СтрВариант);
	Если Не Вариант = Неопределено Тогда
		Вариант.ПриОтображении(Форма);	
	КонецЕсли;	
КонецПроцедуры	

Функция ИмяЭлементаАлгоритма() Экспорт
	Возврат "ВстроенныйЯзык";	
КонецФункции

Процедура ВыполнитьВарианты(Форма,ТД,СтрВариант,ДопПараметры = Неопределено) Экспорт
	Перем Параметры;
	Вариант = ВариантыКлиентПовторноеИспользование_Ei.ПолучитьВарианты().Получить(СтрВариант);
	Если Не Вариант = Неопределено Тогда
		СобытиеОтладки 	= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Выполнние варианта """+Вариант.Свойства().Синоним+"""","Конструктор");
		Попытка
			//Подготавливаем
			ПроверитьПоказателиВыполнения(ТД.ПоказателиВыполнения);
			ОбщийМодульКлиентСервер_Ei.ПроверитьПоказателиРезультата(ТД.ПоказателиРезультата); //добавил, без нее возникала ошибка в новой строке запроса если е пытаться сразу выполнить в динамическом списке
			//Выполняем
			ДатаДо 					= ТекущаяУниверсальнаяДатаВМиллисекундах();
				Вариант.ВыполнитьВариант(Форма, ТД, Параметры, ДопПараметры);
			ИзменитьПоказателиРезультата(ТД,ТД.ПоказателиРезультата.сооАдресовРезультатов);
			ИзменитьВремяВыполнения(Форма,ТД,ТекущаяУниверсальнаяДатаВМиллисекундах()-ДатаДо);
			//Показываем результат
			ДатаДо_ 					= ТекущаяУниверсальнаяДатаВМиллисекундах();
				Вариант.ПоказатьРезультат(Форма, ТД, Параметры);
			ТД.ПоказателиРезультата.сооВремя.Вставить(ТД.ПоказателиВыполнения.ВидРезультата,ТекущаяУниверсальнаяДатаВМиллисекундах() - ДатаДо_);	
			//Завершаем
			Форма.ПодключитьОбработчикОжидания("ОО_ОбновитьЗаголовкиЗакладок",0.1,Истина);	
			Если ТекущаяУниверсальнаяДатаВМиллисекундах()-ДатаДо>15*1000 Тогда 
				Сигнал();
			КонецЕсли;
		Исключение
			Вариант.ОбработкаОшибокВыполнения(СобытиеОтладки,ИнформацияОбОшибке());
			Возврат;
		КонецПопытки;
	    ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);	
	КонецЕсли;
КонецПроцедуры	

Процедура ПроверитьПоказателиВыполнения(ПоказателиВыполнения) Экспорт
	Если Не ТипЗнч(ПоказателиВыполнения) = Тип("Структура")
		ИЛИ Не ПоказателиВыполнения.Свойство("ВидРезультата") Тогда
		ПоказателиВыполнения = Новый Структура("ВидРезультата,сооВремя",ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ДинамическийСписок,Новый Соответствие); //№№ убрал 0
	КонецЕсли;
Конецпроцедуры

#Область ПодписиКВкладкам

//Устанавливает показатели результата, адреса результата, кол-во отмеченный флажком строк
//
Процедура  ИзменитьПоказателиРезультата(ТД, сооАдресРезультата = Неопределено) Экспорт
	ОбщийМодульКлиентСервер_Ei.ПроверитьПоказателиРезультата(ТД.ПоказателиРезультата);
	Если Не сооАдресРезультата = Неопределено Тогда
		ТД.ПоказателиРезультата.сооАдресовРезультатов = сооАдресРезультата;
	КонецЕсли;	
		сПараметры = ОбщийМодульКлиент_Ei.ПолучитьСтруктуруДанных(ТД,"РезультатЗапроса,ПоказателиРезультата,ПоказателиВыполнения");
	стрПометок = Новый Структура;	
	стрПометок.Вставить("Ложь",		ОбщийМодульВызовСервера_Ei.ПолучитьКолВоСтрокРезультата(сПараметры,Ложь));
	стрПометок.Вставить("Истина",	ОбщийМодульВызовСервера_Ei.ПолучитьКолВоСтрокРезультата(сПараметры,Истина));
	стрПометок.Вставить("Ложь", 	стрПометок.Ложь + стрПометок.Истина);
	ТД.ПоказателиРезультата.сооПометок.Вставить(ТД.ПоказателиВыполнения.ВидРезультата,стрПометок);
КонецПроцедуры

//Устанавливает время в заголовки сстраницы для которой выполнялось действие
//Параметры:
//	ДеревоЗапросовТД	- Текущая строка дерева
//	Значение			- <Число>. Число секунд затраченного времени
Процедура ИзменитьВремяВыполнения(Форма,ТД,Значение) Экспорт 
    ПроверитьПоказателиВыполнения(ТД.ПоказателиВыполнения);
	ТД.ПоказателиВыполнения.сооВремя.Вставить(Форма.Элементы.ПанельТекстаЗапроса.ТекущаяСтраница.Имя,Значение);
КонецПроцедуры 

#КонецОбласти

// Получаем текст выполняемого запроса/выражения на встроенном языке
//
// Параметры:
//  ТД			 - ЭлементКоллекциДереваФомы	 - Строка дерева значений 
//  сИмяЭлемента - Строка	 -  Имя элемента формы и реквизита коллекции (должны свлпадать)
// 
// Возвращаемое значение:
//   - Строка. Выджеленое значение или выражение
//
Функция ПолучитьТекстДляВыполнения(Форма,ТД,сИмяЭлемента,Проверять = Истина) Экспорт
	Результат = ТД[сИмяЭлемента];
	ПолеВвода = Форма.Элементы.Найти(сИмяЭлемента);
	Если Не ПолеВвода = Неопределено Тогда
		ВыделенныйТекст = ПолеВвода.ВыделенныйТекст; 
		Если ЗначениеЗаполнено(ВыделенныйТекст) Тогда
			Результат = ВыделенныйТекст;		
		КонецЕсли;
	КонецЕсли;	
	Возврат Результат;
КонецФункции

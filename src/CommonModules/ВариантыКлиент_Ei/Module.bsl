Функция ПолучитьСтруктуруДоступныхПеременных(Форма, ТДЗапросов, ИспИсторию = Истина, ИспВаринаты = Истина) Экспорт
	ДоступныеПеременные = Новый Структура;
	//СтруктураПараметров = ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСтруктуруПараметров(Элементы.ДеревоЗапросов.ТекущиеДанные.ПараметрыЗапроса,УникальныйИдентификатор);
	//СтруктураДопПараметров.ДоступныеПеременные.Вставить("Параметры",СтруктураПараметров);
		СтруктураЭтаФорма = Новый Структура("РезультатВыполнения", Неопределено);//РезультатыКлиент_Ei.ПолучитьОписаниеЗначенияСохраненногоРезультата(ТДЗапросов)); 
		стрЗапросов =  Новый Структура;
		СформироватьСтруктуруЗапросов(Форма,стрЗапросов,Форма.ДеревоЗапросов.ПолучитьЭлементы());
	СтруктураЭтаФорма.Вставить("Варианты",стрЗапросов);
	//Если Не ТДЗапросов = Неопределено И стрЗапросов.Свойство(ТДЗапросов.Запрос) Тогда
		//ДоступныеПеременные.Вставить("Параметры",стрЗапросов[ТДЗапросов.Запрос].Параметры);			
	//КонецЕсли;	
	ДоступныеПеременные.Вставить("ЭтаФорма",СтруктураЭтаФорма);
	
	НаборВариантовКлиент_Ei.ДополнитьДоступныеПеременные(ДоступныеПеременные,Форма,ТДЗапросов.Запрос);
	

#Область ИнтерфейсВариантов

Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",		ВариантыКлиентСерверПовторноеИспользование_Ei.ИмяЭлементаЗапроса());
	Результат.Вставить("Синоним",	"Запрос");
	Результат.Вставить("Картинка",	Новый Картинка);
	Возврат Результат;
КонецФункции

Функция ВыполнитьВариант(Форма,УникальныйИдентификатор,ТД,Параметры,ДопПараметры,ОбработчикРезультата = Неопределено) Экспорт
	Перем ОписаниеЗначения;
	ТекстЗапроса = ПолучитьТекстЗапроса(Форма, ТД, ДопПараметры);	
	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
		ПараметрыКлиентСервер_Ei.УточнитьПараметры(ТД, УникальныйИдентификатор, Параметры);
		Если ОбработчикРезультата =  Неопределено ИЛИ  
			 ОбработчикРезультата.ПереопределитьВыполнение(Форма,УникальныйИдентификатор,ТД,Параметры,ДопПараметры,ВариантКлиентСервер_Запрос_Ei,ОписаниеЗначения) Тогда	
			ОписаниеЗначения = ОбщийМодульКлиентСервер_Ei.__ВыполнитьЗапрос(ТекстЗапроса,Параметры,УникальныйИдентификатор); 
		КонецЕсли;
	КонецЕсли;	
	Возврат ОписаниеЗначения;	
КонецФункции	

#Если Клиент Тогда


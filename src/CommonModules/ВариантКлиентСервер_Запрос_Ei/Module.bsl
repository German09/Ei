Функция ПолучитьТекстЗапроса(Форма, ТД, ДопПараметры) Экспорт
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ТД,"Инструкции") Тогда
		//такая структура данных специфична для выхова из обработки выполнения
		Возврат ТД.Инструкции.Запрос;	
	Иначе
		#Если Клиент Тогда
			//получим текст запроса это при интерактивном выполненнии
			Возврат ВариантКлиент_Запрос_Ei.ПолучитьАктуальныйТекстЗапроса(Форма, ТД, ДопПараметры);
		#КонецЕсли	
	КонецЕсли;
КонецФункции

Процедура УточнитьПараметрыЗапроса(УникальныйИдентификатор, ТД, Параметры) Экспорт
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ТД,"Параметры") Тогда
		// это вызов из обработки выполнений и параметры в данном случае уже заполнены
	Иначе
		#Если Клиент Тогда
			Параметры	= ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСтруктуруПараметров(ТД.ПараметрыЗапроса,УникальныйИдентификатор);
		#КонецЕсли	
	КонецЕсли;
КонецПроцедуры
Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",		ВариантыКлиентСерверПовторноеИспользование_Ei.ИмяЭлементаЗапроса());
	Результат.Вставить("Синоним",	"Запрос");
	Результат.Вставить("Картинка",	Новый Картинка);
	Возврат Результат;
КонецФункции

Функция ВыполнитьВариант(Форма,УникальныйИдентификатор,ТД,Параметры,ДопПараметры) Экспорт
	Перем ТекстЗапроса;
	Перем ОбработчикРезультата;
	Перем ОписаниеЗначения;
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ТД,"Инструкции") Тогда
		//такая структура данных специфична для выхова из обработки выполнения
		ТекстЗапроса = ТД.Инструкции.Запрос;	
	Иначе
		#Если Клиент Тогда
			//получим текст запроса это при интерактивном выполненнии
			ТекстЗапроса = ВариантКлиент_Запрос_Ei.ПолучитьАктуальныйТекстЗапроса(Форма, ТД, ДопПараметры);
		#КонецЕсли	
	КонецЕсли;	
	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
		Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ТД,"Параметры") Тогда
			// это вызов из обработки выполнений и параметры в данном случае уже заполнены
		Иначе
			#Если Клиент Тогда
				Параметры	= ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСтруктуруПараметров(ТД.ПараметрыЗапроса,УникальныйИдентификатор);
			#КонецЕсли	
		КонецЕсли;
		
//		Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,"ПоказателиРезультата") Тогда
//			сооАдресРезультата 		= ДопПараметры.ПоказателиРезультата.сооАдресовРезультатов;
//		Иначе
//			сооАдресРезультата 		= ТД.ПоказателиРезультата.сооАдресовРезультатов;			//Новый Соответствие; если поставить новый то после выполнения ДС все отальные результаты в строке обнулялись
//		КонецЕсли;
		#Если Клиент Тогда
			//выполняем интерактивно, поэтому знаем в какой типа результата собираемся это показать
			ОбработчикРезультата = РезультатыКлиентСерверПовторноеИспользование_Ei.ПолучитьРезультаты().Получить(ТД.ПоказателиВыполнения.ВидРезультата);	
			//ИмяОсновногоРеквизита 	= РезультатыКлиент_Ei.ПолучитьИмяОсновногоРеквизита(ТД);
		#КонецЕсли	
		Если ОбработчикРезультата =  Неопределено ИЛИ  
			 ОбработчикРезультата.ВыполнятьВариант(ЭтотОбъект) Тогда	
			ОписаниеЗначения = ОбщийМодульКлиентСервер_Ei.__ВыполнитьЗапрос(ТекстЗапроса,Параметры,УникальныйИдентификатор); 
			//сооАдресРезультата.Вставить(ОписаниеЗначения.ОписаниеТипов, ОписаниеЗначения);
			Если ТипЗнч(ТД) = Тип("ДанныеФормыЭлементДерева") Тогда
				//сооАдресРезультата.Удалить(ТД.ПоказателиВыполнения.ВидРезультата); //чтобы результат обновился если он был ранее сохранен непосредственно
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
	Возврат ОписаниеЗначения;	
КонецФункции	

#Если Клиент Тогда


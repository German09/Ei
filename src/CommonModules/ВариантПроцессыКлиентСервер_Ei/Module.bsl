// Вариант «Процессы»: процесс по графической схеме из обработок, см. ПроцессыКлиентСервер_Ei
// Выполняется и в фоне: тогда клиент видит ход процесса на схеме, см. ПроцессыКлиент_Ei.ПоказатьХод

#Область ПрограммныйИнтерфейс

// Свойства варианта.
//
// Возвращаемое значение:
//  Структура:
//   * Код - Строка - 12-символьный идентификатор для сохранения настроек в формате EDT
//   * Имя - Строка
//   * Синоним - Строка
//   * Картинка - Картинка
//   * Символ - Строка - значок варианта в строке дерева наборов, см. ВариантыКлиент_Ei.СимволыВариантов
//   * Класс - ОбщийМодуль
//   * Исполнение - Булево - вариант выполняется и выводит результат
//   * ФоновоеВыполнение - Булево - вариант выполняется в фоне, см. ФоновоеВыполнениеКлиентСервер_Ei.ВариантВыполняетсяВФоне
//
Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Код",				"a23e7824dc63");
	Результат.Вставить("Имя",				Ключ());
	Результат.Вставить("Синоним",			Ключ());
	Результат.Вставить("Картинка",			БиблиотекаКартинок.Процессы_Ei);
	Результат.Вставить("Символ",			"⚙");
	Результат.Вставить("Класс",				ВариантыКлиентСервер_Ei);
	Результат.Вставить("Исполнение",		Истина);
	Результат.Вставить("ФоновоеВыполнение",	Истина);
	Возврат Результат;
КонецФункции

// Выполняет процесс строки набора. В фоне процесс сообщает клиенту о ходе выполнения, см. ПроцессыКлиентСервер_Ei.НовыйХод
//
// Параметры:
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор для временного хранилища результата
//  ДопПараметры - Структура - дополнительные параметры выполнения
//  ОбработчикРезультата - ОбщийМодуль, Неопределено - обработчик результата, который может переопределить выполнение
//  ДанныеКлиента - Соответствие из КлючИЗначение - возвращаемый параметр: время, ошибки и контекст обработок,
//    см. ПроцессыКлиентСервер_Ei.ВыполнитьПроцесс
//
// Возвращаемое значение:
//  Произвольный - результат последней обработки процесса, см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
Функция ВыполнитьВариант(УникальныйИдентификатор, ДопПараметры, ОбработчикРезультата = Неопределено, ДанныеКлиента = Неопределено) Экспорт
	ОписаниеЗначения = Неопределено;
	Если ОбработчикРезультата = Неопределено
		Или ОбработчикРезультата.ПереопределитьВыполнение(УникальныйИдентификатор, ДопПараметры, ВариантПроцессыКлиентСервер_Ei, ОписаниеЗначения) Тогда
		ГрафСхемаXDTO 		= ВариантыКлиентСервер_Ei.ПолучитьИнструкцию(Неопределено, Ключ());
		НастройкиОбработок 	= ВариантыКлиентСервер_Ei.ПолучитьСвойство(Неопределено, Ключ(), "Обработки");
		ИзначальныйОбъект	= ВариантыКлиентСервер_Ei.ПолучитьСвойство(Неопределено, Ключ(), "ИзначальныйОбъект");
		ДанныеКлиента 		= Новый Соответствие;
		ОписаниеЗначения	= ПроцессыКлиентСервер_Ei.ВыполнитьПроцесс(УникальныйИдентификатор, ГрафСхемаXDTO, НастройкиОбработок,
			ДанныеКлиента, Новый Массив, ИзначальныйОбъект, ПроцессыКлиентСервер_Ei.НовыйХод());
	КонецЕсли;
	Возврат ОписаниеЗначения;
КонецФункции

// Данные строки набора для параметра сеанса НаборВариантов_Ei.
//
// Параметры:
//  Объект - ДанныеФормыЭлементДерева, ФормаКлиентскогоПриложения - строка набора или форма с процессом
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура:
//   * Инструкция - Строка - сериализованная графическая схема
//   * Обработки - ФиксированноеСоответствие из КлючИЗначение - настройки обработок, см. ОбработкиКлиентСервер_Ei.ПолучитьДанныеОбработок
//   * ИзначальныйОбъект - Строка - выражение объекта процесса
//
Функция ПодготовитьДанные(Объект) Экспорт
	Возврат Новый ФиксированнаяСтруктура("Инструкция, Обработки, ИзначальныйОбъект", Строка(Объект.ГрафСхемаXDTO),
		ОбработкиКлиентСервер_Ei.ПолучитьДанныеОбработок(Объект.ДоступныеОбработки), Строка(Объект.Процессы_Объект));
КонецФункции

// Представление исходных данных варианта во встроенном языке.
//
// Параметры:
//  ИсходныеДанные - см. ПодготовитьДанные
//
// Возвращаемое значение:
//  см. ПодготовитьДанные
//
Функция Данные(ИсходныеДанные) Экспорт
	Возврат ИсходныеДанные;
КонецФункции

// Загружает в строку набора или форму сохраненные данные варианта: прежние обработки заменяются.
//
// Параметры:
//  Объект - ДанныеФормыЭлементДерева, ФормаКлиентскогоПриложения - строка набора или форма с процессом
//  Настройка - Структура, ФиксированнаяСтруктура - сохраненные данные, см. ПодготовитьДанные
//
Процедура ЗагрузитьДанные(Объект, Настройка) Экспорт
	Если ТипЗнч(Настройка) = Тип("ФиксированнаяСтруктура") Или ТипЗнч(Настройка) = Тип("Структура") Тогда
		Объект.ГрафСхемаXDTO	= Настройка.Инструкция;
		Объект.Процессы_Объект 	= Настройка.ИзначальныйОбъект;
		Объект.ДоступныеОбработки.ПолучитьЭлементы().Очистить();
		ОбработкиКлиентСервер_Ei.ДобавитьОбработкиВКоллекцию(Объект.ДоступныеОбработки.ПолучитьЭлементы(), Настройка.Обработки);
	КонецЕсли;
КонецПроцедуры

#Если Клиент Или ТолстыйКлиентУправляемоеПриложение Тогда

// Перед выполнением варианта.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  ДопПараметры - Структура - дополнительные параметры выполнения
//
// Возвращаемое значение:
//  Структура - дополнительные параметры выполнения
//
Функция ПередВыполнением(Форма, ДопПараметры) Экспорт
	#Если Клиент Тогда
		КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
	#КонецЕсли
	Возврат ДопПараметры;
КонецФункции

// После выполнения варианта: показатели обработок на схеме.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  ДанныеКлиента - Соответствие из КлючИЗначение - данные обработок, см. ВыполнитьВариант
//
Процедура ПослеВыполнения(Форма, ДанныеКлиента) Экспорт
	ВариантПроцессыКлиент_Ei.ПослеВыполнения(Форма, ДанныеКлиента);
КонецПроцедуры

// При изменении данных строки набора.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//
Процедура ПриИзмененииДанных(Форма) Экспорт
	ВариантПроцессыКлиент_Ei.ПриИзмененииДанных(Форма);
КонецПроцедуры

// При переходе на закладку варианта.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//
Процедура ПриОтображении(Форма) Экспорт
	ВариантПроцессыКлиент_Ei.ПриОтображении(Форма);
КонецПроцедуры

// Показывает ошибку выполнения варианта.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  СобытиеОтладки - Структура, Неопределено - событие отладки
//  ИнфоОбОшибке - ИнформацияОбОшибке, Строка - ошибка
//
Процедура ОбработкаОшибокВыполнения(Форма, СобытиеОтладки, ИнфоОбОшибке) Экспорт
	ВариантПроцессыКлиент_Ei.ОбработкаОшибокВыполнения(Форма, СобытиеОтладки, ИнфоОбОшибке);
КонецПроцедуры

// Устанавливает параметры варианта: у процесса параметров нет.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//
Процедура УстановитьПараметры(Форма) Экспорт
	Возврат;
КонецПроцедуры

// Показывает место ошибки: обработку с ошибкой на схеме.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  Элемент - ДекорацияФормы - декорация ошибки
//
Процедура РасшифровкаОшибки(Форма, Элемент) Экспорт
	ВариантПроцессыКлиент_Ei.РасшифровкаОшибки(Форма, Элемент);
КонецПроцедуры

// Размерность варианта: сколько обработок на схеме.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  ТекД - ДанныеФормыЭлементДерева - строка набора
//
// Возвращаемое значение:
//  Число
//
Функция ПолучитьРазмерность(Форма, ТекД) Экспорт
	Возврат ВариантПроцессыКлиент_Ei.ПолучитьРазмерность(Форма, ТекД);
КонецФункции

// Элемент с текстом варианта: у процесса текста нет, выделенный фрагмент выполнить нельзя.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//
// Возвращаемое значение:
//  Неопределено
//
Функция ЭлементИнструкции(Форма) Экспорт
	Возврат Неопределено;
КонецФункции

// Сохраняет данные варианта на диск в формате EDT.
//
// Параметры:
//  Настройки - см. ВариантыКлиент_Ei.НастройкиСохранения
//
// Возвращаемое значение:
//  Обещание - см. ВариантПроцессыКлиент_Ei.Сохранить
//
Асинх Функция Сохранить(Настройки) Экспорт
	Результат = Ждать ВариантПроцессыКлиент_Ei.Сохранить(Настройки);
	Возврат Результат;
КонецФункции


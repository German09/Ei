#Область ИнтерфейсВариантов

Процедура Инициализировать(Форма, Контейнер) Экспорт
	ФормаРодитель 	= ПолучитьФорму("ОбщаяФорма.СКД_Ei");
		ПереопредПутиРеквизитов  = Новый Соответствие;
		ПереопредПутиРеквизитов.Вставить("ТекстСКД",КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента());
	НаследованиеФормКлиент_Ei.Дополнить(ФормаРодитель,Форма,Контейнер,ПереопредПутиРеквизитов);
КонецПроцедуры

Процедура ПриИзмененииДанных(Форма) Экспорт
	//ВариантыКлиент_Ei.ПриИзмененииДанных(Форма,"ОшибкаВыражения");	
Конецпроцедуры

Процедура ПриОтображении(Форма) Экспорт
	ПараметрыКлиент_Ei.ИзменитьВидимость(Форма,Истина);	
Конецпроцедуры

Процедура ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
	ОтладкаКлиент_Ei.ПоказатьИсключение(Форма,ИнфоОбОшибке,ВариантыКлиентСервер_Ei,ВариантКлиентСервер_СКД_Ei);
КонецПроцедуры

Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ТекстМодуляКлиент_Ei.ВыделитьОшибкуВТексте(Форма,Элемент,Форма.Элементы.ТекстСКД);			
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеПроцедуры

Процедура ОткрытьКонструкторНачало(Форма,ФормаОбработкиВыбора) Экспорт 
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
			Конструктор = Новый КонструкторСхемыКомпоновкиДанных(ОбщийМодульКлиентСервер_Ei.Структурировать(ТД.ТекстСКД,Новый СхемаКомпоновкиДанных));
			Конструктор.Редактировать(ФормаОбработкиВыбора);
		#Иначе
			ПоказатьПредупреждение(, НСтр("ru='Конструктор СКД можно открыть только в толстом клиенте. В тонком клиенте и веб клиенте редактирование СКД возможно только в тексте.'"));
		#КонецЕсли
	КонецЕсли;	
КонецПроцедуры

Процедура УстановитьСхему(Форма,Схема) Экспорт
	ТД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		ТД.ТекстСКД = ОбщийМодульКлиентСервер_Ei.Сериализовать(Схема);
		ВариантыКлиент_Ei.ТекстПриИзменении(Форма,Форма.Элементы.ТекстСКД);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

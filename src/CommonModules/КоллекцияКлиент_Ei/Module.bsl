#Область ПрограммныйИнтерфейс

// Получить размерность коллекции.
// Есть похожая функция см. РезультатТаблицаВызовСервера_Ei.ОпределитьРазмерность
// 
// Параметры:
//  Коллекция 		- Неопределено - Коллекция
//  ТаблицаФормы 	- ТаблицаФормы - Эл формы
// 
// Возвращаемое значение:
//  Неопределено,Строка
Функция ПолучитьРазмерностьКоллекции(Коллекция,ТаблицаФормы) Экспорт
	ЧислоСтрок = Коллекция.Количество();
	Если ЧислоСтрок Тогда
		Возврат СтрШаблон("%1/%2",ЧислоСтрок,ТаблицаФормы.ПодчиненныеЭлементы.Количество());
	КонецЕсли;	 	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура Выбор(Форма,Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) Экспорт
	СтандартнаяОбработка 	= Ложь;
	ВыделенныеСтроки		= Новый Массив; //сформируем массив выделенных туда передаим только одну выбранную, конструкция еще используется в перетаскивании
	ВыделенныеСтроки.Добавить(ВыбраннаяСтрока);
	Для Каждого ЗначениеЯчеек ИЗ  ПолучитьВыделенныеЯчейки(Форма, Элемент, ВыделенныеСтроки, Поле) Цикл 	
		ОбщегоНазначенияКлиент_Ei.ПоказатьЗначениеРасш(Форма,ЗначениеЯчеек.Значение); //пока зываем всегда первое, список нет смысла показывать, поскольку из него всеравно ничего не выбрать
 	КонецЦикла;
КонецПроцедуры

// Устанавливаем заголовок и активируем страницу по индексу
// 
// Параметры:
//  Форма 	- см. ОбщаяФорма.Ei
//  Элемент - ТаблицаФормы
Процедура ПриАктивизацииСтроки(Форма,Элемент) Экспорт
	Страницы = ПолучитьСтраницыВложенныхТаблиц(Элемент);
	Если Не Страницы = Неопределено Тогда
		ДанныеСтроки 	= Элемент.ДанныеСтроки(Элемент.ТекущаяСтрока);
		Если Не ДанныеСтроки = Неопределено Тогда		
			Для Каждого Страница ИЗ Страницы Цикл
				ИмяДанных		= ОбщегоНазначенияКлиентСервер_Ei.СтрНачалоДо(Страница.Заголовок);
				Коллекция		= Неопределено;
				Если Не ИмяДанных = Неопределено Тогда
					Если ДанныеСтроки.Свойство(ИмяДанных,Коллекция) Тогда
						Для Каждого ЭлФормы ИЗ Страница.ПодчиненныеЭлементы Цикл
							Если ТипЗнч(ЭлФормы) = Тип("ТаблицаФормы") Тогда
								УстановитьЗаголовокСтраницы(Страница, ЭлФормы, Коллекция, ИмяДанных);
							ИначеЕсли ТипЗнч(ЭлФормы) = Тип("ГруппаФормы") 
										И ЭлФормы.Вид = ВидГруппыФормы.Страницы
										И ЭлФормы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет Тогда //важно не перепутать с вложенной группой отличе по способу отображения страниц
															
								Индекс = ПолучитьИндекс(Форма, Элемент);	
								СтарницаИндексаСтрок = ЭлФормы.ПодчиненныеЭлементы.Найти(СтрШаблон("%1_%2_%3",Страница.Имя,КоллекцияСтруктураКлиентСервер_Ei.ПризнакИндексаСтрок(),Формат(Индекс,"ЧН=0; ЧГ=")));
								Страница.Видимость = (Не СтарницаИндексаСтрок = Неопределено);	
								Если Страница.Видимость Тогда
									ЭлФормы.ТекущаяСтраница = СтарницаИндексаСтрок;
									Для Каждого ЭлФормы ИЗ СтарницаИндексаСтрок.ПодчиненныеЭлементы Цикл
										УстановитьЗаголовокСтраницы(Страница, ЭлФормы, Коллекция, ИмяДанных);
										Прервать; //Ожидаем всего 1 элемент - таблицу формы
									КонецЦикла;	 
								Иначе
									//тут пустое значение,будет скрыта сама страница			
								КонецЕсли;				
							КонецЕсли;	
						КонецЦикла;	 
					КонецЕсли;
				КонецЕсли;	 
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;					
КонецПроцедуры	




Процедура ПриАктивизацииЯчейки(Форма,Элемент) Экспорт
	ВывестиИтогиВПодвале(Форма, Элемент);			
КонецПроцедуры

Функция ПолучитьВыделенныеЯчейки(Форма, Элемент, ВыделенныеСтроки, Поле) Экспорт
	ВыделенноеСодержимое =  Новый СписокЗначений;
	Если ЗначениеЗаполнено(Поле.Заголовок) Тогда
		Для Каждого ИдСтроки ИЗ ВыделенныеСтроки Цикл
			ДанныеСтроки = Элемент.ДанныеСтроки(ИдСтроки);
			Если Не ДанныеСтроки = Неопределено Тогда
			    ВыделенноеСодержимое.Добавить(ДанныеСтроки[Поле.Заголовок]);		
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	Возврат ВыделенноеСодержимое; 
КонецФункции
#КонецОбласти


#Область СлужебныеПроцедурыИФункции

//У текущей стороки получается другой индекс после перезаполнения, это приводит к тому 
//что повтороное выполнение одного и того же запроса не находит нужную страницу 
//если первая колонка из 3 при первом выполнии будет иметь индекс 0 то при втором выполнении индекс будет 4
//см. КоллекцияВызовСервера_Ei.ПолучитьСтраницуИндексаСтрок
//нужно опредлить относительный индекс, знать минимальный индекс в наборе всех строк
Функция ПолучитьИндекс(Знач Форма, Элемент)
	Перем Индекс;
	//тут для каждой строки свои колокнки 
	//создавали через см. КоллекцияВызовСервера_Ei.ПолучитьСтраницуИндексаСтрок
	//в берется порядковый номер см. КоллекцияВызовСервера_Ei.ЗаполнитьВложенные
	Строка = Форма[Элемент.Имя].НайтиПоИдентификатору(Элемент.ТекущаяСтрока);
	Если Не Строка = Неопределено Тогда
		Если Строка.Свойство("Индекс",Индекс) Тогда
			//это простой случай в виде массива в исходной таблице
			//возможно его бужет достаточно для индекса строк
		Иначе
								
		КонецЕсли;						
	КонецЕсли;	
	Если Индекс = Неопределено Тогда
		Индекс = Элемент.ТекущаяСтрока;
	КонецЕсли;	
	Возврат Индекс
КонецФункции

Процедура УстановитьЗаголовокСтраницы(Страница, ТаблицаФормы, Коллекция, ИмяДанных)
	Размерность = ПолучитьРазмерностьКоллекции(Коллекция,ТаблицаФормы);
	Если ЗначениеЗаполнено(Размерность) Тогда  
		Страница.Заголовок  = СтрШаблон("%1 (%2)",ИмяДанных,Размерность);
	Иначе
		Страница.Заголовок  = ИмяДанных;
	КонецЕсли;
КонецПроцедуры

Процедура ВывестиИтогиВПодвале(Форма, Элемент)
	ОчиститьПодвал(Элемент);
	Элемент.Подвал = Ложь;
	ЗначенияЯчеек = ПолучитьВыделенныеЯчейки(Форма, Элемент, Элемент.ВыделенныеСтроки, Элемент.ТекущийЭлемент);	
	Если ЗначенияЯчеек.Количество()>1 Тогда
		Сумма = 0;
		Для Каждого ЭлементСЗ ИЗ ЗначенияЯчеек Цикл
			Попытка
				Сумма = Сумма + Число(ЭлементСЗ.Значение); 			
			Исключение
				Продолжить;
			КонецПопытки;					
		КонецЦикла;	
		Если ЗначениеЗаполнено(Сумма) Тогда
			Элемент.Подвал = Истина;
			Элемент.ТекущийЭлемент.ТекстПодвала = ""+Сумма;
		КонецЕсли;			
	КонецЕсли;	
КонецПроцедуры

Процедура ОчиститьПодвал(Элемент)
	Для Каждого ПолеФормы ИЗ Элемент.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ПолеФормы) = Тип("ПолеФормы") Тогда
			ПолеФормы.ТекстПодвала = " ";			
		КонецЕсли;		
	КонецЦикла;
КонецПроцедуры

// Получаем массив стараниц на которых размещены вложенные таблицы
// 
// Параметры:
//  Элемент - ТаблицаФормы -
// 
// Возвращаемое значение:
//  ЭлементыФормы - Страницы группы вложенных таблиц
Функция ПолучитьСтраницыВложенныхТаблиц(Элемент)
	Перем Результат;
	Родитель = Элемент.Родитель;
	Если Не Родитель = Неопределено Тогда
		Для Каждого ЭлементРодителя ИЗ Родитель.ПодчиненныеЭлементы Цикл
			Если ТипЗнч(ЭлементРодителя) = Тип("ГруппаФормы") И СтрЗаканчиваетсяНа(ЭлементРодителя.Имя,КоллекцияСтруктураКлиентСервер_Ei.ПризнакВложеннойГруппы()) Тогда
				Результат = ЭлементРодителя.ПодчиненныеЭлементы; 
				Прервать;	
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	Возврат Результат;	
КонецФункции
#КонецОбласти


	

	
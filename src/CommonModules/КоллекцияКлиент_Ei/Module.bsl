#Область ПрограммныйИнтерфейс


// Получить размерность коллекции.
// 
// Параметры:
//  Коллекция 		- Неопределено - Коллекция
//  ТаблицаФормы 	- ТаблицаФормы - Эл формы
// 
// Возвращаемое значение:
//  Неопределено,Строка
Функция ПолучитьРазмерностьКоллекции(Коллекция,ТаблицаФормы) Экспорт
	ЧислоСтрок = Коллекция.Количество();
	Если ЧислоСтрок Тогда
		Возврат ""+ЧислоСтрок+"/"+ТаблицаФормы.ПодчиненныеЭлементы.Количество();
	КонецЕсли;	 	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс
Процедура Выбор(Форма,Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) Экспорт
	СтандартнаяОбработка 	= Ложь;
	ВыделенныеСтроки		= Новый Массив; //сформируем массив выделенных туда передаим только одну выбранную, конструкция еще используется в перетаскивании
	ВыделенныеСтроки.Добавить(ВыбраннаяСтрока);
	ЗначенияЯчеек 			= ПолучитьВыделенныеЯчейки(Форма, Элемент, ВыделенныеСтроки, Поле);   
	Если ЗначенияЯчеек.Количество() Тогда
		ПоказатьЗначение(,ЗначенияЯчеек[0].Значение); //пока зываем всегда первое, список нет смысла показывать, поскольку из него всеравно ничего не выбрать
 	КонецЕсли;
КонецПроцедуры

Процедура ПриАктивизацииСтроки(Форма,Элемент) Экспорт
	Страницы = ПолучитьСтраницыВложенныхТаблиц(Элемент);
	Если Не Страницы = Неопределено Тогда
		ДанныеСтроки 	= Элемент.ДанныеСтроки(Элемент.ТекущаяСтрока);
		Если Не ДанныеСтроки = Неопределено Тогда		
			Для Каждого Страница ИЗ Страницы Цикл
				ИмяДанных		= ОбщегоНазначенияКлиентСервер_Ei.СтрНачалоДо(Страница.Заголовок);
				Коллекция		= Неопределено;
				Если Не ИмяДанных = Неопределено Тогда
					Если ДанныеСтроки.Свойство(ИмяДанных,Коллекция) Тогда
						Для Каждого ЭлФормы ИЗ Страница.ПодчиненныеЭлементы Цикл
							Если ТипЗнч(ЭлФормы) = Тип("ТаблицаФормы") Тогда
								сРазмерность = ПолучитьРазмерностьКоллекции(Коллекция,ЭлФормы);
								Если ЗначениеЗаполнено(сРазмерность) Тогда  
									Страница.Заголовок  = СтрШаблон("%1 (%2)",ИмяДанных,сРазмерность);
								Иначе
									Страница.Заголовок  = ИмяДанных;
								КонецЕсли;		
							КонецЕсли;	
						КонецЦикла;	 
					КонецЕсли;
				КонецЕсли;	 
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;					
КонецПроцедуры

Процедура ПриАктивизацииЯчейки(Форма,Элемент) Экспорт
	ВывестиИтогиВПодвале(Форма, Элемент);			
КонецПроцедуры

Функция ПолучитьВыделенныеЯчейки(Форма, Элемент, ВыделенныеСтроки, Поле) Экспорт
	ВыделенноеСодержимое =  Новый СписокЗначений;
	Если ЗначениеЗаполнено(Поле.Заголовок) Тогда
		Для Каждого ИдСтроки ИЗ ВыделенныеСтроки Цикл
			ДанныеСтроки = Элемент.ДанныеСтроки(ИдСтроки);
			Если Не ДанныеСтроки = Неопределено Тогда
			    ВыделенноеСодержимое.Добавить(ДанныеСтроки[Поле.Заголовок]);		
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	Возврат ВыделенноеСодержимое; 
КонецФункции
#КонецОбласти


#Область СлужебныеПроцедурыИФункции
Процедура ВывестиИтогиВПодвале(Форма, Элемент)
	ОчиститьПодвал(Элемент);
	Элемент.Подвал = Ложь;
	ЗначенияЯчеек = ПолучитьВыделенныеЯчейки(Форма, Элемент, Элемент.ВыделенныеСтроки, Элемент.ТекущийЭлемент);	
	Если ЗначенияЯчеек.Количество()>1 Тогда
		Сумма = 0;
		Для Каждого ЭлементСЗ ИЗ ЗначенияЯчеек Цикл
			Попытка
				Сумма = Сумма + Число(ЭлементСЗ.Значение); 			
			Исключение
				Продолжить;
			КонецПопытки;					
		КонецЦикла;	
		Если ЗначениеЗаполнено(Сумма) Тогда
			Элемент.Подвал = Истина;
			Элемент.ТекущийЭлемент.ТекстПодвала = ""+Сумма;
		КонецЕсли;			
	КонецЕсли;	
КонецПроцедуры

Процедура ОчиститьПодвал(Элемент)
	Для Каждого ПолеФормы ИЗ Элемент.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ПолеФормы) = Тип("ПолеФормы") Тогда
			ПолеФормы.ТекстПодвала = " ";			
		КонецЕсли;		
	КонецЦикла;
КонецПроцедуры

// Получаем массив стараниц на которых размещены вложенные таблицы
// 
// Параметры:
//  Элемент - ТаблицаФормы -
// 
// Возвращаемое значение:
//  ЭлементыФормы - Страницы группы вложенных таблиц
Функция ПолучитьСтраницыВложенныхТаблиц(Элемент)
	Перем Результат;
	Родитель = Элемент.Родитель;
	Если Не Родитель = Неопределено Тогда
		Для Каждого ЭлементРодителя ИЗ Родитель.ПодчиненныеЭлементы Цикл
			Если ТипЗнч(ЭлементРодителя) = Тип("ГруппаФормы") И СтрЗаканчиваетсяНа(ЭлементРодителя.Имя,КоллекцияСтруктураКлиентСервер_Ei.ПризнакВложеннойГруппы()) Тогда
				Результат = ЭлементРодителя.ПодчиненныеЭлементы; 
				Прервать;	
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	Возврат Результат;	
КонецФункции
#КонецОбласти

	

	
#Область СлужебныйПрограммныйИнтерфейс
// Получить варианты.
// 
// Возвращаемое значение:
//  Соответствие Из ОбщийМодуль
Функция ПолучитьВарианты() Экспорт
	Результат 	= Новый Соответствие;
	СтрВарианты = ОбщегоНазначенияВызовСервера_Ei.ПолучитьСоставПодсистемы(ВариантыКлиентСервер_Ei.Ключ());
	Для Каждого СтрВариант ИЗ СтрВарианты Цикл
		Попытка
			Вариант = ВыполнитьКлиентСервер_Ei.ВычислитьБезопасно(СтрВариант);
			Результат.Вставить(Вариант.Свойства().Имя,Вариант);
		Исключение
			//Значит в состав затесался не общий модуль, пропустим его
			Продолжить;
		КонецПопытки;	
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Картинка ссылка.
// 
// Параметры:
//  ВариантИмя - Строка
// 
// Возвращаемое значение:
//  Строка - Картинка ссылка
Функция КартинкаСсылка(ВариантИмя) Экспорт
	Для Каждого ЭлРезультата ИЗ ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
		Обработчик = ЭлРезультата.Значение;
		Если ЭлРезультата.Ключ = ВариантИмя Тогда
			Возврат ПоместитьВоВременноеХранилище(Обработчик.Свойства().Картинка,Новый УникальныйИдентификатор)	
		КонецЕсли;		
	КонецЦикла;		
КонецФункции

//Получает варинаты в определелном порядке
//
// Возвращаемое значение:
//  Массив из Строка - Имен Вариантов
Функция ПолучитьМассивВариантов() Экспорт
	Имена 		= ОбщегоНазначенияВызовСервера_Ei.ПолучитьМассивПодсистем(ВариантыКлиентСервер_Ei.Ключ());
	Варианты = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты();
	ОбщегоНазначенияКлиентСервер_Ei.ЗаполнитьМассивИмен(Варианты, Имена);
	Возврат Имена;
КонецФункции

#КонецОбласти	

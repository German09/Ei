Функция ПолучитьВарианты() Экспорт
	Результат 	= Новый Соответствие;
	СтрВарианты = ОбщийМодульВызовСервера_Ei.ПолучитьСоставПодсистемы(ВариантыКлиентСервер_Ei.Ключ());
	Для Каждого СтрВариант ИЗ СтрВарианты Цикл
		Попытка
			Вариант = Вычислить(СтрВариант);
			Результат.Вставить(Вариант.Свойства().Имя,Вариант);
		Исключение
			//Значит в состав затесался не общий модуль, пропустим его
			Продолжить;
		КонецПопытки;	
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция КартинкаСсылка(ВариантИмя) Экспорт
	Для Каждого ЭлРезультата ИЗ ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
		Обработчик = ЭлРезультата.Значение;
		Если ЭлРезультата.Ключ = ВариантИмя Тогда
			Возврат ПоместитьВоВременноеХранилище(Обработчик.Свойства().Картинка,Новый УникальныйИдентификатор)	
		КонецЕсли;		
	КонецЦикла;		
КонецФункции

//Получает варинаты в определелном порядке
//
Функция ПолучитьМассивВариантов() Экспорт
	мИмен 		= ОбщийМодульВызовСервера_Ei.ПолучитьМассивПодсистем(ВариантыКлиентСервер_Ei.Ключ());
	сооВарианты = ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты();
	//меняем имя подсистемы в массиве на общий модуль из соответсвия 
	Для Каждого ЭлСоо ИЗ ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
		Индекс = мИмен.Найти(нРег(ЭлСоо.Ключ));
		Если Не Индекс = Неопределено Тогда
			мИмен.Установить(Индекс,ЭлСоо.Значение);	
		Иначе
			//не нашли добавим в самый конец
			мИмен.Добавить(ЭлСоо.Значение);		
		КонецЕсли;	 		
	КонецЦикла;	
	Возврат мИмен;
КонецФункции	

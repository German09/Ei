

#Область ПрограммныйИнтерфейс

// Функция - Вычисляет/выполняет выражение на встроенном языке
//
// Параметры:
//  Выражение				 - Строка - Вычисляемое выражение
//  УникальныйИдентификатор	 - УникальныйИдентификатор	 -  Идентификатор адреса, в который нужно поместить результат вычисления
//  ОписаниеТипов			 - ОписаниеТипов - Типы, к которым будет приводится вычисленное значение
//  КонтекстВыполнения		 - Структура -
//
// Возвращаемое значение:
//  - Структура - см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//	- УникальныйИдентификатор - значения в Кеше сервера
//	- Неопределено -  Если не заполнено выражение
//
Функция Выражение(Знач Выражение,УникальныйИдентификатор = Неопределено,ОписаниеТипов = Неопределено,Знач КонтекстВыполнения = Неопределено,СообщатьОбОшибке = Истина) Экспорт
	Перем Значение,Результат;
	КонтекстВыполнения	= ?(КонтекстВыполнения = Неопределено, Новый Структура,КонтекстВыполнения);
	УдалитьОО(КонтекстВыполнения);
	СтрВыражения	= ПодготовитьВыражение(Выражение);
	Выражение		= СтрВыражения.Выражение;
	ОшибкаКлиент	= Неопределено;	
	Если Не ПустаяСтрока(Выражение) Тогда
		СообщениеОтладки	= ВыполнитьВызовСервера_Ei.вПолучитьОписаниеВыражения(Выражение,ОписаниеТипов,КонтекстВыполнения);	
		СобытиеОтладки 		= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Выполнение "+СообщениеОтладки,"Встроенный язык");
		#Если Клиент Тогда
			//вначале пробуем вычислять это на клиенте
			Попытка
				Значение = ВыражениеВычислить(Выражение,УникальныйИдентификатор,ОписаниеТипов,КонтекстВыполнения);
			Исключение
				Попытка
					Значение = ВыражениеВыполнить(Выражение,УникальныйИдентификатор,ОписаниеТипов,КонтекстВыполнения);
				Исключение
					ОшибкаКлиент = ПолучениеВложеннойОшибки();				
				КонецПопытки;	
			КонецПопытки;
		#КонецЕсли		
		Если 	Не ОшибкаКлиент = Неопределено 
				ИЛИ Значение 	= Неопределено  Тогда
			//теперь пробуем выполнять на сервере		
			Попытка
				Значение = ВыполнитьВызовСервера_Ei.ВыражениеВычислить(Выражение,УникальныйИдентификатор,ОписаниеТипов,КонтекстВыполнения);
			Исключение
				Попытка
					Значение = ВыполнитьВызовСервера_Ei.ВыражениеВыполнить(Выражение,УникальныйИдентификатор,ОписаниеТипов,КонтекстВыполнения);
				Исключение
					ОшибкаСервер = ПолучениеВложеннойОшибки();
					ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ОшибкаСервер);	
					ВызватьИсключение СтрШаблон("Выполнение на клиенте:%1%2%1Выполнение на сервере:%1%3",
										Символы.ПС,
										ОбработкаОшибок.ПодробноеПредставлениеОшибки(ОшибкаКлиент),
										ОбработкаОшибок.ПодробноеПредставлениеОшибки(ОшибкаСервер));
				КонецПопытки;
			КонецПопытки;		
		КонецЕсли;
		
		Если ОбщийМодульВызовСервера_Ei.ЭтоАдресКешаЗначений(Значение)  Тогда
			//если получен адрес кеша значений, тоесть процедуры выполнения/вычисления вернули явное значение попробуем получить это значение на клиент
			#Если Клиент Тогда
				Попытка
					Результат =  ОбщийМодульВызовСервера_Ei.ПолучитьЗначениеИзКеша(Значение);
				Исключение
					//если получить его нельзя нужно формировать специальную фиксированную стрктуру описания и дальше на кленете оперировать уже только с ней
					//объязательно в параметрах указываем уникальный идентификатор иначе попытка бессмысленна ожидать его в служебных данных не стоит. если бы он был там указан мы бы не оказались в этой обработке исключений 
					Результат =  ОбщийМодульВызовСервера_Ei.ПодготовитьОписаниеЗначенияВызовСервера(Значение,Новый УникальныйИдентификатор);
				КонецПопытки;
			#КонецЕсли
	
			#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
				//если выполняем на сервере то тут нет возможности проверить поэтому для доступности на клиенте готовим описание
				Результат =  ОбщийМодульВызовСервера_Ei.ПодготовитьОписаниеЗначенияВызовСервера(Значение,Новый УникальныйИдентификатор);
			#КонецЕсли	
		Иначе
			Результат = Значение;
		КонецЕсли;
	Иначе
		Результат = Неопределено;
	КонецЕсли;		
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,"Информация","Результат = "+Строка(Результат)+ОтладкаКлиентСервер_Ei.ПризнакИсключения());
	Возврат  Результат;
КонецФункции

// Выполняет запрос или пакет запросов
//
// Параметры:
//  ТекстЗапроса	 			- Строка	 				- Сам текст запроса
//  ПараметрыЗапроса 			- Структура 				- Параметры запроса
//  УникальныйИдентификатор	 	- УникальныйИдентификатор	- Уникальный идентифкатор формы
// 
// Возвращаемое значение:
//   Структура - см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
Функция Запрос(Знач ТекстЗапроса,УникальныйИдентификатор) Экспорт
	РезультатЗапроса 	= Неопределено;
	ТекстЗапроса		= ПодготовитьТекст(ТекстЗапроса);
	СобытиеОтладки 		= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Выполнение запроса 1С"+Символы.ПС+ТекстЗапроса,"Запрос");
    Попытка
		//Если ВыполнитьПакет Тогда
			РезультатЗапроса = ВыполнитьВызовСервера_Ei.Запрос(ТекстЗапроса,УникальныйИдентификатор);
		//Иначе
		//	РезультатЗапроса=Запрос.Выполнить();
		//КонецЕсли;
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		Если ТипЗнч(ИнфоОбОшибке.Причина) 			=  Тип("ИнформацияОбОшибке") И
			 ТипЗнч(ИнфоОбОшибке.Причина.Причина) 	=  Тип("ИнформацияОбОшибке") Тогда
			//это ошибка в запросе, остальное не интересно
			ИнфоОбОшибке = ИнфоОбОшибке.Причина.Причина;
		ИначеЕсли ТипЗнч(ИнфоОбОшибке.Причина) 			=  Тип("ИнформацияОбОшибке") ТОгда
			ИнфоОбОшибке = ИнфоОбОшибке.Причина;
		КонецЕсли;
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнфоОбОшибке);
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнфоОбОшибке);
	КонецПопытки;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	Возврат РезультатЗапроса;
КонецФункции

// Выполняет СКД
//
// Параметры:
//  ТекстЗапроса	 			- Строка	 					- Сам текст СКД
//  ПараметрыЗапроса 			- Структура 					- Параметры запроса
//  УникальныйИдентификатор	 	- УникальныйИдентификатор	 	- Уникальный идентифкатор адреса.
//  ТипГенератора	 			- Строка	 					- Тип генератора
// 
// Возвращаемое значение:
//  Строка - Адрес в котором схоранен результат запроса
//
Функция СКД(Знач ТекстСКД,УникальныйИдентификатор,ТипГенератора="ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений",СтрРасшифровки) Экспорт
	РезультатСКД 	= Неопределено;
	ТекстСКД		= ПодготовитьТекст(ТекстСКД);
	СобытиеОтладки 	= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Выполнение СКД","Запрос");
    Попытка
		РезультатСКД = ВыполнитьВызовСервера_Ei.СКД(ТекстСКД,УникальныйИдентификатор,ТипГенератора,СтрРасшифровки);
    Исключение
    	ИнфоОбОшибке = ИнформацияОбОшибке();
		Если ТипЗнч(ИнформацияОбОшибке().Причина) 			=  Тип("ИнформацияОбОшибке") И
			 ТипЗнч(ИнформацияОбОшибке().Причина.Причина) 	=  Тип("ИнформацияОбОшибке") Тогда
			//это ошибка в запросе, остальное не интересно
			ИнфоОбОшибке = ИнформацияОбОшибке().Причина.Причина.Описание;
		Иначе
			ИнфоОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());	
		КонецЕсли;
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнфоОбОшибке);
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнфоОбОшибке);
	КонецПопытки;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	Возврат РезультатСКД;
КонецФункции

// Функция - Выполнить команду окружения  https://infostart.ru/public/1266995/
//
// Параметры:
//  ТекстСкрипта				 - Строка	 - Текст команды
//  ТекущаяПапка				 - Строка	 - Текущая дирректория выполнения, если задана то меняется Тип команды, если не задана то старемся выполнять через батникне меняется 
//  ТаймаутВыполненияКомандыСек	 - Число	 - Таймаут выполнения
// 
// Возвращаемое значение:
//   Структура:
//   	*Вывод 	-	Строка
//   	*Ошибки - 	Строка
//
Функция КомандаОкружения(ТекстСкрипта, ТекущаяПапка = Неопределено, ТаймаутВыполненияКомандыСек = 0) Экспорт
	// Структура результата выполнения команды
	РезультатВыполненияСкрипта = Новый Структура;
	РезультатВыполненияСкрипта.Вставить("Вывод", "");
	РезультатВыполненияСкрипта.Вставить("Ошибки", "");

	//@skip-check missing-temporary-file-deletion
	ВременныйФайлСкрипта 			= ПолучитьИмяВременногоФайла("bat");
	//@skip-check missing-temporary-file-deletion
	ВременныйФайлСкриптаPowerShell 	= ПолучитьИмяВременногоФайла("ps1");
	
	Если ТекущаяПапка = Неопределено Тогда
		// Подготавливаем скрипт PowerShell для запуска, но для запуска используем BAT'ник, чтобы сохранить условия безопасного запуска через WScript.Shell

		ПутьКПриложению 				= ОбщийМодульКлиентСервер_Ei.ПутьКИсполняемомуФайлуPowerShell();
		БезопасныйПутьКФайлуСкрипта		= """" + ВременныйФайлСкриптаPowerShell + """";	

		ТекстСкриптаДляВыполнения 	= ПутьКПриложению +" -executionpolicy bypass -File "+БезопасныйПутьКФайлуСкрипта;
		ТекстСкриптаPowerShell 		= ТекстСкрипта;

		ЗаписьТекстаСкриптаPowerShell = Новый ТекстовыйДокумент;
		ЗаписьТекстаСкриптаPowerShell.УстановитьТекст(ТекстСкриптаPowerShell);
		ЗаписьТекстаСкриптаPowerShell.Записать(ВременныйФайлСкриптаPowerShell, КодировкаТекста.UTF8);

		ОбщийМодульКлиентСервер_Ei.ЗаписатьФайлВформатеUTF8безBOM(ТекстСкриптаДляВыполнения, ВременныйФайлСкрипта);
		МаркерЦитирования 				= БезопасныйПутьКФайлуСкрипта;
		ТекстСкриптаДляВыполнения 		= ВременныйФайлСкрипта;
	Иначе
		//это запуск через cmd, поскольку задана директория то ожидается выполнение единичной команды
		
		//Bat`ник пока не выполняем он дает очень странный эффект
		
		//ЗаписьТекстаСкрипта = Новый ТекстовыйДокумент;
		//ЗаписьТекстаСкрипта.УстановитьТекст(ТекстСкрипта);
		//ЗаписьТекстаСкрипта.Записать(ВременныйФайлСкрипта, "cp866");
		//ТекстСкриптаДляВыполнения 		= ВременныйФайлСкрипта;

		МаркерЦитирования				= ТекстСкрипта;
		ТекстСкриптаДляВыполнения 		= ТекстСкрипта;
	КонецЕсли;	
	
			
	НачалоВыполненияКоманды 	= ТекущаяДата();
	ЗавершениеВыполненияКоманды = НачалоВыполненияКоманды + ТаймаутВыполненияКомандыСек;

	// Инициализация объекта WScript.Shell
	Попытка		
		objShell = Новый COMОбъект("WScript.Shell");		
	Исключение		
		ВызватьИсключение 
			"Не удалось инициализировать WScript.Shell.
			|Подробнее:
			|" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());		
	КонецПопытки;
	// Изменение директории
	Если Не ТекущаяПапка = Неопределено Тогда
		Попытка
			objShell.CurrentDirectory = ТекущаяПапка;	
		Исключение
			ВызватьИсключение "Директория выполненения """+ТекущаяПапка+""" не существует";
		КонецПопытки	
	КонецЕсли;	
	// Выполнение команды
	objWshScriptExec 	= objShell.Exec(ТекстСкриптаДляВыполнения);
	objStdOut 			= objWshScriptExec.StdOut;
	objStdErr 			= objWshScriptExec.StdErr;

	// Проверка истечения времени таймаута
	КомандаЗавершенаПоТаймауту = Ложь;
	Пока objWshScriptExec.Status = 0 Цикл
		ОбщийМодульКлиентСервер_Ei.Ожидать(1);
		Если ЗначениеЗаполнено(ТаймаутВыполненияКомандыСек) Тогда			
			Если ЗавершениеВыполненияКоманды <= ТекущаяДата() Тогда			
				КомандаЗавершенаПоТаймауту = Истина;			
				Прервать;				
			КонецЕсли;			
		Иначе			
			Прервать;			
		КонецЕсли;		
	КонецЦикла;

	// Читаем из потока результат выполнения команды - информация
	Если НЕ КомандаЗавершенаПоТаймауту Тогда
		РезультатВыполненияСкрипта.Вывод = objStdOut.ReadAll(); //https://docs.microsoft.com/ru-ru/office/vba/language/reference/user-interface-help/readall-method
		//Пока Не objStdOut.AtEndOfStream Цикл			
		//	strLine = objStdOut.ReadLine();
		//	РезультатВыполненияСкрипта.Вывод = РезультатВыполненияСкрипта.Вывод 
		//		+ strLine 
		//		+ Символы.ВК 
		//		+ Символы.ПС;			
		//	Если ЗначениеЗаполнено(ТаймаутВыполненияКомандыСек)
		//		И ЗавершениеВыполненияКоманды <= ТекущаяДата() Тогда				
		//		КомандаЗавершенаПоТаймауту = Истина;
		//		Прервать;				
		//	КонецЕсли;			
		//КонецЦикла; 		
	КонецЕсли;
	// Читаем из потока результат выполнения команды - ошибки
	Если НЕ КомандаЗавершенаПоТаймауту Тогда
		РезультатВыполненияСкрипта.Ошибки  = objStdErr.ReadAll();	
	КонецЕсли;

	// "Насильно" завершаем процесс по завершению работы
	// и "уничтожаем" COM-объект
	Попытка		
		objWshScriptExec.Terminate();
		objWshScriptExec = Неопределено;		
	Исключение		
		objWshScriptExec = Неопределено;		
	КонецПопытки;	
	objShell = Неопределено;

	// Если команда завершена по таймауту - вызываем исключение.
	// Иначе читаем результат и удаляем временные файлы
	ОбщийМодульКлиентСервер_Ei.УдалитьФайлЕслиВозможно(ВременныйФайлСкрипта);
	ОбщийМодульКлиентСервер_Ei.УдалитьФайлЕслиВозможно(ВременныйФайлСкриптаPowerShell);
	Если КомандаЗавершенаПоТаймауту Тогда		
		ВызватьИсключение "Внимание! Выполнение остановлено по истечении времени ожидания.";		
	Иначе		
		РезультатВыполненияСкрипта.Вывод 	= СокрЛП(ОбщийМодульКлиентСервер_Ei.ПреобразоватьКодировку(РезультатВыполненияСкрипта.Вывод));
		//Уберем из вывода цитату самой команды
		чНачалоЦитированияКомнады = СтрНайти(РезультатВыполненияСкрипта.Вывод,МаркерЦитирования);
		Если чНачалоЦитированияКомнады Тогда
			РезультатВыполненияСкрипта.Вывод = СокрЛП(Сред(РезультатВыполненияСкрипта.Вывод,чНачалоЦитированияКомнады+СтрДлина(МаркерЦитирования)));		
		КонецЕсли;	
		РезультатВыполненияСкрипта.Ошибки 	= СокрЛП(ОбщийМодульКлиентСервер_Ei.ПреобразоватьКодировку(РезультатВыполненияСкрипта.Ошибки));
		#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
			Комментарии = 	"Команада: "+ТекстСкрипта+Символы.ПС+
							"Время выполнения: "+(ТекущаяДата()-НачалоВыполненияКоманды)+" сек."+Символы.ПС+
							"Результат: "+ РезультатВыполненияСкрипта.Вывод + Символы.ПС + РезультатВыполненияСкрипта.Ошибки; 
			ЗаписьЖурналаРегистрации("Выполнение команды окружения",?(ПустаяСтрока(РезультатВыполненияСкрипта.Ошибки),УровеньЖурналаРегистрации.Информация,УровеньЖурналаРегистрации.Ошибка),,,Комментарии);	
		#КонецЕсли
	КонецЕсли;
	Возврат РезультатВыполненияСкрипта; 
КонецФункции


#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс
// Функция - Вычисляет выражение на встроенном языке
//
// Параметры:
//  Выражение				 - Строка - Вычисляемое выражение
//  УникальныйИдентификатор	 - УникальныйИдентификатор	 -  Идентификатор адреса, в который нужно поместить результат вычисления
//  ОписаниеТипов			 - ОписаниеТипов - Типы, к которым будет приводится вычисленное значение
//  КонтекстВыполнения		 - Структура -
//
// Возвращаемое значение:
//  - Структура - см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
Функция ВыражениеВычислить(Выражение,Знач УникальныйИдентификатор,Знач ОписаниеТипов, Знач КонтекстВыполнения) Экспорт 
	Перем Результат;	
	//@skip-check server-execution-safe-mode
	Значение 	= Вычислить(Выражение);	
	Результат 	= ПослеВычисленияЗначения(Значение,ОписаниеТипов,УникальныйИдентификатор);
	Возврат Результат;
КонецФункции

// Функция - выполняет выражение на встроенном языке ожидающее возвращаемое занчение в переменной "Результат"
//
// Параметры:
//  Выражение				 - Строка - Вычисляемое выражение
//  УникальныйИдентификатор	 - УникальныйИдентификатор	 -  Идентификатор адреса, в который нужно поместить результат вычисления
//  ОписаниеТипов			 - ОписаниеТипов - Типы, к которым будет приводится вычисленное значение
//  КонтекстВыполнения		 - Структура -
//
// Возвращаемое значение:
//  - Структура 				- см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
Функция ВыражениеВыполнить(Выражение,Знач УникальныйИдентификатор,Знач ОписаниеТипов,Знач КонтекстВыполнения) Экспорт 
	Перем Результат;	
	//@skip-check server-execution-safe-mode
	Выполнить(Выражение);
	
	Значение 	= Результат;
	Результат 	= ПослеВычисленияЗначения(Значение,ОписаниеТипов,УникальныйИдентификатор);
	Возврат Результат;
КонецФункции

// Функция - После вычисления значения
//
// Параметры:
//  Значение				 - Произвольный	 							- Вычисленное значение 
//  ОписаниеТипов			 - Массив из Строка, Строка, ОписаниеТипов	- Тип к которому нужно привести значение
//  УникальныйИдентификатор	 - УникальныйИдентификатор	 				- Индентифкатор формы, в случае его указания возвращается структура ОписанияЗначения
// 
// Возвращаемое значение:
//  - Структура - см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//	- УникальныйИдентификатор - значения в Кеше сервера
//
Функция ПослеВычисленияЗначения(Значение, ОписаниеТипов, УникальныйИдентификатор) Экспорт
	Если Не ОписаниеТипов = Неопределено Тогда
		ТипПриведения  	= ТипыКлиентСервер_Ei.ПроверитьОписание(ОписаниеТипов);
		Если НЕ ТипПриведения.СодержитТип(ТипЗнч(Значение)) Тогда
			//тут нужно подумать как приводить в сложные значение привести автоматом невсегда возможно
//			Если ТипПриведения.СодержитТип(Тип("ТаблицаЗначений")) Тогда
//				//приведем значение к таблице или дереву значений
//				Значение = КоллекцияВызовСервера_Ei.ПреобразоватьВТаблицуЗначений(Значение);
//			Иначе	
				Значение = ТипПриведения.ПривестиЗначение(Значение);			
//			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
	Если Не УникальныйИдентификатор = Неопределено Тогда
		//если уникальный идентификатор указан то сразу формируем описание значения без попытки передать в явном виде на клиент
	    Результат = ОписаниеЗначенияКлиентСервер_Ei.Подготовить(Значение,УникальныйИдентификатор);
	Иначе
		//мутабельные значения не получится поместить во внутренее хранилище поэтому просто поместим сохраним на сервере в КЭШе
		Результат = Новый УникальныйИдентификатор;
		КэшПользователяКлиентСерверПовтИсп_Ei.Значения().Вставить(Результат,Значение);
	КонецЕсли;	
	Возврат  Результат;			
КонецФункции
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучениеВложеннойОшибки()
	Если ТипЗнч(ИнформацияОбОшибке().Причина) =  Тип("ИнформацияОбОшибке") Тогда
		Возврат  ИнформацияОбОшибке().Причина;
	Иначе	
		Возврат ИнформацияОбОшибке();
	КонецЕсли;
КонецФункции

//Удалим все описания оповещения, а то из не получается передать на сервер
//
Процедура УдалитьОО(КонтекстВыполнения)
	мУдаления = Новый Массив;
	Для Каждого КлючЗначение из КонтекстВыполнения Цикл
		Если ТипЗнч(КлючЗначение.Значение) = Тип("ОписаниеОповещения") Тогда
			мУдаления.Добавить(КлючЗначение);		
		КонецЕСли;		
	КонецЦикла;
	Для Каждого КлючЗначение ИЗ  мУдаления Цикл
		КонтекстВыполнения.Удалить(КлючЗначение.Ключ);		
	КонецЦикла;			
КонецПроцедуры

// Подготовить выражение с учетом разных стратегий выполнения либо через конструкции либо через ВнешнююОбработку
// 
// Параметры:
//  Выражение - Строка
// 
// Возвращаемое значение:
//  Структура:
//		Выражение 	- Строка - Выражение, которое можно выполнить/вычислить
//		Модуль 		- Строка - Модуль внешней обработки, который нельзя исполнить через выполнить/вычислить
Функция ПодготовитьВыражение(Знач Выражение)
	Выражение = ПодготовитьТекст(Выражение);
	Результат = Новый Структура("Выражение,Модуль",Выражение,ВыполнитьВызовСервера_Ei.ПолучитьМодуль(Выражение));
	Возврат Результат;	
КонецФункции

// Подготовить выражение которое возможно будет выполнить, с учтом возможного наличия спец символов,
// которые не позволят выполнить и будут генерировать ошибку "Ожидается последовательность операторов"
// 
// Параметры:
//  Выражение - Строка
// 
// Возвращаемое значение:
//  Строка
Функция ПодготовитьТекст(Знач Выражение)
	СоотвесвтиеЗамены = Новый Соответствие;
	СоотвесвтиеЗамены.Вставить(Символ(160)," ");
	Возврат ОбщийМодульКлиентСервер_Ei.СтрЗаменитьИзСписка(Выражение,СоотвесвтиеЗамены);
КонецФункции

	


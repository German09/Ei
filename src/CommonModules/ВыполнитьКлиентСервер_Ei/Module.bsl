

#Область ПрограммныйИнтерфейс

// Функция - Вычисляет/выполняет выражение на встроенном языке
// Возвращает помимо описанного:
//	- УникальныйИдентификатор - значения в Кеше сервера
//	- Неопределено -  Если не заполнено выражение
//
// Параметры:
//  Код						 - Строка - Вычисляемое или выполняемое выражение или целый модуль
//  УникальныйИдентификатор	 - УникальныйИдентификатор	 -  Идентификатор адреса, в который нужно поместить результат вычисления
//  ОписаниеТипов			 - ОписаниеТипов - Типы, к которым будет приводится вычисленное значение
//  КонтекстВыполнения		 - Структура -
//  СообщатьОбОшибке		 - Булево
//
// Возвращаемое значение:
//  см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
Функция Выражение(Знач Код, УникальныйИдентификатор = Неопределено,ОписаниеТипов = Неопределено,Знач КонтекстВыполнения = Неопределено,СообщатьОбОшибке = Истина) Экспорт
	Перем Значение,Результат;
	КонтекстВыполнения	= ?(КонтекстВыполнения = Неопределено, Новый Структура,КонтекстВыполнения);
	УдалитьОО(КонтекстВыполнения);
	Модуль	= ПолучитьМодуль(Код);
	ОшибкаКлиент	= Неопределено;	
	Если Не ЗначениеЗаполнено(Модуль.ПроцедурыФункции) Тогда
		Выражение		= Модуль.СодержимоеГлавнойФункции;
		//это обычное выражение которое можно выполнить или вычислить
		ОписаниеВыражения	= ВыполнитьВызовСервера_Ei.вПолучитьОписаниеВыражения(Выражение,ОписаниеТипов,КонтекстВыполнения);	
		СобытиеОтладки 		= ОтладкаКлиентСервер_Ei.ДобавитьСобытие(ОперацияВыражения(ОписаниеВыражения),"Встроенный язык");
		МестаВыполнения		= Новый Массив; // Массив из Строка - где выражение выполнялось, для журнала
		#Если Клиент Тогда
			//вначале пробуем вычислять это на клиенте
			МестаВыполнения.Добавить(НСтр("ru = 'на клиенте'"));
			Попытка
				Значение = ВыражениеВычислить(Выражение,УникальныйИдентификатор,ОписаниеТипов,КонтекстВыполнения);
			Исключение
				Попытка
					Значение = ВыражениеВыполнить(Выражение,УникальныйИдентификатор,ОписаниеТипов,КонтекстВыполнения);
				Исключение
					ОшибкаКлиент = ПолучениеВложеннойОшибки(ИнформацияОбОшибке());				
				КонецПопытки;	
			КонецПопытки;
		#КонецЕсли		
		Если 	Не ОшибкаКлиент = Неопределено 
				ИЛИ Значение 	= Неопределено  Тогда
			//теперь пробуем выполнять на сервере		
			МестаВыполнения.Добавить(НСтр("ru = 'на сервере'"));
			Попытка
				Значение = ВыполнитьВызовСервера_Ei.ВыражениеВычислить(Выражение,УникальныйИдентификатор,ОписаниеТипов,КонтекстВыполнения);
			Исключение
				Попытка
					Значение = ВыполнитьВызовСервера_Ei.ВыражениеВыполнить(Выражение,УникальныйИдентификатор,ОписаниеТипов,КонтекстВыполнения);
				Исключение
					ОшибкаСервер = ПолучениеВложеннойОшибки(ИнформацияОбОшибке());					
					СобытиеОтладки.Операция = ОперацияВыражения(ОписаниеВыражения, МестаВыполнения);
					ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ОшибкаСервер);
					// Первая строка - причина: по ней строится представление результата и колонка ошибки журнала.
					// Клиентской ошибки нет, если выражение вычислялось на сервере или на клиенте вернуло Неопределено.
					Искл = Новый Массив;
					Искл.Добавить(ОбработкаОшибок.КраткоеПредставлениеОшибки(ОшибкаСервер));
					Если ОшибкаКлиент <> Неопределено Тогда
						Искл.Добавить("	Выполнение на клиенте");
						Искл.Добавить(УбратьВнутренииеПути(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ОшибкаКлиент)));
						Искл.Добавить("	Выполнение на сервере");
					КонецЕсли;
					Искл.Добавить(УбратьВнутренииеПути(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ОшибкаСервер)));
					ВызватьИсключение СтрСоединить(Искл,Символы.ПС);
				КонецПопытки;
			КонецПопытки;		
		КонецЕсли;
		СобытиеОтладки.Операция = ОперацияВыражения(ОписаниеВыражения, МестаВыполнения);
		
		Если ОбщегоНазначенияВызовСервера_Ei.ЭтоАдресКешаЗначений(Значение)  Тогда
			//если получен адрес кеша значений, тоесть процедуры выполнения/вычисления вернули явное значение попробуем получить это значение на клиент
			#Если Клиент Тогда
				Попытка
					Результат =  ОбщегоНазначенияВызовСервера_Ei.ПолучитьЗначениеИзКеша(Значение);
				Исключение
					//если получить его нельзя нужно формировать специальную фиксированную стрктуру описания и дальше на кленете оперировать уже только с ней
					//объязательно в параметрах указываем уникальный идентификатор иначе попытка бессмысленна ожидать его в служебных данных не стоит. если бы он был там указан мы бы не оказались в этой обработке исключений 
					Результат =  ОбщегоНазначенияВызовСервера_Ei.ПодготовитьОписаниеЗначенияВызовСервера(Значение,Новый УникальныйИдентификатор);
				КонецПопытки;
			#КонецЕсли
	
			#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
				//если выполняем на сервере то тут нет возможности проверить поэтому для доступности на клиенте готовим описание
				Результат =  ОбщегоНазначенияВызовСервера_Ei.ПодготовитьОписаниеЗначенияВызовСервера(Значение,Новый УникальныйИдентификатор);
			#КонецЕсли	
		Иначе
			Результат = Значение;
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Модуль.ПроцедурыФункции) Тогда
		
		ТекстМодуля			= ВариантАлгоритмКлиентСервер_Ei.ПодготовитьМодуль(Модуль,Ложь);
		СобытиеОтладки 		= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Модуль "+ТекстМодуля,"Встроенный язык");	
		
		Результат = ВыполнитьВызовСервера_Ei.ВыполнитьМодуль(ТекстМодуля,УникальныйИдентификатор,ОписаниеТипов);	
	ИНаче	
		Результат = Неопределено;
	КонецЕсли;		
	Если СобытиеОтладки <> Неопределено Тогда
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	КонецЕсли;
	Возврат  Результат;
КонецФункции



// Выполняет блок операторов ровно один раз в заданном месте: без пробного вычисления
// и без перехода с клиента на сервер, как в см. Выражение
// Нужно, когда место выполнения выбрано заранее, например запросом MCP.
//
// Параметры:
//  Код - Строка - блок операторов (результат присваивается переменной Результат), выражение или модуль
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор формы для описания значения
//  МестоВыполнения - Строка - см. МестаВыполнения
//  Режим - Строка, Неопределено - см. РежимыВыражения; по умолчанию блок операторов.
//          Модуль с процедурами и функциями выполняется только на сервере
//
// Возвращаемое значение:
//  см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
Функция ВыражениеВМесте(Знач Код, УникальныйИдентификатор, МестоВыполнения, Режим = Неопределено) Экспорт
	
	Места = МестаВыполнения();
	Режимы = РежимыВыражения();
	РежимВыражения = ?(ЗначениеЗаполнено(Режим), Режим, Режимы.Выполнить);
	Код = ВариантАлгоритмКлиентСервер_Ei.ВидДляEi(ПодготовитьТекст(Код));
	КонтекстВыполнения = Новый Структура;
	ОписаниеВыражения = ВыполнитьВызовСервера_Ei.вПолучитьОписаниеВыражения(Код, Неопределено, КонтекстВыполнения);
	СобытиеОтладки = ОтладкаКлиентСервер_Ei.ДобавитьСобытие(ОперацияВыражения(ОписаниеВыражения), "Встроенный язык");
	МестаЖурнала = Новый Массив; // Массив из Строка
	
	Попытка
		Если РежимВыражения <> Режимы.Выполнить И РежимВыражения <> Режимы.Вычислить И РежимВыражения <> Режимы.Модуль Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный режим выполнения: %1'"), РежимВыражения);
		ИначеЕсли РежимВыражения = Режимы.Модуль Тогда
			Если МестоВыполнения <> Места.Сервер Тогда
				ВызватьИсключение НСтр("ru = 'Модуль с процедурами и функциями выполняется только на сервере'");
			КонецЕсли;
			МестаЖурнала.Добавить(НСтр("ru = 'на сервере'"));
			Модуль = ВыполнитьВызовСервера_Ei.ПолучитьМодуль(Код);
			Если Не ЗначениеЗаполнено(Модуль.ПроцедурыФункции) Тогда
				ВызватьИсключение НСтр("ru = 'В модуле нет процедур и функций: выполните его как блок операторов'");
			КонецЕсли;
			ТекстМодуля = ВариантАлгоритмКлиентСервер_Ei.ПодготовитьМодуль(Модуль, Ложь);
			Значение = ВыполнитьВызовСервера_Ei.ВыполнитьМодуль(ТекстМодуля, УникальныйИдентификатор, Неопределено);
		ИначеЕсли МестоВыполнения = Места.Клиент Тогда
			МестаЖурнала.Добавить(НСтр("ru = 'на клиенте'"));
			#Если Клиент Тогда
				Если РежимВыражения = Режимы.Вычислить Тогда
					Значение = ВыражениеВычислить(Код, УникальныйИдентификатор, Неопределено, КонтекстВыполнения);
				Иначе
					Значение = ВыражениеВыполнить(Код, УникальныйИдентификатор, Неопределено, КонтекстВыполнения);
				КонецЕсли;
			#Иначе
				ВызватьИсключение НСтр("ru = 'Выполнение на клиенте недоступно в серверном контексте'");
			#КонецЕсли
		ИначеЕсли МестоВыполнения = Места.Сервер Тогда
			МестаЖурнала.Добавить(НСтр("ru = 'на сервере'"));
			Если РежимВыражения = Режимы.Вычислить Тогда
				Значение = ВыполнитьВызовСервера_Ei.ВыражениеВычислить(Код, УникальныйИдентификатор, Неопределено, КонтекстВыполнения);
			Иначе
				Значение = ВыполнитьВызовСервера_Ei.ВыражениеВыполнить(Код, УникальныйИдентификатор, Неопределено, КонтекстВыполнения);
			КонецЕсли;
		Иначе
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестное место выполнения: %1'"), МестоВыполнения);
		КонецЕсли;
	Исключение
		Ошибка = ПолучениеВложеннойОшибки(ИнформацияОбОшибке());
		СобытиеОтладки.Операция = ОперацияВыражения(ОписаниеВыражения, МестаЖурнала);
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки, "ОченьВажное", Ошибка);
		// Первая строка - причина: по ней строится представление результата и колонка ошибки журнала.
		ВызватьИсключение ОбработкаОшибок.КраткоеПредставлениеОшибки(Ошибка) + Символы.ПС
			+ УбратьВнутренииеПути(ОбработкаОшибок.ПодробноеПредставлениеОшибки(Ошибка));
	КонецПопытки;
	
	СобытиеОтладки.Операция = ОперацияВыражения(ОписаниеВыражения, МестаЖурнала);
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	
	Возврат Значение;
	
КонецФункции

// Места выполнения для см. ВыражениеВМесте
//
// Возвращаемое значение:
//  Структура:
//   * Клиент - Строка
//   * Сервер - Строка
//
Функция МестаВыполнения() Экспорт
	
	Возврат Новый Структура("Клиент, Сервер", "Клиент", "Сервер");
	
КонецФункции

// Режимы выполнения кода для см. ВыражениеВМесте
//
// Возвращаемое значение:
//  Структура:
//   * Выполнить - Строка - блок операторов, результат - переменная Результат
//   * Вычислить - Строка - выражение, результат - его значение
//   * Модуль - Строка - процедуры и функции с основным блоком или экспортной функцией Результат
//
Функция РежимыВыражения() Экспорт
	
	Возврат Новый Структура("Выполнить, Вычислить, Модуль", "Выполнить", "Вычислить", "Модуль");
	
КонецФункции

// Выполняет запрос или пакет запросов
//
// Параметры:
//  ТекстЗапроса	 			- Строка	 				- Сам текст запроса
//  ПараметрыЗапроса 			- Структура 				- Параметры запроса
//  УникальныйИдентификатор	 	- УникальныйИдентификатор	- Уникальный идентифкатор формы
// 
// Возвращаемое значение:
//   Структура - см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
Функция Запрос(Знач ТекстЗапроса,УникальныйИдентификатор) Экспорт
	РезультатЗапроса 	= Неопределено;
	ТекстЗапроса		= ПодготовитьТекст(ТекстЗапроса);
	СобытиеОтладки 		= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Выполнение запроса 1С"+Символы.ПС+ТекстЗапроса,"Запрос");
    Попытка
		//Если ВыполнитьПакет Тогда
			РезультатЗапроса = ВыполнитьВызовСервера_Ei.Запрос(ТекстЗапроса,УникальныйИдентификатор);
		//Иначе
		//	РезультатЗапроса=Запрос.Выполнить();
		//КонецЕсли;
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		Если ТипЗнч(ИнфоОбОшибке.Причина) 			=  Тип("ИнформацияОбОшибке") И
			 ТипЗнч(ИнфоОбОшибке.Причина.Причина) 	=  Тип("ИнформацияОбОшибке") Тогда
			//это ошибка в запросе, остальное не интересно
			ИнфоОбОшибке = ИнфоОбОшибке.Причина.Причина;
		ИначеЕсли ТипЗнч(ИнфоОбОшибке.Причина) 			=  Тип("ИнформацияОбОшибке") ТОгда
			ИнфоОбОшибке = ИнфоОбОшибке.Причина;
		КонецЕсли;
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнфоОбОшибке);
		Если СтрНачинаетсяС(нРег(ИнфоОбОшибке.Описание),нРег("Не установлен менеджер временных таблиц")) Тогда
			ВызватьИсключение СтрШаблон("%1. Добавьте вычисляемый параметр, который возвращает тип <%2>",ИнфоОбОшибке.Описание,"МенеджерВременныхТаблиц");
		Иначе
			ВызватьИсключение ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнфоОбОшибке);
		Конецесли	
	КонецПопытки;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	Возврат РезультатЗапроса;
КонецФункции

// Выполняет СКД
//
// Параметры:
//  ТекстСКД	 			- Строка	 					- Сам текст СКД
//  ПараметрыЗапроса 			- Структура 					- Параметры запроса
//  УникальныйИдентификатор	 	- УникальныйИдентификатор	 	- Уникальный идентифкатор адреса.
//  ТипГенератора	 			- Строка	 					- Тип генератора
// 
// Возвращаемое значение:
//  Строка - Адрес в котором схоранен результат запроса
//
Функция СКД(Знач ТекстСКД,УникальныйИдентификатор,ТипГенератора="ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений",СтрРасшифровки) Экспорт
	РезультатСКД 	= Неопределено;
	ТекстСКД		= ПодготовитьТекст(ТекстСКД);
	СобытиеОтладки 	= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Выполнение СКД","Запрос");
    Попытка
		РезультатСКД = ВыполнитьВызовСервера_Ei.СКД(ТекстСКД,УникальныйИдентификатор,ТипГенератора,СтрРасшифровки);
    Исключение
    	ИнфоОбОшибке = ИнформацияОбОшибке();
		Если ТипЗнч(ИнформацияОбОшибке().Причина) 			=  Тип("ИнформацияОбОшибке") И
			 ТипЗнч(ИнформацияОбОшибке().Причина.Причина) 	=  Тип("ИнформацияОбОшибке") Тогда
			//это ошибка в запросе, остальное не интересно
			ИнфоОбОшибке = ИнформацияОбОшибке().Причина.Причина.Описание;
		Иначе
			ИнфоОбОшибке = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());	
		КонецЕсли;
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнфоОбОшибке);
		ВызватьИсключение ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнфоОбОшибке);
	КонецПопытки;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	Возврат РезультатСКД;
КонецФункции

// Функция - Выполнить команду окружения  https://infostart.ru/public/1266995/
//
// Параметры:
//  ТекстСкрипта				 - Строка	 - Текст команды
//  ТекущаяПапка				 - Строка	 - Текущая дирректория выполнения, если задана то меняется Тип команды, если не задана то старемся выполнять через батникне меняется 
//  ТаймаутВыполненияКомандыСек	 - Число	 - Таймаут выполнения
// 
// Возвращаемое значение:
//   Структура:
//   	*Вывод 	-	Строка
//   	*Ошибки - 	Строка
//
Функция КомандаОкружения(ТекстСкрипта, ТекущаяПапка = Неопределено, ТаймаутВыполненияКомандыСек = 0) Экспорт
	// Структура результата выполнения команды
	РезультатВыполненияСкрипта = Новый Структура;
	РезультатВыполненияСкрипта.Вставить("Вывод", "");
	РезультатВыполненияСкрипта.Вставить("Ошибки", "");

	//@skip-check missing-temporary-file-deletion
	ВременныйФайлСкрипта 			= ПолучитьИмяВременногоФайла("bat");
	//@skip-check missing-temporary-file-deletion
	ВременныйФайлСкриптаPowerShell 	= ПолучитьИмяВременногоФайла("ps1");
	
	Если ТекущаяПапка = Неопределено Тогда
		// Подготавливаем скрипт PowerShell для запуска, но для запуска используем BAT'ник, чтобы сохранить условия безопасного запуска через WScript.Shell

		ПутьКПриложению 				= ОбщегоНазначенияКлиентСервер_Ei.ПутьКИсполняемомуФайлуPowerShell();
		БезопасныйПутьКФайлуСкрипта		= """" + ВременныйФайлСкриптаPowerShell + """";	

		ТекстСкриптаДляВыполнения 	= ПутьКПриложению +" -executionpolicy bypass -File "+БезопасныйПутьКФайлуСкрипта;
		ТекстСкриптаPowerShell 		= ТекстСкрипта;

		ЗаписьТекстаСкриптаPowerShell = Новый ТекстовыйДокумент;
		ЗаписьТекстаСкриптаPowerShell.УстановитьТекст(ТекстСкриптаPowerShell);
		ЗаписьТекстаСкриптаPowerShell.Записать(ВременныйФайлСкриптаPowerShell, КодировкаТекста.UTF8);

		ОбщегоНазначенияКлиентСервер_Ei.ЗаписатьФайлВформатеUTF8безBOM(ТекстСкриптаДляВыполнения, ВременныйФайлСкрипта);
		МаркерЦитирования 				= БезопасныйПутьКФайлуСкрипта;
		ТекстСкриптаДляВыполнения 		= ВременныйФайлСкрипта;
	Иначе
		//это запуск через cmd, поскольку задана директория то ожидается выполнение единичной команды
		
		//Bat`ник пока не выполняем он дает очень странный эффект
		
		//ЗаписьТекстаСкрипта = Новый ТекстовыйДокумент;
		//ЗаписьТекстаСкрипта.УстановитьТекст(ТекстСкрипта);
		//ЗаписьТекстаСкрипта.Записать(ВременныйФайлСкрипта, "cp866");
		//ТекстСкриптаДляВыполнения 		= ВременныйФайлСкрипта;

		МаркерЦитирования				= ТекстСкрипта;
		ТекстСкриптаДляВыполнения 		= ТекстСкрипта;
	КонецЕсли;	
	
			
	НачалоВыполненияКоманды 	= ТекущаяДата();
	ЗавершениеВыполненияКоманды = НачалоВыполненияКоманды + ТаймаутВыполненияКомандыСек;

	// Инициализация объекта WScript.Shell
	Попытка		
		objShell = Новый COMОбъект("WScript.Shell");		
	Исключение		
		ВызватьИсключение 
			"Не удалось инициализировать WScript.Shell.
			|Подробнее:
			|" + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());		
	КонецПопытки;
	// Изменение директории
	Если Не ТекущаяПапка = Неопределено Тогда
		Попытка
			objShell.CurrentDirectory = ТекущаяПапка;	
		Исключение
			ВызватьИсключение "Директория выполненения """+ТекущаяПапка+""" не существует";
		КонецПопытки	
	КонецЕсли;	
	// Выполнение команды
	objWshScriptExec 	= objShell.Exec(ТекстСкриптаДляВыполнения);
	objStdOut 			= objWshScriptExec.StdOut;
	objStdErr 			= objWshScriptExec.StdErr;

	// Проверка истечения времени таймаута
	КомандаЗавершенаПоТаймауту = Ложь;
	Пока objWshScriptExec.Status = 0 Цикл
		ОбщегоНазначенияКлиентСервер_Ei.Ожидать(1);
		Если ЗначениеЗаполнено(ТаймаутВыполненияКомандыСек) Тогда			
			Если ЗавершениеВыполненияКоманды <= ТекущаяДата() Тогда			
				КомандаЗавершенаПоТаймауту = Истина;			
				Прервать;				
			КонецЕсли;			
		Иначе			
			Прервать;			
		КонецЕсли;		
	КонецЦикла;

	// Читаем из потока результат выполнения команды - информация
	Если НЕ КомандаЗавершенаПоТаймауту Тогда
		РезультатВыполненияСкрипта.Вывод = objStdOut.ReadAll(); //https://docs.microsoft.com/ru-ru/office/vba/language/reference/user-interface-help/readall-method
		//Пока Не objStdOut.AtEndOfStream Цикл			
		//	strLine = objStdOut.ReadLine();
		//	РезультатВыполненияСкрипта.Вывод = РезультатВыполненияСкрипта.Вывод 
		//		+ strLine 
		//		+ Символы.ВК 
		//		+ Символы.ПС;			
		//	Если ЗначениеЗаполнено(ТаймаутВыполненияКомандыСек)
		//		И ЗавершениеВыполненияКоманды <= ТекущаяДата() Тогда				
		//		КомандаЗавершенаПоТаймауту = Истина;
		//		Прервать;				
		//	КонецЕсли;			
		//КонецЦикла; 		
	КонецЕсли;
	// Читаем из потока результат выполнения команды - ошибки
	Если НЕ КомандаЗавершенаПоТаймауту Тогда
		РезультатВыполненияСкрипта.Ошибки  = objStdErr.ReadAll();	
	КонецЕсли;

	// "Насильно" завершаем процесс по завершению работы
	// и "уничтожаем" COM-объект
	Попытка		
		objWshScriptExec.Terminate();
		objWshScriptExec = Неопределено;		
	Исключение		
		objWshScriptExec = Неопределено;		
	КонецПопытки;	
	objShell = Неопределено;

	// Если команда завершена по таймауту - вызываем исключение.
	// Иначе читаем результат и удаляем временные файлы
	ОбщегоНазначенияКлиентСервер_Ei.УдалитьФайлЕслиВозможно(ВременныйФайлСкрипта);
	ОбщегоНазначенияКлиентСервер_Ei.УдалитьФайлЕслиВозможно(ВременныйФайлСкриптаPowerShell);
	Если КомандаЗавершенаПоТаймауту Тогда		
		ВызватьИсключение "Внимание! Выполнение остановлено по истечении времени ожидания.";		
	Иначе		
		РезультатВыполненияСкрипта.Вывод 	= СокрЛП(ОбщегоНазначенияКлиентСервер_Ei.ПреобразоватьКодировку(РезультатВыполненияСкрипта.Вывод));
		//Уберем из вывода цитату самой команды
		чНачалоЦитированияКомнады = СтрНайти(РезультатВыполненияСкрипта.Вывод,МаркерЦитирования);
		Если чНачалоЦитированияКомнады Тогда
			РезультатВыполненияСкрипта.Вывод = СокрЛП(Сред(РезультатВыполненияСкрипта.Вывод,чНачалоЦитированияКомнады+СтрДлина(МаркерЦитирования)));		
		КонецЕсли;	
		РезультатВыполненияСкрипта.Ошибки 	= СокрЛП(ОбщегоНазначенияКлиентСервер_Ei.ПреобразоватьКодировку(РезультатВыполненияСкрипта.Ошибки));
		#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
			Комментарии = 	"Команада: "+ТекстСкрипта+Символы.ПС+
							"Время выполнения: "+(ТекущаяДата()-НачалоВыполненияКоманды)+" сек."+Символы.ПС+
							"Результат: "+ РезультатВыполненияСкрипта.Вывод + Символы.ПС + РезультатВыполненияСкрипта.Ошибки; 
			ЗаписьЖурналаРегистрации("Выполнение команды окружения",?(ПустаяСтрока(РезультатВыполненияСкрипта.Ошибки),УровеньЖурналаРегистрации.Информация,УровеньЖурналаРегистрации.Ошибка),,,Комментарии);	
		#КонецЕсли
	КонецЕсли;
	Возврат РезультатВыполненияСкрипта; 
КонецФункции

// Подготовить выражение с учетом разных стратегий выполнения либо через конструкции либо через ВнешнююОбработку
// 
// Параметры:
//  Выражение - Строка
// 
// Возвращаемое значение:
//  см. ВыполнитьВызовСервера_Ei.ПолучитьМодуль
Функция ПолучитьМодуль(Знач Выражение) Экспорт
	//код, скопированный из модуля формы EDT, выполняется как код Ei
	Выражение = ВариантАлгоритмКлиентСервер_Ei.ВидДляEi(ПодготовитьТекст(Выражение));
	//лишний раз стараемся не вызывать сервер посмотрим наличие признаков модуля
	Для Каждого Признак ИЗ СтрРазделить(нРег(ОсновныеПризнакиМодуля()),"|") Цикл
		Если СтрНайти(нРег(Выражение),Признак) Тогда
			Модуль 	  = ВыполнитьВызовСервера_Ei.ПолучитьМодуль(Выражение);
			Если ЗначениеЗаполнено(Модуль.ПроцедурыФункции) Тогда
				Возврат Модуль;
			КонецЕсли;	
			Прервать;	
		КонецЕсли;
	КонецЦикла;		
	Возврат Новый Структура("СодержимоеГлавнойФункции,ПроцедурыФункции",Выражение,Неопределено);	
КонецФункции



Функция ПолучениеВложеннойОшибки(ИнфОбОшибке)
	Если ТипЗнч(ИнфОбОшибке.Причина) =  Тип("ИнформацияОбОшибке") Тогда
		Возврат ИнфОбОшибке.Причина;
	Иначе	
		Возврат ИнфОбОшибке;
	КонецЕсли;
КонецФункции

// Текст операции журнала для выполнения выражения.
//
// Параметры:
//  ОписаниеВыражения - Строка - см. ВыполнитьВызовСервера_Ei.вПолучитьОписаниеВыражения
//  МестаВыполнения - Массив из Строка, Неопределено - где выражение выполнялось: на клиенте, на сервере
//
// Возвращаемое значение:
//  Строка - первая строка видна в дереве журнала выполнения
//
Функция ОперацияВыражения(ОписаниеВыражения, МестаВыполнения = Неопределено)
	
	Если МестаВыполнения = Неопределено Или МестаВыполнения.Количество() = 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'Выполнение выражения: %1'"), ОписаниеВыражения);
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Выполнение выражения %1: %2'"), СтрСоединить(МестаВыполнения, " " + НСтр("ru = 'и'") + " "),
		ОписаниеВыражения);
	
КонецФункции

//Удалим все описания оповещения, а то из не получается передать на сервер
//
Процедура УдалитьОО(КонтекстВыполнения)
	мУдаления = Новый Массив;
	Для Каждого КлючЗначение из КонтекстВыполнения Цикл
		Если ТипЗнч(КлючЗначение.Значение) = Тип("ОписаниеОповещения") Тогда
			мУдаления.Добавить(КлючЗначение);		
		КонецЕСли;		
	КонецЦикла;
	Для Каждого КлючЗначение ИЗ  мУдаления Цикл
		КонтекстВыполнения.Удалить(КлючЗначение.Ключ);		
	КонецЦикла;			
КонецПроцедуры

Функция УбратьВнутренииеПути(ПодробноеПредОшибки)
	Результат = Новый Массив;
	Для Ном = 0 По СтрЧислоСтрок(ПодробноеПредОшибки) Цикл
		Строка = СтрПолучитьСтроку(ПодробноеПредОшибки,Ном);
		Если Не СтрНачинаетсяС(Строка, СтрШаблон("{%1","EnterpriseIntelligence")) Тогда
			Результат.Добавить(Строка);
		КонецЕсли;	
	КонецЦикла;
	Возврат СтрСоединить(Результат,Символы.ПС);
КонецФункции	



Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",					"ОбработкаНачалоПотока");
	Результат.Вставить("Синоним",				"Начало потока");
	Результат.Вставить("Картинка",				БиблиотекаКартинок.Разделение_Ei);
	Результат.Вставить("ИспользоватьНастройки",	Ложь);
	Результат.Вставить("Форма",					Неопределено);
	Результат.Вставить("ТипЭлемента",			Тип("ЭлементГрафическойСхемыРазделение")); 
	Возврат Результат; 
КонецФункции

// Переопределемая процедура - Выполнить обработку
//
// Параметры:
//  ОписаниеПотока	 - Структура 	- Структура формируемая процедурой ПроцессыКлиент_Ei.ВыполнитьПоток()
//										- сзВызовов 	- СписокЗначений 	- Последовательность подготовленных ОписанийОповещений вызова обоработок, первой располагется следующая к запуску обработка
//										- Контекст  	- Структура  		- Аналог структуры "ДоступныеСтруктуры" из переменной формы СтруктураПеременных
//  ВозврЗначение	 - Структура - Описание возврашаемого значения, в который нужно поместить результат выполнения, своства структуры формируются функцией ОписаниеЗначенияВызовСервера_Ei.Получить()
//
Функция ВыполнитьОбработку(УникальныйИдентификатор, Настройка, ДанныеКлиента) Экспорт
	Перем мФоновогоВыполнения,НастройкиОбработок;
	Результат = Новый Массив;
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(Настройка,"мФоновогоВыполнения",мФоновогоВыполнения) Тогда
		Настройка.Свойство("НастройкиОбработок",НастройкиОбработок);
		Для Каждого мНаправления ИЗ мФоновогоВыполнения Цикл //тут по сути д.б. один проход но оформим в цикл
			Результат.Добавить(ОбработкаНачалоПотокаВызовСервера_Ei.ЗапуститьПоток(мНаправления, НастройкиОбработок, ДанныеКлиента));
		КонецЦикла;
	КонецЕсли;	
	Возврат Новый ФиксированныйМассив(Результат);	
КонецФункции

// Может создать настройку обработки на основании контекста других обработок
// Имеет смысл только в случае ИспользоватьНастройки = Ложь.
// 
// Параметры:
//  Направление - Структура
//  мНаправления - Массив из Структура
//  НастройкиОбработок - Соответствие из Структура 
// 
// Возвращаемое значение:
// 	Произвольный 
Функция СоздатьНастройку(Направление, мНаправления, НастройкиОбработок) Экспорт
	Настройка = Новый Структура;
	ИндексНачала = мНаправления.Найти(Направление);
	Если Не ИндексНачала = Неопределено Тогда
		мФоновогоВыполнения = ПолучитьОбработкиПотока(ИндексНачала+1,мНаправления);
		Настройка.Вставить("мФоновогоВыполнения", 	мФоновогоВыполнения);
		Настройка.Вставить("НастройкиОбработок", 	НастройкиОбработок); 		
	КонецЕсли;
	Возврат Настройка;		
КонецФункции

//Получим новый массив направления удалив все элементы нового 
Функция ПолучитьОбработкиПотока(ИндексНачала,мНаправления)
	Результат 			= Новый Массив;
	Поток 				= Новый Массив;
	Результат.Добавить(Поток);
	сзУдаления 			= Новый СписокЗначений();
	Для Индекс = ИндексНачала По мНаправления.ВГраница() Цикл
		Направление	= мНаправления.Получить(Индекс);		
		Обработчик 	= ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки().Получить(Направление.Значение); //это не настраеваемая обработка
		Если Обработчик = ОбработкаЗавершениеПотокаКлиентСервер_Ei Тогда
			Прервать; 
		Иначе
			сзУдаления.Добавить(Индекс);
			Если ТипЗнч(Направление.Значение) =  Тип("Массив") Тогда
				//Это массив массивов напралений, несколько линий из разветвления
				Результат = Направление.Значение; 
				Прервать;
			Иначе
				//Это один поток - одна линия из разделителя
				Поток.Добавить(Направление);
			КонецЕсли;		
		КонецЕсли;	
	КонецЦикла;
	//и удалим их из списка вызовов что бы сразу перейти к слиянию/ОО_ФоновыйПотокЗавершение
	сзУдаления.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
	Для Каждого ЭлИндекс ИЗ сзУдаления Цикл
		мНаправления.Удалить(ЭлИндекс.Значение);		
	КонецЦикла;	
	Возврат Результат;
КонецФункции	
	
		
		


// Обработка процесса «Начало потока»: запускает направления после разделения схемы фоновыми заданиями,
// их завершения ждет обработка «Завершение потока», см. ОбработкаЗавершениеПотокаКлиентСервер_Ei

#Область ПрограммныйИнтерфейс

// Свойства обработки.
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - имя обработки, по нему обработка находится, см. ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки
//   * Синоним - Строка - представление в дереве доступных обработок
//   * Картинка - Картинка - картинка в дереве доступных обработок и на схеме
//   * ИспользоватьНастройки - Булево - у обработки нет настройки, ее создает СоздатьНастройку
//   * Форма - Неопределено - формы настройки нет
//   * ТипЭлемента - Тип - тип элемента графической схемы
//
Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",					"ОбработкаНачалоПотока");
	Результат.Вставить("Синоним",				"Начало потока");
	Результат.Вставить("Картинка",				БиблиотекаКартинок.Разделение_Ei);
	Результат.Вставить("ИспользоватьНастройки",	Ложь);
	Результат.Вставить("Форма",					Неопределено);
	Результат.Вставить("ТипЭлемента",			Тип("ЭлементГрафическойСхемыРазделение"));
	Возврат Результат;
КонецФункции

// Запускает направления потока фоновыми заданиями.
//
// Параметры:
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор для временного хранилища результатов
//  Настройка - Структура - настройка, см. СоздатьНастройку
//  ДанныеКлиента - Соответствие из КлючИЗначение - данные выполненных обработок, см. ПроцессыКлиентСервер_Ei.ВыполнитьПроцесс
//  Ход - Структура, Неопределено - ход процесса в фоне, см. ПроцессыКлиентСервер_Ei.НовыйХод
//
// Возвращаемое значение:
//  ФиксированныйМассив из Произвольный - описания запущенных потоков, см. ОбработкаНачалоПотокаВызовСервера_Ei.ЗапуститьПоток
//
Функция ВыполнитьОбработку(УникальныйИдентификатор, Настройка, ДанныеКлиента, Ход = Неопределено) Экспорт
	Результат = Новый Массив;
	ФоновыеНаправления = Неопределено;
	Если ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(Настройка, "ФоновыеНаправления", ФоновыеНаправления) Тогда
		Для Каждого Направления Из ФоновыеНаправления Цикл // по сути один проход
			Результат.Добавить(ОбработкаНачалоПотокаВызовСервера_Ei.ЗапуститьПоток(Направления, Настройка.НастройкиОбработок, ДанныеКлиента));
		КонецЦикла;
	КонецЕсли;
	Возврат Новый ФиксированныйМассив(Результат);
КонецФункции

// Создает настройку: направления от разделения до завершения потока. Они удаляются из направлений процесса,
// чтобы процесс сразу перешел к завершению потока.
//
// Параметры:
//  Направление - Структура - направление разделения, см. ПроцессыКлиентСервер_Ei.ВыполнитьПоток
//  Направления - Массив из Структура - направления процесса, из них удаляются направления потока
//  НастройкиОбработок - ФиксированноеСоответствие из КлючИЗначение - настройки обработок схемы
//
// Возвращаемое значение:
//  Структура:
//   * ФоновыеНаправления - Массив из Произвольный - массивы направлений, выполняемые фоновыми заданиями
//   * НастройкиОбработок - ФиксированноеСоответствие из КлючИЗначение - настройки обработок схемы
//
Функция СоздатьНастройку(Направление, Направления, НастройкиОбработок) Экспорт
	Результат = Новый Структура;
	ИндексНачала = Направления.Найти(Направление);
	Если ИндексНачала <> Неопределено Тогда
		Результат.Вставить("ФоновыеНаправления", ПолучитьОбработкиПотока(ИндексНачала + 1, Направления));
		Результат.Вставить("НастройкиОбработок", НастройкиОбработок);
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Направления потока от индекса начала до завершения потока, удаляет их из направлений процесса.
//
// Параметры:
//  ИндексНачала - Число - индекс первого направления потока
//  Направления - Массив из Структура - направления процесса
//
// Возвращаемое значение:
//  Массив из Произвольный - массивы направлений потоков: один поток или несколько линий разветвления
//
Функция ПолучитьОбработкиПотока(ИндексНачала, Направления)
	Результат = Новый Массив;
	Поток = Новый Массив;
	Результат.Добавить(Поток);
	Удаляемые = Новый СписокЗначений;
	Для Индекс = ИндексНачала По Направления.ВГраница() Цикл
		Направление = Направления.Получить(Индекс);
		Обработчик = ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки().Получить(Направление.Значение); // обработка без настройки
		Если Обработчик = ОбработкаЗавершениеПотокаКлиентСервер_Ei Тогда
			Прервать;
		КонецЕсли;
		Удаляемые.Добавить(Индекс);
		Если ТипЗнч(Направление.Значение) = Тип("Массив") Тогда
			// Несколько линий из разветвления: массив массивов направлений
			Результат = Направление.Значение;
			Прервать;
		КонецЕсли;
		// Одна линия из разделения
		Поток.Добавить(Направление);
	КонецЦикла;
	// Удаляем с конца, чтобы индексы не сдвигались
	Удаляемые.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
	Для Каждого Удаляемый Из Удаляемые Цикл
		Направления.Удалить(Удаляемый.Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

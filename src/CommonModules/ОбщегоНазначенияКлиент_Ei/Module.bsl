#Область ПрограммныйИнтерфейс
// Функция - Получить часть данных в виде структуры
//
// Параметры:
//  ПолныеДанные - Произвольные	 - Даныне содержашие свойства
//  сИменаПолей	 - Строка	 	 - Перечень свойств разделенных ","
// 
// Возвращаемое значение:
//   - Структура . Выделенные данные собранные в структуру
//
Функция ПолучитьСтруктуруДанных(ПолныеДанные,сИменаПолей) Экспорт
	ЧастьПолныхДанных = Новый Структура(сИменаПолей);
	Если Не ПолныеДанные = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ЧастьПолныхДанных,ПолныеДанные);
	КонецЕсли;	
	Возврат ЧастьПолныхДанных;
КонецФункции	


// В получить уникальное имя в коллекции.
// 
// Параметры:
//  СтрПоиска 		- Структура
//  Коллекция 		- ДанныеФормыКоллекцияЭлементовДерева, ЭлементыГрафическойСхемы, ДанныеФормыКоллекция - Коллекция
//  сРазделитель 	- Строка - С разделитель
//  Приращение 		- Число - Приращение
//  Вложенные 		- Булево - Вложенные
// 
// Возвращаемое значение:
//  Строка - В получить уникальное имя в коллекции
Функция вПолучитьУникальноеИмяВКоллекции(СтрПоиска,Коллекция,сРазделитель = "", Знач Приращение = 1, Вложенные = Истина) Экспорт
	Результат 	= "";
	Найденные	= Новый Массив;
	Если ТипЗнч(Коллекция) = Тип("ДанныеФормыКоллекцияЭлементовДерева") Тогда
		Найденные = ОбщегоНазначенияКлиентСервер_Ei.НайтиВКоллекцииДерева(СтрПоиска,Коллекция,Вложенные);
	ИначеЕсли ТипЗнч(Коллекция) = Тип("ЭлементыГрафическойСхемы") Тогда
		Найденные = Новый Массив;
		Для Каждого ЭлПоиска ИЗ СтрПоиска Цикл
			РезультатПоиска = Коллекция.Найти(ЭлПоиска.Значение);
			Если Не РезультатПоиска = Неопределено Тогда
				Найденные.Добавить(РезультатПоиска);
			КонецЕсли;
			Прервать;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Коллекция) = Тип("ДанныеФормыКоллекция") Тогда
		Найденные = Коллекция.НайтиСтроки(СтрПоиска);
	КонецЕсли;
	Для Каждого ЭлПоиска ИЗ СтрПоиска Цикл
		Если Не Найденные.Количество() Тогда
			Результат = ЭлПоиска.Значение;
		Иначе
			//имя не уникально
			чОкончание = ВыделитьЧисловоеОкончание(ЭлПоиска.Значение,сРазделитель);
			Если ЗначениеЗаполнено(чОкончание) Тогда
				СтрПоиска[ЭлПоиска.Ключ] = СтрЗаменить(ЭлПоиска.Значение,сРазделитель+Формат(чОкончание,"ЧН=0; ЧГ="),сРазделитель+Формат(чОкончание+Приращение,"ЧН=0; ЧГ="));	
			Иначе
				СтрПоиска[ЭлПоиска.Ключ] = ЭлПоиска.Значение+сРазделитель+Формат(Приращение,"ЧН=0; ЧГ=");
			КонецЕсли;
			Результат 	= вПолучитьУникальноеИмяВКоллекции(СтрПоиска,Коллекция,сРазделитель,Приращение,Вложенные);	
		КонецЕсли;
		Прервать;
	КонецЦикла;	
	Возврат Результат;
КонецФункции


// Вызывается обработчиком оповещения из
// См. ВыборКлиент_Ei.ПараметрыСтроки
// 
// Параметры:
//  Результат 		- Неопределено - Возвращаемый параметр
//  ДопПараметры 	- Структура - Задается в см. ОО_Клиент:	
//						*Аргументы	- Строка 
Процедура ОО_История(Результат, ДопПараметры) Экспорт
	Результат = ПолучитьИсторию();
КонецПроцедуры

// Вызывается обработчиком оповещения из
// См. ВыборКлиент_Ei.ПараметрыСтроки
// 
// Параметры:
//  Результат 		- Неопределено - Возвращаемый параметр
//  ДопПараметры 	- Структура - Задается в см. ОО_Клиент:	
//						*Аргументы	- Строка 
Процедура ОО_Избранное(Результат, ДопПараметры) Экспорт
	Результат = ПолучитьИзбранное();
КонецПроцедуры

// Вызывается обработчиком оповещения из
// См. ВыборКлиент_Ei.ПараметрыСтроки
// 
// Параметры:
//  Результат 		- Неопределено - Возвращаемый параметр
//  ДопПараметры 	- Структура - Задается в см. ОО_Клиент:	
//						*Аргументы	- Строка 
Процедура ОО_Формы(Результат, ДопПараметры) Экспорт
	Результат = ПолучитьОткрытыеФормы();	
КонецПроцедуры

// Получить открытые формы.
// 
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение:
//		*Ключ - Строка - Уникальный идентифкатор формы
//		*Значение - Форма 
Функция ПолучитьОткрытыеФормы() Экспорт
	Результат = Новый Соответствие();
	Для каждого ОкноПриложения Из ПолучитьОкна() Цикл
		Для Каждого Форма из ОкноПриложения.Содержимое Цикл
			Результат.Вставить(Строка(Форма.УникальныйИдентификатор),Форма);			
		КонецЦикла;	
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Вызывается обработчиком оповещения из
// См. ВыборКлиент_Ei.ПараметрыСтроки
// 
// Параметры:
//  Результат 		- Неопределено - Возвращаемый параметр
//  ДопПараметры 	- Структура - Задается в см. ВыборКлиент_Ei.ПолучитьСвойстваЗначения:	
//						*Аргументы				- Строка
//						*УникальныйИдентификатор- Строка - Уникальный идентифкатор открытой формы 
Процедура ОО_Реквизиты(Результат, ДопПараметры) Экспорт
	Результат = ОбщегоНазначенияВызовСервера_Ei.Реквизиты(ДопПараметры.УникальныйИдентификатор);
КонецПроцедуры


// Вызывается обработчиком оповещения из
// См. ВыборКлиент_Ei.ПараметрыСтроки
// 
// Параметры:
//  Результат 		- Неопределено - Возвращаемый параметр
//  ДопПараметры 	- Структура - Задается в см. ВариантыКлиент_Ei.ПолучитьСтруктуруДоступныхПеременных:	
//						*Аргументы	- Строка 
Процедура ОО_Клиент(Результат, ДопПараметры) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("История",	Новый ОписаниеОповещения("ОО_История",	ОбщегоНазначенияКлиент_Ei,Новый Структура("Аргументы",ВыборКлиент_Ei.ОкончаниеФункции())));
	Результат.Вставить("Избранное",	Новый ОписаниеОповещения("ОО_Избранное",ОбщегоНазначенияКлиент_Ei,Новый Структура("Аргументы",ВыборКлиент_Ei.ОкончаниеФункции())));
	Результат.Вставить("Формы",		Новый ОписаниеОповещения("ОО_Формы",	ОбщегоНазначенияКлиент_Ei,Новый Структура("Аргументы",ВыборКлиент_Ei.ОкончаниеФункции())));
КонецПроцедуры



// Функция - ссылок открытых пользователем за последние 24 часа, удобно использовать в анализе
// 
// Возвращаемое значение:
//   - СписокЗначений из ЛюбаяСсылка 
//   - Соответствие из КлючИЗначение:
//   	*Ключ 		- Строка - Нав ссылка
//   	*Значение	- Произвольный 
Функция ПолучитьИсторию() Экспорт
	Результат 		= Новый Соответствие();
	Результат 		= Новый СписокЗначений(); //Выводим в СЗ для сохранени порядка
	ПоследняяДата  	= Неопределено;
	Попытка
		//Возврат Результат; // исключение не перехватывается 
		История =  ИсторияРаботыПользователя.Получить();
	Исключение
		//если в истории были элемент ВИД к которому нет подключение, возможна ошибка
		//странно что в избранном нет такой темы
		Возврат Результат;	
	КонецПопытки;		
	Для Каждого ЭлИстории ИЗ История Цикл
		Если Не ПоследняяДата = Неопределено Тогда
			Если Не ЭлИстории.Дата > (ПоследняяДата-24*60*60) Тогда  // за полседние 24 часа
				Прервать;
			КонецЕсли;
		КонецЕсли;
		Попытка
			Ссылка = ОбщегоНазначенияВызовСервера_Ei.ПолучитьСсылкуИзНавСсылки(ЭлИстории.НавигационнаяСсылка);
			Если ЗначениеЗаполнено(Ссылка) Тогда
				Если ТипЗнч(Результат) = Тип("Соответствие") Тогда
					Результат.Вставить(ЭлИстории.НавигационнаяСсылка,Ссылка);
				ИначеЕсли  ТипЗнч(Результат) = Тип("СписокЗначений") Тогда
					Если Результат.НайтиПоЗначению(Ссылка) = Неопределено Тогда //чтобы не дублировать поищем
						Результат.Добавить(Ссылка,СтрШаблон("%1: %2",Формат(ЭлИстории.Дата,"ДЛФ=T;"),ЭлИстории.НавигационнаяСсылка));
					КонецЕсли;		
				Иначе
					//возможно массив
					Результат.Добавить(Ссылка);							
				КонецЕсли;
				ПоследняяДата = ?(ПоследняяДата = Неопределено,ЭлИстории.Дата,ПоследняяДата);
			КонецЕсли;		
		Исключение
			//могут навигационные сссылки типа http:\\
			Продолжить;
		КонецПопытки;	
	КонецЦикла;
	Возврат Результат; 
КонецФункции

// Функция - ссылок открытых пользователем за последние 24 часа, удобно использовать в анализе
// 
// Возвращаемое значение:
//   Соответствие из КлючИЗначение
//   	*Ключ 		- Строка - Нав ссылка
//   	*Значение	- Произвольный 
Функция ПолучитьИзбранное() Экспорт
	Результат 		= Новый Соответствие();
	ПоследняяДата  	= Неопределено;
	Для Каждого НавСсылка ИЗ ВыборВызовСервера_Ei.ПолучитьИзбранное() Цикл
		Попытка
			Ссылка = ОбщегоНазначенияВызовСервера_Ei.ПолучитьСсылкуИзНавСсылки(НавСсылка);
			Если ЗначениеЗаполнено(Ссылка) Тогда
				Результат.Вставить(НавСсылка,Ссылка);
			КонецЕсли;
		Исключение
			//могут навигационные сссылки типа http:\\
			Продолжить;
		КонецПопытки;	
	КонецЦикла;
	Возврат Результат; 
КонецФункции	

Процедура АктуализироватьСтраницу(Контейнер,ИмяСтраницы) Экспорт
	Если ЗначениеЗаполнено(ИмяСтраницы) Тогда
		НайденаяСтраница = Контейнер.ПодчиненныеЭлементы.Найти(ИмяСтраницы);
		Если Не НайденаяСтраница = Неопределено Тогда
			Контейнер.ТекущаяСтраница = НайденаяСтраница;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	

// Формирует дополнительную структуру параметров для формы выбора типа
//
// Параметры:
//  ТД	 - ДанныеФормыЭлементДерева	 - или ДанныеФормыЭлементКоллекции  в зависимости от того откуда происходит вызов 
// 
// Возвращаемое значение:
//   Структура:
//		*ТекущиеДанные - Структура:
//			**ИмяПараметра
//			**ЗначениеПараметра
//			**ЭтоВыражение
//			**Идентификатор
//		*ДоступныеСтруктуры см.ВариантыКлиент_Ei.ПолучитьСтруктуруДоступныхПеременных
Функция ПолучитьСтруктуруПеременных(Форма, ТД, ЗначениеПараметра = Неопределено, ИспИсторию = Истина, ИспНаборы = Истина, ИспПараметры = Истина) Экспорт 
	СтрТекущиеДанные	= Новый Структура("ЭтоВыражение,ЗначениеПараметра,ИмяПараметра",Истина,ЗначениеПараметра);
	Если Не ТД = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(СтрТекущиеДанные,ТД); 
	КонецЕсли;
	СтруктураПеременных	= Новый Структура();
	СтруктураПеременных.Вставить("ТекущиеДанные",СтрТекущиеДанные);
	СтруктураПеременных.Вставить("ДоступныеСтруктуры",ВариантыКлиент_Ei.ПолучитьСтруктуруДоступныхПеременных(Форма,Форма.ПолучитьПереопределяемыйОбъектОбработки(),ИспИсторию,ИспНаборы,ИспПараметры));	
	Возврат СтруктураПеременных; 	
КонецФункции

// Получаем все свойства объекта данных на основе таблицы результатов запроса
//
// Параметры:
//  Объект	 					- Произвольный	- 	Объект данных, свойства которого необходимо получить
//  УникальныйИдентификатор	 	- УникальныйИдентифкатор	 - Уникальный идентифкатор формы, используется для формирования описания значения, если не указан то табличные части и таблицы значений в объекте игнорируются
//
// 
// Возвращаемое значение:
//   - СписокЗначений Список значений со структурой  ОписаниеТипов,Значение
//
Функция вПолучитьСвойстваОбъектаМетаданных(Объект,УникальныйИдентификатор = Неопределено) Экспорт
	СписокСвойств	= Новый СписокЗначений;
	Если Не Объект = Неопределено Тогда
		ОписаниеЗначения 	= ОбщегоНазначенияКлиентСервер_Ei.ПолучитьОписаниеМетаданных(ТипЗнч(Объект));
		ПолноеИмяДляЗапроса	= ОписаниеЗначения.ТипДляЗапроса+"."+ОписаниеЗначения.ПолноеИмя;
		СобытиеОтладки 	= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Получение свойств объекта метаданных "+ПолноеИмяДляЗапроса,"Объекты БД");
		Попытка
			ТекстЗапроса 		= "ВЫБРАТЬ ПЕРВЫЕ 0 _Т.* ИЗ "+ПолноеИмяДляЗапроса+" КАК _Т";    //Кудяков Г.А.  28 февраля 2013 г. 11:30:18 Issue 40
			АдресКеша			= ВыполнитьКлиентСервер_Ei.Запрос(ТекстЗапроса,Неопределено); // тут уникальный идентификатор не передаем, потому что расчитываем на возврат именно адреса Кеша					
			СписокСвойств		= ОбщегоНазначенияВызовСервера_Ei.вСформироватьСписокПоСтруктуреКолонок(АдресКеша,Объект,УникальныйИдентификатор);
		Исключение
			ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке());
			//ВызватьИсключение "Не удалось получить свойства";
		КонецПопытки;
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	КонецЕсли;	
	Возврат СписокСвойств
КонецФункции

// Получает форматированное время 00:00:00
// 
// Параметры:
//  Значение - Число - Число мили.секунд, которые нужно показать пользователю
// 
// Возвращаемое значение:
//  Строка 
Функция ФорматироватьВремя(Знач Значение) Экспорт
	Результат   = "";
	Множитель 	= 1000;
	СтрФормата	= "ЧЦ=2; ЧН=00; ЧВН=";
	Если Значение>60*Множитель Тогда 
		//переведем только в минуты 		
		//десятый секунды в данном случае ни к чему
		Значение	= Окр(Значение/Множитель);
		Минуты		= Цел(Значение/60);
 		Результат	= СтрШаблон("%1:%2",Формат(Минуты,стрФормата),Формат(Значение-Минуты*60,стрФормата));
		Если Значение>3600 Тогда
			//переведем  в часы и  минуты 		
			//десятый секунды в данном случае ни к чему
			Часы		= Цел(Минуты/60);
			Результат	= СтрШаблон("%1:%2:%3",Формат(Часы,стрФормата),Формат(Минуты-Часы*60,стрФормата),Формат(Значение-Минуты*60,стрФормата));
			Если Значение>3600*24 Тогда
				//переведем в дни, секунды в даноом случае ни к чему
				Дни			= Цел(Часы/24);
				Результат	= СтрШаблон("%1д. %2:%3",Дни,Формат(Часы-Дни*24,стрФормата),Формат(Минуты-Часы*60,стрФормата));
			КонецЕсли;	
		КонецЕсли;	  
	Иначе 
	    Результат   = СтрШаблон("%1 сек.",Значение/Множитель);
	КонецЕсли;
	Возврат Результат 
КонецФункции

// Удаляет пустые строки из под строки дерева значений, необходимо для динамического формирования дерева
// 
// Параметры:
//  СтрокаДЗ 	- ДанныеФормыЭлементДерева - Строка родитель
//  ИмяКолонки 	- Строка - Имя колонки
// 
// Возвращаемое значение:
//  Число - Коло-во удаленных строк
Функция УдалитьПустыеСтроки(СтрокаДЗ,ИмяКолонки = "Представление") Экспорт
	УдалилиСтрок	= 0; 
	мУдаления 		= Новый Массив;
	Для Каждого ПодСтрока ИЗ СтрокаДЗ.ПолучитьЭлементы() Цикл
		Если Не ЗначениеЗаполнено(ПодСтрока[ИмяКолонки]) Тогда
			мУдаления.Добавить(ПодСтрока);
		КонецЕсли;
	КонецЦикла;
	УдалилиСтрок 	= мУдаления.Количество();
	Для Каждого Подстрока ИЗ мУдаления Цикл
		СтрокаДЗ.ПолучитьЭлементы().Удалить(Подстрока);		
	КонецЦикла;	
	Возврат УдалилиСтрок;
КонецФункции


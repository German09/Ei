Функция ПолучитьОбращение(ОписаниеЗначения)		
	Возврат ОписаниеЗначения.Тип+"."+СтрЗаменить(ОписаниеЗначения.ПолноеИмя,".Таблица.",".Таблицы."); //Замена для внешних истоников данных	
КонецФункции

// Получаем все свойства объекта данных на основе таблицы результатов запроса
//
// Параметры:
//  Объект	 					- Произвольный	- 	Объект данных, свойства которого необходимо получить
//  УникальныйИдентификатор	 	- УникальныйИдентифкатор	 - Уникальный идентифкатор формы, используется для формирования описания значения, если не указан то табличные части и таблицы значений в объекте игнорируются
//
// 
// Возвращаемое значение:
//   - СписокЗначений Список значений со структурой  ОписаниеТипов,Значение
//
Функция вПолучитьСвойстваОбъектаМетаданных(Объект,УникальныйИдентификатор = Неопределено) Экспорт
	СписокСвойств	= Новый СписокЗначений;
	Если Не Объект = Неопределено Тогда
		ОписаниеЗначения 	= ПеречисленияКлиентСерверПовторноеИспользование_Ei.ПолучитьОписаниеМетаданных(Объект);
		ПолноеИмяДляЗапроса	= ОписаниеЗначения.ТипДляЗапроса+"."+ОписаниеЗначения.ПолноеИмя;
		СобытиеОтладки 	= ОтладкаКлиент_Ei.ДобавитьСобытие("Получение свойств объекта метаданных "+ПолноеИмяДляЗапроса,"Объекты БД");
		Попытка
			ТекстЗапроса 		= "ВЫБРАТЬ ПЕРВЫЕ 0 _Т.* ИЗ "+ПолноеИмяДляЗапроса+" КАК _Т";    //Кудяков Г.А.  28 февраля 2013 г. 11:30:18 Issue 40
			АдресКеша			= ОбщийМодульКлиент_Ei.вВыполнитьЗапрос(ТекстЗапроса,Новый Структура,Неопределено); // тут уникальный идентификатор не передаем, потому что расчитываем на возврат именно адреса Кеша					
			СписокСвойств		= ОбщийМодульВызовСервера_Ei.вСформироватьСписокПоСтруктуреКолонок(АдресКеша,Объект,УникальныйИдентификатор);
		Исключение
			ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке());
			//ВызватьИсключение "Не удалось получить свойства";
		КонецПопытки;
		ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
	КонецЕсли;	
	Возврат СписокСвойств
КонецФункции

// Получаем все свойства объекта данных на основе таблицы результатов запроса
//
// Параметры:
//  Объект	 - 	Произвольный 	Объект данных, свойства которого необходимо получить
// 
// Возвращаемое значение:
//   - Соответсвие значений с именами/функциями свойств
//
Функция вПолучитьСвойстваОбъекта(Объект) 
	Результат = Новый Соответствие;
	Для Каждого ЭлСЗ ИЗ вПолучитьСвойстваОбъектаМетаданных(Объект) Цикл
		Результат.Вставить(ЭлСЗ.Представление,ЭлСЗ.Значение);		
	КонецЦикла;	
	Возврат Результат; 
КонецФункции	

//Формирует строковое описание типа
//Параметры:
//	Значение - <Тип>. Тип значения
//Возвращаемое значение:
//	Строка представление типа
Функция вТипВСтроку(Значение) Экспорт
	Результат =  "";
	Если ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки().СодержитТип(Значение) Тогда
		//тут нужно поменять на
		отЗначение 			= ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(Значение);
		ОписаниеЗначения 	= ПеречисленияКлиентСерверПовторноеИспользование_Ei.ПолучитьОписаниеМетаданных(отЗначение.ПривестиЗначение(Неопределено));
		Если Не ОписаниеЗначения = Неопределено Тогда
			Результат = ОписаниеЗначения.ТипДляЗапроса+"Ссылка."+ОписаниеЗначения.ПолноеИмя;					
		КонецЕсли;
	Иначе
		Результат = ОбщийМодульКлиентСервер_Ei.вВрегПослеПробела(Строка(Значение));
	КонецЕсли;
	Возврат Результат;
КонецФункции


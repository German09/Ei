																												ЭлементСписка,
																												ЭлементСписка.Значение))+");
				|";	
			КонецЦикла;
			ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
			Возврат ВыражениеСписка;
		ИначеЕсли ТипЗнч(Значение)=Тип("ОписаниеТипов") Тогда
			Если Значение.Типы().Количество()>1 Тогда
				ВыражениеСписка="МассивТипов	= Новый Массив;";
				Для каждого Тип из Значение.Типы() Цикл
					ВыражениеСписка=ВыражениеСписка+Символы.ПС+"МассивТипов.Добавить("+ПреобразоватьЗначениеКВыражению(Тип)+");";	
				КонецЦикла;
				ВыражениеСписка=ВыражениеСписка+Символы.ПС+ПеречисленияКлиентСерверПовторноеИспользование_Ei.РезультатРавно()+" Новый ОписаниеТипов(МассивТипов);";

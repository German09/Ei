//Получает струтуру параметров, конструктора или отбора трассировки 
//Параметры:
//	ТабПараметров		- <ТаблицаЗначений>. Таблица параметров
//	МассивИсключений	- <Массив>. Массив ссылок на строки таблицы, которые не должны попасть в итоговую структуру (применяется для вычисляемых параметров)
//Возвращаемое значение:
// <Структура значений>
Функция вПолучитьСтруктуруПараметров(ТабПараметров,УникальныйИдентификатор, Знач МассивИсключений=Неопределено, ЭтаФорма = Неопределено) Экспорт
	Параметры = Новый Структура;
	СобытиеОтладки=ОтладкаКлиент_Ei.ДобавитьСобытие("Получение структуры параметров");
	Попытка
		Если МассивИсключений=Неопределено Тогда
			МассивИсключений=Новый Массив;
		КонецЕсли;
		Для каждого СтрокаПараметров Из ТабПараметров Цикл
			//ОбработкаПрерыванияПользователя();
			СтрокаИсключение=МассивИсключений.Найти(СтрокаПараметров);
			Если Не СтрокаИсключение=Неопределено Тогда
				Продолжить;
			КонецЕсли;	
			СобытиеОтладки_Параметр=ОтладкаКлиент_Ei.ДобавитьСобытие(?(СтрокаПараметров.ЭтоВыражение,"Вычисление","Получение")+" параметра """+СтрокаПараметров.ИмяПараметра+"""",,СобытиеОтладки);
			Попытка
				ИмяПараметра=СтрЗаменить(СтрокаПараметров.ИмяПараметра,"@",""); //этот символ недоспутим в имени структуры но в SQL необходим
				Если Не ПустаяСтрока(ИмяПараметра) Тогда
					//вначале проверяем корректность имени
					Попытка
						Параметры.Вставить(ИмяПараметра);
					Исключение
						ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки_Параметр,"Информация","Неправильно задано имя параметра, или присутсвуют недоспустимые символы, параметр """+СтрокаПараметров.ИмяПараметра+""" не добавлен");
						Продолжить;
					КонецПопытки;
					//теперь добавляем параметр со значением
					Если СтрокаПараметров.ЭтоВыражение И ТипЗнч(СтрокаПараметров.ЗначениеПараметра)=Тип("Строка") Тогда
						МассивИсключений.Добавить(СтрокаПараметров);
						ОгрПараметры		= вПолучитьСтруктуруПараметров(ТабПараметров,УникальныйИдентификатор,МассивИсключений);	
						КонтекстВыполнения	= Новый Структура("Параметры,ЭтаФорма",ОгрПараметры,ЭтаФорма);
						ОписаниеЗначения	= ОбщийМодульКлиент_Ei.__ВычислитьЗначение(СтрокаПараметров.ЗначениеПараметра,УникальныйИдентификатор,,КонтекстВыполнения);
						Попытка
							Параметры.Вставить(ИмяПараметра,ПолучитьИзВременногоХранилища(ОписаниеЗначения.Ссылка));
						Исключение
							//это значение не можем хранить таскать по клиенту
							Параметры.Вставить(ИмяПараметра,ОписаниеЗначения.Ссылка);
						КонецПопытки;	
						//Дополним ранее расчитанными параметрами
						Для Каждого ВложенныйПараметр ИЗ ОгрПараметры Цикл
							Параметры.Вставить(ВложенныйПараметр.Ключ,ВложенныйПараметр.Значение);		
						КонецЦикла;	
					Иначе	
						Параметры.Вставить(ИмяПараметра,СтрокаПараметров.ЗначениеПараметра);
					КонецЕсли;
				КонецЕсли;
			Исключение
				ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки_Параметр,"Информация","Параметр """+СтрокаПараметров.ИмяПараметра+""" пропущен "+ИнформацияОбОшибке());
				//ВызватьИсключение  "Не удалось "+?(СтрокаПараметров.ЭтоВыражение,"вычислить","получить")+" параметр "+ИнформацияОбОшибке().Описание;
			КонецПопытки;
			ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки_Параметр);
		КонецЦикла;
	Исключение
		ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке());
		ВызватьИсключение  "Не удалось получить структуру параметров "+ИнформацияОбОшибке().Описание;
	КонецПопытки;
	ОтладкаКлиент_Ei.ЗавершитьСобытие(СобытиеОтладки);
	Возврат Параметры;
КонецФункции

//Формирует представление встроенного языка, для вывода отладочных сообщений
//Параметры:
//	СлужебныеДанные		- <Структура>. Данные определяюшие вычсление(выполнение) значения:(Выражение,ОписаниеТипов)
//	ДоступныеПеременные - <Структура>. Структура доступныех переменных
Функция вПолучитьОписаниеВыражения(СлужебныеДанные,ДоступныеПеременные) Экспорт
	СообщениеОтладки	= "Вычисление выражения на встроенном языке: "+Символы.ПС+Символы.Таб+СлужебныеДанные.Выражение;
	СообщениеОтладки    = СообщениеОтладки+Символы.ПС+"Доступные переменные:";	
	Для Каждого Переменная Из ДоступныеПеременные Цикл
		Если Не Переменная.Значение=Неопределено Тогда
			СообщениеОтладки	= СообщениеОтладки+Символы.ПС+Символы.Таб+Переменная.Ключ+"		-	"+Переменная.Значение;		
		КонецЕсли;
	КонецЦикла;
	Если СлужебныеДанные.Свойство("ОписаниеТипов") Тогда
		СообщениеОтладки	= СообщениеОтладки+Символы.ПС+"Результат, вычисление преобразуется к типу: "+СлужебныеДанные.ОписаниеТипов;
	КонецЕсли;
	Возврат СообщениеОтладки; 
КонецФункции

//возврашает форматированное время 00:00:00
//Параметры
//	Значение	- <число> Число мили.секунд, которые нужно показать пользователю	
Функция вФорматироватьВремя(Значение) Экспорт
	Если Значение>3600*24*1000 Тогда
		//переведем в дни секунды в даноом случае никчему
		Значение	= Окр(Значение);
		Минуты		= Цел(Значение/60);
		Часы		= Цел(Минуты/60);
		Дни			= Цел(Часы/24);
		Результат	= ""+Дни+"д. "+Формат(Часы-Дни*24,"ЧЦ=2; ЧН=00; ЧВН=")+":"+Формат(Минуты-Часы*60,"ЧЦ=2; ЧН=00; ЧВН=");
	ИначеЕсли Значение>3600*1000 Тогда
		//переведем  в часы и  минуты 		
		//десятый секунды в данном случае никчему 
		Значение	= Окр(Значение);
		Минуты		= Цел(Значение/60);
		Часы		= Цел(Минуты/60);
		Результат	= ""+Формат(Часы,"ЧЦ=2; ЧН=00; ЧВН=")+":"+Формат(Минуты-Часы*60,"ЧЦ=2; ЧН=00; ЧВН=")+":"+Формат(Значение-Минуты*60,"ЧЦ=2; ЧН=00; ЧВН=");
	ИначеЕсли Значение>60*1000 Тогда 
		//переведем только в минуты 		
		//десятый секунды в данном случае никчему
		Значение	= Окр(Значение);
		Минуты		= Цел(Значение/60);
		Результат	= ""+Формат(Минуты,"ЧЦ=2; ЧН=00; ЧВН=")+":"+Формат(Значение-Минуты*60,"ЧЦ=2; ЧН=00; ЧВН=");
	Иначе 
	    Результат   = ""+Значение/1000+" сек.";
	КонецЕсли;
	Возврат Результат 
КонецФункции

// Функция - Получить имя (как в метаданных) 1 типа значения в опсианиии типов
//
// Параметры:
//  ОписаниеТипов	 - Описание Типов	 - 
// 
// Возвращаемое значение:
//   - Строка. Имя объекта метаданных.
//
Функция ПолучитьИмяОписанияТипов(ОписаниеТипов) Экспорт
	Результат =  "";
	Если ОписаниеТипов.Типы().Количество() Тогда 
		мЛокальногоИмени 	= СтрРазделить(СериализаторXDTO.ЗаписатьXDTO(ОписаниеТипов).Type[0].ЛокальноеИмя,".");
		Результат 			= мЛокальногоИмени[мЛокальногоИмени.ВГраница()]; 	
	КонецЕсли;
	Возврат Результат;
КонецФункции


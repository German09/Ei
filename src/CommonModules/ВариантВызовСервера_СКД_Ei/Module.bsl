Процедура УстановитьПараметры(Форма, ДеревоЗапросовИД) Экспорт
	ТД = Форма.ДеревоЗапросов.НайтиПоИдентификатору(ДеревоЗапросовИД);
	Если Не ТД = Неопределено Тогда
		СКД = ОбщийМодульКлиентСервер_Ei.Структурировать(ТД.ТекстСКД,Новый СхемаКомпоновкиДанных);
		Для Каждого ПараметрКомпановки из СКД.Параметры Цикл
			ПараметрыКлиентСервер_Ei.ДобавитьПараметр(ТД,ПараметрКомпановки);
		КонецЦикла;	
	КонецЕсли;		

//
Функция Примитивные() Экспорт
	мТипов = Новый Массив;
	мТипов.Добавить(Тип("Null"));
	мТипов.Добавить(Тип("Неопределено"));
	мТипов.Добавить(Тип("Число"));
	мТипов.Добавить(Тип("Строка"));
	мТипов.Добавить(Тип("Дата"));
	мТипов.Добавить(Тип("Тип"));
	мТипов.Добавить(Тип("Булево"));
	мТипов.Добавить(Тип("УникальныйИдентификатор"));
	Возврат мТипов;	
КонецФункции


//Определяет схожесть двух объектов описание типов
//Параметры:
//	ОТипов1	-ОписаниеТипов.
//	ОТипов2	-ОписаниеТипов.	
//Возвращаемое значение:  
//	Булево - В описаниях есть одинаковые Типы
//
Функция ОписанияПересекаются(ОТипов1,ОТипов2) Экспорт
	Если ТипЗнч(ОТипов1) = Тип("ОписаниеТипов") Тогда
		ИсходноеКолвоТипов	= ОТипов1.Типы().Количество();
	Иначе
		ИсходноеКолвоТипов	= 0;
	КонецЕсли;
	
	Если ИсходноеКолвоТипов Тогда
		ИсклТипов 	= ОТипов2.Типы();
		Если ИсклТипов.Количество()=1 Тогда
			Возврат  ОТипов1.СодержитТип(ИсклТипов[0]);
		Иначе
			ОТипов				= Новый ОписаниеТипов(ОТипов1,ИсклТипов);  //складываем типы
			Возврат (ИсходноеКолвоТипов+ИсклТипов.Количество()>ОТипов.Типы().Количество());
		КонецЕсли;	
	Иначе
		Возврат Ложь;
	КонецЕсли;	
КонецФункции

// Функция - Получить имя описания типов
// Например:
// {http://v8.1c.ru/8.1/data/core}ValueTable
// {http://v8.1c.ru/8.1/data/enterprise/current-config}CatalogRef.Справочник1
// {http://v8.1c.ru/8.1/data/enterprise/current-config}ExternalDataSourceTableRef.PAS.BASEDOC
// 	
//
// Параметры:
//  ОписаниеТипов	 - ОписаниеТипов - Строка описания типов
//  ДляЧеловека		 - Булево - Если Истина тогда возвращает представление для человека, иначе для обратного преобразования см. ПроверитьОписание
//		
// 
// Возвращаемое значение:
//   Строка - 	Если ДляЧеловека 	ValueTable,Справочник1,PAS.BASEDOС
//				Если ДляПрограммы  	ValueTable,CatalogRef.Справочник1,ExternalDataSourceTableRef.PAS.BASEDOC
//
Функция ПолучитьИмяОписанияТипов(ОписаниеТипов, ДляЧеловека = Истина) Экспорт
	Результат =  Новый Массив;
	Типы = ОписаниеТипов.Типы();
	Если Типы.Количество() Тогда
		ОбъектXDTO =  СериализаторXDTO.ЗаписатьXDTO(ОписаниеТипов); 
		//На клиенте и на сервере разные результаты сериализации
		//на Севере только свойство Тype 
		//на Клиенте к Тype еще TypeSet для ВИД и TуpeID для типов недостпных на клиенте - не ожидаем что решим получить их Имена
		Для Каждого Свойство ИЗ СтрРазделить("Type,TypeSet",",") Цикл
			Для Каждого Тип ИЗ ОбъектXDTO[Свойство] Цикл
				Точка = СтрНайти(Тип.ЛокальноеИмя,".");
				Если ДляЧеловека И Точка Тогда
					Результат.Добавить(Сред(Тип.ЛокальноеИмя,Точка+1));
				Иначе
					Результат.Добавить(СтрЗаменить(Тип.ЛокальноеИмя,"decimal","number"));
				КонецЕсли;	
			КонецЦикла;	
		КонецЦикла;			 	
	КонецЕсли;
	Возврат СтрСоединить(Результат,",");
КонецФункции

//Создает описание типов на сонове коллекциии с типами, или на основе единичного типа
//Параметры:
//	КоллекцияТипов	- Тип, Массив из Тип -  Колекция типов или одиночный тип.
//Возвращаемое значение:
//	ОписаниеТипов
//
Функция СоздатьОписаниеИзКолекции(КоллекцияТипов) Экспорт
	МассивТипов = Новый Массив;
	Если ТипЗнч(КоллекцияТипов)= Тип("Тип") Тогда
		МассивТипов.Добавить(КоллекцияТипов);		
	Иначе	
		Для каждого Типы из КоллекцияТипов Цикл
			МассивТипов.Добавить(Типы.Тип);	
		КонецЦикла;
	КонецЕсли;	
	Возврат Новый ОписаниеТипов(МассивТипов);
КонецФункции

//Функция - Получает переданное описание типов с клиента на сервер и обратно
//не все типы можно передать поэтому иногда строкой или массивм строк.  
//
// Параметры:
//  ВозможноОписаниеТипов	 - Строка, Массив из Строка,ОписаниеТипов	 - Значение которое необходимо модифицировать
// 
// Возвращаемое значение:
//   - ОписаниеТипов,Массив ИЗ Строка,Строка
//
Функция ПроверитьОписание(ВозможноОписаниеТипов) Экспорт
	Перем Результат;
	Попытка
		Если ТипЗнч(ВозможноОписаниеТипов) =  Тип("Строка") Тогда
			Результат = Новый ОписаниеТипов(ВозможноОписаниеТипов);
		ИначеЕсли ТипЗнч(ВозможноОписаниеТипов) =  Тип("Массив") Тогда	
			Результат = Новый ОписаниеТипов(СтрСоединить(ВозможноОписаниеТипов,","));
		Иначе
			Результат = ВозможноОписаниеТипов;
		КонецЕсли;
	Исключение
		//не все типы могут быть доступны на клиенте, если недоступны то это точно не примитивные типы
		Результат = ВозможноОписаниеТипов;
	КонецПопытки;		
	Возврат Результат;
КонецФункции

//Формирует строковое описание типа
//Параметры:
//	Значение - Тип- Тип значения
//Возвращаемое значение:
//	 - Строка - представление типа
Функция ВСтроку(Значение) Экспорт
	Результат =  "";
	Если ТипыКлиентСерверПовтИсп_Ei.ВсеСсылки().СодержитТип(Значение) Тогда
		ОписаниеЗначения 	= ОбщегоНазначенияКлиентСервер_Ei.ПолучитьОписаниеМетаданных(Значение);
		Если Не ОписаниеЗначения = Неопределено Тогда
			Результат = ОписаниеЗначения.ТипДляЗапроса+"Ссылка."+ОписаниеЗначения.ПолноеИмя;					
		КонецЕсли;
	Иначе
		Результат = ОбщегоНазначенияКлиентСервер_Ei.вВрегПослеПробела(Строка(Значение));
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Получить из ADO.
// 
// Параметры:
//  Field - ComОбъект
// 
// Возвращаемое значение:
//  ОписаниеТипов - Получить из ADO
Функция ПолучитьИзADO(Field) Экспорт
    Если Field.Type=129 Тогда
        Описание = Новый ОписаниеТипов("Строка,Null", , Новый КвалификаторыСтроки(Field.DefinedSize, ДопустимаяДлина.Фиксированная));
    ИначеЕсли Field.Type=14 или Field.Type=131 Тогда
        Описание = Новый ОписаниеТипов("Число,Null", Новый КвалификаторыЧисла(Field.Precision, Field.NumericScale));
    ИначеЕсли Field.Type=3 Тогда
        Описание = Новый ОписаниеТипов("Число,Null", Новый КвалификаторыЧисла(10, 0));
    ИначеЕсли Field.Type=200 Тогда
        Описание = Новый ОписаниеТипов("Строка,Null", , Новый КвалификаторыСтроки(Field.DefinedSize, ДопустимаяДлина.Переменная));
    ИначеЕсли Field.Type=16 Тогда
        Описание = Новый ОписаниеТипов("Число,Null", Новый КвалификаторыЧисла(3, 0));
    ИначеЕсли Field.Type=2 Тогда
        Описание = Новый ОписаниеТипов("Число,Null", Новый КвалификаторыЧисла(5, 0));
    ИначеЕсли Field.Type=11 Тогда
        Описание = Новый ОписаниеТипов("Булево,Null");
    ИначеЕсли Field.Type=135 Тогда
        Описание = Новый ОписаниеТипов("Дата,Null", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
    Иначе
        Описание = Новый ОписаниеТипов("");
    КонецЕсли;
    Возврат Описание;
КонецФункции

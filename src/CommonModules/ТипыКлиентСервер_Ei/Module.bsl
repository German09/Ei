// Получает универсальное строковое представление типа, которое можно преобразовывать в тип знч и обратно с помошью функции 
// См. ОбщегоНазначенияКлиентСервер_Ei.ПолучитьИмяТипЗнч
// 
// Возвращаемое значение:
//  Структура Из Строка
Функция Универсальные() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Запрос",					"Query");
	Результат.Вставить("ДинамическийСписок",		"DynamicList");
	Результат.Вставить("РезультатЗапроса",			"QueryResult");
	Результат.Вставить("ТаблицаЗначений",			"ValueTable");
	Результат.Вставить("ДеревоЗначений",			"ValueTree");
	Результат.Вставить("ТабличныйДокумент",			"SpreadsheetDocument");
	Результат.Вставить("Перечисления",				"EnumRef");
	Результат.Вставить("МакетКомпоновкиДанных",		"DataCompositionTemplate");
	Результат.Вставить("СписокЗначений",			"ValueList");
	Результат.Вставить("Соответствие",				"Map");
	Результат.Вставить("ФиксированноеСоответсвие",	"FixedMap");
	Результат.Вставить("Структура",					"Structure");
	Результат.Вставить("ФиксированняСтруктура",		"FixedStructure");
	Результат.Вставить("Массив",					"Array");
	Результат.Вставить("ФиксированныйМассив",		"FixedArray");
	Результат.Вставить("Строка",					"string"); // с !маленькой буквы, ВАЖНО
	Результат.Вставить("Отчеты",					"ReportObject");
	Результат.Вставить("ОбъектXDTO",				"XDTODataObject");
	Результат.Вставить("СписокXDTO",				"XDTOList");
	//@skip-check constructor-function-return-section
	Возврат Результат;
КонецФункции


#Область ИнтерфейсРезультатов

Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",			ТипыКлиентСервер_Ei.Универсальные().ДеревоЗначений);
	Результат.Вставить("Синоним",		"Дерево");
	Результат.Вставить("Картинка",		БиблиотекаКартинок.Дерево_Ei);
	Результат.Вставить("КартинкаСсылка",ПоместитьВоВременноеХранилище(Результат.Картинка,Новый УникальныйИдентификатор));
	Результат.Вставить("ИмяРеквизита",	"ДЗ");
	Результат.Вставить("ТипРеквизита",	ТипыКлиентСервер_Ei.Универсальные().ДеревоЗначений);
	Результат.Вставить("Типы",			Новый Массив); //поддерживаемые типы, помимо имени
		Результат.Типы.Добавить(ТипыКлиентСервер_Ei.Универсальные().РезультатЗапроса);
		Результат.Типы.Добавить(ТипыКлиентСервер_Ei.Универсальные().МакетКомпоновкиДанных);
	Возврат Результат;
КонецФункции

// Выполняется до выполнения варианта для данноготипа результата
// Варинат не всегда нужно выполнять для некоторых результатов, например в Динамическом списке, не нужно выполнять запрос
// 
// Параметры:
//  Вариант  - общий модуль - модуль варианта
//  ОписаниеЗначения - Описание значения - возвращаемый параметр, тут мы можем переопределить результат в зависимости от того как будем его отображать, если задуматся глубоко то ДС вообше не должно существовать
// 
// Возвращаемое значение:
//  Булево - Выполнять вариант или нет
Функция ПереопределитьВыполнение(УникальныйИдентификатор,ДопПараметры,Вариант,ОписаниеЗначения) Экспорт
	Возврат  РезультатыКлиентСервер_Ei.ВыполнятьВаринатПоУмолчанию();	
КонецФункции

Процедура ПослеЗагрузкиРезультата(Форма) Экспорт
	Возврат;	
КонецПроцедуры

#Если Сервер Тогда
	

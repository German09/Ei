Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",			ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ДеревоЗначений);
	Результат.Вставить("Синоним",		"Дерево");
	Результат.Вставить("Картинка",		БиблиотекаКартинок.ИерархическийСписок_Ei);
	Результат.Вставить("ИмяРеквизита",	"РезультатЗапросаДЗ");
	Возврат Результат;
КонецФункции


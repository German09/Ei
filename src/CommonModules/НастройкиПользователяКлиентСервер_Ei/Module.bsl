#Область ТекущийВариант

Функция ТекущийВариант(КлючНабора)
	Возврат ОбщегоНазначенияКлиентСервер_Ei.ИдентификаторВКлюч(КлючНабора,"Вариант");	
КонецФункции	

Функция ПолучитьТекущийВариант(НастройкиПользователя,КлючНабора) Экспорт
	Ключ 					= ТекущийВариант(КлючНабора); 
	Возврат ПользовательКлиентСервер_Ei.Получить(Ключ, НастройкиПользователя);	
КонецФункции	

Процедура СохранитьТекущийВариант(НастройкиПользователя,КлючНабора,ТекД) Экспорт
	Ключ 					= ТекущийВариант(КлючНабора);
	ПользовательКлиентСервер_Ei.Сохранить(Ключ, НастройкиПользователя, ТекД.КлючНастроек);
	//И в параметрах сеанса
	НаборВариантовВызовСервера_Ei.УстановитьТекущийНабор(ТекД.ИмяНабора); 		
КонецПроцедуры

#КонецОбласти

#Область ВнутрНастройкиОбработчиков

Функция КаталогИсходногоКода() Экспорт
	Возврат "КаталогИсходногоКода";	
КонецФункции	

Функция ПолучитьКаталогИсходногоКода(НастройкиПользователя) Экспорт
	Ключ 					= КаталогИсходногоКода();
	Возврат ПользовательКлиентСервер_Ei.Получить(Ключ, НастройкиПользователя);	
КонецФункции	

Процедура СохранитьКаталогИсходногоКода(НастройкиПользователя,Значение) Экспорт
	Ключ 					= КаталогИсходногоКода();
	ПользовательКлиентСервер_Ei.Сохранить(Ключ, НастройкиПользователя, Значение);
	//сохраняем дополнительно в настройки поскольку при получении см. НастройкиПользователяВызовСервера_Ei.ПолучитьКаталогИсходногоКода
	//нам не будет доступны данный вариант пользовательских настроек
	НастройкиПользователяВызовСервера_Ei.СохранитьКаталогИсходногоКода(Значение);		
КонецПроцедуры


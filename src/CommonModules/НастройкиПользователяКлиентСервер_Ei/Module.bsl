Процедура Проверить(Настройки) Экспорт
	Если Не ТипЗнч(Настройки) =  Тип("Структура") Тогда
		Настройки =  Новый Структура();
	КонецЕсли;			
КонецПроцедуры

Функция ПодготовитьКлючНастроек(ТД)	
	Возврат "_"+СтрЗаменить(ТД.КлючНастроек,"-","");
КонецФункции	

Функция Получить(Ключ,НастройкиПользователя) 
	Перем Результат;
	Проверить(НастройкиПользователя);
	НастройкиПользователя.Свойство(Ключ,Результат);
	Возврат Результат;		
КонецФункции

Процедура Сохранить(Ключ, НастройкиПользователя, Значение) 
	Проверить(НастройкиПользователя);
	НастройкиПользователя.Вставить(Ключ,Значение); 		
КонецПроцедуры

#Область ИмяТекущегоОбработчика

Функция ИмяТекущегоОбработчика(ТД,ВидОбработчика)
	Возврат "Текущий"+ВидОбработчика + ПодготовитьКлючНастроек(ТД);	
КонецФункции	

Функция ПолучитьИмяТекущегоОбработчика(ТД,НастройкиПользователя,ВидОбработчика) Экспорт
	Ключ = ИмяТекущегоОбработчика(ТД,ВидОбработчика); 
	Возврат Получить(Ключ, НастройкиПользователя);	
КонецФункции	

Процедура СохранитьИмяТекущегоОбработчика(ТД,НастройкиПользователя,ВидОбработчика,Значение) Экспорт
	Ключ = ИмяТекущегоОбработчика(ТД,ВидОбработчика);
	Сохранить(Ключ, НастройкиПользователя, Значение); 		
КонецПроцедуры

#КонецОбласти

#Область ВремяВыполнения

Функция ЗатраченноеВремя(ТД,Обработчик)
	Возврат "Время"+Обработчик.Свойства().Имя + ПодготовитьКлючНастроек(ТД);	
КонецФункции	

Функция ПолучитьЗатраченноеВремя(ТД,НастройкиПользователя,Обработчик) Экспорт
	Ключ = ЗатраченноеВремя(ТД,Обработчик); 
	Возврат Получить(Ключ, НастройкиПользователя);	
КонецФункции	

Процедура СохранитьЗатраченноеВремя(ТД,НастройкиПользователя,Обработчик,Значение) Экспорт
	Ключ = ЗатраченноеВремя(ТД,Обработчик);
	Сохранить(Ключ, НастройкиПользователя, Значение); 		
КонецПроцедуры

#КонецОбласти

#Область Размерность

Функция Размерность(ТД,Обработчик)
	Возврат "Размер"+Обработчик.Свойства().Имя + ПодготовитьКлючНастроек(ТД);	
КонецФункции	

Функция ПолучитьРазмерность(ТД,НастройкиПользователя,Обработчик) Экспорт
	Ключ = Размерность(ТД,Обработчик); 
	Возврат Получить(Ключ, НастройкиПользователя);	
КонецФункции	

Процедура СохранитьРазмерность(ТД,НастройкиПользователя,Обработчик,Значение) Экспорт
	Ключ = Размерность(ТД,Обработчик);
	Сохранить(Ключ, НастройкиПользователя, Значение); 		
КонецПроцедуры

#КонецОбласти


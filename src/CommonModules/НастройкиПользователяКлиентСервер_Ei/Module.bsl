#Область ТекущийВариант

Функция ТекущийВариант()
	Возврат "Вариант";	
КонецФункции	

Функция ПолучитьТекущийВариант(НастройкиПользователя) Экспорт
	Ключ = ТекущийВариант(); 
	Возврат ПользовательКлиентСервер_Ei.Получить(Ключ, НастройкиПользователя);	
КонецФункции	

Процедура СохранитьТекущийВариант(Форма,ТД) Экспорт
	Ключ 					= ТекущийВариант();
	НастройкиПользователя	= Форма.НастройкиПользователя;
	ПользовательКлиентСервер_Ei.Сохранить(Ключ, НастройкиПользователя, ТД.КлючНастроек);
	//И в параметрах сеанса
	ВариантыВызовСервера_Ei.ОбновитьВариант(ВариантыКлиентСервер_Ei.ПолучитьВариант(Форма,ТД)); 		
КонецПроцедуры


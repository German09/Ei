#Область ПоследниеНаборы

// Последние открытые и сохраненные наборы, первым - самый свежий
// 
// Параметры:
//  НастройкиПользователя - Структура, Неопределено
// 
// Возвращаемое значение:
//  Массив из Структура:
//  	* Каталог 	- Строка - папка проекта EDT
//  	* Имя 		- Строка - имя обработки в проекте, оно же имя корневого набора
Функция ПолучитьПоследниеНаборы(НастройкиПользователя) Экспорт
	Результат = ПользовательКлиентСервер_Ei.Получить("ПоследниеНаборы", НастройкиПользователя);
	Если Не ТипЗнч(Результат) = Тип("Массив") Тогда
		Результат = Новый Массив;
	КонецЕсли;
	Возврат Результат;
КонецФункции	

// Сохранить последние наборы.
// 
// Параметры:
//  НастройкиПользователя 	- Структура, Неопределено
//  Значение 				- см. ПолучитьПоследниеНаборы
Процедура СохранитьПоследниеНаборы(НастройкиПользователя, Значение) Экспорт
	ПользовательКлиентСервер_Ei.Сохранить("ПоследниеНаборы", НастройкиПользователя, Значение);
КонецПроцедуры

#КонецОбласти

#Область СтрокРезультата

// Сколько строк результата загружать в реквизит формы: весь результат остается во временном хранилище.
// Большая таблица в реквизите замедляет каждый серверный вызов формы, см. РезультатыСервер_Ei.ЗагрузитьРезультат
// 
// Параметры:
//  НастройкиПользователя - Структура, Неопределено
// 
// Возвращаемое значение:
//  Число - 0 - без ограничения
Функция ПолучитьСтрокРезультата(НастройкиПользователя) Экспорт
	Результат = ПользовательКлиентСервер_Ei.Получить("СтрокРезультата", НастройкиПользователя);
	Если Не ТипЗнч(Результат) = Тип("Число") Тогда
		Результат = СтрокРезультатаПоУмолчанию();
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Сохранить строк результата.
// 
// Параметры:
//  НастройкиПользователя 	- Структура, Неопределено
//  Значение 				- Число - 0 - без ограничения
Процедура СохранитьСтрокРезультата(НастройкиПользователя, Значение) Экспорт
	ПользовательКлиентСервер_Ei.Сохранить("СтрокРезультата", НастройкиПользователя, Значение);
КонецПроцедуры

// Строк результата по умолчанию.
// 
// Возвращаемое значение:
//  Число
Функция СтрокРезультатаПоУмолчанию() Экспорт
	Возврат 10000;
КонецФункции

// Сколько строк во всем результате, если в форму загружены не все, см. РезультатыСервер_Ei.ЗагрузитьРезультат
// 
// Параметры:
//  ТекД 					- ДанныеФормыЭлементДерева
//  НастройкиПользователя 	- Структура, Неопределено
//  Обработчик 				- ОбщийМодуль - обработчик результата
// 
// Возвращаемое значение:
//  Число, Неопределено - Неопределено, если загружен весь результат
Функция ПолучитьВсегоСтрокУсеченного(ТекД, НастройкиПользователя, Обработчик) Экспорт
	Ключ = ВсегоСтрокУсеченного(ТекД, Обработчик);
	Возврат ПользовательКлиентСервер_Ei.Получить(Ключ, НастройкиПользователя);
КонецФункции

// Сохранить всего строк усеченного.
// 
// Параметры:
//  ТекД 					- ДанныеФормыЭлементДерева
//  НастройкиПользователя 	- Структура, Неопределено
//  Обработчик 				- ОбщийМодуль - обработчик результата
//  Значение 				- Число, Неопределено - Неопределено, если загружен весь результат
Процедура СохранитьВсегоСтрокУсеченного(ТекД, НастройкиПользователя, Обработчик, Значение) Экспорт
	Ключ = ВсегоСтрокУсеченного(ТекД, Обработчик);
	ПользовательКлиентСервер_Ei.Сохранить(Ключ, НастройкиПользователя, Значение);
КонецПроцедуры

Функция ВсегоСтрокУсеченного(ТекД, Обработчик)
	Возврат "ВсегоСтрок" + Обработчик.Свойства().Имя + ПользовательКлиентСервер_Ei.ПодготовитьКлючНастроек(ТекД);
КонецФункции

#КонецОбласти
#КонецОбласти

Процедура Инициализация(Форма, Отказ, СтандартнаяОбработка) Экспорт
	//Получам саму коллекцию
	РеквизитКоллекции   = КоллекцияСтруктураКлиентСервер_Ei.РеквизитКоллекции();
	Коллекция 			= ОбщийМодульКлиентСервер_Ei.Структурировать(Форма.Параметры.Коллекция);	
	ПоказатьКоллекцию(Форма, Коллекция, РеквизитКоллекции);
	//Сохраним настройку для формы на основе коллекции 
	мКоллекцияИСостсав = КоллекцияРеквизитыСервер_Ei.ПолучитьКоллекциюИСостав(РеквизитКоллекции, Коллекция);
	Форма.Параметры.Настройка = ОбщийМодульКлиентСервер_Ei.Сериализовать(мКоллекцияИСостсав);
КонецПроцедуры

Процедура ПоказатьКоллекцию(Форма, Коллекция, РеквизитКоллекции)
	ВариантКоллекцияВызовСервера_Ei.Загрузить(Форма,Коллекция,РеквизитКоллекции, ,Форма.Элементы.Низ);
КонецПроцедуры

Процедура ИзменитьОбразецКоллекции(Форма,Знач мКоллекцияИСостсав) Экспорт
	//Меняем Коллекцию
	РеквизитКоллекции   = КоллекцияСтруктураКлиентСервер_Ei.РеквизитКоллекции();
	Коллекция 			= Форма.РеквизитФормыВЗначение(РеквизитКоллекции);
	Если ИзменитьКоллекцию(Коллекция,мКоллекцияИСостсав) Тогда
		//Меняем РеквизитыФормы
		//Удаляем и создаем новые элементы формы
		ПоказатьКоллекцию(Форма, Коллекция, РеквизитКоллекции);
	КонецЕсли;	
КонецПроцедуры


Функция ИзменитьКоллекцию(Коллекция,мКоллекцияИСостсав) Экспорт
	Изменено = Ложь;
	Для Каждого Состав ИЗ мКоллекцияИСостсав Цикл
		ИзменитьТипКоллекции(Коллекция,Состав.Колонка.ТипЗначения,Изменено);
		ИзменитьКолонкиКоллекции(Коллекция,Состав.мКолонки,Изменено);
		Прервать; //на первом уровне только б.д. одна строка
	КонецЦикла;	 
	Возврат Изменено;
КонецФункции

Процедура ИзменитьТипКоллекции(Коллекция,НовыйТип, Изменено)
	Если Не ТипЗнч(Коллекция) = Тип(НовыйТип) Тогда
		Если Тип(НовыйТип) = Тип("ТаблицаЗначений") Тогда
			Изменено = Истина;
			//Дерево в таблицу
			Коллекция =  РезультатТаблицаКлиентСервер_Ei.ПривестиРезультат(Коллекция);
		ИначеЕсли Тип(НовыйТип) = Тип("ДеревоЗначений") Тогда
			Изменено = Истина;
			//Таблица в дерево
			Коллекция =  РезультатДеревоКлиентСервер_Ei.ПривестиРезультат(Коллекция);		
		КонецЕсли;	 		
	КонецЕсли;		
КонецПроцедуры

Процедура ИзменитьКолонкиКоллекции(Коллекция,мКоллекцияИСостав,Изменено)
	//Добавляем или изменяем
	Для Каждого Состав ИЗ мКоллекцияИСостав Цикл
		Колонка = Состав.Колонка;
		КолонкаКоллекции = НайтиКолонкуВКоллекции(Коллекция,Колонка);
		Тип = ПроверитьОписание(Колонка.ТипЗначения);
		Если КолонкаКоллекции = Неопределено Тогда
			Изменено = Истина;
			КолонкаКоллекции = Коллекция.Колонки.Добавить(Колонка.Имя,Тип);
			Если ЗначениеЗаполнено(Колонка.ИмяОригинала) Тогда
				Коллекция.ЗагрузитьКолонку(Коллекция.ВыгрузитьКолонку(Колонка.ИмяОригинала),Колонка.Имя);	
			КонецЕсли;		
		ИначеЕсли Не СтрСравнить(КолонкаКоллекции.Имя,Колонка.Имя) = 0 Тогда
			Изменено = Истина;
			КолонкаКоллекции.Имя = Колонка.Имя;
		КонецЕсли;
		Если Не Тип = КолонкаКоллекции.ТипЗначения Тогда
			Изменено = Истина;
			ИзменитьТипКолонки(Коллекция,КолонкаКоллекции,Тип);		
		КонецЕсли;
		Если ТипыВызовСервера_Ei.ОписаниеВложеннойКоллекции(Тип) Тогда
			Для Каждого Строка ИЗ Коллекция Цикл
				ВложеннаяКоллекция = Строка[Колонка.Имя];
				ИзменитьКолонкиКоллекции(ВложеннаяКоллекция,Состав.мКолонки,Изменено);
				Если Не ВложеннаяКоллекция.Количество() Тогда
					//Добавим хотябы одну строку, а то даже не увидим ее на форме
					ВложеннаяКоллекция.Добавить();
				КонецЕсли;	
			КонецЦикла;			
		КонецЕсли;		  				
	КонецЦикла;	
	//Удаляем
	УдалитьКолонкиКоллекции(Коллекция.Колонки,мКоллекцияИСостав,Изменено);
	//Меняем порядок
	ИзменитьПорядокКолонокКоллекции(Коллекция.Колонки,мКоллекцияИСостав,Изменено);			
КонецПроцедуры

Процедура УдалитьКолонкиКоллекции(Колонки,мКоллекцияИСостав,Изменено)
	мУдаления = Новый Массив;
	Для Каждого	Колонка ИЗ Колонки Цикл
		Удалять = Истина;
		Для Каждого Состав ИЗ мКоллекцияИСостав Цикл
			Если СтрСравнить(Состав.Колонка.Имя,Колонка.Имя)=0 Тогда
				Удалять = Ложь;
				Продолжить;
			КонецЕсли;	 	
		КонецЦикла;
		Если Удалять Тогда
			мУдаления.Добавить(Колонка);		
		КонецЕсли;
	КонецЦикла;	
	Для Каждого Колонка ИЗ мУдаления Цикл
		Колонки.Удалить(Колонка);
		Изменено = Истина;			
	КонецЦикла;	
КонецПроцедуры

Процедура ИзменитьПорядокКолонокКоллекции(Колонки,мКоллекцияИСостав,Изменено)
	Индекс = 0;
	Для Каждого Состав ИЗ мКоллекцияИСостав Цикл
		Колонка = Колонки.Найти(Состав.Колонка.Имя);
		Смещение = Индекс-Колонки.Индекс(Колонка);
		Если ЗначениеЗаполнено(Смещение) Тогда
			Изменено = Истина;
			Колонки.Сдвинуть(Колонка, Смещение); // тут нужно учесть колнки вложенного типа которых нет на форме	
		КонецЕсли;	
		Индекс = Индекс +1; 	
	КонецЦикла;		
КонецПроцедуры

Функция ПроверитьОписание(ВозможноОписаниеТипов)
	Если ТипЗнч(ВозможноОписаниеТипов) = Тип("Строка") Тогда
		Если ВозможноОписаниеТипов = КоллекцияСтруктураКлиентСервер_Ei.Произвольный() Тогда
			Возврат Новый ОписаниеТипов;	
		КонецЕсли;	
	КонецЕсли;
	Возврат ТипыКлиентСервер_Ei.ПроверитьОписание(ВозможноОписаниеТипов);	
КонецФункции

Функция НайтиКолонкуВКоллекции(Коллекция,Колонка) 
	Перем Результат;
	Если ЗначениеЗаполнено(Колонка.ИмяРанее) Тогда
		Результат =	Коллекция.Колонки.Найти(Колонка.ИмяРанее);
	КонецЕсли;
	Если Результат = Неопределено Тогда
		Результат =	Коллекция.Колонки.Найти(Колонка.Имя);
	КонецЕсли;
	Возврат Результат;	
КонецФункции

Функция СкопироватьКолонку(Коллекция,КолонкаКоллекции,НовыйТип = Неопределено, НовоеИмя = Неопределено)
	Если НовоеИмя = Неопределено Тогда
		//Тут нужно указать как будем получать новоее имя		
	КонецЕсли;
	Если НовыйТип = Неопределено Тогда
		НовыйТип = КолонкаКоллекции.ТипЗначения;
	КонецЕсли;
	Индекс 			= Коллекция.Колонки.Индекс(КолонкаКоллекции);
	НоваяКолонка 	= Коллекция.Колонки.Вставить(Индекс+1,НовоеИмя,НовыйТип);
	Если ТипыВызовСервера_Ei.ОписаниеВложеннойКоллекции(КолонкаКоллекции.ТипЗначения) И НовыйТип = Новый ОписаниеТипов ТОгда
		//если меняем таблицу/дерево  на произволный тип, копирование не выполняем, поскольку произволный по умолчанию не должен включать таблицы или дерево
		//в противном случае будет ошибка на форме, не сможем показать результат
	Иначе	  
		Коллекция.ЗагрузитьКолонку(Коллекция.ВыгрузитьКолонку(КолонкаКоллекции.Имя),НовоеИмя);
	КонецЕсли;	 
	Возврат НоваяКолонка;  	
КонецФункции

Процедура ИзменитьТипКолонки(Коллекция,КолонкаКоллекции,НовыйТип)
	Имя	= КолонкаКоллекции.Имя;
	ВременноеИмя = ОбщийМодульКлиентСервер_Ei.ИдентификаторВКлюч(Новый УникальныйИдентификатор());
	Колонка = СкопироватьКолонку(Коллекция,КолонкаКоллекции,НовыйТип,ВременноеИмя);
	Коллекция.Колонки.Удалить(КолонкаКоллекции);
	Колонка.Имя = Имя;	
КонецПроцедуры		 

Процедура ИзменитьКолонкиКоллекции(Коллекция,мКоллекцияИСостав,Изменено)
	//Добавляем или изменяем
	Для Каждого Состав ИЗ мКоллекцияИСостав Цикл
		Колонка = Состав.Колонка;
		КолонкаКоллекции = НайтиКлонкуВКоллекции(Коллекция,Колонка);
		Тип = ПроверитьОписание(Колонка.ТипЗначения);
		Если КолонкаКоллекции = Неопределено Тогда
			Изменено = Истина;
			КолонкаКоллекции = Коллекция.Колонки.Добавить(Колонка.Имя,Тип);	
		ИначеЕсли нРег(КолонкаКоллекции.Имя) = нРег(Колонка.Имя) Тогда
			Изменено = Истина;
			КолонкаКоллекции.Имя = Колонка.Имя;
		КонецЕсли;
		Если Не Тип = КолонкаКоллекции.ТипЗначения Тогда
			Изменено = Истина;
			ИзменитьТипКолонки(Коллекция,КолонкаКоллекции,Тип);		
		КонецЕсли;	  				
	КонецЦикла;	
	//Удаляем
	УдалитьКолонкиКоллекции(Коллекция.Колонки,мКоллекцияИСостав,Изменено);
	//Меняем порядок
	ИзменитьПорядокКолонокКоллекции(Коллекция.Колонки,мКоллекцияИСостав,Изменено);			
КонецПроцедуры

Процедура УдалитьКолонкиКоллекции(Колонки,мКоллекцияИСостав,Изменено)
	мУдаления = Новый Массив;
	Для Каждого	Колонка ИЗ Колонки Цикл
		Удалять = Истина;
		Для Каждого Состав ИЗ мКоллекцияИСостав Цикл
			Если нРег(Состав.Колонка.Имя) = нРег(Колонка.Имя) Тогда
				Удалять = Ложь;
				Продолжить;
			КонецЕсли;	 	
		КонецЦикла;
		Если Удалять Тогда
			мУдаления.Добавить(Колонка);		
		КонецЕсли;
	КонецЦикла;	
	Для Каждого Колонка ИЗ мУдаления Цикл
		Колонки.Удалить(Колонка);
		Изменено = Истина;			
	КонецЦикла;	
КонецПроцедуры

Процедура ИзменитьПорядокКолонокКоллекции(Колонки,мКоллекцияИСостав,Изменено)
	Индекс = 0;
	Для Каждого Состав ИЗ мКоллекцияИСостав Цикл
		Колонка = Колонки.Найти(Состав.Колонка.Имя);
		Смещение = Индекс-Колонки.Индекс(Колонка);
		Если ЗначениеЗаполнено(Смещение) Тогда
			Изменено = Истина;
			Колонки.Сдвинуть(Колонка, Смещение);	
		КонецЕсли;	
		Индекс = Индекс +1; 	
	КонецЦикла;		
КонецПроцедуры

Функция ПроверитьОписание(ВозможноОписаниеТипов)
	Если ТипЗнч(ВозможноОписаниеТипов) = Тип("Строка") Тогда
		Если ВозможноОписаниеТипов = КоллекцияСтруктураКлиентСервер_Ei.Произвольный() Тогда
			Возврат Новый ОписаниеТипов;	
		КонецЕсли;	
	Иначе
		Возврат ТипыКлиентСервер_Ei.ПроверитьОписание(ВозможноОписаниеТипов);
	КонецЕсли;	
КонецФункции

Функция НайтиКлонкуВКоллекции(Коллекция,Колонка) 
	Перем Результат;
	Если ЗначениеЗаполнено(Колонка.ИмяРанее) Тогда
		Результат =	Коллекция.Колонки.Найти(Колонка.ИмяРанее);
	КонецЕсли;
	Если Результат = Неопределено Тогда
		Результат =	Коллекция.Колонки.Найти(Колонка.Имя);
	КонецЕсли;
	Возврат Результат;	
КонецФункции

Функция СкопироватьКолонку(Коллекция,КолонкаКоллекции,НовыйТип = Неопределено, НовоеИмя = Неопределено)
	Если НовоеИмя = Неопределено Тогда
		//Тут нужно указать как будем получать новоее имя		
	КонецЕсли;
	Если НовыйТип = Неопределено Тогда
		НовыйТип = КолонкаКоллекции.ТипЗначения;
	КонецЕсли;
	Индекс 			= Коллекция.Колонки.Индекс(КолонкаКоллекции);
	НоваяКолонка 	= Коллекция.Колонки.Вставить(Индекс+1,НовоеИмя,НовыйТип);
	Коллекция.ЗагрузитьКолонку(Коллекция.ВыгрузитьКолонку(КолонкаКоллекции.Имя),НовоеИмя); 
	Возврат НоваяКолонка;  	
КонецФункции

Процедура ИзменитьТипКолонки(Коллекция,КолонкаКоллекции,НовыйТип)
	Имя	= КолонкаКоллекции.Имя;
	ВременноеИмя = "Колонка"+ СтрЗаменить(Новый УникальныйИдентификатор(),"-","");
	Колонка = СкопироватьКолонку(Коллекция,КолонкаКоллекции,НовыйТип,ВременноеИмя);
	Коллекция.Колонки.Удалить(КолонкаКоллекции);
	Колонка.Имя = Имя;	
КонецПроцедуры		 

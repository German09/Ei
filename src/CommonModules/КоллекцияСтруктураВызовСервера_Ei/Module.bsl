Процедура Инициализация(Форма, Отказ, СтандартнаяОбработка) Экспорт
	Коллекция = ОбщийМодульКлиентСервер_Ei.Структурировать(Форма.Параметры.Коллекция);	
	ИмяОсновногоРеквизита   = "Коллекция";
	КоллекцияВызовСервера_Ei.ИзменитьРеквизиты(Форма, ИмяОсновногоРеквизита, Коллекция);
	Форма.ЗначениеВРеквизитФормы(Коллекция, ИмяОсновногоРеквизита);
	мКолонокРезультата 	= КоллекцияВызовСервера_Ei.ПолучитьКолонки(Коллекция);
	КоллекцияВызовСервера_Ei.ДобавитьКолонкиВЭлемент(Форма, 0, ИмяОсновногоРеквизита, ИмяОсновногоРеквизита, мКолонокРезультата, Форма.Элементы.Низ);
КонецПроцедуры
Процедура Инициализация(Форма, Отказ, СтандартнаяОбработка) Экспорт
	//Получам саму коллекцию
	РеквизитКоллекции   = КоллекцияСтруктураКлиентСервер_Ei.РеквизитКоллекции();
	Коллекция 			= ОбщийМодульКлиентСервер_Ei.Структурировать(Форма.Параметры.Коллекция);	
	ПоказатьКоллекцию(Форма, Коллекция, РеквизитКоллекции);
	//Сохраним настройку для формы на основе коллекции 
	мКоллекцияИСостсав = ПолучитьКоллекциюИСостав(РеквизитКоллекции, Коллекция);
	Форма.Параметры.Настройка = ОбщийМодульКлиентСервер_Ei.Сериализовать(мКоллекцияИСостсав);
КонецПроцедуры

Процедура ПоказатьКоллекцию(Форма, Коллекция, РеквизитКоллекции)
	ВариантКоллекцияВызовСервера_Ei.Загрузить(Форма,Коллекция,РеквизитКоллекции, ,Форма.Элементы.Низ);
КонецПроцедуры

Процедура ИзменитьОбразецКоллекции(Форма,мКоллекцияИСостсав) Экспорт
	//Меняем Коллекцию
	РеквизитКоллекции   = КоллекцияСтруктураКлиентСервер_Ei.РеквизитКоллекции();
	Коллекция 			= Форма.РеквизитФормыВЗначение(РеквизитКоллекции);
	Если ИзменитьКоллекцию(Коллекция,мКоллекцияИСостсав) Тогда
		//Меняем РеквизитыФормы
		//Удаляем и создаем новые элементы формы
		ПоказатьКоллекцию(Форма, Коллекция, РеквизитКоллекции);
	КонецЕсли;	
КонецПроцедуры

//Получем не только сам состав колонок, но и элемент верхнего уровня, саму коллекцию
//
Функция ПолучитьКоллекциюИСостав(РеквизитКоллекции, Коллекция)
	Значение 		= ТипыКлиентСервер_Ei.СоздатьОписаниеИзКолекции(ТипЗнч(Коллекция));
	сТип			= ТипыКлиентСервер_Ei.ПолучитьИмяОписанияТипов(Значение);
	Результат 	= Новый Массив();
		Колонка 	= Новый Структура("Имя,ТипЗначения",РеквизитКоллекции,сТип);
	Результат.Добавить(Новый Структура("Колонка,мКолонки",Колонка, КоллекцияВызовСервера_Ei.ПолучитьКолонки(Коллекция)));
	Возврат Результат;			
КонецФункции


Функция ИзменитьКоллекцию(Коллекция,мКоллекцияИСостсав) Экспорт
	Изменено = Ложь;
	Для Каждого Состав ИЗ мКоллекцияИСостсав Цикл
		ИзменитьТипКоллекции(Коллекция,Состав.Колонка.ТипЗначения,Изменено);
		ИзменитьКолонкиКоллекции(Коллекция,Состав.мКолонки,Изменено);
		Прервать; //на первом уровне только б.д. одна строка
	КонецЦикла;	 
	Возврат Изменено;
КонецФункции


Процедура ДобавитьПараметр(ТД,ПараметрЗапроса) Экспорт
	СтрокиПараметров = ТД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",ПараметрЗапроса.Имя));
	Если Не СтрокиПараметров.Количество() Тогда
		СтрокаПараметров = ТД.ПараметрыЗапроса.Добавить();
		СтрокаПараметров.ИмяПараметра = ПараметрЗапроса.Имя;
		Если Не СтрокаПараметров.ЭтоВыражение Тогда
			ТипЗначения = ПараметрЗапроса.ТипЗначения; 
			Если ТипЗначения.СодержитТип(Тип("Тип")) Тогда //#СпецОбработкаТипа
				ТипЗначения =  Новый ОписаниеТипов("ОписаниеТипов");		
			КонецЕсли;	
			СтрокаПараметров.ЗначениеПараметра = ТипЗначения.ПривестиЗначение(СтрокаПараметров.ЗначениеПараметра);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

Процедура УточнитьПараметры(ТД, УникальныйИдентификатор, Параметры) Экспорт
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ТД,"Параметры") Тогда
		// это вызов из обработки выполнений и параметры в данном случае уже заполнены
	Иначе
		#Если Клиент Тогда
			Параметры	= ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСтруктуруПараметров(ТД.ПараметрыЗапроса,УникальныйИдентификатор);
		#КонецЕсли	
	КонецЕсли;
КонецПроцедуры
Процедура ДобавитьПараметр(ТД,ПараметрЗапроса) Экспорт
	СтрокиПараметров = ТД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",ПараметрЗапроса.Имя));
	Если Не СтрокиПараметров.Количество() Тогда
		СтрокаПараметров = ТД.ПараметрыЗапроса.Добавить();
		СтрокаПараметров.ИмяПараметра = ПараметрЗапроса.Имя;
		Если Не СтрокаПараметров.ЭтоВыражение Тогда
			ТипЗначения = ПараметрЗапроса.ТипЗначения; 
			Если ТипЗначения.СодержитТип(Тип("Тип")) Тогда //#СпецОбработкаТипа
				ТипЗначения =  Новый ОписаниеТипов("ОписаниеТипов");		
			КонецЕсли;	
			СтрокаПараметров.ЗначениеПараметра = ТипЗначения.ПривестиЗначение(СтрокаПараметров.ЗначениеПараметра);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

Функция ПолучитьСтруктуру(ТабПараметров) Экспорт
	Параметры = Новый Структура;
	Для каждого Строка Из ТабПараметров Цикл
		Если ТипЗнч(Строка.ЗначениеПараметра) = Тип("СписокЗначений") Тогда
			//Уложим в фиксированный массив, а то не сможем сохранить как параметры сеанса
			//TODO #19 нужно установить доп признак чтобы произвести обратное переобразование
			ЗначениеПараметра = Новый ФиксированныйМассив(Строка.ЗначениеПараметра.ВыгрузитьЗначения());
		Иначе
			ЗначениеПараметра = Строка.ЗначениеПараметра;
		КонецЕсли;	
		Параметры.Вставить(Строка.ИмяПараметра,Новый ФиксированнаяСтруктура("ЭтоВыражение,ЗначениеПараметра",Строка.ЭтоВыражение,ЗначениеПараметра));					
	КонецЦикла;
	Возврат Параметры;
КонецФункции	
	
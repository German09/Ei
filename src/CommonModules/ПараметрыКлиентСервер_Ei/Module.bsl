#Область ПрограммныйИнтерфейс

// Добавить параметр.
// 
// Параметры:
//  ТекД   		см. КонструкторКлиентСервер_Ei.ПолучитьПереопределяемыйОбъектОбработки
//  Параметр 	см. ПараметрыВызовСервера_Ei.ПолучитьПараметры
Процедура ДобавитьПараметр(ТекД,Параметр) Экспорт
	СтрокиПараметров = ТекД.ПараметрыЗапроса.НайтиСтроки(Новый Структура("ИмяПараметра",Параметр.Имя));
	Если Не СтрокиПараметров.Количество() Тогда
		СтрокаПараметров = ТекД.ПараметрыЗапроса.Добавить();
		СтрокаПараметров.ИмяПараметра 	= Параметр.Имя;
		СтрокаПараметров.Ключ 			= ПолучитьНовыйКлюч();
		Если Не СтрокаПараметров.ЭтоВыражение Тогда
			ТипЗначения = Параметр.ТипЗначения; 
			Если ТипЗначения.СодержитТип(Тип("Тип")) Тогда //#СпецОбработкаТипа
				ТипЗначения =  Новый ОписаниеТипов("ОписаниеТипов");		
			КонецЕсли;	
			СтрокаПараметров.ЗначениеПараметра = ТипЗначения.ПривестиЗначение(СтрокаПараметров.ЗначениеПараметра);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

// Получить структуру параметров
// 
// Параметры:
//  ТабПараметров - ДанныеФормыКоллекция - Таблица параметров
// 
// Возвращаемое значение:
//  Структура из КлючИЗначение:
//	*Ключ - Строка - Имя параметра
//	*Значение - Структура:
//		**ЭтоВыражение - Булево - Признак выражения на встроенном языке
//		**Ключ - Строка- Уникальный идентифкатор 12 символов
//		**ЗначениеПараметра - Строка - Значение вырежения на встроенном языке или строка
//							- Произвольный - Значение параметра  
Функция ПолучитьСтруктуру(ТабПараметров) Экспорт
	Параметры = Новый Структура;
	Для каждого Строка Из ТабПараметров Цикл		
		Если ЗначениеЗаполнено(Строка.ИмяПараметра)	Тогда //при добавлении новый строки в параметр она в самам начале пустая #17			
			Стр	= Новый Структура("ЭтоВыражение,Ключ",Строка.ЭтоВыражение,Строка.Ключ);
			Стр.Вставить("ЗначениеПараметра",ПолучитьЗначениеПараметраСохр(Строка.ЗначениеПараметра));
			Параметры.Вставить(Строка.ИмяПараметра,Новый ФиксированнаяСтруктура(Стр));
		КонецЕсли;						
	КонецЦикла;
	Возврат Параметры;
КонецФункции

// Получить новый ключ.
// 
// Возвращаемое значение:
//  Строка - Получить новый ключ
Функция ПолучитьНовыйКлюч() Экспорт
	Возврат Прав(Новый УникальныйИдентификатор(),12);
КонецФункции
#КонецОбласти	

#Область СлужебныеПроцедурыИФункции
// Значение параметра, которое можно сохранить в параметрах сеанса (снимок наборов): список значений, тип и описание типов
// в фиксированной структуре параметра сеанса недопустимы, они записываются XML и восстанавливаются при вычислении,
// см. ОбщегоНазначенияКлиентСервер_Ei.ПопыткаСтруктурировать (тип и описание типов - с 3.2.8.6: их восстанавливает
// из XML ЗапросыMCPКлиент_Ei.ЗначениеПараметраСтроки, раньше они оставались в форме строкой XML)
//
// Параметры:
//  ЗначениеПараметра - Произвольный - значение параметра в форме Ei
//
// Возвращаемое значение:
//  Произвольный - значение или его XML
Функция ПолучитьЗначениеПараметраСохр(ЗначениеПараметра)
	Результат	= ЗначениеПараметра;
	ВXML		= Новый ОписаниеТипов("СписокЗначений,Тип,ОписаниеТипов");
	Если ВXML.СодержитТип(ТипЗнч(ЗначениеПараметра)) Тогда
		Результат = ОбщегоНазначенияВызовСервера_Ei.Сериализовать(ЗначениеПараметра); //именно на сервере, а то не все типы определяются, возвращался просто список с идентификаторами
	КонецЕсли;
	Возврат Результат;	
КонецФункции

#КонецОбласти

	
		
	

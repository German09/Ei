
&После("ПриСозданииНаСервере")
Процедура ПриСозданииНаСервере_Ei(Форма, Отказ, СтандартнаяОбработка) Экспорт
	Если ПравоДоступа("Просмотр", Метаданные.ОбщиеКоманды.Ei) Тогда
		РеквизитыФормы = Новый Соответствие();
		Для Каждого РеквизитФормы ИЗ Форма.ПолучитьРеквизиты() Цикл
			РеквизитыФормы.Вставить(РеквизитФормы,Форма[РеквизитФормы.Имя]);		
		КонецЦикла;
		Если РеквизитыФормы.Количество() Тогда	
			ОбщегоНазначенияПовтИсп_Ei.Формы().Вставить(Строка(Форма.УникальныйИдентификатор),РеквизитыФормы);	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

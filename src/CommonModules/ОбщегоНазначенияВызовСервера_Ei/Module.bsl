// Получить хеш строки.
// 
// Параметры:
//  стрЗначение - Строка - значение
// 
// Возвращаемое значение:
//  Строка
Функция ПолучитьХешСтроки(стрЗначение) Экспорт
	Хеш = "";
	ХешДанных = Новый ХешированиеДанных(ХешФункция.MD5);
	Если ЗначениеЗаполнено(стрЗначение)Тогда
		ХешДанных.Добавить(стрЗначение);
		Хеш = СтрЗаменить(ХешДанных.ХешСумма," ","");
	КонецЕсли;	
	Возврат Хеш;
КонецФункции

// Реквизиты.
// 
// Параметры:
//  УникальныйИдентифкатор 	- Строка - Уникальный идентифкатор открытой формы
//  Подготавиливать			- Булево - Подготавливать к передаче на клиент или нет
// 
// Возвращаемое значение:
//  Структура из Произвольный - Реквизиты
Функция Реквизиты(Знач УникальныйИдентифкатор,Подготавиливать=Истина) Экспорт 
	Результат = Новый Структура();
	СооРеквизитов = ОбщегоНазначенияПовтИсп_Ei.Формы().Получить(УникальныйИдентифкатор);
	Если Не СооРеквизитов = Неопределено Тогда
		Для Каждого ЭлРеквизит ИЗ СооРеквизитов Цикл 
			Если Не ТипыКлиентСервер_Ei.СложныеРеквизитыФормы().Найти(ТипЗнч(ЭлРеквизит.Значение)) = Неопределено Тогда
				ЗначениеРеквизита = ДанныеФормыВЗначение(ЭлРеквизит.Значение,ЭлРеквизит.Ключ.ТипЗначения.Типы().Получить(0));
			Иначе	
				ЗначениеРеквизита = ЭлРеквизит.Значение;
			КонецЕсли;
			Если Подготавиливать Тогда //иногда нужно передать чистое значение чтобы потом упаковать только нужное см. Обработка.ОбъектКлиент_Ei. 
				ЗначениеРеквизита = ОписаниеЗначенияКлиентСервер_Ei.Подготовить(ЗначениеРеквизита,Новый УникальныйИдентификатор());
			КонецЕсли;	
			Результат.Вставить(ЭлРеквизит.Ключ.Имя,ЗначениеРеквизита);	 		
		КонецЦикла;	
	КонецЕсли;	
	Возврат Результат; 
КонецФункции

// Функция - Получить значения определенного перечисления
//
// Параметры:
//  стрОписаниеТипов - Строка - Универсальное строковое описание типов
// 
// Возвращаемое значение:
//   - Соответствие из Структура:
//						* Ключ	   - Строка - Имя перечисления
//						* Значение - Структура из Строка
//											*Синоним  -Строка-
//											*Значение -Строка-	Само значение перечисления
//
Функция ПолучитьЗначенияПеречисления(стрОписаниеТипов) Экспорт
	Результат 		= Новый Соответствие;
	ОписаниеТипов 	= ТипыКлиентСервер_Ei.ПроверитьОписание(стрОписаниеТипов);
	ПустоеЗначение  = ОписаниеТипов.ПривестиЗначение();
	МД 				= ПустоеЗначение.Метаданные();
	Для Каждого Значение ИЗ МД.ЗначенияПеречисления Цикл
		Синоним = ?(ПустаяСтрока(Значение.Синоним),Значение.Имя,Значение.Синоним);
		Результат.Вставить(Значение.Имя,Новый Структура("Синоним,Значение",Синоним,Перечисления[МД.Имя][Значение.Имя]));		
	КонецЦикла;	
	Возврат Результат; 
КонецФункции	

// Функция - Получить состав подсистемы
//
// Параметры:
//  СтрИмяПодсистемы - Строка - Имя подсистемы
// 
// Возвращаемое значение:
//   - Массив Из Строка - Имя общего модуля
//
Функция ПолучитьСоставПодсистемы(СтрИмяПодсистемы) Экспорт
	Результат = Новый Массив;
	Подсистема_Ei = Метаданные.Подсистемы.Найти(ОбщегоНазначенияКлиентСервер_Ei.Постфикс());
	Если Не Подсистема_Ei = Неопределено Тогда
		Подсистема = Подсистема_Ei.Подсистемы.Найти(СтрИмяПодсистемы);
		Если Не Подсистема = Неопределено Тогда
			Для Каждого ЭлСостава ИЗ Подсистема.Состав Цикл
				Результат.Добавить(ЭлСостава.Имя);			
			КонецЦикла	
		КонецЕсли;
	КонецЕсли;		
	Возврат Результат; 
КонецФункции 



#Область ПрограммныйИнтерфейс
// Формирует список значений на основе структуры колонок
//
// Параметры:
//  АдресКешаРезультатаЗапроса	- УникальныйИдентификатор - Адресс кеша запроса в котором сохранен РезультатЗапроса
//  Объект						- Произвольный	- Значение произволного типа, свойства которого, мы получаем
//  УникальныйИдентификатор	 	- УникальныйИдентификатор	 - Уникальный идентифкатор формы, используется для формирования описания значения, если не указан то табличные части и таблицы значений в объекте игнорируются
// 
// Возвращаемое значение:
//   - СписокЗначений из Структура
//    						*ОписаниеТипов
//    						*Значение
//
//@skip-check common-module-named-self-reference
Функция вСформироватьСписокПоСтруктуреКолонок(АдресКешаРезультатаЗапроса,Объект,УникальныйИдентификатор) Экспорт
	СписокКолонок			= Новый СписокЗначений();
	Если ОбщегоНазначенияВызовСервера_Ei.ЭтоАдресКешаЗначений(АдресКешаРезультатаЗапроса)  Тогда
		СохраненныйРезультат = ОбщегоНазначенияВызовСервера_Ei.ПолучитьЗначениеИзКеша(АдресКешаРезультатаЗапроса);
		//для всех ссылочных типов кроме перечисления добавим уникальный идентифкатор
		Если ТипыКлиентСерверПовтИсп_Ei.ВсеСсылки().СодержитТип(ТипЗнч(Объект)) Тогда
			Если ТипыКлиентСерверПовтИсп_Ei.ВсеСсылки("Перечисления").СодержитТип(ТипЗнч(Объект)) Тогда
		    	Возврат СписокКолонок; //тут нет свойств
			Иначе
				Если ТипыКлиентСерверПовтИсп_Ei.ВсеСсылки(ОбщегоНазначенияКлиентСервер_Ei.сВнешниеИсточникиДанных()).СодержитТип(ТипЗнч(Объект)) Тогда
	                //у внешних ичтоников нет уникального идентифкатора, зато есть значение
					Значение 		= Объект.Значение();
					Представление 	= "Значение()";
				Иначе
					Значение 		= Объект.УникальныйИдентификатор();
					Представление 	= "УникальныйИдентификатор()";
				КонецЕсли;
				СписокКолонок.Добавить(Значение,Представление);
	        КонецЕсли;
		КонецЕсли;
		ОбъектВСписок(Объект,СохраненныйРезультат.Выгрузить().Колонки,СписокКолонок,УникальныйИдентификатор);
	КонецЕсли;	
	Возврат СписокКолонок;  
КонецФункции

// Процедура - раскладывает объект на список реквизитов и табличных частей с их значениями или описаниями значений
//
// Параметры:
//  Объект					 - Произвольный						 - Объект, который раскладываем на список 
//  Колонки					 - КоллекцияКолонокТаблицыЗначений	 - Колонки талицы значений 
//  Список					 - СписокЗначений Из Произвольный	 - Возвращемый параметр который наполняется списком значений
//  УникальныйИдентификатор	 - УникальныйИдентификатор			 - Уникальный идентифкатор формы, используется для формирования описания значения, если не указан то табличные части и таблицы значений в объекте игнорируются
//
Процедура ОбъектВСписок(Объект,Колонки,Список,УникальныйИдентификатор) Экспорт
	Для Каждого Колонка Из Колонки Цикл
		Попытка
			Значение		= Объект[Колонка.Имя];
		Исключение
			//почему то свойство не смогли получить
			//например для ключа записи регистра, возвращаются все свойства регистра включая ресуры, а можем получить только измерения	
			Продолжить;		
		КонецПопытки;		
		Представление 	= Колонка.Имя;
		Если ТипыВызовСервера_Ei.ОписаниеВложеннойКоллекции(Колонка.ТипЗначения) Тогда
			Если УникальныйИдентификатор = Неопределено Тогда	//если адреса формы, нет то описание значения получить не сможем поэтому все таблицы значений и табличные формы игнорируем
				Продолжить;
			КонецЕсли;	
			Если Не ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
				//Это табличная часть
				Значение 		= Значение.Выгрузить();
				Представление 	= Представление+".Выгрузить()";
			КонецЕсли;
			Значение = ОписаниеЗначенияКлиентСервер_Ei.Подготовить(Значение,УникальныйИдентификатор);				
		КонецЕсли;
		Список.Добавить(Значение,Представление);
	КонецЦикла;
КонецПроцедуры


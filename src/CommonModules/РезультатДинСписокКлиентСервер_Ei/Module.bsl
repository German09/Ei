#Область ИнтерфейсРезультатов

Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",			"Список");
	Результат.Вставить("Синоним",		"Дин.список");
	Результат.Вставить("Картинка",		БиблиотекаКартинок.Список_Ei);
	Результат.Вставить("Класс",			РезультатыКлиентСервер_Ei);
	Результат.Вставить("ТипРеквизита",	ТипыКлиентСервер_Ei.Универсальные().ДинамическийСписок);
	Результат.Вставить("Типы",			Новый Массив); //поддерживаемые типы, помимо типа реквизита
		Результат.Типы.Добавить(ТипыКлиентСервер_Ei.Универсальные().Запрос);
	Возврат Результат;
КонецФункции

// Выполняется до выполнения варианта для данноготипа результата
// Варинат не всегда нужно выполнять для некоторых результатов, например в Динамическом списке, не нужно выполнять запрос
// 
// Параметры:
// 	УникальныйИдентификатор - 
// 	ДопПараметры			- 
//  Вариант  				- ОбщийМодуль - модуль варианта
//  ОписаниеЗначения 		- ОписаниеЗначения - возвращаемый параметр, тут мы можем переопределить результат в зависимости от того как будем его отображать, если задуматся глубоко то ДС вообше не должно существовать
// 
// Возвращаемое значение:
//  Булево - Выполнять вариант или нет
Функция ПереопределитьВыполнение(УникальныйИдентификатор,ДопПараметры,Вариант,ОписаниеЗначения) Экспорт
	Результат = Истина;
	Если Вариант = ВариантЗапросКлиентСервер_Ei Тогда
		//если это запрос то его не нужно выполнять, он будут выполнен при создание элементов на форме, тоесть в модуле РезультатДинСписокКлиентСервер_Ei
		ТекстЗапроса = ВариантыКлиентСервер_Ei.ПолучитьИнструкцию(Неопределено,ВариантЗапросКлиентСервер_Ei.Свойства().Имя,ДопПараметры);	
		Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
			//ПараметрыКлиентСервер_Ei.УточнитьПараметры(ТД, УникальныйИдентификатор, Параметры);
			ОписаниеЗначения = РезультатДинСписокВызовСервера_Ei.ПодготовитьЗапрос(ТекстЗапроса,УникальныйИдентификатор);
		КонецЕсли;	 
		Результат = Ложь;
	КонецЕсли;	
	Возврат Результат;	
КонецФункции

Процедура ПослеЗагрузкиРезультата(Форма) Экспорт
	Возврат;	
КонецПроцедуры


#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
	
Функция Загрузить(Форма,ВариантИД,Результат,мКолонокРезультата) Экспорт
	Возврат РезультатДинСписокВызовСервера_Ei.Загрузить(Форма,ВариантИД,Результат,мКолонокРезультата);
КонецФункции

// Привести результат к типу, который возможно показать
// 
// Параметры:
//  СохраненныйРезультат - ПроизвольноеЗначение - значение которые мы птыемся показать данным обработчиком
// 
// Возвращаемое значение:
//	Произвольное значение - Значение приведенное к типу	который можно тут отобразить   
Функция ПривестиРезультат(СохраненныйРезультат) Экспорт
	Возврат РезультатДинСписокВызовСервера_Ei.ПривестиРезультат(СохраненныйРезультат);		
КонецФункции

Функция ОпределитьРазмерность(Результат) Экспорт
	Возврат Неопределено;		
КонецФункции

Процедура ДополнитьДинамическийЭлементФормы(Форма,элФормы) Экспорт
	РезультатДинСписокВызовСервера_Ei.ДополнитьДинамическийЭлементФормы(Форма,элФормы);	
КонецПроцедуры

Функция ПолучитьДопустимыеСвойства(Значение, УникальныйИдентификатор) Экспорт
	Возврат РезультатДинСписокВызовСервера_Ei.ПолучитьДопустимыеСвойства(Значение, УникальныйИдентификатор);		
КонецФункции


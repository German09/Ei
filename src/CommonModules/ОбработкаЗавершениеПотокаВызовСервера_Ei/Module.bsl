#Область ПрограммныйИнтерфейс

// Ожидает завершения фоновых потоков и заполняет их свойства Активно, ИнформацияОбОшибке, Сообщения, ДанныеКлиента.
//
// Параметры:
//  Потоки	- Массив из Структура - описания запуска потоков, см. ОбработкаНачалоПотокаВызовСервера_Ei.ЗапуститьПоток
//            фиксированные структуры заменяются структурами с добавленными свойствами Активно, ИнформацияОбОшибке, Сообщения, ДанныеКлиента
//  Таймаут	- Число, Неопределено - время ожидания завершения активных фоновых заданий в секундах
//
// Возвращаемое значение:
//  Структура:
//   * Завершено 		- Булево - все фоновые задания завершены
//   * сооРезультатов 	- Соответствие из КлючИЗначение - адреса результатов завершенных потоков:
//    ** Ключ 		- Строка - наименование потока
//    ** Значение 	- Строка - адрес результата во временном хранилище
//
Функция ОжидатьЗавершенияПотоков(Потоки,Таймаут = Неопределено) Экспорт	
	//сформируем массив ФЗ
	АктивныеЗадания = Новый Массив;
	Результат 		= Новый Структура("Завершено, сооРезультатов",Истина, Новый Соответствие());
	
	//Соберем данные по всем существующим и активным ФЗ
	Индекс = 0; 
	Для Каждого ЗапускПотока из Потоки Цикл
		Если ТипЗнч(ЗапускПотока) = Тип("ФиксированнаяСтруктура") Тогда
			//меняем фикс структуру на обычную
			ЗапускПотока =  Новый Структура(ЗапускПотока);
			ЗапускПотока.Вставить("Активно", 				Истина);
			ЗапускПотока.Вставить("ИнформацияОбОшибке");
			ЗапускПотока.Вставить("Сообщения",				Новый Массив);
			ЗапускПотока.Вставить("ДанныеКлиента", 			Новый Соответствие);	
			Потоки.Установить(Индекс,ЗапускПотока);
		КонецЕсли;	
		Если ЗапускПотока.Активно Тогда 
			ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ЗапускПотока.Идентификатор);
			Если Не ФоновоеЗадание = Неопределено Тогда
				СборДанныхФЗ(ФоновоеЗадание, ЗапускПотока);
				Если ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда 
					АктивныеЗадания.Добавить(ФоновоеЗадание);
				Иначе
					ПриЗавершении(ФоновоеЗадание, ЗапускПотока, Результат);
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
		Индекс = Индекс+1;
	КонецЦикла;
	//Соберем данные по активным ФЗ с ожиданием
	Если АктивныеЗадания.Количество() Тогда
		Для Каждого ФоновоеЗадание ИЗ ФоновыеЗадания.ОжидатьЗавершенияВыполнения(АктивныеЗадания,Таймаут) Цикл //только с платформы 8.3.13
			//теперь найдем его в Потоки и дополним свойства
			Для Каждого ЗапускПотока из Потоки Цикл			
				Если ФоновоеЗадание.УникальныйИдентификатор = ЗапускПотока.Идентификатор Тогда
					СборДанныхФЗ(ФоновоеЗадание, ЗапускПотока);
					Если ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
						Результат.Завершено = Ложь;
					Иначе
						ПриЗавершении(ФоновоеЗадание, ЗапускПотока, Результат); 
					КонецЕсли;	
					Прервать;
				КонецЕсли;					
			КонецЦикла;	
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Собирает результаты завершенных потоков и добавляет их объекты к объектам процесса текущего сеанса.
//
// Параметры:
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор для помещения результатов во временное хранилище
//  Адреса 					- Соответствие из КлючИЗначение - адреса результатов потоков, см. ОжидатьЗавершенияПотоков:
//   * Ключ 		- Строка - наименование потока
//   * Значение 	- Строка - адрес результата во временном хранилище
//
// Возвращаемое значение:
//  Произвольный - описание значения структуры результатов потоков с ключами по наименованиям потоков,
//                 см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
Функция ПолучитьОписанниеРезульатовФЗ(УникальныйИдентификатор, Адреса) Экспорт
	Результат = Новый Структура();
	Для Каждого Элемент ИЗ Адреса Цикл
		Если ЭтоАдресВременногоХранилища(Элемент.Значение) Тогда
			Объекты = ПолучитьИзВременногоХранилища(Элемент.Значение);
			Если Объекты.Количество() Тогда
				Результат.Вставить(Элемент.Ключ,Объекты.Получить(Объекты.ВГраница()).Результат);
				ОбъектыСервер_Ei.Дополнить(Объекты,УникальныйИдентификатор);
			КонецЕсли;			
		КонецЕсли;		
	КонецЦикла;	
	Возврат ОписаниеЗначенияКлиентСервер_Ei.Подготовить(Результат,УникальныйИдентификатор); 		
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПриЗавершении(ФоновоеЗадание, ЗапускПотока, Результат)
	ЗапускПотока.Активно 			= Ложь;
	ЗапускПотока.ИнформацияОбОшибке = ФоновоеЗадание.ИнформацияОбОшибке;
	ЗапускПотока.ДанныеКлиента		= ХранилищеСистемныхНастроек.Загрузить(ОбщегоНазначенияКлиентСервер_Ei.Постфикс(),ЗапускПотока.Ключ);
	Результат.сооРезультатов.Вставить(ЗапускПотока.Наименование,ЗапускПотока.Ключ);
КонецПроцедуры

Процедура СборДанныхФЗ(ФоновоеЗадание, ЗапускПотока)
	Для Каждого СообщениеПользователю ИЗ ФоновоеЗадание.ПолучитьСообщенияПользователю(Истина) Цикл
		ЗапускПотока.Сообщения.Добавить(СообщениеПользователю);		
	КонецЦикла;
КонецПроцедуры	

#КонецОбласти

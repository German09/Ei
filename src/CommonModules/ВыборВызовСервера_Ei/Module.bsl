// Функция - получает свойства/функции переденного значения
//
// Параметры:
//  Значение				 - Произвольный	 - переданное значение 
//  УникальныйИдентификатор	 - УникальныйИдентификатор	 -  Адрес для формирования описания значения
// 
// Возвращаемое значение:
//   - Список значений или описаний значений
//
Функция ПолучитьСвойстваЗначения(Знач Значение, УникальныйИдентификатор) Экспорт
	ЛюбойКлюч				= " ";
	соо 					= Новый Соответствие();
	Результат 				= Новый СписокЗначений;
	Значение 				= ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(Значение);
	Тип						= ТипЗнч(Значение); 
	ОбработчикРезультата 	= РезультатыКлиентСерверПовтИсп_Ei.ПолучитьРезультаты().Получить(ОбщийМодульКлиентСервер_Ei.ПолучитьИмяТипЗнч(Тип));
	Если Не ОбработчикРезультата = Неопределено Тогда
		// это свойства и функции описаны в обработчике результата
		соо.Вставить(ВариантыКлиентСерверПовтИсп_Ei.КартинкаСсылка(ОбработчикРезультата.Свойства().Имя),ОбработчикРезультата.ПолучитьДопустимыеСвойства(Значение, УникальныйИдентификатор)); 
	ИначеЕсли Тип = Тип("КолонкаТаблицыЗначений") ИЛИ Тип = Тип("КолонкаДереваЗначений") Тогда
		Результат.Добавить(Значение.Заголовок,	"Заголовок");	
		Результат.Добавить(Значение.Имя,		"Имя");
		Результат.Добавить(Значение.ТипЗначения,"ТипЗначения");
		Результат.Добавить(Значение.Ширина, 	"Ширина");
		соо.Вставить(ЛюбойКлюч,Результат);
	ИначеЕсли Тип = Тип("КолонкаРезультатаЗапроса") Тогда
		Результат.Добавить(Значение.Имя,		"Имя");
		Результат.Добавить(Значение.ТипЗначения,"ТипЗначения");
		Результат.Добавить(Значение.Ширина, 	"Ширина");
		соо.Вставить(ЛюбойКлюч,Результат);
	ИначеЕсли Тип = Тип("СтрокаТаблицыЗначений") Тогда
		Результат.Добавить(ОписаниеЗначенияСервер_Ei.Подготовить(Значение.Владелец(),УникальныйИдентификатор),"Владелец()");
		ОбщийМодульВызовСервера_Ei.ОбъектВСписок(Значение,Значение.Владелец().Колонки,Результат,УникальныйИдентификатор);
		соо.Вставить(ЛюбойКлюч,Результат);
	ИначеЕсли Тип = Тип("СтрокаДереваЗначений") Тогда
		Результат.Добавить(ОписаниеЗначенияСервер_Ei.Подготовить(Значение.Строки,УникальныйИдентификатор),"Строки");
		Результат.Добавить(ОписаниеЗначенияСервер_Ei.Подготовить(Значение.Родитель,УникальныйИдентификатор),"Родитель");
		Результат.Добавить(Значение.Уровень(),	"Уровень()");
		Результат.Добавить(ОписаниеЗначенияСервер_Ei.Подготовить(Значение.Владелец(),УникальныйИдентификатор),"Владелец()");
		ОбщийМодульВызовСервера_Ei.ОбъектВСписок(Значение,Значение.Владелец().Колонки,Результат,УникальныйИдентификатор);
		соо.Вставить(ЛюбойКлюч,Результат);
	ИначеЕсли Тип = Тип("РезультатЗапроса") Тогда
		Результат.Добавить(ОписаниеЗначенияСервер_Ei.Подготовить(Значение.Колонки,УникальныйИдентификатор),"Колонки");
		Результат.Добавить(Значение.Пустой(),		"Пустой()");
		Результат.Добавить(ОписаниеЗначенияСервер_Ei.Подготовить(Значение.Выгрузить(),УникальныйИдентификатор),	"Выгрузить()");
		Результат.Добавить(ОписаниеЗначенияСервер_Ei.Подготовить(Значение.Выбрать(),УникальныйИдентификатор),	"Выбрать()");
		соо.Вставить(ЛюбойКлюч,Результат);
	ИначеЕсли Тип = Тип("ВыборкаИзРезультатаЗапроса") Тогда
		Результат.Добавить(Значение.Следующий(),	"Следующий()");
		Результат.Добавить(Значение.Количество(),	"Количество()");
		Для Каждого Колонка ИЗ Значение.Владелец().Колонки Цикл
			Если Колонка.ТипЗначения =  Новый ОписаниеТипов("ТаблицаЗначений") Тогда
				Результат.Добавить(ОписаниеЗначенияСервер_Ei.Подготовить(Значение[Колонка.Имя],УникальныйИдентификатор),Колонка.Имя);	
			Иначе
				Результат.Добавить(Значение[Колонка.Имя],Колонка.Имя);	
			КонецЕсли;		
		КонецЦикла;	
		соо.Вставить(ЛюбойКлюч,Результат);		
	ИначеЕсли Тип = Тип("ИнформацияОбОшибке") Тогда
		Результат.Добавить(Значение.Описание,			"Описание");
		Результат.Добавить(Значение.Причина, 			"Причина");	
		Результат.Добавить(Значение.ИмяМодуля,			"ИмяМодуля");
		Результат.Добавить(Значение.ИсходнаяСтрока,		"ИсходнаяСтрока");
		Результат.Добавить(Значение.НомерСтроки,		"НомерСтроки");
		соо.Вставить(ЛюбойКлюч,Результат);
	ИначеЕсли Тип = Тип("Структура") ИЛИ Тип = Тип("ФиксированнаяСтруктура") Тогда
		Для Каждого элКлючЗначение ИЗ Значение Цикл
			Результат.Добавить(элКлючЗначение.Значение,	элКлючЗначение.Ключ);		
		КонецЦикла;
		соо.Вставить(ЛюбойКлюч,Результат);
	ИначеЕсли Тип = Тип("ОтчетОбъект.ПроцессорВывода_Ei") Тогда
		соо.Вставить(ЛюбойКлюч,Значение.ПолучитьСвойстваЗначения(УникальныйИдентификатор));				
	КонецЕсли;
	Возврат соо;
КонецФункции	

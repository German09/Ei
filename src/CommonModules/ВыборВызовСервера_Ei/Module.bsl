Функция ВычислитьЗначениеСтрокиНаСервере(ДеревоТиповИД,ТД,СлужебныеДанные,ВыборПеременные) Экспорт
	ВызватьИсключение "нужно уже использовать клиентский метод вычисления значения";

	Результат = Новый Структура("Значение,КэшПредставление,ЭтоКоллекция");
	НовоеЗначение = ОбщийМодульВызовСервера_Ei.__ВычислитьЗначение(СлужебныеДанные,ВыборПеременные.Параметры,ВыборПеременные.ЭтаФорма,ВыборПеременные.Объект,ВыборПеременные.ТекущиеДанные,ВыборПеременные.СтрокаТЧ,Неопределено,Неопределено);
	//ДоступенНаКлиенте =  Истина;
	ДанныеФормы 		= ОбщийМодульКлиентСервер_Ei.Структурировать(ТД);
	ДоступенНаКлиенте =	ПроверитьДоступностьЗначенияНаКлиенте(ТД,НовоеЗначение);

	//НЕ (ТипЗнч(НовоеЗначение) =  Тип("ТаблицаЗначений") ИЛИ ТипЗнч(НовоеЗначение) =  Тип("ДеревоЗначений"));
	//Если ДоступенНаКлиенте Тогда
	//	Попытка
	//		Результат.Значение = НовоеЗначение;
	//	Исключение
	//		ДоступенНаКлиенте = Ложь;
	//	КонецПопытки
	//КонецЕсли;	
	Если Не ДоступенНаКлиенте Тогда
		ПеречисленияКлиентСерверПовторноеИспользование_Ei.Значения().Вставить(ДеревоТиповИД,НовоеЗначение); 
		Результат.КэшПредставление = Строка(ТипЗнч(НовоеЗначение));
	КонецЕсли;
	Попытка
		Результат.ЭтоКоллекция = (НовоеЗначение.Количество()+1);
	Исключение
	КонецПопытки;
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьСвойствамиСсылкиЗначения(ДеревоТиповИД,ТД,СвойстваВозможны,Тест = Неопределено) Экспорт
	Если ЭтоАдресВременногоХранилища(ТД.Ссылка) Тогда
		Значение 	= ПолучитьИзВременногоХранилища(ТД.Ссылка);
	Иначе
		Если ОбщийМодульВызовСервера_Ei.ЭтоАдресКешаЗначений(ТД.Ссылка) Тогда
			Адрес = ТД.Ссылка;
		Иначе
			Адрес = ДеревоТиповИД;
		КонецЕсли;	
		Значение 	= ПеречисленияКлиентСерверПовторноеИспользование_Ei.Значения().Получить(Адрес);
	КонецЕсли;
	Если Не Значение =  Неопределено Тогда 
		cooСвойств	= ПолучитьСвойстваОбъекта(Значение,Новый УникальныйИдентификатор);
		Если Не СвойстваВозможны = Неопределено Тогда
			Если ЭтоАдресВременногоХранилища(ТД.Ссылка) Тогда
				// это первое получение просто укажем тип и возможность свойств
				ТД.СсылкаПредставление = Строка(ТипЗнч(Значение));
			КонецЕсли;
		    СвойстваВозможны = Булево(cooСвойств.Количество());
		Иначе
			//это уже пытаемся развернуть ранее поименнованное представление ссылки
			Для каждого Свойство ИЗ cooСвойств Цикл
				ПодСтрока = ТД.ПолучитьЭлементы().Добавить();
				ПодСтрока.Представление	= Свойство.Ключ;
				ДозаполнитьСтрокуДереваНаСервере(ПодСтрока,Свойство.Значение);
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьСвойстваОбъекта(Значение, УникальныйИдентификатор) 
	сооРезультат = Новый Соответствие;
	Если ТипЗнч(Значение) = Тип("ОбъектXDTO") Тогда
		Для каждого Свойство ИЗ Значение.Свойства() Цикл
			Если ЗначениеЗаполнено(Значение[Свойство.Имя]) Тогда
				сооРезультат.Вставить(Свойство.Имя,Значение[Свойство.Имя]);
			КонецЕсли;	
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
		//ОписаниеТипов			= ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(ТипЗнч(Значение));
		//сИмяОписаниеТипов 		= ОбщийМодульЗакрытыйКлиент_Ei.ПолучитьИмяОписанияТипов(ОписаниеТипов);
		//ПеречисленияКлиентСерверПовторноеИспользование_Ei.ОписаниеТиповДоступныхНаКлиенте();
		сооРезультат.Вставить("Колонки",Новый ФиксированнаяСтруктура("Значение,ЭтоКоллекция",Значение.Колонки,Истина));
		сооРезультат.Вставить("Индексы",Новый ФиксированнаяСтруктура("Значение,ЭтоКоллекция",Значение.Индексы,Истина));
	ИначеЕсли ТипЗнч(Значение) = Тип("КолонкаТаблицыЗначений") Тогда
		сооРезультат.Вставить("Заголовок"	,Значение.Заголовок);	
		сооРезультат.Вставить("Имя"			,Значение.Имя);
		сооРезультат.Вставить("ТипЗначения"	,Значение.ТипЗначения);
		сооРезультат.Вставить("Ширина"		,Значение.Ширина);
	ИначеЕсли ТипЗнч(Значение) = Тип("СтрокаТаблицыЗначений") ИЛИ ТипЗнч(Значение) = Тип("СтрокаДереваЗначений") Тогда
		СписокСвойств   = Новый СписокЗначений;
		ОбщийМодульВызовСервера_Ei.ДополнитьСписокПоНаборкуКолонок(СписокСвойств,Значение.Владелец().Колонки,Значение,УникальныйИдентификатор);
		Для Каждого ЭлСписка ИЗ СписокСвойств Цикл
			сооРезультат.Вставить(ЭлСписка.Представление,ЭлСписка.Значение);		
		КонецЦикла;	
	КонецЕсли;
  	Возврат сооРезультат;
КонецФункции

Функция ПроверитьДоступностьЗначенияНаКлиенте(ТД, Значение)
	ДоступноНаКлиенте = НЕ (ТипЗнч(Значение) =  Тип("ТаблицаЗначений") ИЛИ ТипЗнч(Значение) =  Тип("ДеревоЗначений")); //эти значение по умолчанию можно передать на форму если она будет заведомо подготовлена
	Если  ДоступноНаКлиенте Тогда
		//если по прежнему можно то дополнительно проверим явным образом
		ДанныеФормы = ОбщийМодульКлиентСервер_Ei.Структурировать(ТД);
		Если Не ДанныеФормы.Количество() Тогда
			ДанныеФормы.Добавить();
		КонецЕсли;
		Для Каждого Элемент ИЗ ДанныеФормы Цикл
			Попытка 
				Элемент.Значение = Значение; //метод очень шаткий, если положить в структуру то получится передать 
			Исключение
				ДоступноНаКлиенте = Ложь;
			КонецПопытки;	
			Прервать;
		КонецЦикла;
	КонецЕсли;	
	Возврат ДоступноНаКлиенте;
КонецФункции	
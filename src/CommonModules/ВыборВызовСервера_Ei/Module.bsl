//Функция получает список! типов которы возможно использовать в этой форме
//
Функция вПолучитСписокДоступныхТипов(ЭтоВыражение) Экспорт 
	СписокТипов	= Новый СписокЗначений;
	Если ЭтоВыражение = Ложь Тогда
		//Значит нужно выбрать тип в противном случае только ВыборПеременные
		СписокТипов.Добавить(Новый ОписаниеТипов("Число"),					"Число");
		СписокТипов.Добавить(Новый ОписаниеТипов("Строка"),					"Строка");
		СписокТипов.Добавить(Новый ОписаниеТипов("Дата"),					"Дата");
		СписокТипов.Добавить(Новый ОписаниеТипов("Булево"),					"Булево");
	    СписокТипов.Добавить(Новый ОписаниеТипов("СписокЗначений"),			"Список значений");
		СписокТипов.Добавить(Справочники.ТипВсеСсылки(),								"Справочники",				Истина);
		СписокТипов.Добавить(Перечисления.ТипВсеСсылки(),								"Перечисления",				Истина);
		СписокТипов.Добавить(Документы.ТипВсеСсылки(),									"Документы",				Истина);
		СписокТипов.Добавить(ПланыВидовХарактеристик.ТипВсеСсылки(),					"ПланыВидовХарактеристик",	Истина);
		СписокТипов.Добавить(ПланыСчетов.ТипВсеСсылки(),								"ПланыСчетов",				Истина);
		СписокТипов.Добавить(ПланыВидовРасчета.ТипВсеСсылки(),							"ПланыВидовРасчета",		Истина);
		СписокТипов.Добавить(ПланыОбмена.ТипВсеСсылки(),								"ПланыОбмена",				Истина);
		СписокТипов.Добавить(БизнесПроцессы.ТипВсеСсылки(),								"БизнесПроцессы",			Истина);
		отВнешнихИстоников = Новый ОписаниеТипов;
		Для Каждого ВнешнийИстоник ИЗ ВнешниеИсточникиДанных Цикл
			отВнешнихИстоников = Новый ОписаниеТипов(отВнешнихИстоников,ВнешнийИстоник.Таблицы.ТипВсеСсылки().Типы());		
		КонецЦикла;
		СписокТипов.Добавить(отВнешнихИстоников,										"ВнешниеИсточникиДанных",	Истина);
		//СписокТипов.Добавить(БизнесПроцессы.ТипВсеСсылкиТочекМаршрутаБизнесПроцессов(),	"ТочкиМаршрута",			Истина);
		СписокТипов.Добавить(Задачи.ТипВсеСсылки(),										"Задачи",					Истина);
	    СписокТипов.Добавить(Новый ОписаниеТипов("ОписаниеТипов"),			"Описание типов");
		СписокТипов.Добавить(Новый ОписаниеТипов("ВидДвиженияНакопления"),	"Вид движения накопления");
		СписокТипов.Добавить(Новый ОписаниеТипов("ВидДвиженияБухгалтерии"),	"Вид движения бухгалтерии");
		СписокТипов.Добавить(Новый ОписаниеТипов("ВидСчета"),				"Вид счета");
	Иначе
		Заголовок = "Выбор доступной переменной";
	КонецЕсли;	
	Возврат СписокТипов;
КонецФункции

// Функция - получает свойства/функции переденного значения
//
// Параметры:
//  Значение				 - Произвольный	 - переданное значение 
//  УникальныйИдентификатор	 - УникальныйИдентифкатор	 -  Адрес для формирования описания значения
// 
// Возвращаемое значение:
//   - Список значений или описаний значений
//
Функция ПолучитьСвойстваЗначения(Знач Значение, УникальныйИдентификатор) Экспорт
	Результат = Новый СписокЗначений;
	Значение = СтруктурыЗначенийСервер_Ei.ПереопределитьЗначение(Значение);
	Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
		Результат.Добавить(ОбщийМодульСервер_Ei.ПодготовитьОписаниеЗначения(Значение.Колонки,УникальныйИдентификатор),"Колонки");
		Результат.Добавить(ОбщийМодульСервер_Ei.ПодготовитьОписаниеЗначения(Значение.Индексы,УникальныйИдентификатор),"Индексы");
	ИначеЕсли ТипЗнч(Значение) = Тип("ДеревоЗначений") Тогда
		Результат.Добавить(ОбщийМодульСервер_Ei.ПодготовитьОписаниеЗначения(Значение.Строки,УникальныйИдентификатор),"Строки");
		Результат.Добавить(ОбщийМодульСервер_Ei.ПодготовитьОписаниеЗначения(Значение.Колонки,УникальныйИдентификатор),"Колонки");
	ИначеЕсли ТипЗнч(Значение) = Тип("КолонкаТаблицыЗначений") ИЛИ ТипЗнч(Значение) = Тип("КолонкаДереваЗначений") Тогда
		Результат.Добавить(Значение.Заголовок,	"Заголовок");	
		Результат.Добавить(Значение.Имя,		"Имя");
		Результат.Добавить(Значение.ТипЗначения,"ТипЗначения");
		Результат.Добавить(Значение.Ширина, 	"Ширина");
	ИначеЕсли ТипЗнч(Значение) = Тип("КолонкаРезультатаЗапроса") Тогда
		Результат.Добавить(Значение.Имя,		"Имя");
		Результат.Добавить(Значение.ТипЗначения,"ТипЗначения");
		Результат.Добавить(Значение.Ширина, 	"Ширина");
	ИначеЕсли ТипЗнч(Значение) = Тип("СтрокаТаблицыЗначений") Тогда
		ОбщийМодульВызовСервера_Ei.ОбъектВСписок(Значение,Значение.Владелец().Колонки,Результат,УникальныйИдентификатор);
	ИначеЕсли ТипЗнч(Значение) = Тип("СтрокаДереваЗначений") Тогда
		Результат.Добавить(ОбщийМодульСервер_Ei.ПодготовитьОписаниеЗначения(Значение.Строки,УникальныйИдентификатор),"Строки");
		Результат.Добавить(ОбщийМодульСервер_Ei.ПодготовитьОписаниеЗначения(Значение.Родитель,УникальныйИдентификатор),"Родитель");
		ОбщийМодульВызовСервера_Ei.ОбъектВСписок(Значение,Значение.Владелец().Колонки,Результат,УникальныйИдентификатор);
		Результат.Добавить(Значение.Уровень(),	"Уровень()");	
	ИначеЕсли ТипЗнч(Значение) = Тип("РезультатЗапроса") Тогда
		Результат.Добавить(ОбщийМодульСервер_Ei.ПодготовитьОписаниеЗначения(Значение.Колонки,УникальныйИдентификатор),"Колонки");
		Результат.Добавить(Значение.Пустой(),		"Пустой()");
		Результат.Добавить(ОбщийМодульСервер_Ei.ПодготовитьОписаниеЗначения(Значение.Выгрузить(),УникальныйИдентификатор),	"Выгрузить()");
	КонецЕсли;
	Возврат Результат;
КонецФункции	

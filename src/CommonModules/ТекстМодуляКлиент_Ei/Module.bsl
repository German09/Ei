						 ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки_Алгоритм);
					КонецЕсли;	
				ИначеЕсли Алгоритм.Значение = "ПоискПоНаименованию" Тогда
					Если ОписаниеЗначения.Тип = "Справочники" ИЛИ 
						 ОписаниеЗначения.Тип = "ПланыВидовХарактеристик" ИЛИ
						 ОписаниеЗначения.Тип = "ПланыВидовРасчета" ИЛИ
	     			     ОписаниеЗначения.Тип = "ПланыОбмена" ИЛИ
						 ОписаниеЗначения.Тип = "Задачи" ИЛИ
		                 ОписаниеЗначения.Тип = "ПланыСчетов" ИЛИ 
						 ОписаниеЗначения.Тип = ПеречисленияКлиентСерверПовторноеИспользование_Ei.сВнешниеИсточникиДанных() Тогда
						     сИмяПоля 		= "Наименование";
						 	 Наименование 	= Значение_Свойства.Получить(сИмяПоля);
							 СобытиеОтладки_Алгоритм=ОтладкаКлиентСервер_Ei.ДобавитьСобытие(Алгоритм.Представление,"Встроенный язык",СобытиеОтладки);
							 Попытка
								 Если Не Наименование = Неопределено Тогда
									 Наименование				= """"+СокрП(СтрЗаменить(Наименование,"""",""""""))+""""; //правые хвостовые пробелы можем откинуть
									 сМетод						= ?(ОписаниеЗначения.Тип = ПеречисленияКлиентСерверПовторноеИспользование_Ei.сВнешниеИсточникиДанных(),".НайтиПоПолю("""+сИмяПоля+""",",".НайтиПоНаименованию(");
									 сОсноваАлгоритма 			= ПолучитьОбращение(ОписаниеЗначения)+сМетод;
									 сПредполагаемыйАлгоритм 	= сОсноваАлгоритма+СокрЛП(Наименование)+")";
									 НайденоеЗначение			= ВыполнитьКлиентСервер_Ei.Выражение(сПредполагаемыйАлгоритм,,,,Ложь);  	
									 Если НайденоеЗначение = Значение Тогда
										 ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки_Алгоритм);
										 ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
										 Возврат сПредполагаемыйАлгоритм;
									 ИначеЕсли Не Наименование = СокрЛП(Наименование) Тогда
										 сПредполагаемыйАлгоритм 	= сОсноваАлгоритма+Наименование+")";
										 НайденоеЗначение			= ВыполнитьКлиентСервер_Ei.Выражение(сПредполагаемыйАлгоритм,,,,Ложь);	
										 Если НайденоеЗначение = Значение Тогда
											 ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки_Алгоритм);
											 ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
											 Возврат сПредполагаемыйАлгоритм;
										 КонецЕсли;	
									 КонецЕсли;
								КонецЕсли;	 
							 Исключение
								 ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки_Алгоритм,"ОченьВажное",ИнформацияОбОшибке());
								 ВызватьИсключение  "Не удалось сформировать выражение по алгоритмам";
							 КонецПопытки;
							 ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки_Алгоритм);
					КонецЕсли;	
				ИначеЕсли Алгоритм.Значение = "УникальныйИдентификатор" Тогда
					Если ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки().СодержитТип(ТипЗнч(Значение)) Тогда
						СобытиеОтладки_Алгоритм=ОтладкаКлиентСервер_Ei.ДобавитьСобытие(Алгоритм.Представление,"Встроенный язык",СобытиеОтладки);
						Попытка
							Если ОписаниеЗначения.Тип = ПеречисленияКлиентСерверПовторноеИспользование_Ei.сВнешниеИсточникиДанных() Тогда
								Идентификатор	= Значение.Значение();
								Если ТипЗнч(Идентификатор) = Тип("Строка") Тогда
									сПредИдентификатора = """"+Идентификатор+"""";
								Иначе
									сПредИдентификатора = Формат(Идентификатор,"ЧРГ=; ЧГ=");
								КонецЕсли;
								сВыражение 		= ПолучитьОбращение(ОписаниеЗначения)+".ПолучитьСсылку("+сПредИдентификатора+")";
							Иначе	
		                        Идентификатор	= Значение_Свойства.Получить("УникальныйИдентификатор()");
								сВыражение 		= ПолучитьОбращение(ОписаниеЗначения)+".ПолучитьСсылку(Новый УникальныйИдентификатор("""+Идентификатор+"""))";
							КонецЕсли;
							ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки_Алгоритм);
							ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
							Возврат сВыражение;
						Исключение
							ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки_Алгоритм,"ОченьВажное",ИнформацияОбОшибке());
							ВызватьИсключение  "Не удалось сформировать выражение по алгоритму";
						КонецПопытки;
					КонецЕсли;	
			   КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
		//ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);	
	Исключение
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,"ОченьВажное",ИнформацияОбОшибке());
		//ВызватьИсключение  "Не удалось сформировать выражение "+ИнформацияОбОшибке();
	КонецПопытки;
КонецФункции

Функция ПолучитьОбращение(ОписаниеЗначения)		
	Возврат ОписаниеЗначения.Тип+"."+СтрЗаменить(ОписаниеЗначения.ПолноеИмя,".Таблица.",".Таблицы."); //Замена для внешних истоников данных	
КонецФункции

//Формирует строковое описание типа
//Параметры:
//	Значение - <Тип>. Тип значения
//Возвращаемое значение:
//	Строка представление типа
Функция вТипВСтроку(Значение)
	Результат =  "";
	Если ПеречисленияКлиентСерверПовторноеИспользование_Ei.ВсеСсылки().СодержитТип(Значение) Тогда
		//тут нужно поменять на
		отЗначение 			= ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(Значение);
		ОписаниеЗначения 	= ПеречисленияКлиентСерверПовторноеИспользование_Ei.ПолучитьОписаниеМетаданных(отЗначение.ПривестиЗначение(Неопределено));
		Если Не ОписаниеЗначения = Неопределено Тогда
			Результат = ОписаниеЗначения.ТипДляЗапроса+"Ссылка."+ОписаниеЗначения.ПолноеИмя;					
		КонецЕсли;
	Иначе
		Результат = ОбщийМодульКлиентСервер_Ei.вВрегПослеПробела(Строка(Значение));
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Получаем все свойства объекта данных на основе таблицы результатов запроса
//
// Параметры:
//  Объект	 - 	Произвольный 	Объект данных, свойства которого необходимо получить
// 
// Возвращаемое значение:
//   - Соответсвие значений с именами/функциями свойств
//
Функция вПолучитьСвойстваОбъекта(Объект) 
	Результат = Новый Соответствие;
	Для Каждого ЭлСЗ ИЗ ОбщийМодульКлиент_Ei.вПолучитьСвойстваОбъектаМетаданных(Объект) Цикл
		Результат.Вставить(ЭлСЗ.Представление,ЭлСЗ.Значение);		
	КонецЦикла;	
	Возврат Результат; 
КонецФункции	 		

Процедура ПоказатьОшибкиКодов(Элемент,ИнформацияОбОшибке) Экспорт
	Если Не ИнформацияОбОшибке = Неопределено Тогда
		сОшибка = ?(ТипЗнч(ИнформацияОбОшибке) = Тип("ИнформацияОбОшибке"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке),ИнформацияОбОшибке); 
		Элемент.Заголовок 			= Лев(СтрЗаменить(СтрЗаменить(сОшибка,Символы.ПС,Символы.НПП)," ",Символы.НПП),100);
		Элемент.Подсказка 			= сОшибка;
		Элемент.Родитель.Видимость 	= Истина;
	КонецЕсли;	
КонецПроцедуры	

Процедура ВыделитьОшибкуВТексте(Форма,Элемент,ПолеТД) Экспорт
	сПозиция = Лев(Элемент.Заголовок,Найти(Элемент.Заголовок,")}:")-1);
	сПозиция = СтрЗаменить(СтрЗаменить(сПозиция,"{(",""),",",Символы.ПС);
	Если СтрЧислоСтрок(сПозиция) = 2 Тогда
		//Для Каждого Поле ИЗ Элемент.Родитель.Родитель.ПодчиненныеЭлементы Цикл
			Если ПолеТД.Вид = ВидПоляФормы.ПолеТекстовогоДокумента Тогда
				Попытка
					чСтрока 				= Число(СтрПолучитьСтроку(сПозиция,1));
					чКолонка 				= Число(СтрПолучитьСтроку(сПозиция,2));
					Форма.ТекущийЭлемент 	= ПолеТД;
					ПолеТД.УстановитьГраницыВыделения(чСтрока,чКолонка-1,чСтрока,чКолонка);
				Исключение
				Конецпопытки;	
				//Прервать;
			КонецЕсли;	
		//КонецЦикла;	
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьЧислоСтрок(Знач Текст) Экспорт 
	ЧислоСтрок = 0;
	Если ЗначениеЗаполнено(Текст) Тогда
		Текст 		= СокрЛП(Текст);
		ЧислоСтрок	= СтрЧислоСтрок(Текст);
	КонецЕсли;
	Возврат ЧислоСтрок;
КонецФункции

//Перобразовать значение к выражению на встроенном языке
//уичтываеются передопределенные занчения, уникальность кодов и номеров ссылочных значений
//возвможно преобразование наборов занчений Списоков и Массивов
//Параметры:
//	Значение - произвольное значение попытка перобразования которого будет выполнена
//Возвращаемое Значение:
//	Строка - Выражение на встроенном языке;
//
Функция ПреобразоватьЗначениеКВыражению(Значение) Экспорт
	СобытиеОтладки=ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Преобразование значения """+Значение+""" к выражению на встроенном языке","Встроенный язык");
	Попытка
		ОбработкаПрерыванияПользователя();
		Если Значение=Неопределено Тогда
			ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
			Возврат "Неопределено";
		КонецЕсли;	
		Если ТипЗнч(Значение)=Тип("СписокЗначений")
			Или ТипЗнч(Значение)=Тип("Массив") Тогда
			ВыражениеСписка = ПеречисленияКлиентСерверПовторноеИспользование_Ei.РезультатРавно()+" Новый "+вТипВСтроку(ТипЗнч(Значение))+";
			|";
			Для каждого ЭлементСписка из Значение Цикл
				ВыражениеСписка=ВыражениеСписка+"Результат.Добавить("+ПреобразоватьЗначениеКВыражению(?(ТипЗнч(Значение)=Тип("Массив"),
																												ЭлементСписка,
																												ЭлементСписка.Значение))+");
				|";	
			КонецЦикла;
			ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
			Возврат ВыражениеСписка;
		ИначеЕсли ТипЗнч(Значение)=Тип("ОписаниеТипов") Тогда
			Если Значение.Типы().Количество()>1 Тогда
				ВыражениеСписка="МассивТипов	= Новый Массив;";
				Для каждого Тип из Значение.Типы() Цикл
					ВыражениеСписка=ВыражениеСписка+Символы.ПС+"МассивТипов.Добавить("+ПреобразоватьЗначениеКВыражению(Тип)+");";	
				КонецЦикла;
				ВыражениеСписка=ВыражениеСписка+Символы.ПС+ПеречисленияКлиентСерверПовторноеИспользование_Ei.РезультатРавно()+" Новый ОписаниеТипов(МассивТипов);";
				ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
				Возврат ВыражениеСписка; 
			ИначеЕсли Значение.Типы().Количество()=1 Тогда
				ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
				Возврат "Новый ОписаниеТипов("""+вТипВСтроку(Значение.Типы()[0])+""")";
			Иначе
				ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
				Возврат "Новый ОписаниеТипов()";
			КонецЕсли;
		ИначеЕсли ТипЗнч(Значение)=Тип("Тип") Тогда
			ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
			Возврат "Тип("""+вТипВСтроку(Значение)+""")";	
		ИначеЕсли ТипЗнч(Значение)=Тип("Граница") Тогда
			ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
			Возврат "Новый Граница("+ПреобразоватьЗначениеКВыражению(Значение.Значение)+",ВидГраницы."+Значение.ВидГраницы+")";

// Процедура - показывает доступные переменные для текста на встроенном языке
//
// Параметры:
//  Форма			 - Форма	 -  Форма владельца
//  Поле			 - ПолеТекстового документа	 -  Элемент формы в контекстном меню которого происходит вызов
//  стрПараметров	 - Структура	 - Структура параметров
//
Процедура ПоказатьДоступныеПеременные(Форма,Поле,стрПараметров,Выбор) Экспорт
	
	
	стрПараметров.Вставить("ЗапретитьВстроенныйЯзык");
	стрПараметров.ТекущиеДанные.ЭтоВыражение 		= Истина; 		//для того чтоб не заполнялось дерево типов
	ВыделенныйТекст									= ПолучитьВыделенныйТекст(Поле);
	стрПараметров.ТекущиеДанные.ЗначениеПараметра 	= ?(ЗначениеЗаполнено(ВыделенныйТекст),ВыделенныйТекст,Неопределено); //в вСформироватьСтруктуруДляФормыВыбораТипа заполняется текущей строкой
	стрПараметров.ТекущиеДанные.Удалить("Идентификатор"); //Удаляем идентифкатор, для того чтобы в ОбработкеВыбора могли пройти до условия СтруктураГраницВыделения
	стрПараметров.ТекущиеДанные.Вставить("СтруктураГраницВыделения", ПолучитьГраницыВыделения(Поле));
		
	ОО_ВыбораВозрЗначения = Новый ОписаниеОповещения("УстановитьВыбранныеГраницыВыделения",ТекстМодуляКлиент_Ei,Поле);
	ВыборКлиент_Ei.НачалоВыбора(ОО_ВыбораВозрЗначения,Выбор,Форма,Поле,стрПараметров,Ложь);
КонецПроцедуры

Функция ПолучитьВыделенныйТекст(Элемент) Экспорт
	Результат = "";
	Если Элемент.Вид = ВидПоляФормы.ПолеHTMLДокумента Тогда
		Результат = РедакторКодаКлиент_Ei.View(Элемент).selectedText()
	Иначе //Это текстовый документ	
		Результат = Элемент.ВыделенныйТекст;
	КонецЕсли;	 
	Возврат Результат;		
КонецФункции

// Установить выделенный текст.
// 
// Параметры:
//  Элемент - 
//  Текст - Строка
Процедура УстановитьВыделенныйТекст(Элемент,Текст) Экспорт
	Если Элемент.Вид = ВидПоляФормы.ПолеHTMLДокумента Тогда
		РедакторКодаКлиент_Ei.View(Элемент).selectedText(Текст)
	Иначе //Это текстовый документ	
		Элемент.ВыделенныйТекст = Текст;
	КонецЕсли;		
КонецПроцедуры

Функция ПолучитьГраницыВыделения(Элемент)
	Перем НачалоСтрока,НачалоКолонка,ОкончаниеСтрока,ОкончаниеКолонка;
	Если Элемент.Вид = ВидПоляФормы.ПолеHTMLДокумента Тогда
		Область = РедакторКодаКлиент_Ei.View(Элемент).getSelection();
		НачалоСтрока 		= Область.startLineNumber;
		НачалоКолонка 		= Область.startColumn;
		ОкончаниеСтрока 	= Область.endLineNumber;
		ОкончаниеКолонка 	= Область.endColumn;
	Иначе //Это текстовый документ	
		Элемент.ПолучитьГраницыВыделения(НачалоСтрока,НачалоКолонка,ОкончаниеСтрока,ОкончаниеКолонка);
	КонецЕсли;	 
	Возврат  Новый Структура("НачалоСтрока,НачалоКолонка,ОкончаниеСтрока,ОкончаниеКолонка", НачалоСтрока,НачалоКолонка,ОкончаниеСтрока,ОкончаниеКолонка);			
КонецФункции

Процедура УстановитьГраницыВыделения(Элемент,ГраницыВыделения)
	Перем НачалоСтрока,НачалоКолонка,ОкончаниеСтрока,ОкончаниеКолонка;
	НачалоСтрока 		= ГраницыВыделения.НачалоСтрока;
	НачалоКолонка 		= ГраницыВыделения.НачалоКолонка;
	ОкончаниеСтрока 	= ГраницыВыделения.ОкончаниеСтрока;
	ОкончаниеКолонка 	= ГраницыВыделения.ОкончаниеКолонка;
	Если Элемент.Вид = ВидПоляФормы.ПолеHTMLДокумента Тогда
		РедакторКодаКлиент_Ei.View(Элемент).setSelection(НачалоСтрока,НачалоКолонка,ОкончаниеСтрока,ОкончаниеКолонка);
	Иначе //Это текстовый документ
		//Выделение может не сработать есл поле текстового документа не является текущим на форме, вероятно придется ТекущийЭлемент = Поле;
		Элемент.УстановитьГраницыВыделения(НачалоСтрока,НачалоКолонка,ОкончаниеСтрока,ОкончаниеКолонка);
	КонецЕсли;		
КонецПроцедуры
		

// Процедура - Установить текст в поле выбранного документа 
//
// Параметры:
//  Поле			 		- ПолеТекстового документа	 -  Элемент формы в контекстном меню которого происходит вызов в которое устанавливаем текст
//  ВыбранноеЗначение	 	- Структура	 -  Возвращаемая структура формой/алгоритмом выбора типа 
//
Процедура УстановитьВыбранныеГраницыВыделения(ВыбранноеЗначение,Поле) Экспорт
	Если ЗначениеЗаполнено(ВыбранноеЗначение.СтруктураГраницВыделения) Тогда
		УстановитьГраницыВыделения(Поле,ВыбранноеЗначение.СтруктураГраницВыделения);
	КонецЕсли;
	УстановитьВыделенныйТекст(Поле,ВыбранноеЗначение.ЗначениеПараметра);
	
	//нужно как то целевые формы уведомить об изменении тектового поля, например для конструктора важно
	//ДеревоЗапросовЯзыкПриИзменении(Элементы.Язык);
КонецПроцедуры

Функция ПолучитьСвойстваТекстаОшибки(ОписаниеОшибки)
	
	Ошибка = Новый Структура("ТекстОшибки, НомерСтроки, НомерКолонки", ОписаниеОшибки, 0, 1);
	
	ПозицияРазделителя = СтрНайти(ОписаниеОшибки, ":");
	
	Если 0 < ПозицияРазделителя Тогда
		
		Ошибка.ТекстОшибки = СокрЛП(Сред(ОписаниеОшибки, ПозицияРазделителя + 1));
		
		СтрокаОшибки = Лев(ОписаниеОшибки, ПозицияРазделителя - 1);
		СтрокаОшибки = СтрЗаменить(СтрокаОшибки, "{", "");
		СтрокаОшибки = СтрЗаменить(СтрокаОшибки, "(", "");
		СтрокаОшибки = СтрЗаменить(СтрокаОшибки, ")", "");
		СтрокаОшибки = СтрЗаменить(СтрокаОшибки, "}", "");
		
		Подстроки = СтрЗаменить(СтрокаОшибки, ",", Символы.ПС);
		
		стрНомерСтроки  = СтрПолучитьСтроку(Подстроки, 1);
		Если ОбщегоНазначенияКлиентСервер_Ei.ЭтоЧисло(стрНомерСтроки) Тогда
			Ошибка.НомерСтроки 	= Число(стрНомерСтроки);
		КонецЕсли;
		стрНомерКолонки  = СтрПолучитьСтроку(Подстроки, 2);
		Если ОбщегоНазначенияКлиентСервер_Ei.ЭтоЧисло(стрНомерКолонки) Тогда
			Ошибка.НомерКолонки 	= Число(стрНомерКолонки);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ошибка;
	
КонецФункции	

Процедура ВыделитьОшибкуВТексте(Форма,Элемент,ЭлементИнструкции) Экспорт
	Свойства = ПолучитьСвойстваТекстаОшибки(Элемент.Заголовок);
	Если ЗначениеЗаполнено(Свойства.НомерСтроки) Тогда
		РедакторКодаКлиент_Ei.View(ЭлементИнструкции).markError(Свойства.НомерСтроки, Свойства.НомерКолонки);
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьЧислоСтрок(Знач Текст) Экспорт 
	ЧислоСтрок = 0;
	Если ЗначениеЗаполнено(Текст) Тогда
		Текст 		= СокрЛП(Текст);
		ЧислоСтрок	= СтрЧислоСтрок(Текст);
	КонецЕсли;
	Возврат ЧислоСтрок;
КонецФункции

//Перобразовать значение к выражению на встроенном языке
//уичтываеются передопределенные занчения, уникальность кодов и номеров ссылочных значений
//возвможно преобразование наборов занчений Списоков и Массивов.
//Параметры:
//	Значение - Произвольный - значение попытка перобразования которого будет выполнена
//Возвращаемое Значение:
//	Строка - Выражение на встроенном языке;
//
Функция ПреобразоватьЗначениеКВыражению(Значение) Экспорт
	СобытиеОтладки=ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Преобразование значения """+Значение+""" к выражению на встроенном языке","Встроенный язык");
	Попытка
		ОбработкаПрерыванияПользователя();
		Если Значение=Неопределено Тогда
			ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
			Возврат "Неопределено";
		КонецЕсли;	
		Если ТипЗнч(Значение)=Тип("СписокЗначений")
			Или ТипЗнч(Значение)=Тип("Массив") Тогда
			ВыражениеСписка = РезультатРавно()+" Новый "+ТипыКлиентСервер_Ei.ВСтроку(ТипЗнч(Значение))+";
			|";
			Для каждого ЭлементСписка из Значение Цикл
				ВыражениеСписка=ВыражениеСписка+"Результат.Добавить("+ПреобразоватьЗначениеКВыражению(?(ТипЗнч(Значение)=Тип("Массив"),
																												ЭлементСписка,
																												ЭлементСписка.Значение))+");
				|";	
			КонецЦикла;
			ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
			Возврат ВыражениеСписка;
		ИначеЕсли ТипЗнч(Значение)=Тип("ОписаниеТипов") Тогда
			Если Значение.Типы().Количество()>1 Тогда
				ВыражениеСписка="МассивТипов	= Новый Массив;";
				Для каждого Тип из Значение.Типы() Цикл
					ВыражениеСписка=ВыражениеСписка+Символы.ПС+"МассивТипов.Добавить("+ПреобразоватьЗначениеКВыражению(Тип)+");";	
				КонецЦикла;
				ВыражениеСписка=ВыражениеСписка+Символы.ПС+РезультатРавно()+" Новый ОписаниеТипов(МассивТипов);";
				ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
				Возврат ВыражениеСписка; 
			ИначеЕсли Значение.Типы().Количество()=1 Тогда
				ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
				Возврат "Новый ОписаниеТипов("""+ТипыКлиентСервер_Ei.ВСтроку(Значение.Типы()[0])+""")";
			Иначе
				ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
				Возврат "Новый ОписаниеТипов()";
			КонецЕсли;
		ИначеЕсли ТипЗнч(Значение)=Тип("Тип") Тогда
			ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
			Возврат "Тип("""+ТипыКлиентСервер_Ei.ВСтроку(Значение)+""")";	
		ИначеЕсли ТипЗнч(Значение)=Тип("Граница") Тогда
			ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
			Возврат "Новый Граница("+ПреобразоватьЗначениеКВыражению(Значение.Значение)+",ВидГраницы."+Значение.ВидГраницы+")";
		ИначеЕсли ТипЗнч(Значение)=Тип("МоментВремени") Тогда
			ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
			Возврат "Новый МоментВремени("+ПреобразоватьЗначениеКВыражению(Значение.Дата)+","+ПреобразоватьЗначениеКВыражению(Значение.Ссылка)+")";
		ИначеЕсли ТипЗнч(Значение)=Тип("Булево") Тогда //для 8.2
			ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	    	Возврат ?(Значение,"Истина","Ложь");
		ИначеЕсли ТипыКлиентСервер_Ei.Простые().СодержитТип(ТипЗнч(Значение)) Тогда
			ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
			Возврат ТипыКлиентСервер_Ei.ВСтроку(ТипЗнч(Значение))+"."+СтрЗаменить(ОбщегоНазначенияКлиентСервер_Ei.вВрегПослеПробела(Строка(Значение)),"""","");
		ИначеЕсли ТипЗнч(Значение)=Тип("Строка") Тогда
			ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
			Возврат СтрЗаменить(""""+СтрЗаменить(Значение,"""","""""")+"""",Символы.ПС,Символы.ПС+"|");

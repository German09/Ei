//Определяет порядок в котором будут применены алгоритмы формирования выражения на основе значений
//
Функция АлгоритмыФормированияВыражения()
	Результат = Новый СписокЗначений;
	//измените порядок в случае необходимости
	Результат.Добавить("Предопределенный","Проверка на предопределенное значение");
	Результат.Добавить("ПустаяСсылка","Проверка на пустую ссылку");
	Результат.Добавить("ПоискПоКоду","Поиск по коду");
	Результат.Добавить("ПоискПоНомеру","Поиск по номеру");
	Результат.Добавить("ПоискПоНаименованию","Поиск по наименованию");
	Результат.Добавить("УникальныйИдентификатор","Ссылка из уникального идентификатора");
	Возврат Результат;
КонецФункции

Функция ПолучитьОбращение(ОписаниеЗначения)		
	Возврат ОписаниеЗначения.Тип+"."+СтрЗаменить(ОписаниеЗначения.ПолноеИмя,".Таблица.",".Таблицы."); //Замена для внешних истоников данных	
КонецФункции


// Получаем все свойства объекта данных на основе таблицы результатов запроса
//
// Параметры:
//  Объект	 - 	ЛюбаяСсылка -	Объект данных, свойства которого необходимо получить
// 
// Возвращаемое значение:
//   Соответствие Из Произвольный
//
Функция вПолучитьСвойстваОбъекта(Объект) 
	Результат = Новый Соответствие;
	Для Каждого ЭлСЗ ИЗ ОбщегоНазначенияКлиентСервер_Ei.ПолучитьСвойстваОбъектаМетаданных(Объект) Цикл
		Результат.Вставить(ЭлСЗ.Представление,ЭлСЗ.Значение);		
	КонецЦикла;	
	Возврат Результат; 
КонецФункции

Функция РезультатРавно() Экспорт
	Возврат "Результат"+Символы.Таб+"=";	

// Процедура - показывает доступные переменные для текста на встроенном языке
//
// Параметры:
//  Форма			 - Форма	 -  Форма владельца
//  Поле			 - ПолеТекстового документа	 -  Элемент формы в контекстном меню которого происходит вызов
//  стрПараметров	 - Структура	 - Структура параметров
//
Процедура ПоказатьДоступныеПеременные(Форма,Поле,стрПараметров,Выбор) Экспорт
	Перем НачалоСтрока,КолонкаНач,СтрокаКон,КолонкаКон;
	
	стрПараметров.Вставить("ЗапретитьВстроенныйЯзык");
	стрПараметров.ТекущиеДанные.ЭтоВыражение 		= Истина; 		//для того чтоб не заполнялось дерево типов
	стрПараметров.ТекущиеДанные.ЗначениеПараметра 	= ?(ЗначениеЗаполнено(Поле.ВыделенныйТекст),Поле.ВыделенныйТекст,Неопределено); //в вСформироватьСтруктуруДляФормыВыбораТипа заполняется текущей строкой
	стрПараметров.ТекущиеДанные.Удалить("Идентификатор"); //Удаляем идентифкатор, для того чтобы в ОбработкеВыбора могли пройти до условия СтруктураГраницВыделения
	стрПараметров.ТекущиеДанные.Вставить("СтруктураГраницВыделения");
	Поле.ПолучитьГраницыВыделения(НачалоСтрока,КолонкаНач,СтрокаКон,КолонкаКон);
	стрПараметров.ТекущиеДанные.СтруктураГраницВыделения = Новый Структура("НачалоСтрока,КолонкаНач,СтрокаКон,КолонкаКон", НачалоСтрока,КолонкаНач,СтрокаКон,КолонкаКон);
	
	ОО_ВыбораВозрЗначения = Новый ОписаниеОповещения("УстановитьВыбранныеГраницыВыделения",ТекстМодуляКлиент_Ei,Поле);
	ВыборКлиент_Ei.НачалоВыбора(ОО_ВыбораВозрЗначения,Выбор,Форма,Поле,стрПараметров,Ложь);
КонецПроцедуры

// Процедура - Установить текст в поле выбранного документа 
//
// Параметры:
//  Поле			 		- ПолеТекстового документа	 -  Элемент формы в контекстном меню которого происходит вызов в которое устанавливаем текст
//  ВыбранноеЗначение	 	- Структура	 -  Возвращаемая структура формой/алгоритмом выбора типа 
//
Процедура УстановитьВыбранныеГраницыВыделения(ВыбранноеЗначение,Поле) Экспорт
	Если ЗначениеЗаполнено(ВыбранноеЗначение.СтруктураГраницВыделения) Тогда
		//Выделение может не сработать есл поле текстового документа не является текущим на форме, вероятно придется ТекущийЭлемент = Поле;
		Поле.УстановитьГраницыВыделения(ВыбранноеЗначение.СтруктураГраницВыделения.НачалоСтрока,ВыбранноеЗначение.СтруктураГраницВыделения.КолонкаНач,ВыбранноеЗначение.СтруктураГраницВыделения.СтрокаКон,ВыбранноеЗначение.СтруктураГраницВыделения.КолонкаКон);
	КонецЕсли;
	Поле.ВыделенныйТекст = ВыбранноеЗначение.ЗначениеПараметра;
	
	//нужно как то целевые формы уведомить об изменении тектового поля, например для конструктора важно
	//ДеревоЗапросовЯзыкПриИзменении(Элементы.Язык);

КонецПроцедуры	

//Процедуру нужно убрать вместо нее теперь  
//ОтладкаКлиент_Ei.ПоказатьИсключение()
Процедура ПоказатьОшибкиКодов(Элемент,ИнформацияОбОшибке) Экспорт
	Если Не ИнформацияОбОшибке = Неопределено Тогда
		сОшибка = ?(ТипЗнч(ИнформацияОбОшибке) = Тип("ИнформацияОбОшибке"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке),ИнформацияОбОшибке); 
		Элемент.Заголовок 			= Лев(СтрЗаменить(СтрЗаменить(сОшибка,Символы.ПС,Символы.НПП)," ",Символы.НПП),100);
		Элемент.Подсказка 			= сОшибка;
		Элемент.Родитель.Видимость 	= Истина;
	КонецЕсли;	
КонецПроцедуры	

Процедура ВыделитьОшибкуВТексте(Форма,Элемент,ПолеТД) Экспорт
	сПозиция = Лев(Элемент.Заголовок,Найти(Элемент.Заголовок,")}:")-1);
	сПозиция = СтрЗаменить(СтрЗаменить(сПозиция,"{(",""),",",Символы.ПС);
	Если СтрЧислоСтрок(сПозиция) = 2 Тогда
		//Для Каждого Поле ИЗ Элемент.Родитель.Родитель.ПодчиненныеЭлементы Цикл
			Если ПолеТД.Вид = ВидПоляФормы.ПолеТекстовогоДокумента Тогда
				Попытка
					чСтрока 				= Число(СтрПолучитьСтроку(сПозиция,1));
					чКолонка 				= Число(СтрПолучитьСтроку(сПозиция,2));
					Форма.ТекущийЭлемент 	= ПолеТД;
					ПолеТД.УстановитьГраницыВыделения(чСтрока,чКолонка-1,чСтрока,чКолонка);
				Исключение
				Конецпопытки;	
				//Прервать;
			КонецЕсли;	
		//КонецЦикла;	
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьСписокОбъектов(Каталог) Экспорт
	Результат 	= Новый СписокЗначений();
	ЧТ 		 	= Новый ЧтениеТекста();
	СтрМаркер	= "uuid=""";
	Для Каждого Файл ИЗ НайтиФайлы(Каталог, "*.mdo", Истина) Цикл
		ЧТ.Открыть(Файл.ПолноеИмя);
		Текст = ЧТ.Прочитать();  
		ЧТ.Закрыть();
		Если ЗначениеЗаполнено(Текст) Тогда
			Начало = Найти(Текст,СтрМаркер);
			Если Начало Тогда
				Результат.Добавить(Сред(Текст,Начало+СтрДлина(СтрМаркер),36),Файл.ПолноеИмя);
			КонецЕсли;
		КонецЕсли;		
	КонецЦикла;
КонецФункции
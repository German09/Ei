// @strict-types

// Клиентская часть журнала Ei: буфер корневых замеров, отправка на сервер,
// оповещение об ошибках и открытие просмотра. Замеры ведет см. ЖурналКлиентСервер_Ei

#Область ПрограммныйИнтерфейс

// Отправляет накопленные замеры на сервер.
Процедура Отправить() Экспорт
	
	Буфер = ЖурналКлиентПовтИсп_Ei.СостояниеЖурнала().Буфер;
	Если Буфер.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Замеры = Новый Массив; // Массив из см. ЖурналКлиентСервер_Ei.НачатьЗамер
	Для Каждого Замер Из Буфер Цикл
		Замеры.Добавить(Замер);
	КонецЦикла;
	Буфер.Очистить();
	
	Попытка
		ЖурналВызовСервера_Ei.ЗаписатьЗамеры(Замеры);
	Исключение
		// Журнал не должен мешать работе: замеры теряются, пользователь узнает об этом.
		ПоказатьОповещениеПользователя(НСтр("ru = 'Журнал Ei: замеры не записаны'"), ,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), ОбщегоНазначенияКлиент_Ei.КартинкаОповещения());
	КонецПопытки;
	
КонецПроцедуры

// Открывает просмотр журнала, предварительно отправив накопленные замеры.
//
// Параметры:
//  ИдЗамера - Строка, Неопределено - замер, на котором встать в просмотре
//  Владелец - ФормаКлиентскогоПриложения, Неопределено - форма Ei, в которую журнал восстанавливает запуски
//
Процедура ОткрытьПросмотр(ИдЗамера = Неопределено, Владелец = Неопределено) Экспорт
	
	Отправить();
	
	ПараметрыФормы = Новый Структура("ИдЗамера", ИдЗамера);
	ОткрытьФорму("ОбщаяФорма.ЖурналВыполнения_Ei", ПараметрыФормы, Владелец, ИдЗамера);
	
КонецПроцедуры

// Исходная информация об ошибке замера, завершенного в этом клиентском сеансе.
// Нужна, чтобы показать ошибку стандартным окном платформы: в журнал регистрации пишется только текст.
//
// Параметры:
//  ИдЗамера - Строка
//
// Возвращаемое значение:
//  ИнформацияОбОшибке, Неопределено - Неопределено, если замер без ошибки, из другого сеанса или вытеснен
//
Функция ИнформацияОбОшибкеЗамера(ИдЗамера) Экспорт
	
	Возврат ЖурналКлиентПовтИсп_Ei.СостояниеЖурнала().Ошибки.Получить(ИдЗамера);
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Ставит завершенный корневой замер в буфер. Действия пользователя, ошибки и полный буфер
// отправляются на сервер сразу, остальное - вместе со следующей отправкой.
//
// Параметры:
//  Замер - см. ЖурналКлиентСервер_Ei.НачатьЗамер
//
Процедура ПриЗавершенииКорня(Замер) Экспорт
	
	Буфер = ЖурналКлиентПовтИсп_Ei.СостояниеЖурнала().Буфер;
	Буфер.Добавить(Замер);
	
	Если Замер.Тип = ЖурналКлиентСервер_Ei.ТипыОпераций().Конструктор
		Или ЖурналКлиентСервер_Ei.ЕстьОшибка(Замер)
		Или Буфер.Количество() >= РазмерБуфера() Тогда
		Отправить();
	КонецЕсли;
	
КонецПроцедуры

// Запоминает исходную информацию об ошибке замера до конца сеанса, см. ИнформацияОбОшибкеЗамера.
// Хранится не больше см. КоличествоОшибок, при переполнении старые ошибки забываются.
//
// Параметры:
//  Замер - см. ЖурналКлиентСервер_Ei.НачатьЗамер
//  ИнформацияОбОшибке - ИнформацияОбОшибке
//
Процедура ЗапомнитьОшибку(Замер, ИнформацияОбОшибке) Экспорт
	
	Ошибки = ЖурналКлиентПовтИсп_Ei.СостояниеЖурнала().Ошибки;
	Если Ошибки.Количество() >= КоличествоОшибок() Тогда
		Ошибки.Очистить();
	КонецЕсли;
	Ошибки.Вставить(Замер.Ид, ИнформацияОбОшибке);
	
КонецПроцедуры

// Показывает оповещение об ошибке замера с переходом в просмотр журнала.
//
// Параметры:
//  Замер - см. ЖурналКлиентСервер_Ei.НачатьЗамер
//  ИнформацияОбОшибке - ИнформацияОбОшибке
//
Процедура ОповеститьОбОшибке(Замер, ИнформацияОбОшибке) Экспорт
	
	Пояснение = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
	Если ЗначениеЗаполнено(Пояснение) Тогда
		Переход = Новый ОписаниеОповещения("ОткрытьПросмотрИзОповещения", ЖурналКлиент_Ei, Замер.Ид);
		ПоказатьОповещениеПользователя(СтрПолучитьСтроку(Замер.Операция, 1), Переход, Пояснение,
			БиблиотекаКартинок.Отладка_Ei60);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик перехода из оповещения об ошибке.
//
// Параметры:
//  ИдЗамера - Строка
//
Процедура ОткрытьПросмотрИзОповещения(ИдЗамера) Экспорт
	
	ОткрытьПросмотр(ИдЗамера);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращаемое значение:
//  Число
//
Функция РазмерБуфера()
	
	Возврат 20;
	
КонецФункции

// Возвращаемое значение:
//  Число
//
Функция КоличествоОшибок()
	
	Возврат 100;
	
КонецФункции

#КонецОбласти

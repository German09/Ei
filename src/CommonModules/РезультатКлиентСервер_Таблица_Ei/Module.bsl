#Область ИнтерфейсРезультатов

Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",			ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ТаблицаЗначений);
	Результат.Вставить("Синоним",		"Таблица");
	Результат.Вставить("Картинка",		БиблиотекаКартинок.ВнешнийИсточникДанныхТаблица);
	Результат.Вставить("ИмяРеквизита",	"РезультатЗапросаТЗ");
	Результат.Вставить("Типы",			Новый Массив); //поддерживаемые типы, помимо имени
		Результат.Типы.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().РезультатЗапроса);
		Результат.Типы.Добавить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().МакетКомпоновкиДанных);
		Результат.Типы.Добавить("ValueList");
		Результат.Типы.Добавить("Map");
		Результат.Типы.Добавить("FixedMap");
		Результат.Типы.Добавить("Structure");
		Результат.Типы.Добавить("FixedStructure");
		Результат.Типы.Добавить("Array");
		Результат.Типы.Добавить("FixedArray");
		Результат.Типы.Добавить("String");
	Возврат Результат;
КонецФункции

// Выполняется до выполнения варианта для данноготипа результата
// Варинат не всегда нужно выполнять для некоторых результатов, например в Динамическом списке, не нужно выполнять запрос
// 
// Параметры:
//  Вариант  - общий модуль - модуль варианта
//  ОписаниеЗначения - Описание значения - возвращаемый параметр, тут мы можем переопределить результат в зависимости от того как будем его отображать, если задуматся глубоко то ДС вообше не должно существовать
// 
// Возвращаемое значение:
//  Булево - Выполнять вариант или нет
Функция ПереопределитьВыполнение(Форма,УникальныйИдентификатор,ТД,Параметры,ДопПараметры,Вариант,ОписаниеЗначения) Экспорт
	Возврат  РезультатыКлиентСервер_Ei.ВыполнятьВаринатПоУмолчанию();	
КонецФункции

Процедура ОбработкаОшибокЗагрузки(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
	РезультатыКлиентСервер_Ei.ПоказатьИсключение(Форма,ИнфоОбОшибке);
КонецПроцедуры

Процедура ПослеЗагрузкиРезультата(Форма) Экспорт
	Форма.ТекущийЭлемент = Форма.Элементы[Свойства().ИмяРеквизита];//.ОтборСтрок = Неопределено;//Новый ФиксированнаяСтруктура;
	Форма.ПодключитьОбработчикОжидания("ОО_ОтключитьПоиск",0.1,Истина);	
КонецПроцедуры	 

#Если Сервер Тогда
	
Функция Загрузить(Форма,ВариантИД,Результат,ИмяРеквизита,мКолонокРезультата) Экспорт
	Если Результат = Неопределено Тогда
		//это очистка значения
		Результат =  Новый ТаблицаЗначений();
	КонецЕсли;	
	РезультатыСервер_Ei.ЗагрузитьТаблицуИлиДерево(Форма,Результат,мКолонокРезультата,ИмяРеквизита);
	Возврат Истина;
КонецФункции

// Привести результат к типу, который возможно показать
// 
// Параметры:
//  СохраненныйРезультат - Произвольное значение - значение которые мы птыемся показать данным обработчиком
// 
// Возвращаемое значение:
//	Произвольное значение - Значение приведенное к типу	который можно тут отобразить   
Функция ПривестиРезультат(Значение) Экспорт
	ОписаниеТипаРезультата 	= Новый ОписаниеТипов(Свойства().Имя);
	Результат 				= ОписаниеТипаРезультата.ПривестиЗначение(Неопределено);
	Если ТипЗнч(Значение) = Тип("МакетКомпоновкиДанных") Тогда
		РезультатыСервер_Ei.ВывестиВКоллекециюСКД(Значение,Результат);
	ИначеЕсли ТипЗнч(Значение) = Тип("РезультатЗапроса") Тогда
		Результат 	= Значение.Выгрузить(ОбходРезультатаЗапроса.Прямой);
	ИначеЕсли ТипЗнч(Значение) = Тип("СписокЗначений") Тогда
		Результат.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
		Результат.Колонки.Добавить("Значение_");
		Результат.Колонки.Добавить("Пометка",Новый ОписаниеТипов("Булево"));
		мТипов =  Новый Массив;
		Для Каждого Эл ИЗ Значение Цикл
			Строка = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(Строка,Эл);
			Строка.Значение_ = Эл.Значение;
			мТипов.Добавить(ТипЗнч(Строка.Значение_));
		КонецЦикла;
		Результат.Колонки.Добавить("Значение",Новый ОписаниеТипов(мТипов));
		Результат.ЗагрузитьКолонку(Результат.ВыгрузитьКолонку("Значение_"),"Значение");
		Результат.Колонки.Удалить("Значение_");
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие")  Тогда
		Результат.Колонки.Добавить("Ключ_");
		Результат.Колонки.Добавить("Значение_");
		мТиповКлюч 		=  Новый Массив;
		мТиповЗначение 	=  Новый Массив;
		Для Каждого Эл ИЗ Значение Цикл
			Строка 			= Результат.Добавить();
			Строка.Ключ_ 	= Эл.Ключ;
			Строка.Значение_= Эл.Значение;
			мТиповКлюч.Добавить(ТипЗнч(Эл.Ключ));
			мТиповЗначение.Добавить(ТипЗнч(Эл.Значение));
		КонецЦикла;
		Результат.Колонки.Добавить("Ключ",Новый ОписаниеТипов(мТиповКлюч));
		Результат.Колонки.Добавить("Значение",Новый ОписаниеТипов(мТиповЗначение));
		Результат.ЗагрузитьКолонку(Результат.ВыгрузитьКолонку("Ключ_"),"Ключ");
		Результат.ЗагрузитьКолонку(Результат.ВыгрузитьКолонку("Значение_"),"Значение");
		Результат.Колонки.Удалить("Ключ_");
		Результат.Колонки.Удалить("Значение_");
	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") ИЛИ ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		Результат.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));
		Результат.Колонки.Добавить("Значение_");
		мТипов =  Новый Массив;
		Для Каждого Эл ИЗ Значение Цикл
			Строка 			= Результат.Добавить();
			Строка.Ключ 	= Эл.Ключ;
			Строка.Значение_= Эл.Значение;
			мТипов.Добавить(ТипЗнч(Эл.Значение));
		КонецЦикла;
		Результат.Колонки.Добавить("Значение",Новый ОписаниеТипов(мТипов));
		Результат.ЗагрузитьКолонку(Результат.ВыгрузитьКолонку("Значение_"),"Значение");
		Результат.Колонки.Удалить("Значение_");
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") ИЛИ ТипЗнч(Значение) = Тип("ФиксированныйМассив") Тогда
		Результат.Колонки.Добавить("Колонка1_");
		мТипов =  Новый Массив;
		Для Каждого Эл ИЗ Значение Цикл
			Результат.Добавить().Колонка1_ = Эл;
			мТипов.Добавить(ТипЗнч(Эл));
		КонецЦикла;
		Результат.Колонки.Добавить("Колонка1",Новый ОписаниеТипов(мТипов));
		Результат.ЗагрузитьКолонку(Результат.ВыгрузитьКолонку("Колонка1_"),"Колонка1");
		Результат.Колонки.Удалить("Колонка1_");
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Результат.Колонки.Добавить("Колонка1");
		Для Ном=1 По СтрЧислоСтрок(Значение) Цикл
			Результат.Добавить().Колонка1 = СтрПолучитьСтроку(Значение,Ном);
		КонецЦикла;	
	ИначеЕсли Не Значение = Неопределено Тогда
		ВызватьИсключение "Не удалось отобразить результат в данном представлении";
	КонецЕсли;
	Возврат Результат;		
КонецФункции	

Функция ОпределитьРазмерность(Результат) Экспорт
	Перем ОбъемКоллекции;
	Если ТипЗнч(Результат) = Тип("ТаблицаЗначений") Тогда
		ОписаниеЗначенияВызовСервера_Ei.ОбъемКоллекции(Результат,ОбъемКоллекции);	
	КонецЕсли;
	Возврат ОбъемКоллекции;		
КонецФункции


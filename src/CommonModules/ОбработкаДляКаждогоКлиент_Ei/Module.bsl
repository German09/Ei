#Область ПрограммныйИнтерфейс

// Встраивает в форму обработки «Для каждого» схему процесса и заполняет ее из настройки.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма обработки «Для каждого»
//
Процедура Инициализация(Форма) Экспорт
	ВариантПроцессыКлиент_Ei.Инициализировать(Форма, Форма.Элементы.ПроцессыНаследование);
	Форма.Элементы.ВыборОбъекта.Видимость = Ложь;
	Настройка = ОбработкаДляКаждогоКлиентСервер_Ei.ПолучитьДанныеНастройки(Форма.Параметры.Настройка);
	ВариантПроцессыКлиентСервер_Ei.ЗагрузитьДанные(Форма, Настройка);
	ПроцессыКлиент_Ei.ВосстановитьГрафСхему(Форма);
	ОбработкиКлиент_Ei.ЗагрузитьОбработки(Форма.ДоступныеОбработки.ПолучитьЭлементы());
	Если Не Форма.ВладелецФормы = Неопределено Тогда
		Форма.НастройкиПользователя = Форма.ВладелецФормы.НастройкиПользователя;
		Форма.КэшПользователя 		= Форма.ВладелецФормы.КэшПользователя;
	КонецЕсли;	
КонецПроцедуры

// Выделяет в тексте модуля место ошибки, указанной в элементе.
//
// Параметры:
//  Форма 	- ФормаКлиентскогоПриложения - форма обработки «Для каждого»
//  Элемент - ДекорацияФормы - элемент с текстом ошибки
//
Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ТекстМодуляКлиент_Ei.ВыделитьОшибкуВТексте(Форма,Элемент,Форма.Элементы.ПолеТекстМодуля);		
КонецПроцедуры

#КонецОбласти

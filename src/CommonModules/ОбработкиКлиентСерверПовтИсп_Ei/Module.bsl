#Область СлужебныйПрограммныйИнтерфейс

// Все обработки процессов - модули подсистемы Обработки.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - имя обработки
//   * Значение - ОбщийМодуль - модуль обработки со всеми ее процедурами
//
Функция ПолучитьОбработки() Экспорт
	Результат = Новый Соответствие;
	Для Каждого ИмяМодуля Из ОбщегоНазначенияВызовСервера_Ei.ПолучитьСоставПодсистемы(ОбработкиКлиентСервер_Ei.Ключ()) Цикл
		Попытка
			Обработка = ВыполнитьКлиентСервер_Ei.ВычислитьБезопасно(ИмяМодуля);
			Результат.Вставить(Обработка.Свойства().Имя, Обработка);
		Исключение
			Продолжить; // модуль подсистемы, недоступный в этом контексте, - не обработка
		КонецПопытки;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Картинка обработки для дерева доступных обработок процесса: адрес во временном хранилище
// на время сеанса, один на обработку. Дерево заполняет ОбработкиКлиент_Ei.ЗагрузитьОбработки
//
// Параметры:
//  ИмяОбработки - Строка - имя обработки, см. ПолучитьОбработки
//
// Возвращаемое значение:
//  Строка - адрес картинки, пустая - обработки нет
//
Функция КартинкаСсылка(ИмяОбработки) Экспорт
	Результат = "";
	Обработчик = ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки().Получить(ИмяОбработки);
	Если Обработчик <> Неопределено Тогда
		Результат = ПоместитьВоВременноеХранилище(Обработчик.Свойства().Картинка, Новый УникальныйИдентификатор);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Типы элементов графической схемы, которые выполняют обработки.
//
// Возвращаемое значение:
//  ОписаниеТипов
//
Функция ПолучитьВозможныеТипыЭлементов() Экспорт
	Типы = Новый Массив;
	Для Каждого Элемент Из ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки() Цикл
		Типы.Добавить(Элемент.Значение.Свойства().ТипЭлемента);
	КонецЦикла;
	Возврат Новый ОписаниеТипов(Типы);
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс
// Получает все возможные обработки
// 
// Возвращаемое значение:
//  Соответствие из Строка, ОбщийМодуль - Имя обработки и общий модуль, в котором описаны все необходимые процедуры данной обработки 
Функция ПолучитьОбработки() Экспорт
	Результат 	= Новый Соответствие;
	СтрОбработки = ОбщегоНазначенияВызовСервера_Ei.ПолучитьСоставПодсистемы(ОбработкиКлиентСервер_Ei.Ключ());
	Для Каждого СтрОбработка ИЗ СтрОбработки Цикл
		Попытка
			Обработка = ВыполнитьКлиентСервер_Ei.ВычислитьБезопасно(СтрОбработка);
			Результат.Вставить(Обработка.Свойства().Имя,Обработка);
		Исключение
			Продолжить;
		КонецПопытки;	
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолучитьВозможныеТипыЭлементов() Экспорт
	Типы =  Новый Массив;
	Для Каждого Элемент ИЗ  ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки() Цикл
		Обработчик = Элемент.Значение;
		Типы.Добавить(Обработчик.Свойства().ТипЭлемента);	
	КонецЦикла;	
	Возврат Новый ОписаниеТипов(Типы); 	
КонецФункции

#КонецОбласти	
		
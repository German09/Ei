Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Код",			"d56193ea26df"); //12 символьный идентификатор, необходим при сохранении настроек в формат EDT
	Результат.Вставить("Имя",			"Комментарий");
	Результат.Вставить("Синоним",		"Комментарий");
	Результат.Вставить("Картинка",		БиблиотекаКартинок.Комментарий_Ei);
	Результат.Вставить("Символ",		"❝"); //значок варианта в строке дерева наборов, см. ВариантыКлиент_Ei.СимволыВариантов
	Результат.Вставить("Класс",			ВариантыКлиентСервер_Ei);
	Результат.Вставить("Исполнение",	Ложь); //Исполняется и выводит результат или просто возможно сохранение данных
	Возврат Результат;
КонецФункции

Функция ВыполнитьВариант(УникальныйИдентификатор,ДопПараметры,ОбработчикРезультата = Неопределено, ДанныеКлиента) Экспорт
	Возврат Неопределено;	

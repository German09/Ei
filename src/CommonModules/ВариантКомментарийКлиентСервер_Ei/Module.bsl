//Процедура запоминает (не! сохраняет данные)
//запоминание данных необходимо для того чтобы, произошло сохранение данных выведенных на форму
//в типовом варианте они сохраняться только после изменения контекста.
//
Процедура ЗапомнитьДанные(Форма,ТД) Экспорт
	ТД[Свойства().Имя] =  ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(Форма[Свойства().Имя]);			
КонецПроцедуры

// Сохранить данные настройки на диск в формате EDT
// 
// Параметры:
//	Настройки 	- см. ВариантыКлиент_Ei.НастройкиСохранения
//   
// Возвращаемое значение:
// 	см. ФайлыКлиент_Ei.СохранитьОбщее
Асинх Функция Сохранить(Настройки) Экспорт
	Перем Результат;
	Если ЗначениеЗаполнено(Настройки.Данные.Инструкция) Тогда
		Результат = ФайлыКлиент_Ei.СохранитьОбщее(ВариантКомментарийКлиентСервер_Ei,Настройки.Путь, Настройки.ВариантыИмя, Настройки.ВариантыКлюч, Настройки.Данные);
	Иначе
		УдалитьФайлыАсинх(СтрШаблон("%1\%2_%3",Настройки.Путь,Настройки.ВариантыИмя,ВариантАлгоритмКлиентСервер_Ei.Свойства().Имя));
	КонецЕсли;	
	Возврат Результат;
КонецФункции

// Прочитать.
// 
// Параметры:
//  Путь - Строка 	- Путь к файлы с данными
// 
// Возвращаемое значение:
// 	Структура - см.ПодготовитьДанные	 
Функция Прочитать(Путь) Экспорт
	Результат = ОбщегоНазначенияКлиентСервер_Ei.Структурировать(ФайлыКлиент_Ei.ПрочитатьТекст(Путь));
	Возврат Результат;
КонецФункции


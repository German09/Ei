// Подготовить данные для помещения их в параметры сеанса НаборВариантов_Ei
// 
// Параметры:
//  Форма Форма конструктора
//  Строка Строка дерева вариантов
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Подготовить данные:
// 
Функция ПодготовитьДанные(Строка) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Инструкция",Строка[Свойства().Имя]);
	Возврат Новый ФиксированнаяСтруктура(Результат);			
КонецФункции

// Обрабатываем исходные (сырые) данные для представления объекта во встроенном языке 
// 
// Параметры:
//  ИсходныеДанные -Структура,ФиксированнаяСтруктура- Исходные данные подготовленные функцией см. ПодготовитьДанные 
// 
// Возвращаемое значение:
// 	Произвольный 
Функция Данные(ИсходныеДанные) Экспорт
	Возврат ИсходныеДанные;
КонецФункции

// Загрузить данные из файла
// 
// Параметры:
//  Объект		-ДанныеФормыКоллекцияЭлементовДерева - Строка в которую грузим настройку
//  Настройка  	-ФиксированнаяСтруктура,Структура - Сохраненная настройка
//
Процедура ЗагрузитьДанные(Объект,Настройка) Экспорт
	Если ТипЗнч(Настройка) =  Тип("ФиксированнаяСтруктура") ИЛИ ТипЗнч(Настройка) =  Тип("Структура") Тогда
		Объект[Свойства().Имя]		= Настройка.Инструкция;
	КонецЕсли;	
КонецПроцедуры

#Если Клиент Тогда

Функция ПолучитьРазмерность(Форма,ТД) Экспорт
	Текст 			= "";
	ИмяРеквизита 	= Свойства().Имя;
	элФормы 		= Форма.Элементы.Найти(ИмяРеквизита); 
	Если Не элФормы = Неопределено Тогда
		Текст 			= Форма[ИмяРеквизита].ПолучитьТекст();
	КонецЕсли;			
	Возврат ТекстМодуляКлиент_Ei.ПолучитьЧислоСтрок(Текст);
КонецФункции

// При изменении данных.
// 
// Параметры:
//  Форма - Форма
Процедура ПриИзмененииДанных(Форма) Экспорт
	ТекД 	= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если НЕ ТекД = Неопределено Тогда			
		Форма[Свойства().Имя]		= ОбщегоНазначенияКлиентСервер_Ei.Структурировать(ТекД[Свойства().Имя],Новый ФорматированныйДокумент);
	КонецЕсли;
Конецпроцедуры


Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ТекстМодуляКлиент_Ei.ВыделитьОшибкуВТексте(Форма,Элемент,Форма.Элементы.ПолеТекстМодуля);		
КонецПроцедуры

//Дополняет имена вариантов, вствля их в поле выбора
// 
Процедура ДополнитьИменаВариантов(Форма)
	Коллекция 	 = НаборВариантовВызовСервера_Ei.Получить();
	СписокВыбора = Форма.Элементы.Варианты.СписокВыбора;
	Для Каждого Элемент ИЗ Коллекция Цикл
		СписокВыбора.Добавить(Элемент.Ключ); // тут в качестве значения хорошо бы использовать Элемент.КлючНастроек но его нет в этой структуре
	КонецЦикла;	
КонецПроцедуры

// Дополнить тип варианта на основании возможных закладок их типов
Процедура ДополнитьТипВарианта(Форма)
	Форма.Элементы.Тип.СписокВыбора.Очистить();
	Для Каждого ЭлВарианта ИЗ ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
		ОМ 	= ЭлВарианта.Значение;
		Если ОМ.Свойства().Исполнение Тогда
			Форма.Элементы.Тип.СписокВыбора.Добавить(ЭлВарианта.Ключ,ОМ.Свойства().Синоним);
		КонецЕсли;		
	КонецЦикла;
КонецПроцедуры 	
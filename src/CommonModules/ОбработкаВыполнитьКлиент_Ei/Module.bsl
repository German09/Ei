Процедура Инициализация(Форма) Экспорт
	//ФормаРодитель 	= ПолучитьФорму("ОбщаяФорма.ВозврЗначение_Ei");
	//НаследованиеФормКлиент_Ei.Дополнить(ФормаРодитель,Форма,Форма.Элементы.ВозрЗначение);
	ДополнитьИменаВариантов(Форма);

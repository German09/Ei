#Область ПрограммныйИнтерфейс

// Заполняет форму обработки «Выполнить»: списки выбора вариантов и типов, данные настройки.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма обработки «Выполнить»
//
Процедура Инициализация(Форма) Экспорт
	ДополнитьИменаВариантов(Форма);
	ДополнитьТипВарианта(Форма);
	ЗаполнитьЗначенияСвойств(Форма,ОбработкаВыполнитьКлиентСервер_Ei.ПолучитьДанныеНастройки(Форма.Параметры.Настройка));
КонецПроцедуры

// Выделяет в тексте модуля место ошибки, указанной в элементе.
//
// Параметры:
//  Форма 	- ФормаКлиентскогоПриложения - форма обработки «Выполнить»
//  Элемент - ДекорацияФормы - элемент с текстом ошибки
//
Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ТекстМодуляКлиент_Ei.ВыделитьОшибкуВТексте(Форма,Элемент,Форма.Элементы.ПолеТекстМодуля);		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//Дополняет имена вариантов, вствля их в поле выбора
// 
Процедура ДополнитьИменаВариантов(Форма)
	Коллекция 	 = НаборВариантовВызовСервера_Ei.ПолучитьНаборы();
	СписокВыбора = Форма.Элементы.Варианты.СписокВыбора;
	Для Каждого Элемент ИЗ Коллекция Цикл
		СписокВыбора.Добавить(Элемент.Ключ); // тут в качестве значения хорошо бы использовать Элемент.КлючНастроек но его нет в этой структуре
	КонецЦикла;	
КонецПроцедуры

// Дополнить тип варианта на основании возможных закладок их типов
Процедура ДополнитьТипВарианта(Форма)
	Форма.Элементы.Тип.СписокВыбора.Очистить();
	Для Каждого ЭлементВарианта ИЗ ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
		МодульВарианта 	= ЭлементВарианта.Значение;
		Если МодульВарианта.Свойства().Исполнение Тогда
			Форма.Элементы.Тип.СписокВыбора.Добавить(ЭлементВарианта.Ключ,МодульВарианта.Свойства().Синоним);
		КонецЕсли;		
	КонецЦикла;
КонецПроцедуры 	

#КонецОбласти

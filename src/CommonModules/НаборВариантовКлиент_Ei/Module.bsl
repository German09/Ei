// Вызывается обработчиком оповещения из
// См. ВыборКлиент_Ei.ПараметрыСтроки
// 
// Параметры:
//  Результат 		- Неопределено - Возвращаемый параметр
//  ДопПараметры 	- Структура - Задается в см. ВариантыКлиент_Ei.ПолучитьСтруктуруДоступныхПеременных:
//						*Форма 		- см. ОбщаяФорма.Ei
//						*Аргументы	- Строка 
Процедура Наборы(Результат, ДопПараметры) Экспорт
	Результат = Новый Структура;
	Для Каждого Набор Из НаборВариантовВызовСервера_Ei.Получить() Цикл
		ИмяНабора 			= Набор.Ключ;
		ДоступныеПеременные = Новый Структура;
		ДополнитьДоступныеПеременные(ДоступныеПеременные, ДопПараметры.Форма, ИмяНабора);
		Результат.Вставить(ИмяНабора, ДоступныеПеременные);	//Ключ это Имя набора вариантов
	КонецЦикла;
КонецПроцедуры

Процедура ДополнитьДоступныеПеременные(ДоступныеПеременные, Форма, ИмяНабора) Экспорт
	ДоступныеПеременные.Вставить("Параметры", Новый ОписаниеОповещения("Параметры", ПараметрыКлиент_Ei,
		Новый Структура("Аргументы", ВыборКлиент_Ei.ОкончаниеФункции())));
	ДоступныеПеременные.Вставить("Варианты", Новый ОписаниеОповещения("Варианты", ВариантыКлиент_Ei,
		Новый Структура("ИмяНабора,Аргументы", ИмяНабора, ВыборКлиент_Ei.ОкончаниеФункции())));
КонецПроцедуры

#Область СобытияДереваВариантов

Процедура ПриАктивизацииСтроки(Форма, Элемент) Экспорт
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено И ЗначениеЗаполнено(ТД.ИмяНабора) Тогда //у только что скопированной строки Запрос и все остальные данные строки пустые, отсекаем этот вызов 
		КлючНабора	 = Ключ(Форма);
		КлючНастроек = НастройкиПользователяКлиентСервер_Ei.ПолучитьТекущийВариант(Форма.НастройкиПользователя,
			КлючНабора);
		Если Не КлючНастроек = ТД.КлючНастроек Тогда
			ВосстановитьВариант(Форма, ТД);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ВосстановитьВариант(Форма, ТД) Экспорт
	КлючНабора =  Ключ(Форма);
	НастройкиПользователяКлиентСервер_Ei.СохранитьТекущийВариант(Форма.НастройкиПользователя, КлючНабора, ТД);
	ВариантыКлиент_Ei.ВосстановитьНастройки(Форма, ТД);
	РезультатыКлиент_Ei.ВосстановитьНастройки(Форма, ТД);
	ВариантыКлиент_Ei.ПриИзмененииДанныхВариантов(Форма);
	КонструкторКлиент_Ei.ОбновитьЗаголовкиЗакладок(Форма);
КонецПроцедуры

Процедура ПередНачаломДобавления(Форма, Элемент, Отказ, Копирование, Родитель, ЭтоГруппа, Параметр) Экспорт
	ТД = Элемент.ТекущиеДанные;
	Если Копирование Тогда
		Родитель = ТД.ПолучитьРодителя();
		Если Родитель = Неопределено Тогда
			//запрещаем копировать строку верхнего уровня
			Отказ = Истина;
		Иначе
			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПриНачалеРедактирования(Форма, Элемент, НоваяСтрока, Копирование) Экспорт
	Перем ИмяКадидат;
	ТД = Элемент.ТекущиеДанные;
	Если НоваяСтрока Тогда
		Если Не Копирование Тогда
			ИмяКадидат = ИмяПоУмолчанию();
		Иначе
			ИмяКадидат = ТД.ИмяНабора;
		КонецЕсли;
		ИзменитьНовуюСтроку(Форма, ТД, ИмяКадидат);
	КонецЕсли;
КонецПроцедуры

Процедура ПередОкончаниемРедактирования(Форма, Элемент, НоваяСтрока, ОтменаРедактирования, Отказ) Экспорт
	сПричина 		= "";
	сИмяЗапроса		= СтрЗаменить(Элемент.ТекущиеДанные.ИмяНабора, " ", "");
	Если Не ОбщийМодульКлиентСервер_Ei.ВозможностьКлючСтруктуры(сИмяЗапроса) Тогда
		сПричина = СтрШаблон("Имя '%1' не соответствует правилу именования ключа структуры",сИмяЗапроса);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(сПричина) Тогда
		ДублиСтрок = ОбщийМодульКлиентСервер_Ei.НайтиВКоллекцииДерева(Новый Структура("ИмяНабора", сИмяЗапроса),
			Форма[КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента()].ПолучитьЭлементы());
		Если ДублиСтрок.Количество() > 1 Тогда
			сПричина = "Варинат с именем '" + сИмяЗапроса + "' уже существует";
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(сПричина) Тогда
		Если НоваяСтрока И ОтменаРедактирования Тогда
			//тут разрешаем отказаться 
		Иначе
			ПоказатьПредупреждение( , сПричина, 20, "Ошибка в имени набора");
			Отказ = Истина;
		КонецЕсли;
	Иначе
		//без лишних пробелов
		Элемент.ТекущиеДанные.ИмяНабора = сИмяЗапроса;
		Если НоваяСтрока Тогда 
			//обновим заголоки закладок
			//ПриАктивизацииСтроки(Форма, Элемент); //если тут оставить эту процедуру то теряем текщую строку в поле, никакой установкой текущей строки до или после победить это не смог перенес конструкцию см. ИзменитьНовуюСтроку
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПриИзменении(Форма, Элемент) Экспорт
	КонструкторКлиент_Ei.ВычислитьМодифицированность(Форма);
КонецПроцедуры

Процедура ПередУдалением(Форма, Элемент, Отказ) Экспорт
	Родитель = Элемент.ТекущиеДанные.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		//Это строка верхнего уровня
		Если ПолучитьЭлементы(Форма).Количество() = 1 Тогда
			ПоказатьПредупреждение( , "Невозможно удалить последнюю строку", 10);
			Отказ = Истина;
		Иначе
			Родитель = Форма[КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента()];
		КонецЕсли;
	КонецЕсли;
	Если Не Отказ Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередУдалениемЗавершение", НаборВариантовКлиент_Ei,
			Новый Структура("Форма, Элемент, Родитель", Форма, Элемент, Родитель)), "Удалить строку набора?",
			РежимДиалогаВопрос.ОКОтмена, 15);
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

Процедура ПроверкаПеретаскивания(Форма, Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле) Экспорт
	Если Не Строка = Неопределено Тогда
		СтруктураПеретаскивания = КэшПользователяКлиентСерверПовтИсп_Ei.Значения().Получить(ПараметрыПеретаскивания.Значение);
		Если Не СтруктураПеретаскивания =  Неопределено Тогда
			//вероятно перетаскиваем параметр
			//актуализируем выбранную строку
			Элемент.ТекущаяСтрока = Строка;
			ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
			Если Не ТД = Неопределено Тогда 
				НаборВариантовКлиент_Ei.ВосстановитьВариант(Форма,ТД);
			КонецЕсли;		
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры

#КонецОбласти

Процедура ИзменитьНовуюСтроку(Форма, ТД, Знач ИмяКадидат)
	ТД.ИмяНабора 		= ОбщегоНазначенияКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("ИмяНабора", СокрЛП(
		ИмяКадидат)), ПолучитьЭлементы(Форма));
	ТД.КлючНастроек	= ВариантыКлиентСервер_Ei.ПолучитьПрослеживаемыйИдентификатор(Новый УникальныйИдентификатор,Ключ(Форма));
	ПараметрыКлиент_Ei.ОбновитьКлючи(ТД);
	ЭлементФормыНабора	= Форма.Элементы.Найти(КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента());
	Если Не ЭлементФормыНабора = Неопределено Тогда
		ПриАктивизацииСтроки(Форма, ЭлементФормыНабора); //при наличчи этой процедуры не остаемся в режиме редактирования, что решает проблемму потери текущий строки см. ПередОкончаниемРедактирования
	КонецЕсли;	
КонецПроцедуры

Процедура ПередУдалениемЗавершение(Результат, ДопПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.ОК Тогда
		Элемент 	= ДопПараметры.Элемент;
		Форма 		= ДопПараметры.Форма;
		Родитель	= ДопПараметры.Родитель;
		УдалитьСтрокуИПодстроки(Форма, Родитель, Элемент.ТекущиеДанные);
	КонецЕсли;
КонецПроцедуры

Процедура УдалитьСтрокуИПодстроки(Форма, Родитель, Строка)
	Для Каждого ПодСтрока Из Строка.ПолучитьЭлементы() Цикл
		УдалитьСтрокуИПодстроки(Форма, Строка, ПодСтрока);
	КонецЦикла;
	Родитель.ПолучитьЭлементы().Удалить(Строка);
	РезультатыКлиент_Ei.Очистить(Форма, Строка);
КонецПроцедуры

Функция ПолучитьЭлементы(Форма) Экспорт
	Возврат Форма[КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента()].ПолучитьЭлементы();
КонецФункции

//Создает новый набор по команде или при открутии пустой 
Процедура СоздатьНовый(Форма) Экспорт
	НоваяСтрока = ПолучитьЭлементы(Форма).Добавить();
	НоваяСтрока.ИмяНабора 			= ИмяПоУмолчанию();
	НоваяСтрока.КлючНастроек		= Новый УникальныйИдентификатор;
	//TODO #6 Заполнить настройками по умолчанию
КонецПроцедуры

Процедура Очистить(Форма) Экспорт
	Для Каждого СтрокаВерхнегоУровня Из ПолучитьЭлементы(Форма) Цикл
		УдалитьСтрокуИПодстроки(Форма, Форма[КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента()], СтрокаВерхнегоУровня);
	КонецЦикла;
КонецПроцедуры

Функция ИмяПоУмолчанию()
	Возврат "Вариант";
КонецФункции

//Идентификатором считаем Ключ самой верхней строки (она всегда одна и он генерится автоматически)
Функция Ключ(Форма) Экспорт
	Результат = "";
	Набор = ПолучитьЭлементы(Форма);
	Если Набор.Количество() Тогда
		Результат = Набор[0].КлючНастроек;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Запомним ссылки на файлы для того чтобы потом обратится считать изменения файла
// 
// Параметры:
//  Форма - Форма 
//  СсылкиНаФайлы	-  Структура Из КлючИЗначение:
//  	*Ключ 			- Строка - Имя набора
//  	*ПолеСтруктуры 	- Массив Из Структура см. ФайлыКлиент_Ei.РезультатСохранения
//
Процедура ЗапомнитьСсылкиНаФайлы(Форма, СсылкиНаФайлы) Экспорт
	//Сохраним структуру коллекции в дерево наборов
	Коллекция	= Форма[КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента()].ПолучитьЭлементы();
	Для Каждого СтрНаборСсылок Из СсылкиНаФайлы Цикл
		Для Каждого СтрокаНабора ИЗ ОбщийМодульКлиентСервер_Ei.НайтиВКоллекцииДерева(Новый Структура("ИмяНабора",СтрНаборСсылок.Ключ), Коллекция) Цикл
			Файлы = Новый Структура;
			Для Каждого СтрСсылка Из СтрНаборСсылок.Значение Цикл
				Ключ = ОбщийМодульКлиентСервер_Ei.ИдентификаторВКлюч(СтрСсылка.Ключ);
				Файлы.Вставить(Ключ, СтрСсылка);
			КонецЦикла;
			СтрокаНабора.Файлы = Файлы;
			Прервать;
		КонецЦикла;
	КонецЦикла;
	КонструкторКлиент_Ei.ЗапомнитьНастройки(Форма);
КонецПроцедуры

Функция ПолучитьСсылкуНаФайл(Набор, Знач ВариантКлюч) Экспорт
	Результат = Неопределено;
	Если ТипЗнч(Набор.Файлы) = Тип("Структура") Тогда
		Ключ = ОбщийМодульКлиентСервер_Ei.ИдентификаторВКлюч(ВариантКлюч);
		Набор.Файлы.Свойство(Ключ, Результат);
		Возврат Результат;
	КонецЕсли;
КонецФункции
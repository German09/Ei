// Подготовить модуль в формате
//// 
////<Ei
////@skip-check export-method-in-command-form-module
////@skip-check module-structure-method-in-regions
////@skip-check constructor-function-return-section
////
////Возвращаемое значение:
////	<ссылка на Параметры__Валюта модуля объекта, см. ОписаниеРезультатаФормы>
////
//&НаСервере
//Функция Результат() Экспорт
//	//@skip-check module-unused-local-variable
//	Модуль = РеквизитФормыВЗначение("ОбъектОбработкиEi");
//	Возврат (//Ei>
//	Модуль.Наборы__КурсВалюты().Параметры__Валюта()
////<Ei
//	);
//КонецФункции//Ei>
//
// В модуле формы код записывается в виде для EDT, см. ВидДляEDT; выражение - в скобках после Возврат,
// блок операторов - без скобок, с ;Возврат Результат; в конце. Собственные процедуры и функции алгоритма
// идут после Результат как есть, перед каждой - служебный абзац с директивой, см. ПроцедурыФункцииДляФормы.
// Тип Результат в форме - ссылка на функцию модуля объекта, где он описан по последнему выполнению,
// см. ОписаниеРезультатаФормы: сама форма от выполнения не меняется, и изменения набора по ее хешу не появляются
// 
// Параметры:
//  Модуль  	- см. ВыполнитьКлиентСервер_Ei.ПолучитьМодуль
//  МодульФормы	- Булево - Где будет функция в модуле объекта или в модуле формы
//  ОписаниеРезультата - Строка, Неопределено - тип Результат в комментарии, по умолчанию Произвольный
//  ОбработчикФормы - Булево - добавлять обработчик создания; Ложь для блока общей формы набора
// 
// Возвращаемое значение:
//  Строка 
Функция ПодготовитьМодуль(Модуль, МодульФормы = Истина, ОписаниеРезультата = Неопределено, ОбработчикФормы = Истина) Экспорт
	ЧастиМодуля = Новый Массив;	
	ЧастиМодуля.Добавить(ПолучитьГлавнуюФункцию(Модуль.СодержимоеГлавнойФункции, МодульФормы, ОписаниеРезультата, ОбработчикФормы));
	Если МодульФормы И ЗначениеЗаполнено(Модуль.ПроцедурыФункции) Тогда
		ЧастиМодуля.Добавить(ПроцедурыФункцииДляФормы(Модуль.ПроцедурыФункции));
	Иначе
		ЧастиМодуля.Добавить(Модуль.ПроцедурыФункции);
	КонецЕсли;
	Возврат СтрСоединить(ЧастиМодуля,Символы.ПС);	
КонецФункции

// Тип Результат формы алгоритма или параметра-выражения для комментария: ссылка на функцию модуля объекта обработки,
// где тип описан по последнему выполнению (см. EDTКлиент_Ei.ТекстМодуляОбъекта, предложение пользователя 2026-11-13).
// EDT разрешает такую ссылку из модуля формы (проверено 2026-11-13). Форма от выполнения не меняется - меняется только
// модуль объекта, поэтому изменения набора по хешу формы не появляются. Без имени обработки - Произвольный
//
// Параметры:
//  ИмяОбработки - Строка - имя обработки набора
//  ИмяФункции - Строка - функция модуля объекта, см. ИмяФункцииАлгоритма, ИмяФункцииПараметра
//
// Возвращаемое значение:
//  Строка
Функция ОписаниеРезультатаФормы(ИмяОбработки, ИмяФункции) Экспорт
	Возврат ?(ЗначениеЗаполнено(ИмяОбработки), СтрШаблон("см. ВнешняяОбработка.%1.%2", ИмяОбработки, ИмяФункции), "Произвольный");
КонецФункции

// Функция модуля объекта обработки с типом результата алгоритма строки набора, см. ОписаниеРезультатаФормы
//
// Параметры:
//  ИмяСтроки - Строка - строка набора
//
// Возвращаемое значение:
//  Строка
Функция ИмяФункцииАлгоритма(ИмяСтроки) Экспорт
	Возврат "Алгоритм__" + ИмяСтроки;
КонецФункции

// Функция модуля объекта обработки с типом параметра, в Ei Параметры("Имя"), см. ВидДляEDT
//
// Параметры:
//  ИмяПараметра - Строка
//
// Возвращаемое значение:
//  Строка
Функция ИмяФункцииПараметра(ИмяПараметра) Экспорт
	Возврат "Параметры__" + ИмяПараметра;
КонецФункции


// Убирает обертку модуля созданную процедурой  См. ПодготовитьМодуль
// Весь текст между служебными абзацами отбрасывается, код из вида для EDT переводится в вид Ei, см. ВидДляEi.
// Табуляция снимается только с тела Результат (оно сдвинуто при записи, см. ПолучитьГлавнуюФункцию):
// собственные процедуры и функции алгоритма записаны как есть, их отступы сохраняются
// 
// Параметры:
//  Модуль  - Строка
// 
// Возвращаемое значение:
//  Строка - Получить выражение из модуля
Функция ПолучитьВыражениеИзМодуля(Знач Модуль) Экспорт
	Начало				= НачалоСлужбногоАбзаца() + Символы.ПС;
	Окончание			= ОкончаниеСлужбногоАбзаца() + Символы.ПС;
	ОбъявлениеГлавной	= НРег(СтрШаблон("Функция %1(", ВыполнитьКлиентСервер_Ei.ИмяГлавнойФункции()));
	Части				= Новый Массив;
	ПослеГлавной		= Ложь;
	НачалоАбзаца		= СтрНайти(Модуль, Начало);
	Пока НачалоАбзаца Цикл
		Часть = Лев(Модуль, НачалоАбзаца - 1);
		Части.Добавить(?(ПослеГлавной, ТелоБезОтступа(Часть), Часть));
		КонецАбзаца		= СтрНайти(Модуль, Окончание, , НачалоАбзаца);
		Абзац			= ?(КонецАбзаца, Сред(Модуль, НачалоАбзаца, КонецАбзаца - НачалоАбзаца), Сред(Модуль, НачалоАбзаца));
		//тело Результат идет сразу после служебного абзаца с ее объявлением
		ПослеГлавной	= СтрНайти(НРег(Абзац), ОбъявлениеГлавной) > 0;
		Модуль			= ?(КонецАбзаца, Сред(Модуль, КонецАбзаца + СтрДлина(Окончание)), "");
		НачалоАбзаца	= СтрНайти(Модуль, Начало);
	КонецЦикла;
	Части.Добавить(?(ПослеГлавной, ТелоБезОтступа(Модуль), Модуль));
	Модуль = СтрСоединить(Части, "");
	//Уберем первый и последний перенос строки, которые рождаются вследствии применения комментариев к модулю 
	//Возможно это и не нужно делать см. РедакторКодаКлиент_Ei.ПолучитьТекст
	Если Лев(Модуль,1) = Символы.ПС Тогда
		Модуль = Сред(Модуль,1+1);
	КонецЕсли;
	Если Прав(Модуль,1) = Символы.ПС Тогда
		Модуль = Лев(Модуль,СтрДлина(Модуль)-1);
	КонецЕсли;
	Возврат ВидДляEi(Модуль);
КонецФункции

// Формирует оператор для пробы компиляции, используя те же правила, что модуль формы.
//
// Параметры:
//  Текст - Строка - основной код в формате Ei
//
// Возвращаемое значение:
//  Строка
Функция ТелоПробыКомпиляции(Текст) Экспорт
	Результат = ВидДляEDT(Текст);
	Если ВидКода(Текст).Вычислять Тогда
		Пока СтрЗаканчиваетсяНа(СокрП(Результат), ";") Цикл
			Результат = Лев(СокрП(Результат), СтрДлина(СокрП(Результат)) - 1);
		КонецЦикла;
		Результат = "Результат = (" + Символы.ПС + Результат + Символы.ПС + ");";
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Код Ei в виде для модуля формы EDT. Встроенные функции Ei вызываются через переменную Модуль - объект обработки,
// в модуле объекта которой они описаны с типами (см. EDTКлиент_Ei.ТекстМодуляОбъекта), а имя строкой
// становится частью имени функции, чтобы EDT знал тип каждого параметра и строки набора:
// Параметры("Склады") - Модуль.Параметры__Склады(), Наборы("КурсВалюты").Параметры("Валюта") -
// Модуль.Наборы__КурсВалюты().Параметры__Валюта(), Варианты("Запрос").Результат() - Модуль.Варианты__Запрос().Результат().
// Вызов с именем не строкой (Параметры(Имя)) получает только Модуль. Обратное преобразование см. ВидДляEi
//
// Параметры:
//  Текст - Строка - код Ei
//
// Возвращаемое значение:
//  Строка
Функция ВидДляEDT(Знач Текст) Экспорт
	
	//Имя("Х") - Имя__Х(), длина текста не меняется
	Для Каждого ИмяФункции Из ФункцииСИменемСтрокой() Цикл
		Образец = НРег(ИмяФункции) + "(""";
		Позиция = СтрНайти(НРег(Текст), Образец);
		Пока Позиция > 0 Цикл
			НачалоИмени = Позиция + СтрДлина(Образец);
			Длина		= ДлинаИмени(Текст, НачалоИмени);
			Если Длина > 0
				И Сред(Текст, НачалоИмени + Длина, 2) = """)"
				И (Позиция = 1 Или Не ЭтоСимволИмени(Сред(Текст, Позиция - 1, 1))) Тогда
				Текст = Лев(Текст, НачалоИмени - 3) + "__" + Сред(Текст, НачалоИмени, Длина) + "()"
					+ Сред(Текст, НачалоИмени + Длина + 2);
			КонецЕсли;
			Позиция = СтрНайти(НРег(Текст), Образец, , Позиция + 1);
		КонецЦикла;
	КонецЦикла;
	
	//вызов без объекта - через Модуль
	Префикс = ПеременнаяМодуля() + ".";
	Для Каждого ИмяФункции Из ВстроенныеФункции() Цикл
		Образец = НРег(ИмяФункции);
		Позиция = СтрНайти(НРег(Текст), Образец);
		Пока Позиция > 0 Цикл
			Если ЭтоВызовВстроеннойФункции(Текст, Позиция, СтрДлина(Образец)) Тогда
				Текст	= Лев(Текст, Позиция - 1) + Префикс + Сред(Текст, Позиция);
				Позиция	= Позиция + СтрДлина(Префикс);
			КонецЕсли;
			Позиция = СтрНайти(НРег(Текст), Образец, , Позиция + 1);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

// Код из вида для модуля формы EDT в виде Ei, обратное к см. ВидДляEDT: Модуль.Параметры__Склады() - Параметры("Склады").
// Применяется при чтении модуля формы и перед выполнением кода, поэтому код из EDT можно вставить в Ei как есть
//
// Параметры:
//  Текст - Строка - код в виде для EDT или в виде Ei
//
// Возвращаемое значение:
//  Строка
Функция ВидДляEi(Знач Текст) Экспорт
	
	Если СтрНайти(Текст, "__") = 0 И СтрНайти(НРег(Текст), НРег(ПеременнаяМодуля() + ".")) = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	
	//Модуль.Имя - Имя
	Префикс = НРег(ПеременнаяМодуля() + ".");
	Для Каждого ИмяФункции Из ВстроенныеФункции() Цикл
		Образец = Префикс + НРег(ИмяФункции);
		Позиция = СтрНайти(НРег(Текст), Образец);
		Пока Позиция > 0 Цикл
			Если ЭтоВызовВстроеннойФункции(Текст, Позиция, СтрДлина(Образец)) Тогда
				Текст = Лев(Текст, Позиция - 1) + Сред(Текст, Позиция + СтрДлина(Префикс));
			КонецЕсли;
			Позиция = СтрНайти(НРег(Текст), Образец, , Позиция + 1);
		КонецЦикла;
	КонецЦикла;
	
	//Имя__Х() - Имя("Х"), длина текста не меняется
	Для Каждого ИмяФункции Из ФункцииСИменемСтрокой() Цикл
		Образец = НРег(ИмяФункции) + "__";
		Позиция = СтрНайти(НРег(Текст), Образец);
		Пока Позиция > 0 Цикл
			НачалоИмени = Позиция + СтрДлина(Образец);
			Длина		= ДлинаИмени(Текст, НачалоИмени);
			Если Длина > 0
				И Сред(Текст, НачалоИмени + Длина, 2) = "()"
				И (Позиция = 1 Или Не ЭтоСимволИмени(Сред(Текст, Позиция - 1, 1))) Тогда
				Текст = Лев(Текст, НачалоИмени - 3) + "(""" + Сред(Текст, НачалоИмени, Длина) + """)"
					+ Сред(Текст, НачалоИмени + Длина + 2);
			КонецЕсли;
			Позиция = СтрНайти(НРег(Текст), Образец, , Позиция + 1);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс
Функция ИмяРеквизитаФормыОбработки() Экспорт
	Возврат СтрШаблон("ОбъектОбработки%1",ОбщегоНазначенияКлиентСервер_Ei.Постфикс());
КонецФункции

// Вид кода без строк и комментариев: выражение или блок операторов.
// Точка с запятой после одиночного присваивания отличает его от сравнения-выражения.
// Присваивание Результат учитывается только в начале оператора, а не в условии или имени свойства.
//
// Параметры:
//  Текст - Строка - код с замененными строками и удаленными комментариями
//
// Возвращаемое значение:
//  Структура:
//   * Вычислять - Булево - выражение
//   * ЕстьРезультат - Булево - блок присваивает переменную Результат
Функция ВидКодаБезСтрок(Знач Текст) Экспорт
	Текст				= СокрЛП(Текст);
	ЕстьЗавершитель		= СтрЗаканчиваетсяНа(Текст, ";");
	Если ЕстьЗавершитель Тогда
		Текст = СокрП(Лев(Текст, СтрДлина(Текст) - 1));
	КонецЕсли;
	ПервоеСлово			= НРег(Лев(Текст, ДлинаИмени(Текст, 1)));
	Блок				= СтрНайти(Текст, ";") > 0 Или КлючевыеСловаОператоров().Найти(ПервоеСлово) <> Неопределено;
	ЕстьРезультат		= Ложь;
	ИмяРезультата		= НРег(ВыполнитьКлиентСервер_Ei.ИмяГлавнойФункции());
	НачалаУсловий		= СтрРазделить("если,иначеесли,пока,для,if,elsif,while,for", ",");
	НачалаТел			= СтрРазделить("тогда,иначе,цикл,попытка,исключение,then,else,do,try,except", ",");
	НачалоОператора		= 1;
	Глубина				= 0;
	Позиция				= 1;
	Пока Позиция <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если ЭтоСимволИмени(Символ) Тогда
			Длина	= ДлинаИмени(Текст, Позиция);
			Слово	= НРег(Сред(Текст, Позиция, Длина));
			Если Глубина = 0 Тогда
				Если НачалаТел.Найти(Слово) <> Неопределено Тогда
					НачалоОператора = Позиция + Длина;
				ИначеЕсли НачалаУсловий.Найти(Слово) <> Неопределено Тогда
					НачалоОператора = 0;
				КонецЕсли;
			КонецЕсли;
			Позиция = Позиция + Длина;
			Продолжить;
		КонецЕсли;
		Если Символ = "(" Или Символ = "[" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = ")" Или Символ = "]" Тогда
			Глубина = Глубина - 1;
		ИначеЕсли Глубина = 0 Тогда
			Если Символ = ";" Тогда
				НачалоОператора = Позиция + 1;
			ИначеЕсли Символ = "=" И НачалоОператора > 0 Тогда
				ЛеваяЧасть = СокрЛП(Сред(Текст, НачалоОператора, Позиция - НачалоОператора));
				Если ЭтоЛеваяЧастьПрисваивания(ЛеваяЧасть) Тогда
					ЕстьРезультат	= ЕстьРезультат Или НРег(ЛеваяЧасть) = ИмяРезультата;
					Блок			= Блок Или ЕстьЗавершитель Или ЕстьРезультат;
				КонецЕсли;
				НачалоОператора = 0;
			КонецЕсли;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат Новый Структура("Вычислять, ЕстьРезультат", Не Блок, ЕстьРезультат);
КонецФункции

// Заменяет каждый строковый литерал числом 0 и удаляет комментарии, сохраняя операторы между строками.
// Парные кавычки внутри строки и многострочные литералы не завершают строку раньше времени.
//
// Параметры:
//  Текст - Строка - исходный код
//
// Возвращаемое значение:
//  Строка - код для определения вида
Функция КодБезСтрокИКомментариев(Текст) Экспорт
	Части			= Новый Массив;
	ВСтроке			= Ложь;
	ВКомментарии	= Ложь;
	Позиция			= 1;
	Пока Позиция <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если ВКомментарии Тогда
			Если Символ = Символы.ПС Тогда
				ВКомментарии = Ложь;
				Части.Добавить(Символ);
			КонецЕсли;
		ИначеЕсли ВСтроке Тогда
			Если Символ = """" Тогда
				Если Сред(Текст, Позиция + 1, 1) = """" Тогда
					Позиция = Позиция + 1;
				Иначе
					ВСтроке = Ложь;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Символ = """" Тогда
			ВСтроке = Истина;
			Части.Добавить("0");
		ИначеЕсли Символ = "/" И Сред(Текст, Позиция + 1, 1) = "/" Тогда
			ВКомментарии = Истина;
			Части.Добавить(" ");
			Позиция = Позиция + 1;
		Иначе
			Части.Добавить(Символ);
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат СтрСоединить(Части);
КонецФункции

#КонецОбласти	

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьГлавнуюФункцию(Выражение, МодульФормы, ОписаниеРезультата = Неопределено, ОбработчикФормы = Истина)
	Если ЗначениеЗаполнено(Выражение) Тогда
		ВидКода		= ВидКода(Выражение);
		Вычислять	= ВидКода.Вычислять;
		//в модуле формы выражение берется в скобки, чтобы точка с запятой стояла сразу за ним: иначе EDT пишет «Пропущена точка с запятой»
		ВСкобках	= Вычислять И МодульФормы И Не СтрЗаканчиваетсяНа(СокрП(Выражение), ";");
		//в модуле формы встроенные функции Ei вызываются через объект обработки, где они описаны с типами
		Текст		= ?(МодульФормы, ВидДляEDT(Выражение), Выражение);
		Строки = Новый Массив;
		Строки.Добавить(НачалоСлужбногоАбзаца());
		Строки.Добавить("//@skip-check export-method-in-command-form-module");
		Строки.Добавить("//@skip-check module-structure-method-in-regions");
		//тип Результат описан по фактическому значению последнего выполнения, у структуры - с полями
		//(см. ОписаниеРезультатаФормы); EDT сверяет поля с выведенными из кода, а там у них часто Произвольный,
		//и пишет «Декларируемое свойство не возвращается»: описание по значению точнее вывода EDT (проверено 2026-11-13)
		Строки.Добавить("//@skip-check constructor-function-return-section");
		Строки.Добавить("//"); 
		Строки.Добавить("//Возвращаемое значение:");
		Строки.Добавить("//	" + ?(ЗначениеЗаполнено(ОписаниеРезультата), ОписаниеРезультата, "Произвольный"));
		Строки.Добавить("//"); 
		Если МодульФормы Тогда
			Строки.Добавить("&НаСервере");
		КонецЕсли;	
		Строки.Добавить(СтрШаблон("Функция %1() Экспорт",ВыполнитьКлиентСервер_Ei.ИмяГлавнойФункции()));
		Если МодульФормы Тогда
			//объект обработки нужен, только если алгоритм вызывает встроенные функции Ei
			Строки.Добавить(Символы.Таб+"//@skip-check module-unused-local-variable");
			Строки.Добавить(Символы.Таб+СтрШаблон("%1 = РеквизитФормыВЗначение(""%2"");",ПеременнаяМодуля(),ИмяРеквизитаФормыОбработки()));
		КонецЕсли;	
		Строки.Добавить(Символы.Таб+?(Вычислять,"Возврат"+?(ВСкобках," (",""),"")+ОкончаниеСлужбногоАбзаца());	
		Для Каждого СтрокаВыражения ИЗ СтрРазделить(Текст,Символы.ПС) Цикл
			Строки.Добавить(Символы.Таб+СтрокаВыражения);
		КонецЦикла;
		Строки.Добавить(НачалоСлужбногоАбзаца());
		//блок без присваивания Результат возвращает Неопределено: переменной Результат в нем нет
		Строки.Добавить(Символы.Таб+?(ВСкобках,")","")+";"+?(Вычислять,"",?(ВидКода.ЕстьРезультат,"Возврат Результат;","Возврат Неопределено;")));
		Если МодульФормы И ОбработчикФормы Тогда
			Строки.Добавить("КонецФункции");
			Строки.Добавить(ОбработчикСозданияФормы());
		Иначе
			Строки.Добавить("КонецФункции"+ОкончаниеСлужбногоАбзаца());
		КонецЕсли;
		Возврат СтрСоединить(Строки,Символы.ПС);
	КонецЕсли;		
КонецФункции

// Определяет вид кода, заменяя строковые литералы и удаляя комментарии.
//
// Параметры:
//  Выражение - Строка - код Ei
//
// Возвращаемое значение:
//  см. ВидКодаБезСтрок
Функция ВидКода(Выражение)
	Возврат ВидКодаБезСтрок(КодБезСтрокИКомментариев(Выражение));
КонецФункции

// Ключевые слова, с которых начинается оператор, а не выражение, см. ВидКодаБезСтрок
//
// Возвращаемое значение:
//  Массив из Строка - в нижнем регистре
Функция КлючевыеСловаОператоров()
	Возврат СтрРазделить("если,для,пока,попытка,перем,вызватьисключение,возврат,прервать,продолжить,перейти,выполнить,"
		+ "if,for,while,try,var,raise,return,break,continue,goto,execute", ",");
КонецФункции

// Проверяет левую часть присваивания: переменная, свойство или индекс элемента.
// Вызов функции сам по себе не является левой частью, но его свойство или элемент - является.
//
// Параметры:
//  Текст - Строка - текст перед знаком равенства
//
// Возвращаемое значение:
//  Булево
Функция ЭтоЛеваяЧастьПрисваивания(Текст)
	ПервоеИмя	= НРег(Лев(Текст, ДлинаИмени(Текст, 1)));
	Результат	= ЗначениеЗаполнено(ПервоеИмя) И СтрНайти("0123456789", Лев(ПервоеИмя, 1)) = 0
		И СтрРазделить("истина,ложь,неопределено,null,true,false,undefined,новый,new", ",").Найти(ПервоеИмя) = Неопределено;
	Позиция		= СтрДлина(ПервоеИмя) + 1;
	Последний	= "имя";
	Пока Результат И Позиция <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если ПустаяСтрока(Символ) Тогда
			Позиция = Позиция + 1;
		ИначеЕсли Символ = "." Тогда
			Позиция = Позиция + 1;
			Пока Позиция <= СтрДлина(Текст) И ПустаяСтрока(Сред(Текст, Позиция, 1)) Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
			Длина		= ДлинаИмени(Текст, Позиция);
			Результат	= Длина > 0;
			Позиция		= Позиция + Длина;
			Последний	= "имя";
		ИначеЕсли Символ = "(" Или Символ = "[" Тогда
			Последний	= ?(Символ = "(", "вызов", "индекс");
			Глубина		= 1;
			Позиция		= Позиция + 1;
			Пока Глубина > 0 И Позиция <= СтрДлина(Текст) Цикл
				Символ = Сред(Текст, Позиция, 1);
				Если Символ = "(" Или Символ = "[" Тогда
					Глубина = Глубина + 1;
				ИначеЕсли Символ = ")" Или Символ = "]" Тогда
					Глубина = Глубина - 1;
				КонецЕсли;
				Позиция = Позиция + 1;
			КонецЦикла;
			Результат = Глубина = 0;
		Иначе
			Результат = Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат И Последний <> "вызов";
КонецФункции

Функция НачалоСлужбногоАбзаца()
	Возврат "//<Ei";
КонецФункции

Функция ОкончаниеСлужбногоАбзаца()
	Возврат "//Ei>";
КонецФункции

// Имя переменной модуля формы EDT с объектом обработки, через нее вызываются встроенные функции Ei, см. ВидДляEDT
//
// Возвращаемое значение:
//  Строка
Функция ПеременнаяМодуля()
	Возврат "Модуль";
КонецФункции

// Обработчик ПриСозданииНаСервере формы алгоритма в проекте EDT - конец служебного абзаца после Результат.
// Обработчик назначен в описании формы (см. EDTКлиент_Ei.СоздатьОписаниеФормы). Ei выполняет форму, получая ее с клиента
// (команда «Выполнить в обработке EDT», см. ВариантАлгоритмКлиент_Ei.ВыполнитьВОбработке). Что делает форма, описано
// один раз - в процедуре ВыполнитьФорму модуля объекта обработки (см. EDTКлиент_Ei.ТекстМодуляОбъекта), в форме только
// ее вызов (с 3.2.8.8, раньше тело повторялось в каждой форме). Объект обработки в Результат остается локальной переменной:
// у переменной модуля формы EDT не выводит тип, и подсказки с типами параметров пропадают (проверено 2026-11-13)
//
// Возвращаемое значение:
//  Строка
Функция ОбработчикСозданияФормы()
	Шаблон = "
	|//@skip-check module-structure-method-in-regions
	|&НаСервере
	|Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	|	//Ei выполняет эту форму командой «Выполнить в обработке EDT», см. ВыполнитьФорму в модуле объекта
	|	РеквизитФормыВЗначение(""%1"").ВыполнитьФорму(ЭтотОбъект, Отказ);
	|КонецПроцедуры";
	Возврат СтрШаблон(Шаблон, ИмяРеквизитаФормыОбработки()) + ОкончаниеСлужбногоАбзаца();
КонецФункции

// Собственные процедуры и функции алгоритма для модуля формы: перед каждым объявлением - служебный абзац с директивой
// &НаСервере (без нее EDT пишет «Пропущена директива компиляции») и исключениями проверок модуля формы.
// Ei вырезает служебные абзацы при чтении формы, см. ПолучитьВыражениеИзМодуля, поэтому текст алгоритма в Ei не меняется.
// Объявление, перед которым уже стоит директива, остается как есть
//
// Параметры:
//  Текст - Строка - процедуры и функции алгоритма, см. ВыполнитьКлиентСервер_Ei.ПолучитьМодуль
//
// Возвращаемое значение:
//  Строка
Функция ПроцедурыФункцииДляФормы(Знач Текст)
	Строки		= Новый Массив;
	Предыдущая	= "";
	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Если ЭтоОбъявлениеМетода(Строка) И Не СтрНачинаетсяС(Предыдущая, "&") Тогда
			Строки.Добавить(НачалоСлужбногоАбзаца());
			Строки.Добавить("//@skip-check module-structure-method-in-regions");
			Строки.Добавить("//@skip-check export-method-in-command-form-module");
			Строки.Добавить("&НаСервере");
			Строки.Добавить(ОкончаниеСлужбногоАбзаца());
		КонецЕсли;
		Строки.Добавить(Строка);
		Если ЗначениеЗаполнено(СокрЛП(Строка)) Тогда
			Предыдущая = СокрЛ(Строка);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Строка - начало объявления процедуры или функции модуля
//
// Параметры:
//  Строка - Строка - строка текста модуля
//
// Возвращаемое значение:
//  Булево
Функция ЭтоОбъявлениеМетода(Строка)
	Начало		= НРег(СокрЛ(Строка));
	Результат	= Ложь;
	Для Каждого Ключевое Из СтрРазделить("процедура ,функция ,асинх ,procedure ,function ,async ", ",", Ложь) Цикл
		Если СтрНачинаетсяС(Начало, Ключевое) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Тело функции Результат из модуля формы без отступа: его строки сдвинуты табуляцией, см. ПолучитьГлавнуюФункцию.
// В начале каждой строки убирается одна табуляция
//
// Параметры:
//  Текст - Строка - тело функции Результат между служебными абзацами
//
// Возвращаемое значение:
//  Строка
Функция ТелоБезОтступа(Знач Текст)
	Строки = Новый Массив;
	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Строки.Добавить(?(СтрНачинаетсяС(Строка, Символы.Таб), Сред(Строка, 2), Строка));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Встроенные функции Ei, которые в модуле формы EDT вызываются через переменную Модуль,
// см. ВыполнитьКлиентСервер_Ei, область ФиксированныеФункции
//
// Возвращаемое значение:
//  Массив из Строка
Функция ВстроенныеФункции()
	Возврат СтрРазделить("Параметры,Наборы,Варианты,Объект,Результат,Клиент,Пауза", ",");
КонецФункции

// Встроенные функции Ei, у которых вызов с именем строкой Имя("Х") в EDT записывается как Имя__Х()
//
// Возвращаемое значение:
//  Массив из Строка
Функция ФункцииСИменемСтрокой()
	Возврат СтрРазделить("Параметры,Наборы,Варианты", ",");
КонецФункции

// Вызов встроенной функции Ei без объекта: перед именем не часть другого имени и не точка,
// после имени - скобка или вид для EDT __Х()
//
// Параметры:
//  Текст - Строка - код
//  Позиция - Число - начало имени функции, с префиксом Модуль. если он есть
//  Длина - Число - длина имени функции с префиксом
//
// Возвращаемое значение:
//  Булево
Функция ЭтоВызовВстроеннойФункции(Текст, Позиция, Длина)
	Если Позиция > 1 Тогда
		Предыдущий = Сред(Текст, Позиция - 1, 1);
		Если Предыдущий = "." Или ЭтоСимволИмени(Предыдущий) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Конец = Позиция + Длина;
	Если Сред(Текст, Конец, 1) = "(" Тогда
		Возврат Истина;
	КонецЕсли;
	ДлинаИмениСтрокой = ?(Сред(Текст, Конец, 2) = "__", ДлинаИмени(Текст, Конец + 2), 0);
	Возврат ДлинаИмениСтрокой > 0 И Сред(Текст, Конец + 2 + ДлинаИмениСтрокой, 2) = "()";
КонецФункции

// Длина имени (идентификатора), которое начинается в позиции
//
// Параметры:
//  Текст - Строка
//  Начало - Число
//
// Возвращаемое значение:
//  Число
Функция ДлинаИмени(Текст, Начало)
	Длина = 0;
	Пока ЭтоСимволИмени(Сред(Текст, Начало + Длина, 1)) Цикл
		Длина = Длина + 1;
	КонецЦикла;
	Возврат Длина;
КонецФункции

// Символ может быть частью имени: буква, цифра или подчеркивание
//
// Параметры:
//  Символ - Строка
//
// Возвращаемое значение:
//  Булево
Функция ЭтоСимволИмени(Символ)
	Возврат Символ <> "" И (Символ = "_" Или СтрНайти("0123456789", Символ) > 0 Или ВРег(Символ) <> НРег(Символ));
КонецФункции
#КонецОбласти	

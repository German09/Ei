#Область ИнтерфейсВариантов

Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",			"Алгоритм");
	Результат.Вставить("Синоним",		"Алгоритм");
	Результат.Вставить("Картинка",		БиблиотекаКартинок.Алгоритм_Ei);
	Результат.Вставить("КартинкаСсылка",ПоместитьВоВременноеХранилище(Результат.Картинка,Новый УникальныйИдентификатор));
	Результат.Вставить("Класс",			ВариантыКлиентСервер_Ei);
	Результат.Вставить("Исполнение",	Истина); //Исполняется и выводит результат или просто возможно сохранение данных
	Возврат Результат;
КонецФункции

Функция ВыполнитьВариант(УникальныйИдентификатор,ДопПараметры,ОбработчикРезультата = Неопределено,ДанныеКлиента) Экспорт
	//Перем КонтекстВыполнения;
	Перем ОписаниеЗначения;
	ТекстВыполняемогоКода = ВариантыКлиентСервер_Ei.ПолучитьИнструкцию(Неопределено,Свойства().Имя,ДопПараметры);	
	Если ЗначениеЗаполнено(ТекстВыполняемогоКода) Тогда
		Если ОбработчикРезультата =  Неопределено ИЛИ  
			 ОбработчикРезультата.ПереопределитьВыполнение(УникальныйИдентификатор,ДопПараметры,ВариантАлгоритмКлиентСервер_Ei,ОписаниеЗначения) Тогда
			ОписаниеЗначения		= ВыполнитьКлиентСервер_Ei.Выражение(ТекстВыполняемогоКода,УникальныйИдентификатор);
		КонецЕсли;		
	КонецЕсли;
	Возврат ОписаниеЗначения;	
КонецФункции

// Подготовить данные для помещения их в параметры сеанса НаборВариантов_Ei
// 
// Параметры:
//  Форма Форма конструктора
//  Строка Строка дерева вариантов
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Подготовить данные:
// * Инструкция 
Функция ПодготовитьДанные(Строка) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Инструкция",Строка[Свойства().Имя]);
	Возврат Новый ФиксированнаяСтруктура(Результат);		
КонецФункции

// Обрабатываем исходные (сырые) данные для представления объекта во встроенном языке 
// 
// Параметры:
//  ИсходныеДанные -Структура,ФиксированнаяСтруктура- Исходные данные подготовленные функцией ПодготовитьДанные() 
// 
// Возвращаемое значение:
// 	Произвольный 
Функция Данные(ИсходныеДанные) Экспорт
	Возврат ИсходныеДанные;
КонецФункции	

// Загрузить данные из файла
// 
// Параметры:
//  Объект		-ДанныеФормыКоллекцияЭлементовДерева - Строка в которую грузим настройку
//  Настройка  	-ФиксированнаяСтруктура,Структура - Сохраненная настройка
//
Процедура ЗагрузитьДанные(Объект,Настройка) Экспорт
	ВариантыКлиентСервер_Ei.ЗагрузитьДанныеПоИмени(Объект,Настройка,ВариантАлгоритмКлиентСервер_Ei);
КонецПроцедуры

#Если Клиент Тогда

Асинх Функция ПередВыполнением(Форма,ДопПараметры) Экспорт
	Возврат Ждать ВариантАлгоритмКлиент_Ei.ПередВыполнением(Форма,ДопПараметры);
КонецФункции

Процедура ПослеВыполнения(Форма,ДанныеКлиента) Экспорт
	Возврат;	
КонецПроцедуры		

Функция ПолучитьРазмерность(Форма,ТД) Экспорт
	Инструкция = ВариантыКлиентСервер_Ei.ПолучитьИнструкцию(Неопределено,Свойства().Имя);;
	Возврат ТекстМодуляКлиент_Ei.ПолучитьЧислоСтрок(Инструкция);
КонецФункции	

Процедура ПриИзмененииДанных(Форма) Экспорт
	ВариантАлгоритмКлиент_Ei.ПриИзмененииДанных(Форма);
Конецпроцедуры

Процедура ПриОтображении(Форма) Экспорт
	ВариантАлгоритмКлиент_Ei.ПриОтображении(Форма);	
Конецпроцедуры

Процедура ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ВариантАлгоритмКлиент_Ei.ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке);
КонецПроцедуры

Процедура УстановитьПараметры(Форма) Экспорт
	Возврат;	
КонецПроцедуры

Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ВариантАлгоритмКлиент_Ei.РасшифровкаОшибки(Форма,Элемент);			
КонецПроцедуры

//Процедура запоминает (не! сохраняет данные)
//запоминание данных необходимо для того чтобы, произошло сохранение данных выведенных на форму
//в типовом варианте они сохраняться только после изменения контекста.
//
Процедура ЗапомнитьДанные(Форма,ТД) Экспорт
	ЭлементИнструкции = ЭлементИнструкции(Форма);	
	Если Не ЭлементИнструкции = Неопределено Тогда
		ТД[Свойства().Имя] =  РедакторКодаКлиент_Ei.ПолучитьТекст(ЭлементИнструкции);
	КонецЕсли;				
КонецПроцедуры

Функция ЭлементИнструкции(Форма) Экспорт 
	Возврат ВариантАлгоритмКлиент_Ei.ЭлементИнструкции(Форма);			
КонецФункции

#КонецЕсли

#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда

Процедура Инициализировать(Форма, Контейнер) Экспорт
	ВариантыВызовСервера_Ei.ИнициализироватьПоИмени(Форма, ВариантАлгоритмКлиентСервер_Ei);
КонецПроцедуры		

#КонецЕсли

#КонецОбласти

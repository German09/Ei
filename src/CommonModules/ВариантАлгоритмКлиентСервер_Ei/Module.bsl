// Размерность варианта для заголовка закладки: число строк текста алгоритма
//
// Параметры:
//  Форма - см. Обработка.Ei.Форма.Форма
//  ТекущиеДанные - ДанныеФормыЭлементДерева - строка дерева наборов
//
// Возвращаемое значение:
//  Число
Функция ПолучитьРазмерность(Форма,ТекущиеДанные) Экспорт
	Инструкция = "";
	Данные = ПодготовитьДанные(ТекущиеДанные);
	Данные.Свойство("Инструкция",Инструкция);
	Возврат ТекстМодуляКлиент_Ei.ПолучитьЧислоСтрок(Инструкция);
КонецФункции


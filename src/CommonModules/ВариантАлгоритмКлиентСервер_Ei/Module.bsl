//Процедура запоминает (не! сохраняет данные)
//запоминание данных необходимо для того чтобы, произошло сохранение данных выведенных на форму
//в типовом варианте они сохраняться только после изменения контекста.
//
Процедура ЗапомнитьДанные(Форма,ТД) Экспорт
	ЭлементИнструкции = ЭлементИнструкции(Форма);	
	Если Не ЭлементИнструкции = Неопределено Тогда
		ТД[Свойства().Имя] =  РедакторКодаКлиент_Ei.ПолучитьТекст(ЭлементИнструкции);
	КонецЕсли;				
КонецПроцедуры


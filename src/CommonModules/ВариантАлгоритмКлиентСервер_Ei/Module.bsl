#Область ПрограммныйИнтерфейс

// Свойства варианта Алгоритм для конструктора Ei
//
// Возвращаемое значение:
//  Структура:
//   * Код - Строка - 12-символьный идентификатор, нужен при сохранении настроек в формат EDT
//   * Имя - Строка - имя варианта
//   * Синоним - Строка - представление варианта
//   * Картинка - Картинка - картинка закладки
//   * Символ - Строка - значок варианта в строке дерева наборов
//   * Класс - ОбщийМодуль - общий обработчик вариантов
//   * Исполнение - Булево - вариант выполняется и выводит результат
//   * ФоновоеВыполнение - Булево - вариант можно выполнить в фоне
Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Код",			"6b0815f87f2d"); //12 символьный идентификатор, необходим при сохранении настроек в формат EDT
	Результат.Вставить("Имя",			"Алгоритм");
	Результат.Вставить("Синоним",		"Алгоритм");
	Результат.Вставить("Картинка",		БиблиотекаКартинок.Алгоритм_Ei);
	Результат.Вставить("Символ",		"✎"); //значок варианта в строке дерева наборов, см. ВариантыКлиент_Ei.СимволыВариантов
	Результат.Вставить("Класс",			ВариантыКлиентСервер_Ei);
	Результат.Вставить("Исполнение",	Истина); //Исполняется и выводит результат или просто возможно сохранение данных
	Результат.Вставить("ФоновоеВыполнение",	Истина); //только на сервере, см. ФоновоеВыполнениеКлиентСервер_Ei.ВариантВыполняетсяВФоне
	Возврат Результат;
КонецФункции

// Выполнить алгоритм строки набора: в месте и режиме из ДопПараметры (запрос MCP) или как см. ВыполнитьКлиентСервер_Ei.Выражение
//
// Параметры:
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор формы для описания значения
//  ДопПараметры - Структура, Неопределено - дополнительные параметры выполнения: место, режим, фрагмент текста
//  ОбработчикРезультата - ОбщийМодуль, Неопределено - обработчик, который может переопределить выполнение
//  ДанныеКлиента - Произвольный - у алгоритма не используется
//
// Возвращаемое значение:
//  Произвольный - описание значения, см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить; Неопределено, если текста нет
Функция ВыполнитьВариант(УникальныйИдентификатор,ДопПараметры,ОбработчикРезультата = Неопределено,ДанныеКлиента = Неопределено) Экспорт
	//Перем КонтекстВыполнения;
	Перем ОписаниеЗначения;
	ТекстВыполняемогоКода = ВариантыКлиентСервер_Ei.ПолучитьИнструкцию(Неопределено,Свойства().Имя,ДопПараметры);	
	Если ЗначениеЗаполнено(ТекстВыполняемогоКода) Тогда
		Если ОбработчикРезультата =  Неопределено ИЛИ  
			 ОбработчикРезультата.ПереопределитьВыполнение(УникальныйИдентификатор,ДопПараметры,ВариантАлгоритмКлиентСервер_Ei,ОписаниеЗначения) Тогда
			//место и режим выполнения заданы заранее, например запросом MCP: выполняем один раз и только там
			МестоВыполнения = Неопределено;
			ОбработкаEDT	= Неопределено;
			Если ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(ДопПараметры, "ОбработкаEDT", ОбработкаEDT) Тогда
				//команда «Выполнить в обработке EDT»: алгоритм выполняет форма обработки, собранной EDT, - в ней останавливается отладчик
				#Если Клиент Тогда
					ОписаниеЗначения	= ВариантАлгоритмКлиент_Ei.ВыполнитьВОбработке(ОбработкаEDT, УникальныйИдентификатор);
				#Иначе
					ВызватьИсключение НСтр("ru = 'Выполнить в обработке EDT можно только из формы Ei: форму обработки получает клиент'");
				#КонецЕсли
			ИначеЕсли ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(ДопПараметры, "МестоВыполнения", МестоВыполнения)
				И ЗначениеЗаполнено(МестоВыполнения) Тогда
				РежимВыражения = Неопределено;
				ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(ДопПараметры, "РежимВыражения", РежимВыражения);
				ОписаниеЗначения	= ВыполнитьКлиентСервер_Ei.ВыражениеВМесте(ТекстВыполняемогоКода,УникальныйИдентификатор,МестоВыполнения,РежимВыражения);
			Иначе
				ОписаниеЗначения	= ВыполнитьКлиентСервер_Ei.Выражение(ТекстВыполняемогоКода,УникальныйИдентификатор);
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
	Возврат ОписаниеЗначения;	
КонецФункции

// Подготовить данные для помещения их в параметры сеанса НаборВариантов_Ei
// 
// Параметры:
//  Строка - ДанныеФормыЭлементДерева - строка дерева наборов
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура:
//   * Инструкция - Строка - текст алгоритма
Функция ПодготовитьДанные(Строка) Экспорт
	Данные = Новый Структура("Инструкция", Строка[Свойства().Имя]);
	//EDT не видит ключи структуры через конструктор ФиксированнаяСтруктура
	//@skip-check constructor-function-return-section
	Возврат Новый ФиксированнаяСтруктура(Данные);
КонецФункции

// Обрабатываем исходные (сырые) данные для представления объекта во встроенном языке 
// 
// Параметры:
//  ИсходныеДанные - Структура,ФиксированнаяСтруктура - Исходные данные подготовленные см. ПодготовитьДанные
// 
// Возвращаемое значение:
// 	Произвольный 
Функция Данные(ИсходныеДанные) Экспорт
	Возврат ИсходныеДанные;
КонецФункции	


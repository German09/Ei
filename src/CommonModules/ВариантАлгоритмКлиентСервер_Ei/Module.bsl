//КонецФункции//Ei>
// 
// Параметры:
//  Модуль  	- см. ВыполнитьКлиентСервер_Ei.ПолучитьМодуль
//  МодульФормы	- Булево - Где будет функция в модуле объекта или в модуле формы
// 
// Возвращаемое значение:
//  Строка 
Функция ПодготовитьМодуль(Модуль, МодульФормы = Истина) Экспорт
	ЧастиМодуля = Новый Массив;	
	ЧастиМодуля.Добавить(ПолучитьГлавнуюФункцию(Модуль.СодержимоеГлавнойФункции, МодульФормы));
	ЧастиМодуля.Добавить(Модуль.ПроцедурыФункции);
	Возврат СтрСоединить(ЧастиМодуля,Символы.ПС);	
КонецФункции


// Убирает обертку модуля созданную процедурой  См. ПодготовитьМодуль
// Весь текст между 
// 
// Параметры:
//  Модуль  - Строка
// 
// Возвращаемое значение:
//  Строка - Получить выражение из модуля
Функция ПолучитьВыражениеИзМодуля(Знач Модуль) Экспорт
	НачалоАбзаца = 1;
	Пока НачалоАбзаца Цикл
		НачалоАбзаца = СтрНайти(Модуль,НачалоСлужбногоАбзаца()+Символы.ПС);
		Если НачалоАбзаца Тогда
			КонецАбзаца	 = СтрНайти(Модуль,ОкончаниеСлужбногоАбзаца()+Символы.ПС,,НачалоАбзаца);
			Модуль = Лев(Модуль,НачалоАбзаца-1) + ?(КонецАбзаца,Сред(Модуль,КонецАбзаца+СтрДлина(ОкончаниеСлужбногоАбзаца()+Символы.ПС)),"");
		КонецЕсли;	
	КонецЦикла;
	//Уберем табулятор
	Модуль = СтрСоединить(СтрРазделить(СтрЗаменить(Символы.ПС+Модуль,Символы.ПС+Символы.Таб,Символ(160)),Символ(160)),Символы.ПС);
	//Уберем первый и последний перенос строки, которые рождаются вследствии применения комментариев к модулю 
	//Возможно это и не нужно делать см. РедакторКодаКлиент_Ei.ПолучитьТекст
	Если Лев(Модуль,1) = Символы.ПС Тогда
		Модуль = Сред(Модуль,1+1);
	КонецЕсли;
	Если Прав(Модуль,1) = Символы.ПС Тогда
		Модуль = Лев(Модуль,СтрДлина(Модуль)-1);
	КонецЕсли;
	Возврат Модуль;					
КонецФункции	

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс
Функция ИмяРеквизитаФормыОбработки() Экспорт
	Возврат СтрШаблон("ОбъектОбработки%1",ОбщегоНазначенияКлиентСервер_Ei.Постфикс());
КонецФункции
#КонецОбласти	

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьГлавнуюФункцию(Выражение, МодульФормы)
	Если ЗначениеЗаполнено(Выражение) Тогда
		Вычислять = ЭтоВычисляемоеВыражение(Выражение);
		Строки = Новый Массив;
		Строки.Добавить(НачалоСлужбногоАбзаца());
		Строки.Добавить("//@skip-check export-method-in-command-form-module");
		Строки.Добавить("//@skip-check module-structure-method-in-regions");
		Строки.Добавить("//"); 
		Строки.Добавить("//Возвращаемое значение:");
		Строки.Добавить("//	Неопределено");
		Строки.Добавить("//"); 
		Если МодульФормы Тогда
			Строки.Добавить("&НаСервере");
		КонецЕсли;	
		Строки.Добавить(СтрШаблон("Функция %1() Экспорт",ВыполнитьКлиентСервер_Ei.ИмяГлавнойФункции()));
		Если МодульФормы Тогда
			Строки.Добавить(Символы.Таб+СтрШаблон("Модуль = РеквизитФормыВЗначение(""%1"");",ИмяРеквизитаФормыОбработки()));
		КонецЕсли;	
		Строки.Добавить(Символы.Таб+?(Вычислять,"Возврат","")+ОкончаниеСлужбногоАбзаца());	
		Для Каждого СтрокаВыражения ИЗ СтрРазделить(Выражение,Символы.ПС) Цикл
			Строки.Добавить(Символы.Таб+СтрокаВыражения);
		КонецЦикла;
		Строки.Добавить(НачалоСлужбногоАбзаца());
		Строки.Добавить(Символы.Таб+";"+?(Вычислять,"","Возврат Результат;"));
		Строки.Добавить("КонецФункции"+ОкончаниеСлужбногоАбзаца());
		Возврат СтрСоединить(Строки,Символы.ПС);
	КонецЕсли;		
КонецФункции

Функция ЭтоВычисляемоеВыражение(Знач Выражение)
	Если СтрНайти(нРег(Выражение),нРег(ВыполнитьКлиентСервер_Ei.ИмяГлавнойФункции())) Тогда
		Если СтрНайти(Выражение,"""") ИЛИ СтрНайти(Выражение,"//") Тогда
			//Тут сложнее 
			//Помещение в переменную может быть сткрыто в стороке или в комментарии
			Результат = ВыполнитьВызовСервера_Ei.ЭтоВычисляемоеВыражение(Выражение);
		Иначе
			//нет ни комментов ни строк
			Результат = Ложь;	
		КонецЕсли;	
	Иначе
		Результат = Истина;
	КонецЕсли;		
	Возврат Результат;
КонецФункции	

Функция НачалоСлужбногоАбзаца()
	Возврат "//<Ei";
КонецФункции

Функция ОкончаниеСлужбногоАбзаца()
	Возврат "//Ei>";
КонецФункции

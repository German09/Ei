// Процедура - открывает диалог выбора для уточнения объекта для следующей обработки 
//
// Параметры:
//  Линия			 	 - ЭлементГрафическойСхемы 		- Соединительная линия графической схемы
//  ВладелецФормы		 - Форма - Форма владелец
//  ОбъектОбработки		 - Форма или Элемент дерева 	- Объект в котором находится ГрафСхемаXDTO         
//  СтруктураПеременных	 - Структура - Структура данных возвращаемая процедурой ПолучитьСтруктуруПеременных из формы <Конструктор>
//  КонтекстВыполнения	 - Структура - Структура контекста выполнения 
//												Параметры
//												ЭтаФорма
//												Объект
//
Процедура НачатьУточнениеОбъектаОбработки(Линия,ВладелецФормы,ОбъектОбработки,СтруктураПеременных,КонтекстВыполнения)
	сзВызовов 		= Новый СписокЗначений;
	ПодготовитьВызовы(сзВызовов,ОбъектОбработки,КонтекстВыполнения);
	
	ОбработкаИмя 	= Линия.НачалоЭлемент.Имя;
	ОО_НачалоЛинии 	= НайтиЗначениеСпискаВызовов(ОбработкаИмя,сзВызовов);
	Если Не ОО_НачалоЛинии = Неопределено Тогда
		СтруктураПеременныхКопия = ОбщийМодульКлиентСервер_Ei.СкопироватьСтруктуру(СтруктураПеременных);//Структурировать(ОбщийМодульКлиентСервер_Ei.Сериализовать(СтруктураПеременных));
		СтруктураПеременныхКопия.ДоступныеСтруктуры.Вставить("Объект",ОО_НачалоЛинии.ДополнительныеПараметры.Объект);
		СтруктураПеременныхКопия.ТекущиеДанные.ЭтоВыражение 		= Истина;
		СтруктураПеременныхКопия.ТекущиеДанные.ЗначениеПараметра 	= Линия.Наименование;
		ОО_Завершения =  Новый ОписаниеОповещения("ЗакончитьУточнениеОбъектаОбработки",ПроцессыКлиент_Ei,Новый Структура("Линия,Форма",Линия,ВладелецФормы));
	    ВыборКлиент_Ei.НачалоВыбора(ОО_Завершения,,ВладелецФормы,Неопределено,СтруктураПеременныхКопия,Ложь,Ложь);
    КонецЕсли;
КонецПроцедуры

// Процедура - Завершает уточнение объекта обработки и устаналивает ему иму наименование
//
// Параметры:
//  Результат		- Структура - Структура текущиъ выбранных данных
//  ДопПараметры	- Структура -
//							Линия - ЭлементГрафическойСхемы - Соединительная линия графической схемы
//							Форма - Форма - Форма владелец
//
Процедура ЗакончитьУточнениеОбъектаОбработки(Результат,ДопПараметры) Экспорт
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(Результат,"ЗначениеПараметра") Тогда
		Если Не ДопПараметры.Линия.Наименование = Результат.ЗначениеПараметра Тогда
			//ДопПараметры.Линия.Наименование = Результат.ЗначениеПараметра; //так не работает и СохранитьИзмененияГрафСхемы() перезатирает все изменения поэтому дальше немного извращения
			ГрафСхема 	= ДопПараметры.Форма.Процессы_ГрафСхема;
			Линия 		= ГрафСхема.ЭлементыГрафическойСхемы.Найти(ДопПараметры.Линия.Имя);
			Если Не Линия = Неопределено Тогда
				Линия.Наименование 		= Результат.ЗначениеПараметра;
				Линия.ПоложениеТекста	= ПоложениеТекстаСоединительнойЛинии.ПервыйСегмент; //тем самым показываем где происходит вычисление объекта
				СохранитьИзмененияГрафСхемы(ГрафСхема,ДопПараметры.Форма);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

// Функция - Найходит описание оповещения по имени элемета схемы в списке вызовов
//
// Параметры:
//  сПредставление	 - Строка -  Имя элемента графической схемы
//	сзВызовов		 - СписокЗначений - В значении: последовательность подготовленных ОписанийОповещений, в представлении: Имя блока в графической схеме
// 
// Возвращаемое значение:
//   - Описание оповещения
//
Функция НайтиЗначениеСпискаВызовов(сПредставление,сзВызовов)
	Для Каждого Элемент Из сзВызовов Цикл
		Если Элемент.Представление = сПредставление Тогда
			Возврат Элемент.Значение;
		ИначеЕсли ТипЗнч(Элемент.Значение) =  Тип("Структура") Тогда
			//переберем вложенные
			Для Каждого КлючЗначение ИЗ Элемент.Значение.сооВызовов Цикл
				Результат =  НайтиЗначениеСпискаВызовов(сПредставление,КлючЗначение.Значение);
				Если Не Результат = Неопределено Тогда
					Возврат Результат;	
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;	
КонецФункции	

Процедура ОО_ДоступныеОбработкиПередУдалением(Результат,ДопПараметры) Экспорт
	ТД = ДопПараметры.Элемент.ТекущиеДанные;
	Если Результат = КодВозвратаДиалога.ОК И Не ТД =  Неопределено Тогда
		Родитель = ТД.ПолучитьРодителя();
		Если Не Родитель = Неопределено Тогда
			ГрафСхемаXDTO 		= СериализаторXDTO.ЗаписатьXDTO(ДопПараметры.ГрафСхема);
			РаботаСГС_Ei.УдалитьОбъектСхемы(ГрафСхемаXDTO,ТД.Имя);
			Родитель.ПолучитьЭлементы().Удалить(ТД);
			ВыполнитьОбработкуОповещения(ДопПараметры.ооСохраненияИзменений,СериализаторXDTO.ПрочитатьXDTO(ГрафСхемаXDTO));
		КонецЕсли; 
	КонецЕсли;	
КонецПроцедуры	

Процедура ОтказатьДляВида(Элемент, Отказ)
	Родитель = Элемент.ТекущиеДанные.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;	
Конецпроцедуры

Процедура ДополнитьНовуюДоступнуюОбработку(Строка,ИмяКадидат,ПодСтроки)
	Строка.Имя 						= ОбщийМодульКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("Имя",СокрЛП(ИмяКадидат)),ПодСтроки);
	Строка.Представление    		= Строка.Имя;
	Строка.ИспользоватьНастройки 	= Истина;
	Строка.КлючНастроек				= Новый УникальныйИдентификатор;
КонецПроцедуры	

#КонецОбласти

#Область ИсполнениеГрафСхемы
	
// Функция - Преобразовать список оповещений в структуру со свойствами ДополнительныеПараметры  и ИмяОбработчика
//
// Параметры:
//  сзОповещения - Список значение	 - Список описаний оповещений
// 
// Возвращаемое значение:
//   - Список значений, где от описаний оповещений остается только структура доп. параметров доступная на сервере
//
Функция ПреобразоватьСписокОповещений(сзОповещения) Экспорт
	Результат = сзОповещения.Скопировать();
	Для Каждого ЭлСЗ Из Результат Цикл
		Если ТипЗнч(ЭлСЗ.Значение) = Тип("ОписаниеОповещения") Тогда
			ЭлСЗ.Значение = ПроцессыКлиентСервер_Ei.СформироватьЗначениеВызова(ЭлСЗ.Значение.ДополнительныеПараметры);
		ИначеЕсли ТипЗнч(ЭлСЗ.Значение) = Тип("Структура") Тогда
	        //тут разные направления
			Для Каждого КлючЗначение ИЗ ЭлСЗ.Значение.сооВызовов Цикл
				ЭлСЗ.Значение.сооВызовов.Вставить(КлючЗначение.Ключ,ПреобразоватьСписокОповещений(КлючЗначение.Значение));	
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;	
	Возврат Результат; 
КонецФункции	

#Область ОбработчикиОповещений

Процедура ОО_ВыполнитьПереходКСледующейОбработке(Результат,ОписаниеПотока) Экспорт
	ОбработкаПрерыванияПользователя();
	Если ТипЗнч(Результат) = Тип("ИнформацияОбОшибке") Тогда
		ПроцессыКлиентСервер_Ei.ВыполнитьПереходКСледующейОбработке(ОписаниеПотока,,Результат);
	Иначе
		ПроцессыКлиентСервер_Ei.ВыполнитьПереходКСледующейОбработке(ОписаниеПотока);
	КонецЕсли;	
КонецПроцедуры


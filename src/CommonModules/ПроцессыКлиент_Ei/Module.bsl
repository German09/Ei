Процедура вЗагрузитьГрупповыеОбработки(ВсеДоступныеОбработки,ДоступныеОбработки,УникальныйИдентификаторФормы) Экспорт
	//пустой список
	Если ВсеДоступныеОбработки = Неопределено Тогда
		ВсеДоступныеОбработки = ПроцессыВызовСервера_Ei.ПолучитьГрупповыеОбработки(стрПрефиксОбработок(),УникальныйИдентификаторФормы);
	КонецЕсли;	
	Для Каждого СвойтваОбработки ИЗ ВсеДоступныеОбработки Цикл
		СтрокаОбработки 	= Неопределено;
		Для Каждого ПодСтрока ИЗ ДоступныеОбработки Цикл
			Если ПодСтрока.Имя = СвойтваОбработки.Имя Тогда
				СтрокаОбработки 	= ПодСтрока;
				СсылкаНаКартинку 	= СтрокаОбработки.СсылкаНаКартинку;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		Если СтрокаОбработки = Неопределено Тогда
			СтрокаОбработки = ДоступныеОбработки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОбработки,СвойтваОбработки);
		КонецЕсли;
		СтрокаОбработки.СсылкаНаКартинку = СвойтваОбработки.Картинка18;
	КонецЦикла;	
Конецпроцедуры	

// Функция - Получает доступную обработку из дерева
//
// Параметры:
//  КоллекцияСтрок	 - Элементы дерева значения	 - строки дерева выбранных обработок
//  сИмя			 - Строка	-  Имя элмента графической схемы
// 
// Возвращаемое значение:
//   - Строка дерева доступных обработок
//
Функция ПолучитьДоступнуюОбработку(КоллекцияСтрок,сИмя)
	мИмяПоиска = СтрРазделить(сИмя,стрРазделительИмени(),Ложь);
	Для Каждого сИмяПоиска ИЗ мИмяПоиска Цикл
		мСтрок = ОбщийМодульКлиент_Ei.НайтиВКоллекцииДерева(Новый Структура("Имя",сИмяПоиска),КоллекцияСтрок);
		Если мСтрок.Количество() Тогда
			Возврат мСтрок[0];
		КонецЕсли;
		Прервать;
	КонецЦикла;	
КонецФункции

Процедура ОткрытьНайстройкуОбработки(ОО_ВыполнитьОбработку,ИмяЭлемента,ВладелецФормы,ОбъектОбработки,Знач СтруктураПеременных) 
	СтрокаОбработки = ПолучитьДоступнуюОбработку(ОбъектОбработки.ДоступныеОбработки.ПолучитьЭлементы(),ИмяЭлемента);
	Если Не СтрокаОбработки =  Неопределено Тогда
		ОО_Закрытия	= Новый ОписаниеОповещения("ОО_ЗакрытьОбработку",ПроцессыКлиент_Ei,СтрокаОбработки);
		ФормаОбработки = ОткрытьФорму(ОО_ВыполнитьОбработку.Модуль.ИмяФормы,,ВладелецФормы,,,,ОО_Закрытия,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		//дополняем структуру переменных из ДопПараметров ОО_ВыполнитьОбработку
		ОО_ДопПараметры	= ОО_ВыполнитьОбработку.ДополнительныеПараметры;
		//скопируем структуру и переобпределим объект в них, иначе можем потерять исходный объект
		СтруктураПеременныхКопия = ОбщийМодульКлиентСервер_Ei.СкопироватьСтруктуру(СтруктураПеременных);//Структурировать(ОбщийМодульКлиентСервер_Ei.Сериализовать(СтруктураПеременных));
		СтруктураПеременныхКопия.ДоступныеСтруктуры.Вставить("Объект",ОО_ДопПараметры.Объект);
		ФормаОбработки.СтруктураПеременных  = СтруктураПеременныхКопия;
		ФормаОбработки.Заголовок 			= СтрокаОбработки.Представление;
		ФормаОбработки.ЗагрузитьНастройку(ОО_ДопПараметры.Настройка);
	КонецЕсли;
КонецПроцедуры

Процедура ОткрытьПозициюОбработки(ИмяЭлемента,ВладелецФормы,ОбъектОбработки,СтруктураПеременных,КонтекстВыполнения) 
	//необходимо структуру переменных дополнить объектом, объект для обработки это возвращаемый элемент предыдущего шага выполнения, поэтому получим список выполнения
	сзВызовов 	= Новый СписокЗначений;
	ГрафСхема 	= ОбщийМодульКлиентСервер_Ei.Структурировать(ОбъектОбработки.ГрафСхемаXDTO,Новый ГрафическаяСхема);
	ЗаполнитьСписокВызовов(сзВызовов,ПроцессыВызовСервера_Ei.ПолучитьМассивНаправления(ГрафСхема),ОбъектОбработки,КонтекстВыполнения,КонтекстВыполнения.Объект);
	ОО_ВыполнитьОбработку = НайтиЗначениеСпискаВызовов(ИмяЭлемента,сзВызовов);
	Если Не ОО_ВыполнитьОбработку = Неопределено Тогда
		ОткрытьНайстройкуОбработки(ОО_ВыполнитьОбработку,ИмяЭлемента,ВладелецФормы,ОбъектОбработки,СтруктураПеременных); 	
	КонецЕсли;	
КонецПроцедуры

Функция НайтиЗначениеСпискаВызовов(сПредставление,сзВызовов)
	Для Каждого Элемент Из сзВызовов Цикл
		Если Элемент.Представление = сПредставление Тогда
			Возврат Элемент.Значение;
		ИначеЕсли ТипЗнч(Элемент.Значение) =  Тип("Массив") Тогда
			//переберем сложенные
			Для Каждого сзВложенныхВызовов ИЗ Элемент.Значение Цикл
				Результат =  НайтиЗначениеСпискаВызовов(сПредставление,сзВложенныхВызовов);
				Если Не Результат = Неопределено Тогда
					Возврат Результат;	
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;	
КонецФункции

Функция ПолучитьИмяФормыОбработки(СтрокаОбработки)
	СтрокаВида 	= ?(СтрокаОбработки.ПолучитьРодителя() = Неопределено,СтрокаОбработки,СтрокаОбработки.ПолучитьРодителя());
	Возврат "Обработка."+стрПрефиксОбработок()+СтрокаВида.Имя+".Форма"	
КонецФункции	

Процедура ОО_ЗакрытьОбработку(Результат,СтрокаОбработки) Экспорт
	Если Не Результат = Неопределено Тогда	
		СтрокаОбработки.Настройка = Результат;	
	КонецЕсли;	
КонецПроцедуры	

Процедура ОО_ДоступныеОбработкиПередУдалением(Результат,ДопПараметры) Экспорт
	ТД = ДопПараметры.Элемент.ТекущиеДанные;
	Если Результат = КодВозвратаДиалога.ОК И Не ТД =  Неопределено Тогда
		Родитель = ТД.ПолучитьРодителя();
		Если Не Родитель = Неопределено Тогда
			ГрафСхемаXDTO 		= СериализаторXDTO.ЗаписатьXDTO(ДопПараметры.ГрафСхема);
			РаботаСГС_Ei.УдалитьОбъектСхемы(ГрафСхемаXDTO,ТД.Имя);
			Родитель.ПолучитьЭлементы().Удалить(ТД);
			ВыполнитьОбработкуОповещения(ДопПараметры.ооСохраненияИзменений,СериализаторXDTO.ПрочитатьXDTO(ГрафСхемаXDTO));
		КонецЕсли; 
	КонецЕсли;	
КонецПроцедуры	

Процедура ОтказатьДляВида(Элемент, Отказ)
	Родитель = Элемент.ТекущиеДанные.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;	
Конецпроцедуры

#КонецОбласти

#Область ИсполнениеГрафСхемы

// Процедура - Выполнить процесс
//
// Параметры:
//  ОбъектОбработки		 	- Форма и Элемент дерева 	- Объект в котором находится ГрафСхемаXDTO
//  КонтекстВыполнения	 	- Структура		 - Структура контекста выполнения 
//												Параметры
//												ЭтаФорма
//												Объект
//												ТекущиеДанные
//												СтрокаТЧ	
//
Процедура ВыполнитьПроцесс(ОбъектОбработки,КонтекстВыполнения) Экспорт
	сзВызовов 	= Новый СписокЗначений;
	УдалитьЭлементыСостояния(ОбъектОбработки);
	ГрафСхема 	= ОбщийМодульКлиентСервер_Ei.Структурировать(ОбъектОбработки.ГрафСхемаXDTO,Новый ГрафическаяСхема);
	ЗаполнитьСписокВызовов(сзВызовов,ПроцессыВызовСервера_Ei.ПолучитьМассивНаправления(ГрафСхема),ОбъектОбработки,КонтекстВыполнения,КонтекстВыполнения.Объект);
	ЗапуститьПотокВыполнения(ОбъектОбработки,сзВызовов,КонтекстВыполнения);
КонецПроцедуры

// Процедура - Заполняет массив вызовов на основании массив направления, массив напаравление - это просто имя настройк доступной обработки. 
// 
// Параметры:
//  сзВызовов		 		- СписокЗначений - Возвращаемый/пополняемый параметр  в значении: последовательность подготовленных ОписанийОповещений, в представлении: Имя блока в грфической схеме
//  мНаправления	 		- Массив - Содержит имя настройки доступной обработки
//  ОбъектОбработки	 		- Форма и Элемент дерева 	- Объект в котором находится Дерево Доступных обработок
//  КонтекстВыполнения	 	- Структура		 - Структура контекста выполнения 
//												Параметры
//												ЭтаФорма
//												Объект
//												ТекущиеДанные
//												СтрокаТЧ
// стрВозвращаемоеЗначение 	- Структура - Описание возврашаемого значения предыдущего шага обработки, задается при старте и в случае рекурсивного вызова/развилки по направлениям, 
//											своства структуры возвращаются функцией ОбщийМодульСервер_Ei.ПолучитьОписаниеЗначения
//
Процедура ЗаполнитьСписокВызовов(сзВызовов,мНаправления,ОбъектОбработки,КонтекстВыполнения,Знач стрВозвращаемоеЗначение=Неопределено)
	Для Каждого ОбъектНаправления ИЗ мНаправления Цикл
		Если ТипЗнч(ОбъектНаправления) = Тип("Строка") Тогда
			//это шаг в там же направлении
			СтрокаОбработки = ПолучитьДоступнуюОбработку(ОбъектОбработки.ДоступныеОбработки.ПолучитьЭлементы(),ОбъектНаправления);	
			Если Не СтрокаОбработки =  Неопределено Тогда
				ФормаОбработки  		= ПолучитьФорму(ПолучитьИмяФормыОбработки(СтрокаОбработки));
				ОО_ДопПараметры			= Новый Структура;
				ОО_ДопПараметры.Вставить("Настройка",СтрокаОбработки.Настройка);
				ОО_ДопПараметры.Вставить("Объект",стрВозвращаемоеЗначение); //в объект запишем стрктуру возвращаемого значения предыдущего вызова
				//тут получаем адрес в котором будет размещатся результат выполнения
				стрВозвращаемоеЗначение	= ФормаОбработки.ПолучитьОписаниеВозврЗначения(СтрокаОбработки.Настройка,КонтекстВыполнения); 
				ОО_ДопПараметры.Вставить("ВозвращаемоеЗначение",стрВозвращаемоеЗначение);
				ОО_ВыполнитьОбработку	= Новый ОписаниеОповещения("ОО_ВыполнитьОбработку",ФормаОбработки,ОО_ДопПараметры);
				сзВызовов.Добавить(ОО_ВыполнитьОбработку,ОбъектНаправления);	
			КонецЕсли;
		Иначе
			мВложенныхВызовов = Новый Массив;
			сзВызовов.Добавить(мВложенныхВызовов);
			//тут пошло в разные направления
			Для Каждого мВложенногоНаправления ИЗ ОбъектНаправления Цикл
				сзВложенногоВызова = Новый СписокЗначений;
				мВложенныхВызовов.Добавить(сзВложенногоВызова);
				ЗаполнитьСписокВызовов(сзВложенногоВызова,мВложенногоНаправления,ОбъектОбработки,КонтекстВыполнения,стрВозвращаемоеЗначение);	
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры	

// Процедура - Выполняет, один шаг, переход к процедуре выполнения обработки, или запускает выполнение новых потоков (последовательности выполнения)
// Обратный вызов процедуры происходит из процедур ВыполнитьОбработку ОбработкиEi_
//
// Параметры:
//  ОписаниеПотока	 - Структура 	- Структура формируемая процедурой ЗапуститьПотокВыполнения()
//										- сзВызовов 		- СписокЗначений		- последовательность подготовленных ОписанийОповещений вызова обоработок, первой располагется следующая к запуску обработка
//										- ОО				- Описание оповещения   - обрабтный вызов из процедуры выполнения обработки, процедуры менеджера потоков
//										- Контекст  		- Структура  			-  Аналог структуры "ДоступныеСтруктуры" из переменной формы СтруктураПеременных
//										- ОбъектОбработки   - Форма и Элемент дерева 	- Объект в котором находится ГрафСхемаXDTO
//                                      - ДатаНачала		- Число 					- Хранит текущую универсальную дату запуска послдней обработки
//
Процедура ВыполнитьПереходКСледующейОбработке(ОписаниеПотока,ПервыйШагПотока = Ложь,ИнформацияОбОшибке = Неопределено)
	Перем ПредОбработка_ДопПараметры; //
	Если Не ПервыйШагПотока И ОписаниеПотока.сзВызовов.Количество() Тогда
		ПредОбработка = ОписаниеПотока.сзВызовов[0];
		ПредОбработка_ДопПараметры = ПредОбработка.Значение.ДополнительныеПараметры;
		//Удалим предыдущую обработку
		ОтметитьФактВыполненияОбработки(ОписаниеПотока,ПредОбработка.Представление,ИнформацияОбОшибке);
		ОписаниеПотока.сзВызовов.Удалить(ПредОбработка);
	КонецЕсли;	
	Для Каждого ОбъектПотока ИЗ ОписаниеПотока.сзВызовов Цикл
		Если Не ПредОбработка_ДопПараметры = Неопределено Тогда
			//Возвращаемое значение предыдущей обработки перададим как объект в контекст
			ОписаниеПотока.Контекст.Объект = ПредОбработка.Значение.ДополнительныеПараметры.ВозвращаемоеЗначение;
		КонецЕсли;
		Если ТипЗнч(ОбъектПотока.Значение) = Тип("ОписаниеОповещения") Тогда
			ОписаниеПотока.ДатаНачала	=  ТекущаяУниверсальнаяДатаВМиллисекундах();
			ОО_КСледующей = Новый ОписаниеОповещения("ОО_ВыполнитьПереходКСледующейОбработке",ПроцессыКлиент_Ei,ОписаниеПотока);
			ВыполнитьОбработкуОповещения(ОбъектПотока.Значение,ОО_КСледующей); //выполняем новую обработку за счет выполнения ОО_ВыполнитьОбработку, после ее выполнения будет вызвана ОО_КСледующей
		Иначе
			//тут массив и производим запуск нескольких потоков
			Для Каждого сзВызовов из ОбъектПотока Цикл
				ЗапуститьПотокВыполнения(ОписаниеПотока.ОбъектОбработки,сзВызовов,ОписаниеПотока.Контекст);
			КонецЦикла;	
		КонецЕсли;	
		Прервать;
	КонецЦикла;	
КонецПроцедуры

// Процедура - Формирует 2 структуры потока выполнения. краткую, просто для фиксации 
//
// Параметры:
//  сзВызовов - СписокЗначений - Последовательность подготовленных ОписанийОповещений
//
Процедура ЗапуститьПотокВыполнения(ОбъектОбработки,сзВызовов,Контекст)
	ОписаниеПотока = Новый Структура;
	ОписаниеПотока.Вставить("сзВызовов",сзВызовов);	
	ОписаниеПотока.Вставить("ОбъектОбработки",ОбъектОбработки); //Для отображения факта выполнения
	ОписаниеПотока.Вставить("ДатаНачала",0); 					//Для подсчета времени выполненя обработки
	ОписаниеПотока.Вставить("Контекст",	Контекст);
	//Выполняем переход к первой обработке потока
	ВыполнитьПереходКСледующейОбработке(ОписаниеПотока,Истина);
КонецПроцедуры

#Область ОбработчикиОповещений

Процедура ОО_ВыполнитьПереходКСледующейОбработке(Результат,ОписаниеПотока) Экспорт
	Если ТипЗнч(Результат) = Тип("ИнформацияОбОшибке") Тогда
		ВыполнитьПереходКСледующейОбработке(ОписаниеПотока,,Результат);
	Иначе
		ВыполнитьПереходКСледующейОбработке(ОписаниеПотока);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область Индикация

// Процедура - Отметить факт выполнения обработки
//
// Параметры:
//  ОписаниеПотока	 	- Структура - Структура формируемая процедурой ЗапуститьПотокВыполнения()
//  ИмяЭлмента		 	- Строка	 - Имя элемента графической схемы к которому нужно добавить статус выполнения
//	ИнформацияОбОшибке  - ИнформацияОбОшибке - Информация об ошибке или непределено
//
Процедура ОтметитьФактВыполненияОбработки(ОписаниеПотока,ИмяЭлемента,ИнформацияОбОшибке)
	Ширина 				= 180;
	Высота 				= 27; //если 30 то будет видны строки следующего перехода
	ГрафСхема 			= ОбщийМодульКлиентСервер_Ei.Структурировать(ОписаниеПотока.ОбъектОбработки.ГрафСхемаXDTO,Новый ГрафическаяСхема);
	ГрафСхемаXDTO 		= СериализаторXDTO.ЗаписатьXDTO(ГрафСхема);
	стрИмяЭлемента		= ИмяЭлемента+ПеречисленияКлиентСерверПовторноеИспользование_Ei.ПризнакСостояния();
	ЭлементСостояние 	= ГрафСхема.ЭлементыГрафическойСхемы.Найти(стрИмяЭлемента);
	Если ЭлементСостояние =  Неопределено Тогда
		ЭлементОсновной 	= ГрафСхема.ЭлементыГрафическойСхемы.Найти(ИмяЭлемента);
		Если Не ЭлементОсновной = Неопределено Тогда
			Начало 		= ЭлементОсновной.Лево + ЭлементОсновной.Ширина - 30;
			НачалоВерх	= ЭлементОсновной.Верх - Высота; 
			НовЭлемент 	= РаботаСГС_Ei.НовыйОбъектДекорация(ГрафСхемаXDTO,стрИмяЭлемента,"",ФигурыГрафическойСхемы.Нет,Начало,НачалоВерх,Ширина,Высота);
			ГрафСхемаXDTO.item.Добавить(НовЭлемент);
			ГрафСхема 	= СериализаторXDTO.ПрочитатьXDTO(ГрафСхемаXDTO);
			ЭлементСостояние = ГрафСхема.ЭлементыГрафическойСхемы[стрИмяЭлемента];
		КонецЕсли;	
	КонецЕсли;
	Если Не ЭлементСостояние = Неопределено Тогда
		Если ИнформацияОбОшибке =  Неопределено Тогда
			ЭлементСостояние.Картинка 	= БиблиотекаКартинок.Информация_Ei;
			ДопИнформация 				= "";
		Иначе
			ЭлементСостояние.Картинка 	= БиблиотекаКартинок.Предупреждение_Ei;
			ДопИнформация 				= " "+КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		КонецЕсли;	
		
		Если Не ОписаниеПотока.ДатаНачала = 0 Тогда
			ЭлементСостояние.Наименование  				= ОбщийМодульЗакрытыйКлиент_Ei.вФорматироватьВремя(ТекущаяУниверсальнаяДатаВМиллисекундах() - ОписаниеПотока.ДатаНачала) + ДопИнформация;
		Иначе
			ЭлементСостояние.Наименование  				= "";
		КонецЕсли;	
		ЭлементСостояние.ПрозрачныйФон  				= Истина;
		ЭлементСостояние.ГоризонтальноеПоложение  		= ГоризонтальноеПоложение.Лево;
		ОписаниеПотока.ОбъектОбработки.ГрафСхемаXDTO	= ОбщийМодульКлиентСервер_Ei.Сериализовать(ГрафСхема);
		Оповестить("ОбновитьГрафическуюСхему");
	КонецЕсли;	
КонецПроцедуры

// Процедура - Удалить элементы состояния, которые могли остаться от предыдущего выполнения схемы
//
// Параметры:
//  ОбъектОбработки		 	- Форма и Элемент дерева 	- Объект в котором находится ГрафСхемаXDTO
//
Процедура УдалитьЭлементыСостояния(ОбъектОбработки)
	Изменяли 		= Ложь;
	ГрафСхема 		= ОбщийМодульКлиентСервер_Ei.Структурировать(ОбъектОбработки.ГрафСхемаXDTO,Новый ГрафическаяСхема);
	ГрафСхемаXDTO 	= СериализаторXDTO.ЗаписатьXDTO(ГрафСхема);
	Для Каждого Элемент ИЗ  ГрафСхема.ЭлементыГрафическойСхемы Цикл
		Если ТипЗнч(Элемент) = тип("ЭлементГрафическойСхемыДекорация") И СтрЗаканчиваетсяНа(Элемент.Имя,ПеречисленияКлиентСерверПовторноеИспользование_Ei.ПризнакСостояния()) Тогда
			РаботаСГС_Ei.УдалитьОбъектСхемы(ГрафСхемаXDTO,Элемент.Имя);
			Изменяли = Истина;
		КонецЕсли;	
	КонецЦикла;
	Если Изменяли Тогда
		ГрафСхема 	= СериализаторXDTO.ПрочитатьXDTO(ГрафСхемаXDTO);
		ОбъектОбработки.ГрафСхемаXDTO	= ОбщийМодульКлиентСервер_Ei.Сериализовать(ГрафСхема);
		Оповестить("ОбновитьГрафическуюСхему");
	КонецЕсли;	
КонецПроцедуры	

#КонецОбласти

#КонецОбласти

#Область СериализацияСтруктурирование

&НаКлиенте
Функция ПолучитьСоотвествиеПроцесса(ОбъектОбработки) Экспорт
	Результат = Новый Соответствие;
	Результат.Вставить("",						ПолучитьСписокОбработок(ОбъектОбработки.ДоступныеОбработки.ПолучитьЭлементы()));
	Результат.Вставить("GraphicalSchema.xml", 	ОбъектОбработки.ГрафСхемаXDTO);
	Возврат Результат;
КонецФункции	

// Функция - Формирует список доступных обработок, которые имеют сохраненные настройки
// обратно перобразуется функцией ДобавитьОбработкиВКоллекцию()
//
// Параметры:
//  Коллекция	 - ДанныеФормыКоллекцияЭлементовДерева  	-  Строки дерева доступный обработок- 
// 
// Возвращаемое значение:
//   -  Список значений
//
Функция ПолучитьСписокОбработок(Коллекция)
	сзПроцессов = Новый СписокЗначений;
	Для Каждого Строка ИЗ Коллекция Цикл
		Если Строка.ИспользоватьНастройки Тогда
			Значение = Новый Соответствие;
			Значение.Вставить("Settings.xml",	ОбщийМодульКлиент_Ei.ПолучитьСтруктуруДанных(Строка,"Представление,Настройка"));
			сзВложенных = ПолучитьСписокОбработок(Строка.ПолучитьЭлементы());
			Значение.Вставить("",				сзВложенных);
			Если сзВложенных.Количество() ИЛИ Не Строка.Получитьродителя() = Неопределено Тогда
				//добавим только в том случае если у вида есть хоть одна сохраненная настройка
				сзПроцессов.Добавить(Значение,Строка.Имя);
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	Возврат сзПроцессов;	
КонецФункции

#КонецОбласти
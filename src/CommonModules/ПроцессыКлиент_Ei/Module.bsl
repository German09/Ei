// Процессы на клиенте: графическая схема процесса и дерево доступных обработок, показатели выполнения
// обработок на схеме и ход процесса, выполняющегося в фоне, см. ПоказатьХод

#Область ПрограммныйИнтерфейс

#Область ОбработчикиПоляГрафическойСхемы

// Обработчик активизации элемента схемы: активизирует его обработку в дереве доступных обработок
// и показывает контекст, с которым обработка выполнялась.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с процессом, см. ОбщаяФорма.Процессы_Ei
//  Элемент - ПолеФормы - поле графической схемы
//
Процедура ПолеГрафСхемыПриАктивизации(Форма, Элемент) Экспорт
	
	ОбъектОбработки = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	ЭлементСхемы = Элемент.ТекущийЭлемент;
	Если ОбъектОбработки = Неопределено Или ЭлементСхемы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Найденные = ОбщегоНазначенияКлиентСервер_Ei.НайтиВКоллекцииДерева(Новый Структура("Имя", ИмяОбработкиЭлемента(ЭлементСхемы.Имя)),
		ОбъектОбработки.ДоступныеОбработки.ПолучитьЭлементы());
	Для Каждого СтрокаОбработки Из Найденные Цикл
		Форма.Элементы.ДоступныеОбработки.ТекущаяСтрока = СтрокаОбработки.ПолучитьИдентификатор();
		// Контекст обработки устанавливается в параметре сеанса, только если обработка найдена
		АктуализироватьКонтекст(ЭлементСхемы, Форма);
		СтруктураПеременных = ОбщегоНазначенияКлиент_Ei.ПолучитьСтруктуруПеременных(Форма, Неопределено, Неопределено, Ложь, Ложь, Ложь);
		ДополнитьДоступныеПеременные(СтруктураПеременных.ДоступныеСтруктуры);
		ФормаРодитель = ВыборКлиент_Ei.НаследоватьВыбор(Форма, Форма.Элементы.Выбор, Форма.Элементы.ГруппаОбычнаяКонтекст);
		КнопкаЗакрыть = Форма.Элементы.ДеревоВыбораКнопкаЗакрыть;
		Если КнопкаЗакрыть.Видимость Тогда
			КнопкаЗакрыть.Видимость = Ложь;
		КонецЕсли;
		ВыборКлиент_Ei.НачалоВыбора(Неопределено, ФормаРодитель.Выбор, Форма, Форма.Элементы.ВыборОбъекта, СтруктураПеременных, Ложь, Ложь);
		Прервать;
	КонецЦикла;
	
КонецПроцедуры

// Обработчик выбора элемента схемы: у линии - уточнение объекта, у обработки - ее настройка.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с процессом
//  Элемент - ПолеФормы - поле графической схемы
//
Процедура ПолеГрафСхемыВыбор(Форма, Элемент) Экспорт
	
	ОбъектОбработки = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	ЭлементСхемы = Элемент.ТекущийЭлемент;
	Если ОбъектОбработки = Неопределено Или ЭлементСхемы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ЭлементСхемы) = Тип("ЭлементГрафическойСхемыДекорация") Тогда
		Возврат; // показатели выполнения обработки
	ИначеЕсли ТипЗнч(ЭлементСхемы) = Тип("ЭлементГрафическойСхемыСоединительнаяЛиния") Тогда
		НачатьУточнениеОбъектаОбработки(ЭлементСхемы, Форма);
	Иначе
		ОткрытьНастройкуОбработки(ЭлементСхемы, Форма, ОбъектОбработки, Форма.КэшПользователя);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик изменения схемы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с процессом
//  Элемент - ПолеФормы - поле графической схемы
//
Процедура ПолеГрафСхемыПриИзменении(Форма, Элемент) Экспорт
	
	СохранитьИзмененияГрафСхемы(Форма.Процессы_ГрафСхема, Форма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиДереваОбработок

// Обработчик активизации строки дерева доступных обработок: активизирует ее элемент на схеме.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с процессом
//  Элемент - ТаблицаФормы - дерево доступных обработок
//
Процедура ДоступныеОбработкиПриАктивизацииСтроки(Форма, Элемент) Экспорт
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НайденныйЭлемент = Неопределено;
	Для Каждого ЭлементСхемы Из Форма.Процессы_ГрафСхема.ЭлементыГрафическойСхемы Цикл
		Если НРег(ИмяОбработкиЭлемента(ЭлементСхемы.Имя)) = НРег(ТекущиеДанные.Имя) Тогда
			НайденныйЭлемент = ЭлементСхемы;
		КонецЕсли;
	КонецЦикла;
	Если НайденныйЭлемент <> Неопределено Тогда
		Форма.Элементы.Процессы_ГрафСхема.ТекущийЭлемент = НайденныйЭлемент;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик выбора в дереве доступных обработок: добавляет обработку на схему. У вида обработки с настройками
// сначала добавляется новая настроенная обработка.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с процессом
//  Элемент - ТаблицаФормы - дерево доступных обработок
//  ВыбраннаяСтрока - Число - идентификатор строки
//  Поле - ПолеФормы
//  СтандартнаяОбработка - Булево
//
Процедура ДоступныеОбработкиВыбор(Форма, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) Экспорт
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Родитель = ТекущиеДанные.ПолучитьРодителя();
	Если Родитель = Неопределено И ТекущиеДанные.ИспользоватьНастройки = Истина Тогда
		ПодСтроки = ТекущиеДанные.ПолучитьЭлементы();
		СтрокаОбработки = ПодСтроки.Добавить();
		ДополнитьНовуюДоступнуюОбработку(СтрокаОбработки, ТекущиеДанные.Имя + "1", ПодСтроки);
	Иначе
		СтрокаОбработки = ТекущиеДанные;
	КонецЕсли;
	// Тип элемента схемы задает вид обработки
	ТипЭлемента = ?(Родитель = Неопределено, ТекущиеДанные.ТипЭлемента, Родитель.ТипЭлемента);
	ДобавитьОбработкуВГрафСхему(Форма.Процессы_ГрафСхема, СтрокаОбработки, ТипЭлемента, ОписаниеСохраненияСхемы(Форма));
	
КонецПроцедуры

// Обработчик удаления в дереве доступных обработок: удаляется только настроенная обработка, после вопроса.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с процессом
//  Элемент - ТаблицаФормы - дерево доступных обработок
//  Отказ - Булево
//
Процедура ДоступныеОбработкиПередУдалением(Форма, Элемент, Отказ) Экспорт
	
	ОтказатьДляВида(Элемент, Отказ);
	Если Не Отказ Тогда
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Элемент", 			Элемент);
		ДополнительныеПараметры.Вставить("ГрафСхема", 			Форма.Процессы_ГрафСхема);
		ДополнительныеПараметры.Вставить("ОписаниеСохранения", 	ОписаниеСохраненияСхемы(Форма));
		ПоказатьВопрос(Новый ОписаниеОповещения("ОО_ДоступныеОбработкиПередУдалением", ПроцессыКлиент_Ei, ДополнительныеПараметры),
			НСтр("ru = 'Удалить настройку обработки?'"), РежимДиалогаВопрос.ОКОтмена, 15);
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик начала изменения в дереве доступных обработок: вид обработки не изменяется.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с процессом
//  Элемент - ТаблицаФормы - дерево доступных обработок
//  Отказ - Булево
//
Процедура ДоступныеОбработкиПередНачаломИзменения(Форма, Элемент, Отказ) Экспорт
	
	ОтказатьДляВида(Элемент, Отказ);
	
КонецПроцедуры

// Обработчик начала редактирования в дереве доступных обработок: новой обработке - уникальное имя.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с процессом
//  Элемент - ТаблицаФормы - дерево доступных обработок
//  НоваяСтрока - Булево
//  Копирование - Булево
//
Процедура ДоступныеОбработкиПриНачалеРедактирования(Форма, Элемент, НоваяСтрока, Копирование) Экспорт
	
	Если НоваяСтрока Тогда
		ОбъектОбработки = Форма.ПолучитьПереопределяемыйОбъектОбработки();
		Родитель = Элемент.ТекущиеДанные.ПолучитьРодителя();
		ИмяКандидат = ?(Родитель = Неопределено, Элемент.ТекущиеДанные.Имя, Родитель.Имя);
		ДополнитьНовуюДоступнуюОбработку(Элемент.ТекущиеДанные, ИмяКандидат, ОбъектОбработки.ДоступныеОбработки.ПолучитьЭлементы());
	КонецЕсли;
	
КонецПроцедуры

// Обработчик окончания редактирования в дереве доступных обработок: представление обработки - в заголовок ее элемента схемы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с процессом
//  Элемент - ТаблицаФормы - дерево доступных обработок
//  НоваяСтрока - Булево
//  ОтменаРедактирования - Булево
//
Процедура ДоступныеОбработкиПриОкончанииРедактирования(Форма, Элемент, НоваяСтрока, ОтменаРедактирования) Экспорт
	
	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	ГрафСхема = Форма.Процессы_ГрафСхема;
	БылиИзменения = Ложь;
	Для Каждого ЭлементСхемы Из ГрафСхема.ЭлементыГрафическойСхемы Цикл
		Если НРег(ИмяОбработкиЭлемента(ЭлементСхемы.Имя)) = НРег(Элемент.ТекущиеДанные.Имя) Тогда
			ЭлементСхемы.Наименование = Элемент.ТекущиеДанные.Представление;
			БылиИзменения = Истина;
		КонецЕсли;
	КонецЦикла;
	Если БылиИзменения Тогда
		ВыполнитьОбработкуОповещения(ОписаниеСохраненияСхемы(Форма), ГрафСхема);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик начала добавления в дереве доступных обработок: копируется только настроенная обработка,
// добавляется - только настроенная обработка в вид.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с процессом
//  Элемент - ТаблицаФормы - дерево доступных обработок
//  Отказ - Булево
//  Копирование - Булево
//  Родитель - Произвольный - у дерева формы всегда Неопределено, родитель берется из текущей строки
//  Группа - Булево
//  Параметр - Произвольный
//
Процедура ДоступныеОбработкиПередНачаломДобавления(Форма, Элемент, Отказ, Копирование, Родитель, Группа, Параметр) Экспорт
	
	РодительТекущей = ?(Элемент.ТекущиеДанные = Неопределено, Неопределено, Элемент.ТекущиеДанные.ПолучитьРодителя());
	Если Копирование Тогда
		Отказ = (РодительТекущей = Неопределено);
	Иначе
		Отказ = (РодительТекущей <> Неопределено);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ГрафическаяСхема

// Показывает или скрывает показатели выполнения обработок на схеме и запоминает выбор.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с процессом
//  НовоеЗначение - Булево, Неопределено - показывать ли показатели; Неопределено - переключить
//
Процедура ОтобразитьПоказателиПроцесса(Форма, НовоеЗначение = Неопределено) Экспорт
	
	ОбъектОбработки = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Кнопка = Форма.Элементы.ОтобразитьПоказателиПроцесса;
	Кнопка.Пометка = ?(НовоеЗначение = Неопределено, Не Кнопка.Пометка, НовоеЗначение);
	Форма.Процессы_ГрафСхема = ПолучитьВыполненнуюСхему(ОбъектОбработки, Форма, Форма.КэшПользователя, Кнопка.Пометка);
	ВариантПроцессыКлиент_Ei.СохранитьНастройки(Форма, ОбъектОбработки);
	
КонецПроцедуры

// Показывает в поле схему процесса, сохраненную в объекте обработки.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с процессом
//
Процедура ВосстановитьГрафСхему(Форма) Экспорт
	
	ОбъектОбработки = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Форма.Процессы_ГрафСхема = ОбщегоНазначенияКлиентСервер_Ei.Структурировать(ОбъектОбработки.ГрафСхемаXDTO, Новый ГрафическаяСхема);
	
КонецПроцедуры

// Показывает показатели выполнения и активизирует на схеме обработку с ошибкой.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с процессом
//  Элемент - ДекорацияФормы - декорация ошибки
//
Процедура ВыделитьОшибкуВПроцессе(Форма, Элемент) Экспорт
	
	Если Не Форма.Элементы.ОтобразитьПоказателиПроцесса.Пометка Тогда
		ОтобразитьПоказателиПроцесса(Форма);
	КонецЕсли;
	АктивизироватьОшибкуВПроцессе(Форма.Элементы.Процессы_ГрафСхема, Форма.Процессы_ГрафСхема);
	
КонецПроцедуры

// Схема процесса с показателями выполнения обработок или без них. У процесса строки набора, выполняющегося в фоне,
// показывается и его ход: выполняющаяся обработка, строка коллекции «Для Каждого», время и ошибки завершенных обработок.
//
// Параметры:
//  ОбъектОбработки - ДанныеФормыЭлементДерева, ФормаКлиентскогоПриложения - строка набора или форма с ГрафСхемаXDTO
//  Форма - ФормаКлиентскогоПриложения - форма с настройками пользователя
//  КэшПользователя - Структура - кэш пользователя формы с ошибками обработок
//  ОтображатьПоказатели - Булево - показывать время и ошибки последнего выполнения
//
// Возвращаемое значение:
//  ГрафическаяСхема
//
Функция ПолучитьВыполненнуюСхему(ОбъектОбработки, Форма, КэшПользователя, ОтображатьПоказатели) Экспорт
	
	Результат = ПолучитьСхемуБезЭлементовСостояния(
		ОбщегоНазначенияКлиентСервер_Ei.Структурировать(ОбъектОбработки.ГрафСхемаXDTO, Новый ГрафическаяСхема));
	ХодЗапуска = ХодВыполняющегосяЗапуска(ОбъектОбработки);
	Для Каждого ЭлементСхемы Из ПроцессыКлиентСервер_Ei.ПолучитьУправляющиеЭлементы(Результат) Цикл
		Состояние = ?(ХодЗапуска = Неопределено, Неопределено, ХодЗапуска.Элементы.Получить(ЭлементСхемы.Имя));
		Если Состояние <> Неопределено Тогда
			ДобавитьСостояниеХода(ЭлементСхемы.Имя, Результат, Состояние);
		ИначеЕсли ОтображатьПоказатели Тогда
			КлючНастроекСпец = ПроцессыКлиентСервер_Ei.ПолучитьСпециальныйКлючНастроек(ОбъектОбработки.КлючНастроек, ЭлементСхемы.Имя);
			Время = НастройкиПользователяКлиентСервер_Ei.ПолучитьЗатраченноеВремя(КлючНастроекСпец, Форма.НастройкиПользователя,
				ВариантПроцессыКлиентСервер_Ei);
			Ошибка = КэшПользователяКлиентСервер_Ei.ПолучитьОшибку(КлючНастроекСпец, КэшПользователя, ВариантПроцессыКлиентСервер_Ei);
			Если Время <> Неопределено Или Ошибка <> Неопределено Тогда
				ДобавитьПоказатели(ЭлементСхемы.Имя, Результат, Время, Ошибка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Результат.ЭлементыГрафическойСхемы.Количество() = 0 Тогда
		Результат = ОбщегоНазначенияКлиентСервер_Ei.Структурировать(ПроцессыВызовСервера_Ei.ПолучитьМакетСхемыПоУмолчаниюСтрокой(),
			Новый ГрафическаяСхема);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ХодВыполнения

// Показывает ход процесса, выполняющегося в фоне: состояние обработок на схеме процесса и строку,
// которую обрабатывает «Для Каждого», в таблице результата ее источника - варианта строки набора,
// результат которого перебирается
// Время и ошибка завершенной обработки запоминаются как после обычного выполнения: схема показывает их
// и после завершения запуска. Обработчик уведомления, см. ФоновоеВыполнениеКлиент_Ei.ПриХодеЗапуска
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения, Неопределено - форма Ei, Неопределено - форма закрыта
//  Данные - Структура - уведомление о ходе, см. ФоновоеВыполнениеСервер_Ei.УведомитьОХоде:
//   * Ид - Строка - идентификатор фонового запуска
//   * КлючСтроки - Строка - КлючНастроек строки набора с процессом
//   * ИмяНабора - Строка - имя строки набора с процессом
//   * Пользователь - Строка
//   * Событие - Строка - см. ПроцессыКлиентСервер_Ei.СобытияХода
//   * Элемент - Строка - имя элемента схемы
//   * Время - Число - длительность обработки, миллисекунды
//   * Ошибка - Строка - краткое представление ошибки обработки
//   * Индекс - Число - индекс строки коллекции, с нуля
//   * Всего - Число - сколько строк в коллекции
//   * Источник - ФиксированнаяСтруктура, Неопределено - вариант строки набора, результат которого перебирается:
//     ** ИмяНабора - Строка - имя строки набора; пустая - строка с процессом
//     ** ИмяВарианта - Строка - имя варианта, например Запрос
//
Процедура ПоказатьХод(Форма, Данные) Экспорт
	
	ЗапомнитьХод(Данные);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	События = ПроцессыКлиентСервер_Ei.СобытияХода();
	Если Данные.Событие = События.Завершение Тогда
		ЗапомнитьПоказатели(Форма, Данные);
	ИначеЕсли Данные.Событие = События.Строка Тогда
		АктивизироватьСтрокуИсточника(Форма, Данные);
	КонецЕсли;
	
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если ТекД <> Неопределено И Строка(ТекД.КлючНастроек) = Данные.КлючСтроки И СхемаПроцессаПоказана(Форма, ТекД) Тогда
		Форма.Процессы_ГрафСхема = ПолучитьВыполненнуюСхему(ТекД, Форма, Форма.КэшПользователя,
			Форма.Элементы.ОтобразитьПоказателиПроцесса.Пометка);
		Если Данные.Событие = События.Завершение И ЗначениеЗаполнено(Данные.Ошибка) Тогда
			ВариантПроцессыКлиентСервер_Ei.ОбработкаОшибокВыполнения(Форма, Неопределено, Данные.Ошибка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ВыборОбъекта

// Всплывающая группа выбора объекта процесса.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//
// Возвращаемое значение:
//  ГруппаФормы, Неопределено - всплывающая группа, Неопределено - ее нет в форме
//
Функция ВсплываемаяГруппа(Форма) Экспорт
	
	Возврат Форма.Элементы.Найти("ОбъектГруппаВсп");
	
КонецФункции

// Открывает выбор объекта процесса во всплывающей группе.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//
Процедура ВыбратьОбъект(Форма) Экспорт
	
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если ТекД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПеременных = ОбщегоНазначенияКлиент_Ei.ПолучитьСтруктуруПеременных(Форма, Неопределено, ТекД.Процессы_Объект, Ложь);
	ВсплывающаяГруппа = ВсплываемаяГруппа(Форма);
	ФормаРодитель = ВыборКлиент_Ei.НаследоватьВыбор(Форма, Форма.Элементы.Выбор, ВсплывающаяГруппа);
	ОписаниеВыбора = Новый ОписаниеОповещения("ЗавершениеВыбораОбъекта", ПроцессыКлиент_Ei, Новый Структура("Форма", Форма));
	ВыборКлиент_Ei.НачалоВыбора(ОписаниеВыбора, ФормаРодитель.Выбор, Форма, Форма.Элементы.ВыборОбъекта, СтруктураПеременных, Ложь, Ложь);
	ВсплывающаяГруппа.Видимость = Истина; // скрывает обработчик ожидания формы, чтобы группа не мешала
	Форма.ПодключитьОбработчикОжидания("ПоказатьВыборОбъекта", 0.1, Истина); // иначе группа не показывается
	
КонецПроцедуры

// Показывает всплывающую группу выбора объекта, вызывается обработчиком ожидания формы Ei.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//
Процедура ПоказатьВыборОбъекта(Форма) Экспорт
	
	ВсплываемаяГруппа(Форма).Показать();
	Форма.ПодключитьОбработчикОжидания("СкрытьВсплывающиеГруппы", 1, Ложь);
	
КонецПроцедуры

// Заголовок кнопки выбора объекта процесса строки набора.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  ТекД - ДанныеФормыЭлементДерева - строка набора
//
Процедура ОбновитьЗаголовокОбъекта(Форма, ТекД) Экспорт
	
	Элемент = Форма.Элементы.Найти("ВыборОбъекта");
	Если Элемент <> Неопределено Тогда
		Элемент.Заголовок = ?(ЗначениеЗаполнено(ТекД.Процессы_Объект), "Объект = " + ТекД.Процессы_Объект, "");
	КонецЕсли;
	
КонецПроцедуры

// Дополняет переменные формы настройки обработки функциями процесса Объект() и Результат("ИмяЭлемента").
// У первой обработки вложенного процесса «Для Каждого» Объект - строка, текущая в таблице источника коллекции,
// см. УстановитьКонтекстТекущейСтроки. У остальных - тот, что обработка получила при последнем выполнении процесса.
// Обработка - текущий элемент схемы формы с процессом: форма настройки открывается по выбору элемента
// и блокирует владельца.
//
// Параметры:
//  ДоступныеПеременные - Структура - переменные выбора, см. ОбщегоНазначенияКлиент_Ei.ПолучитьСтруктуруПеременных
//  Форма - ФормаКлиентскогоПриложения - форма с процессом, владелец формы настройки обработки
//
Процедура ДополнитьПеременнымиОбработки(ДоступныеПеременные, Форма) Экспорт
	
	ПолеСхемы = ?(Форма = Неопределено, Неопределено, Форма.Элементы.Найти("Процессы_ГрафСхема"));
	Если ПолеСхемы = Неопределено Или ПолеСхемы.ТекущийЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	ИмяЭлемента = ПолеСхемы.ТекущийЭлемент.Имя;
	Если ТекД <> Неопределено И Не УстановитьКонтекстТекущейСтроки(Форма, ИмяЭлемента) Тогда
		КлючНастроекСпец = ПроцессыКлиентСервер_Ei.ПолучитьСпециальныйКлючНастроек(ТекД.КлючНастроек, ИмяЭлемента);
		Контекст = КэшПользователяКлиентСервер_Ei.ПолучитьКонтекст(КлючНастроекСпец, Форма.КэшПользователя,
			ВариантПроцессыКлиентСервер_Ei);
		ОбъектыВызовСервера_Ei.Установить(КонтекстДоОбработки(Контекст, ИмяЭлемента));
	КонецЕсли;
	ДополнитьДоступныеПеременные(ДоступныеПеременные);
	
КонецПроцедуры

#КонецОбласти

// Имя формы, от которой формы с процессом наследуют поведение.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяМодальнойФормы() Экспорт
	
	Возврат "ОбщаяФорма.Процессы_Ei";
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Сохраняет схему процесса в объекте обработки без элементов состояния, обработчик оповещения.
//
// Параметры:
//  Результат - ГрафическаяСхема - измененная схема
//  Форма - ФормаКлиентскогоПриложения - форма с процессом
//
Процедура СохранитьИзмененияГрафСхемы(Результат, Форма) Экспорт
	
	ОбъектОбработки = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если ОбъектОбработки <> Неопределено Тогда
		Форма.Процессы_ГрафСхема = Результат;
		ОбъектОбработки.ГрафСхемаXDTO = ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(ПолучитьСхемуБезЭлементовСостояния(Результат));
		Форма.ВычислитьМодифицированность();
	КонецЕсли;
	
КонецПроцедуры

// Записывает в наименование линии выбранное выражение объекта, обработчик оповещения о выборе.
//
// Параметры:
//  Результат - Структура - выбранные данные: ЗначениеПараметра - выражение
//  ДополнительныеПараметры - Структура:
//   * Линия - ЭлементГрафическойСхемыСоединительнаяЛиния - линия схемы
//   * Форма - ФормаКлиентскогоПриложения - форма с процессом
//
Процедура ЗакончитьУточнениеОбъектаОбработки(Результат, ДополнительныеПараметры) Экспорт
	
	Выражение = Неопределено;
	Если Не ОбщегоНазначенияКлиентСервер_Ei.ЕстьСвойство(Результат, "ЗначениеПараметра", Выражение)
		Или ДополнительныеПараметры.Линия.Наименование = Выражение Тогда
		Возврат;
	КонецЕсли;
	
	// Линию меняем в схеме формы: изменение элемента из параметра затерла бы СохранитьИзмененияГрафСхемы
	ГрафСхема = ДополнительныеПараметры.Форма.Процессы_ГрафСхема;
	Линия = ГрафСхема.ЭлементыГрафическойСхемы.Найти(ДополнительныеПараметры.Линия.Имя);
	Если Линия <> Неопределено Тогда
		Линия.Наименование = Выражение;
		Линия.ПоложениеТекста = ПоложениеТекстаСоединительнойЛинии.ПервыйСегмент; // так видно, где вычисляется объект
		СохранитьИзмененияГрафСхемы(ГрафСхема, ДополнительныеПараметры.Форма);
	КонецЕсли;
	
КонецПроцедуры

// Удаляет настроенную обработку и ее элемент схемы после ответа на вопрос, обработчик оповещения.
//
// Параметры:
//  Результат - КодВозвратаДиалога - ответ на вопрос
//  ДополнительныеПараметры - Структура:
//   * Элемент - ТаблицаФормы - дерево доступных обработок
//   * ГрафСхема - ГрафическаяСхема - схема процесса
//   * ОписаниеСохранения - ОписаниеОповещения - см. ОписаниеСохраненияСхемы
//
Процедура ОО_ДоступныеОбработкиПередУдалением(Результат, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = ДополнительныеПараметры.Элемент.ТекущиеДанные;
	Если Результат <> КодВозвратаДиалога.ОК Или ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Родитель = ТекущиеДанные.ПолучитьРодителя();
	Если Родитель <> Неопределено Тогда
		ГрафСхемаXDTO = СериализаторXDTO.ЗаписатьXDTO(ДополнительныеПараметры.ГрафСхема);
		РаботаСГС_Ei.УдалитьОбъектСхемы(ГрафСхемаXDTO, ТекущиеДанные.Имя);
		Родитель.ПолучитьЭлементы().Удалить(ТекущиеДанные);
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОписаниеСохранения, СериализаторXDTO.ПрочитатьXDTO(ГрафСхемаXDTO));
	КонецЕсли;
	
КонецПроцедуры

// Записывает выбранное выражение объекта процесса в строку набора, обработчик оповещения о выборе.
//
// Параметры:
//  ВыбранноеЗначение - Структура - выбранные данные: ЗначениеПараметра - выражение
//  ДополнительныеПараметры - Структура:
//   * Форма - ФормаКлиентскогоПриложения - форма Ei
//
Процедура ЗавершениеВыбораОбъекта(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если ТекД <> Неопределено Тогда
		ТекД.Процессы_Объект = ВыбранноеЗначение.ЗначениеПараметра;
		ОбновитьЗаголовокОбъекта(Форма, ТекД);
		Форма.ВычислитьМодифицированность();
	КонецЕсли;
	ВсплываемаяГруппа(Форма).Видимость = Ложь;
	
КонецПроцедуры

// Объект процесса для выбора, обработчик оповещения переменной Объект, см. ДополнитьДоступныеПеременные
//
// Параметры:
//  Результат - Произвольный - возвращаемый параметр: описание значения объекта
//  ДополнительныеПараметры - Структура
//
Процедура Объект(Результат, ДополнительныеПараметры) Экспорт
	
	Результат = ОбъектыВызовСервера_Ei.Получить(Истина);
	
КонецПроцедуры

// Результаты элементов схемы для выбора, обработчик оповещения переменной Результат, см. ДополнительныеПараметры
//
// Параметры:
//  Результат - Структура - возвращаемый параметр: результаты по именам элементов схемы
//  ДополнительныеПараметры - Структура
//
Процедура Результат(Результат, ДополнительныеПараметры) Экспорт
	
	Результат = Новый Структура;
	Для Каждого РезультатЭлемента Из ОбъектыВызовСервера_Ei.ПолучитьВсе() Цикл
		Результат.Вставить(РезультатЭлемента.Имя, РезультатЭлемента.Результат);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область РедактированиеСхемы

// Добавляет на схему элемент обработки, соединенный линией.
//
// Параметры:
//  ГрафСхема - ГрафическаяСхема - схема, в которую добавляется обработка
//  СтрокаОбработки - ДанныеФормыЭлементДерева - строка дерева доступных обработок
//  ТипЭлемента - Тип - тип элемента графической схемы
//  ОписаниеСохранения - ОписаниеОповещения - см. ОписаниеСохраненияСхемы
//
Процедура ДобавитьОбработкуВГрафСхему(Знач ГрафСхема, СтрокаОбработки, ТипЭлемента, ОписаниеСохранения)
	
	Ширина = 100;
	Высота = 30;
	ГенераторЧисел = Новый ГенераторСлучайныхЧисел;
	ИмяЭлемента = ОбщегоНазначенияКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("Имя", СтрокаОбработки.Имя),
		ГрафСхема.ЭлементыГрафическойСхемы, ПроцессыКлиентСервер_Ei.стрРазделительИмени());
	
	ГрафСхемаXDTO = СериализаторXDTO.ЗаписатьXDTO(ГрафСхема);
	НовыйЭлемент = РаботаСГС_Ei.НовыйОбъектПоТипу(ТипЭлемента, ГрафСхемаXDTO, ИмяЭлемента, СтрокаОбработки.Представление,
		ГенераторЧисел.СлучайноеЧисло(10, 500), ГенераторЧисел.СлучайноеЧисло(70, 100), Ширина, Высота);
	ГрафСхемаXDTO.item.Добавить(НовыйЭлемент);
	РаботаСГС_Ei.СоединитьОбъектыЛинией(ГрафСхемаXDTO, НовыйЭлемент, Неопределено, 4, 2);
	ГрафСхема = СериализаторXDTO.ПрочитатьXDTO(ГрафСхемаXDTO);
	
	ЭлементСхемы = ГрафСхема.ЭлементыГрафическойСхемы.Найти(ИмяЭлемента);
	Если ЭлементСхемы <> Неопределено Тогда
		ЭлементСхемы.Картинка = ПолучитьКартинкуОбработки(СтрокаОбработки);
	КонецЕсли;
	ВыполнитьОбработкуОповещения(ОписаниеСохранения, ГрафСхема);
	
КонецПроцедуры

// Картинка обработки: своя или вида обработки.
//
// Параметры:
//  СтрокаОбработки - ДанныеФормыЭлементДерева, Неопределено - строка дерева доступных обработок
//
// Возвращаемое значение:
//  Картинка
//
Функция ПолучитьКартинкуОбработки(СтрокаОбработки)
	
	Результат = Новый Картинка;
	Если СтрокаОбработки <> Неопределено Тогда
		Картинка = Неопределено;
		Если ЗначениеЗаполнено(СтрокаОбработки.СсылкаНаКартинку) Тогда
			Картинка = ПолучитьИзВременногоХранилища(СтрокаОбработки.СсылкаНаКартинку);
		КонецЕсли;
		// Адрес прошлого сеанса пуст: картинка - у строки вида обработки
		Если ТипЗнч(Картинка) = Тип("Картинка") Тогда
			Результат = Картинка;
		Иначе
			Результат = ПолучитьКартинкуОбработки(СтрокаОбработки.ПолучитьРодителя());
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Оповещение, сохраняющее измененную схему, см. СохранитьИзмененияГрафСхемы
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с процессом
//
// Возвращаемое значение:
//  ОписаниеОповещения
//
Функция ОписаниеСохраненияСхемы(Форма)
	
	Возврат Новый ОписаниеОповещения("СохранитьИзмененияГрафСхемы", ПроцессыКлиент_Ei, Форма);
	
КонецФункции

// Имя обработки в имени элемента схемы: часть до разделителя.
//
// Параметры:
//  ИмяЭлемента - Строка - имя элемента графической схемы
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяОбработкиЭлемента(ИмяЭлемента)
	
	Результат = "";
	Для Каждого Часть Из СтрРазделить(ИмяЭлемента, ПроцессыКлиентСервер_Ei.стрРазделительИмени(), Ложь) Цикл
		Результат = Часть;
		Прервать;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область НастройкаОбработок

// Открывает форму настройки обработки элемента схемы, с ошибкой ее последнего выполнения.
//
// Параметры:
//  ЭлементСхемы - Произвольный - элемент обработки графической схемы
//  ВладелецФормы - ФормаКлиентскогоПриложения - форма с процессом
//  ОбъектОбработки - ДанныеФормыЭлементДерева, ФормаКлиентскогоПриложения - объект с деревом доступных обработок
//  КэшПользователя - Структура - кэш пользователя формы с ошибками обработок
//
Процедура ОткрытьНастройкуОбработки(ЭлементСхемы, ВладелецФормы, ОбъектОбработки, КэшПользователя)
	
	СтрокаОбработки = ПроцессыКлиентСервер_Ei.ПолучитьДоступнуюОбработку(ОбъектОбработки.ДоступныеОбработки, ЭлементСхемы.Имя);
	Обработчик = ?(СтрокаОбработки = Неопределено, Неопределено, ПроцессыКлиентСервер_Ei.ПолучитьОбработчик(СтрокаОбработки));
	Если Обработчик = Неопределено Или Не ЗначениеЗаполнено(Обработчик.Свойства().Форма) Тогда
		Возврат;
	КонецЕсли;
	
	КлючНастроекСпец = ПроцессыКлиентСервер_Ei.ПолучитьСпециальныйКлючНастроек(ОбъектОбработки.КлючНастроек, ЭлементСхемы.Имя);
	Ошибка = КэшПользователяКлиентСервер_Ei.ПолучитьОшибку(КлючНастроекСпец, КэшПользователя, ВариантПроцессыКлиентСервер_Ei);
	ПараметрыФормы = Новый Структура("Настройка, ИнфоОбОшибке, КлючНастроек", СтрокаОбработки.Настройка, Ошибка, ОбъектОбработки.КлючНастроек);
	ОписаниеЗакрытия = Новый ОписаниеОповещения("СохранитьНастройку", ОбработкиКлиент_Ei,
		Новый Структура("Форма, СтрокаОбработки", ВладелецФормы, СтрокаОбработки));
	ФормаОбработки = ОткрытьФорму(Обработчик.Свойства().Форма, ПараметрыФормы, ВладелецФормы, , , , ОписаниеЗакрытия,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ФормаОбработки.Заголовок = СтрокаОбработки.Представление;
	ФормаОбработки.КлючНастроек = ФормаОбработки.Параметры.КлючНастроек;
	ОтладкаКлиент_Ei.ПоказатьОшибки(ФормаОбработки, ОбработкиКлиент_Ei, Ошибка);
	
КонецПроцедуры

// Открывает выбор выражения объекта для линии схемы: объект, который получит следующая обработка.
//
// Параметры:
//  Линия - ЭлементГрафическойСхемыСоединительнаяЛиния - линия схемы
//  Форма - ФормаКлиентскогоПриложения - форма с процессом
//
Процедура НачатьУточнениеОбъектаОбработки(Линия, Форма)
	
	// Для выбора нужен контекст, который был к началу линии
	Если Линия.НачалоЭлемент <> Неопределено Тогда
		АктуализироватьКонтекст(Линия.НачалоЭлемент, Форма);
	КонецЕсли;
	СтруктураПеременных = ОбщегоНазначенияКлиент_Ei.ПолучитьСтруктуруПеременных(Форма, Неопределено, Линия.Наименование, Ложь);
	ДополнитьДоступныеПеременные(СтруктураПеременных.ДоступныеСтруктуры);
	ОписаниеЗавершения = Новый ОписаниеОповещения("ЗакончитьУточнениеОбъектаОбработки", ПроцессыКлиент_Ei,
		Новый Структура("Линия, Форма", Линия, Форма));
	ВыборКлиент_Ei.НачалоВыбора(ОписаниеЗавершения, , Форма, Неопределено, СтруктураПеременных, Ложь, Ложь);
	
КонецПроцедуры

// Устанавливает в параметре сеанса контекст, с которым последний раз выполнялся элемент схемы.
//
// Параметры:
//  ЭлементСхемы - Произвольный - элемент графической схемы
//  Форма - ФормаКлиентскогоПриложения - форма с процессом
//
Процедура АктуализироватьКонтекст(ЭлементСхемы, Форма)
	
	ТекД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если ТекД <> Неопределено Тогда
		КлючНастроекСпец = ПроцессыКлиентСервер_Ei.ПолучитьСпециальныйКлючНастроек(ТекД.КлючНастроек, ЭлементСхемы.Имя);
		ОбъектыВызовСервера_Ei.Установить(КэшПользователяКлиентСервер_Ei.ПолучитьКонтекст(КлючНастроекСпец, Форма.КэшПользователя,
			ВариантПроцессыКлиентСервер_Ei));
	КонецЕсли;
	
КонецПроцедуры

// Дополняет переменные выбора функциями процесса Объект() и Результат("ИмяЭлемента").
//
// Параметры:
//  ДоступныеПеременные - Структура - переменные выбора, см. ОбщегоНазначенияКлиент_Ei.ПолучитьСтруктуруПеременных
//
Процедура ДополнитьДоступныеПеременные(ДоступныеПеременные)
	
	ДоступныеПеременные.Вставить("Объект", Новый ОписаниеОповещения("Объект", ПроцессыКлиент_Ei, Новый Структура("Аргументы", "()")));
	ДоступныеПеременные.Вставить("Результат", Новый ОписаниеОповещения("Результат", ПроцессыКлиент_Ei,
		Новый Структура("Аргументы", ВыборКлиент_Ei.ОкончаниеФункции())));
	
КонецПроцедуры

// Контекст, с которым обработка начала выполняться: сохраненный контекст обработки заканчивается
// ее собственным результатом: его запоминает ЗафиксироватьРезультат модуля ПроцессыКлиентСервер_Ei.
//
// Параметры:
//  Контекст - ФиксированныйМассив из ФиксированнаяСтруктура, Неопределено - контекст после выполнения обработки
//  ИмяЭлемента - Строка - имя элемента обработки
//
// Возвращаемое значение:
//  Массив из ФиксированнаяСтруктура - объекты процесса, см. ОбъектыВызовСервера_Ei.ПолучитьВсе
//
Функция КонтекстДоОбработки(Контекст, ИмяЭлемента)
	
	Результат = Новый Массив;
	Если ТипЗнч(Контекст) = Тип("ФиксированныйМассив") Тогда
		Для Каждого ОбъектПроцесса Из Контекст Цикл
			Результат.Добавить(ОбъектПроцесса);
		КонецЦикла;
		Последний = Результат.ВГраница();
		Если Последний >= 0 И Результат[Последний].Имя = ИмяЭлемента Тогда
			Результат.Удалить(Последний);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Устанавливает контекст первой обработки вложенного процесса «Для Каждого» по строке, текущей в таблице
// источника коллекции: Объект - эта строка, как при выполнении, см. ОбработкаДляКаждогоКлиентСервер_Ei.ОбъектыЭлемента.
// Так переменные показывают выбранную строку и до выполнения процесса. Источник известен, когда «Для Каждого»
// верхнего уровня получает коллекцию выражением результата или данных варианта, см. ВыражениеКоллекции.
// Без текущей строки в таблице берется первая: с нее «Для Каждого» начинает.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма «Для Каждого», владелец формы настройки обработки
//  ИмяЭлемента - Строка - имя обработки вложенного процесса
//
// Возвращаемое значение:
//  Булево - Истина, контекст установлен
//
Функция УстановитьКонтекстТекущейСтроки(Форма, ИмяЭлемента)
	
	ФормаEi = Форма.ВладелецФормы;
	Если ТипЗнч(Форма.ПолучитьПереопределяемыйОбъектОбработки()) <> Тип("ФормаКлиентскогоПриложения") Или ФормаEi = Неопределено
		Или ИмяПервойОбработки(Форма.ГрафСхемаXDTO) <> ИмяЭлемента Тогда
		Возврат Ложь;
	КонецЕсли;
	ТекД = ФормаEi.ПолучитьПереопределяемыйОбъектОбработки();
	ПолеСхемы = ФормаEi.Элементы.Найти("Процессы_ГрафСхема");
	// Только «Для Каждого» верхнего уровня: у вложенного в другой «Для Каждого» коллекция - результат обработки
	Если ТипЗнч(ТекД) <> Тип("ДанныеФормыЭлементДерева") Или ПолеСхемы = Неопределено Или ПолеСхемы.ТекущийЭлемент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ИмяКоллекции = ПолеСхемы.ТекущийЭлемент.Имя;
	Выражение = ВыражениеКоллекции(ТекД, ИмяКоллекции);
	Источник = ?(ПустаяСтрока(Выражение), Неопределено, ПроцессыКлиентСервер_Ei.ИсточникВыражения(Выражение));
	Если Источник = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ОбъектыВызовСервера_Ei.УстановитьОбъектыЭлемента(Выражение, ИмяКоллекции, ИмяЭлемента,
		ИндексТекущейСтроки(ФормаEi, Источник, ТекД), Форма.УникальныйИдентификатор);
	
КонецФункции

// Выражение коллекции, которую получает обработка схемы: выражение на линии, входящей в обработку,
// у первой обработки без него - выражение объекта процесса, см. ПроцессыКлиентСервер_Ei.ВыполнитьПоток.
//
// Параметры:
//  ТекД - ДанныеФормыЭлементДерева - строка набора с процессом
//  ИмяЭлемента - Строка - имя обработки верхнего уровня схемы
//
// Возвращаемое значение:
//  Строка - пустая, если обработка получает результат предыдущей обработки
//
Функция ВыражениеКоллекции(ТекД, ИмяЭлемента)
	
	Результат = "";
	Первое = Истина;
	Для Каждого Направление Из ПроцессыКлиентСерверПовтИсп_Ei.ПолучитьМассивНаправления(ТекД.ГрафСхемаXDTO) Цикл
		Если Направление.Значение = ИмяЭлемента Тогда
			Результат = ?(Первое И ПустаяСтрока(Направление.Уточнение), ТекД.Процессы_Объект, Направление.Уточнение);
			Прервать;
		КонецЕсли;
		Первое = Ложь;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Имя первой обработки процесса: она получает объект процесса, во вложенном процессе «Для Каждого» - элемент коллекции.
//
// Параметры:
//  ГрафСхемаXDTO - Строка - сериализованная графическая схема процесса
//
// Возвращаемое значение:
//  Строка - пустая, если процесс начинается развилкой или обработок нет
//
Функция ИмяПервойОбработки(ГрафСхемаXDTO)
	
	Результат = "";
	Для Каждого Направление Из ПроцессыКлиентСерверПовтИсп_Ei.ПолучитьМассивНаправления(ГрафСхемаXDTO) Цикл
		Если ТипЗнч(Направление.Значение) = Тип("Строка") Тогда
			Результат = Направление.Значение;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Индекс строки, текущей в таблице варианта-источника коллекции, см. ИменаТаблицИсточника.
// Номер - номер в таблице: если таблицу отсортировали, берется строка результата с тем же номером.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  Источник - см. ПроцессыКлиентСервер_Ei.ИсточникВыражения
//  ТекД - ДанныеФормыЭлементДерева - строка набора с процессом
//
// Возвращаемое значение:
//  Число - 0, если таблицы нет или в ней нет текущей строки
//
Функция ИндексТекущейСтроки(Форма, Источник, ТекД)
	
	Результат = 0;
	СтрокаНабора = ?(ЗначениеЗаполнено(Источник.ИмяНабора), СтрокаИсточника(Форма, Новый Структура("Источник", Источник)), ТекД);
	Если СтрокаНабора = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ИмяТаблицы Из ИменаТаблицИсточника(Источник.ИмяВарианта, СтрокаНабора) Цикл
		Таблица = Форма.Элементы.Найти(ИмяТаблицы);
		Если Таблица = Неопределено Или Таблица.ТекущаяСтрока = Неопределено Или ТипЗнч(Форма[ИмяТаблицы]) <> Тип("ДанныеФормыКоллекция") Тогда
			Продолжить;
		КонецЕсли;
		Строки = Форма[ИмяТаблицы];
		ТекущаяСтрока = Строки.НайтиПоИдентификатору(Таблица.ТекущаяСтрока);
		Если ТекущаяСтрока <> Неопределено Тогда
			Результат = Строки.Индекс(ТекущаяСтрока);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Отказ в изменении и удалении вида обработки: меняются только настроенные обработки.
//
// Параметры:
//  Элемент - ТаблицаФормы - дерево доступных обработок
//  Отказ - Булево
//
Процедура ОтказатьДляВида(Элемент, Отказ)
	
	Если Элемент.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Заполняет новую настроенную обработку: уникальное имя, ключ настроек и картинка вида.
//
// Параметры:
//  СтрокаОбработки - ДанныеФормыЭлементДерева - новая строка дерева доступных обработок
//  ИмяКандидат - Строка - имя, от которого строится уникальное
//  ПодСтроки - ДанныеФормыКоллекцияЭлементовДерева - строки, среди которых имя уникально
//
Процедура ДополнитьНовуюДоступнуюОбработку(СтрокаОбработки, ИмяКандидат, ПодСтроки)
	
	СтрокаОбработки.Имя = ОбщегоНазначенияКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("Имя", СокрЛП(ИмяКандидат)), ПодСтроки);
	СтрокаОбработки.Представление = СтрокаОбработки.Имя;
	СтрокаОбработки.ИспользоватьНастройки = Истина;
	СтрокаОбработки.КлючНастроек = Новый УникальныйИдентификатор;
	Родитель = СтрокаОбработки.ПолучитьРодителя();
	Если Родитель <> Неопределено Тогда
		СтрокаОбработки.СсылкаНаКартинку = Родитель.СсылкаНаКартинку;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Индикация

// Добавляет рядом с обработкой время и ошибку ее последнего выполнения.
//
// Параметры:
//  ИмяЭлемента - Строка - имя элемента обработки
//  ГрафСхема - ГрафическаяСхема - схема, заменяется схемой с элементом состояния
//  Время - Число, Неопределено - длительность, миллисекунды
//  Ошибка - ИнформацияОбОшибке, Строка, Неопределено - ошибка выполнения
//
Процедура ДобавитьПоказатели(ИмяЭлемента, ГрафСхема, Время, Ошибка)
	
	Части = Новый Массив;
	Если ЗначениеЗаполнено(Время) Тогда
		Части.Добавить(ОбщегоНазначенияКлиент_Ei.ФорматироватьВремя(Время));
	КонецЕсли;
	Если Ошибка = Неопределено Тогда
		Картинка = БиблиотекаКартинок.Информация_Ei;
	Иначе
		Картинка = БиблиотекаКартинок.Предупреждение_Ei;
		Части.Добавить(?(ТипЗнч(Ошибка) = Тип("ИнформацияОбОшибке"), ОбработкаОшибок.КраткоеПредставлениеОшибки(Ошибка), Ошибка));
	КонецЕсли;
	ДобавитьОписаниеСостояния(ИмяЭлемента, ГрафСхема, СтрСоединить(Части, " "), Картинка);
	
КонецПроцедуры

// Добавляет рядом с обработкой ее состояние в ходе фонового запуска: выполняется,
// какую строку коллекции обрабатывает, или время и ошибку, если уже выполнена.
//
// Параметры:
//  ИмяЭлемента - Строка - имя элемента обработки
//  ГрафСхема - ГрафическаяСхема - схема, заменяется схемой с элементом состояния
//  Состояние - Структура - последнее уведомление об элементе, см. ПоказатьХод.Данные
//
Процедура ДобавитьСостояниеХода(ИмяЭлемента, ГрафСхема, Состояние)
	
	Если Состояние.Событие = ПроцессыКлиентСервер_Ei.СобытияХода().Завершение Тогда
		ДобавитьПоказатели(ИмяЭлемента, ГрафСхема, Состояние.Время, ?(ЗначениеЗаполнено(Состояние.Ошибка), Состояние.Ошибка, Неопределено));
	Иначе
		Текст = ?(Состояние.Всего > 0, СтрШаблон(НСтр("ru = '%1 из %2'"), Формат(Состояние.Индекс + 1, "ЧГ="), Формат(Состояние.Всего, "ЧГ=")),
			НСтр("ru = 'выполняется'"));
		ДобавитьОписаниеСостояния(ИмяЭлемента, ГрафСхема, Текст, БиблиотекаКартинок.ФоновоеВыполнение_Ei);
	КонецЕсли;
	
КонецПроцедуры

// Добавляет или обновляет надпись состояния над правым краем элемента обработки.
//
// Параметры:
//  ИмяЭлемента - Строка - имя элемента обработки
//  ГрафСхема - ГрафическаяСхема - схема, заменяется схемой с элементом состояния
//  Текст - Строка - текст состояния
//  Картинка - Картинка - картинка состояния
//
Процедура ДобавитьОписаниеСостояния(ИмяЭлемента, ГрафСхема, Текст, Картинка)
	
	ИмяСостояния = ИмяЭлемента + ПризнакСостояния();
	ЭлементСостояние = ГрафСхема.ЭлементыГрафическойСхемы.Найти(ИмяСостояния);
	Если ЭлементСостояние = Неопределено Тогда
		ЭлементОсновной = ГрафСхема.ЭлементыГрафическойСхемы.Найти(ИмяЭлемента);
		Если ЭлементОсновной <> Неопределено Тогда
			Высота = 27; // при 30 видны строки следующего перехода
			ГрафСхемаXDTO = СериализаторXDTO.ЗаписатьXDTO(ГрафСхема);
			// Фигура строкой: ФигурыГрафическойСхемы на тонком клиенте нет, XDTO приводит строку к значению перечисления
			Декорация = РаботаСГС_Ei.НовыйОбъектДекорация(ГрафСхемаXDTO, ИмяСостояния, "", "None",
				ЭлементОсновной.Лево + ЭлементОсновной.Ширина - 30, ЭлементОсновной.Верх - Высота, 180, Высота);
			ГрафСхемаXDTO.item.Добавить(Декорация);
			ГрафСхема = СериализаторXDTO.ПрочитатьXDTO(ГрафСхемаXDTO);
			ЭлементСостояние = ГрафСхема.ЭлементыГрафическойСхемы.Найти(ИмяСостояния);
		КонецЕсли;
	КонецЕсли;
	
	Если ЭлементСостояние <> Неопределено Тогда
		ЭлементСостояние.Картинка = Картинка;
		ЭлементСостояние.Наименование = Текст;
		ЭлементСостояние.ПрозрачныйФон = Истина;
		ЭлементСостояние.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Лево;
	КонецЕсли;
	
КонецПроцедуры

// Схема без элементов состояния, которые могли остаться от показа показателей.
//
// Параметры:
//  Схема - ГрафическаяСхема
//
// Возвращаемое значение:
//  ГрафическаяСхема
//
Функция ПолучитьСхемуБезЭлементовСостояния(Схема)
	
	Изменяли = Ложь;
	ГрафСхемаXDTO = СериализаторXDTO.ЗаписатьXDTO(Схема);
	Для Каждого ЭлементСхемы Из Схема.ЭлементыГрафическойСхемы Цикл
		Если ТипЗнч(ЭлементСхемы) = Тип("ЭлементГрафическойСхемыДекорация") И СтрЗаканчиваетсяНа(ЭлементСхемы.Имя, ПризнакСостояния()) Тогда
			РаботаСГС_Ei.УдалитьОбъектСхемы(ГрафСхемаXDTO, ЭлементСхемы.Имя);
			Изменяли = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ?(Изменяли, СериализаторXDTO.ПрочитатьXDTO(ГрафСхемаXDTO), Схема);
	
КонецФункции

// Активизирует в поле схемы первый элемент состояния с ошибкой.
//
// Параметры:
//  Поле - Произвольный - поле графической схемы формы: его текущий элемент - элемент схемы
//  ГрафСхема - ГрафическаяСхема
//
Процедура АктивизироватьОшибкуВПроцессе(Поле, ГрафСхема)
	
	Для Каждого ЭлементСхемы Из ГрафСхема.ЭлементыГрафическойСхемы Цикл
		Если ТипЗнч(ЭлементСхемы) = Тип("ЭлементГрафическойСхемыДекорация") И ЭлементСхемы.Картинка = БиблиотекаКартинок.Предупреждение_Ei Тогда
			// Текущий элемент поля графической схемы - элемент схемы, а не элемент формы
			//@skip-check bsl-legacy-check-expression-type
			Поле.ТекущийЭлемент = ЭлементСхемы;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Окончание имени элемента состояния схемы.
//
// Возвращаемое значение:
//  Строка
//
Функция ПризнакСостояния()
	
	Возврат "_Состояние";
	
КонецФункции

#КонецОбласти

#Область Ход

// Запоминает уведомление о ходе по элементу схемы. Ход нового запуска строки заменяет ход прежнего.
//
// Параметры:
//  Данные - см. ПоказатьХод.Данные
//
Процедура ЗапомнитьХод(Данные)
	
	ХодПроцессов = ОбщийМодульКлиентПовтИсп_Ei.ХодПроцессов();
	ХодЗапуска = ХодПроцессов.Получить(Данные.КлючСтроки);
	Если ХодЗапуска = Неопределено Или ХодЗапуска.Ид <> Данные.Ид Тогда
		ХодЗапуска = Новый Структура("Ид, Элементы", Данные.Ид, Новый Соответствие);
		ХодПроцессов.Вставить(Данные.КлючСтроки, ХодЗапуска);
	КонецЕсли;
	ХодЗапуска.Элементы.Вставить(Данные.Элемент, Данные);
	
КонецПроцедуры

// Ход фонового запуска процесса строки набора, пока запуск выполняется.
//
// Параметры:
//  ОбъектОбработки - ДанныеФормыЭлементДерева, ФормаКлиентскогоПриложения - строка набора; у формы хода нет
//
// Возвращаемое значение:
//  Структура, Неопределено - см. ОбщийМодульКлиентПовтИсп_Ei.ХодПроцессов
//
Функция ХодВыполняющегосяЗапуска(ОбъектОбработки)
	
	Результат = Неопределено;
	Если ТипЗнч(ОбъектОбработки) = Тип("ДанныеФормыЭлементДерева")
		И ФоновоеВыполнениеКлиент_Ei.ВариантВыполняется(ОбъектОбработки, ВариантПроцессыКлиентСервер_Ei.Ключ()) Тогда
		Результат = ОбщийМодульКлиентПовтИсп_Ei.ХодПроцессов().Получить(Строка(ОбъектОбработки.КлючНастроек));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Запоминает время и ошибку завершенной обработки, как после обычного выполнения, см. ВариантПроцессыКлиент_Ei.ПослеВыполнения
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  Данные - см. ПоказатьХод.Данные
//
Процедура ЗапомнитьПоказатели(Форма, Данные)
	
	КлючНастроекСпец = ПроцессыКлиентСервер_Ei.ПолучитьСпециальныйКлючНастроек(Данные.КлючСтроки, Данные.Элемент);
	НастройкиПользователяКлиентСервер_Ei.СохранитьЗатраченноеВремя(КлючНастроекСпец, Форма.НастройкиПользователя,
		ВариантПроцессыКлиентСервер_Ei, Данные.Время);
	КэшПользователяКлиентСервер_Ei.СохранитьОшибку(КлючНастроекСпец, Форма.КэшПользователя, ВариантПроцессыКлиентСервер_Ei,
		?(ЗначениеЗаполнено(Данные.Ошибка), Данные.Ошибка, Неопределено));
	
КонецПроцедуры

// Активизирует строку, которую обрабатывает «Для Каждого», в таблицах варианта-источника коллекции:
// в таблице результата строки набора и, у варианта Коллекция, в таблице самой коллекции.
// Таблица есть у строки, которую уже показывали; видна она, когда строка и ее вариант текущие.
// Номер строки - номер в результате: если таблицу отсортировали, активизируется строка с тем же номером.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  Данные - см. ПоказатьХод.Данные
//
Процедура АктивизироватьСтрокуИсточника(Форма, Данные)
	
	СтрокаИсточника = ?(Данные.Источник = Неопределено, Неопределено, СтрокаИсточника(Форма, Данные));
	Если СтрокаИсточника = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ИмяТаблицы Из ИменаТаблицИсточника(Данные.Источник.ИмяВарианта, СтрокаИсточника) Цикл
		Таблица = Форма.Элементы.Найти(ИмяТаблицы);
		// У дерева значений строки по номеру не найти
		Если Таблица = Неопределено Или ТипЗнч(Форма[ИмяТаблицы]) <> Тип("ДанныеФормыКоллекция") Тогда
			Продолжить;
		КонецЕсли;
		Строки = Форма[ИмяТаблицы];
		Если Данные.Индекс < Строки.Количество() Тогда
			Идентификатор = Строки.Получить(Данные.Индекс).ПолучитьИдентификатор();
			Если Таблица.ТекущаяСтрока <> Идентификатор Тогда
				Таблица.ТекущаяСтрока = Идентификатор;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Имена таблиц варианта-источника коллекции: таблица результата строки набора и, у варианта Коллекция,
// таблица самой коллекции. Таблица есть у строки, которую уже показывали.
//
// Параметры:
//  ИмяВарианта - Строка - имя варианта, см. ПроцессыКлиентСервер_Ei.ИсточникВыражения
//  СтрокаИсточника - ДанныеФормыЭлементДерева - строка набора
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ИменаТаблицИсточника(ИмяВарианта, СтрокаИсточника)
	
	КлючСтроки = ПользовательКлиентСервер_Ei.ПодготовитьКлючНастроек(СтрокаИсточника);
	Результат = Новый Массив;
	Результат.Добавить(СтрШаблон("%1%2_%3", ИмяВарианта, КлючСтроки, РезультатТаблицаКлиентСервер_Ei.Свойства().Имя));
	ИмяКоллекции = ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя;
	Если НРег(ИмяВарианта) = НРег(ИмяКоллекции) Тогда
		// Данные коллекции показывает таблица самого варианта, см. КонструкторКлиентСервер_Ei.ДинамическоеИмяРеквизита
		Результат.Добавить(СтрШаблон("%1%2_%1", ИмяКоллекции, КлючСтроки));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Строка набора, результат варианта которой перебирает «Для Каждого».
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  Данные - см. ПоказатьХод.Данные
//
// Возвращаемое значение:
//  ДанныеФормыЭлементДерева, Неопределено - строка набора, Неопределено - ее нет в открытом наборе
//
Функция СтрокаИсточника(Форма, Данные)
	
	Результат = Неопределено;
	// Без имени набора выражение берет вариант строки, в которой выполняется процесс
	Отбор = ?(ЗначениеЗаполнено(Данные.Источник.ИмяНабора), Новый Структура("ИмяНабора", Данные.Источник.ИмяНабора),
		Новый Структура("КлючНастроек", Данные.КлючСтроки));
	Для Каждого Найденная Из ОбщегоНазначенияКлиентСервер_Ei.НайтиВКоллекцииДерева(Отбор, НаборВариантовКлиент_Ei.ПолучитьЭлементы(Форма)) Цикл
		Результат = Найденная;
		Прервать;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Показана ли в форме Ei схема процесса строки набора.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма Ei
//  ТекД - ДанныеФормыЭлементДерева - текущая строка набора
//
// Возвращаемое значение:
//  Булево
//
Функция СхемаПроцессаПоказана(Форма, ТекД)
	
	Вариант = ВариантыКлиентСервер_Ei.ПолучитьТекущийОбработчик(Форма, ТекД);
	
	Возврат Вариант <> Неопределено И Вариант.Свойства().Имя = ВариантПроцессыКлиентСервер_Ei.Ключ()
		И Форма.Элементы.Найти("ОтобразитьПоказателиПроцесса") <> Неопределено;
	
КонецФункции

#КонецОбласти

#КонецОбласти

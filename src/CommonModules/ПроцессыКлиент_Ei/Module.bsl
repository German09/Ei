Процедура ЗагрузитьОбработки(ДоступныеОбработки) Экспорт
	Для Каждого ЭлОбработчика ИЗ ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки() Цикл
		Обработчик 	= ЭлОбработчика.Значение;
		Свойства 	= Обработчик.Свойства();
		СтрокаОбработки 	= Неопределено;
		Для Каждого ПодСтрока ИЗ ДоступныеОбработки Цикл
			Если ПодСтрока.Имя = ЭлОбработчика.Ключ Тогда
				СтрокаОбработки 	= ПодСтрока;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		Если СтрокаОбработки = Неопределено Тогда
			СтрокаОбработки = ДоступныеОбработки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОбработки,Свойства);
		КонецЕсли;
		СтрокаОбработки.СсылкаНаКартинку = Свойства.КартинкаСсылка;
		СтрокаОбработки.Представление	 = Свойства.Синоним;
	КонецЦикла;	

// Процедура - Выполнить процесс и вернуть результат
//
// Параметры:
//  ОбъектОбработки		 	- Форма или Элемент дерева 	- Объект в котором находится ГрафСхемаXDTO                       
//  КонтекстВыполнения	 	- Структура		 - Структура контекста выполнения 
//												Параметры
//												ЭтаФорма
//												Объект
//												ТекущиеДанные
//												СтрокаТЧ
// Возвращаемое значение:
//   - ОписаниеЗначения
//
Функция ВыполнитьПроцесс(ОбъектОбработки,КонтекстВыполнения) Экспорт
	сзВызовов 	= Новый СписокЗначений;
	ОбъектОбработки.ПоказателиВыполненияПроцесса = Новый Структура;
	Оповестить("ОбновитьСтатистикуВыполнения",,ОбъектОбработки);
	ГрафСхема 	= ОбщийМодульКлиентСервер_Ei.Структурировать(ОбъектОбработки.ГрафСхемаXDTO,Новый ГрафическаяСхема);
	мНаправления 	= ПроцессыВызовСервера_Ei.ПолучитьМассивНаправления(ГрафСхема);
	СтрНаправления 	= ПроцессыКлиент_Ei.ПоследнийЭлементВложеннойКоллекции(мНаправления);		
	ЗаполнитьСписокВызовов(сзВызовов,мНаправления,ОбъектОбработки,КонтекстВыполнения,КонтекстВыполнения.Объект);
	Результат = ВыполнитьПоток(ОбъектОбработки,сзВызовов,КонтекстВыполнения);
	Если Не СтрНаправления =  Неопределено И Не СтрНаправления.Тип = Тип("ЭлементГрафическойСхемыЗавершение") Тогда
		//Если последний элемент не завершение то тут не м.б. результата
		Результат = ОписаниеЗначенияВызовСервера_Ei.Подготовить(Неопределено,Новый УникальныйИдентификатор);
	КонецЕсли;
	Возврат Результат;	
КонецФункции

// Процедура - Заполняет массив вызовов на основании массив направления 
// 
// Параметры:
//  сзВызовов		 		- СписокЗначений - Возвращаемый/пополняемый параметр  в значении: последовательность подготовленных ОписанийОповещений, в представлении: Имя блока в грфической схеме
//  мНаправления	 		- Массив - Коллекция структур со свойствами 
//																- Тип - ТипЭлеменаГрафическойСхемы
//																- Значение - Имя элемента грфической схемы или массив новых направлений
//  ОбъектОбработки	 		- Форма или Элемент дерева 	- Объект в котором находится Дерево Доступных обработок
//  КонтекстВыполнения	 	- Структура		 - Структура контекста выполнения 
//												Параметры
//												ЭтаФорма
//												Объект
//												ТекущиеДанные
//												СтрокаТЧ
// стрВозвращаемоеЗначение 	- Структура - Описание возврашаемого значения предыдущего шага обработки, задается при старте и в случае рекурсивного вызова/развилки по направлениям, 
//											своства структуры возвращаются функцией ОписаниеЗначенияВызовСервера_Ei.Получить()
//
Процедура ЗаполнитьСписокВызовов(сзВызовов,мНаправления,ОбъектОбработки,КонтекстВыполнения,Знач стрВозвращаемоеЗначение = Неопределено) Экспорт
	Для Каждого СтрНаправления ИЗ мНаправления Цикл
		Если ТипЗнч(СтрНаправления.Значение) = Тип("Строка") Тогда
			//это шаг в том же направлении
			Если Не СтрНаправления.Тип = Тип("ЭлементГрафическойСхемыЗавершение") Тогда 
				СтрокаОбработки = ПолучитьДоступнуюОбработку(ОбъектОбработки.ДоступныеОбработки.ПолучитьЭлементы(),СтрНаправления.Значение);	
				Если Не СтрокаОбработки =  Неопределено Тогда
					ФормаОбработки  		= ПолучитьФорму(ПолучитьИмяФормыОбработки(СтрокаОбработки));
					ФормаОбработки.СтрокаОбработки = СтрокаОбработки; //сохраним в нее исходную строку обработки чтобы сохранить в нее индикацию на схеме			
					
					ОО_ДопПараметры			= Новый Структура;
					ОО_ДопПараметры.Вставить("Настройка",СтрокаОбработки.Настройка);
					Если СброситьВозврЗначениеВызова(стрВозвращаемоеЗначение) Тогда
						ОО_ДопПараметры.Вставить("Объект",КонтекстВыполнения.Объект); //Будем считать что мы обрабатываем контекст объекта
					Иначе	
						ОО_ДопПараметры.Вставить("Объект",стрВозвращаемоеЗначение); //В объект запишем стрктуру возвращаемого значения предыдущего вызова
					КонецЕсли;	
					
					ФормаОбработки.ЗагрузитьНастройку(СтрокаОбработки.Настройка,Ложь); //Загружаем настройку чтобы не делать это несколько раз и не тратить на это время при исполнении
					//тут получаем адрес в котором будет размещатся результат выполнения, важно то что адрес получаем именно предварительно и в процессе выполнения сораняем туда значение
					стрВозвращаемоеЗначение	= ФормаОбработки.ПолучитьОписаниеВозврЗначения(КонтекстВыполнения); 
					
					ОО_ДопПараметры.Вставить("ВозвращаемоеЗначение",стрВозвращаемоеЗначение);
					ОО_ДопПараметры.Вставить("ИмяОбработки",СтрНаправления.Значение);
					ОО_ВыполнитьОбработку	= Новый ОписаниеОповещения("ОО_ВыполнитьОбработку",ФормаОбработки,ОО_ДопПараметры);
					сзВызовов.Добавить(ОО_ВыполнитьОбработку,СтрНаправления.Значение);	
				КонецЕсли;
			КонецЕсли;	
		ИначеЕсли ТипЗнч(СтрНаправления.Значение) = Тип("Массив") Тогда
			КлючевоеУсловие = Неопределено;
			сооВызовов 		= Новый Соответствие;
			стрВызовов		= Новый Структура("сооВызовов",сооВызовов);
			сзВызовов.Добавить(стрВызовов);
			//тут пошло в разные направления
			Для Каждого мВложенногоНаправления ИЗ СтрНаправления.Значение Цикл
				сзВложенногоВызова 	= Новый СписокЗначений;
				КлючевоеУсловие		= ОпределитьКлючевоеУсловиеНаправления(СтрНаправления.Тип,мВложенногоНаправления,стрВозвращаемоеЗначение);
				сооВызовов.Вставить(КлючевоеУсловие,сзВложенногоВызова);
				ЗаполнитьСписокВызовов(сзВложенногоВызова,мВложенногоНаправления,ОбъектОбработки,КонтекстВыполнения,стрВозвращаемоеЗначение);	
			КонецЦикла;
			стрВызовов.Вставить("ТипУсловия",ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(ТипЗнч(КлючевоеУсловие))); 
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры

// Функция - Определяет ключевое условие/значение по которому будет запускаться это направление
//
// Параметры:
//  Тип					 - ТипЭлементовГрафическойСхемы	 - 
//  мНаправления		 - Массив - 
//  ВозвращаемоеЗначение - Структура - Описание возврашаемого значения предыдущего шага обработки	 - 
// 
// Возвращаемое значение:
//   - Булево, Значение перечисления
//
Функция ОпределитьКлючевоеУсловиеНаправления(Тип,мНаправления,ВозвращаемоеЗначение)
	Результат = Неопределено;
	Если мНаправления.Количество() Тогда
		Если Тип = Тип("ЭлементГрафическойСхемыУсловие") Тогда
			стрИмяЛинии = мНаправления[0].Условие;
			//тут возможны Истина или Ложь, будем орентироваться на окончание элемента названия линии/ребра
			Результат 	= СтрЗаканчиваетсяНа(стрИмяЛинии,стрРазделительИмени()+1);
		ИначеЕсли Тип = Тип("ЭлементГрафическойСхемыВыборВарианта") Тогда
			стрИмяВарианта = мНаправления[0].Условие;
			Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ВозвращаемоеЗначение) Тогда
				Если СтрНачинаетсяС(ВозвращаемоеЗначение.ОписаниеТипов,ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().Перечисления) Тогда
					сооЗначений	= ОбщийМодульВызовСервера_Ei.ПолучитьЗначенияПеречисления(ВозвращаемоеЗначение.ОписаниеТипов);
					стрЗначение = сооЗначений.Получить(стрИмяВарианта); 
					Если Не стрЗначение = Неопределено Тогда
						Результат 	= стрЗначение.Значение;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
	Возврат Результат;
КонецФункции	

// Функция - Определяет выполнять сброс возвр значения предыдущего вызова ил передать его дальше по списку вызовов
// Если пердыдущий алгоритм ничего не возвращает "ВозвращаемоеЗначение"  или возвращает типы для которых предусмотрены фисксированные элементы графической схемы см. ДобавитьОбработкуВГрафСхему()
// то будем считать что мы обрабатываем контекст объекта
//
// Параметры:
//  ВозвращаемоеЗначение - Фиксированная структура - ОписаниеЗначения результата выполнения предыдущего алгоритма 
// 
// Возвращаемое значение:
//   - Булево
//
Функция СброситьВозврЗначениеВызова(ВозвращаемоеЗначение)
	Результат = Ложь;
	Если ВозвращаемоеЗначение = Неопределено Тогда
		Результат = Истина;
	ИначеЕсли ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеНеопределенногоЗначения(ВозвращаемоеЗначение) Тогда 	
		Результат = Истина;
	ИначеЕсли ВозвращаемоеЗначение.ОписаниеТипов = ОбщийМодульКлиентСервер_Ei.ПолучитьИмяТипЗнч(Тип("Булево")) Тогда
		Результат = Истина;
	КонецЕсли;	
	Возврат Результат;
КонецФункции	

// Функция - Получает последний элемент направления процесса графической схемы
//
// Параметры:
//  Коллекция - Массив,СписокЗначений или Структура -   
// 
// Возвращаемое значение:
//   - Структура
//
Функция ПоследнийЭлементВложеннойКоллекции(Коллекция) Экспорт
	Если ТипЗнч(Коллекция) =  Тип("Массив") Тогда
		Если Коллекция.Количество() Тогда
			Возврат ПоследнийЭлементВложеннойКоллекции(Коллекция[Коллекция.ВГраница()]);	
		КонецЕсли;
	ИначеЕсли ТипЗнч(Коллекция) =  Тип("Структура") Тогда
		//разделение на несколько путей
		Если Коллекция.Свойство("Значение") И ТипЗнч(Коллекция.Значение) = Тип("Массив") Тогда
			//тут вложенный массив направлений см. ПроцессыВызовСервера_Ei.ДополнитьМассивНаправления()
			Возврат ПоследнийЭлементВложеннойКоллекции(Коллекция.Значение);	
		ИначеЕсли Коллекция.Свойство("сооВызовов") Тогда
			//тут вложенный список вызовов см. ЗаполнитьСписокВызовов()
			Возврат ПоследнийЭлементВложеннойКоллекции(Коллекция.сооВызовов);	
		КонецЕсли 	
	ИначеЕсли ТипЗнч(Коллекция) =  Тип("СписокЗначений") Тогда
		Если Коллекция.Количество() Тогда
			Возврат ПоследнийЭлементВложеннойКоллекции(Коллекция[Коллекция.Количество()-1].Значение);	
		КонецЕсли;
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Для Каждого КлючЗначение ИЗ Коллекция  Цикл
			Возврат ПоследнийЭлементВложеннойКоллекции(КлючЗначение.Значение);	//возьмем только первый (пока первый или последний не столь важно)
		КонецЦикла;	
	Иначе
		Возврат Коллекция;
	КонецЕсли;	
КонецФункции	

// Процедура - Выполняет, один шаг, переход к процедуре выполнения обработки, или запускает выполнение новых потоков (последовательности выполнения)
// Обратный вызов процедуры происходит из процедур ВыполнитьОбработку ОбработкиEi_
//
// Параметры:
//  ОписаниеПотока	 	- Структура 			- Структура формируемая процедурой ВыполнитьПоток()
//													- сзВызовов 		- СписокЗначений			- Последовательность подготовленных ОписанийОповещений вызова обоработок, первой располагется следующая к запуску обработка
//													- ОО				- Описание оповещения   	- Обрабтный вызов из процедуры выполнения обработки, процедуры менеджера потоков
//													- Контекст  		- Структура  				- Аналог структуры "ДоступныеСтруктуры" из переменной формы СтруктураПеременных
//													- ОбъектОбработки   - Форма и Элемент дерева 	- Объект в котором находится ГрафСхемаXDTO
//                                      			- ДатаНачала		- Число 					- Хранит текущую универсальную дату запуска послдней обработки
//  ПервыйШагПотока		- Булево 				- Признак первого шага, во время него не производится анализ и доп обработки предыдущего шага
//	ИнформацияОбОшибке	- ИнформацияОбОшибке 	- Информация об ошибке предыдущего выполнения обработки, если все ОК, то Неопределено
//
Процедура ВыполнитьПереходКСледующейОбработке(ОписаниеПотока,ПервыйШагПотока = Ложь,ИнформацияОбОшибке = Неопределено)
	Перем ПредОбработка_ДопПараметры; //
	Если Не ПервыйШагПотока И ОписаниеПотока.сзВызовов.Количество() Тогда
		ПредОбработка = ОписаниеПотока.сзВызовов[0];
		ПредОбработка_ДопПараметры = ПредОбработка.Значение.ДополнительныеПараметры;
		//Удалим предыдущую обработку
		ЗафиксироватьВыполнениеОбработки(ОписаниеПотока,ПредОбработка.Представление,ИнформацияОбОшибке);
		ОписаниеПотока.сзВызовов.Удалить(ПредОбработка);
		Если Не ИнформацияОбОшибке = Неопределено И Истина Тогда
			//выполним прервыание в случае ошибки
			сДополнениеОшибки = ИнформацияОбОшибке.Описание;	
			ВызватьИсключение сДополнениеОшибки;
		КонецЕсли;	
	КонецЕсли;
	//это условие не должно быть в цикле иначе для последнего значения не сможем вернуть результат
	Если Не ПредОбработка_ДопПараметры = Неопределено Тогда
		//Возвращаемое значение предыдущей обработки перададим как объект в контекст
		ОписаниеПотока.Контекст.Объект = ПредОбработка.Значение.ДополнительныеПараметры.ВозвращаемоеЗначение;
	КонецЕсли;
	Для Каждого ОбъектПотока ИЗ ОписаниеПотока.сзВызовов Цикл
		Если ТипЗнч(ОбъектПотока.Значение) = Тип("ОписаниеОповещения") Тогда
			ОписаниеПотока.ДатаНачала	=  ТекущаяУниверсальнаяДатаВМиллисекундах();
			ОО_КСледующей = Новый ОписаниеОповещения("ОО_ВыполнитьПереходКСледующейОбработке",ПроцессыКлиент_Ei,ОписаниеПотока);
			ВыполнитьОбработкуОповещения(ОбъектПотока.Значение,ОО_КСледующей); //выполняем новую обработку за счет выполнения ОО_ВыполнитьОбработку, после ее выполнения будет вызвана ОО_КСледующей
		ИначеЕсли ТипЗнч(ОбъектПотока.Значение) = Тип("Структура") Тогда
			//тут разные направления 
			Если Не ПредОбработка_ДопПараметры = Неопределено Тогда 
				//попытаемся вычислить путь
				КлючевоеУсловиеНаправления 	= СтруктурыЗначенийВызовСервера_Ei.ПереопределитьЗначение(ПредОбработка.Значение.ДополнительныеПараметры.ВозвращаемоеЗначение,ОбъектПотока.Значение.ТипУсловия);
				сзВызовов = ОбъектПотока.Значение.сооВызовов.Получить(КлючевоеУсловиеНаправления);
				Если Не сзВызовов =  Неопределено Тогда
					//в данном случае возвращаемое значение предыдуще обработки только определяло маршрутизацию и не может считаться переданным объектом
					//объектом обработки будем считать то же что являлось объектом для предыдущей обработки
					ОписаниеПотока.Контекст.Объект = ПредОбработка.Значение.ДополнительныеПараметры.Объект;
					ВыполнитьПоток(ОписаниеПотока.ОбъектОбработки,сзВызовов,ОписаниеПотока.Контекст);
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
		Прервать; //только оин раз
	КонецЦикла;	
КонецПроцедуры

// Функция - Формирует структуру описани потока выполнения и запускает сам поток
//
// Параметры:
//  ОбъектОбработки	 - Форма или Элемент дерева - Объект в котором находится ГрафСхемаXDTO			 - 
//  сзВызовов		 - СписокЗначений	 		- Последовательность подготовленных ОписанийОповещений
//  Контекст		 - Структура		 		- Структура контекста выполнения 
//													Параметры
//													ЭтаФорма
//													Объект
//													ТекущиеДанные
//													СтрокаТЧ
// 
// Возвращаемое значение:
//   - ОписаниеЗначения
//
Функция ВыполнитьПоток(ОбъектОбработки,сзВызовов,Контекст)
	ОписаниеПотока = Новый Структура;
	ОписаниеПотока.Вставить("сзВызовов",сзВызовов);	
	ОписаниеПотока.Вставить("ОбъектОбработки",ОбъектОбработки); //Для отображения факта выполнения
	ОписаниеПотока.Вставить("ДатаНачала",0); 					//Для подсчета времени выполненя обработки
	ОписаниеПотока.Вставить("Контекст",	Контекст);
	//Выполняем переход к первой обработке потока
	ВыполнитьПереходКСледующейОбработке(ОписаниеПотока,Истина);
	Возврат ОписаниеПотока.Контекст.Объект;
КонецФункции

#Область ОбработчикиОповещений

Процедура ОО_ВыполнитьПереходКСледующейОбработке(Результат,ОписаниеПотока) Экспорт
	Если ТипЗнч(Результат) = Тип("ИнформацияОбОшибке") Тогда
		ВыполнитьПереходКСледующейОбработке(ОписаниеПотока,,Результат);
	Иначе
		ВыполнитьПереходКСледующейОбработке(ОписаниеПотока);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область Индикация

// Процедура - Фиксирует в отдельной структуре настроек, факт выполнения обработки или завершения ее с ошибкой
//
// Параметры:
//  ОписаниеПотока	 	- Структура - Структура формируемая процедурой ВыполнитьПоток()
//  ИмяЭлмента		 	- Строка	 - Имя элемента графической схемы к которому нужно добавить статус выполнения
//	ИнформацияОбОшибке  - ИнформацияОбОшибке - Информация об ошибке или непределено
//
Процедура ЗафиксироватьВыполнениеОбработки(ОписаниеПотока,ИмяЭлемента,ИнформацияОбОшибке)
	Показатель = Новый Структура("Время,Ошибка",0);
	Если Не ИнформацияОбОшибке =  Неопределено Тогда
		Показатель.Ошибка 	= КраткоеПредставлениеОшибки(ИнформацияОбОшибке); //ИнформацияОбОшибке не сериализуется поэтому возможно только так.
	КонецЕсли;
	Если Не ОписаниеПотока.ДатаНачала = 0 Тогда
		Показатель.Время	= ТекущаяУниверсальнаяДатаВМиллисекундах() - ОписаниеПотока.ДатаНачала;	
	КонецЕсли;	
	ОписаниеПотока.ОбъектОбработки.ПоказателиВыполненияПроцесса.Вставить(ИмяЭлемента,Показатель);
	Оповестить("ОбновитьСтатистикуВыполнения",,ОписаниеПотока.ОбъектОбработки);
Конецпроцедуры

// Функция - Получает исполненную графическую схему с учетом флага отображать показатели, донасышяет ее или очищает
//
// Параметры:
//  ОбъектОбработки		 	- Форма или Элемент дерева 	- Объект в котором находится ГрафСхемаXDTO                       
//  ОтображатьПоказатели 	- Булево	 - Признак необходимости вывода состояния, рядом с каждой обработкой
// 
// Возвращаемое значение:
//   - Графическая схема
//
Функция ПолучитьВыполненнуюСхему(ОбъектОбработки,ОтображатьПоказатели) Экспорт
	Результат =  ОбщийМодульКлиентСервер_Ei.Структурировать(ОбъектОбработки.ГрафСхемаXDTO,Новый ГрафическаяСхема);
	Если Не ОбъектОбработки = Неопределено Тогда
		Если ОтображатьПоказатели Тогда
			Если ТипЗнч(ОбъектОбработки.ПоказателиВыполненияПроцесса) = Тип("Структура") И ОбъектОбработки.ПоказателиВыполненияПроцесса.Количество() Тогда
				Для Каждого Элемент Из ОбъектОбработки.ПоказателиВыполненияПроцесса Цикл
					ГрафСхемаXDTO 		= СериализаторXDTO.ЗаписатьXDTO(Результат); //выполняем именно так
					ДобавитьОписанияСостояния(Результат,ГрафСхемаXDTO,Элемент);
				КонецЦикла;
			Иначе
				Результат = ПолучитьСхемуБезЭлементовСостояния(Результат);
			КонецЕсли;	
		Иначе
			Результат = ПолучитьСхемуБезЭлементовСостояния(Результат);
		КонецЕсли;
	КонецЕсли;	
	Возврат Результат; 
КонецФункции

// Процедура - Добавляет рядом с обработкой графический элемент описания на схему
//
// Параметры:
//  ГрафСхема		 - Графическая схема	 - Графическая схема 
//  ГрафСхемаXDTO	 - ОбъектXDTO			 - Сериализованное предстаавление графической схемы
//  Элемент			 - ЭлементСтруктуры	 	 - Элмент структуры, где Ключ - Имя элемента на схеме, а значение - Структура со свойствами Время и Ошибка см. ЗафиксироватьВыполнениеОбработки()
//
Процедура ДобавитьОписанияСостояния(ГрафСхема,ГрафСхемаXDTO,Элемент)
	Ширина 				= 180;
	Высота 				= 27; //если 30 то будет видны строки следующего перехода
	стрИмяЭлемента		= Элемент.Ключ+ПеречисленияКлиентСерверПовторноеИспользование_Ei.ПризнакСостояния();
	ЭлементСостояние 	= ГрафСхема.ЭлементыГрафическойСхемы.Найти(стрИмяЭлемента);
	Если ЭлементСостояние =  Неопределено Тогда
		ЭлементОсновной 	= ГрафСхема.ЭлементыГрафическойСхемы.Найти(Элемент.Ключ);
		Если Не ЭлементОсновной = Неопределено Тогда
			Начало 		= ЭлементОсновной.Лево + ЭлементОсновной.Ширина - 30;
			НачалоВерх	= ЭлементОсновной.Верх - Высота; 
			НовЭлемент 	= РаботаСГС_Ei.НовыйОбъектДекорация(ГрафСхемаXDTO,стрИмяЭлемента,"",ФигурыГрафическойСхемы.Нет,Начало,НачалоВерх,Ширина,Высота);
			ГрафСхемаXDTO.item.Добавить(НовЭлемент);
			ГрафСхема 	= СериализаторXDTO.ПрочитатьXDTO(ГрафСхемаXDTO);
			ЭлементСостояние = ГрафСхема.ЭлементыГрафическойСхемы[стрИмяЭлемента];
		КонецЕсли;	
	КонецЕсли;
	Если Не ЭлементСостояние = Неопределено Тогда
		Если Элемент.Значение.Ошибка =  Неопределено Тогда
			ЭлементСостояние.Картинка 	= БиблиотекаКартинок.Информация_Ei;
			ДопИнформация 				= "";
		Иначе
			ЭлементСостояние.Картинка 	= БиблиотекаКартинок.Предупреждение_Ei;
			ДопИнформация 				= " "+Элемент.Значение.Ошибка;
		КонецЕсли;	
		
		Если Не Элемент.Значение.Время = 0 Тогда
			ЭлементСостояние.Наименование  				= ОбщийМодульЗакрытыйКлиент_Ei.вФорматироватьВремя(Элемент.Значение.Время) + ДопИнформация;
		Иначе
			ЭлементСостояние.Наименование  				= "";
		КонецЕсли;	
		ЭлементСостояние.ПрозрачныйФон  				= Истина;
		ЭлементСостояние.ГоризонтальноеПоложение  		= ГоризонтальноеПоложение.Лево;
	КонецЕсли;	
КонецПроцедуры	

// Функция - Удаляет элементы состояния, которые могли остаться от отображения выполнения схемы
//
// Параметры:
//  Схема	- Графическая схема	 - Графическая схема
//
Функция ПолучитьСхемуБезЭлементовСостояния(Схема) Экспорт
	Изменяли 		= Ложь;
	ГрафСхемаXDTO 	= СериализаторXDTO.ЗаписатьXDTO(Схема);
	Для Каждого Элемент ИЗ  Схема.ЭлементыГрафическойСхемы Цикл
		Если ТипЗнч(Элемент) = тип("ЭлементГрафическойСхемыДекорация") И СтрЗаканчиваетсяНа(Элемент.Имя,ПеречисленияКлиентСерверПовторноеИспользование_Ei.ПризнакСостояния()) Тогда
			РаботаСГС_Ei.УдалитьОбъектСхемы(ГрафСхемаXDTO,Элемент.Имя);
			Изменяли = Истина;
		КонецЕсли;	
	КонецЦикла;
	Возврат ?(Изменяли,СериализаторXDTO.ПрочитатьXDTO(ГрафСхемаXDTO),Схема);
КонецФункции	

Процедура АктивизироватьОшибкуВПроцессе(Поле,ГрафСхема) Экспорт
	Для Каждого Элемент ИЗ ГрафСхема.ЭлементыГрафическойСхемы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементГрафическойСхемыДекорация") И Элемент.Картинка 	= БиблиотекаКартинок.Предупреждение_Ei Тогда
			Поле.ТекущийЭлемент = Элемент;
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры	

#КонецОбласти

#Область СериализацияСтруктурирование

Функция ПолучитьСоотвествиеПроцесса(ОбъектОбработки) Экспорт
	Результат = Новый Соответствие;
	Результат.Вставить("",																		ПолучитьСписокОбработок(ОбъектОбработки.ДоступныеОбработки.ПолучитьЭлементы()));
	Результат.Вставить("GraphicalSchema.xml", 													ОбъектОбработки.ГрафСхемаXDTO);
	Результат.Вставить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ИмяФайлаСтатистики(),	ОбъектОбработки.ПоказателиВыполненияПроцесса);

	Возврат Результат;
КонецФункции

Функция ЗагрузитьПроцессИзСоответствия(ОбъектОбработки,сооПроцессы) Экспорт
	Если ТипЗнч(сооПроцессы) =  Тип("Соответствие") Тогда
		ОбъектОбработки.ГрафСхемаXDTO					= сооПроцессы.Получить("GraphicalSchema.xml");
		ОбъектОбработки.ПоказателиВыполненияПроцесса	= сооПроцессы.Получить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ИмяФайлаСтатистики());

		ДобавитьОбработкиВКоллекцию(ОбъектОбработки.ДоступныеОбработки.ПолучитьЭлементы(),сооПроцессы.Получить(""))
	КонецЕсли;	
КонецФункции	

// Функция - Формирует список доступных обработок, которые имеют сохраненные настройки
// обратно перобразуется функцией ДобавитьОбработкиВКоллекцию()
//
// Параметры:
//  Коллекция	 - ДанныеФормыКоллекцияЭлементовДерева  	-  Строки дерева доступный обработок- 
// 
// Возвращаемое значение:
//   -  Список значений
//
Функция ПолучитьСписокОбработок(Коллекция)
	сзПроцессов = Новый СписокЗначений;
	Для Каждого Строка ИЗ Коллекция Цикл
		Если Строка.ИспользоватьНастройки Тогда
			Значение = Новый Соответствие;
			Значение.Вставить("Settings.xml",	ОбщийМодульКлиент_Ei.ПолучитьСтруктуруДанных(Строка,"Представление,Настройка,ТипЭлемента"));
			сзВложенных = ПолучитьСписокОбработок(Строка.ПолучитьЭлементы());
			Значение.Вставить("",				сзВложенных);
			Если сзВложенных.Количество() ИЛИ Не Строка.Получитьродителя() = Неопределено Тогда
				//добавим только в том случае если у вида есть хоть одна сохраненная настройка
				сзПроцессов.Добавить(Значение,Строка.Имя);
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	Возврат сзПроцессов;	
КонецФункции

// Процедура - Добавить обработки в коллекцию
//
// Параметры:
//  Коллекция	 - ДанныеФормыКоллекцияЭлементовДерева  	-  Строки дерева доступный обработок
//  сзОбработки	 - СписокЗначений	 - Список значений доступных обработок формируется функцией ПолучитьСписокОбработок()
//
Процедура ДобавитьОбработкиВКоллекцию(Коллекция,сзОбработки)
	Если ТипЗнч(сзОбработки) = Тип("СписокЗначений") Тогда
		Для Каждого Элемент ИЗ сзОбработки Цикл
			Обработка	= Коллекция.Добавить();
			Обработка.Имя					= Элемент.Представление;
			Обработка.ИспользоватьНастройки = Истина;
			стрНастройки 			= Элемент.Значение.Получить("Settings.xml");
			Если ТипЗнч(стрНастройки) =  Тип("Структура") Тогда
				ЗаполнитьЗначенияСвойств(Обработка,стрНастройки);	
			КонецЕсли;
			//Теперь вложенные
			ДобавитьОбработкиВКоллекцию(Обработка.ПолучитьЭлементы(),Элемент.Значение.Получить(""));
		КонецЦикла;
	КонецЕсли;	
Конецпроцедуры	

#КонецОбласти

Функция ИмяМодальнойФормы() Экспорт
	Возврат "ОбщаяФорма.Процессы_Ei";	
КонецФункции
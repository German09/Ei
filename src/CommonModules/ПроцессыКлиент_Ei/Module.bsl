// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ ПОЛЯ ГРАФИЧЕСКОЙ СХЕМЫ
#Область ОбработчикиПоляГрафическойСхемы

Процедура ПолеГрафСхемыПриАктивизации(Форма,Элемент) Экспорт
	ОбъектОбработки 		= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	ПолеДоступныеОбработки	= Форма.Элементы.ДоступныеОбработки;
	Если Не Элемент.ТекущийЭлемент = Неопределено Тогда
		мИмяПоиска = СтрРазделить(Элемент.ТекущийЭлемент.Имя,стрРазделительИмени(),Ложь);
		Для Каждого сИмяПоиска ИЗ мИмяПоиска Цикл
			мСтрок = ОбщийМодульКлиент_Ei.НайтиВКоллекцииДерева(Новый Структура("Имя",сИмяПоиска),ОбъектОбработки.ДоступныеОбработки.ПолучитьЭлементы());
			Если мСтрок.Количество() Тогда
				СтрокаДоступныхОбработок = мСтрок[0];
				ПолеДоступныеОбработки.ТекущаяСтрока=СтрокаДоступныхОбработок.ПолучитьИдентификатор();
			КонецЕсли;
			Прервать;
		КонецЦикла;	
	КонецЕСли;	
КонецПроцедуры

Процедура ПолеГрафСхемыВыбор(Форма,Элемент) Экспорт
	ОбъектОбработки 		= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	СтруктураПеременных		= Форма.СтруктураПеременных();
	КонтекстВыполнения		= Форма.ПодготовитьКонтекст(СтруктураПеременных.ДоступныеСтруктуры);
	Если Не ОбъектОбработки = Неопределено И Не Элемент.ТекущийЭлемент = Неопределено Тогда
		Если ТипЗнч(Элемент.ТекущийЭлемент) = Тип("ЭлементГрафическойСхемыДекорация") Тогда
			// это открытие декорации - статистики использования
		ИначеЕсли ТипЗнч(Элемент.ТекущийЭлемент) = Тип("ЭлементГрафическойСхемыСоединительнаяЛиния") Тогда
			// это открытие уточнения объекта
			НачатьУточнениеОбъектаОбработки(Элемент.ТекущийЭлемент,Форма,ОбъектОбработки,СтруктураПеременных,КонтекстВыполнения);
		Иначе	
			ОткрытьПозициюОбработки(Элемент.ТекущийЭлемент.Имя,Форма,ОбъектОбработки,СтруктураПеременных,КонтекстВыполнения);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Процедура ПолеГрафСхемыПриИзменении(Форма,Элемент) Экспорт
	СохранитьИзмененияГрафСхемы(Форма.Процессы_ГрафСхема,Форма);
КонецПроцедуры

#КонецОбласти

// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ ДЕРЕВА ДОСТУПНЫХ ОБРАБОТОК
#Область ОбработчикиДереваОбработок

Процедура ДоступныеОбработкиПриАктивизацииСтроки(Форма,Элемент) Экспорт
	ТекущиеДанные	= Форма.Элементы.ДоступныеОбработки.ТекущиеДанные;
	ГрафСхема		= Форма.Процессы_ГрафСхема;
	ПолеГрафСхемы   = Форма.Элементы.Процессы_ГрафСхема;
	Если Не ТекущиеДанные =  Неопределено Тогда
		НайденыйЭлементГС =  Неопределено;
		Для Каждого ЭлементГС ИЗ ГрафСхема.ЭлементыГрафическойСхемы Цикл
			мИмяСравнения = СтрРазделить(ЭлементГС.Имя,стрРазделительИмени(),Ложь);
			Для Каждого сИмяСравнения ИЗ мИмяСравнения Цикл
				Если нРег(сИмяСравнения) = нРег(ТекущиеДанные.Имя) Тогда
					НайденыйЭлементГС = ЭлементГС;
				КонецЕсли;
				Прервать;
			КонецЦикла;	
		КонецЦикла;
		Если Не НайденыйЭлементГС =  Неопределено Тогда
			ПолеГрафСхемы.ТекущийЭлемент = НайденыйЭлементГС;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	

Процедура ДоступныеОбработкиВыбор(Форма,Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) Экспорт
	ТекущиеДанные			= Форма.Элементы.ДоступныеОбработки.ТекущиеДанные;
	ГрафСхема				= Форма.Процессы_ГрафСхема;
	ооСохраненияИзменений	= Новый ОписаниеОповещения("СохранитьИзмененияГрафСхемы",ПроцессыКлиент_Ei,Форма);
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено И ТекущиеДанные.ИспользоватьНастройки = Истина Тогда
		ИмяКадидат 	= ТекущиеДанные.Имя+"1";
		ПодСтроки	= ТекущиеДанные.ПолучитьЭлементы();
		Строка = ПодСтроки.Добавить();
		Строка.Имя 						= ОбщийМодульКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("Имя",СокрЛП(ИмяКадидат)),ПодСтроки);
		Строка.Представление    		= Строка.Имя;
		Строка.ИспользоватьНастройки 	= Истина;
	Иначе
		Строка 			= ТекущиеДанные;
	КонецЕсли;
	//Тип элемента опредлим по родителю если он есть
	ТипЭлемента		= ?(ТекущиеДанные.ПолучитьРодителя() = Неопределено, ТекущиеДанные.ТипЭлемента, ТекущиеДанные.ПолучитьРодителя().ТипЭлемента);
	ДобавитьОбработкуВГрафСхему(ГрафСхема,Строка,ТипЭлемента,ооСохраненияИзменений)
КонецПроцедуры

Процедура ДоступныеОбработкиПередУдалением(Форма, Элемент, Отказ) Экспорт
	ГрафСхема				= Форма.Процессы_ГрафСхема;
	ооСохраненияИзменений	= Новый ОписаниеОповещения("СохранитьИзмененияГрафСхемы",ПроцессыКлиент_Ei,Форма);
	ОтказатьДляВида(Элемент, Отказ);
	Если Не Отказ Тогда
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Элемент",Элемент);
		ДопПараметры.Вставить("ГрафСхема",ГрафСхема);
		ДопПараметры.Вставить("ооСохраненияИзменений",ооСохраненияИзменений);
		ПоказатьВопрос(Новый ОписаниеОповещения("ОО_ДоступныеОбработкиПередУдалением",ПроцессыКлиент_Ei,ДопПараметры),"Удалить настройку обработки?",РежимДиалогаВопрос.ОКОтмена,15);
		Отказ = Истина;
	КонецЕсли;	
КонецПроцедуры

Процедура ДоступныеОбработкиПередНачаломИзменения(Форма, Элемент, Отказ) Экспорт
	ОтказатьДляВида(Элемент, Отказ);	
КонецПроцедуры

Процедура ДоступныеОбработкиПриОкончанииРедактирования(Форма, Элемент, НоваяСтрока, ОтменаРедактирования) Экспорт
	ГрафСхема				= Форма.Процессы_ГрафСхема;
	ооСохраненияИзменений	= Новый ОписаниеОповещения("СохранитьИзмененияГрафСхемы",ПроцессыКлиент_Ei,Форма);
	БылиИзменения =  Ложь;
	Если Не ОтменаРедактирования Тогда
		Для Каждого ЭлементГС ИЗ ГрафСхема.ЭлементыГрафическойСхемы Цикл
			мИмяСравнения = СтрРазделить(ЭлементГС.Имя,стрРазделительИмени(),Ложь);
			Для Каждого сИмяСравнения ИЗ мИмяСравнения Цикл
				Если нРег(сИмяСравнения) = нРег(Элемент.ТекущиеДанные.Имя) Тогда
					ЭлементГС.Наименование = Элемент.ТекущиеДанные.Представление;
					БылиИзменения = Истина;
				КонецЕсли;
				Прервать;
			КонецЦикла;	
		КонецЦикла;			
	КонецЕсли;
	Если БылиИзменения Тогда
		ВыполнитьОбработкуОповещения(ооСохраненияИзменений,ГрафСхема);
	КонецЕсли;	
КонецПроцедуры

Процедура ДоступныеОбработкиПередНачаломДобавления(Форма, Элемент, Отказ, Копирование, Родитель, Группа, Параметр) Экспорт
	Отказ = (Не Родитель = Неопределено);	
КонецПроцедуры

#КонецОбласти

// ПРОЦЕДУРЫ - ФУНКЦИИ РАБОТЫ С ГРАФИЧЕСКОЙ СХЕМОЙ
#Область ИзмененияГрафическойСхемы

// Процедура - создает точки старта аналогичные структуре колонок
//
// Параметры:
//  ГрафСхема				 - Графическая схема	 - Графическая схема
//  мКолонокРезультата		 - Массив	 - Массив описывающий структуру колонок
//  ооСохраненияИзменений	 - ОписаниеОповещения			 - Процедура которая сохраняет изменения если они были
//
Процедура СоздатьТочкиСтарта(ГрафСхема,мКолонокРезультата,ооСохраненияИзменений) Экспорт
	БылиИзменения 		= Ложь;
	БылиИзмененияXDTO   = Ложь;
	мИменЭлементов		= Новый Массив;
	Ширина 				= 140;
	Высота 				= 40;
	Начало 				= 0;
	Перфикс				= "Старт_";
	мИменЭлементов		= ПолучитьМассивИмяЭлементовГрафСхемы(мКолонокРезультата,Перфикс);
	Если мИменЭлементов.Количество() Тогда
		БылиИзменения 	= АннулироватьЭлементыСхемы(ГрафСхема.ЭлементыГрафическойСхемы,Тип("ЭлементГрафическойСхемыСтарт"),мИменЭлементов,Начало);
		ГрафСхемаXDTO 	= СериализаторXDTO.ЗаписатьXDTO(ГрафСхема);
		Для Каждого стрИмяЭлемента ИЗ мИменЭлементов Цикл
			Если ГрафСхема.ЭлементыГрафическойСхемы.Найти(стрИмяЭлемента) = Неопределено Тогда
				НовСтарт = РаботаСГС_Ei.НовыйОбъектСтарт(ГрафСхемаXDTO,стрИмяЭлемента,СтрЗаменить(стрИмяЭлемента,Перфикс,""),Начало,0,Ширина,Высота);
				Начало = Начало + Ширина;
				ГрафСхемаXDTO.item.Добавить(НовСтарт);
				Линия = РаботаСГС_Ei.СоединитьОбъектыЛинией(ГрафСхемаXDTO,НовСтарт,Неопределено,4,2);
				БылиИзмененияXDTO = Истина;
			КонецЕсли;	
		КонецЦикла;
		Если БылиИзмененияXDTO Тогда
			ГрафСхема = СериализаторXDTO.ПрочитатьXDTO(ГрафСхемаXDTO);
		КонецЕсли;
	КонецЕсли;
	Если Макс(БылиИзменения,БылиИзмененияXDTO) Тогда
		ВыполнитьОбработкуОповещения(ооСохраненияИзменений,Неопределено);
	КонецЕсли;	
КонецПроцедуры

// Функция - Получает ожидаемый массив элементов схемы
//
// Параметры:
//  мКолонокРезультата	 - Массив	 - Исходный массив всех колонко результат 
//  Перфикс				 - Строка	 - Перфикс имен элементов зависимый только от типа
// 
// Возвращаемое значение:
//   - Массив имен элементов граф схемы
//
Функция ПолучитьМассивИмяЭлементовГрафСхемы(мКолонокРезультата,Перфикс)
	мРезультат = Новый Массив;
	Для Каждого Колонка ИЗ мКолонокРезультата Цикл
		Если Не Колонка.Колонка.Имя = ПеречисленияКлиентСерверПовторноеИспользование_Ei.Пометка() Тогда
			мРезультат.Добавить(Перфикс+Колонка.Колонка.Имя);
		КонецЕсли;	
	КонецЦикла;
	Возврат мРезультат
КонецФункции	

// Функция - выполняет визуальную активизация или деактивизацию элементов схемы
//
// Параметры:
//  Элменты			 - ЭлементыГрафическойСхемы	 - Элементы граф схемы
//  ИскомыйТип		 - Тип  - Тип элементов
//  мИменИсключений	 - Массив - Массив имен элементов которые должны присутсовавать
//  Начало			 - Число	 - Возвращаемый параметр самой правой точки элементов формы, используется для добавления новых в последующем
// 
// Возвращаемое значение:
//   - Булево, были или нет изменены элменты схемы
//
Функция АннулироватьЭлементыСхемы(Элменты, ИскомыйТип,мИменИсключений,Начало)
	БылиИзменения 	= Ложь;
	Для Каждого Элемент ИЗ Элменты Цикл
		Если ТипЗнч(Элемент) = ИскомыйТип Тогда 
			Аннулировать =  (мИменИсключений.Найти(Элемент.Имя) = Неопределено);
			Если Не Элемент.ПрозрачныйФон = Аннулировать Тогда
				Элемент.ПрозрачныйФон = Аннулировать;
				Элемент.Шрифт  	= Новый Шрифт(Элемент.Шрифт,,,,,,Аннулировать);			
				БылиИзменения 	= Истина; 
			КонецЕсли;
			Начало = Макс(Начало,Элемент.Лево+Элемент.Ширина);
		КонецЕсли;	
	КонецЦикла;
	Возврат БылиИзменения;
Конецфункции	

// Процедура - Добавляет элемент обработки в графическую схему
//
// Параметры:
//  ГрафСхема				 - Графическая схема	 		- Схема в которую необходимо добавить обраьботку
//  ТекущиеДанные			 - ДанныеФормыЭлементДерева	 	- Строка дерева доступных оработок
//  ТипЭлемента				 - Тип	 						- Тип элмента графической схемы или НЕОПРЕДЕЛЕНО
//  ооСохраненияИзменений	 - ОписаниеОповещения	 		- Оповщения сохранения изменений схемы
//
Процедура ДобавитьОбработкуВГрафСхему(Знач ГрафСхема,ТекущиеДанные,ТипЭлемента,ооСохраненияИзменений)
	Перем стрИмяЭлементаЛинии1,стрИмяЭлементаЛинии2;
	БылиИзмененияXDTO   	= Ложь;
	Ширина 					= 100;
	Высота 					= 30;
	ГрафСхемаXDTO 			= СериализаторXDTO.ЗаписатьXDTO(ГрафСхема);
	ГСЧ 					= Новый ГенераторСлучайныхЧисел;
	Начало 					= ГСЧ.СлучайноеЧисло(10,500);
	НачалоВерх				= ГСЧ.СлучайноеЧисло(70,100);
	Наименование 			= ТекущиеДанные.Представление;
	Имя						= ТекущиеДанные.Имя;
	стрИмяЭлемента 			= ОбщийМодульКлиент_Ei.вПолучитьУникальноеИмяВКоллекции(Новый Структура("Имя",Имя),ГрафСхема.ЭлементыГрафическойСхемы,стрРазделительИмени());
	Настройка 				= ОбщийМодульКлиентСервер_Ei.Структурировать(ТекущиеДанные.Настройка,Новый Соответствие);
	ВозвращаемоеЗначение	= Настройка.Получить("Return.xml");
	Если ТипЭлемента = Тип("ЭлементГрафическойСхемыВложенныйБизнесПроцесс") Тогда //ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ТекущиеДанные.Настройка,"ГрафСхема") Тогда
		//это вложенная схема
		НовЭлемент 	= РаботаСГС_Ei.НовыйОбъектВложенныйПроцесс(ГрафСхемаXDTO,стрИмяЭлемента,Наименование,Начало,НачалоВерх,Ширина+20,Высота);
	ИначеЕсли ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ВозвращаемоеЗначение) Тогда
		//безопасно(не все типы доустпны на клиенте) проверим тип возвращаемого значения
		Если ВозвращаемоеЗначение.ОписаниеТипов = ОбщийМодульКлиентСервер_Ei.ПолучитьИмяТипЗнч(Тип("Булево")) Тогда 
			НовЭлемент 	= РаботаСГС_Ei.НовыйОбъектУсловие(ГрафСхемаXDTO,стрИмяЭлемента,Наименование,Начало,НачалоВерх,Ширина+20,Высота);
			ГрафСхемаXDTO.item.Добавить(НовЭлемент);
			Линия = РаботаСГС_Ei.СоединитьОбъектыЛинией(ГрафСхемаXDTO,НовЭлемент,Неопределено,3,1);
			Линия.itemCode = Линия.itemCode+стрРазделительИмени()+1; //Зададим имя линии Истина по маске для вычисления маршрута 
			стрИмяЭлементаЛинии1 = Линия.itemCode;
			Линия = РаботаСГС_Ei.СоединитьОбъектыЛинией(ГрафСхемаXDTO,НовЭлемент,Неопределено,1,3);
			Линия.itemCode = Линия.itemCode+стрРазделительИмени()+0; //Зададим имя линии Ложь по маске для вычисления маршрута 
			стрИмяЭлементаЛинии2 = Линия.itemCode;
		ИначеЕсли СтрНачинаетсяС(ВозвращаемоеЗначение.ОписаниеТипов,ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().Перечисления) Тогда  
			//это фиксированный список вариантов
			НовЭлемент = РаботаСГС_Ei.НовыйОбъектВыборВарианта(ГрафСхемаXDTO,стрИмяЭлемента,Наименование,Начало,НачалоВерх,Ширина,Высота);
			ГрафСхемаXDTO.item.Добавить(НовЭлемент);
			сооВаринаты = ОбщийМодульВызовСервера_Ei.ПолучитьЗначенияПеречисления(ВозвращаемоеЗначение.ОписаниеТипов);
			Ном = 0;
			Для Каждого Вариант ИЗ сооВаринаты Цикл
				РаботаСГС_Ei.ДобавитьВариант(НовЭлемент,Вариант.Ключ,Вариант.Значение.Синоним);
				Ном 	= Ном + 1;
				Линия 	= РаботаСГС_Ei.СоединитьОбъектыЛинией(ГрафСхемаXDTO,НовЭлемент,Неопределено,3,1,Ном);
			КонецЦикла;
			стрИмяЭлементаЛинии1 = ""; //что бы не создавал линию, они возможны только от вариантов
		Иначе
			НовЭлемент 	= РаботаСГС_Ei.НовыйОбъектОбработка(ГрафСхемаXDTO,стрИмяЭлемента,Наименование,Начало,НачалоВерх,Ширина,Высота);
		КонецЕсли;	
	Иначе
		НовЭлемент 	= РаботаСГС_Ei.НовыйОбъектОбработка(ГрафСхемаXDTO,стрИмяЭлемента,Наименование,Начало,НачалоВерх,Ширина,Высота);
	КонецЕсли;	
	Если стрИмяЭлементаЛинии1 =  Неопределено Тогда
		ГрафСхемаXDTO.item.Добавить(НовЭлемент);
		Линия = РаботаСГС_Ei.СоединитьОбъектыЛинией(ГрафСхемаXDTO,НовЭлемент,Неопределено,4,2);
	КонецЕсли;	
	ГрафСхема = СериализаторXDTO.ПрочитатьXDTO(ГрафСхемаXDTO);
	ГрафСхема.ЭлементыГрафическойСхемы[стрИмяЭлемента].Картинка 	= ПолучитьКартинкуобработки(ТекущиеДанные);
	Если Не стрИмяЭлементаЛинии2 = Неопределено Тогда 
		//добавим подписи к линиям условия 
		ГрафСхема.ЭлементыГрафическойСхемы[стрИмяЭлементаЛинии1].Наименование = "Да";
		ГрафСхема.ЭлементыГрафическойСхемы[стрИмяЭлементаЛинии2].Наименование = "Нет";
	КонецЕсли;	
	ВыполнитьОбработкуОповещения(ооСохраненияИзменений,ГрафСхема);
КонецПроцедуры

Функция ПолучитьКартинкуобработки(Строка)
	Результат = Новый Картинка;
	Если Не Строка =  Неопределено Тогда
		Если ЗначениеЗаполнено(Строка.СсылкаНаКартинку) Тогда
			Результат = ПолучитьИзВременногоХранилища(Строка.СсылкаНаКартинку);
		Иначе
			Результат = ПолучитьКартинкуобработки(Строка.ПолучитьРодителя());
		КонецЕсли;
	КонецЕсли;	
	Возврат Результат;	
КонецФункции	

Процедура СохранитьИзмененияГрафСхемы(Результат,Форма) Экспорт
	ОбъектОбработки = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ОбъектОбработки = Неопределено Тогда
		Форма.Процессы_ГрафСхема	 	= Результат;
		СхемаБезЭлементовСостояния		= ПолучитьСхемуБезЭлементовСостояния(Результат);
		ОбъектОбработки.ГрафСхемаXDTO 	= ОбщийМодульКлиентСервер_Ei.Сериализовать(СхемаБезЭлементовСостояния);
		Форма.ВычислитьМодифицированность();
	КонецЕсли;	
КонецПроцедуры

Процедура ОтобразитьПоказателиПроцесса(Форма) Экспорт
	ОбъектОбработки 		= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Форма.Элементы.ОтобразитьПоказателиПроцесса.Пометка = Не Форма.Элементы.ОтобразитьПоказателиПроцесса.Пометка;
	Форма.Процессы_ГрафСхема = ПолучитьВыполненнуюСхему(ОбъектОбработки,Форма.Элементы.ОтобразитьПоказателиПроцесса.Пометка);
КонецПроцедуры

Процедура ВосстановитьГрафСхему(Форма) Экспорт
	ОбъектОбработки 			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Форма.Процессы_ГрафСхема 	= ОбщийМодульКлиентСервер_Ei.Структурировать(ОбъектОбработки.ГрафСхемаXDTO,Новый ГрафическаяСхема);
КонецПроцедуры

Процедура ВыделитьОшибкуВПроцессе(Форма, Элемент) Экспорт 
	Если Не Форма.Элементы.ОтобразитьПоказателиПроцесса.Пометка Тогда
		ОтобразитьПоказателиПроцесса(Форма);		
	КонецЕсли;
	АктивизироватьОшибкуВПроцессе(Форма.Элементы.Процессы_ГрафСхема,Форма.Процессы_ГрафСхема);
	ОтладкаКлиент_Ei.СкрытьГруппуОшибок(Элемент)
КонецПроцедуры

#КонецОбласти


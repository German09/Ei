Процедура вЗагрузитьГрупповыеОбработки(ВсеДоступныеОбработки,ДоступныеОбработки,УникальныйИдентификаторФормы) Экспорт
	//пустой список
	Если ВсеДоступныеОбработки = Неопределено Тогда
		ВсеДоступныеОбработки = ПроцессыВызовСервера_Ei.ПолучитьГрупповыеОбработки(стрПрефиксОбработок(),УникальныйИдентификаторФормы);
	КонецЕсли;	
	Для Каждого СвойтваОбработки ИЗ ВсеДоступныеОбработки Цикл
		СтрокаОбработки 	= Неопределено;
		Для Каждого ПодСтрока ИЗ ДоступныеОбработки Цикл
			Если ПодСтрока.Имя = СвойтваОбработки.Имя Тогда
				СтрокаОбработки 	= ПодСтрока;
				СсылкаНаКартинку 	= СтрокаОбработки.СсылкаНаКартинку;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		Если СтрокаОбработки = Неопределено Тогда
			СтрокаОбработки = ДоступныеОбработки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОбработки,СвойтваОбработки);
		КонецЕсли;
		СтрокаОбработки.СсылкаНаКартинку = СвойтваОбработки.Картинка18;
	КонецЦикла;	
Конецпроцедуры	

// Функция - Получает доступную обработку из дерева
//
// Параметры:
//  КоллекцияСтрок	 - Элементы дерева значения	 - строки дерева выбранных обработок
//  сИмя			 - Строка	-  Имя элмента графической схемы
// 
// Возвращаемое значение:
//   - Строка дерева доступных обработок
//
Функция ПолучитьДоступнуюОбработку(КоллекцияСтрок,сИмя)
	мИмяПоиска = СтрРазделить(сИмя,стрРазделительИмени(),Ложь);
	Для Каждого сИмяПоиска ИЗ мИмяПоиска Цикл
		мСтрок = ОбщийМодульКлиент_Ei.НайтиВКоллекцииДерева(Новый Структура("Имя",сИмяПоиска),КоллекцияСтрок);
		Если мСтрок.Количество() Тогда
			Возврат мСтрок[0];
		КонецЕсли;
		Прервать;
	КонецЦикла;	
КонецФункции

Процедура ОткрытьНайстройкуОбработки(ОО_ВыполнитьОбработку,ИмяЭлемента,ВладелецФормы,ОбъектОбработки,Знач СтруктураПеременных) 
	СтрокаОбработки = ПолучитьДоступнуюОбработку(ОбъектОбработки.ДоступныеОбработки.ПолучитьЭлементы(),ИмяЭлемента);
	Если Не СтрокаОбработки =  Неопределено Тогда
		ОО_Закрытия	= Новый ОписаниеОповещения("ОО_ЗакрытиеОбработки",ВладелецФормы,СтрокаОбработки);
		Если Не ОО_ВыполнитьОбработку = Неопределено Тогда
			//открываем элемент схемы который находится в позиции
			ФормаОбработки = ОткрытьФорму(ОО_ВыполнитьОбработку.Модуль.ИмяФормы,,ВладелецФормы,,,,ОО_Закрытия,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			//дополняем структуру переменных из ДопПараметров ОО_ВыполнитьОбработку
			ОО_ДопПараметры	= ОО_ВыполнитьОбработку.ДополнительныеПараметры;
			//скопируем структуру и переобпределим объект в них, иначе можем потерять исходный объект
			СтруктураПеременныхКопия = ОбщийМодульКлиентСервер_Ei.СкопироватьСтруктуру(СтруктураПеременных);//Структурировать(ОбщийМодульКлиентСервер_Ei.Сериализовать(СтруктураПеременных));
			СтруктураПеременныхКопия.ДоступныеСтруктуры.Вставить("Объект",ОО_ДопПараметры.Объект);
			ФормаОбработки.СтруктураПеременных  = СтруктураПеременныхКопия;
			Настройка = ОО_ДопПараметры.Настройка;
		Иначе
			//открываем обычный элемент, который не находится в позиции (не связан с остальными) 
			ФормаОбработки  = ОткрытьФорму(ПолучитьИмяФормыОбработки(СтрокаОбработки),,ВладелецФормы,,,,ОО_Закрытия,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			ФормаОбработки.СтруктураПеременных  = СтруктураПеременных;
			Настройка 		= СтрокаОбработки.Настройка;
		КонецЕсли;	
		ФормаОбработки.Заголовок 			= СтрокаОбработки.Представление;
		ФормаОбработки.СтрокаОбработки 		= СтрокаОбработки; //сохраним в нее исходну строку обработки чтобы иметь возможность сохранять настройку
		ФормаОбработки.ЗагрузитьНастройку(Настройка);
		Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ОбъектОбработки.ПоказателиВыполненияПроцесса,ИмяЭлемента) Тогда
			ТекстМодуляКлиент_Ei.ПоказатьОшибкиКодов(ФормаОбработки.Элементы.ОшибкаПроцессыТекст,ОбъектОбработки.ПоказателиВыполненияПроцесса[ИмяЭлемента].Ошибка);
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

Процедура ОткрытьПозициюОбработки(ИмяЭлемента,ВладелецФормы,ОбъектОбработки,СтруктураПеременных,КонтекстВыполнения) 
	//необходимо структуру переменных дополнить объектом, объект для обработки это возвращаемый элемент предыдущего шага выполнения, поэтому получим список выполнения
	сзВызовов 		= Новый СписокЗначений;
	ГрафСхема 		= ОбщийМодульКлиентСервер_Ei.Структурировать(ОбъектОбработки.ГрафСхемаXDTO,Новый ГрафическаяСхема);
	мНаправления	= ПроцессыВызовСервера_Ei.ПолучитьМассивНаправления(ГрафСхема);
	ЗаполнитьСписокВызовов(сзВызовов,мНаправления,ОбъектОбработки,КонтекстВыполнения,КонтекстВыполнения.Объект);
	ОО_ВыполнитьОбработку = НайтиЗначениеСпискаВызовов(ИмяЭлемента,сзВызовов);
	ОткрытьНайстройкуОбработки(ОО_ВыполнитьОбработку,ИмяЭлемента,ВладелецФормы,ОбъектОбработки,СтруктураПеременных); 	
КонецПроцедуры

Функция НайтиЗначениеСпискаВызовов(сПредставление,сзВызовов)
	Для Каждого Элемент Из сзВызовов Цикл
		Если Элемент.Представление = сПредставление Тогда
			Возврат Элемент.Значение;
		ИначеЕсли ТипЗнч(Элемент.Значение) =  Тип("Структура") Тогда
			//переберем вложенные
			Для Каждого КлючЗначение ИЗ Элемент.Значение.сооВызовов Цикл
				Результат =  НайтиЗначениеСпискаВызовов(сПредставление,КлючЗначение.Значение);
				Если Не Результат = Неопределено Тогда
					Возврат Результат;	
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;	
КонецФункции

Функция ПолучитьИмяФормыОбработки(СтрокаОбработки)
	СтрокаВида 	= ?(СтрокаОбработки.ПолучитьРодителя() = Неопределено,СтрокаОбработки,СтрокаОбработки.ПолучитьРодителя());
	Возврат "Обработка."+стрПрефиксОбработок()+СтрокаВида.Имя+".Форма"	
КонецФункции	

Процедура ОО_ДоступныеОбработкиПередУдалением(Результат,ДопПараметры) Экспорт
	ТД = ДопПараметры.Элемент.ТекущиеДанные;
	Если Результат = КодВозвратаДиалога.ОК И Не ТД =  Неопределено Тогда
		Родитель = ТД.ПолучитьРодителя();
		Если Не Родитель = Неопределено Тогда
			ГрафСхемаXDTO 		= СериализаторXDTO.ЗаписатьXDTO(ДопПараметры.ГрафСхема);
			РаботаСГС_Ei.УдалитьОбъектСхемы(ГрафСхемаXDTO,ТД.Имя);
			Родитель.ПолучитьЭлементы().Удалить(ТД);
			ВыполнитьОбработкуОповещения(ДопПараметры.ооСохраненияИзменений,СериализаторXDTO.ПрочитатьXDTO(ГрафСхемаXDTO));
		КонецЕсли; 
	КонецЕсли;	
КонецПроцедуры	

Процедура ОтказатьДляВида(Элемент, Отказ)
	Родитель = Элемент.ТекущиеДанные.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;	
Конецпроцедуры


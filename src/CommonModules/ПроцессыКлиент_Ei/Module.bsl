#Область ГрупповыеОбработки

Функция стрПрефиксОбработок()
	Возврат "ОбработкиEi_"	
КонецФункции

Функция стрРазделительИмени()
	Возврат "____";//4	
КонецФункции

Процедура вЗагрузитьГрупповыеОбработки(ВсеДоступныеОбработки, ДоступныеОбработки, УникальныйИдентификаторФормы) Экспорт
	//пустой список
	Если ВсеДоступныеОбработки = Неопределено Тогда
		ВсеДоступныеОбработки = ПроцессыВызовСервера_Ei.ПолучитьГрупповыеОбработки(стрПрефиксОбработок(),УникальныйИдентификаторФормы);
	КонецЕсли;	
	Для Каждого СвойтваОбработки ИЗ ВсеДоступныеОбработки Цикл
		СтрокаОбработки 	= Неопределено;
		Для Каждого ПодСтрока ИЗ ДоступныеОбработки Цикл
			Если ПодСтрока.Имя = СвойтваОбработки.Имя Тогда
				СтрокаОбработки 	= ПодСтрока;
				СсылкаНаКартинку 	= СтрокаОбработки.СсылкаНаКартинку;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		Если СтрокаОбработки = Неопределено Тогда
			СтрокаОбработки = ДоступныеОбработки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОбработки,СвойтваОбработки);
		КонецЕсли;
		СтрокаОбработки.СсылкаНаКартинку = СвойтваОбработки.Картинка18;
	КонецЦикла;	
Конецпроцедуры	

// Функция - Получает доступную обработку из дерева
//
// Параметры:
//  КоллекцияСтрок	 - Элементы дерева значения	 - строки дерева выбранных обработок
//  сИмя			 - Строка	-  Имя элмента графической схемы
// 
// Возвращаемое значение:
//   - Строка дерева доступных обработок
//
Функция ПолучитьДоступнуюОбработку(КоллекцияСтрок,сИмя)
	мИмяПоиска = СтрРазделить(сИмя,стрРазделительИмени(),Ложь);
	Для Каждого сИмяПоиска ИЗ мИмяПоиска Цикл
		мСтрок = ОбщийМодульКлиент_Ei.НайтиВКоллекцииДерева(Новый Структура("Имя",сИмяПоиска),КоллекцияСтрок);
		Если мСтрок.Количество() Тогда
			Возврат мСтрок[0];
		КонецЕсли;
		Прервать;
	КонецЦикла;	
КонецФункции

// Процедура - Открыть настройку обработки в выбранной позиции
//
// Параметры:
//  ОО_ВыполнитьОбработку	 	- Описание оповещения	 - Описвание оповещения выполнения обоработки с доп параметрами
//  ИмяЭлемента			 		- Строка -  Имя элемента графической схемы
//  ВладелецФормы		 		- Форма - Форма владелец
//  ОбъектОбработки		 		- Форма или Элемент дерева 	- Объект в котором находится ГрафСхемаXDTO         
//  СтруктураПеременных	 		- Структура - Структура данных возвращаемая процедурой ПолучитьСтруктуруПеременных из формы <Конструктор>
//
Процедура ОткрытьНастройкуОбработки(ОО_ВыполнитьОбработку,ИмяЭлемента,ВладелецФормы,ОбъектОбработки,Знач СтруктураПеременных) 
	СтрокаОбработки = ПолучитьДоступнуюОбработку(ОбъектОбработки.ДоступныеОбработки.ПолучитьЭлементы(),ИмяЭлемента);
	Если Не СтрокаОбработки =  Неопределено Тогда
		ОО_Закрытия	= Новый ОписаниеОповещения("ОО_ЗакрытиеОбработки",ВладелецФормы,СтрокаОбработки);
		Если Не ОО_ВыполнитьОбработку = Неопределено Тогда
			//открываем элемент схемы который находится в позиции
			ФормаОбработки = ОткрытьФорму(ОО_ВыполнитьОбработку.Модуль.ИмяФормы,,ВладелецФормы,,,,ОО_Закрытия,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			//дополняем структуру переменных из ДопПараметров ОО_ВыполнитьОбработку
			ОО_ДопПараметры	= ОО_ВыполнитьОбработку.ДополнительныеПараметры;
			//скопируем структуру и переобпределим объект в них, иначе можем потерять исходный объект
			СтруктураПеременныхКопия = ОбщийМодульКлиентСервер_Ei.СкопироватьСтруктуру(СтруктураПеременных);//Структурировать(ОбщийМодульКлиентСервер_Ei.Сериализовать(СтруктураПеременных));
			СтруктураПеременныхКопия.ДоступныеСтруктуры.Вставить("Объект",ОО_ДопПараметры.Объект);
			ФормаОбработки.СтруктураПеременных  = СтруктураПеременныхКопия;
			Настройка = ОО_ДопПараметры.Настройка;
		Иначе
			//открываем обычный элемент, который не находится в позиции (не связан с остальными) 
			ФормаОбработки  = ОткрытьФорму(ПолучитьИмяОбработки(СтрокаОбработки).Форма,,ВладелецФормы,,,,ОО_Закрытия,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			ФормаОбработки.СтруктураПеременных  = СтруктураПеременных;
			Настройка 		= СтрокаОбработки.Настройка;
		КонецЕсли;	
		ФормаОбработки.Заголовок 			= СтрокаОбработки.Представление;
		ФормаОбработки.СтрокаОбработки 		= СтрокаОбработки; //сохраним в нее исходну строку обработки чтобы иметь возможность сохранять настройку
		ФормаОбработки.ЗагрузитьНастройку(Настройка);
		Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ОбъектОбработки.ПоказателиВыполненияПроцесса,ИмяЭлемента) Тогда
			ТекстМодуляКлиент_Ei.ПоказатьОшибкиКодов(ФормаОбработки.Элементы.ОшибкаТекст,ОбъектОбработки.ПоказателиВыполненияПроцесса[ИмяЭлемента].Ошибка);
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

// Процедура - Подготовить вызовы
//
// Параметры:
//  сзВызовов		 	 - СписокЗначений - Возвращаемый параметр  в значении: последовательность подготовленных ОписанийОповещений, в представлении: Имя блока в графической схеме
//  ОбъектОбработки		 - Форма или Элемент дерева 	- Объект в котором находится ГрафСхемаXDTO         
//  КонтекстВыполнения	 - Структура - Структура контекста выполнения 
//												Параметры
//												ЭтаФорма
//												Объект
//
Процедура ПодготовитьВызовы(сзВызовов,ОбъектОбработки,КонтекстВыполнения)
	ГрафСхема 		= ОбщийМодульКлиентСервер_Ei.Структурировать(ОбъектОбработки.ГрафСхемаXDTO,Новый ГрафическаяСхема);
	мНаправления	= ПроцессыВызовСервера_Ei.ПолучитьМассивНаправления(ГрафСхема);
	ЗаполнитьСписокВызовов(сзВызовов,мНаправления,ОбъектОбработки,КонтекстВыполнения,КонтекстВыполнения.Объект);
КонецПроцедуры	

// Процедура - Открывает позицию обработки
//
// Параметры:
//  ИмяЭлемента			 - Строка -  Имя элемента графической схемы
//  ВладелецФормы		 - Форма - Форма владелец
//  ОбъектОбработки		 - Форма или Элемент дерева 	- Объект в котором находится ГрафСхемаXDTO         
//  СтруктураПеременных	 - Структура - Структура данных возвращаемая процедурой ПолучитьСтруктуруПеременных из формы <Конструктор>
//  КонтекстВыполнения	 - Структура - Структура контекста выполнения 
//												Параметры
//												ЭтаФорма
//												Объект
//
Процедура ОткрытьПозициюОбработки(ИмяЭлемента,ВладелецФормы,ОбъектОбработки,СтруктураПеременных,КонтекстВыполнения) 
	//необходимо структуру переменных дополнить объектом, объект для обработки это возвращаемый элемент предыдущего шага выполнения, поэтому получим список выполнения
	сзВызовов 		= Новый СписокЗначений;
	ПодготовитьВызовы(сзВызовов,ОбъектОбработки,КонтекстВыполнения);	
	
	ОО_ВыполнитьОбработку = НайтиЗначениеСпискаВызовов(ИмяЭлемента,сзВызовов);
	ОткрытьНастройкуОбработки(ОО_ВыполнитьОбработку,ИмяЭлемента,ВладелецФормы,ОбъектОбработки,СтруктураПеременных); 	
КонецПроцедуры

// Процедура - открывает диалог выбора для уточнения объекта для следующей обработки 
//
// Параметры:
//  Линия			 	 - ЭлементГрафическойСхемы 		- Соединительная линия графической схемы
//  ВладелецФормы		 - Форма - Форма владелец
//  ОбъектОбработки		 - Форма или Элемент дерева 	- Объект в котором находится ГрафСхемаXDTO         
//  СтруктураПеременных	 - Структура - Структура данных возвращаемая процедурой ПолучитьСтруктуруПеременных из формы <Конструктор>
//  КонтекстВыполнения	 - Структура - Структура контекста выполнения 
//												Параметры
//												ЭтаФорма
//												Объект
//
Процедура НачатьУточнениеОбъектаОбработки(Линия,ВладелецФормы,ОбъектОбработки,СтруктураПеременных,КонтекстВыполнения)
	сзВызовов 		= Новый СписокЗначений;
	ПодготовитьВызовы(сзВызовов,ОбъектОбработки,КонтекстВыполнения);
	
	ОбработкаИмя 	= Линия.НачалоЭлемент.Имя;
	ОО_НачалоЛинии 	= НайтиЗначениеСпискаВызовов(ОбработкаИмя,сзВызовов);
	Если Не ОО_НачалоЛинии = Неопределено Тогда
		СтруктураПеременныхКопия = ОбщийМодульКлиентСервер_Ei.СкопироватьСтруктуру(СтруктураПеременных);//Структурировать(ОбщийМодульКлиентСервер_Ei.Сериализовать(СтруктураПеременных));
		СтруктураПеременныхКопия.ДоступныеСтруктуры.Вставить("Объект",ОО_НачалоЛинии.ДополнительныеПараметры.Объект);
		СтруктураПеременныхКопия.ТекущиеДанные.ЭтоВыражение 		= Истина;
		СтруктураПеременныхКопия.ТекущиеДанные.ЗначениеПараметра 	= Линия.Наименование;
		ОО_Завершения =  Новый ОписаниеОповещения("ЗакончитьУточнениеОбъектаОбработки",ПроцессыКлиент_Ei,Новый Структура("Линия,Форма",Линия,ВладелецФормы));
	    ВыборКлиент_Ei.НачалоВыбора(ОО_Завершения,,ВладелецФормы,Неопределено,СтруктураПеременныхКопия,Ложь,Ложь);
    КонецЕсли;
КонецПроцедуры

// Процедура - Завершает уточнение объекта обработки и устаналивает ему иму наименование
//
// Параметры:
//  Результат		- Структура - Структура текущиъ выбранных данных
//  ДопПараметры	- Структура -
//							Линия - ЭлементГрафическойСхемы - Соединительная линия графической схемы
//							Форма - Форма - Форма владелец
//
Процедура ЗакончитьУточнениеОбъектаОбработки(Результат,ДопПараметры) Экспорт
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(Результат,"ЗначениеПараметра") Тогда
		Если Не ДопПараметры.Линия.Наименование = Результат.ЗначениеПараметра Тогда
			//ДопПараметры.Линия.Наименование = Результат.ЗначениеПараметра; //так не работает и СохранитьИзмененияГрафСхемы() перезатирает все изменения поэтому дальше немного извращения
			ГрафСхема 	= ДопПараметры.Форма.Процессы_ГрафСхема;
			Линия 		= ГрафСхема.ЭлементыГрафическойСхемы.Найти(ДопПараметры.Линия.Имя);
			Если Не Линия = Неопределено Тогда
				Линия.Наименование 		= Результат.ЗначениеПараметра;
				Линия.ПоложениеТекста	= ПоложениеТекстаСоединительнойЛинии.ПервыйСегмент; //тем самым показываем где происходит вычисление объекта
				СохранитьИзмененияГрафСхемы(ГрафСхема,ДопПараметры.Форма);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

// Функция - Найходит описание оповещения по имени элемета схемы в списке вызовов
//
// Параметры:
//  сПредставление	 - Строка -  Имя элемента графической схемы
//	сзВызовов		 - СписокЗначений - В значении: последовательность подготовленных ОписанийОповещений, в представлении: Имя блока в графической схеме
// 
// Возвращаемое значение:
//   - Описание оповещения
//
Функция НайтиЗначениеСпискаВызовов(сПредставление,сзВызовов)
	Для Каждого Элемент Из сзВызовов Цикл
		Если Элемент.Представление = сПредставление Тогда
			Возврат Элемент.Значение;
		ИначеЕсли ТипЗнч(Элемент.Значение) =  Тип("Структура") Тогда
			//переберем вложенные
			Для Каждого КлючЗначение ИЗ Элемент.Значение.сооВызовов Цикл
				Результат =  НайтиЗначениеСпискаВызовов(сПредставление,КлючЗначение.Значение);
				Если Не Результат = Неопределено Тогда
					Возврат Результат;	
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;	
КонецФункции

// Функция - Получаеть имя формы обработки и самой обработки
//
// Параметры:
//  СтрокаОбработки	 - Данные формы дерева	 - Строка дерева доступных обработок
// 
// Возвращаемое значение:
//   -  Структура со свойствами: Форма,Объект
//
Функция ПолучитьИмяОбработки(СтрокаОбработки)
	Результат = Новый Структура("Форма,Объект");
	СтрокаВида 	= ?(СтрокаОбработки.ПолучитьРодителя() = Неопределено,СтрокаОбработки,СтрокаОбработки.ПолучитьРодителя());
	Результат.Объект 	= стрПрефиксОбработок()+СтрокаВида.Имя;	
	Результат.Форма 	= "Обработка."+стрПрефиксОбработок()+СтрокаВида.Имя+".Форма";	
	Возврат Результат;
КонецФункции	

Процедура ОО_ДоступныеОбработкиПередУдалением(Результат,ДопПараметры) Экспорт
	ТД = ДопПараметры.Элемент.ТекущиеДанные;
	Если Результат = КодВозвратаДиалога.ОК И Не ТД =  Неопределено Тогда
		Родитель = ТД.ПолучитьРодителя();
		Если Не Родитель = Неопределено Тогда
			ГрафСхемаXDTO 		= СериализаторXDTO.ЗаписатьXDTO(ДопПараметры.ГрафСхема);
			РаботаСГС_Ei.УдалитьОбъектСхемы(ГрафСхемаXDTO,ТД.Имя);
			Родитель.ПолучитьЭлементы().Удалить(ТД);
			ВыполнитьОбработкуОповещения(ДопПараметры.ооСохраненияИзменений,СериализаторXDTO.ПрочитатьXDTO(ГрафСхемаXDTO));
		КонецЕсли; 
	КонецЕсли;	
КонецПроцедуры	

Процедура ОтказатьДляВида(Элемент, Отказ)
	Родитель = Элемент.ТекущиеДанные.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;	
Конецпроцедуры

#КонецОбласти

#Область ИсполнениеГрафСхемы

// Процедура - Выполнить процесс и вернуть результат
//
// Параметры:
//  ОбъектОбработки		 	- Форма или Элемент дерева 	- Объект в котором находится ГрафСхемаXDTO                       
//  КонтекстВыполнения	 	- Структура		 - Структура контекста выполнения 
//												Параметры
//												ЭтаФорма
//												Объект
// Возвращаемое значение:
//   - ОписаниеЗначения
//
Функция ВыполнитьПроцесс(ОбъектОбработки,КонтекстВыполнения) Экспорт
	сзВызовов 	= Новый СписокЗначений;
	ОбъектОбработки.ПоказателиВыполненияПроцесса = Новый Структура;
	Оповестить("ОбновитьСтатистикуВыполнения",,ОбъектОбработки);
	ГрафСхема 	= ОбщийМодульКлиентСервер_Ei.Структурировать(ОбъектОбработки.ГрафСхемаXDTO,Новый ГрафическаяСхема);
	мНаправления 	= ПроцессыВызовСервера_Ei.ПолучитьМассивНаправления(ГрафСхема);
	СтрНаправления 	= ПоследнийЭлементВложеннойКоллекции(мНаправления);		
	ЗаполнитьСписокВызовов(сзВызовов,мНаправления,ОбъектОбработки,КонтекстВыполнения,КонтекстВыполнения.Объект);
	Результат = ПроцессыКлиентСервер_Ei.ВыполнитьПоток(ОбъектОбработки,сзВызовов,КонтекстВыполнения);
	Если Не СтрНаправления =  Неопределено И Не СтрНаправления.Тип = Тип("ЭлементГрафическойСхемыЗавершение") Тогда
		//Если последний элемент не завершение то тут не м.б. результата
		Результат = ОписаниеЗначенияВызовСервера_Ei.Подготовить(Неопределено,Новый УникальныйИдентификатор);
	КонецЕсли;
	Возврат Результат;	
КонецФункции

// Процедура - Заполняет массив вызовов на основании массив направления 
// 
// Параметры:
//  сзВызовов		 		- СписокЗначений - Возвращаемый/пополняемый параметр  в значении: последовательность подготовленных ОписанийОповещений, в представлении: Имя блока в графической схеме
//  мНаправления	 		- Массив - Коллекция структур со свойствами 
//																- Тип 		- ТипЭлеменаГрафическойСхемы
//																- Значение 	- Имя элемента грфической схемы или массив новых направлений
//																- Условие	- Имя варианта или имя линии(для условия)
//																- Уточение	- Наименование линии
//  ОбъектОбработки	 		- Форма или Элемент дерева 	- Объект в котором находится Дерево Доступных обработок
//  КонтекстВыполнения	 	- Структура		 - Структура контекста выполнения 
//												Параметры
//												ЭтаФорма
//												Объект
// стрВозвращаемоеЗначение 	- Структура - Описание возврашаемого значения предыдущего шага обработки, задается при старте и в случае рекурсивного вызова/развилки по направлениям, 
//											своства структуры возвращаются функцией ОписаниеЗначенияВызовСервера_Ei.Получить()
//
Процедура ЗаполнитьСписокВызовов(сзВызовов,мНаправления,ОбъектОбработки,КонтекстВыполнения,Знач стрВозвращаемоеЗначение = Неопределено) Экспорт
	Для Каждого СтрНаправления ИЗ мНаправления Цикл
		Если ТипЗнч(СтрНаправления.Значение) = Тип("Строка") Тогда
			//это шаг в том же направлении
			Если СтрНаправления.Тип = Тип("ЭлементГрафическойСхемыЗавершение") Тогда
				ОО_ДопПараметры	= Новый Структура;
				ОО_ДопПараметры.Вставить("Уточнение",СтрНаправления.Уточнение);
				ОО_ДопПараметры.Вставить("Объект",ПроцессыКлиентСервер_Ei.ПереопределитьОбъект(СтрНаправления.Значение,стрВозвращаемоеЗначение, ОО_ДопПараметры.Уточнение, КонтекстВыполнения, КонтекстВыполнения.Объект));
				ОО_ДопПараметры.Вставить("ИмяОбработки",СтрНаправления.Значение);

				ОО_ЗавершениеПотока	= Новый ОписаниеОповещения("ОО_ЗавершениеПотока",ПроцессыКлиент_Ei,ОО_ДопПараметры); //это блок необходим для того чтобы поток мог возвращать результат и отображать его в конструкторе
				сзВызовов.Добавить(ОО_ЗавершениеПотока,СтрНаправления.Значение);
			ИначеЕсли СтрНаправления.Тип = Тип("ЭлементГрафическойСхемыРазделение") Тогда
				ОО_ДопПараметры	= Новый Структура;
				ОО_ДопПараметры.Вставить("Уточнение",СтрНаправления.Уточнение);
				ОО_ДопПараметры.Вставить("Объект",ПроцессыКлиентСервер_Ei.ПереопределитьОбъект(СтрНаправления.Значение,стрВозвращаемоеЗначение, ОО_ДопПараметры.Уточнение, КонтекстВыполнения, КонтекстВыполнения.Объект));
				ОО_ДопПараметры.Вставить("ИмяОбработки",СтрНаправления.Значение);
				ОО_ДопПараметры.Вставить("ВозвращаемоеЗначение",Неопределено);  
				
				ОО_ФоновыйПотокНачало	= Новый ОписаниеОповещения("ОО_ФоновыйПотокНачало",ПроцессыКлиент_Ei,ОО_ДопПараметры); //это блок необходим для того чтобы поток мог возвращать результат и отображать его в конструкторе
				сзВызовов.Добавить(ОО_ФоновыйПотокНачало,СтрНаправления.Значение);
			ИначеЕсли СтрНаправления.Тип = Тип("ЭлементГрафическойСхемыСлияние") Тогда
				ОО_ДопПараметры	= Новый Структура;
				ОО_ДопПараметры.Вставить("Уточнение",СтрНаправления.Уточнение);
				ОО_ДопПараметры.Вставить("Объект",ПроцессыКлиентСервер_Ei.ПереопределитьОбъект(СтрНаправления.Значение,стрВозвращаемоеЗначение, ОО_ДопПараметры.Уточнение, КонтекстВыполнения, КонтекстВыполнения.Объект));
				ОО_ДопПараметры.Вставить("ИмяОбработки",СтрНаправления.Значение);
				ОО_ДопПараметры.Вставить("ВозвращаемоеЗначение",Неопределено);

				ОО_ФоновыйПотокЗавершение	= Новый ОписаниеОповещения(ИмяФункцииЗавершенияФоновогоПотока(),ПроцессыКлиент_Ei,ОО_ДопПараметры); //это блок необходим для того чтобы поток мог возвращать результат и отображать его в конструкторе
				сзВызовов.Добавить(ОО_ФоновыйПотокЗавершение,СтрНаправления.Значение);	
			Иначе	
				СтрокаОбработки = ПолучитьДоступнуюОбработку(ОбъектОбработки.ДоступныеОбработки.ПолучитьЭлементы(),СтрНаправления.Значение);	
				Если Не СтрокаОбработки =  Неопределено Тогда
					стрИмен					= ПолучитьИмяОбработки(СтрокаОбработки);
					ФормаОбработки  		= ПолучитьФорму(стрИмен.Форма);
					ФормаОбработки.СтрокаОбработки = СтрокаОбработки; //сохраним в нее исходную строку обработки чтобы сохранить в нее индикацию на схеме			
					
					ОО_ДопПараметры	= Новый Структура;
					ОО_ДопПараметры.Вставить("Настройка",СтрокаОбработки.Настройка);
					ОО_ДопПараметры.Вставить("Уточнение",СтрНаправления.Уточнение);					
					ОО_ДопПараметры.Вставить("Объект",ПроцессыКлиентСервер_Ei.ПереопределитьОбъект(СтрНаправления.Значение,стрВозвращаемоеЗначение, ОО_ДопПараметры.Уточнение, КонтекстВыполнения, КонтекстВыполнения.Объект));
								
					ФормаОбработки.ЗагрузитьНастройку(СтрокаОбработки.Настройка,Ложь); //Загружаем настройку чтобы не делать это несколько раз и не тратить на это время при исполнении
					//тут получаем адрес в котором будет размещатся результат выполнения, важно то что адрес получаем именно предварительно и в процессе выполнения сораняем туда значение
					стрВозвращаемоеЗначение	= ФормаОбработки.ПолучитьОписаниеВозврЗначения(КонтекстВыполнения); 
					
					ОО_ДопПараметры.Вставить("ВозвращаемоеЗначение",стрВозвращаемоеЗначение);
					ОО_ДопПараметры.Вставить("ИмяОбработки",СтрНаправления.Значение);
					ОО_ДопПараметры.Вставить("ИмяОбработчика",стрИмен.Объект); //для переобразования списка описаний оповещения в последовательность обработчиков доступную на сервере, см. ПреобразоватьСписокОповещений() 
					
					ОО_ВыполнитьОбработку	= Новый ОписаниеОповещения("ОО_ВыполнитьОбработку",ФормаОбработки,ОО_ДопПараметры);
					сзВызовов.Добавить(ОО_ВыполнитьОбработку,СтрНаправления.Значение);	
				КонецЕсли;
			КонецЕсли;	
		ИначеЕсли ТипЗнч(СтрНаправления.Значение) = Тип("Массив") Тогда
			КлючевоеУсловие = Неопределено;
			сооВызовов 		= Новый Соответствие;
			стрВызовов		= Новый Структура("сооВызовов",сооВызовов);
			сзВызовов.Добавить(стрВызовов);
			//тут пошло в разные направления
			Для Каждого мВложенногоНаправления ИЗ СтрНаправления.Значение Цикл
				сзВложенногоВызова 	= Новый СписокЗначений;
				КлючевоеУсловие		= ОпределитьКлючевоеУсловиеНаправления(СтрНаправления.Тип,мВложенногоНаправления,стрВозвращаемоеЗначение);
				сооВызовов.Вставить(КлючевоеУсловие,сзВложенногоВызова);
				ЗаполнитьСписокВызовов(сзВложенногоВызова,мВложенногоНаправления,ОбъектОбработки,КонтекстВыполнения,стрВозвращаемоеЗначение);	
			КонецЦикла;
			стрВызовов.Вставить("ТипУсловия",ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(ТипЗнч(КлючевоеУсловие))); 
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры

// Функция - Определяет ключевое условие/значение по которому будет запускаться это направление
//
// Параметры:
//  Тип					 - ТипЭлементовГрафическойСхемы	 - 
//  мНаправления		 - Массив - 
//  ВозвращаемоеЗначение - ФиксированнаяСтруктура - Описание возврашаемого значения предыдущего шага обработки	 - 
// 
// Возвращаемое значение:
//   - Булево, Значение перечисления
//
Функция ОпределитьКлючевоеУсловиеНаправления(Тип,мНаправления,ВозвращаемоеЗначение)
	Результат = Неопределено;
	Если мНаправления.Количество() Тогда
		Если Тип = Тип("ЭлементГрафическойСхемыУсловие") Тогда
			стрИмяЛинии = мНаправления[0].Условие;
			//тут возможны Истина или Ложь, будем орентироваться на окончание элемента названия линии/ребра
			Результат 	= СтрЗаканчиваетсяНа(стрИмяЛинии,стрРазделительИмени()+1);
		ИначеЕсли Тип = Тип("ЭлементГрафическойСхемыВыборВарианта") Тогда
			стрИмяВарианта = мНаправления[0].Условие;
			Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ВозвращаемоеЗначение) Тогда
				Если СтрНачинаетсяС(ВозвращаемоеЗначение.ОписаниеТипов,ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().Перечисления) Тогда
					сооЗначений	= ОбщийМодульВызовСервера_Ei.ПолучитьЗначенияПеречисления(ВозвращаемоеЗначение.ОписаниеТипов);
					стрЗначение = сооЗначений.Получить(стрИмяВарианта); 
					Если Не стрЗначение = Неопределено Тогда
						Результат 	= стрЗначение.Значение;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
		ИначеЕсли Тип = Тип("ЭлементГрафическойСхемыРазделение") Тогда
			Результат = мНаправления[0].Условие;  //тут ключом будет просто имя линии/маршрута
		КонецЕсли;
	КонецЕсли;	
	Возврат Результат;
КонецФункции	

// Функция - Получает последний элемент направления процесса графической схемы
//
// Параметры:
//  Коллекция - Массив,СписокЗначений или Структура -   
// 
// Возвращаемое значение:
//   - Структура
//
Функция ПоследнийЭлементВложеннойКоллекции(Коллекция) Экспорт
	Если ТипЗнч(Коллекция) =  Тип("Массив") Тогда
		Если Коллекция.Количество() Тогда
			Возврат ПоследнийЭлементВложеннойКоллекции(Коллекция[Коллекция.ВГраница()]);	
		КонецЕсли;
	ИначеЕсли ТипЗнч(Коллекция) =  Тип("Структура") Тогда
		//разделение на несколько путей
		Если Коллекция.Свойство("Значение") И ТипЗнч(Коллекция.Значение) = Тип("Массив") Тогда
			//тут вложенный массив направлений см. ПроцессыВызовСервера_Ei.ДополнитьМассивНаправления()
			Возврат ПоследнийЭлементВложеннойКоллекции(Коллекция.Значение);	
		ИначеЕсли Коллекция.Свойство("сооВызовов") Тогда
			//тут вложенный список вызовов см. ЗаполнитьСписокВызовов()
			Возврат ПоследнийЭлементВложеннойКоллекции(Коллекция.сооВызовов);
		Иначе
			Возврат Коллекция; 
		КонецЕсли 	
	ИначеЕсли ТипЗнч(Коллекция) =  Тип("СписокЗначений") Тогда
		Если Коллекция.Количество() Тогда
			Возврат ПоследнийЭлементВложеннойКоллекции(Коллекция[Коллекция.Количество()-1].Значение);	
		КонецЕсли;
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Для Каждого КлючЗначение ИЗ Коллекция  Цикл
			Возврат ПоследнийЭлементВложеннойКоллекции(КлючЗначение.Значение);	//возьмем только первый (пока первый или последний не столь важно)
		КонецЦикла;	
	Иначе
		Возврат Коллекция;
	КонецЕсли;	
КонецФункции	

Функция ИмяФункцииЗавершенияФоновогоПотока()
	Возврат "ОО_ФоновыйПотокЗавершение";
КонецФункции

// Функция - Преобразовать список оповещений в 
//
// Параметры:
//  сзОповещения - Список значение	 - Список описаний оповещений
// 
// Возвращаемое значение:
//   - Список значений, где от описаний оповещений остается только структура доп. параметров доступная на сервере
//
Функция ПреобразоватьСписокОповещений(сзОповещения)
	Результат = сзОповещения.Скопировать();
	Для Каждого ЭлСЗ Из Результат Цикл
		Если ТипЗнч(ЭлСЗ.Значение) = Тип("ОписаниеОповещения") Тогда
			ЭлСЗ.Значение = Новый Структура("ДополнительныеПараметры,ИмяОбработчика",ЭлСЗ.Значение.ДополнительныеПараметры,ЭлСЗ.Значение.ДополнительныеПараметры.ИмяОбработчика);		
			ЭлСЗ.Значение.ДополнительныеПараметры.Удалить("ИмяОбработчика");  //удалим чтобы не путаться
		КонецЕсли;	
	КонецЦикла;	
	Возврат Результат; 
КонецФункции	


#Область ОбработчикиОповещений

Процедура ОО_ВыполнитьПереходКСледующейОбработке(Результат,ОписаниеПотока) Экспорт
	ОбработкаПрерыванияПользователя();
	Если ТипЗнч(Результат) = Тип("ИнформацияОбОшибке") Тогда
		ПроцессыКлиентСервер_Ei.ВыполнитьПереходКСледующейОбработке(ОписаниеПотока,,Результат);
	Иначе
		ПроцессыКлиентСервер_Ei.ВыполнитьПереходКСледующейОбработке(ОписаниеПотока);
	КонецЕсли;	
КонецПроцедуры

// Процедура - выполняемая для блока "Завершения", по параметрам  аналог ОО_ВыполнитьОбработку в модуле формы обработок
// необходима для возвращение результата потока в функции ВыполнитьПоток() 
// последовательный запуск производится из ВыполнитьПереходКСледующейОбработке()
//
// Параметры:
//  ОО_КСледующей	 - ОписаниеОповещения 	- С переходом на функцию   ПроцессыКлиент_Ei.ОО_ВыполнитьПереходКСледующейОбработке() в дополнительных параметрах структура ОписаниеПотока, формируемая процедурой ПроцессыКлиент_Ei.ВыполнитьПоток()
//										- сзВызовов 	- СписокЗначений 	- Последовательность подготовленных ОписанийОповещений вызова обоработок, первой располагется следующая к запуску обработка
//										- Контекст  	- Структура  		- Аналог структуры "ДоступныеСтруктуры" из переменной формы СтруктураПеременных
//  ДопПараметры	 - Структура		- Структура, доп. параметров
//										- Настройка 			- Структура - настройка экземпляра обработки получаемая функцией ПолучитьНастройкуДляСохранения()
//										- ВозвращаемоеЗначение 	- Структура - описание возврашаемого значения в который нужно поместить результат выполнения, своства структуры формируются функцией ОписаниеЗначенияВызовСервера_Ei.Получить()
//                                      - ИмяОбработки			- Строка 	- Имя обработки как оно задано в дереве доступных обработок
Процедура ОО_ЗавершениеПотока(ОО_КСледующей,ДопПараметры) Экспорт
	ОО_КСледующей.ДополнительныеПараметры.Контекст.Вставить("Результат",ОО_КСледующей.ДополнительныеПараметры.Контекст.Объект);		
КонецПроцедуры 

// Процедура - выполняемая для запуска фоновых заданий при разделении на графической схеме, по параметрам  аналог ОО_ВыполнитьОбработку в модуле формы обработок
// необходима для возвращение результата потока в функции ВыполнитьПоток() 
// последовательный запуск производится из ВыполнитьПереходКСледующейОбработке()
//
// Параметры:
//  ОО_КСледующей	 - ОписаниеОповещения 	- С переходом на функцию   ПроцессыКлиент_Ei.ОО_ВыполнитьПереходКСледующейОбработке() в дополнительных параметрах структура ОписаниеПотока, формируемая процедурой ПроцессыКлиент_Ei.ВыполнитьПоток()
//										- сзВызовов 	- СписокЗначений 	- Последовательность подготовленных ОписанийОповещений вызова обоработок, первой располагется следующая к запуску обработка
//										- Контекст  	- Структура  		- Аналог структуры "ДоступныеСтруктуры" из переменной формы СтруктураПеременных
//  ДопПараметры	 - Структура		- Структура, доп. параметров
//										- Настройка 			- Структура - настройка экземпляра обработки получаемая функцией ПолучитьНастройкуДляСохранения()
//										- ВозвращаемоеЗначение 	- Структура - описание возврашаемого значения в который нужно поместить результат выполнения, своства структуры формируются функцией ОписаниеЗначенияВызовСервера_Ei.Получить()
//                                      - ИмяОбработки			- Строка 	- Имя обработки как оно задано в дереве доступных обработок
//
Процедура ОО_ФоновыйПотокНачало(ОО_КСледующей,ДопПараметры) Экспорт
	//теперь все что ниже - до конца или до следующего соединения нужно выполнить в серверном потоке
	//переложим из одного массива в другой
	СобытиеОтладки 			= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Выполнение обработки <"+ДопПараметры.ИмяОбработки+">","Процессы"); //тут нужно как уто указать ее имя
	Попытка
		мФоновогоВыполнения = Новый Массив;
		мУдаления 			= Новый Массив;
		чИндекс				= 0;
		ОписаниеПотока 		= ОО_КСледующей.ДополнительныеПараметры;
		Для Каждого элСЗ из ОО_КСледующей.ДополнительныеПараметры.сзВызовов Цикл
			Если ТипЗнч(элСЗ.Значение) = Тип("Структура") Тогда
				мФоновогоВыполнения.Добавить(элСЗ.Значение);
				мУдаления.Добавить(чИндекс);
			ИначеЕсли ТипЗнч(элСЗ.Значение) = Тип("ОписаниеОповещения") И элСЗ.Значение.ИмяПроцедуры = ИмяФункцииЗавершенияФоновогоПотока()  Тогда
				Прервать;	
			КонецЕсли;	
			чИндекс = чИндекс+1;
		КонецЦикла;
		//и удалим их из списка вызовов что бы сразу перейти к слиянию/ОО_ФоновыйПотокЗавершение
		Для Каждого чИндекс ИЗ мУдаления Цикл
			ОО_КСледующей.ДополнительныеПараметры.сзВызовов.Удалить(чИндекс);		
		КонецЦикла;
		//теперь запустим потоки сохранив идентификаторы ФЗ 
		Результат = Новый Структура("мИдентифкаторов,ВхОбъект",Новый Массив,ОписаниеПотока.Контекст.Объект);
		Для Каждого ОбъектПотока ИЗ мФоновогоВыполнения Цикл
			Для Каждого СооУсловий Из ОбъектПотока.сооВызовов Цикл
				Результат.мИдентифкаторов.Добавить(ПроцессыВызовСервера_Ei.ЗапуститьПоток(СооУсловий.Ключ,ПреобразоватьСписокОповещений(СооУсловий.Значение),ОписаниеПотока.Контекст));			
			КонецЦикла	
		КонецЦикла;
		ДопПараметры.ВозвращаемоеЗначение = Результат
	Исключение
		ИнфоОбОшибке	=  ИнформацияОбОшибке();
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
		ВыполнитьОбработкуОповещения(ОО_КСледующей,ИнфоОбОшибке); //Выполняется ПроцессыКлиент_Ei.ОО_ВыполнитьПереходКСледующейОбработке()	
		Возврат;
	КонецПопытки;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	ВыполнитьОбработкуОповещения(ОО_КСледующей); //к ОО_ФоновыйПотокЗавершение
КонецПроцедуры

// Процедура - выполняемая для ожидания завершения фоновых заданий при разделении на графической схеме, по параметрам  аналог ОО_ВыполнитьОбработку в модуле формы обработок
// необходима для возвращение результата потока в функции ВыполнитьПоток() 
// последовательный запуск производится из ВыполнитьПереходКСледующейОбработке()
//
// Параметры:
//  ОО_КСледующей	 - ОписаниеОповещения 	- С переходом на функцию   ПроцессыКлиент_Ei.ОО_ВыполнитьПереходКСледующейОбработке() в дополнительных параметрах структура ОписаниеПотока, формируемая процедурой ПроцессыКлиент_Ei.ВыполнитьПоток()
//										- сзВызовов 	- СписокЗначений 	- Последовательность подготовленных ОписанийОповещений вызова обоработок, первой располагется следующая к запуску обработка
//										- Контекст  	- Структура  		- Аналог структуры "ДоступныеСтруктуры" из переменной формы СтруктураПеременных
//  ДопПараметры	 - Структура		- Структура, доп. параметров
//										- Настройка 			- Структура - настройка экземпляра обработки получаемая функцией ПолучитьНастройкуДляСохранения()
//										- ВозвращаемоеЗначение 	- Структура - описание возврашаемого значения в который нужно поместить результат выполнения, своства структуры формируются функцией ОписаниеЗначенияВызовСервера_Ei.Получить()
//                                      - ИмяОбработки			- Строка 	- Имя обработки как оно задано в дереве доступных обработок
//
Процедура ОО_ФоновыйПотокЗавершение(ОО_КСледующей,ДопПараметры) Экспорт
	Перем РезультатОжидания;
	СобытиеОтладки 			= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Выполнение обработки <"+ДопПараметры.ИмяОбработки+">","Процессы"); //тут нужно как уто указать ее имя
	Попытка
		//Ожидаем завершения массива фоновых заданий наполненного в ОО_ФоновыйПотокНачало
		ОписаниеПотока 		= ОО_КСледующей.ДополнительныеПараметры;
		ОжиданиеЗавершения(ОписаниеПотока,РезультатОжидания);
		Пока РезультатОжидания.Завершено = Ложь Цикл	
			ОжиданиеЗавершения(ОписаниеПотока,РезультатОжидания);	
		КонецЦикла;
		//переопределяем объект, то что поступило на вход разделение, должно являеться выходным значением для всей конструкции - Слияния
		ДопПараметры.ВозвращаемоеЗначение = ОписаниеПотока.Контекст.Объект.ВхОбъект;
	Исключение
		ИнфоОбОшибке	=  ИнформацияОбОшибке();
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
		ВыполнитьОбработкуОповещения(ОО_КСледующей,ИнфоОбОшибке); //Выполняется ПроцессыКлиент_Ei.ОО_ВыполнитьПереходКСледующейОбработке()	
		Возврат;
	КонецПопытки;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	ВыполнитьОбработкуОповещения(ОО_КСледующей); //к следующей обработке после Слияния
КонецПроцедуры

// Процедура - Ожидание завершения потоков с выводом накопленных сообщений
//
// Параметры:
//  ОписаниеПотока		 - Структура - Описание потока
//  РезультатОжидания	 - Структура - Возвращемый параметр
//
Процедура ОжиданиеЗавершения(ОписаниеПотока,РезультатОжидания)
	РезультатОжидания   = ПроцессыВызовСервера_Ei.ОжидатьЗавершенияПотоков(ОписаниеПотока.Контекст.Объект.мИдентифкаторов,1);
	Для Каждого СообщПольз Из РезультатОжидания.Сообщения Цикл
		СообщПольз.Сообщить();		
	КонецЦикла;
КонецПроцедуры	

#КонецОбласти


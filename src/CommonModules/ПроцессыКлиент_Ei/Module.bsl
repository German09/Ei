#Область ВыборОбъекта

Функция ВсплываемаяГруппа(Форма) Экспорт
	Возврат Форма.Элементы.ОбъектГруппаВсп;	
КонецФункции

Процедура ВыбратьОбъект(Форма) Экспорт
	ТД 			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		СтруктураПеременных = ОбщийМодульКлиент_Ei.ПолучитьСтруктуруПеременных(Форма,Неопределено,ТД.Процессы_Объект,Ложь);
		ВспГруппа 			= ВсплываемаяГруппа(Форма);		
		ФормаРодитель		= ВыборКлиент_Ei.НаследоватьВыбор(Форма,Форма.Элементы.Выбор,ВспГруппа);
		ОО_ВыбораОбъекта 	= Новый ОписаниеОповещения("ЗавершениеВыбораОбъекта",ЭтотОбъект,Новый Структура("Форма",Форма));
		ВыборКлиент_Ei.НачалоВыбора(ОО_ВыбораОбъекта,ФормаРодитель.Выбор,Форма,Форма.Элементы.ВыборОбъекта,СтруктураПеременных,Ложь,Ложь);
		ВспГруппа.Видимость = Истина; //Скрывается обработкой ожидания, чтобы не мешала
		Форма.ПодключитьОбработчикОжидания("ПоказатьВыборОбъекта",0.1,Истина); // по другому не сработает
	КонецЕсли;	
КонецПроцедуры

Процедура ПоказатьВыборОбъекта(Форма) Экспорт
	ВспГруппа 		= ВсплываемаяГруппа(Форма);
	ВспГруппа.Показать();
	Форма.ПодключитьОбработчикОжидания("СкрытьВсплывающиеГруппы",1, Ложь);	//вызывает 	
КонецПроцедуры

Процедура ЗавершениеВыбораОбъекта(ВыбранноеЗначение, ДопПараметры) Экспорт
	Форма 		= ДопПараметры.Форма;
	ТД 			= Форма.ПолучитьПереопределяемыйОбъектОбработки();
	Если Не ТД = Неопределено Тогда
		ТД.Процессы_Объект = ВыбранноеЗначение.ЗначениеПараметра;
		ОбновитьЗаголовокОбъекта(Форма,ТД);
	КонецЕсли;	
	ВспГруппа 	= ВсплываемаяГруппа(Форма);	
	ВспГруппа.Видимость = Ложь;
Конецпроцедуры

Процедура ОбновитьЗаголовокОбъекта(Форма,ТД) Экспорт
	Элемент = Форма.Элементы.Найти("ВыборОбъекта");
	Если Не Элемент = Неопределено Тогда
		Если Не ЗначениеЗаполнено(ТД.Процессы_Объект) Тогда
			Элемент.Заголовок = "";
		Иначе
			Элемент.Заголовок = "Объект = "+ТД.Процессы_Объект;
		КонецЕсли;						
	КонецЕсли;				
КонецПроцедуры	


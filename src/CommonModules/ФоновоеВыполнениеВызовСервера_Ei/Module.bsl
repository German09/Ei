// Вызовы фонового выполнения вариантов Ei с клиента, реализация см. ФоновоеВыполнениеСервер_Ei
// Без @strict-types: записи запусков читаются из хранилища настроек.

#Область ПрограммныйИнтерфейс

// Запускает вариант строки набора в фоновом задании.
//
// Параметры:
//  Описание - см. ФоновоеВыполнениеСервер_Ei.Запустить.Описание
//
// Возвращаемое значение:
//  см. ФоновоеВыполнениеСервер_Ei.Запустить
//
Функция Запустить(Знач Описание) Экспорт
	
	Возврат ФоновоеВыполнениеСервер_Ei.Запустить(Описание);
	
КонецФункции

// Останавливает фоновый запуск.
//
// Параметры:
//  Ид - Строка - идентификатор запуска
//
// Возвращаемое значение:
//  см. ФоновоеВыполнениеСервер_Ei.Остановить
//
Функция Остановить(Знач Ид) Экспорт
	
	Возврат ФоновоеВыполнениеСервер_Ei.Остановить(Ид);
	
КонецФункции

// Забирает итог завершенного фонового запуска и удаляет его запись.
//
// Параметры:
//  Ид - Строка - идентификатор запуска
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор формы Ei
//
// Возвращаемое значение:
//  см. ФоновоеВыполнениеСервер_Ei.ЗабратьРезультат
//
Функция ЗабратьРезультат(Знач Ид, Знач УникальныйИдентификатор) Экспорт
	
	Возврат ФоновоеВыполнениеСервер_Ei.ЗабратьРезультат(Ид, УникальныйИдентификатор);
	
КонецФункции

// Фоновые запуски текущего пользователя: выполняющиеся и завершенные, результат которых еще не показан,
// с сообщениями пользователю, которых клиент еще не показал.
//
// Параметры:
//  ПоказаноСообщений - Соответствие из КлючИЗначение, Неопределено - сколько сообщений запуска клиент уже показал:
//   * Ключ - Строка - идентификатор запуска
//   * Значение - Число
//
// Возвращаемое значение:
//  Массив из см. ФоновоеВыполнениеСервер_Ei.ДляКлиента
//
Функция Записи(Знач ПоказаноСообщений = Неопределено) Экспорт
	
	Результат = Новый Массив;
	Для Каждого Запись Из ФоновоеВыполнениеСервер_Ei.Записи() Цикл
		Показано = ?(ПоказаноСообщений = Неопределено, Неопределено, ПоказаноСообщений.Получить(Запись.Ид));
		Результат.Добавить(ФоновоеВыполнениеСервер_Ei.ДляКлиента(Запись, ?(Показано = Неопределено, 0, Показано)));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

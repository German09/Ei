//
Процедура ПередатьЗначение(Знач Данные) Экспорт
	
	ФоновоеВыполнениеСервер_Ei.ПередатьЗначение(Данные);
	
КонецПроцедуры

// Данные вариантов, заданные кодом фонового запуска.
//
// Параметры:
//  Ид - Строка - идентификатор запуска
//
// Возвращаемое значение:
//  см. ФоновоеВыполнениеСервер_Ei.ЗаданныеДанные
//
Функция ЗаданныеДанные(Знач Ид) Экспорт
	
	Возврат ФоновоеВыполнениеСервер_Ei.ЗаданныеДанные(Ид);
	
КонецФункции

// Дополняет вложенные запуски фонового запуска результатами из их снимков в истории: временное хранилище
// задания из сеанса клиента недоступно.
//
// Параметры:
//  Вложенные - Массив из см. ВариантыВызовСервера_Ei.ВложенныеЗапуски
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор формы Ei для временного хранилища
//
// Возвращаемое значение:
//  Массив из см. ВариантыВызовСервера_Ei.ВложенныеЗапуски
//
Функция ВложенныеЗапуски(Знач Вложенные, Знач УникальныйИдентификатор) Экспорт
	
	Для Каждого Вложенный Из Вложенные Цикл
		Если Вложенный.ЕстьСнимок Тогда
			Вложенный.ОписаниеЗначения = ИсторияВызовСервера_Ei.ОписаниеРезультата(Вложенный.Ид, УникальныйИдентификатор, Вложенный.ИмяВарианта);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Вложенные;
	
КонецФункции

// Фоновые запуски текущего пользователя: выполняющиеся и завершенные, результат которых еще не показан,
// с сообщениями пользователю, которых клиент еще не показал.
//
// Параметры:
//  ПоказаноСообщений - Соответствие из КлючИЗначение, Неопределено - сколько сообщений запуска клиент уже показал:
//   * Ключ - Строка - идентификатор запуска
//   * Значение - Число
//
// Возвращаемое значение:
//  Массив из см. ФоновоеВыполнениеСервер_Ei.ДляКлиента
//
Функция Записи(Знач ПоказаноСообщений = Неопределено) Экспорт
	
	Результат = Новый Массив;
	Для Каждого Запись Из ФоновоеВыполнениеСервер_Ei.Записи() Цикл
		Показано = ?(ПоказаноСообщений = Неопределено, Неопределено, ПоказаноСообщений.Получить(Запись.Ид));
		Результат.Добавить(ФоновоеВыполнениеСервер_Ei.ДляКлиента(Запись, ?(Показано = Неопределено, 0, Показано)));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

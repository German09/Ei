// Функция - Переопределеить значения контекста, опрделяет значение всех ввозвращаемых параметров
//
// Параметры:
//  КонтекстВыполнения	 - Структура	 - 
//  Параметры			 - Структура	 - Возвращаемый параметр
//  ЭтаФорма			 - Стурктура	 - Возвращаемый параметр
//  Объект				 - Произвольный	 - Возвращаемый параметр
//  Результат			 - Произвольный	 - Возвращаемый параметр
// 
// Возвращаемое значение:
//   -  Структура с реальными значениями (не адресами временного хранилища)
//
Функция ПереопределеитьЗначенияКонтекста(Знач КонтекстВыполнения, Параметры = Неопределено, ЭтаФорма = Неопределено, Объект = Неопределено, Результат = Неопределено)  Экспорт
	КонтекстВыполнения.Свойство("Параметры",Параметры);
	Параметры 	= ПереопределитьПараметры(Параметры);
	КонтекстВыполнения.Свойство("ЭтаФорма",ЭтаФорма);
	ЭтаФорма 	= ПереопределитьЭтуФорму(ЭтаФорма); 
	КонтекстВыполнения.Свойство("Объект",Объект);
	Объект 		= ПереопределитьЗначение(Объект);
	КонтекстВыполнения.Свойство("Результат",Результат);
	Результат 	= ПереопределитьЗначение(Результат);
	Возврат Новый Структура("Параметры,ЭтаФорма,Объект,Результат",Параметры,ЭтаФорма,Объект,Результат);
КонецФункции

// Функция - Переопределить значение, производит распаковку значения из кеша или из хранилища, при вызове с клиента безопасно только приводить результирующеее значение к Типу доступному на клиенте
//
// Параметры:
//  Значение		 - Произвольное	 - Искомое значение, которое 
//  ТипПриведения	 - Описание типов - Описание типов в которому преобразовывается значение
// 
// Возвращаемое значение:
//   - Произволное, преобразованное - распакованное значение
//
Функция ПереопределитьЗначение(Значение,ТипПриведения =  Неопределено) Экспорт
	Перем Ссылка;
	Результат = Значение;
	Если ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") И Значение.Свойство("Ссылка",Ссылка) Тогда
		Если ЭтоАдресВременногоХранилища(Ссылка) Тогда 
			Результат = ПолучитьИзВременногоХранилища(Ссылка);
		ИначеЕсли ОбщийМодульВызовСервера_Ei.ЭтоАдресКешаЗначений(Ссылка)  Тогда
			Результат = ОбщийМодульВызовСервера_Ei.ПолучитьЗначениеИзКеша(Ссылка);
		КонецЕсли;	
	КонецЕсли;		
	Если Не ТипПриведения = Неопределено Тогда 
		Результат = ТипПриведения.ПривестиЗначение(Результат)	
	КонецЕсли;	
	Возврат Результат;	
КонецФункции

Функция ПереопределитьПараметры(Значение) Экспорт
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Результат = ОбщийМодульКлиентСервер_Ei.СкопироватьСтруктуру(Значение);
		Для Каждого Свойство ИЗ Результат Цикл
			Значение.Вставить(Свойство.Ключ, ПереопределитьЗначение(Свойство.Значение));
		КонецЦикла;
	Иначе
		Результат = Значение;
	КонецЕсли;	
	Возврат Результат;	
КонецФункции

Функция ПереопределитьЭтуФорму(Значение)
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Результат = ОбщийМодульКлиентСервер_Ei.СкопироватьСтруктуру(Значение);
		Для Каждого Свойство ИЗ Результат Цикл
			Результат.Вставить(Свойство.Ключ, ПреопределитьСвойствоФормы(Свойство));
		КонецЦикла
	Иначе
		Результат = Значение;
	КонецЕсли;	
	Возврат Результат;	
КонецФункции

Функция ПреопределитьСвойствоФормы(Свойство)
	Если Свойство.Ключ = "РезультатВыполнения" Тогда
		Результат = ПереопределитьЗначение(Свойство.Значение);
	ИначеЕсли Свойство.Ключ = "Параметры" Тогда
		Результат = ПереопределитьПараметры(Свойство.Значение);
	Иначе
		Результат = ПереопределитьЭтуФорму(Свойство.Значение);
	КонецЕсли;
	Возврат Результат;
КонецФункции	



Процедура ПереопределеитьЗначенияКонтекста(КонтекстВыполнения, Параметры, ЭтаФорма, Объект, Результат)  Экспорт
	КонтекстВыполнения.Свойство("Параметры",Параметры);
	Параметры 	= ПереопределитьПараметры(Параметры);
	КонтекстВыполнения.Свойство("ЭтаФорма",ЭтаФорма);
	ЭтаФорма 	= ПереопределитьЭтуФорму(ЭтаФорма); 
	КонтекстВыполнения.Свойство("Объект",Объект);
	Объект 		= ПереопределитьЗначение(Объект);
	КонтекстВыполнения.Свойство("Результат",Результат);
	Результат 	= ПереопределитьЗначение(Результат);
КонецПроцедуры

// Функция - Переопределить значение, производит распаковку значения из кеша или из хранилища, при вызове с клиента безопасно только приводить результирующеее значение к Типу доступному на клиенте
//
// Параметры:
//  Значение		 - Произвольное	 - Искомое значение, которое 
//  ТипПриведения	 - Описание типов - Описание типов в которому преобразовывается значение
// 
// Возвращаемое значение:
//   - Произволное, преобразованное - распакованное значение
//
Функция ПереопределитьЗначение(Значение,ТипПриведения =  Неопределено) Экспорт
	Результат = Значение;
	Если ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		Если ЭтоАдресВременногоХранилища(Значение.Ссылка) Тогда 
			Результат = ПолучитьИзВременногоХранилища(Значение.Ссылка);
		ИначеЕсли ОбщийМодульВызовСервера_Ei.ЭтоАдресКешаЗначений(Значение.Ссылка)  Тогда
			Результат = ОбщийМодульВызовСервера_Ei.ПолучитьЗначениеИзКеша(Значение.Ссылка);
		КонецЕсли;	
	КонецЕсли;		
	Если Не ТипПриведения = Неопределено Тогда 
		Результат = ТипПриведения.ПривестиЗначение(Результат)	
	КонецЕсли;	
	Возврат Результат;	
КонецФункции

Функция ПереопределитьПараметры(Значение) Экспорт
	Если ТипЗнч(Значение) = Тип("Структура") Тогда	
		Для Каждого Свойство ИЗ Значение Цикл
			Значение.Вставить(Свойство.Ключ, ПереопределитьЗначение(Свойство.Значение));
		КонецЦикла;
	КонецЕсли;	
	Возврат Значение;	
КонецФункции

Функция ПереопределитьЭтуФорму(Значение)
	Если ТипЗнч(Значение) = Тип("Структура") Тогда	
		ПреопределитьВариант(Значение);	
	КонецЕсли;	
	Возврат Значение;	
КонецФункции

Функция ПреопределитьВариант(Значение)
	Значение.Вставить("РезультатВыполнения", 	ПереопределитьЗначение(Значение.РезультатВыполнения));
	Если Значение.Свойство("Параметры") Тогда
		Значение.Вставить("Параметры", 				ПереопределитьПараметры(Значение.Параметры));
	КонецЕсли;	
	Если Значение.Свойство("Варианты") Тогда
		Для Каждого Свойство ИЗ Значение.Варианты Цикл
			Значение.Варианты.Вставить(Свойство.Ключ, ПреопределитьВариант(Свойство.Значение));
		КонецЦикла;	
	КонецЕсли;	
КонецФункции	



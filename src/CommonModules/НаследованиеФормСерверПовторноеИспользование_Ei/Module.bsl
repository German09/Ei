Функция ПолучитьСобытияЭлемента(Тип,Расширение =  Неопределено) Экспорт
	Результат = ПолучитьВсеСобытия().НайтиСтроки(Новый Структура("Тип",Тип));		
	Если Не Расширение =  Неопределено Тогда
		Для Каждого Свойство ИЗ ПолучитьВсеСобытия().НайтиСтроки(Новый Структура("Тип",Расширение)) Цикл
			Результат.Добавить(Свойство);		
		КонецЦикла;	
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПолучитьСвойстваЭлемента(Тип,Расширение =  Неопределено) Экспорт
	Результат = ПолучитьВсеСвойства().НайтиСтроки(Новый Структура("Тип",Тип));
	Если Не Расширение =  Неопределено Тогда
		Для Каждого Свойство ИЗ ПолучитьВсеСвойства().НайтиСтроки(Новый Структура("Тип",Расширение)) Цикл
			Результат.Добавить(Свойство);		
		КонецЦикла;	
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПолучитьВсеСобытия() Экспорт
	Возврат НаследованиеФормСерверПовторноеИспользование_Ei.ПолучитьСобытияИлиСвойства("События",3);	
КонецФункции

Функция ПолучитьВсеСвойства()
	Возврат НаследованиеФормСерверПовторноеИспользование_Ei.ПолучитьСобытияИлиСвойства("Свойства");	
КонецФункции

Функция ПолучитьСобытияИлиСвойства(Тип = "События",чШирина = 2) Экспорт 
	ТД = ПолучитьОбщийМакет("НаследованиеФорм"+Тип+"_Ei");
	ПЗ = Новый ПостроительЗапроса;
	ПЗ.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТД.Область(1,1,ТД.ВысотаТаблицы,чШирина)); 
	ПЗ.Выполнить();
	Возврат ПЗ.Результат.Выгрузить();
КонецФункции

Функция ПолучитьСериализованныеТипы() Экспорт
	ТЗ = ПолучитьВсеСвойства().Скопировать(,"Тип");
	ТЗ.Свернуть("Тип");
	мУдаления = Новый Массив;
	Для каждого Строка ИЗ ТЗ Цикл
		Если Найти(Строка.Тип,".") Тогда //это расширение и его тип нам не получить 
			мУдаления.Добавить(Строка);
		КонецЕсли;	
	КонецЦикла;
	//удалим расширения
	Для Каждого удСтрока ИЗ мУдаления Цикл
		ТЗ.Удалить(удСтрока);
	КонецЦикла;	
	мстрТипов = ТЗ.ВыгрузитьКолонку("Тип");
	Возврат ОбщийМодульКлиентСервер_Ei.ПроверитьОписаниеТипов(мстрТипов);
КонецФункции	
#Область ПрограммныйИнтерфейс

// Получает массив структур, характеризующих направления процесса по графической схеме.
//
// Параметры:
//  ГрафСхема - ГрафическаяСхема - графическая схема процесса
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Тип 		- Тип - тип элемента графической схемы
//   * Значение 	- Строка, Массив из Произвольный - имя элемента графической схемы или массив вложенных направлений
//   * Условие	- Строка - имя соединительной линии для выбора или слияния
//   * Уточнение - Строка - наименование линии для уточнения объекта
//
Функция ПолучитьМассивНаправления(ГрафСхема) Экспорт
	Направления 	= Новый Массив;
	МатрицаГрафа	= ПолучитьМатрицуГрафа(ГрафСхема);
	Для Каждого СтрокаСтарта Из ПолучитьСтрокиНачала(МатрицаГрафа) Цикл
		ДополнитьМассивНаправления(ГрафСхема, СтрокаСтарта, Неопределено, Направления);
	КонецЦикла;
	Возврат Направления;
КонецФункции

// Возвращает графическую схему процесса по умолчанию, см. ОбщийМакет.СхемаПроцессаПоУмолчанию_Ei
//
// Возвращаемое значение:
//  ГрафическаяСхема - схема процесса по умолчанию
//
Функция ПолучитьМакетСхемыПоУмолчанию() Экспорт
	Возврат ПолучитьОбщийМакет("СхемаПроцессаПоУмолчанию_Ei");
КонецФункции

// Возвращает графическую схему процесса по умолчанию, сериализованную в строку:
// клиенту передается строка, а не ГрафическаяСхема.
//
// Возвращаемое значение:
//  Строка - сериализованная схема, см. ПолучитьМакетСхемыПоУмолчанию
//
Функция ПолучитьМакетСхемыПоУмолчаниюСтрокой() Экспорт
	Возврат ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(ПолучитьМакетСхемыПоУмолчанию());
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область РазборГрафическойСхемы

// Функция - Получить матрицу графа, в колонках ребра - соединительные линии, в строках, вершины - элементы графической схемы
//
// Параметры:
//  ГрафСхема	 - ГрафическаяСхема
// 
// Возвращаемое значение:
//  ТаблицаЗначений - матрица графа
//
Функция ПолучитьМатрицуГрафа(ГрафСхема)
	Результат = Новый ТаблицаЗначений;
	Для Каждого ДопКолонка ИЗ ПолучитьВспомогательныеКолонки() Цикл
		Результат.Колонки.Добавить(ДопКолонка);
	КонецЦикла;	
	//переберем  линии
	Для Каждого Элемент из  ГрафСхема.ЭлементыГрафическойСхемы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементГрафическойСхемыСоединительнаяЛиния") Тогда
			Результат.Колонки.Добавить(Элемент.Имя,Новый ОписаниеТипов("Число"));
			Строка = ПолучитьСтрокуВМатрицеГрафа(Результат,Элемент.НачалоЭлемент);
			Если Не Строка = Неопределено Тогда
				Строка[Элемент.Имя] = 1;	
			КонецЕсли;	
			Строка = ПолучитьСтрокуВМатрицеГрафа(Результат,Элемент.КонецЭлемент);
			Если Не Строка = Неопределено Тогда
				Строка[Элемент.Имя] = -1;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Функция - Получает строку по имени в матрице графа
//
// Параметры:
//  Результат	 - ТаблицаЗначений 	 - Матрица графа
//  Вершина		 - Произвольный	 - элемент графической схемы, соединяемый линией
// 
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - строка вершины или Неопределено, если вершина не задана
//
Функция ПолучитьСтрокуВМатрицеГрафа(Результат,Вершина) 
	СтрокаВершины = Неопределено;
	Если Не Вершина =  Неопределено Тогда
		СтрокаВершины = Результат.Найти(Вершина.Имя,"Наименование");
		Если СтрокаВершины =  Неопределено Тогда 
			СтрокаВершины =  Результат.Добавить();
			СтрокаВершины.Наименование 	= Вершина.Имя;
			СтрокаВершины.Тип			= ТипЗнч(Вершина);
		КонецЕсли;
	КонецЕсли;
	Возврат СтрокаВершины;
КонецФункции	

// Рекурсивная процедура - Дополнить массив путей
//
// Параметры:
//  ГрафСхема	 				- ГрафическаяСхема	 - Графическая схема
//  СтрокаСтарта				- СтрокаТаблицыЗначений - Строка, с которой нужно начать перебор
//  НаправленияВерхнегоУровня	- Массив из Структура - Массив структур верхнего уровня
//	Направления					- Массив из Структура - Возвращаемый параметр массив структур или массив, массивов в случае вложенности
//
Процедура ДополнитьМассивНаправления(ГрафСхема,СтрокаСтарта,НаправленияВерхнегоУровня,Направления)
	ИменаСвойств 	= "Значение,Тип,Условие,Уточнение";
	ИсходящиеРебра 	= ПолучитьКолонкиСоЗначением(СтрокаСтарта,1);
	Если ИсходящиеРебра.Количество() Тогда 
		Направление = Новый Структура(ИменаСвойств, Новый Массив); 
		Направления.Добавить(Направление);
		Для Каждого Ребро ИЗ ИсходящиеРебра Цикл
			//это начало, теперь нужно найти в этой же колонке -1: это будет завершение 
			СтрокиЗавершения = СтрокаСтарта.Владелец().НайтиСтроки(Новый Структура(Ребро,-1));
			Для Каждого СтрокаЗавершения ИЗ СтрокиЗавершения  Цикл
				КлючУсловия				= ПолучитьКлючУсловия(ГрафСхема,СтрокаСтарта,Ребро); 	//Имя варианта или имя линии(для условия)
				Уточнение				= ПолучитьУточнение(ГрафСхема,Ребро); 					//Наименование линии приходящей в элемент
				СледующееНаправление	= Новый Структура(ИменаСвойств,СтрокаЗавершения.Наименование,СтрокаЗавершения.Тип,КлючУсловия,Уточнение); //м.б. ФиксированнаяСтруктура
				Если ИсходящиеРебра.Количество() = 1 Тогда
					Если СтрокаЗавершения.Тип = Тип("ЭлементГрафическойСхемыСлияние") 
						И Не НаправленияВерхнегоУровня = Неопределено Тогда 	//Исправление #9
						//тут переходим на уровень выше
						Если Не НайтиПоИмениВНаправлении(СледующееНаправление.Значение,НаправленияВерхнегоУровня).Количество() Тогда
							НаправленияВерхнегоУровня.Добавить(СледующееНаправление);
							ДополнитьМассивНаправления(ГрафСхема,СтрокаЗавершения,Новый Массив,НаправленияВерхнегоУровня);
						КонецЕсли;	
					Иначе	
						ЗаполнитьЗначенияСвойств(Направление,СледующееНаправление);
						//переход к следующей обработке
						ДополнитьМассивНаправления(ГрафСхема,СтрокаЗавершения,НаправленияВерхнегоУровня, Направления);
					КонецЕсли;
				Иначе
					ВложенноеНаправление = Новый Массив;
					ВложенноеНаправление.Добавить(СледующееНаправление);
					//переход ниже на уровень по одному из исходящих ребер
					ДополнитьМассивНаправления(ГрафСхема,СтрокаЗавершения,Направления,ВложенноеНаправление);
					Направление.Значение.Добавить(ВложенноеНаправление); //м.б. ФиксированныйМассив
					Направление.Тип	= СтрокаСтарта.Тип;
				КонецЕсли;	
				Прервать; //у ребра возможно только одно завершение !если нет зацикливания
			КонецЦикла;
		КонецЦикла;
		Если Не ЗначениеЗаполнено(Направление.Тип) Тогда 
			//удалим пустое значение поскольку строки могут не всегда заканчиваться блоком
			Направления.Удалить(Направления.ВГраница());
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

// Ищет направления с элементом схемы по имени.
//
// Параметры:
//  Наименование	- Строка - имя элемента графической схемы
//  Направления		- Массив из Структура - направления, см. ПолучитьМассивНаправления
//
// Возвращаемое значение:
//  Массив из Структура - найденные направления
//
Функция НайтиПоИмениВНаправлении(Наименование,Направления)
	Результат = Новый Массив;
	Для Каждого Элемент ИЗ Направления Цикл //если тут ошибка в разделение нужно добавить еще линию #9
		Если ТипЗнч(Элемент.Значение) = Тип("Строка") И Элемент.Значение = Наименование Тогда
			Результат.Добавить(Элемент);		
		КонецЕсли;	
	КонецЦикла;	
	Возврат Результат;
КонецФункции	

// Функция - Получить ключ условия для данного направления используется в ПроцессыКлиент_Ei.ОпределитьКлючевоеУсловиеНаправления()
//
// Параметры:
//  ГрафСхема	 - ГрафическаяСхема	 		- Графическая схема
//  Строка		 - СтрокаТаблицыЗначений 	- Строка в которой/из которой выходит линия 
//  Ребро		 - Строка	 				-  Имя линии направления
// 
// Возвращаемое значение:
//  Строка - Имя линии или Имя Варианта
//
Функция ПолучитьКлючУсловия(ГрафСхема,Строка,Ребро)
	Результат = Ребро;
	Если Строка.Тип = Тип("ЭлементГрафическойСхемыВыборВарианта") Тогда
		//тут вместо имени линии нужно вернуть имя варианта начала линии
		Линия = ГрафСхема.ЭлементыГрафическойСхемы.Найти(Ребро);
		Если Не Линия =  Неопределено И Не Линия.НачалоВариант = Неопределено Тогда
			Результат = Линия.НачалоВариант.Наименование; 		
		КонецЕсли;
	ИначеЕсли Строка.Тип = Тип("ЭлементГрафическойСхемыСлияние") Тогда
		Результат = "";	
	КонецЕсли;	
	Возврат Результат;
КонецФункции

// Функция - Получить колонки со значением
//
// Параметры:
//  Строка	 - СтрокаТаблицыЗначений	 -  Строка в колонках которой нужной найти значение
//  Значение - Произвольный	 - Искомое значение
// 
// Возвращаемое значение:
//  Массив из Строка - имена колонок таблицы значений
//
Функция ПолучитьКолонкиСоЗначением(Строка,Значение)
	Результат = Новый Массив;
	Для Каждого Ребро ИЗ ПолучитьМассивРебер(Строка.Владелец()) Цикл
		Если Строка[Ребро] =  Значение Тогда
			Результат.Добавить(Ребро);	
		КонецЕсли;	
	КонецЦикла;
	Возврат Результат;
КонецФункции	

// Функция - Получить уточнение соединительной линии
//
// Параметры:
//  ГрафСхема	 - ГрафическаяСхема	 - Графическая схема
//  Ребро		 - Строка	 - имя соединительной линии
// 
// Возвращаемое значение:
//  Строка, Неопределено - наименование линии или Неопределено, если наименование не задано
//
Функция ПолучитьУточнение(ГрафСхема,Ребро)
	Результат = Неопределено;
	ЛинияСоед = ГрафСхема.ЭлементыГрафическойСхемы.Найти(Ребро);
	Если Не ЛинияСоед = Неопределено И Не ПустаяСтрока(ЛинияСоед.Наименование) Тогда
		Результат = ЛинияСоед.Наименование;	
	КонецЕсли;	
	Возврат Результат;
КонецФункции	

// Функция - Получить массив ребер матрицы графа
//
// Параметры:
//  МатрицаГрафа	 - ТаблицаЗначений	 - Матрица графа 
// 
// Возвращаемое значение:
//  Массив из Строка - имена колонок
//
Функция ПолучитьМассивРебер(МатрицаГрафа)
	Результат 	= Новый Массив;
	ДопКолонки 	= ПолучитьВспомогательныеКолонки();
	Для Каждого Колонка ИЗ МатрицаГрафа.Колонки Цикл
		Если ДопКолонки.Найти(Колонка.Имя) = Неопределено Тогда
			Результат.Добавить(Колонка.Имя);			
		КонецЕсли;	
	КонецЦикла;
	Возврат Результат; 
КонецФункции

// Функция - Получает вспомогательные колонки, матрицы графа
// 
// Возвращаемое значение:
//  Массив из Строка - имена колонок
//
Функция ПолучитьВспомогательныеКолонки()
	Результат = Новый Массив;
	Результат.Добавить("Наименование");
	Результат.Добавить("Тип");
	Возврат Результат; 
КонецФункции	

// Функция - Получить строки начала
//
// Параметры:
//  МатрицаГрафа	 - ТаблицаЗначений	 - Матрица графа
// 
// Возвращаемое значение:
//  Массив из СтрокаТаблицыЗначений - строки элементов старта
//
Функция ПолучитьСтрокиНачала(МатрицаГрафа)
	Результат = МатрицаГрафа.НайтиСтроки(Новый Структура("Тип",Тип("ЭлементГрафическойСхемыСтарт")));
	Возврат Результат;
КонецФункции	

#КонецОбласти

#КонецОбласти

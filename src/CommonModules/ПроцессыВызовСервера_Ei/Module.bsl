#Область РазборГрафическойСхемы

// Функция - Получает массив струтур харатерезующих направление
//
// Параметры:
//  ГрафСхема	 - Графическая схема	 - Графическая схема
// 
// Возвращаемое значение:
//   - Массив, структур со свойствами 
//								- Тип 		- ТипЭлеменаГрафическойСхемы
//								- Значение 	- Имя элемента грфической схемы или вложенный массив
//								- Условие	- Имя соединительной линии	
//
Функция ПолучитьМассивНаправления(ГрафСхема) Экспорт
	мНаправления 	= Новый Массив;
	ТЗ =  ПолучитьМатрицуГрафа(ГрафСхема);
	Для Каждого СтрокаСтарта Из ПолучитьСтрокиНачала(ТЗ) Цикл
		ДополнитьМассивНаправления(ГрафСхема,СтрокаСтарта,Неопределено,мНаправления);
	КонецЦикла;	
	Возврат мНаправления;
КонецФункции

// Функция - Получить матрицу графа, в колонках ребра - соединительные линии, в строках, вершины - элементы графической схемы
//
// Параметры:
//  ГрафСхема	 - Графическая схема	 - Графическая схема
// 
// Возвращаемое значение:
//   - Таблица Значений
//
Функция ПолучитьМатрицуГрафа(ГрафСхема)
	Результат = Новый ТаблицаЗначений;
	Для Каждого ДопКолонка ИЗ ПолучитьВспомогательныеКолонки() Цикл
		Результат.Колонки.Добавить(ДопКолонка);
	КонецЦикла;	
	//переберем  линии
	Для Каждого Элемент из  ГрафСхема.ЭлементыГрафическойСхемы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементГрафическойСхемыСоединительнаяЛиния") Тогда
			Результат.Колонки.Добавить(Элемент.Имя,Новый ОписаниеТипов("Число"));
			Строка = ПолучитьСтрокуВМатрицеГрафа(Результат,Элемент.НачалоЭлемент);
			Если Не Строка = Неопределено Тогда
				Строка[Элемент.Имя] = 1;	
			КонецЕсли;	
			Строка = ПолучитьСтрокуВМатрицеГрафа(Результат,Элемент.КонецЭлемент);
			Если Не Строка = Неопределено Тогда
				Строка[Элемент.Имя] = -1;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Функция - Получает строку по имени в матрице графа
//
// Параметры:
//  Результат	 - ТаблицаЗначение 	 - Матрица графа
//  Вершина		 - ЭлементГрафической схемы	 - Элемент соединяемый линией
// 
// Возвращаемое значение:
//   -  Строка таблицы значений
//
Функция ПолучитьСтрокуВМатрицеГрафа(Результат,Вершина) 
	Если Не Вершина =  Неопределено Тогда
		СтрокаВершины = Результат.Найти(Вершина.Имя,"Наименование");
		Если СтрокаВершины =  Неопределено Тогда 
			СтрокаВершины =  Результат.Добавить();
			СтрокаВершины.Наименование 	= Вершина.Имя;
			СтрокаВершины.Тип			= ТипЗнч(Вершина);
		КонецЕсли;
		Возврат  СтрокаВершины;
	КонецЕсли;
КонецФункции	

// Рекурсивная процедура - Дополнить массив путей
//
// Параметры:
//  ГрафСхема	 				- Графическая схема	 - Графическая схема
//  СтрокаСтарта				- Строка таблицы значений - Строка с которой нужно начать перебор
//  мНаправленияВерхнегоУровня  - Массив - Массив структур верхнего уровня
//	мНаправления				- Массив - Возвращаемый параметр массив структур
//
Процедура ДополнитьМассивНаправления(ГрафСхема,СтрокаСтарта,мНаправленияВерхнегоУровня,мНаправления)
	мРебраИсходящие = ПолучитьКолонкиСоЗначением(СтрокаСтарта,1);
	Если мРебраИсходящие.Количество() Тогда 
		СтрНаправления = Новый Структура("Значение,Тип,Условие,Уточнение", Новый Массив); 
		мНаправления.Добавить(СтрНаправления);
		Для Каждого Ребро ИЗ  мРебраИсходящие Цикл //ПолучитьМассивРебер(ТЗ) Цикл
			//мВложенногоНаправления	= Новый Массив;
			//мВложенныхНаправлений.Добавить(мВложенногоНаправления);
			//это начало, теперь нужно найти в этой же колонке -1: это будет завершение 
			СтрокиЗавершения = СтрокаСтарта.Владелец().НайтиСтроки(Новый Структура(Ребро,-1));
			Для Каждого СтрокаЗавершения ИЗ СтрокиЗавершения  Цикл
				КлючУсловия			= ПолучитьКлючУсловия(ГрафСхема,СтрокаСтарта,Ребро); 	//Имя варианта или имя линии(для условия)
				Уточнение			= ПолучитьУточнение(ГрафСхема,Ребро); 					//Наименование линии приходящей в элемент
				СтрНаправленияВр  	= Новый Структура("Значение,Тип,Условие,Уточнение",СтрокаЗавершения.Наименование,СтрокаЗавершения.Тип,КлючУсловия,Уточнение);
				Если мРебраИсходящие.Количество() = 1 Тогда
					Если СтрокаЗавершения.Тип = Тип("ЭлементГрафическойСхемыСлияние") Тогда 	
						//тут переходим на уровень выше
						Если Не НайтиПоИмениВНаправлении(СтрНаправленияВр.Значение,мНаправленияВерхнегоУровня).Количество() Тогда
							мНаправленияВерхнегоУровня.Добавить(СтрНаправленияВр);
							ДополнитьМассивНаправления(ГрафСхема,СтрокаЗавершения,,мНаправленияВерхнегоУровня);
						КонецЕсли;	
					Иначе	
						ЗаполнитьЗначенияСвойств(СтрНаправления,СтрНаправленияВр);
						//переход к следующей обработке
						ДополнитьМассивНаправления(ГрафСхема,СтрокаЗавершения,мНаправленияВерхнегоУровня, мНаправления);
					КонецЕсли;
				Иначе
				    мВложенноеНаправление = Новый Массив;
					мВложенноеНаправление.Добавить(СтрНаправленияВр);
					//переход ниже на уровень по одному из исходящих ребер
					ДополнитьМассивНаправления(ГрафСхема,СтрокаЗавершения,мНаправления,мВложенноеНаправление);
					СтрНаправления.Значение.Добавить(мВложенноеНаправление);
					СтрНаправления.Тип	= СтрокаСтарта.Тип;
				КонецЕсли;	
				Прервать; //у ребра возможно только одно завершение !если нет зацикливания
			КонецЦикла;
		КонецЦикла;
		Если Не ЗначениеЗаполнено(СтрНаправления.Тип) Тогда 
			//удалим пустое значение поскольку строки могут не всегда заканчиваться блоком
			мНаправления.Удалить(мНаправления.ВГраница());
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

Функция НайтиПоИмениВНаправлении(Наименование,мНаправления)
	Результат = Новый Массив;
	Для Каждого Элемент ИЗ мНаправления Цикл
		Если ТипЗнч(Элемент.Значение) = Тип("Строка") И Элемент.Значение = Наименование Тогда
			Результат.Добавить(Элемент);		
		КонецЕсли;	
	КонецЦикла;	
	Возврат Результат;
КонецФункции	

// Функция - Получить ключ условия для данного направления используется в ПроцессыКлиент_Ei.ОпределитьКлючевоеУсловиеНаправления()
//
// Параметры:
//  ГрафСхема	 - Графическая схема	 	- Графическая схема
//  Строка		 - Строка таблицы значений 	- Строка в которой/из которой выходит линия 
//  Ребро		 - Строка	 				-  Имя линии направления
// 
// Возвращаемое значение:
//   - Строка: Имя линии или Имя Варианта
//
Функция ПолучитьКлючУсловия(ГрафСхема,Строка,Ребро)
	Результат = Ребро;
	Если Строка.Тип = Тип("ЭлементГрафическойСхемыВыборВарианта") Тогда
		//тут вместо имени линии нужно вернуть имя варианта начала линии
		Линия = ГрафСхема.ЭлементыГрафическойСхемы.Найти(Ребро);
		Если Не Линия =  Неопределено И Не Линия.НачалоВариант = Неопределено Тогда
			Результат = Линия.НачалоВариант.Наименование; 		
		КонецЕсли;
	ИначеЕсли Строка.Тип = Тип("ЭлементГрафическойСхемыСлияние") Тогда
		Результат = "";	
	КонецЕсли;	
	Возврат Результат;
КонецФункции

// Функция - Получить колонки со значением
//
// Параметры:
//  Строка	 - Строка таблицы значений	 -  Строка в колонках которой нужной найти значение
//  Значение - Произвольный	 - Искомое значение
// 
// Возвращаемое значение:
//   -  Массив, колонок таблицы значений
//
Функция ПолучитьКолонкиСоЗначением(Строка,Значение)
	Результат = Новый Массив;
	Для Каждого Ребро ИЗ ПолучитьМассивРебер(Строка.Владелец()) Цикл
		Если Строка[Ребро] =  Значение Тогда
			Результат.Добавить(Ребро);	
		КонецЕсли;	
	КонецЦикла;
	Возврат Результат;
КонецФункции	

// Функция - Получить уточнение соединительной линии
//
// Параметры:
//  ГрафСхема	 - Графическая схема	 - Графическая схема
//  Ребро		 - Колонка таблицы значений	 - Колонка
// 
// Возвращаемое значение:
//   - Строка
//
Функция ПолучитьУточнение(ГрафСхема,Ребро)
	ЛинияСоед = ГрафСхема.ЭлементыГрафическойСхемы.Найти(Ребро);
	Если Не ЛинияСоед = Неопределено И Не ПустаяСтрока(ЛинияСоед.Наименование) Тогда
		Возврат ЛинияСоед.Наименование;	
	КонецЕсли;	
КонецФункции	

// Функция - Получить массив ребер матрицы графа
//
// Параметры:
//  ТЗ	 - Таблица значений	 - Матрица графа 
// 
// Возвращаемое значение:
//   -  Массив, имен колонок
//
Функция ПолучитьМассивРебер(ТЗ)
	Результат 	= Новый Массив;
	ДопКолонки 	= ПолучитьВспомогательныеКолонки();
	Для Каждого Колонка ИЗ ТЗ.Колонки Цикл
		Если ДопКолонки.Найти(Колонка.Имя) = Неопределено Тогда
			Результат.Добавить(Колонка.Имя);			
		КонецЕсли;	
	КонецЦикла;
	Возврат Результат; 
КонецФункции

// Функция - Получает вспомогательные колонки, матрицы графа
// 
// Возвращаемое значение:
//   -  Массив
//
Функция ПолучитьВспомогательныеКолонки()
	Результат = Новый Массив;
	Результат.Добавить("Наименование");
	Результат.Добавить("Тип");
	Возврат Результат; 
КонецФункции	

// Функция - Получить строки начала
//
// Параметры:
//  ТЗ	 - Таблица значений	 - Матрица графа
// 
// Возвращаемое значение:
//   -  Массив строк таблицы значений
//
Функция ПолучитьСтрокиНачала(ТЗ)
	Результат = ТЗ.НайтиСтроки(Новый Структура("Тип",Тип("ЭлементГрафическойСхемыСтарт")));
	Возврат Результат;
КонецФункции	
	
#КонецОбласти

#Область ИсполнениеГрафСхемы

// Функция - Формирует структуру описани потока выполнения и запускает сам поток
//
// Параметры:
//  сзВызовов		 - СписокЗначений	 		- Последовательность подготовленных Дополнительных параметров ОписанийОповещений
//  Контекст		 - Структура		 		- Структура контекста выполнения 
//													Параметры
//													ЭтаФорма
//													Объект
// 
// Возвращаемое значение:
//   - ОписаниеЗначения
//
Функция ЗапуститьПоток(Ключ,сзВызовов,Контекст) Экспорт
	мПараметров = новый Массив;
	мПараметров.Добавить(Неопределено);
	мПараметров.Добавить(сзВызовов);
	РеальныйКонтекст = СтруктурыЗначенийВызовСервера_Ei.ПереопределеитьЗначенияКонтекста(Контекст);  
	мПараметров.Добавить(РеальныйКонтекст);
	ФЗ = ФоновыеЗадания.Выполнить("ПроцессыКлиентСервер_Ei.ВыполнитьПоток",мПараметров,Ключ,"Выполнение фонового потока по маршруту "+Ключ+"->");
	Возврат ФЗ.УникальныйИдентификатор;
КонецФункции

// Функция - Ожидать завершения потоков
//
// Параметры:
//  мИдентифкаторов	 - Масссив	 - Массив идентифкаторов запущенных фоновых заданий
//  Таймаут			 - Число	 - Период через который будум проверять актиность ФЗ
// 
// Возвращаемое значение:
//   - Структура со своствами:
//								- Завершено - Булево - Признак заверешния всех ФЗ из массива
//								- Сообщения - Массив - Накопленные сообщения пользователя
//
Функция ОжидатьЗавершенияПотоков(мИдентифкаторов,Таймаут = Неопределено) Экспорт
	//сформируем массив ФЗ
	мАктивныхФЗ = Новый Массив;
	мСообщений 	= Новый Массив;
	Результат 	= Новый Структура("Завершено,Сообщения",Истина,мСообщений);
	Для Каждого ИдентификаторФЗ из мИдентифкаторов Цикл
		ФЗ = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторФЗ);
		Если Не ФЗ = Неопределено Тогда
			Для Каждого СообщПольз  ИЗ ФЗ.ПолучитьСообщенияПользователю(Истина) Цикл
				мСообщений.Добавить(СообщПольз);		
			КонецЦикла;
			Если ФЗ.Состояние = СостояниеФоновогоЗадания.Активно Тогда 
				мАктивныхФЗ.Добавить(ФЗ);
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	Если мАктивныхФЗ.Количество() Тогда
		Для Каждого ФЗ ИЗ ФоновыеЗадания.ОжидатьЗавершенияВыполнения(мАктивныхФЗ,Таймаут) Цикл //только с платформы 8.3.13
			Для Каждого СообщПольз  ИЗ ФЗ.ПолучитьСообщенияПользователю(Истина) Цикл
				мСообщений.Добавить(СообщПольз);		
			КонецЦикла;		
			Если ФЗ.Состояние = СостояниеФоновогоЗадания.Активно Тогда
				Результат.Завершено = Ложь;	
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции	

Функция ВыполнитьОбработку(УказательВыполнения,ОписаниеПотока) Экспорт
	ОбработкаОбъект = Обработки[УказательВыполнения.ИмяОбработчика].Создать();
	ОбработкаОбъект.ВыполнитьОбработку(УказательВыполнения.ДополнительныеПараметры.Настройка,ОписаниеПотока,УказательВыполнения.ДополнительныеПараметры.ВозвращаемоеЗначение);
	ПроцессыКлиентСервер_Ei.ВыполнитьПереходКСледующейОбработке(ОписаниеПотока);
КонецФункции

#КонецОбласти


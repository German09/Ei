// Функция - Запускает фоновое задание
//
// Параметры:
//  КлючМаршрута	 - Строка					- Представление маршрута (имя соединительной линии)
//	сзВызовов		 - СписокЗначений	 		- Последовательность подготовленных Дополнительных параметров ОписанийОповещений
//  Контекст		 - Структура		 		- Структура контекста выполнения 
//													Параметры
//													ЭтаФорма
//													Объект
// 
// Возвращаемое значение:
//   - Структура со свойствами: 
//								Идентификатор 	- Идентифкатор запущенного фонового задания.
//								Ключ 			- Ключ фонового задания по кторому можно получить промежуточный результат через хранилище системных настроек	
//
Функция ЗапуститьПоток(КлючМаршрута,сзВызовов,Контекст) Экспорт
	Результат = Новый Структура("Ключ,Идентификатор",Строка(Новый УникальныйИдентификатор)); //Ключ статистики выполненя и сам идентифкатор задания
	//заполнение этих свойств происходит в ОжидатьЗавершенияПотоков()  
	Результат.Вставить("Активно", Истина);
	Результат.Вставить("ИнформацияОбОшибке");
	Результат.Вставить("Сообщения", Новый Массив);
	Результат.Вставить("ПромежуточныйРезультат", Новый Массив);
	Результат.Вставить("ИтоговыйРезультат", ПоместитьВоВременноеХранилище(Неопределено));//#1		
	//запускаем
	мПараметров = новый Массив;
	ОбъектОбработки = Новый Структура("Ключ,ВозврЗначение",Результат.Ключ, Результат.ИтоговыйРезультат); //формируем структуру для получения результата, как промежуточного (статистика выполнения) так и окончательного 
	мПараметров.Добавить(ОбъектОбработки);
	мПараметров.Добавить(сзВызовов);
	мПараметров.Добавить(СтруктурыЗначенийВызовСервера_Ei.ПереопределеитьЗначенияКонтекста(Контекст));
	мПараметров.Добавить(Неопределено); //ПредОбработка_ДопПараметры
	мПараметров.Добавить(Истина); //#1 признак фонового задания, для обновления адресов объектов и возвращаемых значений
	мПараметров.Добавить(НаборВариантовВызовСервера_Ei.Получить());
	мПараметров.Добавить(НаборВариантовВызовСервера_Ei.ПолучитьТекущийНабор());
	ФЗ = ФоновыеЗадания.Выполнить("ПроцессыКлиентСервер_Ei.ВыполнитьПоток",мПараметров,Результат.Ключ,"Выполнение фонового потока по маршруту "+КлючМаршрута+"->");
	Результат.Идентификатор = ФЗ.УникальныйИдентификатор;
	Возврат Результат;
КонецФункции

// Функция - Ожидает завершения потоков и заполянет своства Сообщения,ПромежуточныйРезультат,Активно,ИнформацияОбОшибке 
//
// Параметры:
//  мПотоков	 	- Масссив	 - Массив Структуры запуска потоков см. ЗапуститьПоток()  со свойствами:
//																				Идентификатор 		- Идентифкатор запущенного фонового задания.
//																				Ключ 				- Ключ фонового задания по кторому можно получить промежуточный результат через хранилище системных настроек
//																				ИтоговыйРезультат	- Адрес вынутреннего хранилиза в который должен быть помещен итоговый результат	
//
//  Таймаут			- Число	     - Период через который будум проверять актиность ФЗ
// 
// Возвращаемое значение:
//   - Структура со своствами:
//								- Завершено 	- Булево - Признак заверешния всех ФЗ из массива
//								- Сообщения 	- Массив - Накопленные сообщения пользователя
//								- мРезультатов	- Массив - Адреса результатов ФЗ
//
Функция ОжидатьЗавершенияПотоков(мПотоков,Таймаут = Неопределено) Экспорт	
	//сформируем массив ФЗ
	мАктивныхФЗ = Новый Массив;
	мСообщений 	= Новый Массив;
	Результат 	= Новый Структура("Завершено, мРезультатов",Истина, Новый Массив);
	
	//Соберем данные по всем существующим активным ФЗ 
	Для Каждого стрЗапускаПотока из мПотоков Цикл
		Если стрЗапускаПотока.Активно Тогда 
			ФЗ 				= ФоновыеЗадания.НайтиПоУникальномуИдентификатору(стрЗапускаПотока.Идентификатор);
			стрЗапускаПотока.Сообщения 				= Новый Массив;
			стрЗапускаПотока.ПромежуточныйРезультат = ХранилищеСистемныхНастроек.Загрузить(ПолучитьКлючОбъектаНастроек(),стрЗапускаПотока.Ключ);
			Если Не ФЗ = Неопределено Тогда
				Для Каждого СообщПольз  ИЗ ФЗ.ПолучитьСообщенияПользователю(Истина) Цикл
					стрЗапускаПотока.Сообщения.Добавить(СообщПольз);		
				КонецЦикла;
				Если ФЗ.Состояние = СостояниеФоновогоЗадания.Активно Тогда 
					мАктивныхФЗ.Добавить(ФЗ);
				Иначе
					стрЗапускаПотока.Активно = Ложь;
					стрЗапускаПотока.ИнформацияОбОшибке = ФЗ.ИнформацияОбОшибке;
					Результат.мРезультатов.Добавить(стрЗапускаПотока.ИтоговыйРезультат);
					//to-do почистить хранилищеСистемныхНастроек	 
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	//Соберем данные по активным ФЗ
	Если мАктивныхФЗ.Количество() Тогда
		Для Каждого ФЗ ИЗ ФоновыеЗадания.ОжидатьЗавершенияВыполнения(мАктивныхФЗ,Таймаут) Цикл //только с платформы 8.3.13
			//теперь найдем его в мПотомков и дополним свойства
			Для Каждого стрЗапускаПотока из мПотоков Цикл			
				Если ФЗ.УникальныйИдентификатор = стрЗапускаПотока.Идентификатор Тогда
					Для Каждого СообщПольз  ИЗ ФЗ.ПолучитьСообщенияПользователю(Истина) Цикл
						стрЗапускаПотока.Сообщения.Добавить(СообщПольз);		
					КонецЦикла;
					стрЗапускаПотока.ПромежуточныйРезультат = ХранилищеСистемныхНастроек.Загрузить(ПолучитьКлючОбъектаНастроек(),стрЗапускаПотока.Ключ);
					Если ФЗ.Состояние = СостояниеФоновогоЗадания.Активно Тогда
						Результат.Завершено = Ложь;
					Иначе
						стрЗапускаПотока.Активно = Ложь;
						Результат.мРезультатов.Добавить(стрЗапускаПотока.ИтоговыйРезультат);
						//to-do почистить хранилищеСистемныхНастроек	 
					КонецЕсли;	
					Прервать;
				КонецЕсли;					
			КонецЦикла;	
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПолучитьОписанниеМассиваРезульатовФЗ(МассивАдресов) Экспорт
	Результат = Новый Массив;
	Для Каждого Значение ИЗ МассивАдресов Цикл
		Если ЭтоАдресВременногоХранилища(Значение) Тогда
			Результат.Добавить(ПолучитьИзВременногоХранилища(Значение));		
		КонецЕсли;		
	КонецЦикла;	
	Возврат ОписаниеЗначенияВызовСервера_Ei.Подготовить(Результат,Новый УникальныйИдентификатор); 		
КонецФункции	 

// Функция - Получить ключ объекта настроек для сохранения времени выполнения
// 
// Возвращаемое значение:
//   - Строка
//
Функция ПолучитьКлючОбъектаНастроек() Экспорт
	Возврат "Ei."+ПеречисленияКлиентСерверПовторноеИспользование_Ei.ИмяФайлаСтатистики();	
КонецФункции	

// Функция - Выполнить обработку
//
// Параметры:
//  УказательВыполнения	 - 	 -                                                      
//  ОписаниеПотока		 - Структура - Структура формируемая функцией ЗапуститьПоток()
//                                                                    
// Возвращаемое значение:
//   - 
//
Функция ВыполнитьОбработку(УказательВыполнения,ОписаниеПотока) Экспорт
	Перем ИнфоОбОшибке;
	Попытка
		ОбработкаОбъект = Обработки[УказательВыполнения.ИмяОбработчика].Создать();
		ОбработкаОбъект.ОО_ВыполнитьОбработку(Новый Структура("ДополнительныеПараметры",ОписаниеПотока),УказательВыполнения.ДополнительныеПараметры);
	Исключение
		ИнфоОбОшибке	=  ИнформацияОбОшибке();
	КонецПопытки;	
	ПроцессыКлиентСервер_Ei.ВыполнитьПереходКСледующейОбработке(ОписаниеПотока,,ИнфоОбОшибке);
КонецФункции

// Процедура - Иерарахически дополняет показатели выполнения сохраняемые в настройках 
//
// Параметры:
//  КлючНастройки	 - Строка - Ключ запущенного фонового задания 
//  СтрДополнение	 - Структура - Стрктура которой нужно дополнить уже созданную или создаваемую структуру промежуточного результата "ПоказателиВыполненияПроцесса"
//
Процедура ДополнитьПоказательВыполненияСервер(КлючНастройки, СтрДополнение) Экспорт
	КлючОбъектаНастроек    = ПолучитьКлючОбъектаНастроек();
	ПромежуточныйРезультат = ХранилищеСистемныхНастроек.Загрузить(КлючОбъектаНастроек,КлючНастройки,);
	Если ПромежуточныйРезультат = Неопределено Тогда
		ПромежуточныйРезультат = Новый Структура("ПоказателиВыполненияПроцесса",Новый Структура());
	КонецЕсли;
	ОбщийМодульКлиентСервер_Ei.вСоединить(ПромежуточныйРезультат.ПоказателиВыполненияПроцесса,СтрДополнение);
	ХранилищеСистемныхНастроек.Сохранить(КлючОбъектаНастроек, КлючНастройки, ПромежуточныйРезультат);
КонецПроцедуры
		
#КонецОбласти

Функция ПолучитьОбъект(ВызовСервера = Ложь) Экспорт
	Перем ДанныеПроцесса;
	Перем ОписаниеЗначения;
	ДанныеНабора 	= НаборВариантовКлиентСервер_Ei.ПолучитьДанныеНабора();
	мОбъекты		= ПолучитьОбъекты();
	Если Не ДанныеНабора = Неопределено Тогда
		Данные = ДанныеНабора.Данные;
		Если Данные.Свойство(ВариантКлиентСервер_Ei_Процессы.Ключ(),ДанныеПроцесса) Тогда
			Если мОбъекты.Количество() Тогда
				ОписаниеЗначения = мОбъекты.Получить(мОбъекты.ВГраница()).Результат; //ИзначальныйОбъект всегда будет первый в списке если он указан
			КонецЕсли;	 	
		КонецЕсли;
	КонецЕсли;	
	Если ВызовСервера Тогда
		//Вызываем сервер с клиента
		Возврат ОписаниеЗначения;
	Иначе
		Возврат СтруктурыЗначенийВызовСервера_Ei.ПереопределитьЗначение(ОписаниеЗначения);		
	КонецЕсли;			
Конецфункции

Функция ПолучитьОбъекты() Экспорт	
	Возврат  ПараметрыСеанса.Объект_Процессы_Ei;
КонецФункции
	
Процедура УстановитьОбъекты(Значение) Экспорт
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		НовоеЗначение = Новый ФиксированныйМассив(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("ФиксированныйМассив") Тогда
		НовоеЗначение = Значение;	
	Иначе
		НовоеЗначение = Новый ФиксированныйМассив(Новый Массив);	
	КонецЕсли;
	ПараметрыСеанса.Объект_Процессы_Ei = НовоеЗначение;		
КонецПроцедуры

Функция ПолучитьРезультат(ИмяЭлемента) Экспорт
	Перем ОписаниеЗначения;
	Для Каждого СтрРезультата ИЗ ПолучитьОбъекты() Цикл
		Если нРег(СтрРезультата.Имя) = нРег(ИмяЭлемента) Тогда
			ОписаниеЗначения = СтрРезультата.Результат;
			Возврат СтруктурыЗначенийВызовСервера_Ei.ПереопределитьЗначение(ОписаниеЗначения);;
		КонецЕсли;		
	КонецЦикла;			
КонецФункции	


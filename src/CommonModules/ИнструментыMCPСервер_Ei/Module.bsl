Функция СхемаСозданияВариантов()
	
	Набор = Новый Структура;
	Набор.Вставить("name", СвойствоСхемы("string",
		"Имя строки набора - идентификатор встроенного языка (буквы, цифры, _). Если строка с таким именем уже есть в Ei, она обновится."));
	Для Каждого ОписаниеВарианта Из ВариантыНабора() Цикл
		ТипСвойства = ?(ОписаниеВарианта.Значение.ЭтоТаблица Или ОписаниеВарианта.Значение.ЭтоПроцесс, "object", "string");
		Набор.Вставить(ОписаниеВарианта.Ключ, СвойствоСхемы(ТипСвойства, ОписаниеВарианта.Значение.Описание));
	КонецЦикла;
	ИменаВариантов = СтрСоединить(ИменаВариантовНабора(), ", ");
	Набор.Вставить("parameters", СвойствоСхемы("object", "Параметры строки: &Имя запроса и Параметры(""Имя"") алгоритма. Форматы значений - в описании инструмента."));
	Набор.Вставить("active_variant", СвойствоСхемы("string",
		"Вариант, открытый в строке. По умолчанию - первый заполненный в порядке " + ИменаВариантов + ".", ,
		СтрСоединить(ИменаВариантовНабора(), ",")));
	Дети = СвойствоСхемы("array", "Вложенные строки: объекты того же вида, что элементы sets.");
	Дети.Вставить("items", Новый Структура("type", "object"));
	Набор.Вставить("children", Дети);
	
	ОписаниеНаборов = СвойствоСхемы("array", "Строки наборов: каждая - объект с name, вариантами (" + ИменаВариантов + "), parameters и children.");
	ОписаниеНаборов.Вставить("items", Новый Структура("type, properties", "object", Набор));
	
	Свойства = Новый Структура;
	Свойства.Вставить("sets", ОписаниеНаборов);
	Свойства.Вставить("description", СвойствоСхемы("string", "Одна короткая фраза (до 60 символов), что и зачем отлаживать: пояснение оповещения пользователю, имена строк уже в его заголовке."));
	
	Возврат СхемаПараметров(Свойства, "sets");
	
КонецФункции


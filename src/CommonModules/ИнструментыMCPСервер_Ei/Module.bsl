		+ " not_found - имена из names, которых нет среди строк; deleted_rows - сколько строк отправки нет в форме Ei.");
	Части.Добавить(СтрШаблон("Если клиент 1С не ответил за %1 с, возвращается status=pending и request_id - повторите вызов с теми же аргументами и request_id.",
		ЗапросыMCPСервер_Ei.ВремяОжиданияОтвета()));
	

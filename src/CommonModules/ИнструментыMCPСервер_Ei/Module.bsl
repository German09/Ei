// Инструменты execute_code и execute_query для MCP-сервера 1c_mcp: выполнение кода и запросов средствами Ei.
// MCP находит их по контейнеру см. Обработка.ИнструментыMCP_Ei
// и предпочитает собственным одноименным инструментам. Расширения не ссылаются друг на друга в коде:
// таблица инструментов и аргументы приходят от MCP, ответ уходит строкой JSON.
//
// Параметры MCP становятся временным набором Ei, см. ЗапросыMCPВызовСервера_Ei.НачатьНаборЗапроса
// Поэтому Параметры() в коде, параметры запроса, вычисляемые параметры и пакеты с временными таблицами
// работают так же, как в форме Ei, а запуски попадают в журнал выполнения и историю Ei.
// Опасный код и код для клиента уходят клиентскому агенту, см. ЗапросыMCPСервер_Ei

#Область ПрограммныйИнтерфейс

// Добавляет описания инструментов в таблицу инструментов MCP.
//
// Параметры:
//  Инструменты - ТаблицаЗначений - таблица MCP с колонками Имя, Описание, СхемаПараметров
//
Процедура ДобавитьИнструменты(Инструменты) Экспорт
	
	Если ВыполнениеДоступно(ИмяВыполненияКода()) Тогда
		ОпасныеРазрешены = ПроверкаКодаMCPСервер_Ei.ОпасныеОперацииРазрешены();
		ДобавитьИнструмент(Инструменты, ИмяВыполненияКода(), ОписаниеВыполненияКода(ОпасныеРазрешены), СхемаВыполненияКода());
	КонецЕсли;
	Если ВыполнениеДоступно(ИмяВыполненияЗапроса()) Тогда
		ДобавитьИнструмент(Инструменты, ИмяВыполненияЗапроса(), ОписаниеВыполненияЗапроса(), СхемаВыполненияЗапроса());
	КонецЕсли;
	
КонецПроцедуры

// Выполняет инструмент по имени.
//
// Параметры:
//  ИмяИнструмента - Строка
//  Аргументы - Структура - аргументы вызова, разобранные из JSON
//
// Возвращаемое значение:
//  Строка - ответ JSON
//
Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт
	
	Если Не ВыполнениеДоступно(ИмяИнструмента) Тогда
		ВызватьИсключение СтрШаблон("Инструмент %1 недоступен: нет права Использование на обработку %2 (роль %3)",
			ИмяИнструмента, ОбработкаДоступаMCP(ИмяИнструмента), ИмяРолиДоступа());
	КонецЕсли;
	
	АргументыВызова = ?(ТипЗнч(Аргументы) = Тип("Структура"), Аргументы, Новый Структура);
	Если ИмяИнструмента = ИмяВыполненияКода() Тогда
		Ответ = ВыполнитьКод(АргументыВызова);
	ИначеЕсли ИмяИнструмента = ИмяВыполненияЗапроса() Тогда
		Ответ = ВыполнитьЗапрос(АргументыВызова);
	Иначе
		ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
	КонецЕсли;
	
	Попытка
		ОтветJSON = ЗначениеВJSON(Ответ);
	Исключение
		// Например, соответствие с ключами не строками: JSON его не запишет, модель получит представление.
		Данные = Неопределено;
		Если Ответ.Свойство("data", Данные) Тогда
			Ответ.Вставить("data", Строка(Данные));
			Ответ.Вставить("data_serialization_error", ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецЕсли;
		ОтветJSON = ЗначениеВJSON(Ответ);
	КонецПопытки;
	
	Возврат ОтветJSON;
	
КонецФункции

// Обработчик ЗаписатьJSON: значения, которые JSON не умеет записать, превращает в данные для модели.
// Ссылка - в описание объекта, которое можно вернуть в parameters, таблица - в массив строк.
//
// Параметры:
//  Свойство - Строка
//  Значение - Произвольный
//  ДопПараметры - Произвольный
//  Отказ - Булево
//
// Возвращаемое значение:
//  Произвольный
//
Функция ПреобразованиеJSON(Свойство, Значение, ДопПараметры, Отказ) Экспорт
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ЭтоСсылка(Значение) Тогда
		Результат = ?(Значение.Пустая(), Неопределено, ОписаниеОбъектаПоСсылке(Значение));
	ИначеЕсли ТипЗначения = Тип("РезультатЗапроса") Тогда
		Результат = ТаблицаВМассив(Значение.Выгрузить());
	ИначеЕсли ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Результат = ТаблицаВМассив(Значение);
	ИначеЕсли ТипЗначения = Тип("ДеревоЗначений") Тогда
		Результат = СтрокиДереваВМассив(Значение.Строки, Значение.Колонки);
	ИначеЕсли ТипЗначения = Тип("СписокЗначений") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(Новый Структура("value, presentation", Элемент.Значение, Элемент.Представление));
		КонецЦикла;
	ИначеЕсли ТипЗначения = Тип("Тип") Тогда
		Результат = ПредставлениеТипа(Значение);
	ИначеЕсли ТипЗначения = Тип("ОписаниеТипов") Тогда
		Результат = ПредставлениеОписанияТипов(Значение);
	ИначеЕсли ТипЗначения = Тип("ДвоичныеДанные") Тогда
		Результат = СтрШаблон("<ДвоичныеДанные, %1 байт>", Формат(Значение.Размер(), "ЧН=0; ЧГ=0"));
	ИначеЕсли ТипЗначения = Тип("ХранилищеЗначения") Тогда
		Результат = "<ХранилищеЗначения>";
	Иначе
		Результат = Строка(Значение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОписаниеИнструментов

Процедура ДобавитьИнструмент(Инструменты, Имя, Описание, СхемаПараметров)
	
	НоваяСтрока = Инструменты.Добавить();
	НоваяСтрока.Имя = Имя;
	НоваяСтрока.Описание = Описание;
	НоваяСтрока.СхемаПараметров = ЗначениеВJSON(СхемаПараметров);
	
КонецПроцедуры

// Инструмент выполняет произвольный код, поэтому доступен тому же, кому одноименный инструмент MCP:
// с правом Использование на его обработку. Право дает роль MCP mcp_ВыполнениеКодаИЗапросов или полные права.
//
// Параметры:
//  ИмяИнструмента - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ВыполнениеДоступно(ИмяИнструмента)
	
	ОбработкаMCP = Метаданные.Обработки.Найти(ОбработкаДоступаMCP(ИмяИнструмента));
	Возврат ОбработкаMCP <> Неопределено И ПравоДоступа("Использование", ОбработкаMCP);
	
КонецФункции

// Обработка MCP с одноименным инструментом: права на нее определяют доступ к инструменту Ei.
//
// Параметры:
//  ИмяИнструмента - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ОбработкаДоступаMCP(ИмяИнструмента)
	
	Возврат ?(ИмяИнструмента = ИмяВыполненияКода(), "mcp_ИнструментВыполнениеКода", "mcp_ИнструментРаботаСЗапросами");
	
КонецФункции

Функция ОписаниеВыполненияКода(ОпасныеРазрешены)
	
	Части = Новый Массив; // Массив из Строка
	Части.Добавить("Выполняет код на встроенном языке 1С средствами Ei (EnterpriseIntegrator) на сервере или в клиенте 1С пользователя.");
	Части.Добавить("Режимы mode: statements (по умолчанию) - блок операторов через Выполнить: результат присвойте переменной Результат, нельзя объявлять Процедура/Функция и использовать Возврат;"
		+ " expression - одно выражение через Вычислить, результат - его значение, например Метаданные.Справочники.Количество();"
		+ " module - текст с процедурами и функциями: основной блок операторов вне процедур присваивает переменную Результат, или экспортная функция Результат() без параметров возвращает значение;"
		+ " module выполняется только на сервере, как внешняя обработка.");
	Части.Добавить("Параметры parameters доступны в коде через Параметры(""Имя""), в режиме module - через ВыполнитьКлиентСервер_Ei.Параметры(""Имя""); Параметры() без имени возвращает структуру всех параметров. "
		+ ОписаниеФорматаПараметров());
	Части.Добавить("Ответ: data - значение Результат (таблицы - массивом строк, ссылки - описаниями _objectRef), result_type, messages - тексты Сообщить(); таблица или массив в data обрезается до limit строк с truncated=true и total.");
	Части.Добавить("Запуски на сервере видны в журнале выполнения и истории Ei (набор MCP), запуски в клиенте - строками MCP_ набора в форме Ei.");
	
	Если ОпасныеРазрешены Тогда
		Части.Добавить("Режим базы: копия, разработка или эталон (в БСП включена блокировка работы с внешними ресурсами). Черный список опасных конструкций для server НЕ применяется - разрешены запись, удаление, файлы, COM и т.п.; в ответе dangerous_operations_allowed=true.");
	Иначе
		Части.Добавить("Режим базы: рабочая. Опасные конструкции в коде и в выражениях параметров выполняются только после подтверждения человеком в клиенте 1С; в ответе dangerous_operations_allowed=false.");
	КонецЕсли;
	Части.Добавить(ПроверкаКодаMCPСервер_Ei.ОписаниеОпасныхКонструкций(ОпасныеРазрешены));
	Если Не ОпасныеРазрешены Тогда
		Части.Добавить(ПроверкаКодаMCPСервер_Ei.ОписаниеВызововКонфигурации());
	КонецЕсли;
	
	СостояниеАгента = ЗапросыMCPСервер_Ei.СостояниеАгента();
	Если СостояниеАгента.Доступен Тогда
		Части.Добавить(СтрШаблон("Опасный server-код и client-код с опасными конструкциями показываются пользователю в Ei в форме подтверждения."
			+ " Разрешить - код выполняет пользователь (server - в своем сеансе на сервере) строкой MCP_ набора с параметрами, результат возвращается как обычно;"
			+ " Запретить, Отмена или истечение времени (по умолчанию - запрет) - отказ с rejection_kind forbidden, cancelled или timeout."
			+ " Безопасный client-код выполняется сразу. Если ответа нет за %1 с, возвращается status=pending_approval и request_id -"
			+ " повторите вызов с теми же code, mode, parameters, execution_context и request_id.", ЗапросыMCPСервер_Ei.ВремяОжиданияОтвета()));
	Иначе
		Части.Добавить("Клиентский агент недоступен (" + СостояниеАгента.Причина + "): execution_context=client и подтверждение опасного кода не работают.");
	КонецЕсли;
	
	Возврат СтрСоединить(Части, " ");
	
КонецФункции

Функция ОписаниеВыполненияЗапроса()
	
	Части = Новый Массив; // Массив из Строка
	Части.Добавить("ОСНОВНОЙ ИНСТРУМЕНТ для получения данных из 1С, выполняет запрос средствами Ei (EnterpriseIntegrator).");
	Части.Добавить("Выполняет запрос или пакет запросов, в том числе с временными таблицами (ПОМЕСТИТЬ / УНИЧТОЖИТЬ), и возвращает строки одного результата пакета:"
		+ " по умолчанию последнего запроса выборки, result_index (с 1) выбирает другой, в том числе содержимое временной таблицы."
		+ " batch - сводка по всем запросам пакета: номер, временная таблица, количество строк.");
	Части.Добавить("Ссылочные поля конвертируются в описания объектов {_objectRef, УникальныйИдентификатор, ТипОбъекта, Представление}, которые можно передавать в parameters следующих запросов и в get_nav_link.");
	Части.Добавить("Параметры &Имя - в parameters. " + ОписаниеФорматаПараметров()
		+ " Таблица в параметре подходит для ИЗ &Таблица и В (&Таблица), массив - для В (&Список). Выражения параметров с опасными конструкциями здесь запрещены - для них используйте execute_code.");
	Части.Добавить("Постраничная выборка: limit (по умолчанию 100, максимум 1000) и offset; total - всего строк результата, truncated - есть еще строки. columns - имена и типы колонок.");
	Части.Добавить("ИТЕРАТИВНЫЙ ПОДХОД: используй результаты одного запроса как параметры для следующего - так можно углубляться по связям объектов.");
	Части.Добавить("Запуски видны в журнале выполнения и истории Ei (набор MCP).");
	
	Возврат СтрСоединить(Части, " ");
	
КонецФункции

Функция ОписаниеФорматаПараметров()
	
	Возврат "Значения parameters: строка, число, булево, null;"
		+ " {""_date"": ""2024-01-31T00:00:00""} - дата;"
		+ " {""_objectRef"": true, ""УникальныйИдентификатор"": ""<uuid>"", ""ТипОбъекта"": ""СправочникСсылка.Номенклатура""} - ссылка (такие описания возвращают execute_query и execute_code; вместо uuid можно имя предопределенного элемента или значения перечисления);"
		+ " {""_type"": ""СправочникСсылка.Номенклатура""} - тип;"
		+ " {""_table"": {""columns"": [{""name"": ""Товар"", ""type"": ""СправочникСсылка.Номенклатура""}, {""name"": ""Количество"", ""type"": ""Число""}], ""rows"": [{""Товар"": ""<uuid>"", ""Количество"": 2}]}} - таблица значений:"
		+ " type колонки можно не указывать - он определится по значениям, строки - объекты или массивы в порядке колонок, ячейка ссылочной колонки - uuid или описание _objectRef;"
		+ " {""_expression"": ""код""} - вычисляемый параметр Ei: выражение (например Параметры(""А"") * 2) или блок операторов, присваивающий переменную Результат;"
		+ " в блоке завершайте каждый оператор точкой с запятой: однострочник Результат = Х без ; Ei вычислит как сравнение и получит Булево;"
		+ " вычисляется на сервере при обращении и может вернуть любое значение, например МенеджерВременныхТаблиц или таблицу из запроса;"
		+ " прочие массивы и объекты - Массив и Структура.";
	
КонецФункции

Функция СхемаВыполненияКода()
	
	Свойства = Новый Структура;
	Свойства.Вставить("code", СвойствоСхемы("string", "Код на встроенном языке 1С, см. mode."));
	Свойства.Вставить("mode", СвойствоСхемы("string",
		"statements (по умолчанию) - блок операторов, результат в переменной Результат; expression - выражение; module - процедуры и функции, только server.",
		"statements", "statements,expression,module"));
	Свойства.Вставить("execution_context", СвойствоСхемы("string",
		"server (по умолчанию) - на сервере; client - в клиенте 1С пользователя через Ei, только синхронный код.",
		"server", "server,client"));
	Свойства.Вставить("parameters", СвойствоСхемы("object", "Параметры кода, доступны через Параметры(""Имя""). Форматы значений - в описании инструмента."));
	Свойства.Вставить("limit", СвойствоСхемы("number", "Сколько строк таблицы или элементов массива вернуть в data (по умолчанию 100, максимум 1000).", ПределПоУмолчанию()));
	Свойства.Вставить("request_id", СвойствоСхемы("string",
		"Идентификатор запроса из ответа status=pending_approval. Передайте его вместе с теми же code, mode, parameters и execution_context, чтобы дождаться решения пользователя."));
	
	Возврат СхемаПараметров(Свойства, "code");
	
КонецФункции

Функция СхемаВыполненияЗапроса()
	
	Свойства = Новый Структура;
	Свойства.Вставить("queryText", СвойствоСхемы("string", "Текст запроса или пакета запросов на языке запросов 1С (ВЫБРАТЬ / SELECT)."));
	Свойства.Вставить("parameters", СвойствоСхемы("object", "Параметры запроса &Имя. Форматы значений - в описании инструмента."));
	Свойства.Вставить("limit", СвойствоСхемы("number", "Ограничение строк (по умолчанию 100, максимум 1000).", ПределПоУмолчанию()));
	Свойства.Вставить("offset", СвойствоСхемы("number", "Сколько строк результата пропустить (по умолчанию 0).", 0));
	Свойства.Вставить("result_index", СвойствоСхемы("number",
		"Номер запроса пакета (с 1), результат которого вернуть. По умолчанию - последний запрос выборки, не помещающий во временную таблицу."));
	
	Возврат СхемаПараметров(Свойства, "queryText");
	
КонецФункции

Функция СвойствоСхемы(ТипСвойства, Описание, ЗначениеПоУмолчанию = Неопределено, ДопустимыеЗначения = "")
	
	Свойство = Новый Структура;
	Свойство.Вставить("type", ТипСвойства);
	Свойство.Вставить("description", Описание);
	Если ЗначениеПоУмолчанию <> Неопределено Тогда
		Свойство.Вставить("default", ЗначениеПоУмолчанию);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДопустимыеЗначения) Тогда
		Свойство.Вставить("enum", СтрРазделить(ДопустимыеЗначения, ","));
	КонецЕсли;
	
	Возврат Свойство;
	
КонецФункции

Функция СхемаПараметров(Свойства, Обязательные)
	
	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", СтрРазделить(Обязательные, ","));
	
	Возврат Схема;
	
КонецФункции

#КонецОбласти

#Область ВыполнениеКода

Функция ВыполнитьКод(Аргументы)
	
	Ответ = Новый Структура("success", Ложь);
	
	Код = Строка(Аргумент(Аргументы, "code", ""));
	Контекст = НРег(Строка(Аргумент(Аргументы, "execution_context", "server")));
	ИмяРежима = НРег(Строка(Аргумент(Аргументы, "mode", "statements")));
	Режим = РежимПоИмени(ИмяРежима);
	ИдентификаторЗапроса = СокрЛП(Строка(Аргумент(Аргументы, "request_id", "")));
	Предел = ПределСтрок(Аргумент(Аргументы, "limit"));
	ПараметрыJSON = Аргумент(Аргументы, "parameters");
	
	ОшибкаПараметров = "";
	ПараметрыНабора = ПараметрыНабораИзJSON(ПараметрыJSON, ОшибкаПараметров);
	
	Если Не ЗначениеЗаполнено(СокрЛП(Код)) Тогда
		Ответ.Вставить("error", "Параметр code обязателен и не может быть пустым");
	ИначеЕсли Контекст <> "server" И Контекст <> "client" Тогда
		Ответ.Вставить("error", "Недопустимый execution_context: " + Контекст + ". Допустимо: server, client");
	ИначеЕсли Режим = Неопределено Тогда
		Ответ.Вставить("error", "Недопустимый mode: " + ИмяРежима + ". Допустимо: statements, expression, module");
	ИначеЕсли Режим = ВыполнитьКлиентСервер_Ei.РежимыВыражения().Модуль И Контекст = "client" Тогда
		Ответ.Вставить("error", "mode=module выполняется только на сервере: используйте execution_context=server");
	ИначеЕсли ЗначениеЗаполнено(ОшибкаПараметров) Тогда
		Ответ.Вставить("error", "Ошибка в parameters: " + ОшибкаПараметров);
	Иначе
		
		ОпасныеРазрешены = ПроверкаКодаMCPСервер_Ei.ОпасныеОперацииРазрешены();
		Ответ.Вставить("dangerous_operations_allowed", ОпасныеРазрешены);
		Ответ.Вставить("execution_context", Контекст);
		Ответ.Вставить("mode", ИмяРежима);
		
		ТекстПроверки = ТекстДляПроверки(Код, ПараметрыНабора);
		Запрещенные = Новый Массив; // Массив из Строка
		Если Не ОпасныеРазрешены Тогда
			Запрещенные = ПроверкаКодаMCPСервер_Ei.ЗапрещенныеКлючевыеСлова(ТекстПроверки);
		КонецЕсли;
		
		// Клиентский код выполняется на компьютере пользователя: его проверяем и в копии базы.
		НайденныеОпасные = Новый Массив; // Массив из Строка
		Если Контекст = "client" Или Не ОпасныеРазрешены Тогда
			НайденныеОпасные = ПроверкаКодаMCPСервер_Ei.ОпасныеКлючевыеСлова(ТекстПроверки, Контекст);
		КонецЕсли;
		
		Если Запрещенные.Количество() > 0 Тогда
			Ответ.Вставить("error",
				"Операция запрещена в рабочей базе даже с подтверждением: код обращается к хранилищам настроек, параметрам сеанса, уведомлениям клиента или клиентскому агенту: "
					+ СтрСоединить(Запрещенные, ", "));
			Ответ.Вставить("dangerous_keywords", Запрещенные);
		ИначеЕсли Контекст = "server" И НайденныеОпасные.Количество() = 0 Тогда
			ВыполнитьНаСервере(Код, Режим, ПараметрыНабора, Предел, Ответ);
		Иначе
			Описание = Новый Структура;
			Описание.Вставить("Код", Код);
			Описание.Вставить("Контекст", Контекст);
			Описание.Вставить("Режим", Режим);
			Описание.Вставить("Параметры", ПараметрыНабора);
			Описание.Вставить("ОпасныеКонструкции", НайденныеОпасные);
			// Повторный вызов с request_id должен прислать те же код, режим и параметры
			ЧастиХеша = Новый Массив; // Массив из Строка
			ЧастиХеша.Добавить(Код);
			ЧастиХеша.Добавить(Режим);
			ЧастиХеша.Добавить(ЗначениеВJSON(ПараметрыJSON));
			Описание.Вставить("Хеш", ЗапросыMCPСервер_Ei.Хеш(СтрСоединить(ЧастиХеша, Символы.ПС)));
			ВыполнитьЧерезАгента(Описание, ИдентификаторЗапроса, Предел, Ответ);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Выполняет безопасный код в HTTP-сеансе MCP: с параметрами во временном наборе,
// замером в журнале выполнения и запуском в истории Ei.
Процедура ВыполнитьНаСервере(Код, Режим, ПараметрыНабора, Предел, Ответ)
	
	ИмяВарианта = ВариантАлгоритмКлиентСервер_Ei.Свойства().Имя;
	Выполнение = НачатьВыполнение(ИмяВарианта, Код, ПараметрыНабора, "MCP: execute_code на сервере");
	ОписаниеЗначения = Неопределено;
	ИнформацияОбОшибке = Неопределено;
	
	Попытка
		ОписаниеЗначения = ВыполнитьКлиентСервер_Ei.ВыражениеВМесте(Код, Новый УникальныйИдентификатор,
			ВыполнитьКлиентСервер_Ei.МестаВыполнения().Сервер, Режим);
		Значение = ИсторияВызовСервера_Ei.ЗначениеРезультата(ОписаниеЗначения);
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("result_type", Строка(ТипЗнч(Значение)));
		Ответ.Вставить("data", ОграничитьДанные(Значение, Предел, Ответ));
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Ответ.Вставить("error", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	КонецПопытки;
	
	ЗавершитьВыполнение(Выполнение, ОписаниеЗначения, ИнформацияОбОшибке, Ответ);
	
КонецПроцедуры

// Запрашивает у человека подтверждение серверного кода или выполнение клиентского
// и заполняет ответ по решению агента.
//
// Параметры:
//  Описание - см. ЗапросыMCPСервер_Ei.ЗапроситьРешение
//  ИдентификаторЗапроса - Строка
//  Предел - Число
//  Ответ - Структура - дополняется полями ответа
//
Процедура ВыполнитьЧерезАгента(Описание, ИдентификаторЗапроса, Предел, Ответ)
	
	Если Описание.ОпасныеКонструкции.Количество() > 0 Тогда
		Ответ.Вставить("dangerous_keywords", Описание.ОпасныеКонструкции);
	КонецЕсли;
	
	СостояниеАгента = ЗапросыMCPСервер_Ei.СостояниеАгента();
	Если Не СостояниеАгента.Доступен Тогда
		Если Описание.Контекст = "client" Тогда
			Ответ.Вставить("error", "execution_context=client недоступен: " + СостояниеАгента.Причина + ". Используйте execution_context=server.");
		Иначе
			Ответ.Вставить("error", "Операция запрещена: код содержит опасные конструкции: " + СтрСоединить(Описание.ОпасныеКонструкции, ", ")
				+ ". Подтверждение человеком недоступно: " + СостояниеАгента.Причина);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Попытка
		Решение = ЗапросыMCPСервер_Ei.ЗапроситьРешение(Описание, ИдентификаторЗапроса);
	Исключение
		Ответ.Вставить("error", "Ошибка обмена с клиентским агентом Ei: "
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Если Решение.Статус = "error" Тогда
		Ответ.Вставить("error", Решение.Ошибка);
	ИначеЕсли Решение.Статус = "pending" Тогда
		Ответ.Вставить("status", "pending_approval");
		Ответ.Вставить("request_id", Решение.Идентификатор);
		Ответ.Вставить("message",
			"Ожидается решение пользователя в клиенте 1С. Повторите execute_code с теми же code, mode, parameters, execution_context и request_id="
				+ Решение.Идентификатор + ", чтобы дождаться ответа.");
	Иначе
		РешениеАгента = Решение.Ответ;
		Ответ.Вставить("request_id", Решение.Идентификатор);
		Ответ.Вставить("user_decision", РешениеАгента.Решение);
		Если РешениеАгента.Решение = "Отклонено" Тогда
			ЗаполнитьОтказ(РешениеАгента, Ответ);
		Иначе
			ЗаполнитьРезультатАгента(РешениеАгента, Предел, Ответ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Отказ пользователя: rejection_kind различает явный запрет,
// отмену (пользователь не уверен) и отказ по истечении времени формы подтверждения.
Процедура ЗаполнитьОтказ(РешениеАгента, Ответ)
	
	ВидОтказа = "";
	РешениеАгента.Свойство("ВидОтказа", ВидОтказа);
	
	Если ВидОтказа = "Запрещено" Тогда
		Ответ.Вставить("rejection_kind", "forbidden");
		Ответ.Вставить("error", "Пользователь запретил выполнение кода");
	ИначеЕсли ВидОтказа = "Таймаут" Тогда
		Ответ.Вставить("rejection_kind", "timeout");
		Ответ.Вставить("error", "Пользователь не ответил за отведенное время, выполнение запрещено по умолчанию");
	Иначе
		Ответ.Вставить("rejection_kind", "cancelled");
		Ответ.Вставить("error", "Пользователь отменил подтверждение: не уверен, что код нужно выполнять");
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРезультатАгента(РешениеАгента, Предел, Ответ)
	
	Успех = ТипЗнч(РешениеАгента.Успех) = Тип("Булево") И РешениеАгента.Успех;
	Ответ.Вставить("success", Успех);
	
	Если Успех Тогда
		Ответ.Вставить("result_type", РешениеАгента.ТипРезультата);
		Ответ.Вставить("data", ОграничитьДанные(РешениеАгента.Результат, Предел, Ответ));
	Иначе
		Ответ.Вставить("error", РешениеАгента.Ошибка);
	КонецЕсли;
	
	Если ТипЗнч(РешениеАгента.КодИзменен) = Тип("Булево") И РешениеАгента.КодИзменен Тогда
		Ответ.Вставить("code_modified", Истина);
		Ответ.Вставить("executed_code", РешениеАгента.Код);
	КонецЕсли;
	
КонецПроцедуры

// Код вместе с выражениями параметров: выражения выполняются так же, как код, и проверяются вместе с ним.
Функция ТекстДляПроверки(Код, ПараметрыНабора)
	
	Тексты = Новый Массив; // Массив из Строка
	Тексты.Добавить(Код);
	Для Каждого Выражение Из ВыраженияПараметров(ПараметрыНабора) Цикл
		Тексты.Добавить(Выражение);
	КонецЦикла;
	
	Возврат СтрСоединить(Тексты, Символы.ПС);
	
КонецФункции

Функция РежимПоИмени(ИмяРежима)
	
	Режимы = ВыполнитьКлиентСервер_Ei.РежимыВыражения();
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("statements", Режимы.Выполнить);
	Соответствие.Вставить("expression", Режимы.Вычислить);
	Соответствие.Вставить("module", Режимы.Модуль);
	
	Возврат Соответствие.Получить(ИмяРежима);
	
КонецФункции

// Таблица или массив в результате обрезаются до предела: модели нужны первые строки и общее количество.
//
// Параметры:
//  Значение - Произвольный
//  Предел - Число
//  Ответ - Структура - дополняется полями truncated и total
//
// Возвращаемое значение:
//  Произвольный
//
Функция ОграничитьДанные(Знач Значение, Предел, Ответ)
	
	Если ТипЗнч(Значение) = Тип("РезультатЗапроса") Тогда
		Значение = Значение.Выгрузить();
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") Или ТипЗнч(Значение) = Тип("Массив") Тогда
		Всего = Значение.Количество();
		Ответ.Вставить("total", Всего);
		Ответ.Вставить("truncated", Всего > Предел);
		Если Всего > Предел Тогда
			Первые = Новый Массив;
			Для Каждого Элемент Из Значение Цикл
				Если Первые.Количество() = Предел Тогда
					Прервать;
				КонецЕсли;
				Первые.Добавить(Элемент);
			КонецЦикла;
			Значение = ?(ТипЗнч(Значение) = Тип("Массив"), Первые, Значение.Скопировать(Первые));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

#КонецОбласти

#Область ВыполнениеЗапроса

Функция ВыполнитьЗапрос(Аргументы)
	
	Ответ = Новый Структура("success", Ложь);
	
	ТекстЗапроса = Строка(Аргумент(Аргументы, "queryText", ""));
	Предел = ПределСтрок(Аргумент(Аргументы, "limit"));
	Смещение = Макс(0, Цел(ЧислоАргумента(Аргумент(Аргументы, "offset"), 0)));
	НомерРезультата = Цел(ЧислоАргумента(Аргумент(Аргументы, "result_index"), 0));
	
	ОшибкаПараметров = "";
	ПараметрыНабора = ПараметрыНабораИзJSON(Аргумент(Аргументы, "parameters"), ОшибкаПараметров);
	
	Если Не ЗначениеЗаполнено(СокрЛП(ТекстЗапроса)) Тогда
		Ответ.Вставить("message", "Параметр queryText обязателен и не может быть пустым");
	ИначеЕсли ЗначениеЗаполнено(ОшибкаПараметров) Тогда
		Ответ.Вставить("message", "Ошибка в parameters: " + ОшибкаПараметров);
	Иначе
		
		ОпасныеВыражения = Новый Массив; // Массив из Строка
		Если Не ПроверкаКодаMCPСервер_Ei.ОпасныеОперацииРазрешены() Тогда
			ОпасныеВыражения = ПроверкаКодаMCPСервер_Ei.ОпасныеКонструкции(
				СтрСоединить(ВыраженияПараметров(ПараметрыНабора), Символы.ПС), "server");
		КонецЕсли;
		
		Если ОпасныеВыражения.Количество() > 0 Тогда
			Ответ.Вставить("message", "Выражения параметров содержат опасные конструкции: " + СтрСоединить(ОпасныеВыражения, ", ")
				+ ". Вычислите такие значения в execute_code с подтверждением пользователя.");
			Ответ.Вставить("dangerous_keywords", ОпасныеВыражения);
		Иначе
			ВыполнитьЗапросНаСервере(ТекстЗапроса, ПараметрыНабора, Предел, Смещение, НомерРезультата, Ответ);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Выполняет пакет запросов, как вариант Запрос строки набора Ei: параметры из временного набора,
// менеджер временных таблиц, результаты всех запросов пакета.
//@skip-check method-too-many-params
Процедура ВыполнитьЗапросНаСервере(ТекстЗапроса, ПараметрыНабора, Предел, Смещение, НомерРезультата, Ответ)
	
	ИмяВарианта = ВариантЗапросКлиентСервер_Ei.Свойства().Имя;
	Выполнение = НачатьВыполнение(ИмяВарианта, ТекстЗапроса, ПараметрыНабора, "MCP: execute_query");
	ОписаниеЗначения = Неопределено;
	ИнформацияОбОшибке = Неопределено;
	
	Попытка
		ОписаниеЗначения = ВыполнитьКлиентСервер_Ei.Запрос(ТекстЗапроса, Новый УникальныйИдентификатор);
		ЗаполнитьОтветЗапроса(Ответ, ИсторияВызовСервера_Ei.ЗначениеРезультата(ОписаниеЗначения), ТекстЗапроса,
			Предел, Смещение, НомерРезультата);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("message", ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке) + Символы.ПС + Символы.ПС
			+ "HINT: При ошибке запроса проверьте:" + Символы.ПС
			+ "1) Структуру объектов метаданных через get_metadata_structure (имена таблиц, полей, табличных частей)" + Символы.ПС
			+ "2) Формат parameters: ссылки - {_objectRef, УникальныйИдентификатор, ТипОбъекта}, даты - {_date}, таблицы - {_table}" + Символы.ПС
			+ "3) Если используете навигационные ссылки - сначала преобразуйте их через parse_nav_link");
	КонецПопытки;
	
	ЗавершитьВыполнение(Выполнение, ОписаниеЗначения, ИнформацияОбОшибке, Ответ);
	
КонецПроцедуры

//@skip-check method-too-many-params
Процедура ЗаполнитьОтветЗапроса(Ответ, Значение, ТекстЗапроса, Предел, Смещение, НомерРезультата)
	
	Результаты = Новый Массив;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результаты = Значение;
	Иначе
		Результаты.Добавить(Значение);
	КонецЕсли;
	
	ЗапросыПакета = ЗапросыПакета(ТекстЗапроса);
	Сводка = Новый Массив; // Массив из Структура
	ПоследняяВыборка = 0;
	
	Для Индекс = 0 По Результаты.ВГраница() Цикл
		ЭлементСводки = Новый Структура("index", Индекс + 1);
		ЗапросПакета = ?(Индекс <= ЗапросыПакета.ВГраница(), ЗапросыПакета[Индекс], Новый Структура("Помещение, Уничтожение", "", ""));
		Если ЗначениеЗаполнено(ЗапросПакета.Помещение) Тогда
			ЭлементСводки.Вставить("temp_table", ЗапросПакета.Помещение);
		ИначеЕсли ЗначениеЗаполнено(ЗапросПакета.Уничтожение) Тогда
			ЭлементСводки.Вставить("dropped_table", ЗапросПакета.Уничтожение);
		КонецЕсли;
		Результат = Результаты[Индекс];
		Если ТипЗнч(Результат) = Тип("РезультатЗапроса") Тогда
			ЭлементСводки.Вставить("rows", Результат.Выбрать().Количество());
			Если Не ЗначениеЗаполнено(ЗапросПакета.Помещение) Тогда
				ПоследняяВыборка = Индекс + 1;
			КонецЕсли;
		КонецЕсли;
		Сводка.Добавить(ЭлементСводки);
	КонецЦикла;
	
	Номер = ?(НомерРезультата > 0, НомерРезультата, ?(ПоследняяВыборка > 0, ПоследняяВыборка, Результаты.Количество()));
	Ответ.Вставить("results_count", Результаты.Количество());
	Ответ.Вставить("result_index", Номер);
	Если Результаты.Количество() > 1 Тогда
		Ответ.Вставить("batch", Сводка);
	КонецЕсли;
	
	Если Номер < 1 Или Номер > Результаты.Количество() Тогда
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("message", СтрШаблон("В пакете %1 запросов, result_index=%2 вне диапазона", Результаты.Количество(), Номер));
	ИначеЕсли ТипЗнч(Результаты[Номер - 1]) <> Тип("РезультатЗапроса") Тогда
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("message", СтрШаблон("Запрос %1 пакета не возвращает строк (уничтожение временной таблицы)", Номер));
		Ответ.Вставить("columns", Новый Массив);
		Ответ.Вставить("rows", Новый Массив);
	Иначе
		ЗаполнитьСтрокиРезультата(Ответ, Результаты[Номер - 1], Предел, Смещение);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСтрокиРезультата(Ответ, РезультатЗапроса, Предел, Смещение)
	
	Колонки = Новый Массив; // Массив из Структура
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Колонки.Добавить(Новый Структура("name, type", Колонка.Имя, ПредставлениеОписанияТипов(Колонка.ТипЗначения)));
	КонецЦикла;
	
	Выборка = РезультатЗапроса.Выбрать();
	Всего = Выборка.Количество();
	Строки = Новый Массив; // Массив из Структура
	Номер = 0;
	Пока Выборка.Следующий() Цикл
		Номер = Номер + 1;
		Если Номер <= Смещение Тогда
			Продолжить;
		КонецЕсли;
		Если Строки.Количество() = Предел Тогда
			Прервать;
		КонецЕсли;
		СтрокаРезультата = Новый Структура;
		Для Каждого Колонка Из Колонки Цикл
			СтрокаРезультата.Вставить(Колонка.name, Выборка[Колонка.name]);
		КонецЦикла;
		Строки.Добавить(СтрокаРезультата);
	КонецЦикла;
	
	Усечено = Смещение + Строки.Количество() < Всего;
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("message", ?(Усечено, СтрШаблон("Возвращено %1 строк из %2: остальные - через offset", Строки.Количество(), Всего),
		"Запрос выполнен успешно"));
	Ответ.Вставить("total", Всего);
	Ответ.Вставить("offset", Смещение);
	Ответ.Вставить("limit", Предел);
	Ответ.Вставить("truncated", Усечено);
	Ответ.Вставить("columns", Колонки);
	Ответ.Вставить("rows", Строки);
	
КонецПроцедуры

// Временные таблицы, которые запросы пакета помещают и уничтожают.
//
// Параметры:
//  ТекстЗапроса - Строка
//
// Возвращаемое значение:
//  Массив из Структура - по запросам пакета, пустой, если текст не разобран:
//   * Помещение - Строка - имя временной таблицы ПОМЕСТИТЬ
//   * Уничтожение - Строка - имя уничтожаемой временной таблицы
//
Функция ЗапросыПакета(ТекстЗапроса)
	
	Запросы = Новый Массив; // Массив из Структура
	Попытка
		Схема = Новый СхемаЗапроса;
		Схема.УстановитьТекстЗапроса(ТекстЗапроса);
		Для Каждого ЗапросСхемы Из Схема.ПакетЗапросов Цикл
			ЗапросПакета = Новый Структура("Помещение, Уничтожение", "", "");
			Если ТипЗнч(ЗапросСхемы) = Тип("ЗапросВыбораСхемыЗапроса") Тогда
				ЗапросПакета.Помещение = ЗапросСхемы.ТаблицаДляПомещения;
			Иначе
				ЗапросПакета.Уничтожение = ЗапросСхемы.ИмяТаблицы;
			КонецЕсли;
			Запросы.Добавить(ЗапросПакета);
		КонецЦикла;
	Исключение
		// Текст уже выполнился, разбор нужен только для сводки по пакету.
		Запросы = Новый Массив;
	КонецПопытки;
	
	Возврат Запросы;
	
КонецФункции

#КонецОбласти

#Область ЖурналИИстория

// Начинает выполнение инструмента: временный набор с параметрами, корневой замер журнала выполнения
// и запуск в истории Ei с тем же идентификатором.
//
// Параметры:
//  ИмяВарианта - Строка - Алгоритм или Запрос
//  Инструкция - Строка - код или текст запроса
//  ПараметрыНабора - Структура
//  Операция - Строка - заголовок замера
//
// Возвращаемое значение:
//  Структура:
//   * Запуск - см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//   * Замер - см. ЖурналКлиентСервер_Ei.НачатьЗамер
//   * Набор - см. ЗапросыMCPВызовСервера_Ei.НачатьНаборЗапроса
//
Функция НачатьВыполнение(ИмяВарианта, Инструкция, ПараметрыНабора, Операция)
	
	ПолучитьСообщенияПользователю(Истина);
	
	КлючНабора = ЗапросыMCPВызовСервера_Ei.КлючНабораЗапроса();
	ИдЗапуска = Строка(Новый УникальныйИдентификатор);
	Запуск = ИсторияКлиентСервер_Ei.НовыйЗапуск(ИдЗапуска, ИсторияКлиентСервер_Ei.КлючВарианта(КлючНабора, ИмяВарианта),
		ИмяВарианта, Инструкция);
	Запуск.Параметры = ИменаПараметров(ПараметрыНабора);
	
	Замер = ЖурналКлиентСервер_Ei.НачатьЗамер(Операция + Символы.ПС + Инструкция,
		ЖурналКлиентСервер_Ei.ТипыОпераций().Конструктор, , Ложь, ИдЗапуска, "");
	Замер.Контекст = Новый Структура("КлючСтроки, Вариант, Запуск", Строка(КлючНабора), ИмяВарианта, ИдЗапуска);
	
	Инструкции = Новый Структура;
	Инструкции.Вставить(ИмяВарианта, Инструкция);
	Набор = ЗапросыMCPВызовСервера_Ei.НачатьНаборЗапроса(ПараметрыНабора, Инструкции);
	// Параметры, вычисленные при выполнении, попадают в историю внутри этого запуска
	НаборВариантовВызовСервера_Ei.Обновить(НаборВариантовВызовСервера_Ei.Получить(), ИдЗапуска);
	
	Возврат Новый Структура("Запуск, Замер, Набор", Запуск, Замер, Набор);
	
КонецФункции

// Завершает замер и запуск, возвращает набор, дополняет ответ сообщениями и идентификатором запуска.
// Ошибки журнала и истории не должны испортить ответ модели.
//
// Параметры:
//  Выполнение - см. НачатьВыполнение
//  ОписаниеЗначения - Произвольный
//  ИнформацияОбОшибке - ИнформацияОбОшибке, Неопределено
//  Ответ - Структура
//
Процедура ЗавершитьВыполнение(Выполнение, ОписаниеЗначения, ИнформацияОбОшибке, Ответ)
	
	Запуск = Выполнение.Запуск;
	Запуск.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Запуск.Начало;
	Если ИнформацияОбОшибке <> Неопределено Тогда
		Запуск.Статус = ИсторияКлиентСервер_Ei.СтатусыЗапуска().Ошибка;
		Запуск.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	КонецЕсли;
	
	Попытка
		ЖурналКлиентСервер_Ei.ЗавершитьЗамер(Выполнение.Замер, , ?(ИнформацияОбОшибке = Неопределено, "", ИнформацияОбОшибке));
		ИсторияВызовСервера_Ei.ЗавершитьЗапускВарианта(Запуск, ОписаниеЗначения);
	Исключение
		ЗаписьЖурналаРегистрации(ЖурналКлиентСервер_Ei.ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			"MCP: запуск не записан в журнал или историю Ei" + Символы.ПС
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	ЗапросыMCPВызовСервера_Ei.ЗавершитьНаборЗапроса(Выполнение.Набор);
	
	Сообщения = Новый Массив; // Массив из Строка
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Сообщения.Добавить(Сообщение.Текст);
	КонецЦикла;
	Если Сообщения.Количество() > 0 Тогда
		Ответ.Вставить("messages", Сообщения);
	КонецЕсли;
	Ответ.Вставить("run_id", Запуск.Ид);
	
КонецПроцедуры

#КонецОбласти

#Область Параметры

// Превращает parameters из JSON в параметры временного набора Ei.
// Сложные значения хранятся XML-строкой: снимок наборов лежит в параметре сеанса,
// а Ei восстанавливает такие значения при вычислении, см. ОбщегоНазначенияКлиентСервер_Ei.ПопыткаСтруктурировать
//
// Параметры:
//  ПараметрыJSON - Структура, Строка, Неопределено - объект или его JSON строкой: так его передают некоторые клиенты
//  Ошибка - Строка - заполняется, если параметры не разобраны
//
// Возвращаемое значение:
//  Структура - см. ЗапросыMCPВызовСервера_Ei.НачатьНаборЗапроса
//
Функция ПараметрыНабораИзJSON(Знач ПараметрыJSON, Ошибка)
	
	ПараметрыНабора = Новый Структура;
	
	Если ТипЗнч(ПараметрыJSON) = Тип("Строка") И ЗначениеЗаполнено(СокрЛП(ПараметрыJSON)) Тогда
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ПараметрыJSON);
		Попытка
			ПараметрыJSON = ПрочитатьJSON(ЧтениеJSON);
		Исключение
			Ошибка = "строка parameters - не JSON-объект с именами-идентификаторами: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		ЧтениеJSON.Закрыть();
	ИначеЕсли ТипЗнч(ПараметрыJSON) = Тип("Строка") Тогда
		ПараметрыJSON = Неопределено;
	КонецЕсли;
	
	Разбирать = Не ЗначениеЗаполнено(Ошибка) И ПараметрыJSON <> Неопределено;
	Если Разбирать И ТипЗнч(ПараметрыJSON) <> Тип("Структура") Тогда
		Ошибка = "ожидается объект {имя: значение}, получено: " + Строка(ТипЗнч(ПараметрыJSON));
	ИначеЕсли Разбирать Тогда
		Для Каждого ЭлементПараметра Из ПараметрыJSON Цикл
			Попытка
				ПараметрыНабора.Вставить(ЭлементПараметра.Ключ, ПараметрНабора(ЭлементПараметра.Значение));
			Исключение
				Ошибка = СтрШаблон("%1: %2", ЭлементПараметра.Ключ, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Прервать;
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ПараметрыНабора;
	
КонецФункции

Функция ПараметрНабора(ЗначениеJSON)
	
	Выражение = Неопределено;
	Если ТипЗнч(ЗначениеJSON) = Тип("Структура") И ЗначениеJSON.Свойство("_expression", Выражение) Тогда
		Параметр = Новый Структура("ЭтоВыражение, ЗначениеПараметра", Истина, Строка(Выражение));
	Иначе
		Значение = ЗначениеИзJSON(ЗначениеJSON);
		Если Не ЭтоПростоеЗначение(Значение) Тогда
			Значение = ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(Значение);
		КонецЕсли;
		Параметр = Новый Структура("ЭтоВыражение, ЗначениеПараметра", Ложь, Значение);
	КонецЕсли;
	
	Возврат Параметр;
	
КонецФункции

// Значение, которое можно хранить в снимке наборов и в форме Ei как есть.
Функция ЭтоПростоеЗначение(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Возврат Значение = Неопределено Или Значение = Null
		Или ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Или ТипЗначения = Тип("Дата")
		Или ЭтоСсылка(Значение);
	
КонецФункции

Функция ВыраженияПараметров(ПараметрыНабора)
	
	Выражения = Новый Массив; // Массив из Строка
	Для Каждого ЭлементПараметра Из ПараметрыНабора Цикл
		Если ЭлементПараметра.Значение.ЭтоВыражение Тогда
			Выражения.Добавить(ЭлементПараметра.Значение.ЗначениеПараметра);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Выражения;
	
КонецФункции

Функция ИменаПараметров(ПараметрыНабора)
	
	Имена = Новый Массив; // Массив из Строка
	Для Каждого ЭлементПараметра Из ПараметрыНабора Цикл
		Имена.Добавить(ЭлементПараметра.Ключ);
	КонецЦикла;
	
	Возврат Имена;
	
КонецФункции

// Значение 1С из значения JSON со служебными полями _objectRef, _date, _type, _table.
//
// Параметры:
//  ЗначениеJSON - Произвольный - Структура, Массив или примитивное значение
//
// Возвращаемое значение:
//  Произвольный
//
Функция ЗначениеИзJSON(ЗначениеJSON)
	
	Значение = ЗначениеJSON;
	ЗначениеСвойства = Неопределено;
	
	Если ТипЗнч(ЗначениеJSON) = Тип("Массив") Тогда
		Значение = Новый Массив;
		Для Каждого Элемент Из ЗначениеJSON Цикл
			Значение.Добавить(ЗначениеИзJSON(Элемент));
		КонецЦикла;
	ИначеЕсли ТипЗнч(ЗначениеJSON) <> Тип("Структура") Тогда
		Значение = ЗначениеJSON;
	ИначеЕсли ЗначениеJSON.Свойство("_objectRef") Тогда
		Значение = СсылкаПоОписанию(ЗначениеJSON);
	ИначеЕсли ЗначениеJSON.Свойство("_date", ЗначениеСвойства) Тогда
		Значение = ДатаИзСтроки(ЗначениеСвойства);
	ИначеЕсли ЗначениеJSON.Свойство("_type", ЗначениеСвойства) Тогда
		Значение = Тип(ЗначениеСвойства);
	ИначеЕсли ЗначениеJSON.Свойство("_table", ЗначениеСвойства) Тогда
		Значение = ТаблицаИзJSON(ЗначениеСвойства);
	ИначеЕсли ЗначениеJSON.Свойство("_expression") Тогда
		ВызватьИсключение "_expression допустимо только как значение параметра верхнего уровня";
	Иначе
		Значение = Новый Структура;
		Для Каждого ЭлементСтруктуры Из ЗначениеJSON Цикл
			Значение.Вставить(ЭлементСтруктуры.Ключ, ЗначениеИзJSON(ЭлементСтруктуры.Значение));
		КонецЦикла;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Таблица значений из {columns, rows} или массива строк-объектов.
// Тип колонки без явного type выводится по значениям: таблица в параметре запроса должна быть типизирована.
//
// Параметры:
//  ОписаниеТаблицы - Структура, Массив
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция ТаблицаИзJSON(ОписаниеТаблицы)
	
	КолонкиJSON = Неопределено;
	СтрокиJSON = Неопределено;
	Если ТипЗнч(ОписаниеТаблицы) = Тип("Массив") Тогда
		СтрокиJSON = ОписаниеТаблицы;
	ИначеЕсли ТипЗнч(ОписаниеТаблицы) = Тип("Структура") Тогда
		ОписаниеТаблицы.Свойство("columns", КолонкиJSON);
		ОписаниеТаблицы.Свойство("rows", СтрокиJSON);
	Иначе
		ВызватьИсключение "_table: ожидается {columns, rows} или массив строк";
	КонецЕсли;
	Если ТипЗнч(СтрокиJSON) <> Тип("Массив") Тогда
		СтрокиJSON = Новый Массив;
	КонецЕсли;
	
	Колонки = КолонкиТаблицы(КолонкиJSON, СтрокиJSON);
	
	ЗначенияСтрок = Новый Массив; // Массив из Массив
	Для Каждого СтрокаJSON Из СтрокиJSON Цикл
		Значения = Новый Массив;
		Для Индекс = 0 По Колонки.ВГраница() Цикл
			ЗначениеЯчейки = Неопределено;
			Если ТипЗнч(СтрокаJSON) = Тип("Структура") Тогда
				СтрокаJSON.Свойство(Колонки[Индекс].Имя, ЗначениеЯчейки);
			ИначеЕсли ТипЗнч(СтрокаJSON) = Тип("Массив") И Индекс <= СтрокаJSON.ВГраница() Тогда
				ЗначениеЯчейки = СтрокаJSON[Индекс];
			КонецЕсли;
			Значения.Добавить(ЗначениеЯчейки(ЗначениеЯчейки, Колонки[Индекс].ТипЗначения));
		КонецЦикла;
		ЗначенияСтрок.Добавить(Значения);
	КонецЦикла;
	
	Таблица = Новый ТаблицаЗначений;
	Для Индекс = 0 По Колонки.ВГраница() Цикл
		ТипЗначения = Колонки[Индекс].ТипЗначения;
		Если ТипЗначения = Неопределено Тогда
			ТипЗначения = ВыведенныйТип(ЗначенияСтрок, Индекс);
		КонецЕсли;
		Таблица.Колонки.Добавить(Колонки[Индекс].Имя, ТипЗначения);
	КонецЦикла;
	
	Для Каждого Значения Из ЗначенияСтрок Цикл
		НоваяСтрока = Таблица.Добавить();
		Для Индекс = 0 По Колонки.ВГраница() Цикл
			НоваяСтрока[Индекс] = Значения[Индекс];
		КонецЦикла;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

// Параметры:
//  КолонкиJSON - Массив, Неопределено - имена колонок или {name, type}
//  СтрокиJSON - Массив - без колонок имена берутся из первой строки-объекта
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Имя - Строка
//   * ТипЗначения - ОписаниеТипов, Неопределено - Неопределено, если тип выводится по значениям
//
Функция КолонкиТаблицы(КолонкиJSON, СтрокиJSON)
	
	Колонки = Новый Массив; // Массив из Структура
	Если ТипЗнч(КолонкиJSON) = Тип("Массив") Тогда
		Для Каждого КолонкаJSON Из КолонкиJSON Цикл
			Колонка = Новый Структура("Имя, ТипЗначения", "", Неопределено);
			ИмяКолонки = "";
			ТипКолонки = Неопределено;
			Если ТипЗнч(КолонкаJSON) = Тип("Структура") Тогда
				КолонкаJSON.Свойство("name", ИмяКолонки);
				КолонкаJSON.Свойство("type", ТипКолонки);
			Иначе
				ИмяКолонки = КолонкаJSON;
			КонецЕсли;
			Колонка.Имя = СокрЛП(Строка(ИмяКолонки));
			Если Не ЗначениеЗаполнено(Колонка.Имя) Тогда
				ВызватьИсключение "_table: у колонки не задано имя";
			КонецЕсли;
			Если ЗначениеЗаполнено(ТипКолонки) Тогда
				Колонка.ТипЗначения = Новый ОписаниеТипов(Строка(ТипКолонки));
				Если Колонка.ТипЗначения.Типы().Количество() = 0 Тогда
					ВызватьИсключение СтрШаблон("_table: неизвестный тип колонки %1: %2", Колонка.Имя, ТипКолонки);
				КонецЕсли;
			КонецЕсли;
			Колонки.Добавить(Колонка);
		КонецЦикла;
	ИначеЕсли СтрокиJSON.Количество() > 0 И ТипЗнч(СтрокиJSON[0]) = Тип("Структура") Тогда
		Для Каждого ЭлементСтроки Из СтрокиJSON[0] Цикл
			Колонки.Добавить(Новый Структура("Имя, ТипЗначения", ЭлементСтроки.Ключ, Неопределено));
		КонецЦикла;
	Иначе
		ВызватьИсключение "_table: укажите columns или передайте строки объектами";
	КонецЕсли;
	
	Возврат Колонки;
	
КонецФункции

// Значение ячейки с учетом типа колонки: строка в ссылочной колонке - uuid или имя, в колонке даты - дата.
Функция ЗначениеЯчейки(ЗначениеJSON, ТипКолонки)
	
	Значение = ЗначениеИзJSON(ЗначениеJSON);
	
	// Строка остается строкой, если тип колонки не задан или допускает строки
	Преобразовать = ТипКолонки <> Неопределено И ТипЗнч(Значение) = Тип("Строка") И Не ТипКолонки.СодержитТип(Тип("Строка"));
	
	Если Преобразовать И ТипКолонки.СодержитТип(Тип("Дата")) Тогда
		Значение = ДатаИзСтроки(Значение);
	ИначеЕсли Преобразовать Тогда
		Для Каждого ТипСсылки Из ТипКолонки.Типы() Цикл
			Если ЭтоТипСсылки(ТипСсылки) Тогда
				Значение = СсылкаПоИдентификатору(ТипСсылки, Значение);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Описание типов колонки по ее значениям; строка - с длиной самого длинного значения.
//
// Параметры:
//  ЗначенияСтрок - Массив из Массив
//  Индекс - Число - индекс колонки
//
// Возвращаемое значение:
//  ОписаниеТипов
//
Функция ВыведенныйТип(ЗначенияСтрок, Индекс)
	
	Типы = Новый Массив; // Массив из Тип
	ДлинаСтроки = 1;
	Для Каждого Значения Из ЗначенияСтрок Цикл
		Значение = Значения[Индекс];
		Если Значение = Неопределено Или Значение = Null Тогда
			Продолжить;
		КонецЕсли;
		Если Типы.Найти(ТипЗнч(Значение)) = Неопределено Тогда
			Типы.Добавить(ТипЗнч(Значение));
		КонецЕсли;
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			ДлинаСтроки = Макс(ДлинаСтроки, СтрДлина(Значение));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый ОписаниеТипов(Типы, , Новый КвалификаторыСтроки(ДлинаСтроки));
	
КонецФункции

Функция ДатаИзСтроки(Знач СтрокаДаты)
	
	СтрокаДаты = СокрЛП(Строка(СтрокаДаты));
	Если СтрДлина(СтрокаДаты) = 10 Тогда
		СтрокаДаты = СтрокаДаты + "T00:00:00";
	КонецЕсли;
	Попытка
		Значение = XMLЗначение(Тип("Дата"), СтрокаДаты);
	Исключение
		ВызватьИсключение СтрШаблон("неверная дата ""%1"", ожидается ГГГГ-ММ-ДД или ГГГГ-ММ-ДДTчч:мм:сс", СтрокаДаты);
	КонецПопытки;
	
	Возврат Значение;
	
КонецФункции

#КонецОбласти

#Область Ссылки

// Ссылка по описанию {_objectRef, УникальныйИдентификатор, ТипОбъекта}, как в ответах execute_query.
Функция СсылкаПоОписанию(Описание)
	
	ИмяТипа = "";
	Идентификатор = "";
	Описание.Свойство("ТипОбъекта", ИмяТипа);
	Описание.Свойство("УникальныйИдентификатор", Идентификатор);
	Если Не ЗначениеЗаполнено(ИмяТипа) Тогда
		ВызватьИсключение "_objectRef: не заполнен ТипОбъекта";
	КонецЕсли;
	
	ТипСсылки = Тип(ИмяТипа);
	Если Не ЭтоТипСсылки(ТипСсылки) Тогда
		ВызватьИсключение СтрШаблон("_objectRef: %1 - не ссылочный тип", ИмяТипа);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Ссылка = СсылкаПоИдентификатору(ТипСсылки, Идентификатор);
	Иначе
		ОписаниеСсылки = Новый ОписаниеТипов(ИмяТипа);
		Ссылка = ОписаниеСсылки.ПривестиЗначение(Неопределено);
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции

// Ссылка по uuid, имени значения перечисления или имени предопределенного элемента.
Функция СсылкаПоИдентификатору(ТипСсылки, Знач Идентификатор)
	
	Идентификатор = СокрЛП(Строка(Идентификатор));
	Попытка
		Ссылка = XMLЗначение(ТипСсылки, Идентификатор);
	Исключение
		Ссылка = Неопределено;
	КонецПопытки;
	
	Если Ссылка = Неопределено Тогда
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипСсылки);
		Попытка
			Ссылка = ПредопределенноеЗначение(ОбъектМетаданных.ПолноеИмя() + "." + Идентификатор);
		Исключение
			ВызватьИсключение СтрШаблон("нет значения ""%1"" среди значений типа ""%2""", Идентификатор, ПредставлениеТипа(ТипСсылки));
		КонецПопытки;
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции

Функция ОписаниеОбъектаПоСсылке(Ссылка)
	
	Описание = Новый Структура;
	Описание.Вставить("_objectRef", Истина);
	Описание.Вставить("УникальныйИдентификатор", XMLСтрока(Ссылка));
	Описание.Вставить("ТипОбъекта", ПредставлениеТипа(ТипЗнч(Ссылка)));
	Описание.Вставить("Представление", Строка(Ссылка));
	
	Возврат Описание;
	
КонецФункции

Функция ЭтоСсылка(Значение)
	
	Возврат ЭтоТипСсылки(ТипЗнч(Значение));
	
КонецФункции

// Ссылочные типы XDTO называются CatalogRef.Имя, DocumentRef.Имя, EnumRef.Имя и т.п.
Функция ЭтоТипСсылки(ПроверяемыйТип)
	
	ТипXML = XMLТип(ПроверяемыйТип);
	Возврат ТипXML <> Неопределено И СтрНайти(ТипXML.ИмяТипа, "Ref.") > 0;
	
КонецФункции

// Имя ссылочного типа в виде СправочникСсылка.Имя, его принимают Тип() и ОписаниеТипов; остальные - Строка(Тип).
Функция ПредставлениеТипа(ПредставляемыйТип)
	
	Представление = Строка(ПредставляемыйТип);
	Если ЭтоТипСсылки(ПредставляемыйТип) Тогда
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ПредставляемыйТип);
		Если ОбъектМетаданных <> Неопределено Тогда
			ЧастиИмени = СтрРазделить(ОбъектМетаданных.ПолноеИмя(), ".");
			Если ЧастиИмени.Количество() = 2 Тогда
				Представление = ЧастиИмени[0] + "Ссылка." + ЧастиИмени[1];
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

Функция ПредставлениеОписанияТипов(Описание)
	
	Представления = Новый Массив; // Массив из Строка
	Для Каждого ТипОписания Из Описание.Типы() Цикл
		Если ТипОписания <> Тип("Null") Тогда
			Представления.Добавить(ПредставлениеТипа(ТипОписания));
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(Представления, ", ");
	
КонецФункции

#КонецОбласти

#Область JSON

Функция ЗначениеВJSON(Значение)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	
	НастройкиСериализации = Новый НастройкиСериализацииJSON;
	НастройкиСериализации.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	НастройкиСериализации.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДата;
	
	ЗаписатьJSON(ЗаписьJSON, Значение, НастройкиСериализации, "ПреобразованиеJSON", ИнструментыMCPСервер_Ei);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

Функция ТаблицаВМассив(Таблица)
	
	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаМассива = Новый Структура;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			СтрокаМассива.Вставить(Колонка.Имя, СтрокаТаблицы[Колонка.Имя]);
		КонецЦикла;
		Строки.Добавить(СтрокаМассива);
	КонецЦикла;
	
	Возврат Строки;
	
КонецФункции

Функция СтрокиДереваВМассив(СтрокиДерева, Колонки)
	
	Строки = Новый Массив;
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		СтрокаМассива = Новый Структура;
		Для Каждого Колонка Из Колонки Цикл
			СтрокаМассива.Вставить(Колонка.Имя, СтрокаДерева[Колонка.Имя]);
		КонецЦикла;
		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			СтрокаМассива.Вставить("Строки", СтрокиДереваВМассив(СтрокаДерева.Строки, Колонки));
		КонецЕсли;
		Строки.Добавить(СтрокаМассива);
	КонецЦикла;
	
	Возврат Строки;
	
КонецФункции

#КонецОбласти

#Область Аргументы

Функция Аргумент(Аргументы, Имя, ПоУмолчанию = Неопределено)
	
	Значение = Неопределено;
	Если Не Аргументы.Свойство(Имя, Значение) Или Значение = Неопределено Или Значение = Null Тогда
		Значение = ПоУмолчанию;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Параметры:
//  Значение - Произвольный - число из JSON или его строковая запись
//  ПоУмолчанию - Число - если значение не задано или не число
//
// Возвращаемое значение:
//  Число
//
Функция ЧислоАргумента(Значение, ПоУмолчанию)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Результат = Значение;
	Иначе
		ОписаниеЧисла = Новый ОписаниеТипов("Число");
		Результат = ОписаниеЧисла.ПривестиЗначение(Значение);
		Если Результат = 0 Тогда
			Результат = ПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Значение - Произвольный - limit из аргументов
//
// Возвращаемое значение:
//  Число - от 1 до см. МаксимальныйПредел
//
Функция ПределСтрок(Значение)
	
	Результат = Цел(ЧислоАргумента(Значение, ПределПоУмолчанию()));
	Если Результат <= 0 Тогда
		Результат = ПределПоУмолчанию();
	КонецЕсли;
	
	Возврат Мин(Результат, МаксимальныйПредел());
	
КонецФункции


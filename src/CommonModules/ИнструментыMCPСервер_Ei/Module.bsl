Функция СвойствоСхемы(ТипСвойства, Описание, ЗначениеПоУмолчанию = Неопределено, ДопустимыеЗначения = "")
	
	Свойство = Новый Структура;
	Свойство.Вставить("type", ТипСвойства);
	Свойство.Вставить("description", Описание);
	Если ЗначениеПоУмолчанию <> Неопределено Тогда
		Свойство.Вставить("default", ЗначениеПоУмолчанию);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДопустимыеЗначения) Тогда
		Свойство.Вставить("enum", СтрРазделить(ДопустимыеЗначения, ","));
	КонецЕсли;
	
	Возврат Свойство;
	
КонецФункции

Функция СхемаПараметров(Свойства, Обязательные)
	
	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", СтрРазделить(Обязательные, ",", Ложь));
	
	Возврат Схема;
	
КонецФункции

#КонецОбласти

#Область ВыполнениеКода

Функция ВыполнитьКод(Аргументы)
	
	Ответ = Новый Структура("success", Ложь);
	
	Код = Строка(Аргумент(Аргументы, "code", ""));
	Контекст = НРег(Строка(Аргумент(Аргументы, "execution_context", "server")));
	ИмяРежима = НРег(Строка(Аргумент(Аргументы, "mode", "statements")));
	Режим = РежимПоИмени(ИмяРежима);
	ИдентификаторЗапроса = СокрЛП(Строка(Аргумент(Аргументы, "request_id", "")));
	Предел = ПределСтрок(Аргумент(Аргументы, "limit"));
	ПараметрыJSON = Аргумент(Аргументы, "parameters");
	
	ОшибкаПараметров = "";
	ПараметрыНабора = ПараметрыНабораИзJSON(ПараметрыJSON, ОшибкаПараметров);
	
	Если Не ЗначениеЗаполнено(СокрЛП(Код)) Тогда
		Ответ.Вставить("error", "Параметр code обязателен и не может быть пустым");
	ИначеЕсли Контекст <> "server" И Контекст <> "client" Тогда
		Ответ.Вставить("error", "Недопустимый execution_context: " + Контекст + ". Допустимо: server, client");
	ИначеЕсли Режим = Неопределено Тогда
		Ответ.Вставить("error", "Недопустимый mode: " + ИмяРежима + ". Допустимо: statements, expression, module");
	ИначеЕсли Режим = ВыполнитьКлиентСервер_Ei.РежимыВыражения().Модуль И Контекст = "client" Тогда
		Ответ.Вставить("error", "mode=module выполняется только на сервере: используйте execution_context=server");
	ИначеЕсли ЗначениеЗаполнено(ОшибкаПараметров) Тогда
		Ответ.Вставить("error", "Ошибка в parameters: " + ОшибкаПараметров);
	Иначе
		
		ОпасныеРазрешены = ПроверкаКодаMCPСервер_Ei.ОпасныеОперацииРазрешены();
		Ответ.Вставить("dangerous_operations_allowed", ОпасныеРазрешены);
		Ответ.Вставить("execution_context", Контекст);
		Ответ.Вставить("mode", ИмяРежима);
		
		ТекстПроверки = ТекстДляПроверки(Код, ПараметрыНабора);
		Запрещенные = Новый Массив; // Массив из Строка
		Если Не ОпасныеРазрешены Тогда
			Запрещенные = ПроверкаКодаMCPСервер_Ei.ЗапрещенныеКлючевыеСлова(ТекстПроверки);
		КонецЕсли;
		
		НайденныеОпасные = Новый Массив; // Массив из Строка
		Если Не ОпасныеРазрешены Тогда
			НайденныеОпасные = ПроверкаКодаMCPСервер_Ei.ОпасныеКлючевыеСлова(ТекстПроверки, Контекст);
		КонецЕсли;
		
		Если Запрещенные.Количество() > 0 Тогда
			Ответ.Вставить("error",
				"Операция запрещена в рабочей базе даже с подтверждением: код обращается к хранилищам настроек, параметрам сеанса, уведомлениям клиента или клиентскому агенту: "
					+ СтрСоединить(Запрещенные, ", "));
			Ответ.Вставить("dangerous_keywords", Запрещенные);
		ИначеЕсли Контекст = "server" И НайденныеОпасные.Количество() = 0 Тогда
			ВыполнитьНаСервере(Код, Режим, ПараметрыНабора, Предел, Ответ);
		Иначе
			Описание = Новый Структура;
			Описание.Вставить("Код", Код);
			Описание.Вставить("Контекст", Контекст);
			Описание.Вставить("Режим", Режим);
			Описание.Вставить("Параметры", ПараметрыНабора);
			Описание.Вставить("ОпасныеКонструкции", НайденныеОпасные);
			// Повторный вызов с request_id должен прислать те же код, режим и параметры
			ЧастиХеша = Новый Массив; // Массив из Строка
			ЧастиХеша.Добавить(Код);
			ЧастиХеша.Добавить(Режим);
			ЧастиХеша.Добавить(ЗначениеВJSON(ПараметрыJSON));
			Описание.Вставить("Хеш", ЗапросыMCPСервер_Ei.Хеш(СтрСоединить(ЧастиХеша, Символы.ПС)));
			ВыполнитьЧерезАгента(Описание, ИдентификаторЗапроса, Предел, Ответ);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Выполняет безопасный код в HTTP-сеансе MCP: с параметрами во временном наборе,
// замером в журнале выполнения и запуском в истории Ei.
Процедура ВыполнитьНаСервере(Код, Режим, ПараметрыНабора, Предел, Ответ)
	
	ИмяВарианта = ВариантАлгоритмКлиентСервер_Ei.Свойства().Имя;
	Выполнение = НачатьВыполнение(ИмяВарианта, Код, ПараметрыНабора, "MCP: execute_code на сервере");
	ОписаниеЗначения = Неопределено;
	ИнформацияОбОшибке = Неопределено;
	
	Попытка
		ОписаниеЗначения = ВыполнитьКлиентСервер_Ei.ВыражениеВМесте(Код, Новый УникальныйИдентификатор,
			ВыполнитьКлиентСервер_Ei.МестаВыполнения().Сервер, Режим);
		Значение = ИсторияВызовСервера_Ei.ЗначениеРезультата(ОписаниеЗначения);
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("result_type", Строка(ТипЗнч(Значение)));
		Ответ.Вставить("data", ОграничитьДанные(Значение, Предел, Ответ));
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Ответ.Вставить("error", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	КонецПопытки;
	
	ЗавершитьВыполнение(Выполнение, ОписаниеЗначения, ИнформацияОбОшибке, Ответ);
	
КонецПроцедуры

// Запрашивает у человека подтверждение серверного кода или выполнение клиентского
// и заполняет ответ по решению агента.
//
// Параметры:
//  Описание - см. ЗапросыMCPСервер_Ei.ЗапроситьРешение
//  ИдентификаторЗапроса - Строка
//  Предел - Число
//  Ответ - Структура - дополняется полями ответа
//
Процедура ВыполнитьЧерезАгента(Описание, ИдентификаторЗапроса, Предел, Ответ)
	
	Если Описание.ОпасныеКонструкции.Количество() > 0 Тогда
		Ответ.Вставить("dangerous_keywords", Описание.ОпасныеКонструкции);
	КонецЕсли;
	
	СостояниеАгента = ЗапросыMCPСервер_Ei.СостояниеАгента();
	Если Не СостояниеАгента.Доступен Тогда
		Если Описание.Контекст = "client" Тогда
			Ответ.Вставить("error", "execution_context=client недоступен: " + СостояниеАгента.Причина + ". Используйте execution_context=server.");
		Иначе
			Ответ.Вставить("error", "Операция запрещена: код содержит опасные конструкции: " + СтрСоединить(Описание.ОпасныеКонструкции, ", ")
				+ ". Подтверждение человеком недоступно: " + СостояниеАгента.Причина);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Попытка
		Решение = ЗапросыMCPСервер_Ei.ЗапроситьРешение(Описание, ИдентификаторЗапроса);
	Исключение
		Ответ.Вставить("error", "Ошибка обмена с клиентским агентом Ei: "
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Если Решение.Статус = "error" Тогда
		Ответ.Вставить("error", Решение.Ошибка);
	ИначеЕсли Решение.Статус = "pending" Тогда
		Ответ.Вставить("status", "pending_approval");
		Ответ.Вставить("request_id", Решение.Идентификатор);
		Ответ.Вставить("message",
			"Ожидается решение пользователя в клиенте 1С. Повторите execute_code с теми же code, mode, parameters, execution_context и request_id="
				+ Решение.Идентификатор + ", чтобы дождаться ответа.");
	Иначе
		РешениеАгента = Решение.Ответ;
		Ответ.Вставить("request_id", Решение.Идентификатор);
		Ответ.Вставить("user_decision", РешениеАгента.Решение);
		Если РешениеАгента.Решение = "Отклонено" Тогда
			ЗаполнитьОтказ(РешениеАгента, Ответ);
		Иначе
			ЗаполнитьРезультатАгента(РешениеАгента, Предел, Ответ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Отказ пользователя: rejection_kind различает явный запрет,
// отмену (пользователь не уверен) и отказ по истечении времени формы подтверждения.
Процедура ЗаполнитьОтказ(РешениеАгента, Ответ)
	
	ВидОтказа = "";
	РешениеАгента.Свойство("ВидОтказа", ВидОтказа);
	
	Если ВидОтказа = "Запрещено" Тогда
		Ответ.Вставить("rejection_kind", "forbidden");
		Ответ.Вставить("error", "Пользователь запретил выполнение кода");
	ИначеЕсли ВидОтказа = "Таймаут" Тогда
		Ответ.Вставить("rejection_kind", "timeout");
		Ответ.Вставить("error", "Пользователь не ответил за отведенное время, выполнение запрещено по умолчанию");
	Иначе
		Ответ.Вставить("rejection_kind", "cancelled");
		Ответ.Вставить("error", "Пользователь отменил подтверждение: не уверен, что код нужно выполнять");
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРезультатАгента(РешениеАгента, Предел, Ответ)
	
	Успех = ТипЗнч(РешениеАгента.Успех) = Тип("Булево") И РешениеАгента.Успех;
	Ответ.Вставить("success", Успех);
	
	Если Успех Тогда
		Ответ.Вставить("result_type", РешениеАгента.ТипРезультата);
		Ответ.Вставить("data", ОграничитьДанные(РешениеАгента.Результат, Предел, Ответ));
	Иначе
		Ответ.Вставить("error", РешениеАгента.Ошибка);
	КонецЕсли;
	
	Если ТипЗнч(РешениеАгента.КодИзменен) = Тип("Булево") И РешениеАгента.КодИзменен Тогда
		Ответ.Вставить("code_modified", Истина);
		Ответ.Вставить("executed_code", РешениеАгента.Код);
	КонецЕсли;
	
КонецПроцедуры

// Код вместе с выражениями параметров: выражения выполняются так же, как код, и проверяются вместе с ним.
Функция ТекстДляПроверки(Код, ПараметрыНабора)
	
	Тексты = Новый Массив; // Массив из Строка
	Тексты.Добавить(Код);
	Для Каждого Выражение Из ВыраженияПараметров(ПараметрыНабора) Цикл
		Тексты.Добавить(Выражение);
	КонецЦикла;
	
	Возврат СтрСоединить(Тексты, Символы.ПС);
	
КонецФункции

Функция РежимПоИмени(ИмяРежима)
	
	Режимы = ВыполнитьКлиентСервер_Ei.РежимыВыражения();
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("statements", Режимы.Выполнить);
	Соответствие.Вставить("expression", Режимы.Вычислить);
	Соответствие.Вставить("module", Режимы.Модуль);
	
	Возврат Соответствие.Получить(ИмяРежима);
	
КонецФункции

// Таблица или массив в результате обрезаются до предела: модели нужны первые строки и общее количество.
//
// Параметры:
//  Значение - Произвольный
//  Предел - Число
//  Ответ - Структура - дополняется полями truncated и total
//
// Возвращаемое значение:
//  Произвольный
//
Функция ОграничитьДанные(Знач Значение, Предел, Ответ)
	
	Если ТипЗнч(Значение) = Тип("РезультатЗапроса") Тогда
		Значение = Значение.Выгрузить();
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") Или ТипЗнч(Значение) = Тип("Массив") Тогда
		Всего = Значение.Количество();
		Ответ.Вставить("total", Всего);
		Ответ.Вставить("truncated", Всего > Предел);
		Если Всего > Предел Тогда
			Первые = Новый Массив;
			Для Каждого Элемент Из Значение Цикл
				Если Первые.Количество() = Предел Тогда
					Прервать;
				КонецЕсли;
				Первые.Добавить(Элемент);
			КонецЦикла;
			Значение = ?(ТипЗнч(Значение) = Тип("Массив"), Первые, Значение.Скопировать(Первые));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

#КонецОбласти

#Область ВыполнениеЗапроса

Функция ВыполнитьЗапрос(Аргументы)
	
	Ответ = Новый Структура("success", Ложь);
	
	ТекстЗапроса = Строка(Аргумент(Аргументы, "queryText", ""));
	Предел = ПределСтрок(Аргумент(Аргументы, "limit"));
	Смещение = Макс(0, Цел(ЧислоАргумента(Аргумент(Аргументы, "offset"), 0)));
	НомерРезультата = Цел(ЧислоАргумента(Аргумент(Аргументы, "result_index"), 0));
	
	ОшибкаПараметров = "";
	ПараметрыНабора = ПараметрыНабораИзJSON(Аргумент(Аргументы, "parameters"), ОшибкаПараметров);
	
	Если Не ЗначениеЗаполнено(СокрЛП(ТекстЗапроса)) Тогда
		Ответ.Вставить("message", "Параметр queryText обязателен и не может быть пустым");
	ИначеЕсли ЗначениеЗаполнено(ОшибкаПараметров) Тогда
		Ответ.Вставить("message", "Ошибка в parameters: " + ОшибкаПараметров);
	Иначе
		
		ОпасныеВыражения = Новый Массив; // Массив из Строка
		Если Не ПроверкаКодаMCPСервер_Ei.ОпасныеОперацииРазрешены() Тогда
			ОпасныеВыражения = ПроверкаКодаMCPСервер_Ei.ОпасныеКонструкции(
				СтрСоединить(ВыраженияПараметров(ПараметрыНабора), Символы.ПС), "server");
		КонецЕсли;
		
		Если ОпасныеВыражения.Количество() > 0 Тогда
			Ответ.Вставить("message", "Выражения параметров содержат опасные конструкции: " + СтрСоединить(ОпасныеВыражения, ", ")
				+ ". Вычислите такие значения в execute_code с подтверждением пользователя.");
			Ответ.Вставить("dangerous_keywords", ОпасныеВыражения);
		Иначе
			ВыполнитьЗапросНаСервере(ТекстЗапроса, ПараметрыНабора, Предел, Смещение, НомерРезультата, Ответ);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Выполняет пакет запросов, как вариант Запрос строки набора Ei: параметры из временного набора,
// менеджер временных таблиц, результаты всех запросов пакета.
//@skip-check method-too-many-params
Процедура ВыполнитьЗапросНаСервере(ТекстЗапроса, ПараметрыНабора, Предел, Смещение, НомерРезультата, Ответ)
	
	ИмяВарианта = ВариантЗапросКлиентСервер_Ei.Свойства().Имя;
	Выполнение = НачатьВыполнение(ИмяВарианта, ТекстЗапроса, ПараметрыНабора, "MCP: execute_query");
	ОписаниеЗначения = Неопределено;
	ИнформацияОбОшибке = Неопределено;
	
	Попытка
		ОписаниеЗначения = ВыполнитьКлиентСервер_Ei.Запрос(ТекстЗапроса, Новый УникальныйИдентификатор);
		ЗаполнитьОтветЗапроса(Ответ, ИсторияВызовСервера_Ei.ЗначениеРезультата(ОписаниеЗначения), ТекстЗапроса,
			Предел, Смещение, НомерРезультата);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("message", ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке) + Символы.ПС + Символы.ПС
			+ "HINT: При ошибке запроса проверьте:" + Символы.ПС
			+ "1) Структуру объектов метаданных через get_metadata_structure (имена таблиц, полей, табличных частей)" + Символы.ПС
			+ "2) Формат parameters: ссылки - {_objectRef, УникальныйИдентификатор, ТипОбъекта}, даты - {_date}, таблицы - {_table}" + Символы.ПС
			+ "3) Если используете навигационные ссылки - сначала преобразуйте их через parse_nav_link");
	КонецПопытки;
	
	ЗавершитьВыполнение(Выполнение, ОписаниеЗначения, ИнформацияОбОшибке, Ответ);
	
КонецПроцедуры

//@skip-check method-too-many-params
Процедура ЗаполнитьОтветЗапроса(Ответ, Значение, ТекстЗапроса, Предел, Смещение, НомерРезультата)
	
	Результаты = Новый Массив;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результаты = Значение;
	Иначе
		Результаты.Добавить(Значение);
	КонецЕсли;
	
	ЗапросыПакета = ЗапросыПакета(ТекстЗапроса);
	Сводка = Новый Массив; // Массив из Структура
	ПоследняяВыборка = 0;
	
	Для Индекс = 0 По Результаты.ВГраница() Цикл
		ЭлементСводки = Новый Структура("index", Индекс + 1);
		ЗапросПакета = ?(Индекс <= ЗапросыПакета.ВГраница(), ЗапросыПакета[Индекс], Новый Структура("Помещение, Уничтожение", "", ""));
		Если ЗначениеЗаполнено(ЗапросПакета.Помещение) Тогда
			ЭлементСводки.Вставить("temp_table", ЗапросПакета.Помещение);
		ИначеЕсли ЗначениеЗаполнено(ЗапросПакета.Уничтожение) Тогда
			ЭлементСводки.Вставить("dropped_table", ЗапросПакета.Уничтожение);
		КонецЕсли;
		Результат = Результаты[Индекс];
		Если ТипЗнч(Результат) = Тип("РезультатЗапроса") Тогда
			ЭлементСводки.Вставить("rows", Результат.Выбрать().Количество());
			Если Не ЗначениеЗаполнено(ЗапросПакета.Помещение) Тогда
				ПоследняяВыборка = Индекс + 1;
			КонецЕсли;
		КонецЕсли;
		Сводка.Добавить(ЭлементСводки);
	КонецЦикла;
	
	Номер = ?(НомерРезультата > 0, НомерРезультата, ?(ПоследняяВыборка > 0, ПоследняяВыборка, Результаты.Количество()));
	Ответ.Вставить("results_count", Результаты.Количество());
	Ответ.Вставить("result_index", Номер);
	Если Результаты.Количество() > 1 Тогда
		Ответ.Вставить("batch", Сводка);
	КонецЕсли;
	
	Если Номер < 1 Или Номер > Результаты.Количество() Тогда
		Ответ.Вставить("success", Ложь);
		Ответ.Вставить("message", СтрШаблон("В пакете %1 запросов, result_index=%2 вне диапазона", Результаты.Количество(), Номер));
	ИначеЕсли ТипЗнч(Результаты[Номер - 1]) <> Тип("РезультатЗапроса") Тогда
		Ответ.Вставить("success", Истина);
		Ответ.Вставить("message", СтрШаблон("Запрос %1 пакета не возвращает строк (уничтожение временной таблицы)", Номер));
		Ответ.Вставить("columns", Новый Массив);
		Ответ.Вставить("rows", Новый Массив);
	Иначе
		ЗаполнитьСтрокиРезультата(Ответ, Результаты[Номер - 1], Предел, Смещение);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСтрокиРезультата(Ответ, РезультатЗапроса, Предел, Смещение)
	
	Колонки = Новый Массив; // Массив из Структура
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Колонки.Добавить(Новый Структура("name, type", Колонка.Имя, ПредставлениеОписанияТипов(Колонка.ТипЗначения)));
	КонецЦикла;
	
	Выборка = РезультатЗапроса.Выбрать();
	Всего = Выборка.Количество();
	Строки = Новый Массив; // Массив из Структура
	Номер = 0;
	Пока Выборка.Следующий() Цикл
		Номер = Номер + 1;
		Если Номер <= Смещение Тогда
			Продолжить;
		КонецЕсли;
		Если Строки.Количество() = Предел Тогда
			Прервать;
		КонецЕсли;
		СтрокаРезультата = Новый Структура;
		Для Каждого Колонка Из Колонки Цикл
			СтрокаРезультата.Вставить(Колонка.name, Выборка[Колонка.name]);
		КонецЦикла;
		Строки.Добавить(СтрокаРезультата);
	КонецЦикла;
	
	Усечено = Смещение + Строки.Количество() < Всего;
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("message", ?(Усечено, СтрШаблон("Возвращено %1 строк из %2: остальные - через offset", Строки.Количество(), Всего),
		"Запрос выполнен успешно"));
	Ответ.Вставить("total", Всего);
	Ответ.Вставить("offset", Смещение);
	Ответ.Вставить("limit", Предел);
	Ответ.Вставить("truncated", Усечено);
	Ответ.Вставить("columns", Колонки);
	Ответ.Вставить("rows", Строки);
	
КонецПроцедуры

// Временные таблицы, которые запросы пакета помещают и уничтожают.
//
// Параметры:
//  ТекстЗапроса - Строка
//
// Возвращаемое значение:
//  Массив из Структура - по запросам пакета, пустой, если текст не разобран:
//   * Помещение - Строка - имя временной таблицы ПОМЕСТИТЬ
//   * Уничтожение - Строка - имя уничтожаемой временной таблицы
//
Функция ЗапросыПакета(ТекстЗапроса)
	
	Запросы = Новый Массив; // Массив из Структура
	Попытка
		Схема = Новый СхемаЗапроса;
		Схема.УстановитьТекстЗапроса(ТекстЗапроса);
		Для Каждого ЗапросСхемы Из Схема.ПакетЗапросов Цикл
			ЗапросПакета = Новый Структура("Помещение, Уничтожение", "", "");
			Если ТипЗнч(ЗапросСхемы) = Тип("ЗапросВыбораСхемыЗапроса") Тогда
				ЗапросПакета.Помещение = ЗапросСхемы.ТаблицаДляПомещения;
			Иначе
				ЗапросПакета.Уничтожение = ЗапросСхемы.ИмяТаблицы;
			КонецЕсли;
			Запросы.Добавить(ЗапросПакета);
		КонецЦикла;
	Исключение
		// Текст уже выполнился, разбор нужен только для сводки по пакету.
		Запросы = Новый Массив;
	КонецПопытки;
	
	Возврат Запросы;
	
КонецФункции

#КонецОбласти

#Область СозданиеВариантов

Функция СоздатьВарианты(Аргументы)
	
	Ответ = Новый Структура("success", Ложь);
	
	ОшибкаНаборов = "";
	НаборыJSON = ЗначениеИзСтрокиJSON(Аргумент(Аргументы, "sets"), ОшибкаНаборов);
	Описание = СокрЛП(Строка(Аргумент(Аргументы, "description", "")));
	
	Если ЗначениеЗаполнено(ОшибкаНаборов) Тогда
		Ответ.Вставить("error", "Ошибка в sets: " + ОшибкаНаборов);
	ИначеЕсли ТипЗнч(НаборыJSON) <> Тип("Массив") Или НаборыJSON.Количество() = 0 Тогда
		Ответ.Вставить("error", "Параметр sets обязателен: непустой массив строк наборов");
	Иначе
		
		Разбор = Новый Структура;
		Разбор.Вставить("Ошибка", "");
		Разбор.Вставить("КоличествоСтрок", 0);
		Разбор.Вставить("Пути", Новый Массив);
		Разбор.Вставить("Тексты", Новый Массив);
		Наборы = НаборыИзJSON(НаборыJSON, "", 1, Разбор);
		
		Если ЗначениеЗаполнено(Разбор.Ошибка) Тогда
			Ответ.Вставить("error", "Ошибка в sets: " + Разбор.Ошибка);
		Иначе
			
			ТекстПроверки = СтрСоединить(Разбор.Тексты, Символы.ПС);
			ОпасныеКонструкции = Новый Массив; // Массив из Строка
			Запрещенные = Новый Массив; // Массив из Строка
			Если Не ПроверкаКодаMCPСервер_Ei.ОпасныеОперацииРазрешены() Тогда
				// Код выполнит сам пользователь, где захочет: проверяем как клиентский, по самому широкому списку
				ОпасныеКонструкции = ПроверкаКодаMCPСервер_Ei.ОпасныеКлючевыеСлова(ТекстПроверки, "client");
				Запрещенные = ПроверкаКодаMCPСервер_Ei.ЗапрещенныеКлючевыеСлова(ТекстПроверки);
			КонецЕсли;
			
			Если Запрещенные.Количество() > 0 Тогда
				Ответ.Вставить("error",
					"Операция запрещена в рабочей базе: код обращается к хранилищам настроек, параметрам сеанса, уведомлениям клиента или клиентскому агенту: "
						+ СтрСоединить(Запрещенные, ", "));
				Ответ.Вставить("dangerous_keywords", Запрещенные);
			Иначе
				ЗаполнитьОтветОтправкиНаборов(Наборы, Описание, ОпасныеКонструкции, Разбор.Пути, Ответ);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Процедура ЗаполнитьОтветОтправкиНаборов(Наборы, Описание, ОпасныеКонструкции, Пути, Ответ)
	
	Итог = ЗапросыMCPСервер_Ei.ОтправитьНаборы(Наборы, Описание, ОпасныеКонструкции);
	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		Ответ.Вставить("error", Итог.Ошибка);
		Возврат;
	КонецЕсли;
	
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("status", "sent");
	Ответ.Вставить("sets_id", Итог.Идентификатор);
	Ответ.Вставить("sessions", Итог.КоличествоСеансов);
	Ответ.Вставить("rows", Пути);
	Если ОпасныеКонструкции.Количество() > 0 Тогда
		Ответ.Вставить("dangerous_keywords", ОпасныеКонструкции);
	КонецЕсли;
	Ответ.Вставить("message",
		"Пользователю показано оповещение в клиенте 1С: по нажатию на него строки добавятся в Ei."
			+ " Когда пользователь отладит их, прочитайте строки через get_variants с sets_id=" + Итог.Идентификатор + ".");
	
КонецПроцедуры

// Разбирает массив строк наборов из sets или children.
//
// Параметры:
//  НаборыJSON - Массив из Произвольный - элементы sets или children
//  ПутьРодителя - Строка - путь родительской строки через /, пустой для sets
//  Уровень - Число - уровень вложенности, с 1
//  Разбор - Структура - общее состояние разбора:
//   * Ошибка - Строка - первая ошибка, разбор на ней останавливается
//   * КоличествоСтрок - Число
//   * Пути - Массив из Строка - пути строк в порядке добавления
//   * Тексты - Массив из Строка - код алгоритмов и выражений параметров для проверки
//
// Возвращаемое значение:
//  Массив из см. НаборИзJSON
//
Функция НаборыИзJSON(НаборыJSON, ПутьРодителя, Уровень, Разбор)
	
	Наборы = Новый Массив; // Массив из Структура
	
	Если Уровень > МаксимальнаяВложенностьНаборов() Тогда
		Разбор.Ошибка = СтрШаблон("%1: вложенность children больше %2 уровней", ПутьРодителя, МаксимальнаяВложенностьНаборов());
	Иначе
		Для Каждого НаборJSON Из НаборыJSON Цикл
			Разбор.КоличествоСтрок = Разбор.КоличествоСтрок + 1;
			Если Разбор.КоличествоСтрок > МаксимумСтрокНаборов() Тогда
				Разбор.Ошибка = СтрШаблон("строк больше %1, отправьте их несколькими вызовами", МаксимумСтрокНаборов());
				Прервать;
			КонецЕсли;
			Набор = НаборИзJSON(НаборJSON, ПутьРодителя, Уровень, Разбор);
			Если ЗначениеЗаполнено(Разбор.Ошибка) Тогда
				Прервать;
			КонецЕсли;
			Наборы.Добавить(Набор);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Наборы;
	
КонецФункции

// Строка набора для клиентского агента, см. ЗапросыMCPСервер_Ei.ОтправитьНаборы
//
// Параметры:
//  НаборJSON - Произвольный - элемент sets или children
//  ПутьРодителя - Строка
//  Уровень - Число
//  Разбор - см. НаборыИзJSON
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка
//   * Варианты - Структура - текст по имени варианта Ei
//   * Параметры - Структура - параметры по имени: ЭтоВыражение и ЗначениеПараметра
//   * ТекущийВариант - Строка - имя варианта Ei
//   * Строки - Массив из Структура - вложенные строки
//
Функция НаборИзJSON(НаборJSON, ПутьРодителя, Уровень, Разбор)
	
	Набор = Новый Структура;
	Набор.Вставить("Имя", "");
	Набор.Вставить("Варианты", Новый Структура);
	Набор.Вставить("Параметры", Новый Структура);
	Набор.Вставить("ТекущийВариант", "");
	Набор.Вставить("Строки", Новый Массив);
	
	Если ТипЗнч(НаборJSON) <> Тип("Структура") Тогда
		Разбор.Ошибка = СтрШаблон("%1: строка набора должна быть объектом, получено: %2",
			?(ЗначениеЗаполнено(ПутьРодителя), ПутьРодителя, "sets"), ТипЗнч(НаборJSON));
	Иначе
		ЗаполнитьНабор(Набор, НаборJSON, ПутьРодителя, Уровень, Разбор);
	КонецЕсли;
	
	Возврат Набор;
	
КонецФункции

// Заполняет строку набора из JSON, на первой ошибке останавливается.
//
// Параметры:
//  Набор - см. НаборИзJSON
//  НаборJSON - Структура - элемент sets или children
//  ПутьРодителя - Строка
//  Уровень - Число
//  Разбор - см. НаборыИзJSON
//
Процедура ЗаполнитьНабор(Набор, НаборJSON, ПутьРодителя, Уровень, Разбор)
	
	Набор.Имя = СокрЛП(Строка(Аргумент(НаборJSON, "name", ИмяНабораПоУмолчанию())));
	Путь = ?(ЗначениеЗаполнено(ПутьРодителя), ПутьРодителя + "/", "") + Набор.Имя;
	Разбор.Пути.Добавить(Путь);
	Если Не ЭтоИмяНабора(Набор.Имя) Тогда
		Разбор.Ошибка = СтрШаблон("%1: name должно быть идентификатором встроенного языка (буквы, цифры, _, не с цифры)", Путь);
		Возврат;
	КонецЕсли;
	
	ЗаполнитьВариантыНабора(Набор, НаборJSON, Путь, Разбор);
	Если ЗначениеЗаполнено(Разбор.Ошибка) Тогда
		Возврат;
	КонецЕсли;
	
	ОшибкаПараметров = "";
	Набор.Параметры = ПараметрыНабораИзJSON(Аргумент(НаборJSON, "parameters"), ОшибкаПараметров, Истина);
	Если ЗначениеЗаполнено(ОшибкаПараметров) Тогда
		Разбор.Ошибка = СтрШаблон("%1: ошибка в parameters: %2", Путь, ОшибкаПараметров);
		Возврат;
	КонецЕсли;
	Для Каждого Выражение Из ВыраженияПараметров(Набор.Параметры) Цикл
		Разбор.Тексты.Добавить(Выражение);
	КонецЦикла;
	
	ОшибкаВложенных = "";
	ВложенныеJSON = ЗначениеИзСтрокиJSON(Аргумент(НаборJSON, "children"), ОшибкаВложенных);
	Если ЗначениеЗаполнено(ОшибкаВложенных) Тогда
		Разбор.Ошибка = СтрШаблон("%1: ошибка в children: %2", Путь, ОшибкаВложенных);
	ИначеЕсли ВложенныеJSON <> Неопределено И ТипЗнч(ВложенныеJSON) <> Тип("Массив") Тогда
		Разбор.Ошибка = СтрШаблон("%1: children должно быть массивом", Путь);
	ИначеЕсли ВложенныеJSON <> Неопределено Тогда
		Набор.Строки = НаборыИзJSON(ВложенныеJSON, Путь, Уровень + 1, Разбор);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Разбор.Ошибка) И Набор.Варианты.Количество() = 0 И Набор.Строки.Количество() = 0 Тогда
		Разбор.Ошибка = СтрШаблон("%1: пустая строка - нужен хотя бы один из %2 или children", Путь,
			СтрСоединить(ИменаВариантовНабора(), ", "));
	КонецЕсли;
	
КонецПроцедуры

// Тексты вариантов строки и вариант, открытый в ней.
//
// Параметры:
//  Набор - см. НаборИзJSON
//  НаборJSON - Структура
//  Путь - Строка - путь строки, для текста ошибки
//  Разбор - см. НаборыИзJSON
//
Процедура ЗаполнитьВариантыНабора(Набор, НаборJSON, Путь, Разбор)
	
	ВариантыСтроки = ВариантыНабора();
	ПервыйВариант = "";
	Для Каждого ОписаниеВарианта Из ВариантыСтроки Цикл
		Текст = Аргумент(НаборJSON, ОписаниеВарианта.Ключ);
		// Процесс приходит описанием шагов, в набор кладутся его готовые данные
		Если ОписаниеВарианта.Значение.ЭтоПроцесс И Текст <> Неопределено Тогда
			ДанныеПроцесса = ДанныеПроцессаИзJSON(Текст, Путь + ": " + ОписаниеВарианта.Ключ, Разбор);
			Если ЗначениеЗаполнено(Разбор.Ошибка) Тогда
				Возврат;
			КонецЕсли;
			Набор.Варианты.Вставить(ОписаниеВарианта.Значение.Имя, ДанныеПроцесса);
			Если Не ЗначениеЗаполнено(ПервыйВариант) Тогда
				ПервыйВариант = ОписаниеВарианта.Ключ;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если ОписаниеВарианта.Значение.ЭтоТаблица И Текст <> Неопределено Тогда
			Текст = ТекстКоллекции(Текст, Путь + ": " + ОписаниеВарианта.Ключ, Разбор);
			Если ЗначениеЗаполнено(Разбор.Ошибка) Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Если Текст = Неопределено Тогда
			Продолжить;
		ИначеЕсли ТипЗнч(Текст) <> Тип("Строка") Тогда
			Разбор.Ошибка = СтрШаблон("%1: %2 должно быть строкой", Путь, ОписаниеВарианта.Ключ);
			Возврат;
		ИначеЕсли Не ЗначениеЗаполнено(СокрЛП(Текст)) Тогда
			Продолжить;
		КонецЕсли;
		Набор.Варианты.Вставить(ОписаниеВарианта.Значение.Имя, Текст);
		Если ОписаниеВарианта.Значение.ЭтоКод Тогда
			Разбор.Тексты.Добавить(Текст);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ПервыйВариант) Тогда
			ПервыйВариант = ОписаниеВарианта.Ключ;
		КонецЕсли;
	КонецЦикла;
	
	ИмяТекущего = НРег(СокрЛП(Строка(Аргумент(НаборJSON, "active_variant", ПервыйВариант))));
	Если ЗначениеЗаполнено(ИмяТекущего) И Не ВариантыСтроки.Свойство(ИмяТекущего) Тогда
		Разбор.Ошибка = СтрШаблон("%1: недопустимый active_variant %2. Допустимо: %3", Путь, ИмяТекущего,
			СтрСоединить(ИменаВариантовНабора(), ", "));
	ИначеЕсли ЗначениеЗаполнено(ИмяТекущего) Тогда
		Набор.ТекущийВариант = ВариантыСтроки[ИмяТекущего].Имя;
	КонецЕсли;
	
КонецПроцедуры

// Данные варианта Процессы из описания процесса: схема из шагов по порядку, настроенные обработки шагов
// и выражение объекта. Код алгоритмов и выражение объекта попадают в проверку опасных конструкций.
//
// Параметры:
//  Значение - Структура, Строка - {object, steps}; некоторые клиенты MCP присылают JSON строкой
//  Место - Строка - путь строки и имя свойства для текста ошибки
//  Разбор - см. НаборыИзJSON
//
// Возвращаемое значение:
//  см. ВариантПроцессыКлиентСервер_Ei.ПодготовитьДанные
//
Функция ДанныеПроцессаИзJSON(Знач Значение, Место, Разбор)
	
	Результат = Неопределено;
	ОшибкаJSON = "";
	Значение = ЗначениеИзСтрокиJSON(Значение, ОшибкаJSON);
	Если ЗначениеЗаполнено(ОшибкаJSON) Тогда
		Разбор.Ошибка = СтрШаблон("%1: %2", Место, ОшибкаJSON);
	ИначеЕсли ТипЗнч(Значение) <> Тип("Структура") Тогда
		Разбор.Ошибка = СтрШаблон("%1: должно быть объектом {""object"": ..., ""steps"": [...]}", Место);
	Иначе
		ИзначальныйОбъект = Аргумент(Значение, "object", "");
		Если ТипЗнч(ИзначальныйОбъект) <> Тип("Строка") Тогда
			Разбор.Ошибка = СтрШаблон("%1: object должно быть строкой - выражением объекта", Место);
		Иначе
			Шаги = ШагиПроцессаИзJSON(Аргумент(Значение, "steps"), Место, Разбор);
			Если Не ЗначениеЗаполнено(Разбор.Ошибка) Тогда
				Если ЗначениеЗаполнено(ИзначальныйОбъект) Тогда
					Разбор.Тексты.Добавить(ИзначальныйОбъект);
				КонецЕсли;
				Результат = ВариантПроцессыСервер_Ei.ДанныеПроцесса(Шаги, ИзначальныйОбъект);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Шаги процесса из JSON, на первой ошибке останавливается.
//
// Параметры:
//  Значение - Массив из Структура, Строка - шаги; некоторые клиенты MCP присылают JSON строкой
//  Место - Строка - путь процесса или шага для текста ошибки
//  Разбор - см. НаборыИзJSON
//
// Возвращаемое значение:
//  Массив из Структура - см. ВариантПроцессыСервер_Ei.ДанныеПроцесса
//
Функция ШагиПроцессаИзJSON(Знач Значение, Место, Разбор)
	
	Шаги = Новый Массив;
	ОшибкаJSON = "";
	Значение = ЗначениеИзСтрокиJSON(Значение, ОшибкаJSON);
	Если ЗначениеЗаполнено(ОшибкаJSON) Тогда
		Разбор.Ошибка = СтрШаблон("%1: steps: %2", Место, ОшибкаJSON);
	ИначеЕсли ТипЗнч(Значение) <> Тип("Массив") Или Значение.Количество() = 0 Тогда
		Разбор.Ошибка = СтрШаблон("%1: steps должно быть непустым массивом шагов", Место);
	Иначе
		Имена = Новый Соответствие;
		Номер = 0;
		Для Каждого ШагJSON Из Значение Цикл
			Номер = Номер + 1;
			МестоШага = СтрШаблон("%1: steps[%2]", Место, Номер);
			Шаг = ШагПроцессаИзJSON(ШагJSON, Номер, МестоШага, Разбор);
			Если ЗначениеЗаполнено(Разбор.Ошибка) Тогда
				Прервать;
			ИначеЕсли Имена.Получить(НРег(Шаг.Имя)) <> Неопределено Тогда
				Разбор.Ошибка = СтрШаблон("%1: имя шага %2 уже есть в этом процессе", МестоШага, Шаг.Имя);
				Прервать;
			КонецЕсли;
			Имена.Вставить(НРег(Шаг.Имя), Истина);
			Шаги.Добавить(Шаг);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Шаги;
	
КонецФункции

// Шаг процесса из JSON.
//
// Параметры:
//  ШагJSON - Произвольный - элемент steps
//  Номер - Число - номер шага, для имени по умолчанию
//  МестоШага - Строка - для текста ошибки
//  Разбор - см. НаборыИзJSON
//
// Возвращаемое значение:
//  Структура - шаг, см. ВариантПроцессыСервер_Ei.ДанныеПроцесса:
//   * Вид - Строка
//   * Имя - Строка
//   * Заголовок - Строка
//   * Код - Строка
//   * ИмяНабора - Строка
//   * ИмяВарианта - Строка
//   * Шаги - Массив из Структура
//
Функция ШагПроцессаИзJSON(ШагJSON, Номер, МестоШага, Разбор)
	
	Шаг = Новый Структура;
	Шаг.Вставить("Вид", 		"");
	Шаг.Вставить("Имя", 		"");
	Шаг.Вставить("Заголовок", 	"");
	Шаг.Вставить("Код", 		"");
	Шаг.Вставить("ИмяНабора", 	"");
	Шаг.Вставить("ИмяВарианта", "");
	Шаг.Вставить("Шаги", 		Новый Массив);
	
	ВидыШагов = Новый Структура;
	ВидыШагов.Вставить("algorithm", ОбработкаАлгоритмКлиентСервер_Ei.Свойства().Имя);
	ВидыШагов.Вставить("run", 		ОбработкаВыполнитьКлиентСервер_Ei.Свойства().Имя);
	ВидыШагов.Вставить("for_each", 	ОбработкаДляКаждогоКлиентСервер_Ei.Свойства().Имя);
	
	Вид = Неопределено;
	Если ТипЗнч(ШагJSON) <> Тип("Структура") Тогда
		Разбор.Ошибка = СтрШаблон("%1: шаг должен быть объектом", МестоШага);
	ИначеЕсли Не ВидыШагов.Свойство(НРег(СокрЛП(Строка(Аргумент(ШагJSON, "type", "")))), Вид) Тогда
		Разбор.Ошибка = СтрШаблон("%1: type должен быть algorithm, run или for_each", МестоШага);
	Иначе
		Шаг.Вид = Вид;
		Шаг.Имя = СокрЛП(Строка(Аргумент(ШагJSON, "name", Вид + Формат(Номер, "ЧГ="))));
		Шаг.Заголовок = СокрЛП(Строка(Аргумент(ШагJSON, "title", Шаг.Имя)));
		ЗаполнитьШагПроцесса(Шаг, ШагJSON, МестоШага, Разбор);
	КонецЕсли;
	
	Возврат Шаг;
	
КонецФункции

// Заполняет шаг процесса по его виду: код алгоритма, строку и вариант для Выполнить, шаги для Для Каждого.
//
// Параметры:
//  Шаг - см. ШагПроцессаИзJSON
//  ШагJSON - Структура - элемент steps
//  МестоШага - Строка - для текста ошибки
//  Разбор - см. НаборыИзJSON
//
Процедура ЗаполнитьШагПроцесса(Шаг, ШагJSON, МестоШага, Разбор)
	
	Разделитель = ПроцессыКлиентСервер_Ei.стрРазделительИмени();
	Если Не ЭтоИмяНабора(Шаг.Имя) Или СтрНайти(Шаг.Имя, Разделитель) > 0 Тогда
		Разбор.Ошибка = СтрШаблон("%1: name должно быть идентификатором встроенного языка без ""%2""", МестоШага, Разделитель);
	ИначеЕсли Шаг.Вид = ОбработкаАлгоритмКлиентСервер_Ei.Свойства().Имя Тогда
		Код = Аргумент(ШагJSON, "code", "");
		Если ТипЗнч(Код) <> Тип("Строка") Или Не ЗначениеЗаполнено(СокрЛП(Код)) Тогда
			Разбор.Ошибка = СтрШаблон("%1: у шага algorithm нужен code - код на встроенном языке", МестоШага);
		Иначе
			Шаг.Код = Код;
			Разбор.Тексты.Добавить(Код);
		КонецЕсли;
	ИначеЕсли Шаг.Вид = ОбработкаВыполнитьКлиентСервер_Ei.Свойства().Имя Тогда
		Шаг.ИмяНабора = СокрЛП(Строка(Аргумент(ШагJSON, "set", "")));
		Шаг.ИмяВарианта = ИмяВариантаШага(СокрЛП(Строка(Аргумент(ШагJSON, "variant", ""))));
		Если Не ЭтоИмяНабора(Шаг.ИмяНабора) Или Не ЗначениеЗаполнено(Шаг.ИмяВарианта) Тогда
			Разбор.Ошибка = СтрШаблон("%1: у шага run нужны set - имя строки набора и variant - вариант (%2)", МестоШага,
				СтрСоединить(ИменаВариантовНабора(), ", "));
		КонецЕсли;
	Иначе
		Шаг.Шаги = ШагиПроцессаИзJSON(Аргумент(ШагJSON, "steps"), МестоШага, Разбор);
	КонецЕсли;
	
КонецПроцедуры

// Имя варианта Ei для шага run: свойство JSON (query) или имя варианта (Запрос).
//
// Параметры:
//  Имя - Строка
//
// Возвращаемое значение:
//  Строка - имя варианта Ei, пустая - такого варианта нет
//
Функция ИмяВариантаШага(Имя)
	
	Результат = "";
	ОписаниеВарианта = Неопределено;
	Если Не ЭтоИмяНабора(Имя) Тогда
		Возврат Результат; // не идентификатор: такого варианта нет
	ИначеЕсли ВариантыНабора().Свойство(НРег(Имя), ОписаниеВарианта) Тогда
		Результат = ОписаниеВарианта.Имя;
	Иначе
		Для Каждого ЭлементВарианта Из ВариантыКлиентСерверПовтИсп_Ei.ПолучитьВарианты() Цикл
			Если НРег(ЭлементВарианта.Ключ) = НРег(Имя) Тогда
				Результат = ЭлементВарианта.Ключ;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Варианты строки набора, которые можно передать в create_variants: тексты, которые Ei хранит в строке как есть,
// и коллекция - таблица значений, которую строка хранит сериализованной.
//
// Возвращаемое значение:
//  Структура - ключ - имя свойства JSON, значение - описание варианта, см. ОписаниеВариантаНабора
//
Функция ВариантыНабора()
	
	Варианты = Новый Структура;
	Варианты.Вставить("query", ОписаниеВариантаНабора(ВариантЗапросКлиентСервер_Ei.Свойства().Имя,
		"Текст запроса или пакета запросов (вариант Запрос).", Ложь));
	Варианты.Вставить("algorithm", ОписаниеВариантаНабора(ВариантАлгоритмКлиентСервер_Ei.Свойства().Имя,
		"Код на встроенном языке, блок операторов с переменной Результат (вариант Алгоритм).", Истина));
	Варианты.Вставить("dcs", ОписаниеВариантаНабора(ВариантСКДКлиентСервер_Ei.Свойства().Имя,
		"Схема компоновки данных - XML СхемаКомпоновкиДанных (вариант СКД).", Ложь));
	Варианты.Вставить("json", ОписаниеВариантаНабора(ВариантJSONКлиентСервер_Ei.Свойства().Имя,
		"Текст JSON (вариант JSON).", Ложь));
	Варианты.Вставить("collection", ОписаниеВариантаНабора(ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя,
		"Таблица значений (вариант Коллекция): {columns, rows} в формате _table из parameters или массив строк-объектов."
			+ " Код строки берет ее через Варианты(""Коллекция"").Данные().", Ложь, Истина));
	Варианты.Вставить("process", ОписаниеВариантаНабора(ВариантПроцессыКлиентСервер_Ei.Свойства().Имя,
		"Процесс (вариант Процессы): {""object"": выражение объекта процесса, ""steps"": [шаги по порядку]}."
			+ " Шаг: {""type"": ""algorithm"", ""code"": код} | {""type"": ""run"", ""set"": строка набора, ""variant"": вариант} | {""type"": ""for_each"", ""steps"": [шаги для каждого элемента]},"
			+ " у шага необязательные name (идентификатор) и title (надпись на схеме).", Ложь, Ложь, Истина));
	Варианты.Вставить("comment", ОписаниеВариантаНабора(ВариантКомментарийКлиентСервер_Ei.Свойства().Имя,
		"Пояснение для пользователя: что проверить и как (вариант Комментарий).", Ложь));
	
	Возврат Варианты;
	
КонецФункции

// Описание варианта строки набора для create_variants.
//
// Параметры:
//  Имя - Строка - имя варианта Ei
//  Описание - Строка - для схемы инструмента
//  ЭтоКод - Булево - текст выполняется как код
//  ЭтоТаблица - Булево - значение - таблица в формате _table
//  ЭтоПроцесс - Булево - значение - описание процесса
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - имя варианта Ei, оно же колонка дерева наборов
//   * Описание - Строка - для схемы инструмента
//   * ЭтоКод - Булево - текст выполняется как код и проверяется на опасные конструкции
//   * ЭтоТаблица - Булево - значение - таблица в формате _table, а не текст
//   * ЭтоПроцесс - Булево - значение - описание процесса {object, steps}, см. ДанныеПроцессаИзJSON
//
Функция ОписаниеВариантаНабора(Имя, Описание, ЭтоКод, ЭтоТаблица = Ложь, ЭтоПроцесс = Ложь)
	
	Возврат Новый Структура("Имя, Описание, ЭтоКод, ЭтоТаблица, ЭтоПроцесс", Строка(Имя), Строка(Описание), ЭтоКод = Истина,
		ЭтоТаблица = Истина, ЭтоПроцесс = Истина);
	
КонецФункции

// Сериализованная таблица значений для варианта Коллекция: так ее хранит строка Ei,
// см. ВариантКоллекцияВызовСервера_Ei.СохранитьКоллекцию
//
// Параметры:
//  Значение - Структура, Массив, Строка - {columns, rows} или массив строк; некоторые клиенты MCP присылают JSON строкой
//  Место - Строка - путь строки и имя свойства для текста ошибки
//  Разбор - см. НаборыИзJSON
//
// Возвращаемое значение:
//  Строка - XML таблицы значений, пустая строка для коллекции без колонок
//
Функция ТекстКоллекции(Знач Значение, Место, Разбор)
	
	Текст = "";
	ОшибкаJSON = "";
	Значение = ЗначениеИзСтрокиJSON(Значение, ОшибкаJSON);
	
	Если ЗначениеЗаполнено(ОшибкаJSON) Тогда
		Разбор.Ошибка = СтрШаблон("%1: %2", Место, ОшибкаJSON);
	ИначеЕсли Значение <> Неопределено Тогда
		Таблица = Неопределено;
		Попытка
			Таблица = ТаблицаИзJSON(Значение);
		Исключение
			Разбор.Ошибка = СтрШаблон("%1: %2", Место, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Если Таблица <> Неопределено И Таблица.Колонки.Количество() > 0 Тогда
			Текст = ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(Таблица);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция ИменаВариантовНабора()
	
	Имена = Новый Массив; // Массив из Строка
	Для Каждого ОписаниеВарианта Из ВариантыНабора() Цикл
		Имена.Добавить(ОписаниеВарианта.Ключ);
	КонецЦикла;
	
	Возврат Имена;
	
КонецФункции

// Имя строки - ключ снимка наборов Ei, см. ВариантыКлиентСервер_Ei.ПолучитьВариант, поэтому оно должно быть идентификатором.
Функция ЭтоИмяНабора(Имя)
	
	Попытка
		Проверка = Новый Структура(Имя);
		ЭтоИмя = Проверка.Количество() = 1;
	Исключение
		ЭтоИмя = Ложь;
	КонецПопытки;
	
	Возврат ЭтоИмя;
	
КонецФункции

// Значение аргумента, который некоторые клиенты MCP присылают JSON строкой вместо массива или объекта.
//
// Параметры:
//  Значение - Произвольный
//  Ошибка - Строка - заполняется, если строка - не JSON
//
// Возвращаемое значение:
//  Произвольный - Неопределено для пустой строки
//
Функция ЗначениеИзСтрокиJSON(Знач Значение, Ошибка)
	
	Результат = Неопределено;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Результат = Значение;
	ИначеЕсли ЗначениеЗаполнено(СокрЛП(Значение)) Тогда
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Значение);
		Попытка
			Результат = ПрочитатьJSON(ЧтениеJSON);
		Исключение
			Ошибка = "строка - не JSON: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		ЧтениеJSON.Закрыть();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ЧтениеВариантов

Функция ПрочитатьВарианты(Аргументы)
	
	Ответ = Новый Структура("success", Ложь);
	
	ИдентификаторНаборов = СокрЛП(Строка(Аргумент(Аргументы, "sets_id", "")));
	ИдентификаторЗапроса = СокрЛП(Строка(Аргумент(Аргументы, "request_id", "")));
	Предел = ПределСтрок(Аргумент(Аргументы, "limit"));
	ЗначениеСРезультатами = Аргумент(Аргументы, "with_results", Истина);
	СРезультатами = Не (ЗначениеСРезультатами = Ложь Или НРег(СокрЛП(Строка(ЗначениеСРезультатами))) = "false");
	ОшибкаИмен = "";
	Имена = ИменаСтрокИзАргумента(Аргумент(Аргументы, "names"), ОшибкаИмен);
	
	Если ЗначениеЗаполнено(ОшибкаИмен) Тогда
		Ответ.Вставить("error", "Ошибка в names: " + ОшибкаИмен);
	Иначе
		Наборы = ЗапросыMCPСервер_Ei.НаборыДляЧтения(ИдентификаторНаборов, Имена.Количество() > 0);
		Если ЗначениеЗаполнено(Наборы.Ошибка) Тогда
			Ответ.Вставить("error", Наборы.Ошибка);
		Иначе
			Описание = ОписаниеЗапросаЧтения(ИдентификаторНаборов, Имена, Наборы, СРезультатами, Предел);
			ПрочитатьЧерезАгента(Описание, ИдентификаторЗапроса, Ответ);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Запрос клиентскому агенту на чтение строк, см. ЗапросыMCPСервер_Ei.ЗапроситьРешение
//
// Параметры:
//  ИдентификаторНаборов - Строка - sets_id или пустая строка
//  Имена - Массив из Строка - отбор по именам строк
//  Наборы - Структура - где и какие строки читать, см. ЗапросыMCPСервер_Ei.НаборыДляЧтения
//  СРезультатами - Булево - читать результаты последнего выполнения вариантов
//  Предел - Число - сколько строк таблицы или элементов массива результата вернуть
//
// Возвращаемое значение:
//  Структура - описание запроса для ЗапросыMCPСервер_Ei.ЗапроситьРешение
//
Функция ОписаниеЗапросаЧтения(ИдентификаторНаборов, Имена, Наборы, СРезультатами, Предел)
	
	НомераСеансов = Новый Массив; // Массив из Число
	НомераСеансов.Добавить(Наборы.НомерСеанса);
	
	ЧастиХеша = Новый Массив; // Массив из Строка
	ЧастиХеша.Добавить(ИдентификаторНаборов);
	ЧастиХеша.Добавить(СтрСоединить(Имена, ","));
	ЧастиХеша.Добавить(Формат(СРезультатами, "БЛ=false; БИ=true"));
	ЧастиХеша.Добавить(Формат(Предел, "ЧГ=0"));
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("ИдентификаторНаборов", ИдентификаторНаборов);
	ДанныеЗапроса.Вставить("Имена", Имена);
	ДанныеЗапроса.Вставить("КлючиСтрок", Наборы.КлючиСтрок);
	ДанныеЗапроса.Вставить("СРезультатами", СРезультатами);
	ДанныеЗапроса.Вставить("Предел", Предел);
	
	Описание = Новый Структура;
	Описание.Вставить("Код", "");
	Описание.Вставить("Контекст", ЗапросыMCPСервер_Ei.КонтекстЧтенияНаборов());
	Описание.Вставить("Режим", "");
	Описание.Вставить("Параметры", Новый Структура);
	Описание.Вставить("ОпасныеКонструкции", Новый Массив);
	Описание.Вставить("Хеш", ЗапросыMCPСервер_Ei.Хеш(СтрСоединить(ЧастиХеша, Символы.ПС)));
	Описание.Вставить("НомераСеансов", НомераСеансов);
	Описание.Вставить("ДанныеЗапроса", ДанныеЗапроса);
	
	Возврат Описание;
	
КонецФункции

// Отправляет запрос чтения клиентскому агенту и заполняет ответ по его результату.
//
// Параметры:
//  Описание - см. ОписаниеЗапросаЧтения
//  ИдентификаторЗапроса - Строка - request_id прежнего вызова со status=pending
//  Ответ - Структура - дополняется полями ответа
//
Процедура ПрочитатьЧерезАгента(Описание, ИдентификаторЗапроса, Ответ)
	
	Попытка
		Решение = ЗапросыMCPСервер_Ei.ЗапроситьРешение(Описание, ИдентификаторЗапроса);
	Исключение
		Ответ.Вставить("error", "Ошибка обмена с клиентским агентом Ei: "
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Если Решение.Статус = "error" Тогда
		Ответ.Вставить("error", Решение.Ошибка);
	ИначеЕсли Решение.Статус = "pending" Тогда
		Ответ.Вставить("status", "pending");
		Ответ.Вставить("request_id", Решение.Идентификатор);
		Ответ.Вставить("message",
			"Клиент 1С еще не ответил. Повторите get_variants с теми же sets_id, names и request_id=" + Решение.Идентификатор + ".");
	Иначе
		РешениеАгента = Решение.Ответ;
		Ответ.Вставить("request_id", Решение.Идентификатор);
		Если РешениеАгента.Решение = "Выполнено" И ТипЗнч(РешениеАгента.Успех) = Тип("Булево") И РешениеАгента.Успех Тогда
			ЗаполнитьОтветЧтения(РешениеАгента.Результат, Ответ);
		ИначеЕсли РешениеАгента.Решение = "Выполнено" Тогда
			Ответ.Вставить("error", РешениеАгента.Ошибка);
		Иначе
			Ответ.Вставить("error", "Клиент 1С отклонил чтение наборов");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Строки, прочитанные агентом, в формате JSON: имена вариантов Ei становятся свойствами query, algorithm и т.д.,
// параметры - значениями в формате parameters.
//
// Параметры:
//  Результат - Структура - результат чтения клиентским агентом ЗапросыMCPКлиент_Ei: Строки, НеНайдены, Удалено
//  Ответ - Структура
//
Процедура ЗаполнитьОтветЧтения(Результат, Ответ)
	
	КлючиВариантов = Новый Соответствие; // имя варианта Ei - свойство JSON
	Для Каждого ОписаниеВарианта Из ВариантыНабора() Цикл
		КлючиВариантов.Вставить(ОписаниеВарианта.Значение.Имя, ОписаниеВарианта.Ключ);
	КонецЦикла;
	
	Строки = Новый Массив; // Массив из Структура
	Для Каждого ОписаниеСтроки Из Результат.Строки Цикл
		СтрокаJSON = Новый Структура;
		СтрокаJSON.Вставить("name", ОписаниеСтроки.Имя);
		СтрокаJSON.Вставить("path", ОписаниеСтроки.Путь);
		Для Каждого ЭлементВарианта Из ОписаниеСтроки.Варианты Цикл
			КлючВарианта = КлючиВариантов.Получить(ЭлементВарианта.Ключ);
			Если КлючВарианта <> Неопределено Тогда
				СтрокаJSON.Вставить(КлючВарианта, ЗначениеВариантаВJSON(ЭлементВарианта.Ключ, ЭлементВарианта.Значение));
			КонецЕсли;
		КонецЦикла;
		Параметры = Новый Структура;
		Для Каждого ЭлементПараметра Из ОписаниеСтроки.Параметры Цикл
			Параметры.Вставить(ЭлементПараметра.Ключ, ПараметрВJSON(ЭлементПараметра.Значение));
		КонецЦикла;
		СтрокаJSON.Вставить("parameters", Параметры);
		ТекущийВариант = КлючиВариантов.Получить(ОписаниеСтроки.ТекущийВариант);
		Если ТекущийВариант <> Неопределено Тогда
			СтрокаJSON.Вставить("active_variant", ТекущийВариант);
		КонецЕсли;
		Результаты = Неопределено;
		Если ОписаниеСтроки.Свойство("Результаты", Результаты) И Результаты.Количество() > 0 Тогда
			СтрокаJSON.Вставить("results", РезультатыВJSON(Результаты, КлючиВариантов));
		КонецЕсли;
		Строки.Добавить(СтрокаJSON);
	КонецЦикла;
	
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("rows", Строки);
	Если Результат.НеНайдены.Количество() > 0 Тогда
		Ответ.Вставить("not_found", Результат.НеНайдены);
	КонецЕсли;
	Если Результат.Удалено > 0 Тогда
		Ответ.Вставить("deleted_rows", Результат.Удалено);
	КонецЕсли;
	
КонецПроцедуры

// Значение варианта строки для ответа get_variants: коллекция - таблицей в формате _table, как ее принимает create_variants,
// остальные варианты - текстом как есть.
//
// Параметры:
//  ИмяВарианта - Строка - имя варианта Ei
//  Значение - Строка - текст варианта из строки набора, у коллекции - XML таблицы значений
//
// Возвращаемое значение:
//  Строка, Структура
//
Функция ЗначениеВариантаВJSON(ИмяВарианта, Значение)
	
	Результат = Значение;
	Если ИмяВарианта = ВариантКоллекцияКлиентСервер_Ei.Свойства().Имя Тогда
		Коллекция = ОбщегоНазначенияКлиентСервер_Ei.ПопыткаСтруктурировать(Значение);
		Если ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
			Результат = ТаблицаВФорматеПараметров(Коллекция);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Результаты последнего выполнения вариантов строки: по свойству варианта (query, algorithm, dcs)
// либо ошибка, либо данные, обрезанные клиентским агентом до limit.
//
// Параметры:
//  Результаты - Структура - по имени варианта Ei: Ошибка, Значение, ТипРезультата, Всего, Обрезано,
//   см. ЗапросыMCPВызовСервера_Ei.ЗаписатьОтветЧтения
//  КлючиВариантов - Соответствие из Строка - свойство JSON по имени варианта Ei
//
// Возвращаемое значение:
//  Структура
//
Функция РезультатыВJSON(Результаты, КлючиВариантов)
	
	РезультатыJSON = Новый Структура;
	Для Каждого ЭлементРезультата Из Результаты Цикл
		КлючВарианта = КлючиВариантов.Получить(ЭлементРезультата.Ключ);
		Если КлючВарианта = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		РезультатВарианта = ЭлементРезультата.Значение;
		РезультатJSON = Новый Структура;
		Если ЗначениеЗаполнено(РезультатВарианта.Ошибка) Тогда
			РезультатJSON.Вставить("error", РезультатВарианта.Ошибка);
		Иначе
			РезультатJSON.Вставить("result_type", РезультатВарианта.ТипРезультата);
			РезультатJSON.Вставить("data", РезультатВарианта.Значение);
			Если РезультатВарианта.Всего <> Неопределено Тогда
				РезультатJSON.Вставить("total", РезультатВарианта.Всего);
				РезультатJSON.Вставить("truncated", РезультатВарианта.Обрезано);
			КонецЕсли;
		КонецЕсли;
		РезультатыJSON.Вставить(КлючВарианта, РезультатJSON);
	КонецЦикла;
	
	Возврат РезультатыJSON;
	
КонецФункции

// Параметр строки Ei в формате parameters, обратное см. ПараметрНабора
//
// Параметры:
//  Параметр - Структура:
//   * ЭтоВыражение - Булево
//   * ЗначениеПараметра - Произвольный - выражение, простое значение или XML сложного значения
//
// Возвращаемое значение:
//  Произвольный
//
Функция ПараметрВJSON(Параметр)
	
	Если Параметр.ЭтоВыражение Тогда
		Результат = Новый Структура("_expression", Строка(Параметр.ЗначениеПараметра));
	Иначе
		Результат = ЗначениеВФорматеПараметров(ОбщегоНазначенияКлиентСервер_Ei.ПопыткаСтруктурировать(Параметр.ЗначениеПараметра));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Значение в формате parameters: даты, типы и таблицы - служебными объектами, которые понимает ЗначениеИзJSON.
// Ссылки записывает ПреобразованиеJSON описаниями _objectRef.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Произвольный
//
Функция ЗначениеВФорматеПараметров(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Дата") Тогда
		Результат = Новый Структура("_date", ЗаписатьДатуJSON(Значение, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДата));
	ИначеЕсли ТипЗначения = Тип("Тип") Тогда
		Результат = Новый Структура("_type", ПредставлениеТипа(Значение));
	ИначеЕсли ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Результат = Новый Структура("_table", ТаблицаВФорматеПараметров(Значение));
	ИначеЕсли ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ЗначениеВФорматеПараметров(Элемент));
		КонецЦикла;
	ИначеЕсли ТипЗначения = Тип("СписокЗначений") Тогда
		//массивом, как его передают в create_variants, см. ПараметрНабора
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ЗначениеВФорматеПараметров(Элемент.Значение));
		КонецЦикла;
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого КлючИЗначение Из Значение Цикл
			Результат.Вставить(КлючИЗначение.Ключ, ЗначениеВФорматеПараметров(КлючИЗначение.Значение));
		КонецЦикла;
	Иначе
		Результат = Значение;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Таблица значений в формате _table: колонки с типом, если он у колонки один, и строки объектами.
//
// Параметры:
//  Таблица - ТаблицаЗначений
//
// Возвращаемое значение:
//  Структура:
//   * columns - Массив из Структура - name и, если тип один, type
//   * rows - Массив из Структура
//
Функция ТаблицаВФорматеПараметров(Таблица)
	
	Колонки = Новый Массив; // Массив из Структура
	Для Каждого Колонка Из Таблица.Колонки Цикл
		ОписаниеКолонки = Новый Структура("name", Колонка.Имя);
		Типы = Колонка.ТипЗначения.Типы();
		Если Типы.Количество() = 1 Тогда
			Для Каждого ТипКолонки Из Типы Цикл
				ОписаниеКолонки.Вставить("type", ПредставлениеТипа(ТипКолонки));
			КонецЦикла;
		КонецЕсли;
		Колонки.Добавить(ОписаниеКолонки);
	КонецЦикла;
	
	Возврат Новый Структура("columns, rows", Колонки, ТаблицаВМассив(Таблица));
	
КонецФункции

// Имена строк из names: массив строк, JSON-массив строкой или имена через запятую.
//
// Параметры:
//  Значение - Произвольный
//  Ошибка - Строка - заполняется, если names не разобраны
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ИменаСтрокИзАргумента(Знач Значение, Ошибка)
	
	Имена = Новый Массив; // Массив из Строка
	Если ТипЗнч(Значение) = Тип("Строка") И СтрНачинаетсяС(СокрЛП(Значение), "[") Тогда
		Значение = ЗначениеИзСтрокиJSON(Значение, Ошибка);
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Значение = СтрРазделить(Значение, ",", Ложь);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ошибка) И Значение <> Неопределено И ТипЗнч(Значение) <> Тип("Массив") Тогда
		Ошибка = "ожидается массив имен строк";
	ИначеЕсли Не ЗначениеЗаполнено(Ошибка) И Значение <> Неопределено Тогда
		Для Каждого Имя Из Значение Цикл
			Если ТипЗнч(Имя) <> Тип("Строка") Или Не ЗначениеЗаполнено(СокрЛП(Имя)) Тогда
				Ошибка = "имя строки должно быть непустой строкой";
				Прервать;
			КонецЕсли;
			Имена.Добавить(СокрЛП(Имя));
		КонецЦикла;
	КонецЕсли;
	
	Возврат Имена;
	
КонецФункции

#КонецОбласти

#Область ЖурналИИстория

// Начинает выполнение инструмента: временный набор с параметрами, корневой замер журнала выполнения
// и запуск в истории Ei с тем же идентификатором.
//
// Параметры:
//  ИмяВарианта - Строка - Алгоритм или Запрос
//  Инструкция - Строка - код или текст запроса
//  ПараметрыНабора - Структура
//  Операция - Строка - заголовок замера
//
// Возвращаемое значение:
//  Структура:
//   * Запуск - см. ИсторияКлиентСервер_Ei.НовыйЗапуск
//   * Замер - см. ЖурналКлиентСервер_Ei.НачатьЗамер
//   * Набор - см. ЗапросыMCPВызовСервера_Ei.НачатьНаборЗапроса
//
Функция НачатьВыполнение(ИмяВарианта, Инструкция, ПараметрыНабора, Операция)
	
	ПолучитьСообщенияПользователю(Истина);
	
	КлючНабора = ЗапросыMCPВызовСервера_Ei.КлючНабораЗапроса();
	ИдЗапуска = Строка(Новый УникальныйИдентификатор);
	Запуск = ИсторияКлиентСервер_Ei.НовыйЗапуск(ИдЗапуска, ИсторияКлиентСервер_Ei.КлючВарианта(КлючНабора, ИмяВарианта),
		ИмяВарианта, Инструкция);
	Запуск.Параметры = ИменаПараметров(ПараметрыНабора);
	
	Замер = ЖурналКлиентСервер_Ei.НачатьЗамер(Операция + Символы.ПС + Инструкция,
		ЖурналКлиентСервер_Ei.ТипыОпераций().Конструктор, , Ложь, ИдЗапуска, "");
	Замер.Контекст = Новый Структура("КлючСтроки, Вариант, Запуск", Строка(КлючНабора), ИмяВарианта, ИдЗапуска);
	
	Инструкции = Новый Структура;
	Инструкции.Вставить(ИмяВарианта, Инструкция);
	Набор = ЗапросыMCPВызовСервера_Ei.НачатьНаборЗапроса(ПараметрыНабора, Инструкции);
	// Параметры, вычисленные при выполнении, попадают в историю внутри этого запуска
	НаборВариантовВызовСервера_Ei.Обновить(НаборВариантовВызовСервера_Ei.Получить(), ИдЗапуска);
	
	Возврат Новый Структура("Запуск, Замер, Набор", Запуск, Замер, Набор);
	
КонецФункции

// Завершает замер и запуск, возвращает набор, дополняет ответ сообщениями и идентификатором запуска.
// Ошибки журнала и истории не должны испортить ответ модели.
//
// Параметры:
//  Выполнение - см. НачатьВыполнение
//  ОписаниеЗначения - Произвольный
//  ИнформацияОбОшибке - ИнформацияОбОшибке, Неопределено
//  Ответ - Структура
//
Процедура ЗавершитьВыполнение(Выполнение, ОписаниеЗначения, ИнформацияОбОшибке, Ответ)
	
	Запуск = Выполнение.Запуск;
	Запуск.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Запуск.Начало;
	Если ИнформацияОбОшибке <> Неопределено Тогда
		Запуск.Статус = ИсторияКлиентСервер_Ei.СтатусыЗапуска().Ошибка;
		Запуск.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	КонецЕсли;
	
	Попытка
		ЖурналКлиентСервер_Ei.ЗавершитьЗамер(Выполнение.Замер, , ?(ИнформацияОбОшибке = Неопределено, "", ИнформацияОбОшибке));
		ИсторияВызовСервера_Ei.ЗавершитьЗапускВарианта(Запуск, ОписаниеЗначения);
	Исключение
		ЗаписьЖурналаРегистрации(ЖурналКлиентСервер_Ei.ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			"MCP: запуск не записан в журнал или историю Ei" + Символы.ПС
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	ЗапросыMCPВызовСервера_Ei.ЗавершитьНаборЗапроса(Выполнение.Набор);
	
	Сообщения = Новый Массив; // Массив из Строка
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Сообщения.Добавить(Сообщение.Текст);
	КонецЦикла;
	Если Сообщения.Количество() > 0 Тогда
		Ответ.Вставить("messages", Сообщения);
	КонецЕсли;
	Ответ.Вставить("run_id", Запуск.Ид);
	
КонецПроцедуры

#КонецОбласти

#Область Параметры

// Превращает parameters из JSON в параметры временного набора Ei.
// Сложные значения хранятся XML-строкой: снимок наборов лежит в параметре сеанса,
// а Ei восстанавливает такие значения при вычислении, см. ОбщегоНазначенияКлиентСервер_Ei.ПопыткаСтруктурировать
//
// Параметры:
//  ПараметрыJSON - Структура, Строка, Неопределено - объект или его JSON строкой: так его передают некоторые клиенты
//  Ошибка - Строка - заполняется, если параметры не разобраны
//  МассивВСписок - Булево - массив верхнего уровня передать списком значений: его видно в параметрах строки Ei,
//                  для строк create_variants
//
// Возвращаемое значение:
//  Структура - см. ЗапросыMCPВызовСервера_Ei.НачатьНаборЗапроса
//
Функция ПараметрыНабораИзJSON(Знач ПараметрыJSON, Ошибка, МассивВСписок = Ложь)
	
	ПараметрыНабора = Новый Структура;
	
	Если ТипЗнч(ПараметрыJSON) = Тип("Строка") И ЗначениеЗаполнено(СокрЛП(ПараметрыJSON)) Тогда
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ПараметрыJSON);
		Попытка
			ПараметрыJSON = ПрочитатьJSON(ЧтениеJSON);
		Исключение
			Ошибка = "строка parameters - не JSON-объект с именами-идентификаторами: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		ЧтениеJSON.Закрыть();
	ИначеЕсли ТипЗнч(ПараметрыJSON) = Тип("Строка") Тогда
		ПараметрыJSON = Неопределено;
	КонецЕсли;
	
	Разбирать = Не ЗначениеЗаполнено(Ошибка) И ПараметрыJSON <> Неопределено;
	Если Разбирать И ТипЗнч(ПараметрыJSON) <> Тип("Структура") Тогда
		Ошибка = "ожидается объект {имя: значение}, получено: " + Строка(ТипЗнч(ПараметрыJSON));
	ИначеЕсли Разбирать Тогда
		Для Каждого ЭлементПараметра Из ПараметрыJSON Цикл
			Попытка
				ПараметрыНабора.Вставить(ЭлементПараметра.Ключ, ПараметрНабора(ЭлементПараметра.Значение, МассивВСписок));
			Исключение
				Ошибка = СтрШаблон("%1: %2", ЭлементПараметра.Ключ, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Прервать;
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ПараметрыНабора;
	
КонецФункции

Функция ПараметрНабора(ЗначениеJSON, МассивВСписок)
	
	Выражение = Неопределено;
	Если ТипЗнч(ЗначениеJSON) = Тип("Структура") И ЗначениеJSON.Свойство("_expression", Выражение) Тогда
		Параметр = Новый Структура("ЭтоВыражение, ЗначениеПараметра", Истина, Строка(Выражение));
	Иначе
		Значение = ЗначениеИзJSON(ЗначениеJSON);
		Если МассивВСписок И ТипЗнч(Значение) = Тип("Массив") Тогда
			//список значений форма Ei хранит как есть, см. ЗапросыMCPКлиент_Ei.ЗначениеПараметраСтроки
			Список = Новый СписокЗначений;
			Список.ЗагрузитьЗначения(Значение);
			Значение = Список;
		КонецЕсли;
		Если Не ЭтоПростоеЗначение(Значение) Тогда
			Значение = ОбщегоНазначенияКлиентСервер_Ei.Сериализовать(Значение);
		КонецЕсли;
		Параметр = Новый Структура("ЭтоВыражение, ЗначениеПараметра", Ложь, Значение);
	КонецЕсли;
	
	Возврат Параметр;
	
КонецФункции

// Значение, которое можно хранить в снимке наборов и в форме Ei как есть.
Функция ЭтоПростоеЗначение(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Возврат Значение = Неопределено Или Значение = Null
		Или ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Или ТипЗначения = Тип("Дата")
		Или ЭтоСсылка(Значение);
	
КонецФункции

Функция ВыраженияПараметров(ПараметрыНабора)
	
	Выражения = Новый Массив; // Массив из Строка
	Для Каждого ЭлементПараметра Из ПараметрыНабора Цикл
		Если ЭлементПараметра.Значение.ЭтоВыражение Тогда
			Выражения.Добавить(ЭлементПараметра.Значение.ЗначениеПараметра);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Выражения;
	
КонецФункции

Функция ИменаПараметров(ПараметрыНабора)
	
	Имена = Новый Массив; // Массив из Строка
	Для Каждого ЭлементПараметра Из ПараметрыНабора Цикл
		Имена.Добавить(ЭлементПараметра.Ключ);
	КонецЦикла;
	
	Возврат Имена;
	
КонецФункции

// Значение 1С из значения JSON со служебными полями _objectRef, _date, _type, _table.
//
// Параметры:
//  ЗначениеJSON - Произвольный - Структура, Массив или примитивное значение
//
// Возвращаемое значение:
//  Произвольный
//
Функция ЗначениеИзJSON(ЗначениеJSON)
	
	Значение = ЗначениеJSON;
	ЗначениеСвойства = Неопределено;
	
	Если ТипЗнч(ЗначениеJSON) = Тип("Массив") Тогда
		Значение = Новый Массив;
		Для Каждого Элемент Из ЗначениеJSON Цикл
			Значение.Добавить(ЗначениеИзJSON(Элемент));
		КонецЦикла;
	ИначеЕсли ТипЗнч(ЗначениеJSON) <> Тип("Структура") Тогда
		Значение = ЗначениеJSON;
	ИначеЕсли ЗначениеJSON.Свойство("_objectRef") Тогда
		Значение = СсылкаПоОписанию(ЗначениеJSON);
	ИначеЕсли ЗначениеJSON.Свойство("_recordKey") Тогда
		Значение = КлючЗаписиПоОписанию(ЗначениеJSON);
	ИначеЕсли ЗначениеJSON.Свойство("_date", ЗначениеСвойства) Тогда
		Значение = ДатаИзСтроки(ЗначениеСвойства);
	ИначеЕсли ЗначениеJSON.Свойство("_type", ЗначениеСвойства) Тогда
		Значение = Тип(ЗначениеСвойства);
	ИначеЕсли ЗначениеJSON.Свойство("_table", ЗначениеСвойства) Тогда
		Значение = ТаблицаИзJSON(ЗначениеСвойства);
	ИначеЕсли ЗначениеJSON.Свойство("_expression") Тогда
		ВызватьИсключение "_expression допустимо только как значение параметра верхнего уровня";
	Иначе
		Значение = Новый Структура;
		Для Каждого ЭлементСтруктуры Из ЗначениеJSON Цикл
			Значение.Вставить(ЭлементСтруктуры.Ключ, ЗначениеИзJSON(ЭлементСтруктуры.Значение));
		КонецЦикла;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Таблица значений из {columns, rows} или массива строк-объектов.
// Тип колонки без явного type выводится по значениям: таблица в параметре запроса должна быть типизирована.
//
// Параметры:
//  ОписаниеТаблицы - Структура, Массив
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция ТаблицаИзJSON(ОписаниеТаблицы)
	
	КолонкиJSON = Неопределено;
	СтрокиJSON = Неопределено;
	Если ТипЗнч(ОписаниеТаблицы) = Тип("Массив") Тогда
		СтрокиJSON = ОписаниеТаблицы;
	ИначеЕсли ТипЗнч(ОписаниеТаблицы) = Тип("Структура") Тогда
		ОписаниеТаблицы.Свойство("columns", КолонкиJSON);
		ОписаниеТаблицы.Свойство("rows", СтрокиJSON);
	Иначе
		ВызватьИсключение "_table: ожидается {columns, rows} или массив строк";
	КонецЕсли;
	Если ТипЗнч(СтрокиJSON) <> Тип("Массив") Тогда
		СтрокиJSON = Новый Массив;
	КонецЕсли;
	
	Колонки = КолонкиТаблицы(КолонкиJSON, СтрокиJSON);
	
	ЗначенияСтрок = Новый Массив; // Массив из Массив
	Для Каждого СтрокаJSON Из СтрокиJSON Цикл
		Значения = Новый Массив;
		Для Индекс = 0 По Колонки.ВГраница() Цикл
			ЗначениеЯчейки = Неопределено;
			Если ТипЗнч(СтрокаJSON) = Тип("Структура") Тогда
				СтрокаJSON.Свойство(Колонки[Индекс].Имя, ЗначениеЯчейки);
			ИначеЕсли ТипЗнч(СтрокаJSON) = Тип("Массив") И Индекс <= СтрокаJSON.ВГраница() Тогда
				ЗначениеЯчейки = СтрокаJSON[Индекс];
			КонецЕсли;
			Значения.Добавить(ЗначениеЯчейки(ЗначениеЯчейки, Колонки[Индекс].ТипЗначения));
		КонецЦикла;
		ЗначенияСтрок.Добавить(Значения);
	КонецЦикла;
	
	Таблица = Новый ТаблицаЗначений;
	Для Индекс = 0 По Колонки.ВГраница() Цикл
		ТипЗначения = Колонки[Индекс].ТипЗначения;
		Если ТипЗначения = Неопределено Тогда
			ТипЗначения = ВыведенныйТип(ЗначенияСтрок, Индекс);
		КонецЕсли;
		Таблица.Колонки.Добавить(Колонки[Индекс].Имя, ТипЗначения);
	КонецЦикла;
	
	Для Каждого Значения Из ЗначенияСтрок Цикл
		НоваяСтрока = Таблица.Добавить();
		Для Индекс = 0 По Колонки.ВГраница() Цикл
			НоваяСтрока[Индекс] = Значения[Индекс];
		КонецЦикла;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

// Параметры:
//  КолонкиJSON - Массив, Неопределено - имена колонок или {name, type}
//  СтрокиJSON - Массив - без колонок имена берутся из первой строки-объекта
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Имя - Строка
//   * ТипЗначения - ОписаниеТипов, Неопределено - Неопределено, если тип выводится по значениям
//
Функция КолонкиТаблицы(КолонкиJSON, СтрокиJSON)
	
	Колонки = Новый Массив; // Массив из Структура
	Если ТипЗнч(КолонкиJSON) = Тип("Массив") Тогда
		Для Каждого КолонкаJSON Из КолонкиJSON Цикл
			Колонка = Новый Структура("Имя, ТипЗначения", "", Неопределено);
			ИмяКолонки = "";
			ТипКолонки = Неопределено;
			Если ТипЗнч(КолонкаJSON) = Тип("Структура") Тогда
				КолонкаJSON.Свойство("name", ИмяКолонки);
				КолонкаJSON.Свойство("type", ТипКолонки);
			Иначе
				ИмяКолонки = КолонкаJSON;
			КонецЕсли;
			Колонка.Имя = СокрЛП(Строка(ИмяКолонки));
			Если Не ЗначениеЗаполнено(Колонка.Имя) Тогда
				ВызватьИсключение "_table: у колонки не задано имя";
			КонецЕсли;
			Если ЗначениеЗаполнено(ТипКолонки) Тогда
				Колонка.ТипЗначения = Новый ОписаниеТипов(Строка(ТипКолонки));
				Если Колонка.ТипЗначения.Типы().Количество() = 0 Тогда
					ВызватьИсключение СтрШаблон("_table: неизвестный тип колонки %1: %2", Колонка.Имя, ТипКолонки);
				КонецЕсли;
			КонецЕсли;
			Колонки.Добавить(Колонка);
		КонецЦикла;
	ИначеЕсли СтрокиJSON.Количество() > 0 И ТипЗнч(СтрокиJSON[0]) = Тип("Структура") Тогда
		Для Каждого ЭлементСтроки Из СтрокиJSON[0] Цикл
			Колонки.Добавить(Новый Структура("Имя, ТипЗначения", ЭлементСтроки.Ключ, Неопределено));
		КонецЦикла;
	Иначе
		ВызватьИсключение "_table: укажите columns или передайте строки объектами";
	КонецЕсли;
	
	Возврат Колонки;
	
КонецФункции

// Значение ячейки с учетом типа колонки: строка в ссылочной колонке - uuid или имя, в колонке даты - дата.
Функция ЗначениеЯчейки(ЗначениеJSON, ТипКолонки)
	
	Значение = ЗначениеИзJSON(ЗначениеJSON);
	
	// Строка остается строкой, если тип колонки не задан или допускает строки
	Преобразовать = ТипКолонки <> Неопределено И ТипЗнч(Значение) = Тип("Строка") И Не ТипКолонки.СодержитТип(Тип("Строка"));
	
	Если Преобразовать И ТипКолонки.СодержитТип(Тип("Дата")) Тогда
		Значение = ДатаИзСтроки(Значение);
	ИначеЕсли Преобразовать Тогда
		Для Каждого ТипСсылки Из ТипКолонки.Типы() Цикл
			Если ЭтоТипСсылки(ТипСсылки) Тогда
				Значение = СсылкаПоИдентификатору(ТипСсылки, Значение);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Описание типов колонки по ее значениям; строка - с длиной самого длинного значения.
//
// Параметры:
//  ЗначенияСтрок - Массив из Массив
//  Индекс - Число - индекс колонки
//
// Возвращаемое значение:
//  ОписаниеТипов
//
Функция ВыведенныйТип(ЗначенияСтрок, Индекс)
	
	Типы = Новый Массив; // Массив из Тип
	ДлинаСтроки = 1;
	Для Каждого Значения Из ЗначенияСтрок Цикл
		Значение = Значения[Индекс];
		Если Значение = Неопределено Или Значение = Null Тогда
			Продолжить;
		КонецЕсли;
		Если Типы.Найти(ТипЗнч(Значение)) = Неопределено Тогда
			Типы.Добавить(ТипЗнч(Значение));
		КонецЕсли;
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			ДлинаСтроки = Макс(ДлинаСтроки, СтрДлина(Значение));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый ОписаниеТипов(Типы, , Новый КвалификаторыСтроки(ДлинаСтроки));
	
КонецФункции

Функция ДатаИзСтроки(Знач СтрокаДаты)
	
	СтрокаДаты = СокрЛП(Строка(СтрокаДаты));
	Если СтрДлина(СтрокаДаты) = 10 Тогда
		СтрокаДаты = СтрокаДаты + "T00:00:00";
	КонецЕсли;
	Попытка
		Значение = XMLЗначение(Тип("Дата"), СтрокаДаты);
	Исключение
		ВызватьИсключение СтрШаблон("неверная дата ""%1"", ожидается ГГГГ-ММ-ДД или ГГГГ-ММ-ДДTчч:мм:сс", СтрокаДаты);
	КонецПопытки;
	
	Возврат Значение;
	
КонецФункции

#КонецОбласти

#Область НавигационныеСсылки

// Ответ, как у одноименного инструмента MCP: success, object или message, и дополнительно exists.
Функция РазобратьНавСсылку(Аргументы)

	Ответ = Новый Структура("success", Ложь);

	НавСсылка = СокрЛП(Строка(Аргумент(Аргументы, "navLink", "")));
	Если Не ЗначениеЗаполнено(НавСсылка) Тогда
		Ответ.Вставить("message", "Параметр navLink обязателен и не может быть пустым");
		Возврат Ответ;
	КонецЕсли;

	Попытка
		Значение = ОбщегоНазначения_Ei.ЗначениеПоНавСсылке(НавСсылка);
	Исключение
		Ответ.Вставить("message", "Не удалось разобрать навигационную ссылку: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ответ;
	КонецПопытки;

	Ответ.Вставить("success", Истина);
	// Ключ записи ЗаписатьJSON переводит в описание, см. ПреобразованиеJSON; ссылка описывается сразу: пустую там заменяет null
	Ответ.Вставить("object", ?(ЭтоСсылка(Значение), ОписаниеОбъектаПоСсылке(Значение), Значение));
	Существует = ЗначениеСуществует(Значение);
	Если Существует <> Неопределено Тогда
		Ответ.Вставить("exists", Существует);
	КонецЕсли;

	Возврат Ответ;

КонецФункции

Функция ПолучитьНавСсылку(Аргументы)

	Ответ = Новый Структура("success", Ложь);

	ОшибкаJSON = "";
	Описание = ЗначениеИзСтрокиJSON(Аргумент(Аргументы, "objectDescription"), ОшибкаJSON);

	Если ТипЗнч(Описание) <> Тип("Структура") Или Не (Описание.Свойство("_objectRef") Или Описание.Свойство("_recordKey")) Тогда
		Ответ.Вставить("message", "objectDescription: ожидается описание _objectRef из execute_query или _recordKey из parse_nav_link");
		Возврат Ответ;
	КонецЕсли;

	Попытка
		Значение = ЗначениеИзJSON(Описание);
		НавСсылка = ПолучитьНавигационнуюСсылку(Значение);
	Исключение
		Ответ.Вставить("message", ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ответ;
	КонецПопытки;

	Ответ.Вставить("success", Истина);
	Ответ.Вставить("navLink", НавСсылка);

	Возврат Ответ;

КонецФункции

// Есть ли в базе объект по ссылке или запись по ключу.
//
// Параметры:
//  Значение - Произвольный - ссылка или ключ записи регистра сведений
//
// Возвращаемое значение:
//  Булево, Неопределено - Неопределено для таблицы внешнего источника: проверка обращалась бы к источнику
//
Функция ЗначениеСуществует(Значение)

	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Значение));

	Если ЭтоКлючЗаписи(Значение) Тогда
		Набор = РегистрыСведений[ОбъектМетаданных.Имя].СоздатьНаборЗаписей();
		Для Каждого ПолеКлюча Из ПоляКлючаЗаписи(Значение) Цикл
			Набор.Отбор[ПолеКлюча.Ключ].Установить(ПолеКлюча.Значение);
		КонецЦикла;
		Набор.Прочитать();
		Возврат Набор.Количество() > 0;
	КонецЕсли;

	Если СтрРазделить(ОбъектМетаданных.ПолноеИмя(), ".").Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ 1 ИСТИНА КАК Есть ИЗ %1 ГДЕ Ссылка = &Ссылка", ОбъектМетаданных.ПолноеИмя()));
	Запрос.УстановитьПараметр("Ссылка", Значение);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти

#Область Ссылки

// Ключ записи регистра сведений по описанию {_recordKey, ТипОбъекта, Значения}, см. ОписаниеКлючаЗаписи
// Значение измерения - в формате parameters, ссылочное можно uuid, период и дату - строкой даты.
Функция КлючЗаписиПоОписанию(Описание)

	ИмяРегистра = "";
	ЗначенияJSON = Неопределено;
	Описание.Свойство("ТипОбъекта", ИмяРегистра);
	Описание.Свойство("Значения", ЗначенияJSON);

	ОбъектМетаданных = ?(ЗначениеЗаполнено(ИмяРегистра), Метаданные.НайтиПоПолномуИмени(ИмяРегистра), Неопределено);
	Если ОбъектМетаданных = Неопределено Или Не Метаданные.РегистрыСведений.Содержит(ОбъектМетаданных) Тогда
		ВызватьИсключение СтрШаблон("_recordKey: ТипОбъекта ""%1"" - не регистр сведений, ожидается РегистрСведений.Имя", ИмяРегистра);
	КонецЕсли;

	ЗначенияКлюча = Новый Структура;
	Если ТипЗнч(ЗначенияJSON) = Тип("Структура") Тогда
		Для Каждого ПолеJSON Из ЗначенияJSON Цикл
			Измерение = ОбъектМетаданных.Измерения.Найти(ПолеJSON.Ключ);
			Если Измерение <> Неопределено Тогда
				ТипПоля = Измерение.Тип;
			ИначеЕсли ПолеJSON.Ключ = "Период" Тогда
				ТипПоля = Новый ОписаниеТипов("Дата");
			Иначе
				ВызватьИсключение СтрШаблон("_recordKey: у регистра %1 нет измерения %2", ИмяРегистра, ПолеJSON.Ключ);
			КонецЕсли;
			ЗначенияКлюча.Вставить(ПолеJSON.Ключ, ЗначениеЯчейки(ПолеJSON.Значение, ТипПоля));
		КонецЦикла;
	КонецЕсли;

	Возврат РегистрыСведений[ОбъектМетаданных.Имя].СоздатьКлючЗаписи(ЗначенияКлюча);

КонецФункции

// Ссылка по описанию {_objectRef, УникальныйИдентификатор, ТипОбъекта}, как в ответах execute_query.
Функция СсылкаПоОписанию(Описание)
	
	ИмяТипа = "";
	Идентификатор = "";
	Описание.Свойство("ТипОбъекта", ИмяТипа);
	Описание.Свойство("УникальныйИдентификатор", Идентификатор);
	Если Не ЗначениеЗаполнено(ИмяТипа) Тогда
		ВызватьИсключение "_objectRef: не заполнен ТипОбъекта";
	КонецЕсли;
	
	ТипСсылки = Тип(ИмяТипа);
	Если Не ЭтоТипСсылки(ТипСсылки) Тогда
		ВызватьИсключение СтрШаблон("_objectRef: %1 - не ссылочный тип", ИмяТипа);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Ссылка = СсылкаПоИдентификатору(ТипСсылки, Идентификатор);
	Иначе
		ОписаниеСсылки = Новый ОписаниеТипов(ИмяТипа);
		Ссылка = ОписаниеСсылки.ПривестиЗначение(Неопределено);
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции

// Ссылка по uuid, имени значения перечисления или имени предопределенного элемента.
Функция СсылкаПоИдентификатору(ТипСсылки, Знач Идентификатор)
	
	Идентификатор = СокрЛП(Строка(Идентификатор));
	Попытка
		Ссылка = XMLЗначение(ТипСсылки, Идентификатор);
	Исключение
		Ссылка = Неопределено;
	КонецПопытки;
	
	Если Ссылка = Неопределено Тогда
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипСсылки);
		Попытка
			Ссылка = ПредопределенноеЗначение(ОбъектМетаданных.ПолноеИмя() + "." + Идентификатор);
		Исключение
			ВызватьИсключение СтрШаблон("нет значения ""%1"" среди значений типа ""%2""", Идентификатор, ПредставлениеТипа(ТипСсылки));
		КонецПопытки;
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции

Функция ОписаниеОбъектаПоСсылке(Ссылка)
	
	Описание = Новый Структура;
	Описание.Вставить("_objectRef", Истина);
	Описание.Вставить("УникальныйИдентификатор", XMLСтрока(Ссылка));
	Описание.Вставить("ТипОбъекта", ПредставлениеТипа(ТипЗнч(Ссылка)));
	Описание.Вставить("Представление", Строка(Ссылка));

	Возврат Описание;

КонецФункции

// Описание ключа записи регистра сведений: оно возвращается в get_nav_link и в parameters, см. КлючЗаписиПоОписанию
// Значения пишутся сразу в формате parameters: функция преобразования ЗаписатьJSON не обрабатывает вложенные в свой ответ значения.
Функция ОписаниеКлючаЗаписи(КлючЗаписи)

	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(КлючЗаписи));

	Значения = Новый Структура;
	Представления = Новый Массив; // Массив из Строка
	Для Каждого ПолеКлюча Из ПоляКлючаЗаписи(КлючЗаписи) Цикл
		Если ЭтоСсылка(ПолеКлюча.Значение) Тогда
			Значения.Вставить(ПолеКлюча.Ключ, ОписаниеОбъектаПоСсылке(ПолеКлюча.Значение));
		Иначе
			Значения.Вставить(ПолеКлюча.Ключ, ЗначениеВФорматеПараметров(ПолеКлюча.Значение));
		КонецЕсли;
		Представления.Добавить(СокрП(Строка(ПолеКлюча.Значение)));
	КонецЦикла;

	Описание = Новый Структура;
	Описание.Вставить("_recordKey", Истина);
	Описание.Вставить("ТипОбъекта", ОбъектМетаданных.ПолноеИмя());
	Описание.Вставить("Значения", Значения);
	Описание.Вставить("Представление", ОбъектМетаданных.Представление() + ": " + СтрСоединить(Представления, ", "));

	Возврат Описание;

КонецФункции

// Период периодического регистра и измерения - поля, которые определяют запись.
//
// Параметры:
//  КлючЗаписи - РегистрСведенийКлючЗаписи
//
// Возвращаемое значение:
//  Структура - имя поля - значение
//
Функция ПоляКлючаЗаписи(КлючЗаписи)

	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(КлючЗаписи));

	Поля = Новый Структура;
	Если ОбъектМетаданных.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		Поля.Вставить("Период", КлючЗаписи.Период);
	КонецЕсли;
	Для Каждого Измерение Из ОбъектМетаданных.Измерения Цикл
		Поля.Вставить(Измерение.Имя, КлючЗаписи[Измерение.Имя]);
	КонецЦикла;

	Возврат Поля;

КонецФункции

// У ключа записи нет XML-типа, а Метаданные.НайтиПоТипу дает регистр и для набора записей, поэтому тип сравнивается по имени.
Функция ЭтоКлючЗаписи(Значение)

	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	Возврат ОбъектМетаданных <> Неопределено
		И Метаданные.РегистрыСведений.Содержит(ОбъектМетаданных)
		И ТипЗнч(Значение) = Тип("РегистрСведенийКлючЗаписи." + ОбъектМетаданных.Имя);

КонецФункции

Функция ЭтоСсылка(Значение)
	
	Возврат ЭтоТипСсылки(ТипЗнч(Значение));
	
КонецФункции

// Ссылочные типы XDTO называются CatalogRef.Имя, DocumentRef.Имя, EnumRef.Имя и т.п.
Функция ЭтоТипСсылки(ПроверяемыйТип)
	
	ТипXML = XMLТип(ПроверяемыйТип);
	Возврат ТипXML <> Неопределено И СтрНайти(ТипXML.ИмяТипа, "Ref.") > 0;
	
КонецФункции

// Имя ссылочного типа в виде СправочникСсылка.Имя или ВнешнийИсточникДанныхТаблицаСсылка.Источник.Таблица,
// его принимают Тип() и ОписаниеТипов; остальные - Строка(Тип).
Функция ПредставлениеТипа(ПредставляемыйТип)

	Представление = Строка(ПредставляемыйТип);
	Если ЭтоТипСсылки(ПредставляемыйТип) Тогда
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ПредставляемыйТип);
		Если ОбъектМетаданных <> Неопределено Тогда
			ЧастиИмени = СтрРазделить(ОбъектМетаданных.ПолноеИмя(), ".");
			Если ЧастиИмени.Количество() = 2 Тогда
				Представление = ЧастиИмени[0] + "Ссылка." + ЧастиИмени[1];
			ИначеЕсли ЧастиИмени.Количество() = 4 Тогда
				// ВнешнийИсточникДанных.Источник.Таблица.ИмяТаблицы
				Представление = ЧастиИмени[0] + ЧастиИмени[2] + "Ссылка." + ЧастиИмени[1] + "." + ЧастиИмени[3];
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

Функция ПредставлениеОписанияТипов(Описание)
	
	Представления = Новый Массив; // Массив из Строка
	Для Каждого ТипОписания Из Описание.Типы() Цикл
		Если ТипОписания <> Тип("Null") Тогда
			Представления.Добавить(ПредставлениеТипа(ТипОписания));
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(Представления, ", ");
	
КонецФункции

#КонецОбласти

#Область JSON

Функция ЗначениеВJSON(Значение)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	
	НастройкиСериализации = Новый НастройкиСериализацииJSON;
	НастройкиСериализации.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	НастройкиСериализации.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДата;
	
	ЗаписатьJSON(ЗаписьJSON, Значение, НастройкиСериализации, "ПреобразованиеJSON", ИнструментыMCPСервер_Ei);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

Функция ТаблицаВМассив(Таблица)
	
	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаМассива = Новый Структура;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			СтрокаМассива.Вставить(Колонка.Имя, СтрокаТаблицы[Колонка.Имя]);
		КонецЦикла;
		Строки.Добавить(СтрокаМассива);
	КонецЦикла;
	
	Возврат Строки;
	
КонецФункции

Функция СтрокиДереваВМассив(СтрокиДерева, Колонки)
	
	Строки = Новый Массив;
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		СтрокаМассива = Новый Структура;
		Для Каждого Колонка Из Колонки Цикл
			СтрокаМассива.Вставить(Колонка.Имя, СтрокаДерева[Колонка.Имя]);
		КонецЦикла;
		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			СтрокаМассива.Вставить("Строки", СтрокиДереваВМассив(СтрокаДерева.Строки, Колонки));
		КонецЕсли;
		Строки.Добавить(СтрокаМассива);
	КонецЦикла;
	
	Возврат Строки;
	
КонецФункции

#КонецОбласти

#Область Аргументы

Функция Аргумент(Аргументы, Имя, ПоУмолчанию = Неопределено)
	
	Значение = Неопределено;
	Если Не Аргументы.Свойство(Имя, Значение) Или Значение = Неопределено Или Значение = Null Тогда
		Значение = ПоУмолчанию;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Параметры:
//  Значение - Произвольный - число из JSON или его строковая запись
//  ПоУмолчанию - Число - если значение не задано или не число
//
// Возвращаемое значение:
//  Число
//
Функция ЧислоАргумента(Значение, ПоУмолчанию)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Результат = Значение;
	Иначе
		ОписаниеЧисла = Новый ОписаниеТипов("Число");
		Результат = ОписаниеЧисла.ПривестиЗначение(Значение);
		Если Результат = 0 Тогда
			Результат = ПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Значение - Произвольный - limit из аргументов
//
// Возвращаемое значение:
//  Число - от 1 до см. МаксимальныйПредел
//
Функция ПределСтрок(Значение)
	
	Результат = Цел(ЧислоАргумента(Значение, ПределПоУмолчанию()));
	Если Результат <= 0 Тогда
		Результат = ПределПоУмолчанию();
	КонецЕсли;
	
	Возврат Мин(Результат, МаксимальныйПредел());
	
КонецФункции


#Область ПрограммныйИнтерфейс
// Это описание значения.
// 
// Параметры:
//  Кандидат - Произвольный	
// 
// Возвращаемое значение:
//  Булево - Это описание значения
Функция ЭтоОписаниеЗначения(Кандидат) Экспорт
	Результат = Ложь;
	Если ТипЗнч(Кандидат) = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Кандидат.Свойство("ОбъемКоллекции");	
	КонецЕсли;	
	Возврат Результат;
КонецФункции

// Это описание неопределенного значения.
// 
// Параметры:
//  Кандидат - Произвольный	
// 
// Возвращаемое значение:
//  Булево - Это описание неопределенного значения
Функция ЭтоОписаниеНеопределенногоЗначения(Кандидат) Экспорт
	Если ЭтоОписаниеЗначения(Кандидат) Тогда
		Возврат (Кандидат.ОписаниеТипов = ОбщегоНазначенияКлиентСервер_Ei.ПолучитьИмяТипЗнч(ТипЗнч(Неопределено)));
	Иначе
		Возврат Ложь;
	КонецЕсли;	
КонецФункции

// Функция - Формирует струтуру описание значения, на основе переданных аргументов, некоторые аргументы доуточняются
//  Распаковка происходит в см. ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение
//
// Параметры:
//  ЗначениеИлиАдрес		 - Произвольный	 			-  Искомое значение, которое необходимо описать или адрес значения в кеше
//  УникальныйИдентификатор	 - УникальныйИдентификатор	-  Адрес по которому необходимо сохранить значние, в дальнешем на клиент передается уже сам адрес, а не значение
//  ОписаниеТипов			 - ОписаниеТипов	 		-  Описание типов. Исползуется для определения какой тип значения получен, если значение сохранено во временном хранилище, иногда получить его на клиенте будет невозможно
// 
// Возвращаемое значение:
//   ФиксированнаяСтруктура - именно ФИКСИРОВАННАЯ важна для совместимости с формой выбора тип:
//   	* ОписаниеТипов 		см. ОбщегоНазначенияКлиентСервер_Ei.ПолучитьИмяТипЗнч
//   	* Значение 				- Произвольный
//   	* Ссылка				- Строка, УникальныйИдентификатор, Неопределено - Адрес во временном хранилище или УИД в кеше
//   	* ПредставлениеЗначения	- Строка
//   	* ОбъемКоллекции		- Число  	 				
//   	* Получен				- Число - когда получено значение, универсальная дата в миллисекундах
//   	* Размерность			- Строка, Неопределено - см. РазмерностьЗначения
//
Функция Подготовить(ЗначениеИлиАдрес,УникальныйИдентификатор = Неопределено,Знач ОписаниеТипов = Неопределено) Экспорт
	Перем ОбъемКоллекции,ПредставлениеЗначения,Размерность;
	Если ОбщегоНазначенияКлиентСервер_Ei.ЭтоАдресКешаЗначений(ЗначениеИлиАдрес) Тогда 
		Значение 	= КэшПользователяКлиентСерверПовтИсп_Ei.Значения().Получить(ЗначениеИлиАдрес);	
		Ссылка 		= ЗначениеИлиАдрес;
	Иначе
		Значение 	= ЗначениеИлиАдрес;
		Если УникальныйИдентификатор = Неопределено Тогда
			Ссылка 		= Неопределено;
		КонецЕсли;	
	КонецЕсли;	
	ПодставитьВыгрузку(Значение,ОписаниеТипов);
	Если ОписаниеТипов = Неопределено Тогда
		//сформируем строковое универсальное представление типа, не все типы доступны на клиенте 
		ОписаниеТипов 	= ОбщегоНазначенияКлиентСервер_Ei.ПолучитьИмяТипЗнч(ТипЗнч(Значение));
	КонецЕсли;
	Если ОписаниеТипов <> ТипыКлиентСервер_Ei.Универсальные().РезультатЗапроса Тогда
		//у результата запроса нет получения по индексу, даже если описание хранит его таблицу
		ОбъемКоллекции(Значение,ОбъемКоллекции);
	КонецЕсли;
	Если Не УникальныйИдентификатор = Неопределено Тогда
		Если ТипыКлиентСерверПовтИсп_Ei.ОписаниеПримитивных().СодержитТип(ТипЗнч(Значение)) Тогда
			//тут ничего неделаем этот тип доступен везде, на клиенте на сервере и в параметрах сеанса
		ИначеЕсли ТипыКлиентСервер_Ei.ЭтоСсылка(ТипЗнч(Значение)) Тогда
			//тут ничего неделаем этот тип доступен везде, на клиенте на сервере и в параметрах сеанса		
		Иначе
			ПредставлениеЗначения		= ПолучитьПредставление(Значение);							
			Размерность					= РазмерностьЗначения(Значение);
			//требуется поместить значение во временное хранилище или кэш вероятно будет использовано на клиенте		
			Попытка
				//для более прогнозируемой жизни объекта попробуем поместить по указанному адресу
				Ссылка 		= ПоместитьВоВременноеХранилище(Значение, УникальныйИдентификатор);
				Значение	= Неопределено;
			Исключение
				КэшПользователяКлиентСервер_Ei.ЗапомнитьМутабельные(Ссылка,Значение);
			КонецПопытки;				
		КонецЕсли;	
	КонецЕсли;	
	Результат = Новый ФиксированнаяСтруктура("ОписаниеТипов,Значение,Ссылка,ПредставлениеЗначения,ОбъемКоллекции,Получен,Размерность",ОписаниеТипов,Значение,Ссылка,ПредставлениеЗначения,ОбъемКоллекции,ТекущаяУниверсальнаяДатаВМиллисекундах(),Размерность);
	//@skip-check constructor-function-return-section
	Возврат Результат;
КонецФункции

// Размерность значения, как на закладке результата: определяет обработчик результата этого типа значения,
// у результата запроса - строки и колонки. На клиенте таких значений нет.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Строка, Число, Неопределено - пустая у значения других типов
//
Функция РазмерностьЗначения(Значение)
	Перем Размерность;
	#Если Не Клиент Тогда
		Если ТипЗнч(Значение) = Тип("РезультатЗапроса") Тогда
			Размерность = СтрШаблон("%1/%2",Значение.Выбрать().Количество(),Значение.Колонки.Количество());
		Иначе
			Для Каждого ЭлРезультата ИЗ РезультатыКлиентСерверПовтИсп_Ei.ПолучитьРезультаты() Цикл
				Размерность = ЭлРезультата.Значение.ОпределитьРазмерность(Значение);
				Если ЗначениеЗаполнено(Размерность) Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	#КонецЕсли
	Возврат Размерность;
КонецФункции

// Заменитель результата запроса в описание не попадает: он не передается и не хранится.
// Описание хранит его таблицу с типом результата запроса, см. ВариантыВызовСервера_Ei.ЗаменительВыгрузки
//
// Параметры:
//  Значение - Произвольный
//  ОписаниеТипов - Строка, Неопределено
//
Процедура ПодставитьВыгрузку(Значение,ОписаниеТипов)
	#Если Не Клиент Тогда
		Если ТипЗнч(Значение) = Тип("ОбработкаОбъект.ВариантЗапрос_Ei") Тогда
			Значение 		= Значение.Выгрузить();
			ОписаниеТипов	= ТипыКлиентСервер_Ei.Универсальные().РезультатЗапроса;
		ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
			//Пакет запроса
			Для Индекс = 0 По Значение.ВГраница() Цикл
				Если ТипЗнч(Значение[Индекс]) = Тип("ОбработкаОбъект.ВариантЗапрос_Ei") Тогда
					Значение[Индекс] = Значение[Индекс].Выгрузить();
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	#КонецЕсли
КонецПроцедуры

// Получить представление.
// 
// Параметры:
//  Значение - Произвольный - Значение
// 
// Возвращаемое значение:
//  Строка - Получить представление
Функция ПолучитьПредставление(Значение) Экспорт
	Перем Представление;
	Тип						= ТипЗнч(Значение);
	ОбработчикРезультата 	= РезультатыКлиентСерверПовтИсп_Ei.ПолучитьРезультаты().Получить(ОбщегоНазначенияКлиентСервер_Ei.ПолучитьИмяТипЗнч(Тип));
	Если Не ОбработчикРезультата = Неопределено Тогда
		Размерность  = ОбработчикРезультата.ОпределитьРазмерность(Значение);
		Если ЗначениеЗаполнено(Размерность) Тогда
			Представление = Строка(Тип)+Символы.НПП+"("+Размерность+")";
		Иначе
			Представление = Строка(Тип);
		КонецЕсли;		
	ИначеЕсли ОбщегоНазначенияКлиентСервер_Ei.ПолучитьИмяТипЗнч(Тип) = ТипыКлиентСервер_Ei.Универсальные().РезультатЗапроса Тогда
		Выборка = Значение.Выбрать();
		Представление = Строка(Тип)+Символы.НПП+СтрШаблон("(%1/%2)",Выборка.Количество(),Значение.Колонки.Количество());			
	Иначе	
		Представление = ПолучитьПредставлениеПростогоЗнач(Значение,Истина);
	КонецЕсли;	
	Возврат Представление; 
КонецФункции

// Получить представление.
// 
// Параметры:
//  Значение 		- Произвольный - Значение
//  ТипЕслиПустое	- Булево - 
// 
// Возвращаемое значение:
//  Строка - Получить представление
Функция ПолучитьПредставлениеПростогоЗнач(Значение,ТипЕслиПустое = Ложь) Экспорт
	Перем Представление;
	Тип						= ТипЗнч(Значение);
	Если Тип = Тип("ФормаКлиентскогоПриложения") Тогда
		Представление =  СтрШаблон("Форма %1",Значение.Заголовок);			
	Иначе	
		Попытка
			Представление    	= Строка(Значение);
			Если ТипЕслиПустое И ПустаяСтрока(Представление) Тогда
				//Иногда значение не имеет представления (например результат запроса),
				//или вызывает ошибку при попытке преобразования (например пустая, выборка результата запроса)
				//тогда просто возьмем представление его типа
				//ВызватьИсключение ""; // чтобы лишний раз не останавливаться "по ошибке" закоментировал
				Представление  	= Строка(Тип)
			КонецЕсли;	
		Исключение		
			Представление  	= Строка(Тип);
		КонецПопытки;
	КонецЕсли;	
	Возврат Представление;
КонецФункции

// Процедура - Рассчитываем объем коллекции для значения, имеет значение если мы можем получать элемент коллекции по индексу 
//
// Параметры:
//  Значение		 - Произвольный	 		- Значение для которого нужно получить объем 
//  ОбъемКоллекции	 - Число,Неопределено	- Возвращаемый параметр
//
Процедура ОбъемКоллекции(Значение,ОбъемКоллекции) Экспорт
	Если Не ТипыКлиентСервер_Ei.НедоступноПолучниеПоИндексу().СодержитТип(ТипЗнч(Значение)) Тогда
		Попытка
			#Если Не Клиент Тогда
				Если ТипЗнч(Значение) = Тип("COMОбъект") Тогда
					ОбъемКоллекции = Значение.RecordCount;
				КонецЕсли;
			#КонецЕсли	
			
			Если ОбъемКоллекции = Неопределено Тогда
				ОбъемКоллекции = Значение.Количество();
			КонецЕсли;	
		Исключение
			Возврат;
		КонецПопытки;
	КонецЕсли;		
КонецПроцедуры
#КонецОбласти	

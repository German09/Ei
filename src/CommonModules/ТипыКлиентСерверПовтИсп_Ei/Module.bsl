//		*Ключ 		-	ВидГруппыФормы,ВидПоляФормы,ВидДекорацииФормы
//		*Значение	- Строка 
Функция РасширенияЭлементов() Экспорт
	Результат = Новый Соответствие;
	Результат.Вставить(ВидГруппыФормы.КоманднаяПанель,"ВидГруппыФормы.КоманднаяПанель");
	Результат.Вставить(ВидГруппыФормы.Подменю,"ВидГруппыФормы.Подменю");

	Результат.Вставить(ВидПоляФормы.ПолеПериода,"ВидПоляФормы.ПолеПериода");
	Результат.Вставить(ВидПоляФормы.ПолеПланировщика,"ВидПоляФормы.ПолеПланировщика");

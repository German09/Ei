// Получает все возможные типы отображение результатов
// 
// Возвращаемое значение:
//  Соответствие - Имя типа отображения результата и общий модуль в котором описана все необходимые процедуры данного типа варианта 
Функция ПолучитьРезультаты() Экспорт
	Результат 	= Новый Соответствие;
	СтрВарианты = ОбщегоНазначенияВызовСервера_Ei.ПолучитьСоставПодсистемы(РезультатыКлиентСервер_Ei.Ключ());
	Для Каждого СтрВариант ИЗ СтрВарианты Цикл
		Попытка
			Вариант = Вычислить(СтрВариант);
			Результат.Вставить(Вариант.Свойства().Имя,Вариант);
		Исключение
		КонецПопытки;	
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Получает результаты в определелном порядке
// 
// Возвращаемое значение:
//  Массив из Строка - Имен результатов
Функция ПолучитьМассивРезультатов() Экспорт
	мИмен 			= ОбщегоНазначенияВызовСервера_Ei.ПолучитьМассивПодсистем(РезультатыКлиентСервер_Ei.Ключ());
	сооРезультаты 	= РезультатыКлиентСерверПовтИсп_Ei.ПолучитьРезультаты();
	ОбщегоНазначенияКлиентСервер_Ei.ЗаполнитьМассивИмен(сооРезультаты, мИмен);	
	Возврат мИмен;
КонецФункции	
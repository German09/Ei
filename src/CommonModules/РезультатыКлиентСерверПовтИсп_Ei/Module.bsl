// Получает все возможные типы отображение результатов
// 
// Возвращаемое значение:
//  Соответствие Из ОбщийМодуль - Имя типа отображения результата и общий модуль в котором описана все необходимые процедуры данного типа варианта
Функция ПолучитьРезультаты() Экспорт
	Результат 	= Новый Соответствие;
	СтрВарианты = ОбщегоНазначенияВызовСервера_Ei.ПолучитьСоставПодсистемы(РезультатыКлиентСервер_Ei.Ключ());
	Для Каждого СтрВариант ИЗ СтрВарианты Цикл
		Попытка
			Вариант = ВыполнитьКлиентСервер_Ei.ВычислитьБезопасно(СтрВариант);
			Результат.Вставить(Вариант.Свойства().Имя,Вариант);
		Исключение
			//не смогли получить модуль из-за его отсутствия или синтаксической ошибки
			Продолжить;
		КонецПопытки;	
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Получает результаты в определелном порядке
// 
// Возвращаемое значение:
//  Массив из Строка - Имен результатов
Функция ПолучитьМассивРезультатов() Экспорт
	Имена 		= ОбщегоНазначенияВызовСервера_Ei.ПолучитьМассивПодсистем(РезультатыКлиентСервер_Ei.Ключ());
	Результаты 	= РезультатыКлиентСерверПовтИсп_Ei.ПолучитьРезультаты();
	ОбщегоНазначенияКлиентСервер_Ei.ЗаполнитьМассивИмен(Результаты, Имена);	
	Возврат Имена;
КонецФункции
#КонецОбласти	
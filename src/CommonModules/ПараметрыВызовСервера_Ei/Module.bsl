#Область ПрограммныйИнтерфейс

// Текст файла значения параметра (не выражения), см. ПараметрыКлиент_Ei.СодержимоеФайла.
// Значение, которое нельзя передать на клиент (таблица значений), хранится в параметре строкой XML своей сериализации,
// так ее кладет в параметр функция ЗначениеПараметраСтроки модуля ЗапросыMCPКлиент_Ei: эта строка и есть содержимое файла. Если сериализовать ее еще раз,
// в файле окажется XML внутри строки (было до 3.2.8.5)
//
// Параметры:
//  Значение - Произвольный - значение параметра в форме Ei
//
// Возвращаемое значение:
//  Строка - XML значения
Функция СодержимоеФайлаЗначения(Значение) Экспорт
	Результат = Неопределено;
	Если ТипЗнч(Значение) = Тип("Строка") И СтрНачинаетсяС(СокрЛ(Значение), "<") Тогда
		Попытка
			Прочитанное = ОбщегоНазначенияКлиентСервер_Ei.Структурировать(Значение);
			Если ТипЗнч(Прочитанное) <> Тип("Строка") Тогда
				Результат = Значение;
			КонецЕсли;
		Исключение
			//это обычная строка, она сериализуется как строка
			Результат = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если Результат = Неопределено Тогда
		Результат = ОбщегоНазначенияВызовСервера_Ei.Сериализовать(Значение);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Вычислить параметры.
// 
// Параметры:
//  ИмяНабора		- Строка 		
//  ИмяПараметра	- Строка 	
// 
// Возвращаемое значение:
//  Структура, Произвольный - Вычислить параметры
Функция ВычислитьПараметры(Знач ИмяНабора, ИмяПараметра) Экспорт
	Перем Свойства;
	Перем Результат;
	ДанныеНабора = НаборВариантовКлиентСервер_Ei.ПолучитьДанныеНабора(ИмяНабора);
	Если Не ДанныеНабора = Неопределено Тогда
		ПараметрыВарианта =  ДанныеНабора.Параметры;
		Если ИмяПараметра = Неопределено Тогда
			Результат =  Новый Структура;
			//Это вычисление всех параметров, нужно для вычисления в форме выбора  
			Для Каждого Параметр Из ПараметрыВарианта Цикл
				//вычисление параметра - вложенный запуск истории, см. ИсторияВызовСервера_Ei.НачатьЗапускПараметра
				ЗапускПараметра = ИсторияВызовСервера_Ei.НачатьЗапускПараметра();
				ЗамерПараметра	= НачатьЗамерПараметра(ЗапускПараметра, Параметр.Ключ, Параметр.Значение);
				Попытка
					Значение = ВычислитьПараметр(Параметр.Значение);
					ЖурналКлиентСервер_Ei.ЗавершитьЗамер(ЗамерПараметра);
					ИсторияВызовСервера_Ei.ЗавершитьЗапускПараметра(ЗапускПараметра, ДанныеНабора.КлючНастроек, Параметр.Ключ, Параметр.Значение, Значение);
				Исключение
					Значение = ИнформацияОбОшибке();
					ЖурналКлиентСервер_Ei.ЗавершитьЗамер(ЗамерПараметра, , Значение);
					ИсторияВызовСервера_Ei.ЗавершитьЗапускПараметра(ЗапускПараметра, ДанныеНабора.КлючНастроек, Параметр.Ключ, Параметр.Значение, Неопределено, Значение);
				КонецПопытки;			
				Результат.Вставить(Параметр.Ключ,Значение);	
			КонецЦикла;
		Иначе
			//Вычисляем определенный параметр
			Если ПараметрыВарианта.Свойство(ИмяПараметра,Свойства) Тогда
				ЗапускПараметра = ИсторияВызовСервера_Ei.НачатьЗапускПараметра();
				ЗамерПараметра	= НачатьЗамерПараметра(ЗапускПараметра, ИмяПараметра, Свойства);
				Попытка
					ОписаниеЗначения = ВычислитьПараметр(Свойства);
					Результат		 = ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОписаниеЗначения);
				Исключение
					ИнфоОбОшибке = ИнформацияОбОшибке();
					ЖурналКлиентСервер_Ei.ЗавершитьЗамер(ЗамерПараметра, , ИнфоОбОшибке);
					ИсторияВызовСервера_Ei.ЗавершитьЗапускПараметра(ЗапускПараметра, ДанныеНабора.КлючНастроек, ИмяПараметра, Свойства, Неопределено, ИнфоОбОшибке);
					ВызватьИсключение;
				КонецПопытки;
				ЖурналКлиентСервер_Ei.ЗавершитьЗамер(ЗамерПараметра);
				ИсторияВызовСервера_Ei.ЗавершитьЗапускПараметра(ЗапускПараметра, ДанныеНабора.КлючНастроек, ИмяПараметра, Свойства, Результат);
			КонецЕсли;	
		КонецЕсли;		
	КонецЕсли;
	Возврат Результат;				
КонецФункции

// Получить параметры.
// 
// Параметры:
//  Текст 		- Строка 
//  Параметры 	- Массив из ОписаниеПараметраЗапроса  
// 
// Возвращаемое значение:
//  Массив из ОписаниеПараметраЗапроса
Функция ПолучитьПараметры(Текст, Параметры) Экспорт
	ТабСортировки 		= Новый ТаблицаЗначений;
	ТабСортировки.Колонки.Добавить("ОписаниеПараметра");
	ТабСортировки.Колонки.Добавить("Порядок",Новый ОписаниеТипов("Число"));
	Для Каждого Параметр Из Параметры Цикл
		НоваяСтрока = ТабСортировки.Добавить();	
		НоваяСтрока.ОписаниеПараметра 	= Новый Структура("Имя,ТипЗначения", Параметр.Имя, ТипЗначенияДляКлиента(Параметр.ТипЗначения));
		НоваяСтрока.Порядок 			= СтрНайти(Текст,"&"+Параметр.Имя);
	КонецЦикла;
	ТабСортировки.Сортировать("Порядок Возр");
	Возврат ТабСортировки.ВыгрузитьКолонку("ОписаниеПараметра");
КонецФункции

// Типы параметров строк набора для документирующих комментариев модуля объекта обработки EDT
// (его собирает функция ТекстМодуляОбъекта клиентского модуля EDTКлиент_Ei).
// Тип параметра-значения берется по значению так же, как его получает код при выполнении, см. ВычислитьПараметр.
// Тип параметра-выражения - по значению его последнего успешного вычисления из истории запусков (с 3.2.8.9);
// параметр с тем же именем в другой строке часто берет значение оттуда, поэтому типы собираются по всем строкам.
// Произвольный - только если выражение ни разу не вычислялось и параметров-значений с этим именем нет.
// Типы меняются только в модуле объекта (вспомогательный элемент обработки): формы ссылаются на них из комментария,
// поэтому выполнение выражения не меняет файлы, по которым Ei считает изменения набора
//
// Параметры:
//  ПараметрыСтрок - Массив из Структура:
//   * Строка - Строка - имя строки набора
//   * КлючСтроки - УникальныйИдентификатор - ключ строки набора (КлючНастроек), по нему ищется история
//   * Имя - Строка - имя параметра
//   * ЭтоВыражение - Булево - параметр-выражение
//   * ЗначениеПараметра - Произвольный - значение, как в см. ПараметрыКлиентСервер_Ei.ПолучитьСтруктуру
//
// Возвращаемое значение:
//  Структура из КлючИЗначение:
//   * Ключ - Строка - имя параметра
//   * Значение - Структура:
//    ** Тип - Строка - тип для документирующего комментария
//    ** Строки - Строка - строки набора с этим параметром через запятую
//
Функция ТипыДляEDT(ПараметрыСтрок) Экспорт
	
	Описания = Новый Структура;
	Для Каждого Параметр Из ПараметрыСтрок Цикл
		Если Не Описания.Свойство(Параметр.Имя) Тогда
			Описания.Вставить(Параметр.Имя, Новый Структура("Типы,Строки", Новый Массив, Новый Массив));
		КонецЕсли;
		Описание = Описания[Параметр.Имя];
		Описание.Строки.Добавить(Параметр.Строка);
		Если Не Параметр.ЭтоВыражение Тогда
			ТипЗначения = ТипДляEDT(ОбщегоНазначенияКлиентСервер_Ei.ПопыткаСтруктурировать(Параметр.ЗначениеПараметра));
		ИначеЕсли Параметр.Свойство("КлючСтроки") И ЗначениеЗаполнено(Параметр.КлючСтроки) Тогда
			ТипЗначения = ИсторияВызовСервера_Ei.ТипПоследнегоЗначения(
				ИсторияКлиентСервер_Ei.КлючПараметра(Параметр.КлючСтроки, Параметр.Имя));
		Иначе
			ТипЗначения = "";
		КонецЕсли;
		Если ЗначениеЗаполнено(ТипЗначения) И Описание.Типы.Найти(ТипЗначения) = Неопределено Тогда
			Описание.Типы.Добавить(ТипЗначения);
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура;
	Для Каждого КлючИЗначение Из Описания Цикл
		Результат.Вставить(КлючИЗначение.Ключ, Новый Структура("Тип,Строки", ТипИзТипов(КлючИЗначение.Значение.Типы),
			СтрСоединить(КлючИЗначение.Значение.Строки, ", ")));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Типы результатов алгоритмов строк набора для документирующих комментариев модуля объекта обработки EDT:
// по значению последнего успешного выполнения варианта из истории запусков, Произвольный - если алгоритм
// ни разу не выполнялся. Форма алгоритма ссылается на этот тип из комментария, см. ВариантАлгоритмКлиентСервер_Ei.ОписаниеРезультатаФормы
//
// Параметры:
//  СтрокиАлгоритмов - Массив из Структура:
//   * Строка - Строка - имя строки набора
//   * КлючСтроки - УникальныйИдентификатор - ключ строки набора (КлючНастроек)
//  ИмяВарианта - Строка - имя варианта алгоритма, как в истории запусков
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - имя строки набора
//   * Значение - Строка - тип для документирующего комментария
//
Функция ТипыРезультатовДляEDT(СтрокиАлгоритмов, ИмяВарианта) Экспорт
	
	Результат = Новый Соответствие;
	Для Каждого СтрокаАлгоритма Из СтрокиАлгоритмов Цикл
		Типы = Новый Массив; // Массив из Строка
		Если ЗначениеЗаполнено(СтрокаАлгоритма.КлючСтроки) Тогда
			ТипЗначения = ИсторияВызовСервера_Ei.ТипПоследнегоЗначения(
				ИсторияКлиентСервер_Ei.КлючВарианта(СтрокаАлгоритма.КлючСтроки, ИмяВарианта));
			Если ЗначениеЗаполнено(ТипЗначения) Тогда
				Типы.Добавить(ТипЗначения);
			КонецЕсли;
		КонецЕсли;
		Результат.Вставить(СтрокаАлгоритма.Строка, ТипИзТипов(Типы));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Тип значения для документирующего комментария модуля объекта обработки EDT, см. ТипДляEDT.
// История запусков запоминает его у каждого результата, см. ИсторияВызовСервера_Ei.ТипПоследнегоЗначения
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Строка - первая строка - тип, у структуры и таблицы значений следующие строки - поля «* Имя - Тип»;
//           пустая, если тип не описать
//
Функция ТипЗначенияДляEDT(Значение) Экспорт
	
	Возврат ТипДляEDT(Значение);
	
КонецФункции

#КонецОбласти	

#Область СлужебныеПроцедурыИФункции

// Тип для комментария по собранным типам: один - он сам, ни одного - Произвольный, несколько - по строке на тип
// «- Тип - значение», без полей. Через запятую нельзя: у коллекции EDT требует тип элемента («Тип коллекции должен
// содержать тип элемента коллекции»), а «СписокЗначений из Х, Y» читается как список из Х или Y (проверено 2026-11-13)
//
// Параметры:
//  Типы - Массив из Строка - см. ТипДляEDT
//
// Возвращаемое значение:
//  Строка - см. ТипЗначенияДляEDT; несколько типов - строки «- Тип - значение»
Функция ТипИзТипов(Типы)
	Если Типы.Количество() = 0 Тогда
		Результат = "Произвольный";
	ИначеЕсли Типы.Количество() = 1 Тогда
		Результат = Типы.Получить(0);
	Иначе
		Строки = Новый Массив; // Массив из Строка
		Для Каждого ТипЗначения Из Типы Цикл
			СтрокаТипа = СтрШаблон("- %1 - значение", ПерваяСтрокаТипа(ТипЗначения));
			Если Строки.Найти(СтрокаТипа) = Неопределено Тогда
				Строки.Добавить(СтрокаТипа);
			КонецЕсли;
		КонецЦикла;
		Результат = СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Тип параметра, который можно передать на клиент. У параметра ИЗ &Таблица тип - ТаблицаЗначений,
// а описание типов с серверной коллекцией тонкий клиент не принимает: передача падает с ошибкой отображения типа ValueTable.
//
// Параметры:
//  ТипЗначения - ОписаниеТипов - тип параметра из Запрос.НайтиПараметры()
//
// Возвращаемое значение:
//  ОписаниеТипов - без таблицы и дерева значений
//
Функция ТипЗначенияДляКлиента(ТипЗначения)
	
	СерверныеКоллекции = Новый Массив; // Массив из Тип
	СерверныеКоллекции.Добавить(Тип("ТаблицаЗначений"));
	СерверныеКоллекции.Добавить(Тип("ДеревоЗначений"));
	
	Возврат Новый ОписаниеТипов(ТипЗначения, , СерверныеКоллекции);
	
КонецФункции

// Замер журнала выполнения для вычисления параметра: тот же идентификатор, что у запуска параметра в истории,
// и та же внешняя операция, чтобы в журнале параметр оказался внутри запуска варианта или другого параметра.
//
// Параметры:
//  ЗапускПараметра - см. ИсторияВызовСервера_Ei.НачатьЗапускПараметра
//  ИмяПараметра - Строка
//  Свойства - ФиксированнаяСтруктура - свойства параметра
//
// Возвращаемое значение:
//  см. ЖурналКлиентСервер_Ei.НачатьЗамер
//
Функция НачатьЗамерПараметра(ЗапускПараметра, ИмяПараметра, Свойства)
	
	Операция = СтрШаблон("Параметр %1", ИмяПараметра);
	Если Свойства.ЭтоВыражение Тогда
		Операция = Операция + Символы.ПС + Строка(Свойства.ЗначениеПараметра);
	КонецЕсли;
	
	Возврат ЖурналКлиентСервер_Ei.НачатьЗамер(Операция, "Параметры", ,
		ЖурналКлиентСервер_Ei.НастройкиЗамера(ЗапускПараметра.Ид, ЗапускПараметра.Родитель, Ложь));
	
КонецФункции

Функция ВычислитьПараметр(Знач Свойства)
	Перем Значение;
	Если Свойства.ЭтоВыражение И ТипЗнч(Свойства.ЗначениеПараметра)=Тип("Строка") Тогда
		Значение	= ВыполнитьКлиентСервер_Ei.Выражение(Свойства.ЗначениеПараметра);
	Иначе
		Значение 	= ОбщегоНазначенияКлиентСервер_Ei.ПопыткаСтруктурировать(Свойства.ЗначениеПараметра);				
	КонецЕсли;
	Возврат Значение;
Конецфункции

// Тип значения для документирующего комментария: ссылка - СправочникСсылка.Имя, платформенный тип - по имени,
// список значений и массив - с типом элементов, если он один. У структуры и таблицы значений после первой строки
// с типом идут строки полей и колонок «* Имя - Тип»: зная поля, EDT подсказывает их в коде, а форма алгоритма,
// которая собирает структуру, не получает замечание «Возвращается недекларируемое свойство» (с 3.2.8.11).
// Неизвестный тип - пустая строка
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Строка - тип, у структуры и таблицы значений - с полями через перевод строки
Функция ТипДляEDT(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("СписокЗначений") Или ТипЗначения = Тип("Массив") Тогда
		Результат = ТипКоллекцииДляEDT(Значение);
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Поля = Новый Массив; // Массив из Строка
		Для Каждого КлючИЗначение Из Значение Цикл
			Поля.Добавить(ПолеДляEDT(КлючИЗначение.Ключ, ПерваяСтрокаТипа(ТипДляEDT(КлючИЗначение.Значение))));
		КонецЦикла;
		Результат = ТипСПолями(ИмяТипаДляEDT(ТипЗначения), Поля);
	ИначеЕсли ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Поля = Новый Массив; // Массив из Строка
		Для Каждого Колонка Из Значение.Колонки Цикл
			Поля.Добавить(ПолеДляEDT(Колонка.Имя, ТипыОписанияДляEDT(Колонка.ТипЗначения)));
		КонецЦикла;
		Результат = ТипСПолями("ТаблицаЗначений", Поля);
	Иначе
		Результат = ИмяТипаДляEDT(ТипЗначения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Тип списка значений или массива для комментария: с типом элементов, если он один и простой, иначе из Произвольный -
// без типа элемента EDT пишет «Тип коллекции должен содержать тип элемента коллекции»
//
// Параметры:
//  Значение - Произвольный - список значений или массив, по элементам которого определяется тип
//
// Возвращаемое значение:
//  Строка
Функция ТипКоллекцииДляEDT(Значение)
	
	ЭтоСписок 		= ТипЗнч(Значение) = Тип("СписокЗначений");
	ТипыЭлементов 	= Новый Массив; // Массив из Строка
	Для Каждого Элемент Из Значение Цикл
		ТипЭлемента = ПерваяСтрокаТипа(ТипДляEDT(?(ЭтоСписок, Элемент.Значение, Элемент)));
		Если ЗначениеЗаполнено(ТипЭлемента) И ТипыЭлементов.Найти(ТипЭлемента) = Неопределено Тогда
			ТипыЭлементов.Добавить(ТипЭлемента);
		КонецЕсли;
	КонецЦикла;
	//в описании типа одно «из»: вложенную коллекцию и несколько типов элементов не указываем
	ТипЭлементов = ?(ТипыЭлементов.Количество() = 1 И СтрНайти(ТипыЭлементов.Получить(0), " ") = 0,
		ТипыЭлементов.Получить(0), "Произвольный");
	Результат = СтрШаблон("%1 из %2", ?(ЭтоСписок, "СписокЗначений", "Массив"), ТипЭлементов);
	
	Возврат Результат;
	
КонецФункции

// Имя типа для комментария: платформенный тип - по имени, ссылка - СправочникСсылка.Имя и т.п.
// Коллекция - с типом элемента, иначе EDT пишет «Тип коллекции должен содержать тип элемента коллекции»
//
// Параметры:
//  ТипЗначения - Тип
//
// Возвращаемое значение:
//  Строка - пустая, если тип не описать
Функция ИмяТипаДляEDT(ТипЗначения)
	
	Результат = "";
	Для Каждого ИмяТипа Из СтрРазделить("Строка,Число,Дата,Булево,Структура,ФиксированнаяСтруктура,"
		+ "Соответствие из КлючИЗначение,ФиксированноеСоответствие из КлючИЗначение,Массив из Произвольный,"
		+ "ФиксированныйМассив из Произвольный,СписокЗначений из Произвольный,ТаблицаЗначений,ДеревоЗначений,"
		+ "ОписаниеТипов,УникальныйИдентификатор,ХранилищеЗначения,ТабличныйДокумент,Тип,РезультатЗапроса,"
		+ "МенеджерВременныхТаблиц", ",") Цикл
		Если ТипЗначения = Тип(СтрПолучитьСтроку(СтрЗаменить(ИмяТипа, " из ", Символы.ПС), 1)) Тогда
			Результат = ИмяТипа;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	//ссылочные типы XDTO называются CatalogRef.Имя, DocumentRef.Имя и т.п.
	ТипXML = ?(ЗначениеЗаполнено(Результат), Неопределено, XMLТип(ТипЗначения));
	Если ТипXML <> Неопределено И СтрНайти(ТипXML.ИмяТипа, "Ref.") > 0 Тогда
		ОбъектМетаданных 	= Метаданные.НайтиПоТипу(ТипЗначения);
		ЧастиИмени 			= ?(ОбъектМетаданных = Неопределено, Новый Массив, СтрРазделить(ОбъектМетаданных.ПолноеИмя(), "."));
		Если ЧастиИмени.Количество() = 2 Тогда
			Результат = ЧастиИмени.Получить(0) + "Ссылка." + ЧастиИмени.Получить(1);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Типы колонки таблицы значений для комментария: известные типы через запятую, иначе Произвольный
//
// Параметры:
//  ОписаниеТипов - ОписаниеТипов
//
// Возвращаемое значение:
//  Строка
Функция ТипыОписанияДляEDT(ОписаниеТипов)
	
	Имена = Новый Массив; // Массив из Строка
	Для Каждого ТипКолонки Из ОписаниеТипов.Типы() Цикл
		ИмяТипа = ИмяТипаДляEDT(ТипКолонки);
		Если ЗначениеЗаполнено(ИмяТипа) И Имена.Найти(ИмяТипа) = Неопределено Тогда
			Имена.Добавить(ИмяТипа);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ?(Имена.Количество() = 0, "Произвольный", СтрСоединить(Имена, ", "));
	
КонецФункции

// Строка поля структуры или колонки таблицы для комментария. Несколько типов EDT принимает только
// с описанием после них, как и в разделе «Возвращаемое значение» (проверено 2026-11-13)
//
// Параметры:
//  Имя - Строка
//  ТипПоля - Строка - пустой - Произвольный
//
// Возвращаемое значение:
//  Строка - например «* Номенклатура - СправочникСсылка.Номенклатура»
Функция ПолеДляEDT(Имя, ТипПоля)
	
	Результат = СтрШаблон("* %1 - %2", Имя, ?(ЗначениеЗаполнено(ТипПоля), ТипПоля, "Произвольный"));
	Если СтрНайти(ТипПоля, ",") > 0 Тогда
		Результат = Результат + " - значения разных типов";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Тип с полями: первая строка - тип, следующие - поля. Больше 100 полей не описываем:
// комментарий вышел бы длиннее самой обвязки
//
// Параметры:
//  ИмяТипа - Строка
//  Поля - Массив из Строка - см. ПолеДляEDT
//
// Возвращаемое значение:
//  Строка
Функция ТипСПолями(ИмяТипа, Поля)
	
	Строки = Новый Массив; // Массив из Строка
	Строки.Добавить(ИмяТипа);
	Если Поля.Количество() <= 100 Тогда
		Для Каждого Поле Из Поля Цикл
			Строки.Добавить(Поле);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

// Первая строка типа - сам тип без полей, см. ТипДляEDT
//
// Параметры:
//  ТипЗначения - Строка
//
// Возвращаемое значение:
//  Строка
Функция ПерваяСтрокаТипа(ТипЗначения)
	
	Возврат СтрПолучитьСтроку(ТипЗначения, 1);
	
КонецФункции

#КонецОбласти

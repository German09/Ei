Функция ВычислитьПараметры(Знач ИмяНабора, ИмяПараметра) Экспорт
	Перем Вариант;
	Перем Свойства;
	Перем Результат;
	ИмяНабора = ?(ИмяНабора = Неопределено,НаборВариантовВызовСервера_Ei.ПолучитьТекущийНабор(),ИмяНабора);
	Если Не ИмяНабора = Неопределено Тогда
		НаборВариантовВызовСервера_Ei.Получить().Свойство(ИмяНабора,Вариант);
		Если Не Вариант = Неопределено Тогда
			ПараметрыВарианта =  Вариант.Параметры;
			Если ИмяПараметра = Неопределено Тогда
				Результат =  Новый Структура;
				//Это вычисление всех параметров, нужно для вычисления в форме выбора  
				Для Каждого Параметр Из ПараметрыВарианта Цикл
					Попытка
						Значение = ВычислитьПараметр(Параметр.Значение);
					Исключение
						Значение = ИнформацияОбОшибке();
					КонецПопытки;			
					Результат.Вставить(Параметр.Ключ,Значение);	
				КонецЦикла;
			Иначе
				//Вычисляем определенный параметр
				Если ПараметрыВарианта.Свойство(ИмяПараметра,Свойства) Тогда
					ОписаниеЗначения = ВычислитьПараметр(Свойства);
					Результат		 = СтруктурыЗначенийВызовСервера_Ei.ПереопределитьЗначение(ОписаниеЗначения);			
				КонецЕсли;	
			КонецЕсли;		
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;				
КонецФункции	

Функция ВычислитьПараметр(Знач Свойства)
	Перем Значение;
	Если Свойства.ЭтоВыражение И ТипЗнч(Свойства.ЗначениеПараметра)=Тип("Строка") Тогда
		Значение	= ВыполнитьКлиентСервер_Ei.Выражение(Свойства.ЗначениеПараметра);
	ИначеЕсли ТипЗнч(Свойства.ЗначениеПараметра)=Тип("ФиксированныйМассив") Тогда
		//преобразуем это в список значений
		Значение = Новый СписокЗначений();
		Значение.ЗагрузитьЗначения(Новый Массив(Свойства.ЗначениеПараметра));
	Иначе
		Значение = Свойства.ЗначениеПараметра;		
	КонецЕсли;
	Возврат Значение
Конецфункции

#Область ПрограммныйИнтерфейс
// Вычислить параметры.
// 
// Параметры:
//  ИмяНабора		- Строка 		
//  ИмяПараметра	- Строка 	
// 
// Возвращаемое значение:
//  Структура, Произвольный - Вычислить параметры
Функция ВычислитьПараметры(Знач ИмяНабора, ИмяПараметра) Экспорт
	Перем Свойства;
	Перем Результат;
	ДанныеНабора = НаборВариантовКлиентСервер_Ei.ПолучитьДанныеНабора(ИмяНабора);
	Если Не ДанныеНабора = Неопределено Тогда
		ПараметрыВарианта =  ДанныеНабора.Параметры;
		Если ИмяПараметра = Неопределено Тогда
			Результат =  Новый Структура;
			//Это вычисление всех параметров, нужно для вычисления в форме выбора  
			Для Каждого Параметр Из ПараметрыВарианта Цикл
				Попытка
					Значение = ВычислитьПараметр(Параметр.Значение);
				Исключение
					Значение = ИнформацияОбОшибке();
				КонецПопытки;			
				Результат.Вставить(Параметр.Ключ,Значение);	
			КонецЦикла;
		Иначе
			//Вычисляем определенный параметр
			Если ПараметрыВарианта.Свойство(ИмяПараметра,Свойства) Тогда
				ОписаниеЗначения = ВычислитьПараметр(Свойства);
				Результат		 = ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОписаниеЗначения);			
			КонецЕсли;	
		КонецЕсли;		
	КонецЕсли;
	Возврат Результат;				
КонецФункции

// Получить параметры.
// 
// Параметры:
//  Текст 		- Строка 
//  Параметры 	- Массив из ОписаниеПараметраЗапроса  
// 
// Возвращаемое значение:
//  Массив из ОписаниеПараметраЗапроса
Функция ПолучитьПараметры(Текст, Параметры) Экспорт
	ТабСортировки 		= Новый ТаблицаЗначений;
	ТабСортировки.Колонки.Добавить("ОписаниеПараметра");
	ТабСортировки.Колонки.Добавить("Порядок",Новый ОписаниеТипов("Число"));
	Для Каждого Параметр Из Параметры Цикл
		НоваяСтрока = ТабСортировки.Добавить();	
		НоваяСтрока.ОписаниеПараметра 	= Новый Структура("Имя,ТипЗначения", Параметр.Имя,Параметр.ТипЗначения);
		НоваяСтрока.Порядок 			= СтрНайти(Текст,"&"+Параметр.Имя);
	КонецЦикла;
	ТабСортировки.Сортировать("Порядок Возр");
	Возврат ТабСортировки.ВыгрузитьКолонку("ОписаниеПараметра");
КонецФункции

#КонецОбласти	

#Область СлужебныеПроцедурыИФункции
Функция ВычислитьПараметр(Знач Свойства)
	Перем Значение;
	Если Свойства.ЭтоВыражение И ТипЗнч(Свойства.ЗначениеПараметра)=Тип("Строка") Тогда
		Значение	= ВыполнитьКлиентСервер_Ei.Выражение(Свойства.ЗначениеПараметра);
	Иначе
		Значение 	= ОбщийМодульКлиентСервер_Ei.ПопыткаСтруктурировать(Свойства.ЗначениеПараметра);				
	КонецЕсли;
	Возврат Значение
Конецфункции
#КонецОбласти

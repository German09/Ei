Процедура ПриОтображении(Форма) Экспорт
	ТД = Форма.ПолучитьПереопределяемыйОбъектОбработки();
	УстановитьВидимостьСписков(Форма,ТД.ПолучитьИдентификатор());		
Конецпроцедуры

Процедура УстановитьВидимостьСписков(Форма,ВариантИД)
	Если Не ВариантИД = Неопределено Тогда
		ПоказалиДС = Ложь;
		ИмяОсновногоРеквизита = РезультатКлиентСервер_ДинСписок_Ei.ПолучитьИмяРеквизитаДинСписка(ВариантИД);
		Для Каждого элФормы ИЗ Форма.Элементы.ГруппаДинСписков.ПодчиненныеЭлементы Цикл                                    
			Если элФормы.Имя = Форма.Элементы.ГруппаДинСписков.Имя+ИмяОсновногоРеквизита Тогда
				элФормы.Видимость 							= Истина;
				ПоказалиДС									= Истина;
				Форма.Элементы.ГруппаДинСписков.ТекущаяСтраница 	= элФормы;
			Иначе
				элФормы.Видимость 	= Ложь;
			КонецЕсли;
		КонецЦикла;
		Форма.Элементы.Логотип.Видимость = Не ПоказалиДС;
	КонецЕсли;	
КонецПроцедуры
//	СтрНаправления 	= ПроцессыКлиентСервер_Ei.ПоследнийЭлементВложеннойКоллекции(мНаправления);		
//	ЗаполнитьСписокВызовов(сзВызовов,мНаправления,ОбъектОбработки,КонтекстВыполнения,КонтекстВыполнения.Объект);
//	Результат = ПроцессыКлиентСервер_Ei.ВыполнитьПоток(ОбъектОбработки,сзВызовов,КонтекстВыполнения);
//	Если Не СтрНаправления =  Неопределено И Не СтрНаправления.Тип = Тип("ЭлементГрафическойСхемыЗавершение") Тогда
//		//Если последний элемент не завершение то тут не м.б. результата
//		Результат = ОписаниеЗначенияВызовСервера_Ei.Подготовить(Неопределено,Новый УникальныйИдентификатор);
//	КонецЕсли;
//	Возврат Результат;	
КонецФункции

Функция ВыполнитьПоток(УникальныйИдентификатор, мНаправления, НастройкиОбработок, ДанныеКлиента, мОбъекты, ИзначальныйОбъект) Экспорт
//	сзВызовов 	= Новый СписокЗначений;
//	ОбъектОбработки.ПоказателиВыполненияПроцесса = Новый Структура;
//	#Если Клиент Тогда
//		Оповестить("ОбновитьСтатистикуВыполнения",,ОбъектОбработки);
//	#КонецЕсли	
	Перем Результат;
	Перем ИнфоОбОшибке;
	Если ЗначениеЗаполнено(ИзначальныйОбъект) И мНаправления.Количество() Тогда
		мНаправления[0].Уточнение = ИзначальныйОбъект; //Изначальное позиционирование объекта проведем	
	КонецЕсли;	
	ОбъектыВызовСервера_Ei.Установить(мОбъекты); //задаем контекст(параметры сеанса) или обнуляем их 	 
	Для Каждого Направление ИЗ мНаправления Цикл
		Если ТипЗнч(Направление.Значение) = Тип("Строка") Тогда
			//это шаг в том же направлении
			ИнфоОбОшибке= Неопределено;
			Настройка	= Неопределено; //Если обработчик найдем то тут будет настройки обработчика
			УточнитьОбъект(Направление, УникальныйИдентификатор, мОбъекты, ДанныеКлиента);   
			Обработчик  = ПолучитьОбработчикВыполнения(Направление,мНаправления,НастройкиОбработок,Настройка);
			Если Не Обработчик = Неопределено Тогда
				СобытиеОтладки 			= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Выполнние обработки <"+Направление.Значение+"> типа "+Обработчик.Свойства().Синоним+" ","Конструктор");
				ДатаНачалаВыполнения 	= ТекущаяУниверсальнаяДатаВМиллисекундах();
				Попытка	
					Результат = Обработчик.ВыполнитьОбработку(УникальныйИдентификатор, Настройка, ДанныеКлиента);
				Исключение
					ИнфоОбОшибке = ИнформацияОбОшибке();
				КонецПопытки;
			    ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
			    ВремяВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах()-ДатаНачалаВыполнения;
			    ЗафиксироватьРезультат(Направление.Значение, Результат, ИнфоОбОшибке, ВремяВыполнения, мОбъекты, ДанныеКлиента);		
			КонецЕсли;			
		ИначеЕсли ТипЗнч(Направление.Значение) = Тип("Массив") Тогда
			//тут пошли в разные направления
			Для Каждого мВложенногоНаправления ИЗ Направление.Значение Цикл
					
			КонецЦикла; 
		КонецЕсли;									
	КонецЦикла;		
	Возврат Результат;
//	СтрНаправления 	= ПроцессыКлиентСервер_Ei.ПоследнийЭлементВложеннойКоллекции(мНаправления);		
//	ЗаполнитьСписокВызовов(сзВызовов,мНаправления,ОбъектОбработки,КонтекстВыполнения,КонтекстВыполнения.Объект);
//	Результат = ПроцессыКлиентСервер_Ei.ВыполнитьПоток(ОбъектОбработки,сзВызовов,КонтекстВыполнения);
//	Если Не СтрНаправления =  Неопределено И Не СтрНаправления.Тип = Тип("ЭлементГрафическойСхемыЗавершение") Тогда
//		//Если последний элемент не завершение то тут не м.б. результата
//		Результат = ОписаниеЗначенияВызовСервера_Ei.Подготовить(Неопределено,Новый УникальныйИдентификатор);
//	КонецЕсли;
//	Возврат Результат;	
КонецФункции

Процедура ЗафиксироватьРезультат(ИмяЭлемента, Результат, ИнфоОбОшибке, ВремяВыполнения, мОбъекты, ДанныеКлиента)		
	мОбъекты.Добавить(Новый ФиксированнаяСтруктура("Имя,Результат",ИмяЭлемента,Результат));
	ОбъектыВызовСервера_Ei.Установить(мОбъекты); //Установим в параметре сеанса
	ДанныеКлиента.Вставить(ИмяЭлемента,Новый ФиксированнаяСтруктура("ИнфоОбОшибке, ВремяВыполнения, Контекст", ИнфоОбОшибке, ВремяВыполнения, Новый ФиксированныйМассив(мОбъекты)));
КонецПроцедуры

Функция ПолучитьОбработчикВыполнения(Направление, мНаправления, НастройкиОбработок, Настройка)
	ИмяЭлемента	= Направление.Значение; 
	мКлюч 		= СтрРазделить(ИмяЭлемента,ПроцессыКлиентСервер_Ei.стрРазделительИмени(),Ложь);
	Для Каждого Ключ ИЗ мКлюч Цикл
		СтрНастройка	= НастройкиОбработок.Получить(Ключ);
		Если Не СтрНастройка = Неопределено Тогда
			Настройка		= СтрНастройка.Настройка;	
			Возврат ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки().Получить(СтрНастройка.Обработчик);
		Иначе
			//это не настраеваемая обработка
			Обработчик = ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки().Получить(Ключ);
			Если Не Обработчик = Неопределено И Не Обработчик.Свойства().ИспользоватьНастройки Тогда
				//доп проверка что по ключу не получили чего то другого
				Настройка = Обработчик.СоздатьНастройку(Направление, мНаправления, НастройкиОбработок);
				Возврат Обработчик;	
			КонецЕсли;		
		КонецЕсли;
		Прервать; //Интересует только первый элемент массива
	КонецЦикла;		 	
КонецФункции

Функция ПолучитьСпециальныйКлючНастроек(КлючНастроек,ИмяЭлмента) Экспорт
	Возврат Новый Структура("КлючНастроек", ИмяЭлмента+"_"+КлючНастроек);	
КонецФункции		

// Функция - Уточнить объект, когда на линии (маршрута мы пишем выражение)
//
//
Процедура УточнитьОбъект(Направление, УникальныйИдентификатор, мОбъекты, ДанныеКлиента) Экспорт
	Перем ИнфоОбОшибке;
	ИмяЛинии 	= Направление.Значение;
	Уточнение	= Направление.Уточнение;
	Если Не ПустаяСтрока(Уточнение) Тогда
		//попытаемся уточнить объект
		СобытиеОтладки 	= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Уточнение объекта на линии <"+ИмяЛинии+">","Процессы"); //тут нужно как уто указать ее имя
		Попытка
			Результат = ВыполнитьКлиентСервер_Ei.Выражение(Уточнение,УникальныйИдентификатор);
		Исключение
			ИнфоОбОшибке	=  ИнформацияОбОшибке();
		КонецПопытки;
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
		ЗафиксироватьРезультат(ИмяЛинии, Результат, ИнфоОбОшибке, 0, мОбъекты, ДанныеКлиента);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ГрафСхема

Функция ПолучитьУправялющиеЭлементы(ГрафСхема) Экспорт
	Результат = Новый Массив;
	ВозможныеТипы = ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьВозможныеТипыЭлементов();
	Для Каждого Элемент ИЗ  ГрафСхема.ЭлементыГрафическойСхемы Цикл
		Если ВозможныеТипы.СодержитТип(ТипЗнч(Элемент)) Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;	
	Возврат Результат;	
КонецФункции


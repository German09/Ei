//	#КонецЕсли	
	ДанныеКлиента   	= Новый Соответствие();
	мНаправленияКэш 	= ПроцессыКлиентСерверПовтИсп_Ei.ПолучитьМассивНаправления(ГрафСхемаXDTO);

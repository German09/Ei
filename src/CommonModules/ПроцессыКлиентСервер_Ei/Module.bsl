
#Область ИсполнениеГрафСхемы

// Процедура - Выполнить процесс и вернуть результат
//
// Параметры:
//  ОбъектОбработки		 	- Форма или Элемент дерева 	- Объект в котором находится ГрафСхемаXDTO                       
//  КонтекстВыполнения	 	- Структура		 - Структура контекста выполнения 
//												Параметры
//												ЭтаФорма
//												Объект
// Возвращаемое значение:
//   - ОписаниеЗначения
//
Функция ВыполнитьПроцесс(ОбъектОбработки,КонтекстВыполнения) Экспорт
	сзВызовов 	= Новый СписокЗначений;
	ОбъектОбработки.ПоказателиВыполненияПроцесса = Новый Структура;
	#Если Клиент Тогда
		Оповестить("ОбновитьСтатистикуВыполнения",,ОбъектОбработки);
	#КонецЕсли	
	ГрафСхема 	= ОбщийМодульКлиентСервер_Ei.Структурировать(ОбъектОбработки.ГрафСхемаXDTO,Новый ГрафическаяСхема);
	мНаправления 	= ПроцессыВызовСервера_Ei.ПолучитьМассивНаправления(ГрафСхема);
	СтрНаправления 	= ПроцессыКлиентСервер_Ei.ПоследнийЭлементВложеннойКоллекции(мНаправления);		
	ЗаполнитьСписокВызовов(сзВызовов,мНаправления,ОбъектОбработки,КонтекстВыполнения,КонтекстВыполнения.Объект);
	Результат = ПроцессыКлиентСервер_Ei.ВыполнитьПоток(ОбъектОбработки,сзВызовов,КонтекстВыполнения);
	Если Не СтрНаправления =  Неопределено И Не СтрНаправления.Тип = Тип("ЭлементГрафическойСхемыЗавершение") Тогда
		//Если последний элемент не завершение то тут не м.б. результата
		Результат = ОписаниеЗначенияВызовСервера_Ei.Подготовить(Неопределено,Новый УникальныйИдентификатор);
	КонецЕсли;
	Возврат Результат;	
КонецФункции

// Функция - Формирует структуру описания потока выполнения и запускает сам поток
//
// Параметры:
//  ОбъектОбработки	 			- Форма или Элемент дерева - Объект в котором находится ГрафСхемаXDTO	для серверного вызова Структура со свойствами: Ключ и ВозврЗначение		  
//  сзВызовов		 			- СписокЗначений	 		- Последовательность подготовленных ОписанийОповещений
//  Контекст		 			- Структура		 		- Структура контекста выполнения 
//													Параметры
//													ЭтаФорма
//													Объект
//	ПредОбработка_ДопПараметры	- Стурктура - Структура дополнительных параметров
//	ЭтоФоновоеЗадание			- Булево - признак фонового задания, при этом возникает необходимость обновить адреса временного хранилища возвращаемых значений в сзВызовов, см. ОбновитьАдреса()											
// 
// Возвращаемое значение:
//   - ОписаниеЗначения
//
Функция ВыполнитьПоток(ОбъектОбработки,сзВызовов,Контекст,ПредОбработка_ДопПараметры = Неопределено,ЭтоФоновоеЗадание = Ложь) Экспорт
	ОписаниеПотока = Новый Структура;
	ОписаниеПотока.Вставить("сзВызовов",ОбновитьАдреса(сзВызовов,ЭтоФоновоеЗадание));	
	ОписаниеПотока.Вставить("ОбъектОбработки",ОбъектОбработки); 						//Для отображения факта выполнения
	ОписаниеПотока.Вставить("ДатаНачала",0); 											//Для подсчета времени выполненя обработки
	ОписаниеПотока.Вставить("ПредОбработка_ДопПараметры",ПредОбработка_ДопПараметры); 	//Для уточнения объекта в рамках маршрута раздвоения потока см. ПереопределитьОбъект()
	ОписаниеПотока.Вставить("Контекст",	Контекст);	
	//Выполняем переход к первой обработке потока
	ВыполнитьПереходКСледующейОбработке(ОписаниеПотока,Истина);
	Если ОписаниеПотока.Контекст.Свойство("Результат") Тогда // это свойство повлется только после выполнения ОО_ЗавершениеПотока без него результат будет в ОписаниеПотока.сзВызовов[0].Значение.ДополнительныеПараметры.ВозвращаемоеЗначение  #1
		Результат = ОписаниеПотока.Контекст.Результат;
		#Если Сервер Тогда
			Если ЭтоФоновоеЗадание Тогда
				//вернем результат выполнения всего потока в родительский поток #1 переложим из одного адреса в другой 			
				ПоместитьВоВременноеХранилище(СтруктурыЗначенийВызовСервера_Ei.ПереопределитьЗначение(Результат), ОбъектОбработки.ВозврЗначение); //#1
			КонецЕсли;				
		#КонецЕсли
		Возврат Результат;		
	КонецЕсли;	
КонецФункции

// Процедура - Выполняет, один шаг, переход к процедуре выполнения обработки, или запускает выполнение новых потоков (последовательности выполнения)
// Обратный вызов процедуры происходит из процедур ВыполнитьОбработку ОбработкиEi_
//
// Параметры:
//  ОписаниеПотока	 	- Структура 			- Структура формируемая процедурой ВыполнитьПоток()
//													- сзВызовов 		- СписокЗначений			- Последовательность подготовленных ОписанийОповещений вызова обоработок, первой располагется следующая к запуску обработка
//													- ОО				- Описание оповещения   	- Обрабтный вызов из процедуры выполнения обработки, процедуры менеджера потоков
//													- Контекст  		- Структура  				- Аналог структуры "ДоступныеСтруктуры" из переменной формы СтруктураПеременных
//													- ОбъектОбработки   - Форма и Элемент дерева 	- Объект в котором находится ГрафСхемаXDTO
//                                      			- ДатаНачала		- Число 					- Хранит текущую универсальную дату запуска послдней обработки
//  ПервыйШагПотока		- Булево 				- Признак первого шага, во время него не производится анализ и доп обработки предыдущего шага
//	ИнформацияОбОшибке	- ИнформацияОбОшибке 	- Информация об ошибке предыдущего выполнения обработки, если все ОК, то Неопределено
//
Процедура ВыполнитьПереходКСледующейОбработке(ОписаниеПотока,ПервыйШагПотока = Ложь,ИнформацияОбОшибке = Неопределено) Экспорт
	//Перем ПредОбработка_ДопПараметры;
	ПредОбработка_ДопПараметры = ОписаниеПотока.ПредОбработка_ДопПараметры; //несет ценность только для первого вызова после раздвоения на несколько потоков
	Если Не ПервыйШагПотока И ОписаниеПотока.сзВызовов.Количество() Тогда
		ПредОбработка = ОписаниеПотока.сзВызовов[0];
		ПредОбработка_ДопПараметры = ПредОбработка.Значение.ДополнительныеПараметры; 
		ЗафиксироватьВыполнениеОбработки(ОписаниеПотока,ПредОбработка.Представление,ИнформацияОбОшибке);
		//Удалим предыдущую обработку
		ОписаниеПотока.сзВызовов.Удалить(ПредОбработка);
		Если Не ИнформацияОбОшибке = Неопределено И Истина Тогда
			//выполним прервыание в случае ошибки
			сДополнениеОшибки = ИнформацияОбОшибке.Описание;	
			ВызватьИсключение сДополнениеОшибки;
		КонецЕсли;	
	КонецЕсли;
	Для Каждого ОбъектПотока ИЗ ОписаниеПотока.сзВызовов Цикл
		Если ЭтоУказательВыполнения(ОбъектПотока.Значение) Тогда
			ОписаниеПотока.ДатаНачала					=  ТекущаяУниверсальнаяДатаВМиллисекундах();
			ОписаниеПотока.ПредОбработка_ДопПараметры	=  ПредОбработка_ДопПараметры;
			Если Не ПредОбработка_ДопПараметры = Неопределено Тогда
				ОписаниеПотока.Контекст.Объект = ПереопределитьОбъект(ОбъектПотока.Представление,ПредОбработка_ДопПараметры.ВозвращаемоеЗначение, ОбъектПотока.Значение.ДополнительныеПараметры.Уточнение, ОписаниеПотока.Контекст, ОписаниеПотока.Контекст.Объект);
			КонецЕсли;
			#Если Клиент Тогда
				ОО_КСледующей = Новый ОписаниеОповещения("ОО_ВыполнитьПереходКСледующейОбработке",ПроцессыКлиент_Ei,ОписаниеПотока);
				ВыполнитьОбработкуОповещения(ОбъектПотока.Значение,ОО_КСледующей); //выполняем новую обработку за счет выполнения ОО_ВыполнитьОбработку, после ее выполнения будет вызвана ОО_КСледующей
			#Иначе
				ПроцессыВызовСервера_Ei.ВыполнитьОбработку(ОбъектПотока.Значение,ОписаниеПотока)
			#КонецЕсли		
		ИначеЕсли ТипЗнч(ОбъектПотока.Значение) = Тип("Структура") Тогда
			//тут разные направления 
			Если Не ПредОбработка_ДопПараметры = Неопределено Тогда 
				//попытаемся вычислить путь
				КлючевоеУсловиеНаправления 	= СтруктурыЗначенийВызовСервера_Ei.ПереопределитьЗначение(ПредОбработка_ДопПараметры.ВозвращаемоеЗначение,ОбъектПотока.Значение.ТипУсловия);
				сзВызовов = ОбъектПотока.Значение.сооВызовов.Получить(КлючевоеУсловиеНаправления);
				Если Не сзВызовов =  Неопределено Тогда
					ПроцессыКлиентСервер_Ei.ВыполнитьПоток(ОписаниеПотока.ОбъектОбработки,сзВызовов,ОписаниеПотока.Контекст,ПредОбработка_ДопПараметры);
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
		Прервать; //только один раз
	КонецЦикла;	
КонецПроцедуры

// Функция - Переопределить объект, когда на линии(маршрута мы пишем выражение)
//
// Параметры:
//	ИмяОбработки			- Строка - Имя обработки для индикации отладки	
//  ВозврЗначение			- ФиксированнаяСтруктура - Описание возврашаемого значения предыдущего шага обработки 
//  Уточнение				- Строка	 - Выражение на встроенном языке, наименование линии маршрута
//  КонтекстПредОбработки	- Структура - Структура контекста выполнения актуальная на момент предыдущей обработки 
//												Параметры
//												ЭтаФорма
//												Объект
// 
//  Объект					- ФиксированнаяСтруктура - Описание текущего объекта контекста 
// 
// Возвращаемое значение:
//   - ФиксированнаяСтруктура - Объект передаваемый в обработку
//
Функция ПереопределитьОбъект(ИмяОбработки, ВозврЗначение, Уточнение, КонтекстПредОбработки, Объект) Экспорт
	Результат = ВозврЗначение; //по умолчанию возвращаем стрктуру возвращаемого значения предыдущего вызова
	Если Не ПустаяСтрока(Уточнение) Тогда
		//попытаемся уточнить объект
		СобытиеОтладки 			= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Уточнение объекта при переходе к обработке <"+ИмяОбработки+">","Процессы"); //тут нужно как уто указать ее имя
		Попытка
			Результат	= ВыполнитьКлиентСервер_Ei.Выражение(Уточнение,Новый УникальныйИдентификатор,,КонтекстПредОбработки);
			ИнфоОбОшибке = Неопределено;
		Исключение
			ИнфоОбОшибке	=  ИнформацияОбОшибке();
		КонецПопытки;
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
	КонецЕсли;
	Если СброситьВозврЗначениеВызова(Результат) Тогда
		Результат = Объект; //Будем считать что мы обрабатываем контекст объекта
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Функция - Определяет выполнять сброс возвр значения предыдущего вызова ил передать его дальше по списку вызовов
// Если пердыдущий алгоритм ничего не возвращает "ВозвращаемоеЗначение"  или возвращает типы для которых предусмотрены фисксированные элементы графической схемы см. ДобавитьОбработкуВГрафСхему()
// то будем считать что мы обрабатываем контекст объекта
//
// Параметры:
//  ВозвращаемоеЗначение - Фиксированная структура - ОписаниеЗначения результата выполнения предыдущего алгоритма 
// 
// Возвращаемое значение:
//   - Булево
//
Функция СброситьВозврЗначениеВызова(ВозвращаемоеЗначение)
	Результат = Ложь;
	Если ВозвращаемоеЗначение = Неопределено Тогда
		Результат = Истина;
	ИначеЕсли ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеНеопределенногоЗначения(ВозвращаемоеЗначение) Тогда 	
		Результат = Истина;
		
	//в данном случае возвращаемое значение предыдуще обработки только определяло маршрутизацию и не может считаться переданным объектом
	//объектом обработки будем считать то же что являлось объектом для предыдущей обработки
	
	//ИначеЕсли ВозвращаемоеЗначение.ОписаниеТипов = ОбщийМодульКлиентСервер_Ei.ПолучитьИмяТипЗнч(Тип("Булево")) Тогда
	//	Результат = Истина;
	//ИначеЕсли СтрНачинаетсяС(ВозвращаемоеЗначение.ОписаниеТипов,ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().Перечисления) Тогда
	//	Результат = Истина;
	КонецЕсли;	
	Возврат Результат;
КонецФункции

Функция ЭтоУказательВыполнения(Значение,Имябработчика = Неопределено)
	Перем ДопПараметры;
	Результат = Ложь;
	#Если Клиент Тогда
		Результат 		= ТипЗнч(Значение) = Тип("ОписаниеОповещения");
		Если Результат Тогда
			ДопПараметры    = Значение.ДополнительныеПараметры;
		КонецЕсли;	
	#Иначе
		Результат		= ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(Значение,"ИмяОбработчика");
		Если Результат Тогда
			ДопПараметры    = Значение;
		КонецЕсли;	
	#КонецЕсли
	Если Результат И Не  Имябработчика = Неопределено Тогда
		Результат = (Имябработчика = ДопПараметры.Имяобработчика);		
	КонецЕсли;
	Возврат Результат;
КонецФункции	

// Функция - Определяет ключевое условие/значение по которому будет запускаться это направление
//
// Параметры:
//  Тип					 - ТипЭлементовГрафическойСхемы	 - 
//  мНаправления		 - Массив - 
//  ВозвращаемоеЗначение - ФиксированнаяСтруктура - Описание возврашаемого значения предыдущего шага обработки	 - 
// 
// Возвращаемое значение:
//   - Булево, Значение перечисления
//
Функция ОпределитьКлючевоеУсловиеНаправления(Тип,мНаправления,ВозвращаемоеЗначение) Экспорт
	Результат = Неопределено;
	Если мНаправления.Количество() Тогда
		Если Тип = Тип("ЭлементГрафическойСхемыУсловие") Тогда
			стрИмяЛинии = мНаправления[0].Условие;
			//тут возможны Истина или Ложь, будем орентироваться на окончание элемента названия линии/ребра
			Результат 	= СтрЗаканчиваетсяНа(стрИмяЛинии,стрРазделительИмени()+1);
		ИначеЕсли Тип = Тип("ЭлементГрафическойСхемыВыборВарианта") Тогда
			стрИмяВарианта = мНаправления[0].Условие;
			Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ВозвращаемоеЗначение) Тогда
				Если СтрНачинаетсяС(ВозвращаемоеЗначение.ОписаниеТипов,ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().Перечисления) Тогда
					сооЗначений	= ОбщийМодульВызовСервера_Ei.ПолучитьЗначенияПеречисления(ВозвращаемоеЗначение.ОписаниеТипов);
					стрЗначение = сооЗначений.Получить(стрИмяВарианта); 
					Если Не стрЗначение = Неопределено Тогда
						Результат 	= стрЗначение.Значение;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
		ИначеЕсли Тип = Тип("ЭлементГрафическойСхемыРазделение") Тогда
			Результат = мНаправления[0].Условие;  //тут ключом будет просто имя линии/маршрута
		КонецЕсли;
	КонецЕсли;	
	Возврат Результат;
КонецФункции

// Функция - Получает последний элемент направления процесса графической схемы
//
// Параметры:
//  Коллекция - Массив,СписокЗначений или Структура -   
// 
// Возвращаемое значение:
//   - Структура
//
Функция ПоследнийЭлементВложеннойКоллекции(Коллекция) Экспорт
	Если ТипЗнч(Коллекция) =  Тип("Массив") Тогда
		Если Коллекция.Количество() Тогда
			Возврат ПоследнийЭлементВложеннойКоллекции(Коллекция[Коллекция.ВГраница()]);	
		КонецЕсли;
	ИначеЕсли ТипЗнч(Коллекция) =  Тип("Структура") Тогда
		//разделение на несколько путей
		Если Коллекция.Свойство("Значение") И ТипЗнч(Коллекция.Значение) = Тип("Массив") Тогда
			//тут вложенный массив направлений см. ПроцессыВызовСервера_Ei.ДополнитьМассивНаправления()
			Возврат ПоследнийЭлементВложеннойКоллекции(Коллекция.Значение);	
		ИначеЕсли Коллекция.Свойство("сооВызовов") Тогда
			//тут вложенный список вызовов см. ЗаполнитьСписокВызовов()
			Возврат ПоследнийЭлементВложеннойКоллекции(Коллекция.сооВызовов);
		Иначе
			Возврат Коллекция; 
		КонецЕсли 	
	ИначеЕсли ТипЗнч(Коллекция) =  Тип("СписокЗначений") Тогда
		Если Коллекция.Количество() Тогда
			Возврат ПоследнийЭлементВложеннойКоллекции(Коллекция[Коллекция.Количество()-1].Значение);	
		КонецЕсли;
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Для Каждого КлючЗначение ИЗ Коллекция  Цикл
			Возврат ПоследнийЭлементВложеннойКоллекции(КлючЗначение.Значение);	//возьмем только первый (пока первый или последний не столь важно)
		КонецЦикла;	
	Иначе
		Возврат Коллекция;
	КонецЕсли;	
КонецФункции

// Процедура - Заполняет массив вызовов на основании массив направления 
// 
// Параметры:
//  сзВызовов		 		- СписокЗначений - Возвращаемый/пополняемый параметр  в значении: последовательность подготовленных ОписанийОповещений, в представлении: Имя блока в графической схеме
//  мНаправления	 		- Массив - Коллекция структур со свойствами 
//																- Тип 		- ТипЭлеменаГрафическойСхемы
//																- Значение 	- Имя элемента грфической схемы или массив новых направлений
//																- Условие	- Имя варианта или имя линии(для условия)
//																- Уточение	- Наименование линии
//  ОбъектОбработки	 		- Форма или Элемент дерева 	- Объект в котором находится Дерево Доступных обработок
//  КонтекстВыполнения	 	- Структура		 - Структура контекста выполнения 
//												Параметры
//												ЭтаФорма
//												Объект
// стрВозвращаемоеЗначение 	- Структура - Описание возврашаемого значения предыдущего шага обработки, задается при старте и в случае рекурсивного вызова/развилки по направлениям, 
//											своства структуры возвращаются функцией ОписаниеЗначенияВызовСервера_Ei.Получить()
//
Процедура ЗаполнитьСписокВызовов(сзВызовов,мНаправления,ОбъектОбработки,КонтекстВыполнения,Знач стрВозвращаемоеЗначение = Неопределено) Экспорт
	Перем стрВозвращаемоеЗначениеНовое;
	Для Каждого СтрНаправления ИЗ мНаправления Цикл
		Если ТипЗнч(СтрНаправления.Значение) = Тип("Строка") Тогда
			//это шаг в том же направлении
			Если СтрНаправления.Тип = Тип("ЭлементГрафическойСхемыЗавершение") Тогда
				ДобавитьЗавершениеПотока(сзВызовов, КонтекстВыполнения, стрВозвращаемоеЗначение, СтрНаправления);
			ИначеЕсли СтрНаправления.Тип = Тип("ЭлементГрафическойСхемыРазделение") Тогда
				ОО_ДопПараметры	= Новый Структура;
				ОО_ДопПараметры.Вставить("Уточнение",СтрНаправления.Уточнение);
				ОО_ДопПараметры.Вставить("Объект",ПроцессыКлиентСервер_Ei.ПереопределитьОбъект(СтрНаправления.Значение,стрВозвращаемоеЗначение, ОО_ДопПараметры.Уточнение, КонтекстВыполнения, КонтекстВыполнения.Объект));
				ОО_ДопПараметры.Вставить("ИмяОбработки",СтрНаправления.Значение);
				ОО_ДопПараметры.Вставить("ВозвращаемоеЗначение",Неопределено);
				ОО_ДопПараметры.Вставить("ИмяОбработчика","ОбработкиПредопределенныеEi_НачалоФоновогоПотока"); //для переобразования списка описаний оповещения в последовательность обработчиков доступную на сервере, см. ПреобразоватьСписокОповещений()

				сВызоваЗначение = СформироватьЗначениеВызова(ОО_ДопПараметры,"ОО_ФоновыйПотокНачало",ПроцессыКлиентСервер_Ei); //это блок необходим для того чтобы поток мог возвращать результат и отображать его в конструкторе
				сзВызовов.Добавить(сВызоваЗначение,СтрНаправления.Значение);
			ИначеЕсли СтрНаправления.Тип = Тип("ЭлементГрафическойСхемыСлияние") Тогда			
				ОО_ДопПараметры	= Новый Структура;
				ОО_ДопПараметры.Вставить("Уточнение",СтрНаправления.Уточнение);
				ОО_ДопПараметры.Вставить("Объект",ПроцессыКлиентСервер_Ei.ПереопределитьОбъект(СтрНаправления.Значение,стрВозвращаемоеЗначение, ОО_ДопПараметры.Уточнение, КонтекстВыполнения, КонтекстВыполнения.Объект));
				ОО_ДопПараметры.Вставить("ИмяОбработки",СтрНаправления.Значение);
				ОО_ДопПараметры.Вставить("ВозвращаемоеЗначение",Неопределено);
				ОО_ДопПараметры.Вставить("ИмяОбработчика",ИмяОбработчикаЗавершенияФоновогоПотока()); //для переобразования списка описаний оповещения в последовательность обработчиков доступную на сервере, см. ПреобразоватьСписокОповещений()
				
				сВызоваЗначение	= СформироватьЗначениеВызова(ОО_ДопПараметры,"ОО_ФоновыйПотокЗавершение",ПроцессыКлиентСервер_Ei); //это блок необходим для того чтобы поток мог возвращать результат и отображать его в конструкторе
				сзВызовов.Добавить(сВызоваЗначение,СтрНаправления.Значение);
			Иначе	
				СтрокаОбработки = ПолучитьДоступнуюОбработку(ОбъектОбработки.ДоступныеОбработки,СтрНаправления.Значение);	
				Если Не СтрокаОбработки =  Неопределено Тогда
					стрИмен							= ПолучитьИмяОбработки(СтрокаОбработки);
					ФормаОбработки					= Неопределено;
					#Если Клиент Тогда
						ФормаОбработки  		= ПолучитьФорму(стрИмен.Форма);
						ФормаОбработки.СтрокаОбработки = СтрокаОбработки; //сохраним в нее исходную строку обработки чтобы сохранить в нее индикацию на схеме
						ФормаОбработки.ЗагрузитьНастройку(СтрокаОбработки.Настройка,Ложь); //Загружаем настройку чтобы не делать это несколько раз и не тратить на это время при исполнении
						//тут получаем адрес в котором будет размещатся результат выполнения, важно то что адрес получаем именно предварительно и в процессе выполнения сораняем туда значение
						стрВозвращаемоеЗначениеНовое	= ФормаОбработки.ПолучитьОписаниеВозврЗначения(КонтекстВыполнения); 
					#Иначе
						стрВозвращаемоеЗначениеНовое 	= ОписаниеЗначенияВызовСервера_Ei.Подготовить(Неопределено); //адресов тут не будет возможно ошибока и нужно указат Уникальный идентификатор см.ПолучитьНовыйАдрес() 
					#КонецЕсли	
					
					ОО_ДопПараметры	= Новый Структура;
					ОО_ДопПараметры.Вставить("Настройка",СтрокаОбработки.Настройка);
					ОО_ДопПараметры.Вставить("Уточнение",СтрНаправления.Уточнение);					
					ОО_ДопПараметры.Вставить("Объект",ПроцессыКлиентСервер_Ei.ПереопределитьОбъект(СтрНаправления.Значение,стрВозвращаемоеЗначение, ОО_ДопПараметры.Уточнение, КонтекстВыполнения, КонтекстВыполнения.Объект));					
					ОО_ДопПараметры.Вставить("ВозвращаемоеЗначение",стрВозвращаемоеЗначениеНовое);
					ОО_ДопПараметры.Вставить("ИмяОбработки",СтрНаправления.Значение);
					ОО_ДопПараметры.Вставить("ИмяОбработчика",стрИмен.Объект); //для переобразования списка описаний оповещения в последовательность обработчиков доступную на сервере, см. ПроцессыКлиент_Ei.ПреобразоватьСписокОповещений() 
					стрВозвращаемоеЗначение = стрВозвращаемоеЗначениеНовое;  //для следующего цикла
					
					сВызоваЗначение = СформироватьЗначениеВызова(ОО_ДопПараметры,"ОО_ВыполнитьОбработку",ФормаОбработки);
					сзВызовов.Добавить(сВызоваЗначение,СтрНаправления.Значение);
				КонецЕсли;
			КонецЕсли;	
		ИначеЕсли ТипЗнч(СтрНаправления.Значение) = Тип("Массив") Тогда
			КлючевоеУсловие = Неопределено;
			сооВызовов 		= Новый Соответствие;
			стрВызовов		= Новый Структура("сооВызовов",сооВызовов);
			сзВызовов.Добавить(стрВызовов);
			//тут пошло в разные направления
			Для Каждого мВложенногоНаправления ИЗ СтрНаправления.Значение Цикл
				сзВложенногоВызова 	= Новый СписокЗначений;
				КлючевоеУсловие		= ПроцессыКлиентСервер_Ei.ОпределитьКлючевоеУсловиеНаправления(СтрНаправления.Тип,мВложенногоНаправления,стрВозвращаемоеЗначение);
				сооВызовов.Вставить(КлючевоеУсловие,сзВложенногоВызова);
				ЗаполнитьСписокВызовов(сзВложенногоВызова,мВложенногоНаправления,ОбъектОбработки,КонтекстВыполнения,стрВозвращаемоеЗначение);
				Если СтрНаправления.Тип = Тип("ЭлементГрафическойСхемыРазделение") Тогда
					//подразумевается что это развилка по разным потокам
					ДобавитьЗавершениеПотока(сзВложенногоВызова, КонтекстВыполнения, стрВозвращаемоеЗначение, СтрНаправления); //#1 нужно возвращать значение из фонового потока	
				КонецЕсли;	
			КонецЦикла;
			стрВызовов.Вставить("ТипУсловия",ОбщийМодульКлиентСервер_Ei.СоздатьОписаниеТиповНаОсновеКолекции(ТипЗнч(КлючевоеУсловие))); 
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры

// Обновить адреса. Необходимость обновить адреса временного хранилища возникает при вызове фонового задания, 
// если адреса оставить прежние то по ним не получится получить внутри! фонового задания всегда после помещения будет возвращаться неопределенно
// это потому что его получение будет доступно только внутри потока вызвавшего фоновое задание
// https://its.1c.ru/db/v8312doc#bookmark:dev:TI000000819  
// 
// Параметры:
//  сзВызовов - СписокЗначений - Сз вызовов
//  ОбновитьАдреса - Булево - Обновить адреса
// 
// Возвращаемое значение:
//  СписокЗначений - с обноленными адресами возвращаемых результатов и 
Функция ОбновитьАдреса(сзВызовов,ОбновитьАдреса) 
	Перем ВозвращаемоеЗначение,Объект;
	сооПроизведенныхЗамен 	= Новый Соответствие(); //кэшируем замены
	Результат 				= сзВызовов;
	Если ОбновитьАдреса Тогда
		//обновим адреса, но обычно они идут парой то что в одном элементе будет в ВозвращаемоеЗначение в следующем элементе будет в Объект
		//поэтому мы запоминаем замены  	
		Для Каждого ЭлСз Из сзВызовов Цикл
			Если ЭлСз.Значение.ДополнительныеПараметры.Свойство("ВозвращаемоеЗначение",ВозвращаемоеЗначение) Тогда	
				ЭлСз.Значение.ДополнительныеПараметры.ВозвращаемоеЗначение = ПолучитьНовыйАдрес(сооПроизведенныхЗамен, ВозвращаемоеЗначение);	
			КонецЕсли;
			Если ЭлСз.Значение.ДополнительныеПараметры.Свойство("Объект",Объект) Тогда	
				ЭлСз.Значение.ДополнительныеПараметры.Объект = ПолучитьНовыйАдрес(сооПроизведенныхЗамен, Объект);
			КонецЕсли;	
		КонецЦикла;	 	
	КонецЕсли;	
	Возврат Результат;	
КонецФункции	

// Получить новый адрес
// 
// Параметры:
//  сооПроизведенныхЗамен - Соответствие - Кэш произведенных замен
//  ОписаниеЗначения 	- ФиксированнаяСтруктура - Кандидат на Описание значения
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура Описание значения
// * ОписаниеТипов 
// * Значение 
// * Ссылка 
// * ПредставлениеЗначения 
// * ОбъемКоллекции 
Функция ПолучитьНовыйАдрес(сооПроизведенныхЗамен, ОписаниеЗначения)
	Перем НовоеОписание;
	Перем Ключ;
	Результат = ОписаниеЗначения; 
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ОписаниеЗначения) Тогда
		Ключ = ОписаниеЗначения.Ссылка;
		НовоеОписание = сооПроизведенныхЗамен.Получить(Ключ);
		Если НовоеОписание = Неопределено Тогда
			НовоеОписание = ОписаниеЗначенияВызовСервера_Ei.Подготовить(Неопределено, Новый УникальныйИдентификатор);
			сооПроизведенныхЗамен.Вставить(Ключ,НовоеОписание);	
		КонецЕсли;
		Результат = НовоеОписание;							
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура ДобавитьЗавершениеПотока(сзВызовов, КонтекстВыполнения, стрВозвращаемоеЗначение, СтрНаправления)
	ОО_ДопПараметры	= Новый Структура;
	ОО_ДопПараметры.Вставить("Уточнение",СтрНаправления.Уточнение);
	ОО_ДопПараметры.Вставить("Объект",ПроцессыКлиентСервер_Ei.ПереопределитьОбъект(СтрНаправления.Значение,стрВозвращаемоеЗначение, ОО_ДопПараметры.Уточнение, КонтекстВыполнения, КонтекстВыполнения.Объект));
	ОО_ДопПараметры.Вставить("ИмяОбработки",СтрНаправления.Значение);
	ОО_ДопПараметры.Вставить("ИмяОбработчика","ОбработкиПредопределенныеEi_ЗавершениеПотока"); //для переобразования списка описаний оповещения в последовательность обработчиков доступную на сервере, см. ПреобразоватьСписокОповещений()
	
	сВызоваЗначение = СформироватьЗначениеВызова(ОО_ДопПараметры,ИмяФункцииЗавершенияПотока(),ПроцессыКлиентСервер_Ei); //это блок необходим для того чтобы поток мог возвращать результат и отображать его в конструкторе
	сзВызовов.Добавить(сВызоваЗначение,СтрНаправления.Значение);
КонецПроцедуры

// Функция - Сформировать значение сохраняемое в списке вызовов это либо 
//
// Параметры:
//  ДополнительныеПараметры	 - Структура	 - Структура праметров 
//  ИмяПроцедуры			 - Строка	 -  Имя процедуры
//  ИмяМодуля				 - Модуль	 - Имя модуля
// 
// Возвращаемое значение:
//   -  ОписаниеОповещения или Структура указателя вызова 
//
Функция СформироватьЗначениеВызова(ДополнительныеПараметры,ИмяПроцедуры = Неопределено, ИмяМодуля = Неопределено) Экспорт
	#Если Клиент Тогда
		Если Не ИмяМодуля = Неопределено Тогда
			Возврат Новый ОписаниеОповещения(ИмяПроцедуры,ИмяМодуля,ДополнительныеПараметры);	
		КонецЕсли;	
	#КонецЕсли	
	Результат = Новый Структура("ДополнительныеПараметры,ИмяОбработчика",ДополнительныеПараметры,ДополнительныеПараметры.ИмяОбработчика);		
	ДополнительныеПараметры.Удалить("ИмяОбработчика");  //удалим чтобы не путаться
	Возврат Результат; 
КонецФункции	

// Функция - Получаеть имя формы обработки и самой обработки
//
// Параметры:
//  СтрокаОбработки	 - Данные формы дерева	 - Строка дерева доступных обработок
// 
// Возвращаемое значение:
//   -  Структура со свойствами: Форма,Объект
//
Функция ПолучитьИмяОбработки(СтрокаОбработки) Экспорт
	Результат = Новый Структура("Форма,Объект");
	СтрокаВида 	= ?(ПолучитьРодителя(СтрокаОбработки) = Неопределено,СтрокаОбработки,ПолучитьРодителя(СтрокаОбработки));
	Результат.Объект 	= стрПрефиксОбработок()+СтрокаВида.Имя;	
	Результат.Форма 	= "Обработка."+стрПрефиксОбработок()+СтрокаВида.Имя+".Форма";	
	Возврат Результат;
КонецФункции

// Функция - Получает доступную обработку из дерева
//
// Параметры:
//  Дерево	 		- Данные формы дерево, Дерево значений	 - Дерево выбранных обработок
//  сИмя			- Строка	-  Имя элмента графической схемы
// 
// Возвращаемое значение:
//   - Строка дерева доступных обработок
//
Функция ПолучитьДоступнуюОбработку(Дерево,сИмя) Экспорт
	мИмяПоиска 		= СтрРазделить(сИмя,ПроцессыКлиентСервер_Ei.стрРазделительИмени(),Ложь);
	КоллекцияСтрок 	= ПолучитьЭлементы(Дерево);	
	Для Каждого сИмяПоиска ИЗ мИмяПоиска Цикл
		мСтрок = ОбщийМодульКлиентСервер_Ei.НайтиВКоллекцииДерева(Новый Структура("Имя",сИмяПоиска),КоллекцияСтрок);
		Если мСтрок.Количество() Тогда
			Возврат мСтрок[0];
		КонецЕсли;
		Прервать;
	КонецЦикла;
КонецФункции

// Процедура - выполняемая для блока "Завершения", по параметрам  аналог ОО_ВыполнитьОбработку в модуле формы обработок
// необходима для возвращение результата потока в функции ВыполнитьПоток() 
// последовательный запуск производится из ВыполнитьПереходКСледующейОбработке()
//
// Параметры:
// 	Контекст  	- Структура  		- Аналог структуры "ДоступныеСтруктуры" из переменной формы СтруктураПеременных
//
Процедура ЗавершениеПотока(Контекст) Экспорт
	Контекст.Вставить("Результат",Контекст.Объект);		
КонецПроцедуры

#Область ОбработчикиОповещений

// Процедура - выполняемая для блока "Завершения", по параметрам  аналог ОО_ВыполнитьОбработку в модуле формы обработок
// необходима для возвращение результата потока в функции ВыполнитьПоток() 
// последовательный запуск производится из ВыполнитьПереходКСледующейОбработке()
//
// Параметры:
//  ОО_КСледующей	 - ОписаниеОповещения 	- С переходом на функцию   ПроцессыКлиент_Ei.ОО_ВыполнитьПереходКСледующейОбработке() в дополнительных параметрах структура ОписаниеПотока, формируемая процедурой ПроцессыКлиент_Ei.ВыполнитьПоток()
//										- сзВызовов 	- СписокЗначений 	- Последовательность подготовленных ОписанийОповещений вызова обоработок, первой располагется следующая к запуску обработка
//										- Контекст  	- Структура  		- Аналог структуры "ДоступныеСтруктуры" из переменной формы СтруктураПеременных
//  ДопПараметры	 - Структура		- Структура, доп. параметров
//										- Настройка 			- Структура - настройка экземпляра обработки получаемая функцией ПолучитьНастройкуДляСохранения()
//										- ВозвращаемоеЗначение 	- Структура - описание возврашаемого значения в который нужно поместить результат выполнения, своства структуры формируются функцией ОписаниеЗначенияВызовСервера_Ei.Получить()
//                                      - ИмяОбработки			- Строка 	- Имя обработки как оно задано в дереве доступных обработок
Процедура ОО_ЗавершениеПотока(ОО_КСледующей, ДопПараметры) Экспорт
	ЗавершениеПотока(ОО_КСледующей.ДополнительныеПараметры.Контекст);
КонецПроцедуры

// Процедура - выполняемая для запуска фоновых заданий при разделении на графической схеме, по параметрам  аналог ОО_ВыполнитьОбработку в модуле формы обработок
// необходима для возвращение результата потока в функции ВыполнитьПоток() 
// последовательный запуск производится из ВыполнитьПереходКСледующейОбработке()
//
// Параметры:
//  ОО_КСледующей	 - ОписаниеОповещения 	- С переходом на функцию   ПроцессыКлиент_Ei.ОО_ВыполнитьПереходКСледующейОбработке() в дополнительных параметрах структура ОписаниеПотока, формируемая процедурой ПроцессыКлиент_Ei.ВыполнитьПоток()
//										- сзВызовов 	- СписокЗначений 	- Последовательность подготовленных ОписанийОповещений вызова обоработок, первой располагется следующая к запуску обработка
//										- Контекст  	- Структура  		- Аналог структуры "ДоступныеСтруктуры" из переменной формы СтруктураПеременных
//  ДопПараметры	 - Структура		- Структура, доп. параметров
//										- Настройка 			- Структура - настройка экземпляра обработки получаемая функцией ПолучитьНастройкуДляСохранения()
//										- ВозвращаемоеЗначение 	- Структура - описание возврашаемого значения в который нужно поместить результат выполнения, своства структуры формируются функцией ОписаниеЗначенияВызовСервера_Ei.Получить()
//                                      - ИмяОбработки			- Строка 	- Имя обработки как оно задано в дереве доступных обработок
//
Процедура ОО_ФоновыйПотокНачало(ОО_КСледующей,ДопПараметры) Экспорт
	//теперь все что ниже - до конца или до следующего соединения нужно выполнить в серверном потоке
	//переложим из одного массива в другой
	СобытиеОтладки 			= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Выполнение обработки <"+ДопПараметры.ИмяОбработки+">","Процессы"); //тут нужно как уто указать ее имя
	Попытка
		мФоновогоВыполнения = Новый Массив;
		мУдаления 			= Новый Массив;
		ОписаниеПотока 		= ОО_КСледующей.ДополнительныеПараметры;
		Для Каждого элСЗ из ОО_КСледующей.ДополнительныеПараметры.сзВызовов Цикл
			Если ЭтоУказательВыполнения(элСЗ.Значение,ПроцессыКлиентСервер_Ei.ИмяОбработчикаЗавершенияФоновогоПотока())  Тогда
				Прервать;
			ИначеЕсли ЭтоУказательВыполнения(элСЗ.Значение,ПроцессыКлиентСервер_Ei.ИмяОбработчикаНачалоФоновогоПотока())  Тогда
				Продолжить;	//так исключим добавление начало фонового потока, а то при переборе мФоновых м.б. ошибка 
			Иначе
			//Если ТипЗнч(элСЗ.Значение) = Тип("Структура") Тогда
			//	Если элСЗ.Значение.Свойство("сооВызовов") Тогда  
					мФоновогоВыполнения.Добавить(элСЗ.Значение);
					мУдаления.Добавить(элСЗ);
			//	КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;
		//и удалим их из списка вызовов что бы сразу перейти к слиянию/ОО_ФоновыйПотокЗавершение
		Для Каждого элСЗ ИЗ мУдаления Цикл
			ОО_КСледующей.ДополнительныеПараметры.сзВызовов.Удалить(элСЗ);		
		КонецЦикла;
		//теперь запустим потоки сохранив идентификаторы ФЗ и ключи 
		Результат = Новый Структура("мПотоков,ВхОбъект",Новый Массив,ОписаниеПотока.Контекст.Объект);
		Для Каждого ОбъектПотока ИЗ мФоновогоВыполнения Цикл //тут по сути д.б. один проход но оформим в цикл
			Для Каждого СооУсловий Из ОбъектПотока.сооВызовов Цикл
				сзВызовов = СооУсловий.Значение;				
				#Если Клиент Тогда 
					сзВызовов = ПроцессыКлиент_Ei.ПреобразоватьСписокОповещений(СооУсловий.Значение);
				#КонецЕсли	
				стрЗапускаПотока = ПроцессыВызовСервера_Ei.ЗапуститьПоток(СооУсловий.Ключ,сзВызовов,ОписаниеПотока.Контекст);
				Результат.мПотоков.Добавить(стрЗапускаПотока);
			КонецЦикла	
		КонецЦикла;
		ДопПараметры.ВозвращаемоеЗначение = Результат
	Исключение
		ИнфоОбОшибке	=  ИнформацияОбОшибке();
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
		#Если Клиент Тогда
			ВыполнитьОбработкуОповещения(ОО_КСледующей,ИнфоОбОшибке);//к ОО_ФоновыйПотокЗавершение Выполняется ПроцессыКлиент_Ei.ОО_ВыполнитьПереходКСледующейОбработке()
		#КонецЕсли	
		Возврат;
	КонецПопытки;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	#Если Клиент Тогда
		ВыполнитьОбработкуОповещения(ОО_КСледующей); //к ОО_ФоновыйПотокЗавершение Выполняется ПроцессыКлиент_Ei.ОО_ВыполнитьПереходКСледующейОбработке()
	#КонецЕсли	
КонецПроцедуры

// Процедура - выполняемая для ожидания завершения фоновых заданий при разделении на графической схеме, по параметрам  аналог ОО_ВыполнитьОбработку в модуле формы обработок
// необходима для возвращение результата потока в функции ВыполнитьПоток() 
// последовательный запуск производится из ВыполнитьПереходКСледующейОбработке()
//
// Параметры:
//  ОО_КСледующей	 - ОписаниеОповещения 	- С переходом на функцию   ПроцессыКлиент_Ei.ОО_ВыполнитьПереходКСледующейОбработке() в дополнительных параметрах структура ОписаниеПотока, формируемая процедурой ПроцессыКлиент_Ei.ВыполнитьПоток()
//										- сзВызовов 	- СписокЗначений 	- Последовательность подготовленных ОписанийОповещений вызова обоработок, первой располагется следующая к запуску обработка
//										- Контекст  	- Структура  		- Аналог структуры "ДоступныеСтруктуры" из переменной формы СтруктураПеременных
//  ДопПараметры	 - Структура		- Структура, доп. параметров
//										- Настройка 			- Структура - настройка экземпляра обработки получаемая функцией ПолучитьНастройкуДляСохранения()
//										- ВозвращаемоеЗначение 	- Структура - описание возврашаемого значения в который нужно поместить результат выполнения, своства структуры формируются функцией ОписаниеЗначенияВызовСервера_Ei.Получить()
//                                      - ИмяОбработки			- Строка 	- Имя обработки как оно задано в дереве доступных обработок
//
Процедура ОО_ФоновыйПотокЗавершение(ОО_КСледующей,ДопПараметры) Экспорт
	Перем РезультатОжидания;
	СобытиеОтладки 			= ОтладкаКлиентСервер_Ei.ДобавитьСобытие("Выполнение обработки <"+ДопПараметры.ИмяОбработки+">","Процессы"); //тут нужно как уто указать ее имя
	Попытка
		//Ожидаем завершения массива фоновых заданий наполненного в ОО_ФоновыйПотокНачало
		ОписаниеПотока 		= ОО_КСледующей.ДополнительныеПараметры;
		ОжиданиеЗавершения(ОписаниеПотока,РезультатОжидания);
		Пока РезультатОжидания.Завершено = Ложь Цикл	
			ОжиданиеЗавершения(ОписаниеПотока,РезультатОжидания);	
		КонецЦикла;
		////переопределяем объект, то что поступило на вход разделение, должно являеться выходным значением для всей конструкции - Слияния
		//ДопПараметры.ВозвращаемоеЗначение = ОписаниеПотока.Контекст.Объект.ВхОбъект;
		//#1 Вернем Описания значения - Массив всех результатов
		ДопПараметры.ВозвращаемоеЗначение = ПроцессыВызовСервера_Ei.ПолучитьОписанниеМассиваРезульатовФЗ(РезультатОжидания.мРезультатов);
		//Для Каждого ИтоговыйРезультат ИЗ РезультатОжидания.мРезультатов	Цикл
		//	ДопПараметры.ВозвращаемоеЗначение.Добавить(ИтоговыйРезультат); //В итоговом результате ожидается описание значения	
		//КонецЦикла;	
	Исключение
		ИнфоОбОшибке	=  ИнформацияОбОшибке();
		ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки,,ИнфоОбОшибке);
		#Если Клиент Тогда
			ВыполнитьОбработкуОповещения(ОО_КСледующей,ИнфоОбОшибке); //Выполняется ПроцессыКлиент_Ei.ОО_ВыполнитьПереходКСледующейОбработке()
		#КонецЕсли	
		Возврат;
	КонецПопытки;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки);
	#Если Клиент Тогда
		ВыполнитьОбработкуОповещения(ОО_КСледующей); //к следующей обработке после Слияния
	#КонецЕсли	
КонецПроцедуры

// Процедура - Ожидание завершения потоков с выводом накопленных сообщений
//
// Параметры:
//  ОписаниеПотока		 - Структура - Описание потока
//  РезультатОжидания	 - Структура - Возвращемый параметр
//
Процедура ОжиданиеЗавершения(ОписаниеПотока,РезультатОжидания)
	мПоказателиВыполненияПроцесса 	= Новый Массив;
	мПотоков 						= ОписаниеПотока.Контекст.Объект.мПотоков;
	РезультатОжидания   			= ПроцессыВызовСервера_Ei.ОжидатьЗавершенияПотоков(мПотоков, 1);
	Для Каждого стрЗапускаПотока из мПотоков Цикл
		Для Каждого СообщПольз Из стрЗапускаПотока.Сообщения Цикл
			СообщПольз.Сообщить();		
		КонецЦикла;
		Если Не стрЗапускаПотока.ПромежуточныйРезультат = Неопределено Тогда
			мПоказателиВыполненияПроцесса.Добавить(стрЗапускаПотока.ПромежуточныйРезультат.ПоказателиВыполненияПроцесса); 		
		КонецЕсли;	
		стрЗапускаПотока.Сообщения =  Новый Массив;
	КонецЦикла;
	Для Каждого ПоказателиВыполненияПроцесса ИЗ мПоказателиВыполненияПроцесса Цикл
		ДополнитьПоказательВыполнения(ОписаниеПотока, ПоказателиВыполненияПроцесса);
	КонецЦикла;	
КонецПроцедуры	

#КонецОбласти

#КонецОбласти

#Область Индикация

// Процедура - Фиксирует в отдельной структуре настроек, факт выполнения обработки или завершения ее с ошибкой
//
// Параметры:
//  ОписаниеПотока	 	- Структура - Структура формируемая процедурой ВыполнитьПоток()
//  ИмяЭлмента		 	- Строка	 - Имя элемента графической схемы к которому нужно добавить статус выполнения
//	ИнформацияОбОшибке  - ИнформацияОбОшибке - Информация об ошибке или непределено
//
Процедура ЗафиксироватьВыполнениеОбработки(ОписаниеПотока,ИмяЭлемента,ИнформацияОбОшибке) Экспорт
	Показатель = Новый Структура("Время,Ошибка",0);
	Если Не ИнформацияОбОшибке =  Неопределено Тогда
		Показатель.Ошибка 	= КраткоеПредставлениеОшибки(ИнформацияОбОшибке); //ИнформацияОбОшибке не сериализуется поэтому возможно только так.
	КонецЕсли;
	Если Не ОписаниеПотока.ДатаНачала = 0 Тогда
		Показатель.Время	= ТекущаяУниверсальнаяДатаВМиллисекундах() - ОписаниеПотока.ДатаНачала;	
	КонецЕсли;
	ПоказателиВыполненияПроцесса = Новый Структура(ИмяЭлемента,Показатель);
	ДополнитьПоказательВыполнения(ОписаниеПотока,ПоказателиВыполненияПроцесса);
Конецпроцедуры

Процедура ДополнитьПоказательВыполнения(ОписаниеПотока,ПоказателиВыполненияПроцесса)
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ОписаниеПотока.ОбъектОбработки,"Ключ") Тогда // ОписаниеПотока.ОбъектОбработки м.б. и Форма
		ПроцессыВызовСервера_Ei.ДополнитьПоказательВыполненияСервер(ОписаниеПотока.ОбъектОбработки.Ключ, ПоказателиВыполненияПроцесса);
	Иначе
		ОбщийМодульКлиентСервер_Ei.вСоединить(ОписаниеПотока.ОбъектОбработки.ПоказателиВыполненияПроцесса,ПоказателиВыполненияПроцесса);
	КонецЕсли;	
	#Если Клиент Тогда
		Оповестить("ОбновитьСтатистикуВыполнения",,ОписаниеПотока.ОбъектОбработки);
	#КонецЕсли
Конецпроцедуры	

#КонецОбласти

Функция стрРазделительИмени() Экспорт 
	Возврат "____";//4	
КонецФункции


// Выполнение процесса по графической схеме: обход направлений схемы, выполнение обработок
// и запоминание их результатов для следующих обработок, см. ОбъектыВызовСервера_Ei
// Процесс, выполняющийся в фоне, сообщает клиенту о ходе выполнения уведомлениями: какая обработка идет,
// сколько она заняла и какую строку коллекции обрабатывает «Для Каждого», см. СообщитьХод

#Область ПрограммныйИнтерфейс

// Выполняет процесс по графической схеме.
//
// Параметры:
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор для временного хранилища результатов
//  ГрафСхемаXDTO - Строка - сериализованная графическая схема процесса
//  НастройкиОбработок - ФиксированноеСоответствие из КлючИЗначение - настройки обработок схемы,
//    см. ОбработкиКлиентСервер_Ei.ПолучитьДанныеОбработок
//  ДанныеКлиента - Соответствие из КлючИЗначение - время, ошибка и контекст выполненных обработок по именам элементов схемы,
//    см. ЗафиксироватьРезультат; Неопределено - создается новое
//  Объекты - Массив из ФиксированнаяСтруктура - результаты предыдущих обработок, см. ЗафиксироватьРезультат
//  ИзначальныйОбъект - Строка - выражение объекта процесса, вычисляется перед первой обработкой
//  Ход - см. НовыйХод
//
// Возвращаемое значение:
//  Произвольный - результат последней выполненной обработки
//
Функция ВыполнитьПроцесс(УникальныйИдентификатор, ГрафСхемаXDTO, НастройкиОбработок, ДанныеКлиента, Объекты,
	ИзначальныйОбъект = Неопределено, Ход = Неопределено) Экспорт
	
	Если ТипЗнч(ДанныеКлиента) <> Тип("Соответствие") Тогда
		ДанныеКлиента = Новый Соответствие;
	КонецЕсли;
	// Копия: обработка может менять направления, см. ОбработкаНачалоПотокаКлиентСервер_Ei.СоздатьНастройку
	Направления = Новый Массив(Новый ФиксированныйМассив(ПроцессыКлиентСерверПовтИсп_Ei.ПолучитьМассивНаправления(ГрафСхемаXDTO)));
	
	Возврат ВыполнитьПоток(УникальныйИдентификатор, Направления, НастройкиОбработок, ДанныеКлиента, Объекты, ИзначальныйОбъект, Ход);
	
КонецФункции

// Выполняет обработки направлений схемы по порядку. Ошибка обработки поток не прерывает:
// она запоминается в данных клиента и показывается на схеме.
//
// Параметры:
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор для временного хранилища результатов
//  Направления - Массив из Структура - направления схемы, см. ПроцессыВызовСервера_Ei.ПолучитьМассивНаправления:
//   * Значение - Строка, Массив из Произвольный - имя элемента схемы или массивы вложенных направлений развилки
//   * Тип - Тип - тип элемента графической схемы
//   * Условие - Строка - имя варианта или линии условия
//   * Уточнение - Строка - выражение объекта на линии, входящей в элемент
//  НастройкиОбработок - см. ВыполнитьПроцесс.НастройкиОбработок
//  ДанныеКлиента - см. ВыполнитьПроцесс.ДанныеКлиента
//  Объекты - см. ВыполнитьПроцесс.Объекты
//  ИзначальныйОбъект - Строка, Неопределено - выражение объекта процесса, вычисляется вместо уточнения первого направления
//  Ход - см. НовыйХод
//
// Возвращаемое значение:
//  Произвольный - результат последней выполненной обработки
//
Функция ВыполнитьПоток(УникальныйИдентификатор, Направления, НастройкиОбработок, ДанныеКлиента, Объекты, ИзначальныйОбъект,
	Ход = Неопределено) Экспорт
	
	Результат = Неопределено;
	ОбъектыВызовСервера_Ei.Установить(Объекты); // контекст обработок в параметре сеанса
	ПервоеНаправление = Истина;
	Для Каждого Направление Из Направления Цикл
		Уточнение = Направление.Уточнение;
		// Направления схемы закэшированы: объект процесса не записывается в них, а подставляется
		Если ПервоеНаправление И ЗначениеЗаполнено(ИзначальныйОбъект) Тогда
			Уточнение = ИзначальныйОбъект;
		КонецЕсли;
		ПервоеНаправление = Ложь;
		// Развилка - массив вложенных направлений - не выполняется: потоки запускает обработка «Начало потока»
		Если ТипЗнч(Направление.Значение) = Тип("Строка") Тогда
			УточнитьОбъект(Направление.Значение, Уточнение, УникальныйИдентификатор, Объекты, ДанныеКлиента);
			Настройка = Неопределено;
			Обработчик = ПолучитьОбработчикВыполнения(Направление, Направления, НастройкиОбработок, Настройка);
			Если Обработчик <> Неопределено Тогда
				Результат = ВыполнитьОбработку(Обработчик, Направление.Значение, Настройка, УникальныйИдентификатор, Объекты,
					ДанныеКлиента, Ход);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Ключ настроек пользователя для элемента схемы процесса строки набора: время и ошибка обработки.
//
// Параметры:
//  КлючНастроек - УникальныйИдентификатор, Строка - КлючНастроек строки набора
//  ИмяЭлемента - Строка - имя элемента графической схемы
//
// Возвращаемое значение:
//  Структура - заменяет строку набора в настройках пользователя:
//   * КлючНастроек - Строка
//
Функция ПолучитьСпециальныйКлючНастроек(КлючНастроек, ИмяЭлемента) Экспорт
	
	Возврат Новый Структура("КлючНастроек", ИмяЭлемента + "_" + КлючНастроек);
	
КонецФункции

// Элементы схемы, которые выполняют обработки.
//
// Параметры:
//  ГрафСхема - ГрафическаяСхема
//
// Возвращаемое значение:
//  Массив из Произвольный - элементы графической схемы
//
Функция ПолучитьУправляющиеЭлементы(ГрафСхема) Экспорт
	
	Результат = Новый Массив;
	ВозможныеТипы = ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьВозможныеТипыЭлементов();
	Для Каждого Элемент Из ГрафСхема.ЭлементыГрафическойСхемы Цикл
		Если ВозможныеТипы.СодержитТип(ТипЗнч(Элемент)) Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Определяет ключевое условие или значение, по которому запускается направление развилки.
//
// Параметры:
//  ТипЭлемента - Тип - тип элемента графической схемы, с которого начинается развилка
//  Направления - Массив из Структура - вложенные направления, см. ВыполнитьПоток.Направления
//  ВозвращаемоеЗначение - ФиксированнаяСтруктура, Неопределено - описание результата предыдущей обработки,
//    см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
// Возвращаемое значение:
//  Булево, Строка, Произвольный - Истина или Ложь для условия, значение перечисления для выбора варианта,
//    имя линии для разделения; Неопределено - условие не определено
//
Функция ОпределитьКлючевоеУсловиеНаправления(ТипЭлемента, Направления, ВозвращаемоеЗначение) Экспорт
	
	Результат = Неопределено;
	Если Направления.Количество() > 0 Тогда
		Условие = Направления.Получить(0).Условие;
		Если ТипЭлемента = Тип("ЭлементГрафическойСхемыУсловие") Тогда
			// Имя линии условия заканчивается на 1 (Истина) или 0 (Ложь)
			Результат = СтрЗаканчиваетсяНа(Условие, стрРазделительИмени() + 1);
		ИначеЕсли ТипЭлемента = Тип("ЭлементГрафическойСхемыВыборВарианта") Тогда
			Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ВозвращаемоеЗначение)
				И СтрНачинаетсяС(ВозвращаемоеЗначение.ОписаниеТипов, ТипыКлиентСервер_Ei.Универсальные().Перечисления) Тогда
				ЗначенияПеречисления = ОбщегоНазначенияВызовСервера_Ei.ПолучитьЗначенияПеречисления(ВозвращаемоеЗначение.ОписаниеТипов);
				ЗначениеПеречисления = ЗначенияПеречисления.Получить(Условие);
				Если ЗначениеПеречисления <> Неопределено Тогда
					Результат = ЗначениеПеречисления.Значение;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТипЭлемента = Тип("ЭлементГрафическойСхемыРазделение") Тогда
			Результат = Условие;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Модуль обработки строки дерева доступных обработок: у настроенной обработки - модуль ее вида.
//
// Параметры:
//  СтрокаОбработки - ДанныеФормыЭлементДерева - строка дерева доступных обработок
//
// Возвращаемое значение:
//  ОбщийМодуль, Неопределено - модуль обработки, см. ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки
//
Функция ПолучитьОбработчик(СтрокаОбработки) Экспорт
	
	СтрокаВида = СтрокаОбработки.ПолучитьРодителя();
	Если СтрокаВида = Неопределено Тогда
		СтрокаВида = СтрокаОбработки;
	КонецЕсли;
	
	Возврат ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки().Получить(СтрокаВида.Имя);
	
КонецФункции

// Строка дерева доступных обработок, которую выполняет элемент схемы.
//
// Параметры:
//  Дерево - ДанныеФормыДерево - дерево доступных обработок
//  ИмяЭлемента - Строка - имя элемента графической схемы
//
// Возвращаемое значение:
//  ДанныеФормыЭлементДерева, Неопределено - строка обработки, Неопределено - обработки нет
//
Функция ПолучитьДоступнуюОбработку(Дерево, ИмяЭлемента) Экспорт
	
	Результат = Неопределено;
	ИмяПоиска = ОбщегоНазначенияКлиентСервер_Ei.СтрНачалоДо(ИмяЭлемента, стрРазделительИмени());
	Если ИмяПоиска <> Неопределено Тогда
		Найденные = ОбщегоНазначенияКлиентСервер_Ei.НайтиВКоллекцииДерева(Новый Структура("Имя", ИмяПоиска), Дерево.ПолучитьЭлементы());
		Для Каждого Найденная Из Найденные Цикл
			Результат = Найденная;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Разделитель в имени элемента схемы: имя обработки и номер элемента, имя линии и ее вариант.
//
// Возвращаемое значение:
//  Строка
//
Функция стрРазделительИмени() Экспорт
	
	Возврат "____";
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Описание хода процесса для уведомлений клиента: только у процесса, выполняющегося в фоне,
// его создает ФоновоеВыполнениеСервер_Ei.ОписаниеХода. При обычном выполнении клиент занят
// и уведомления не показал бы до конца выполнения.
//
// Возвращаемое значение:
//  - Неопределено - процесс выполняется не в фоновом запуске варианта
//  - Структура - описание хода:
//   * Ид - Строка - идентификатор фонового запуска
//   * КлючСтроки - Строка - КлючНастроек строки набора
//   * ИмяНабора - Строка - имя строки набора
//   * Пользователь - Строка - имя пользователя, запустившего вариант
//   * Элемент - Строка - имя выполняющегося элемента схемы
//   * Отправлено - Число - когда отправлено последнее уведомление, универсальное время в миллисекундах
//
Функция НовыйХод() Экспорт
	
	Результат = Неопределено;
	#Если Не Клиент Тогда
		Результат = ФоновоеВыполнениеСервер_Ei.ОписаниеХода();
	#КонецЕсли
	
	Возврат Результат;
	
КонецФункции

// События хода процесса.
//
// Возвращаемое значение:
//  Структура:
//   * Начало - Строка - обработка элемента схемы началась
//   * Завершение - Строка - обработка элемента закончилась, в уведомлении ее время и ошибка
//   * Строка - Строка - «Для Каждого» начал обрабатывать строку коллекции
//
Функция СобытияХода() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Начало", 		"Начало");
	Результат.Вставить("Завершение", 	"Завершение");
	Результат.Вставить("Строка", 		"Строка");
	
	Возврат Результат;
	
КонецФункции

// Сообщает клиенту о ходе процесса, выполняющегося в фоне, показывает ход ПроцессыКлиент_Ei.ПоказатьХод
// О строках коллекции сообщает не чаще раза в ИнтервалУведомленийОСтроках миллисекунд, кроме первой и последней:
// уведомление на каждую строку замедлило бы обработку.
//
// Параметры:
//  Ход - см. НовыйХод
//  Событие - Строка - см. СобытияХода
//  Данные - Структура, Неопределено - поля уведомления:
//   * Время - Число - длительность обработки, миллисекунды
//   * Ошибка - Строка - краткое представление ошибки обработки
//   * Индекс - Число - индекс обрабатываемой строки коллекции, с нуля
//   * Всего - Число - сколько строк в коллекции
//   * Источник - см. ИсточникВыражения
//
Процедура СообщитьХод(Ход, Событие, Данные = Неопределено) Экспорт
	
	Если Ход = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Уведомление = Новый Структура;
	Уведомление.Вставить("Событие", 	Событие);
	Уведомление.Вставить("Элемент", 	Ход.Элемент);
	Уведомление.Вставить("Время", 		0);
	Уведомление.Вставить("Ошибка", 		"");
	Уведомление.Вставить("Индекс", 		0);
	Уведомление.Вставить("Всего", 		0);
	Уведомление.Вставить("Источник", 	Неопределено);
	Если Данные <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Уведомление, Данные);
	КонецЕсли;
	
	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если Событие = СобытияХода().Строка И Уведомление.Индекс > 0 И Уведомление.Индекс < Уведомление.Всего - 1
		И Сейчас - Ход.Отправлено < ИнтервалУведомленийОСтроках() Тогда
		Возврат;
	КонецЕсли;
	Ход.Отправлено = Сейчас;
	
	#Если Не Клиент Тогда
		ФоновоеВыполнениеСервер_Ei.УведомитьОХоде(Ход, Уведомление);
	#КонецЕсли
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Выполнение

// Выполняет обработку элемента схемы и запоминает ее результат.
//
// Параметры:
//  Обработчик - ОбщийМодуль - модуль обработки, см. ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки
//  ИмяЭлемента - Строка - имя элемента схемы
//  Настройка - Произвольный - настройка обработки
//  УникальныйИдентификатор - УникальныйИдентификатор
//  Объекты - см. ВыполнитьПроцесс.Объекты
//  ДанныеКлиента - см. ВыполнитьПроцесс.ДанныеКлиента
//  Ход - см. НовыйХод
//
// Возвращаемое значение:
//  Произвольный - результат обработки, при ошибке - Неопределено
//
Функция ВыполнитьОбработку(Обработчик, ИмяЭлемента, Настройка, УникальныйИдентификатор, Объекты, ДанныеКлиента, Ход)
	
	Результат = Неопределено;
	ИнформацияОбОшибке = Неопределено;
	Если Ход <> Неопределено Тогда
		Ход.Элемент = ИмяЭлемента;
	КонецЕсли;
	СообщитьХод(Ход, СобытияХода().Начало);
	
	СобытиеОтладки = ОтладкаКлиентСервер_Ei.ДобавитьСобытие(СтрШаблон("Выполнение обработки <%1> типа %2", ИмяЭлемента,
		Обработчик.Свойства().Синоним), "Конструктор");
	НачалоВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Результат = Обработчик.ВыполнитьОбработку(УникальныйИдентификатор, Настройка, ДанныеКлиента, Ход);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
	КонецПопытки;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки, , ИнформацияОбОшибке);
	ВремяВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВыполнения;
	
	ЗафиксироватьРезультат(ИмяЭлемента, Результат, ИнформацияОбОшибке, ВремяВыполнения, Объекты, ДанныеКлиента,
		ИсточникРезультата(Обработчик, Настройка));
	СообщитьХод(Ход, СобытияХода().Завершение, Новый Структура("Время, Ошибка", ВремяВыполнения, ТекстОшибки(ИнформацияОбОшибке)));
	
	Возврат Результат;
	
КонецФункции

// Вычисляет объект обработки по выражению на линии маршрута и запоминает его как результат элемента.
//
// Параметры:
//  ИмяЭлемента - Строка - имя элемента схемы, в который входит линия
//  Уточнение - Строка - выражение объекта
//  УникальныйИдентификатор - УникальныйИдентификатор
//  Объекты - см. ВыполнитьПроцесс.Объекты
//  ДанныеКлиента - см. ВыполнитьПроцесс.ДанныеКлиента
//
Процедура УточнитьОбъект(ИмяЭлемента, Уточнение, УникальныйИдентификатор, Объекты, ДанныеКлиента)
	
	Если ПустаяСтрока(Уточнение) Тогда
		Возврат;
	КонецЕсли;
	
	Результат = Неопределено;
	ИнформацияОбОшибке = Неопределено;
	СобытиеОтладки = ОтладкаКлиентСервер_Ei.ДобавитьСобытие(СтрШаблон("Уточнение объекта на линии к <%1>", ИмяЭлемента), "Процессы");
	Попытка
		Результат = ВыполнитьКлиентСервер_Ei.Выражение(Уточнение, УникальныйИдентификатор);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
	КонецПопытки;
	ОтладкаКлиентСервер_Ei.ЗавершитьСобытие(СобытиеОтладки, , ИнформацияОбОшибке);
	ЗафиксироватьРезультат(ИмяЭлемента, Результат, ИнформацияОбОшибке, 0, Объекты, ДанныеКлиента, ИсточникВыражения(Уточнение));
	
КонецПроцедуры

// Запоминает результат элемента схемы: в объектах процесса для следующих обработок и в данных клиента
// для показа на схеме.
//
// Параметры:
//  ИмяЭлемента - Строка - имя элемента схемы
//  Результат - Произвольный - результат обработки, см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//  ИнформацияОбОшибке - ИнформацияОбОшибке, Неопределено - ошибка обработки
//  ВремяВыполнения - Число - миллисекунды
//  Объекты - см. ВыполнитьПроцесс.Объекты
//  ДанныеКлиента - см. ВыполнитьПроцесс.ДанныеКлиента
//  Источник - см. ИсточникВыражения
//
Процедура ЗафиксироватьРезультат(ИмяЭлемента, Результат, ИнформацияОбОшибке, ВремяВыполнения, Объекты, ДанныеКлиента, Источник)
	
	Объекты.Добавить(Новый ФиксированнаяСтруктура("Имя, Результат, Источник", ИмяЭлемента, Результат, Источник));
	ОбъектыВызовСервера_Ei.Установить(Объекты);
	ДанныеКлиента.Вставить(ИмяЭлемента, Новый ФиксированнаяСтруктура("ИнфоОбОшибке, ВремяВыполнения, Контекст",
		ИнформацияОбОшибке, ВремяВыполнения, Новый ФиксированныйМассив(Объекты)));
	
КонецПроцедуры

// Модуль обработки элемента схемы и ее настройка.
//
// Параметры:
//  Направление - Структура - элемент параметра Направления функции ВыполнитьПоток
//  Направления - см. ВыполнитьПоток.Направления
//  НастройкиОбработок - см. ВыполнитьПроцесс.НастройкиОбработок
//  Настройка - Произвольный - возвращаемый параметр: настройка обработки
//
// Возвращаемое значение:
//  ОбщийМодуль, Неопределено - Неопределено, если элемент не выполняет обработку
//
Функция ПолучитьОбработчикВыполнения(Направление, Направления, НастройкиОбработок, Настройка)
	
	Результат = Неопределено;
	Ключ = ОбщегоНазначенияКлиентСервер_Ei.СтрНачалоДо(Направление.Значение, стрРазделительИмени());
	Если Ключ <> Неопределено Тогда
		НастройкаОбработки = НастройкиОбработок.Получить(Ключ);
		Если НастройкаОбработки <> Неопределено Тогда
			Настройка = НастройкаОбработки.Настройка;
			Результат = ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки().Получить(НастройкаОбработки.Обработчик);
		Иначе
			// Обработка без настройки: по ключу может найтись и обработка с настройками, ее не выполняем
			Обработчик = ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки().Получить(Ключ);
			Если Обработчик <> Неопределено И Не Обработчик.Свойства().ИспользоватьНастройки Тогда
				Настройка = Обработчик.СоздатьНастройку(Направление, Направления, НастройкиОбработок);
				Результат = Обработчик;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Источник

// Строка набора и вариант, результат которых дает обработка «Выполнить».
//
// Параметры:
//  Обработчик - ОбщийМодуль - модуль обработки
//  Настройка - Произвольный - настройка обработки
//
// Возвращаемое значение:
//  см. ИсточникВыражения
//
Функция ИсточникРезультата(Обработчик, Настройка)
	
	Результат = Неопределено;
	Если Обработчик = ОбработкаВыполнитьКлиентСервер_Ei Тогда
		Результат = ОбработкаВыполнитьКлиентСервер_Ei.Источник(Настройка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Строка набора и вариант, результат или данные которых дает выражение объекта, например
// Наборы("ПеренестиВАрхив").Варианты("Запрос").Результат() или Варианты("Коллекция").Данные().
// По ним клиент показывает строку, которую обрабатывает «Для Каждого», в таблице этого варианта.
//
// Параметры:
//  Выражение - Строка - выражение объекта на встроенном языке
//
// Возвращаемое значение:
//  - Неопределено - выражение - не результат варианта строки набора
//  - ФиксированнаяСтруктура - строка набора и вариант:
//   * ИмяНабора - Строка - имя строки набора; пустая - строка, в которой выполняется процесс
//   * ИмяВарианта - Строка - имя варианта, например Запрос
//
Функция ИсточникВыражения(Выражение)
	
	Результат = Неопределено;
	ИмяВарианта = АргументВызова(Выражение, "Варианты");
	// Результат - у запроса и алгоритма, данные - у коллекции: ее результата нет
	Если ЗначениеЗаполнено(ИмяВарианта) И (СтрНайти(НРег(Выражение), ".результат(") > 0 Или СтрНайти(НРег(Выражение), ".данные(") > 0) Тогда
		Результат = Новый ФиксированнаяСтруктура("ИмяНабора, ИмяВарианта", АргументВызова(Выражение, "Наборы"), Строка(ИмяВарианта));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Строковый аргумент вызова функции в выражении: для Наборы("Имя") - Имя.
//
// Параметры:
//  Выражение - Строка
//  ИмяФункции - Строка
//
// Возвращаемое значение:
//  Строка - пустая, если вызова со строковым аргументом нет
//
Функция АргументВызова(Выражение, ИмяФункции)
	
	Результат = "";
	Начало = СтрНайти(НРег(Выражение), НРег(ИмяФункции) + "(""");
	Если Начало > 0 Тогда
		Начало = Начало + СтрДлина(ИмяФункции) + 2;
		Длина = СтрНайти(Сред(Выражение, Начало), """") - 1;
		Если Длина > 0 Тогда
			Результат = Сред(Выражение, Начало, Длина);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Прочее

// Краткое представление ошибки для уведомления о ходе.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке, Неопределено - ошибка обработки
//
// Возвращаемое значение:
//  Строка - пустая, если ошибки нет
//
Функция ТекстОшибки(Ошибка)
	
	Результат = "";
	Если Ошибка <> Неопределено Тогда
		Результат = ОбработкаОшибок.КраткоеПредставлениеОшибки(Ошибка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


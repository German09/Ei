#Область СериализацияСтруктурирование

Процедура ЗагрузитьПроцессИзСоответствия(ОбъектОбработки,сооПроцессы) Экспорт
	Если ТипЗнч(сооПроцессы) =  Тип("Соответствие") Тогда
		ОбъектОбработки.ГрафСхемаXDTO					= сооПроцессы.Получить("GraphicalSchema.xml");
		ОбъектОбработки.ПоказателиВыполненияПроцесса	= сооПроцессы.Получить(ПеречисленияКлиентСерверПовторноеИспользование_Ei.ИмяФайлаСтатистики());

		ДобавитьОбработкиВКоллекцию(ПолучитьЭлементы(ОбъектОбработки.ДоступныеОбработки),сооПроцессы.Получить(""))
	КонецЕсли;	
КонецПроцедуры

Функция ПолучитьЭлементы(Коллекция)
	Если ТипЗнч(Коллекция) = Тип("ДанныеФормыДерево") ИЛИ ТипЗнч(Коллекция) = Тип("ДанныеФормыЭлементДерева") Тогда
		Возврат Коллекция.ПолучитьЭлементы();
	Иначе
		//тут дерево значений на входе
		Возврат Коллекция.Строки;
	КонецЕсли;	
КонецФункции

Функция ПолучитьРодителя(Строка)
	Если ТипЗнч(Строка) = Тип("ДанныеФормыЭлементДерева") Тогда
		Возврат Строка.ПолучитьРодителя();
	Иначе
		//тут дерево значений на входе
		Возврат Строка.Родитель;
	КонецЕсли;	
КонецФункции

// Процедура - Добавить обработки в коллекцию
//
// Параметры:
//  Коллекция	 - ДанныеФормыКоллекцияЭлементовДерева  	-  Строки дерева доступный обработок
//  сзОбработки	 - СписокЗначений	 - Список значений доступных обработок формируется функцией ПолучитьСписокОбработок()
//
Процедура ДобавитьОбработкиВКоллекцию(Коллекция,сзОбработки)
	Если ТипЗнч(сзОбработки) = Тип("СписокЗначений") Тогда
		Для Каждого Элемент ИЗ сзОбработки Цикл
			Обработка	= Коллекция.Добавить();
			Обработка.Имя					= Элемент.Представление;
			Обработка.ИспользоватьНастройки = Истина;
			стрНастройки 			= Элемент.Значение.Получить("Settings.xml");
			Если ТипЗнч(стрНастройки) =  Тип("Структура") Тогда
				ЗаполнитьЗначенияСвойств(Обработка,стрНастройки);	
			КонецЕсли;
			//Теперь вложенные
			ДобавитьОбработкиВКоллекцию(ПолучитьЭлементы(Обработка),Элемент.Значение.Получить(""));
		КонецЦикла;
	КонецЕсли;	
Конецпроцедуры

#КонецОбласти



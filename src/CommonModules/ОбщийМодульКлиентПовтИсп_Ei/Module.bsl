// Фоновые запуски пользователя, известные клиенту, на время сеанса, см. ФоновоеВыполнениеКлиент_Ei
//
// Возвращаемое значение:
//  Структура:
//   * Записи - Соответствие из КлючИЗначение:
//     ** Ключ - Строка - идентификатор запуска
//     ** Значение - Структура - запись фонового запуска, см. ФоновоеВыполнениеВызовСервера_Ei.Записи
//   * Забранные - Соответствие из КлючИЗначение:
//     ** Ключ - Строка - идентификатор запуска, результат которого уже показан
//     ** Значение - Булево
//   * ПоказаноСообщений - Соответствие из КлючИЗначение:
//     ** Ключ - Строка - идентификатор запуска
//     ** Значение - Число - сколько первых сообщений пользователю этого запуска уже показано
//   * ПоказанныеВложенные - Соответствие из КлючИЗначение:
//     ** Ключ - Строка - идентификатор запуска, итоги вложенных запусков которого уже в строках набора
//     ** Значение - Булево
//   * Загружены - Булево - записи хотя бы раз получены с сервера
//   * Проверено - Число - универсальное время последней сверки записей с сервером, миллисекунды
//
Функция ФоновоеВыполнение() Экспорт
	Данные = Новый Структура;
	Данные.Вставить("Записи", 				Новый Соответствие);
	Данные.Вставить("Забранные", 			Новый Соответствие);
	Данные.Вставить("ПоказаноСообщений", 	Новый Соответствие);
	Данные.Вставить("ПоказанныеВложенные", 	Новый Соответствие);
	Данные.Вставить("Загружены", 			Ложь);
	Данные.Вставить("Проверено", 			0);
	Возврат Данные;
КонецФункции


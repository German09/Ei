Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",					"ДляКаждого");
	Результат.Вставить("Синоним",				"Для Каждого");
	Результат.Вставить("Картинка",				БиблиотекаКартинок.Процессы_Ei);
	Результат.Вставить("ИспользоватьНастройки",	Истина);
	Результат.Вставить("Форма",					"ОбщаяФорма.ДляКаждого_Обработка_Ei");
	Результат.Вставить("ТипЭлемента",			Тип("ЭлементГрафическойСхемыВложенныйБизнесПроцесс")); 
	Возврат Результат; 
КонецФункции

// Переопределемая процедура - Выполнить обработку
//
// Параметры:
//  ОписаниеПотока	 - Структура 	- Структура формируемая процедурой ПроцессыКлиент_Ei.ВыполнитьПоток()
//										- сзВызовов 	- СписокЗначений 	- Последовательность подготовленных ОписанийОповещений вызова обоработок, первой располагется следующая к запуску обработка
//										- Контекст  	- Структура  		- Аналог структуры "ДоступныеСтруктуры" из переменной формы СтруктураПеременных
//  ВозврЗначение	 - Структура - Описание возврашаемого значения, в который нужно поместить результат выполнения, своства структуры формируются функцией ОписаниеЗначенияВызовСервера_Ei.Получить()
//
Функция ВыполнитьОбработку(УникальныйИдентификатор, Настройка, ДанныеКлиента) Экспорт 
	Перем ИзначальныйОбъект;
	ПоследнийИндекс 	= 0;
	СтрНастройка 		= ПолучитьДанныеНастройки(Настройка);
	КонтекстОбъектов 	= Новый Массив;
	ОбъектыДоНачала 	= ОбъектыВызовСервера_Ei.ПолучитьВсе();
	Если ОбъектыДоНачала.Количество() Тогда
		СтрПоследнийОбъект 	= ОбъектыДоНачала[ОбъектыДоНачала.ВГраница()];
		ИзначальныйОбъект 	= "Результат("""+СтрПоследнийОбъект.Имя+""")";
		Если ЗначениеЗаполнено(СтрПоследнийОбъект.Результат.ОбъемКоллекции) Тогда
			ПоследнийИндекс     = СтрПоследнийОбъект.Результат.ОбъемКоллекции-1;
		КонецЕСли;		
		КонтекстОбъектов.Добавить(СтрПоследнийОбъект);				
	КонецЕсли;			
	Для Индекс = 0 По ПоследнийИндекс Цикл
		Результат	= ПроцессыКлиентСервер_Ei.ВыполнитьПроцесс(УникальныйИдентификатор, СтрНастройка.Инструкция, СтрНастройка.Обработки, ДанныеКлиента, КонтекстОбъектов, ПолучитьВыражениеИтератора(ИзначальныйОбъект,Индекс));
	КонецЦикла;
	Если ПоследнийИндекс Тогда
		ОбъектыВызовСервера_Ei.Установить(ОбъектыДоНачала); //вернем тот состав объектов который был до выполнения
	КонецЕсли;	
	
//	ОбработчикВарианта 		= ВариантыКлиентСерверПовторноеИспользование_Ei.ПолучитьВарианты().Получить(СтрНастройка.Тип);
//	Если Не ОбработчикВарианта = Неопределено Тогда 
//		ИмяНабораДоВызова = НаборВариантовВызовСервера_Ei.ПолучитьТекущийНабор();
//		Если Не ИмяНабораДоВызова = СтрНастройка.Вариант Тогда
//			//обновим имя набора чтобы могли вычисляться вложенные параметры
//			НаборВариантовВызовСервера_Ei.УстановитьТекущийНабор(СтрНастройка.Вариант);
//		КонецЕсли;	
//			Результат = ОбработчикВарианта.ВыполнитьВариант(Неопределено,УникальныйИдентификатор,Неопределено,Новый Структура,Неопределено);
//		Если Не ИмяНабораДоВызова = СтрНастройка.Вариант Тогда
//			//Вернем обратно
//			НаборВариантовВызовСервера_Ei.УстановитьТекущийНабор(ИмяНабораДоВызова);
//		КонецЕсли;
//	КонецЕсли;		
	Возврат Результат;
КонецФункции


// Загружает текущую настройку, выполняется самой первой как при интерактивном открытии так и при выполнении
//
// Параметры:
//  Настройка - Строка- Настройка обработки.
//Возвращаемое значение:
//   Структура
//   	* ГрафСхемаXDTO
//   	* Доступные
//
Функция ПолучитьДанныеНастройки(Настройка) Экспорт
	Результат = Новый Структура;
	Если ЗначениеЗаполнено(Настройка) Тогда
		сооНастройка 			= ОбщийМодульВызовСервера_Ei.Структурировать(Настройка,Новый Соответствие);
		Результат.Вставить("ГрафСхемаXDTO", 		сооНастройка.Получить("GraphicalSchema.xml"));
		Результат.Вставить("Обработки", 			сооНастройка.Получить(""));		
	Иначе
		//настройка по умолчанию	
		Результат.Вставить("ГрафСхемаXDTO",			ОбщийМодульКлиентСервер_Ei.Сериализовать(ПроцессыВызовСервера_Ei.ПолучитьМакетСхемыПоУмолчанию()));
	КонецЕсли;
	Возврат Результат;	
КонецФункции


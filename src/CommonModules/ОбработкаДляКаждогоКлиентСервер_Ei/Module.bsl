// Функция - Получить выражение итератора
//
// Параметры:
//  стрПрефикс	- Строка - Префикс представления
//  чИндекс	 - Число - Итератор
// 
// Возвращаемое значение:
//   - Строка - выражение для вычисления 
//
Функция ПолучитьВыражениеИтератора(стрПрефикс,чИндекс)
	Возврат стрПрефикс+"["+Формат(чИндекс,"ЧН=0; ЧГ=")+"]";
КонецФункции

// Загружает текущую настройку, выполняется самой первой как при интерактивном открытии так и при выполнении
//
// Параметры:
//  Настройка - Строка- Настройка обработки.
//Возвращаемое значение:
//   Структура
//   	* ГрафСхемаXDTO
//   	* Доступные
//
Функция ПолучитьДанныеНастройки(Настройка) Экспорт
	Результат = Новый Структура;
	Если ЗначениеЗаполнено(Настройка) Тогда
		Результат 	= ОбщийМодульВызовСервера_Ei.Структурировать(Настройка,Новый ФиксированнаяСтруктура);
		Результат	= Новый Структура(Результат); //сделаем обычную структуру что бы можно было дополнять в случае чего		
	КонецЕсли;
	//настройка по умолчанию	
	Если Не Результат.Свойство("Инструкция") Тогда
		Результат.Вставить("Инструкция",	ОбщийМодульКлиентСервер_Ei.Сериализовать(ПроцессыВызовСервера_Ei.ПолучитьМакетСхемыПоУмолчанию()));	
	КонецЕсли;	
	Если Не Результат.Свойство("Обработки") Тогда
		Результат.Вставить("Обработки",		Новый ФиксированноеСоответствие(Новый Соответствие()));
	КонецЕсли;
	Если Не Результат.Свойство("ИзначальныйОбъект") Тогда
		Результат.Вставить("ИзначальныйОбъект");
	КонецЕсли;
	Возврат Результат;	
КонецФункции


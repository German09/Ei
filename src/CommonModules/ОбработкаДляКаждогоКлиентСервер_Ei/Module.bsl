// Обработка процесса «Для Каждого»: выполняет вложенный процесс для каждого элемента коллекции,
// которая поступила в обработку. Процесс, выполняющийся в фоне, сообщает клиенту, какую строку коллекции
// обрабатывает, - клиент активизирует ее в результате источника коллекции, см. ПроцессыКлиент_Ei.ПоказатьХод

#Область ПрограммныйИнтерфейс

// Свойства обработки.
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - имя обработки, по нему обработка находится, см. ОбработкиКлиентСерверПовтИсп_Ei.ПолучитьОбработки
//   * Синоним - Строка - представление в дереве доступных обработок
//   * Картинка - Картинка - картинка в дереве доступных обработок и на схеме
//   * ИспользоватьНастройки - Булево - у обработки есть настройка, ее экземпляры настраиваются формой
//   * Форма - Строка - форма настройки
//   * ТипЭлемента - Тип - тип элемента графической схемы
//
Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",					"ДляКаждого");
	Результат.Вставить("Синоним",				"Для Каждого");
	Результат.Вставить("Картинка",				БиблиотекаКартинок.Цикл_Ei);
	Результат.Вставить("ИспользоватьНастройки",	Истина);
	Результат.Вставить("Форма",					"ОбщаяФорма.ДляКаждого_Обработка_Ei");
	Результат.Вставить("ТипЭлемента",			Тип("ЭлементГрафическойСхемыВложенныйБизнесПроцесс"));
	Возврат Результат;
КонецФункции

// Выполняет вложенный процесс для каждого элемента коллекции - объекта, поступившего в обработку.
// Элемент доступен вложенному процессу как Объект(): строка коллекции передается непосредственно.
// Каждый элемент обрабатывается со своим контекстом: результаты обработок одного элемента не копятся к следующему.
// Строки коллекции варианта Коллекция вложенный процесс может менять, например отмечать обработанные:
// после обработки измененная таблица записывается в вариант, см. ОбъектыСервер_Ei.ИзменяемаяКоллекция
// Перебор всегда идет на сервере: у процесса, выполняющегося на клиенте, - одним серверным вызовом.
// В фоне изменения строк уходят клиенту с уведомлениями о ходе, и форма показывает их по ходу перебора.
//
// Параметры:
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор для временного хранилища результатов
//  Настройка - Строка - сериализованная настройка обработки, см. ПолучитьДанныеНастройки
//  ДанныеКлиента - Соответствие из КлючИЗначение - данные выполненных обработок, см. ПроцессыКлиентСервер_Ei.ВыполнитьПроцесс
//  Ход - Структура, Неопределено - ход процесса в фоне, см. ПроцессыКлиентСервер_Ei.НовыйХод
//
// Возвращаемое значение:
//  Произвольный - результат вложенного процесса для последнего элемента; Неопределено - коллекция пуста
//
Функция ВыполнитьОбработку(УникальныйИдентификатор, Настройка, ДанныеКлиента, Ход = Неопределено) Экспорт
	
	#Если Клиент Тогда
		// Процесс выполняется на клиенте: перебор - на сервере одним вызовом, иначе каждая строка была бы
		// строкой своей копии коллекции и изменения строк терялись
		Выполнение = ПроцессыВызовСервера_Ei.ВыполнитьДляКаждого(УникальныйИдентификатор, Настройка);
		Для Каждого ДанныеЭлемента Из Выполнение.ДанныеКлиента Цикл
			ДанныеКлиента.Вставить(ДанныеЭлемента.Ключ, ДанныеЭлемента.Значение);
		КонецЦикла;
		Возврат Выполнение.Результат;
	#КонецЕсли
	
	Результат = Неопределено;
	ОбъектыДоНачала = ОбъектыВызовСервера_Ei.ПолучитьВсе();
	Если ОбъектыДоНачала.Количество() > 0 Тогда
		ДанныеНастройки = ПолучитьДанныеНастройки(Настройка);
		Коллекция = ОбъектыДоНачала.Получить(ОбъектыДоНачала.ВГраница());
		ИзменяемаяКоллекция = Неопределено;
		#Если Не Клиент Тогда
			ИзменяемаяКоллекция = ОбъектыСервер_Ei.ИзменяемаяКоллекция(Коллекция);
			Если ИзменяемаяКоллекция <> Неопределено Тогда
				Коллекция = ИзменяемаяКоллекция.Объект;
			КонецЕсли;
		#КонецЕсли
		Количество = КоличествоЭлементов(Коллекция.Результат);
		Источник = Неопределено;
		Коллекция.Свойство("Источник", Источник);
		События = ПроцессыКлиентСервер_Ei.СобытияХода();
		// Изменения строк после прошлого уведомления: уходят с уведомлением о следующей строке, чтобы в фоне
		// форма показывала их по ходу перебора. Изменения последней строки покажет итоговая запись коллекции
		Изменения = Новый Массив;
		Для Индекс = 0 По Количество - 1 Цикл
			ДанныеХода = Новый Структура("Индекс, Всего, Источник", Индекс, Количество, Источник);
			ДанныеХода.Вставить("Изменения", Изменения);
			Если ПроцессыКлиентСервер_Ei.СообщитьХод(Ход, События.Строка, ДанныеХода) Тогда
				Изменения = Новый Массив;
			КонецЕсли;
			ЗначенияДо = Неопределено;
			#Если Не Клиент Тогда
				ОбъектыСервер_Ei.ВосстановитьИзменяемуюКоллекцию(ИзменяемаяКоллекция);
				Если Ход <> Неопределено Тогда
					ЗначенияДо = ОбъектыСервер_Ei.ЗначенияСтроки(ИзменяемаяКоллекция, Индекс);
				КонецЕсли;
			#КонецЕсли
			КонтекстОбъектов = Новый Массив;
			КонтекстОбъектов.Добавить(Коллекция);
			#Если Клиент Тогда
				ОбъектЭлемента = ВыражениеЭлемента(Коллекция.Имя, Индекс);
			#Иначе
				ОбъектЭлемента = ОписаниеЭлементаКоллекции(Коллекция.Результат, Индекс, УникальныйИдентификатор);
			#КонецЕсли
			Результат = ПроцессыКлиентСервер_Ei.ВыполнитьПроцесс(УникальныйИдентификатор, ДанныеНастройки.Инструкция,
				ДанныеНастройки.Обработки, ДанныеКлиента, КонтекстОбъектов, ОбъектЭлемента);
			#Если Не Клиент Тогда
				ОбъектыСервер_Ei.ДобавитьИзмененияСтроки(Изменения, ИзменяемаяКоллекция, Индекс, ЗначенияДо);
			#КонецЕсли
		КонецЦикла;
		ОбъектыВызовСервера_Ei.УстановитьОбъекты(ОбъектыДоНачала); // объекты процесса, как до обработки
		#Если Не Клиент Тогда
			ОбъектыСервер_Ei.ЗаписатьИзменяемуюКоллекцию(ИзменяемаяКоллекция);
		#КонецЕсли
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Объекты, с которыми вложенный процесс начинает обрабатывать элемент коллекции: коллекция по выражению
// и ее элемент с индексом, как при выполнении, см. ВыполнитьОбработку. По ним переменные первой обработки
// вложенного процесса показывают элемент коллекции и до выполнения процесса.
//
// Параметры:
//  Выражение - Строка - выражение коллекции, например Варианты("Коллекция").Данные()
//  ИмяКоллекции - Строка - имя элемента схемы, результат которого - коллекция: обработки «Для Каждого»
//  ИмяЭлемента - Строка - имя первой обработки вложенного процесса
//  Индекс - Число - индекс элемента коллекции
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор для временного хранилища результатов
//
// Возвращаемое значение:
//  Массив из ФиксированнаяСтруктура - объекты процесса, см. ОбъектыВызовСервера_Ei.ПолучитьВсе
//
Функция ОбъектыЭлемента(Выражение, ИмяКоллекции, ИмяЭлемента, Индекс, УникальныйИдентификатор) Экспорт
	
	Объекты = Новый Массив;
	Коллекция = ВыполнитьКлиентСервер_Ei.Выражение(Выражение, УникальныйИдентификатор);
	Объекты.Добавить(Новый ФиксированнаяСтруктура("Имя, Результат, Источник", ИмяКоллекции, Коллекция, Неопределено));
	ОбъектыВызовСервера_Ei.УстановитьОбъекты(Объекты); // по ним вычисляется выражение элемента
	Элемент = ВыполнитьКлиентСервер_Ei.Выражение(ВыражениеЭлемента(ИмяКоллекции, Индекс), УникальныйИдентификатор);
	Объекты.Добавить(Новый ФиксированнаяСтруктура("Имя, Результат, Источник", ИмяЭлемента, Элемент, Неопределено));
	
	Возврат Объекты;
	
КонецФункции

// Создает настройку обработки по контексту других обработок, только для обработки без настроек.
//
// Параметры:
//  Направление - Структура - направление схемы, см. ПроцессыКлиентСервер_Ei.ВыполнитьПоток
//  Направления - Массив из Структура - направления схемы
//  НастройкиОбработок - ФиксированноеСоответствие из КлючИЗначение - настройки обработок схемы
//
// Возвращаемое значение:
//  Неопределено - у обработки своя настройка
//
Функция СоздатьНастройку(Направление, Направления, НастройкиОбработок) Экспорт
	Возврат Неопределено;
КонецФункции

// Данные настройки: читаются и при открытии формы настройки, и при выполнении.
// Без схемы в настройке - схема процесса по умолчанию.
//
// Параметры:
//  Настройка - Строка, Неопределено - сериализованная настройка обработки
//
// Возвращаемое значение:
//  Структура - данные вложенного процесса:
//   * Инструкция - Строка - сериализованная графическая схема вложенного процесса
//   * Обработки - ФиксированноеСоответствие из КлючИЗначение - настройки обработок вложенного процесса
//   * ИзначальныйОбъект - Строка - выражение объекта вложенного процесса
//
Функция ПолучитьДанныеНастройки(Настройка) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Инструкция", 		"");
	Результат.Вставить("Обработки", 		Новый ФиксированноеСоответствие(Новый Соответствие));
	Результат.Вставить("ИзначальныйОбъект", "");
	Если ЗначениеЗаполнено(Настройка) Тогда
		ЗаполнитьЗначенияСвойств(Результат, ОбщегоНазначенияВызовСервера_Ei.Структурировать(Настройка, Новый ФиксированнаяСтруктура));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Результат.Инструкция) Тогда
		Результат.Инструкция = ПроцессыВызовСервера_Ei.ПолучитьМакетСхемыПоУмолчаниюСтрокой();
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Настройка для сохранения из формы настройки обработки.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма настройки, см. ОбщаяФорма.ДляКаждого_Обработка_Ei
//
// Возвращаемое значение:
//  см. ВариантПроцессыКлиентСервер_Ei.ПодготовитьДанные
//
Функция ПолучитьНастройку(Форма) Экспорт
	Возврат ВариантПроцессыКлиентСервер_Ei.ПодготовитьДанные(Форма);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сколько элементов в коллекции, поступившей в обработку. Описание результата запроса объем коллекции не хранит,
// его элементы - строки таблицы результата, см. ОписаниеЗначенияВызовСервера_Ei.КоличествоЭлементов
//
// Параметры:
//  ОписаниеЗначения - Произвольный - результат элемента схемы, см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//
// Возвращаемое значение:
//  Число
//
Функция КоличествоЭлементов(ОписаниеЗначения)
	Результат = 0;
	Если ОписаниеЗначенияКлиентСервер_Ei.ЭтоОписаниеЗначения(ОписаниеЗначения) Тогда
		Если ЗначениеЗаполнено(ОписаниеЗначения.ОбъемКоллекции) Тогда
			Результат = ОписаниеЗначения.ОбъемКоллекции;
		ИначеЕсли ОписаниеЗначения.ОписаниеТипов = ТипыКлиентСервер_Ei.Универсальные().РезультатЗапроса Тогда
			Результат = ОписаниеЗначенияВызовСервера_Ei.КоличествоЭлементов(ОписаниеЗначения);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Получает элемент уже вычисленной коллекции без выполнения текста выражения.
//
// Параметры:
//  ОписаниеКоллекции - см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
//  Индекс - Число - индекс элемента
//  УникальныйИдентификатор - УникальныйИдентификатор - владелец результата
//
// Возвращаемое значение:
//  см. ОписаниеЗначенияКлиентСервер_Ei.Подготовить
Функция ОписаниеЭлементаКоллекции(ОписаниеКоллекции, Индекс, УникальныйИдентификатор)
	Результат = Неопределено;
	#Если Не Клиент Тогда
		Коллекция = ОписаниеЗначенияСервер_Ei.ПереопределитьЗначение(ОписаниеКоллекции);
		Если ТипЗнч(Коллекция) = Тип("РезультатЗапроса") Тогда
			Коллекция = Коллекция.Выгрузить();
		КонецЕсли;
		Элемент = Коллекция.Получить(Индекс);
		Результат = ОписаниеЗначенияКлиентСервер_Ei.Подготовить(Элемент, УникальныйИдентификатор);
	#КонецЕсли
	Возврат Результат;
КонецФункции

// Выражение элемента коллекции для вложенного процесса.
//
// Параметры:
//  ИмяЭлемента - Строка - имя элемента схемы, результат которого - коллекция
//  Индекс - Число - индекс элемента коллекции
//
// Возвращаемое значение:
//  Строка - например Результат("ДляКаждого____1")[0]
//
Функция ВыражениеЭлемента(ИмяЭлемента, Индекс)
	Возврат СтрШаблон("Результат(""%1"")[%2]", ИмяЭлемента, Формат(Индекс, "ЧН=0; ЧГ="));
КонецФункции

#КонецОбласти

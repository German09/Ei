
#Область СлужебныйПрограммныйИнтерфейс
Функция ПолучитьМенеджерТипаПоПсевдониму(Псевдоним) Экспорт
	Для Каждого элСоответ ИЗ ТипыКлиентСервер_Ei.Ключевые() Цикл
		мИмен = СтрРазделить(элСоответ.Значение,";");
		Если мИмен.Количество()>1 Тогда
			Если нРег(Псевдоним) = нРег(мИмен[1]) Тогда
				УстановитьБезопасныйРежим(Истина);		
				Возврат ВыполнитьКлиентСервер_Ei.ВычислитьБезопасно(мИмен[0]);
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
КонецФункции	

// Пытается получить ссылку или объект из навигационной ссылки
//
// Параметры:
//  НавСсылка	 - Строка - Навигационная ссылка вида 	e1cib/data/Справочник.Справочник1?ref=a291a0c5895957df11e77b287dd26811
//  													e1cib/data/ВнешнийИсточникДанных.POS.Таблица.BASEDOC_DISCOUNT?ref=8001000001B18D28
// 
// Возвращаемое значение:
//   ЛюбаяСсылка
Функция ПолучитьСсылкуИзНавСсылки(Знач НавСсылка) Экспорт
	Перем Признак, Результат;
	Разделитель = "?ref=";
	НачалоЗнач	= ОбщегоНазначенияКлиентСервер_Ei.ЭтоНавСсылкаНаСсылку(НавСсылка,Признак);
	Если НачалоЗнач Тогда
		НавСсылка = Сред(НавСсылка,НачалоЗнач+СтрДлина(Признак));
		НавСсылки = СтрРазделить(СтрЗаменить(НавСсылка,Разделитель,"?"),"?",Ложь);
		Если НавСсылки.Количество()=2 Тогда
			Пути = СтрРазделить(НавСсылки.Получить(0),".");
			Если Пути.Количество()>1 Тогда
				МенеджерТипа = ОбщегоНазначенияПовтИсп_Ei.ПолучитьМенеджерТипаПоПсевдониму(Пути.Получить(0));
				Если Не МенеджерТипа = Неопределено Тогда
					Попытка	
						Менеджер 	= МенеджерТипа[Пути.Получить(1)];
						Если Пути.Количество()= 2 Тогда					
							Результат 	= Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбщегоНазначенияКлиентСервер_Ei.вПреобразоватьИдентификатор(НавСсылки.Получить(1))));				
						ИначеЕсли Пути.Количество()= 4 Тогда
							//это внешний источник данных 
							МенеджерТаблицы	= Менеджер.Таблицы[Пути.Получить(3)];
							Результат 		= МенеджерТаблицы.ПолучитьСсылку(НавСсылки.Получить(1));			
						КонецЕсли;
					Исключение
						Результат 	= Неопределено;
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;					
		КонецЕсли
	КонецЕсли;
	Возврат Результат;
КонецФункции	

Функция Формы() Экспорт
	Возврат Новый Соответствие();
КонецФункции
#КонецОбласти

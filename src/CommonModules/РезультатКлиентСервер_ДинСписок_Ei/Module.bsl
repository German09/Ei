#Область ИнтерфейсРезультатов

Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",			ПеречисленияКлиентСерверПовторноеИспользование_Ei.ТипыСтрУниверсальные().ДинамическийСписок);
	Результат.Вставить("Синоним",		"Список");
	Результат.Вставить("Картинка",		БиблиотекаКартинок.НастроитьСписок);
	Результат.Вставить("ИмяРеквизита",	ПеречисленияКлиентСерверПовторноеИспользование_Ei.сРезультатДС());
	Возврат Результат;
КонецФункции

// Выполняется до выполнения варианта для данноготипа результата
// Варинат не всегда нужно выполнять для некоторых результатов, например в Динамическом списке, не нужно выполнять запрос
// 
// Параметры:
//  Вариант  - общий модуль - модуль варианта
// 
// Возвращаемое значение:
//  Булево - Выполнять вариант или нет
Функция ВыполнятьВариант(Вариант) Экспорт
	Результат = Истина;
	Если Вариант.Свойства().Имя = ВариантыКлиентСерверПовторноеИспользование_Ei.ИмяЭлементаЗапроса() Тогда
		//если это запрос то его не нужно оформлять, он будут выполнен при создание элементов на форме, тоесть в модуле РезультатКлиентСервер_ДинСписок_Ei
		Результат = Ложь;
	КонецЕсли;	
	Возврат Результат;	
КонецФункции	

#Если Сервер Тогда
	
Функция Загрузить(Форма,ВариантИД,Результат,Параметры,ИмяРеквизита,мКолонокРезультата) Экспорт
	ВариантТД 		= Форма.ДеревоЗапросов.НайтиПоИдентификатору(ВариантИД); //не условие не проверяем потому что уже проверяли, по другому сюда не попасть
	сИмяЭлДинСписка = ПолучитьИмяРеквизитаДинСписка(ВариантИД); 
	Если ЗначениеЗаполнено(ВариантТД.ТекстВыполняемогоЗапроса) Тогда
		ЗапросДС 				= ВариантТД.ТекстВыполняемогоЗапроса;
		стрДанныхТекстаЗапроса 	= ОбщийМодульЗакрытыйВызовСервера_Ei.ПолучитьКолонкиИОсновнуюТаблицу(ЗапросДС);
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗапросДС) Тогда
		Если Форма.Элементы.Найти(сИмяЭлДинСписка) = Неопределено И Параметры = Неопределено Тогда
			//реквизита нет, инициализации из смены закладок или активизации первой строки при открытии
			Возврат Истина; //нужно нажать кнопку выполнить, только после этого покажем
		КонецЕсли;
		ИмяРеквизита   									= сИмяЭлДинСписка; //изменим имя основного реквизита, возвращаемого параметра, что бы сработала ТаблицаОткрытьВызовСервера_Ei.ДобавитьКолонкиВЭлемент()
		ВариантТД.КлючНастроек 							= ?(ЗначениеЗаполнено(ВариантТД.КлючНастроек),ВариантТД.КлючНастроек, Новый УникальныйИдентификатор);	
		эл_Список 										= РезультатСервер_ДинСписок_Ei.ДобавитьРеквизитыДС(Форма,ВариантИД);
		РеквизитДС 										= Форма[ИмяРеквизита];	
		РеквизитДС.ПроизвольныйЗапрос   				= Истина;
		РеквизитДС.ТекстЗапроса							= ЗапросДС;
		РеквизитДС.КлючТекущихПользовательскихНастроек	= ВариантТД.КлючНастроек;//КлючПользовательскихНастроекДС;
		
		Если Параметры = Неопределено Тогда
			//Проверим нужен ли расчет прааметров если они не пришли вместе с вызовом (обычно возникат при запуске уже существующего в дереве запроса)
			Запрос				= Новый Запрос(РеквизитДС.ТекстЗапроса);
			Если  Запрос.НайтиПараметры().Количество() Тогда
				//ПараметрыЗапроса		= ОбщийМодульЗакрытыйКлиент_Ei.вПолучитьСтруктуруПараметров(ДеревоЗапросовТД.ПараметрыЗапроса);	
			КонецЕсли;	
		КонецЕсли;
		Параметры = ОбщийМодульКлиентСервер_Ei.ПолучитьМодифицирПараметрыДляЗапроса(Параметры); //#СпецОбработкаТипа
		Попытка
			//Установим переданные параметры
			Если ТипЗнч(Параметры) = Тип("Структура") Тогда
				Для Каждого ДоступныйПараметр ИЗ Форма[ИмяРеквизита].Параметры.ДоступныеПараметры.Элементы Цикл
					УстЗначение =  Неопределено; 
					Если Параметры.Свойство(ДоступныйПараметр.Параметр,УстЗначение) Тогда 
						Если ТипЗнч(УстЗначение) = Тип("Строка") И ЭтоАдресВременногоХранилища(УстЗначение) Тогда
							УстЗначение = ПолучитьИзВременногоХранилища(УстЗначение);
						КонецЕсли;
						УстЗначение = ?(ТипЗнч(УстЗначение) = Тип("СписокЗначений"),УстЗначение.ВыгрузитьЗначения(),УстЗначение); //Динамический список не понимает параметров в виде списка, только массив	
						РеквизитДС.Параметры.УстановитьЗначениеПараметра(ДоступныйПараметр.Параметр, УстЗначение);
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;
			
			//Установим другие свойства дин. списка
			мКолонокРезультата								= стрДанныхТекстаЗапроса.мКолонки;
			РеквизитДС.ОсновнаяТаблица						= стрДанныхТекстаЗапроса.ОсновнаяТаблица;
			Если Не ЗначениеЗаполнено(РеквизитДС.ОсновнаяТаблица) И ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(Параметры,"ОсновнаяТаблица") Тогда
				Если ТипЗнч(Параметры.ОсновнаяТаблица) = Тип("Строка") Тогда
					РеквизитДС.ОсновнаяТаблица = Параметры.ОсновнаяТаблица;		
				КонецЕсли;	
			КонецЕсли;
			Форма.Элементы.Логотип.Видимость 	= Ложь;
			эл_Список.Видимость 				= Истина;
		Исключение
			Форма.Элементы.Логотип.Видимость 	= Истина;
			эл_Список.Видимость 				= Ложь;
			Если ТипЗнч(ИнформацияОбОшибке().Причина) 			=  Тип("ИнформацияОбОшибке") И
				 ТипЗнч(ИнформацияОбОшибке().Причина.Причина) 	=  Тип("ИнформацияОбОшибке") Тогда
				//это ошибка в запросе, остальное не интересно
				сДополнениеОшибки = ИнформацияОбОшибке().Причина.Причина.Описание;
			Иначе
				сДополнениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());	
			КонецЕсли;	
			ВызватьИсключение сДополнениеОшибки;
		КонецПопытки;
	КонецЕсли;		
	Возврат Истина;
КонецФункции

// Привести результат к типу, который возможно показать
// 
// Параметры:
//  СохраненныйРезультат - Произвольное значение - значение которые мы птыемся показать данным обработчиком
// 
// Возвращаемое значение:
//	Произвольное значение - Значение приведенное к типу	который можно тут отобразить   
Функция ПривестиРезультат(СохраненныйРезультат) Экспорт
	Результат 	= Неопределено;
	Возврат Результат;		
КонецФункции


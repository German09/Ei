#Область ИнтерфейсРезультатов

Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",			ТипыКлиентСервер_Ei.Универсальные().Запрос);
	Результат.Вставить("Синоним",		"Список");
	Результат.Вставить("Картинка",		БиблиотекаКартинок.Список_Ei);
	Результат.Вставить("КартинкаСсылка",ПоместитьВоВременноеХранилище(Результат.Картинка,Новый УникальныйИдентификатор));
	Результат.Вставить("Класс",			РезультатыКлиентСервер_Ei);
	Результат.Вставить("ТипРеквизита",	ТипыКлиентСервер_Ei.Универсальные().ДинамическийСписок);
	Результат.Вставить("Типы",			Новый Массив); //поддерживаемые типы, помимо имени
	Возврат Результат;
КонецФункции

// Выполняется до выполнения варианта для данноготипа результата
// Варинат не всегда нужно выполнять для некоторых результатов, например в Динамическом списке, не нужно выполнять запрос
// 
// Параметры:
//  Вариант  - общий модуль - модуль варианта
//  ОписаниеЗначения - Описание значения - возвращаемый параметр, тут мы можем переопределить результат в зависимости от того как будем его отображать, если задуматся глубоко то ДС вообше не должно существовать
// 
// Возвращаемое значение:
//  Булево - Выполнять вариант или нет
Функция ПереопределитьВыполнение(УникальныйИдентификатор,ДопПараметры,Вариант,ОписаниеЗначения) Экспорт
	Результат = Истина;
	Если Вариант = ВариантЗапросКлиентСервер_Ei Тогда
		//если это запрос то его не нужно выполнять, он будут выполнен при создание элементов на форме, тоесть в модуле РезультатКлиентСервер_ДинСписок_Ei
		ТекстЗапроса = ВариантЗапросКлиентСервер_Ei.ПолучитьТекстЗапроса();	
		Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
			//ПараметрыКлиентСервер_Ei.УточнитьПараметры(ТД, УникальныйИдентификатор, Параметры);
			ОписаниеЗначения = РезультатВызовСервера_ДинСписок_Ei.ПодготовитьЗапрос(ТекстЗапроса,УникальныйИдентификатор);
		КонецЕсли;	 
		Результат = Ложь;
	КонецЕсли;	
	Возврат Результат;	
КонецФункции

Процедура ПослеЗагрузкиРезультата(Форма) Экспорт
	Возврат;	
КонецПроцедуры


#Если Сервер Тогда
	
Функция Загрузить(Форма,ВариантИД,Результат,мКолонокРезультата) Экспорт
	Возврат РезультатВызовСервера_ДинСписок_Ei.Загрузить(Форма,ВариантИД,Результат,мКолонокРезультата);
КонецФункции

// Привести результат к типу, который возможно показать
// 
// Параметры:
//  СохраненныйРезультат - Произвольное значение - значение которые мы птыемся показать данным обработчиком
// 
// Возвращаемое значение:
//	Произвольное значение - Значение приведенное к типу	который можно тут отобразить   
Функция ПривестиРезультат(СохраненныйРезультат) Экспорт
	Результат 	= Неопределено;
	Если Не СохраненныйРезультат = Неопределено Тогда
		ВызватьИсключение "Не удалось отобразить результат в данном представлении";
	КонецЕсли;	 
	Возврат Результат;		
КонецФункции

Функция ОпределитьРазмерность(Результат) Экспорт
	Возврат Неопределено;		
КонецФункции

Процедура ДополнитьДинамическийЭлементФормы(Форма,элФормы) Экспорт
	РезультатВызовСервера_ДинСписок_Ei.ДополнитьДинамическийЭлементФормы(Форма,элФормы);	
КонецПроцедуры

Функция ПолучитьДопустимыеСвойства(Значение, УникальныйИдентификатор) Экспорт
	Возврат РезультатВызовСервера_ДинСписок_Ei.ПолучитьДопустимыеСвойства(Значение, УникальныйИдентификатор);		
КонецФункции

#КонецЕсли	

#Если Клиент Тогда

Процедура Инициализировать(Форма, Контейнер) Экспорт
	Форма.ДобавитьРеквизитыРезультата(Свойства().Имя,Неопределено);	
КонецПроцедуры

Процедура ПриОтображении(Форма) Экспорт
	РезультатКлиент_ДинСписок_Ei.ПриОтображении(Форма);	
Конецпроцедуры

Процедура ОбработкаОшибокЗагрузки(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	РезультатКлиент_ДинСписок_Ei.ОбработкаОшибокЗагрузки(Форма,СобытиеОтладки,ИнфоОбОшибке)
КонецПроцедуры

#Иначе

Процедура ДобавитьРеквизиты(Форма, ИД) Экспорт
	Если ИД = Неопределено Тогда
		//это первичное заполнение, на этапе инициализации
		РезультатыСервер_Ei.ДобавитьВспомогательныеЭлементы(Форма,РезультатКлиентСервер_ДинСписок_Ei);
	Иначе
							
	КонецЕсли;						
КонецПроцедуры 	 					


#Область ОбщегоНазначения

// Функция - Сериализовать, описывает форму родителя для дальнейшего добавления в потомка 
//
// Параметры:
//  ФормаРодитель	 - Форма	 - Форма от которой заимствуется поведение
//  ФормаПотомок	 - Форма	 - Форма в которую зимствуется поведение
// 
// Возвращаемое значение:
//   - Адрес во временном хранилище - во временном хранилище содержится структура с описанием формы
//
Функция Сериализовать(ФормаРодитель,ФормаПотомок,ПутьРеквизитов)
	Инициализировать(ФормаРодитель.НаследованиеФорм);
	ФормаРодитель.НаследованиеФорм.ФормаПотомок = ФормаПотомок;
	Возврат ФормаРодитель.СериализоватьФорму(ПутьРеквизитов);	
КонецФункции

// Процедура - Дополнитяет форму потомка, поведением и элементами формы родителя
//
// Параметры:
//  ФормаРодитель	 	- Форма	 - Форма от которой заимствуется поведение
//  ФормаПотомок	 	- Форма	 - Форма в которую зимствуется поведение
//  ЭлементРодитель	 	- ГруппаФормы	- Элемент формы потомка в который помещаются все элементы формы наследника
//  ПутьРеквизитов		- Соответствие из Строка - Соответсвие новых путей для определенных реквизитов формы
//  ЭлементКПРодитель	- ГруппаФормы	- ГРуппа кнопок в которую помешаются элементы командной панели формы наследника 		 
//
Процедура Дополнить(ФормаРодитель,ФормаПотомок,ЭлементРодитель,ПутьРеквизитов = Неопределено,ЭлементКПРодитель = Неопределено) Экспорт
	Инициализировать(ФормаПотомок.НаследованиеФорм);
	Адрес = Сериализовать(ФормаРодитель,ФормаПотомок,ПутьРеквизитов);
	ЭлементКПРодительИмя = ?(ЭлементКПРодитель = Неопределено,Неопределено,ЭлементКПРодитель.Имя);
	ФормаПотомок.ДополнитьФорму(ЭлементРодитель.Имя,Адрес,ЭлементКПРодительИмя);
	ФормаПотомок.НаследованиеФорм.ФормыРодители.Вставить(ЭлементРодитель.Имя,ФормаРодитель);
КонецПроцедуры

// Процедура - Производит инициализацию переменной формы
//
// Параметры:
//  НаследованиеФорм - Произвольный	 - Путь к экспортной перемемнной формы 
//
Процедура Инициализировать(НаследованиеФорм)
	Если Не ТипЗнч(НаследованиеФорм) = Тип("Структура") Тогда
		НаследованиеФорм = Новый Структура("ФормыРодители,ФормаПотомок",Новый Соответствие);
	КонецЕсли;
КонецПроцедуры

// Функция - Выполняет переопределение формы для событий
//
// Параметры:
//  НаследованиеФорм - Структура - Экспортная переменная формы наследника
//  ИсходнаяФорма	 - Форма	 - Форма в которой возникло события
// 
// Возвращаемое значение:
//   ФормаКлиентскогоПриложения 
//
Функция Переопределить(НаследованиеФорм, ИсходнаяФорма) Экспорт
	Если ТипЗнч(НаследованиеФорм) = Тип("Структура") И Не НаследованиеФорм.ФормаПотомок = Неопределено Тогда
		Возврат НаследованиеФорм.ФормаПотомок;
	Иначе
		Возврат ИсходнаяФорма;
	КонецЕсли;	
КонецФункции	

// Функция - Определяет из какой формы наследован элемент 
//
// Параметры:
//  ФормаПотомок - Форма	 -  Форма образованная в результате наследования
//  Элемент		 - Элементформы	 - Элмент для которого нужно определить родителя
// 
// Возвращаемое значение:
//   Форма
//
Функция ПолучитьФормуРодителя(ФормаПотомок, Элемент)
	Результат = Неопределено;
	Родитель = Элемент.Родитель;
	Пока Не Родитель =  Неопределено Цикл
		Результат = ФормаПотомок.НаследованиеФорм.ФормыРодители.Получить(Родитель.Имя);
		Если Не Результат = Неопределено Тогда
			Прервать;
		КонецЕсли;	
		Родитель = Родитель.Родитель; 
	КонецЦикла;	
	Возврат Результат;
КонецФункции	

// Процедура - Выполняет команду формы из формы наследования
//
// Параметры:
//  ФормаПотомок - Форма	 -  Форма образованная в результате наследования
//  Команда		 - Команда	 -  Команда формы
//
Процедура Команда(ФормаПотомок,Команда) Экспорт
	ИмяРодителя= ОбщегоНазначенияКлиентСервер_Ei.СтрНачалоДо(Команда.Имя,НаследованиеФормКлиентСервер_Ei.стрРазделительИмени());
	Если Не ИмяРодителя = Неопределено Тогда
		ФормаРодитель = ФормаПотомок.НаследованиеФорм.ФормыРодители.Получить(ИмяРодителя);
		Если Не ФормаРодитель = Неопределено Тогда
	    	ФормаРодитель.Команда(Команда);
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры



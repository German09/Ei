
Процедура Инициализировать(НаследованиеФорм) Экспорт
	Если Не ТипЗнч(НаследованиеФорм) = Тип("Структура") Тогда
		НаследованиеФорм = Новый Структура("ФормыРодители,ФормаПотомок",Новый Соответствие);
	КонецЕсли;
КонецПроцедуры

Функция ПереопределитьФорму(НаследованиеФорм, ИсходнаяФорма) Экспорт
	Если ТипЗнч(НаследованиеФорм) = Тип("Структура") И Не НаследованиеФорм.ФормаПотомок = Неопределено Тогда
		Возврат НаследованиеФорм.ФормаПотомок;
	Иначе
		Возврат ИсходнаяФорма;
	КонецЕсли;	
КонецФункции	

Функция ПолучитьФормуРодителя(ФормаПотомок, Элемент)
	Результат = Неопределено;
	Родитель = Элемент.Родитель;
	Пока Не Родитель =  Неопределено Цикл
		Результат = ФормаПотомок.НаследованиеФорм.ФормыРодители.Получить(Родитель.Имя);
		Если Не Результат = Неопределено Тогда
			Прервать;
		КонецЕсли;	
		Родитель = Родитель.Родитель; 
	КонецЦикла;	
	Возврат Результат;
КонецФункции	

Процедура Команда(ФормаПотомок,Команда) Экспорт
	мЧастейИмени = СтрРазделить(Команда.Имя,НаследованиеФормКлиентСервер_Ei.стрРазделительИмени(),Ложь);
	Для Каждого ИмяРодителя ИЗ мЧастейИмени Цикл
		ФормаРодитель = ФормаПотомок.НаследованиеФорм.ФормыРодители.Получить(ИмяРодителя);
		Если Не ФормаРодитель = Неопределено Тогда
	    	ФормаРодитель.Команда(Команда);
		КонецЕсли;	
		Прервать;
	КонецЦикла
КонецПроцедуры


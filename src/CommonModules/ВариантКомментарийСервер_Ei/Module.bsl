#Область ПрограммныйИнтерфейс
// Инициализировать.
// 
// Параметры:
//  Форма 		- Форма
//  Контейнер 	- ГруппаФормы
Процедура Инициализировать(Форма, Контейнер) Экспорт
	Обработчик = ВариантКомментарийКлиентСервер_Ei;
	ДобавляемыеРеквизиты	= Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Обработчик.Свойства().Имя, Новый ОписаниеТипов("Строка"),КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента(),,Истина));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Обработчик.Свойства().Имя, Новый ОписаниеТипов("ФорматированныйДокумент")));
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	ЭлФормы 	= Форма.Элементы.Добавить("ФормДок"+Обработчик.Свойства().Имя, Тип("ПолеФормы"), Контейнер);
	ЭлФормы.Вид 				= ВидПоляФормы.ПолеФорматированногоДокумента;
	ЭлФормы.ПутьКДанным			= Обработчик.Свойства().Имя;
	ЭлФормы.ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Нет;
	ЭлФормы.УстановитьДействие("ПриИзменении","КомментарийПолеПриИзменении");
КонецПроцедуры
#КонецОбласти
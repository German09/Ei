#Область ПрограммныйИнтерфейс

// Временные таблицы, которые запросы пакета помещают и уничтожают.
//
// Параметры:
//  ТекстЗапроса - Строка
//
// Возвращаемое значение:
//  Массив из Структура - по запросам пакета, пустой, если текст не разобран:
//   * Помещение	- Строка	- имя временной таблицы ПОМЕСТИТЬ
//   * Уничтожение	- Строка	- имя уничтожаемой временной таблицы
//
Функция ЗапросыПакета(ТекстЗапроса) Экспорт

	Запросы = Новый Массив; // Массив из Структура
	Попытка
		Схема = Новый СхемаЗапроса;
		Схема.УстановитьТекстЗапроса(ТекстЗапроса);
		Для Каждого ЗапросСхемы Из Схема.ПакетЗапросов Цикл
			ЗапросПакета = Новый Структура("Помещение, Уничтожение", "", "");
			Если ТипЗнч(ЗапросСхемы) = Тип("ЗапросВыбораСхемыЗапроса") Тогда
				ЗапросПакета.Помещение = ЗапросСхемы.ТаблицаДляПомещения;
			Иначе
				ЗапросПакета.Уничтожение = ЗапросСхемы.ИмяТаблицы;
			КонецЕсли;
			Запросы.Добавить(ЗапросПакета);
		КонецЦикла;
	Исключение
		// Неразобранный текст оставляем для диагностики при выполнении запроса.
		Запросы = Новый Массив;
	КонецПопытки;

	Возврат Запросы;

КонецФункции

// Функция - Получить параметры из запроса
//
// Параметры:
//  ТекстЗапроса - Строка	 - Текст запроса
// 
// Возвращаемое значение:
//   см. ПараметрыВызовСервера_Ei.ПолучитьПараметры 
//
Функция ПолучитьПараметры(ТекстЗапроса) Экспорт
	Попытка
		Запрос		= Новый Запрос(ТекстЗапроса);
		Параметры 	= Запрос.НайтиПараметры(); 
	Исключение
		Возврат Новый Массив; //видимо ошибка в тексте запроса, по тихому закончим
	КонецПопытки;
	Возврат ПараметрыВызовСервера_Ei.ПолучитьПараметры(Запрос, Параметры);
КонецФункции


// Отладка.
// Создает вариант, если в менедежереВТ есть временные таблицы то для каждой ВТ:
// 	Создается вложенных вариант с типом коллекция
// 	Добавлются отдельный параметр запроса на встроенном языке
// 	В пакет вставляется запрос на создание ВТ из параметра
// C учетом этого, важно передавать запрос до его выполнения, поскольку может быть дублирование ВТ (если они создаются этим же запросом)	 
// 
// Параметры:
//  Запрос - Запрос - Запрос до его выполнения, будут анализировать 
// 
// Возвращаемое значение:
// 	Строка 
Функция Отладка(Запрос) Экспорт	
	УведомленияКлиента.ОтправитьУведомление("ДобавлениеОтладки"+ОбщегоНазначенияКлиентСервер_Ei.Постфикс(), СериализацияЗапроса(Запрос));
	Возврат "Вернитесь в Ei, будет добавлен новый вариант";	 //см. ВариантЗапросКлиент_Ei.ДобавлениеОтладки
КонецФункции

// Сериализация запроса.
// 
// Параметры:
//  Запрос  - Запрос
// 
// Возвращаемое значение:
//  Структура - Сериализация запроса:
// 	* Запрос - Строка - 
Функция СериализацияЗапроса(Запрос) Экспорт
	Результат = Новый Структура("Запрос",Новый Структура);
	Возврат Результат;
КонецФункции
	
#КонецОбласти

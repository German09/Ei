// Функция - Получить параметры из запроса
//
// Параметры:
//  ТекстЗапроса - Строка	 - Текст запроса
// 
// Возвращаемое значение:
//   - Массив структур аналогичных описанию парамемтров 
//
Функция ПолучитьПараметры(ТекстЗапроса) Экспорт
	Попытка
		Запрос				= Новый Запрос(ТекстЗапроса);
		ПараметрыЗапроса 	= Запрос.НайтиПараметры(); 
	Исключение
		Возврат Новый Массив; //видимо ошибка в тексте запроса, по тихому закончим
	КонецПопытки;
	ТабСортировки 		= Новый ТаблицаЗначений;
	ТабСортировки.Колонки.Добавить("ОписаниеПараметра");
	ТабСортировки.Колонки.Добавить("Порядок",Новый ОписаниеТипов("Число"));
	Для Каждого ПараметрЗапроса Из ПараметрыЗапроса Цикл
		НоваяСтрока = ТабСортировки.Добавить();	
		НоваяСтрока.ОписаниеПараметра 	= Новый Структура("Имя,ТипЗначения", ПараметрЗапроса.Имя,ПараметрЗапроса.ТипЗначения);
		НоваяСтрока.Порядок 			= Найти(ТекстЗапроса,"&"+ПараметрЗапроса.Имя);
	КонецЦикла;
	ТабСортировки.Сортировать("Порядок Возр");
	Возврат ТабСортировки.ВыгрузитьКолонку("ОписаниеПараметра");
КонецФункции
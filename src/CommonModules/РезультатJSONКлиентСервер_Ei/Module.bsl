#Область ИнтерфейсРезультатов

// Свойства компонента. Для подключения модуль должен быть включен в Подсистему Ei-Результаты
// 
// Возвращаемое значение:
//  Структура - Свойства:
// 		* Имя 			- Строка -
// 		* Синоним 		- Строка -
// 		* Картинка 		- Картинка -
// 		* Класс 		- ОбшийМодуль 	- см. РезультатыКлиентСервер_Ei					
// 		* ТипРеквизита 	- Строка 		- тип для которого, выводится результат, тип должен быть универсальный см. ТипыКлиентСервер_Ei.ПолучитьИмяОписанияТипов 
// 		* Типы 			- Массив из Строка - Типы, для которых,выводится результат, тип должен быть универсальный см. ТипыКлиентСервер_Ei.ПолучитьИмяОписанияТипов
Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",			"JSON2");
	Результат.Вставить("Синоним",		"JSON");
	Результат.Вставить("Картинка",		БиблиотекаКартинок.Json_Ei);
	Результат.Вставить("Класс",			РезультатыКлиентСервер_Ei);
	Результат.Вставить("ТипРеквизита",	"string");
	Результат.Вставить("Типы",			Новый Массив); //поддерживаемые типы, помимо имени
		Результат.Типы.Добавить("JSONWriter");
		Результат.Типы.Добавить("JSONReader");
	Возврат Результат;
КонецФункции

// Выполняется до выполнения варианта для данноготипа результата
// Варинат не всегда нужно выполнять для некоторых результатов, например в Динамическом списке, не нужно выполнять запрос
// 
// Параметры:
//  Вариант  - ОбщийМодуль - модуль варианта
//  ОписаниеЗначения - Структура - возвращаемый параметр, тут мы можем переопределить результат в зависимости от того как будем его отображать, если задуматся глубоко то ДС вообше не должно существовать
// 
// Возвращаемое значение:
//  Булево - Выполнять вариант или нет
Функция ПереопределитьВыполнение(УникальныйИдентификатор,ДопПараметры,Вариант,ОписаниеЗначения) Экспорт
	Результат = Истина;
	Возврат Результат;
КонецФункции	

#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда

//Значение сохраним в подсказку потому потому что доступно только на клиенте
//	
Функция Загрузить(Форма,ВариантИД,Результат,мКолонокРезультата) Экспорт
	ЭлементИнструкции = ЭлементИнструкции(Форма);
	Если Не ЭлементИнструкции = Неопределено Тогда
		ЭлементИнструкции.Подсказка = Результат;
	КонецЕсли;				
	Возврат Истина;
КонецФункции

// Привести результат к типу, который возможно показать
// 
// Параметры:
//  СохраненныйРезультат - Произвольное значение - значение которые мы птыемся показать данным обработчиком
// 
// Возвращаемое значение:
//	Произвольное значение - Значение приведенное к типу	который можно тут отобразить   
Функция ПривестиРезультат(СохраненныйРезультат) Экспорт
	Возврат Неопределено;		
КонецФункции

Функция ОпределитьРазмерность(Результат) Экспорт
	Перем ОбъемКоллекции;
	Возврат ОбъемКоллекции;		
КонецФункции

Функция ПолучитьДопустимыеСвойства(Значение, УникальныйИдентификатор) Экспорт
	Возврат Новый СписокЗначений;		
КонецФункции

#КонецЕсли	

#Если Клиент Тогда

Процедура ПриОтображении(Форма) Экспорт
	РезультатJSONКлиент_Ei.ПриОтображении(Форма);
Конецпроцедуры

Процедура ОбработкаОшибокЗагрузки(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	РезультатJSONКлиент_Ei.ОбработкаОшибокЗагрузки(Форма,СобытиеОтладки,ИнфоОбОшибке);
КонецПроцедуры

Процедура ПослеЗагрузкиРезультата(Форма) Экспорт
	ЭлементИнструкции = ЭлементИнструкции(Форма);
	Если Не ЭлементИнструкции = Неопределено Тогда
		УстановленныйТекст = РедакторJSONКлиент_Ei.ПолучитьТекст(ЭлементИнструкции);
		Если Не УстановленныйТекст = ЭлементИнструкции.Подсказка Тогда 
			РедакторJSONКлиент_Ei.УстановитьТекст(ЭлементИнструкции,ЭлементИнструкции.Подсказка);
		КонецЕсли;	
		ЭлементИнструкции.Подсказка = "";
	КонецЕсли;		
КонецПроцедуры


#КонецЕсли

#Если Сервер ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда

Процедура Инициализировать(Форма, Контейнер) Экспорт
	ВариантыВызовСервера_Ei.ИнициализироватьПоИмени(Форма, РезультатJSONКлиентСервер_Ei);
КонецПроцедуры	

#КонецЕсли		

#КонецОбласти

Функция ЭлементИнструкции(Форма) Экспорт 
	Возврат Форма.Элементы.Найти("HTML_JSON2");			
КонецФункции	


Функция ПолучитьМенеджерТипаПоПсевдониму(Псевдоним) Экспорт
	Для Каждого элСоответ ИЗ ТипыКлиентСервер_Ei.Ключевые() Цикл
		мИмен = СтрРазделить(элСоответ.Значение,";");
		Если мИмен.Количество()>1 Тогда
			Если нРег(Псевдоним) = нРег(мИмен[1]) Тогда 		
				Возврат Вычислить(мИмен[0]);
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
КонецФункции	

// Пытается получить ссылку или объект из навигационной ссылки
//
// Параметры:
//  сНавСсылка	 - Строка - Навигационная ссылка вида e1cib/data/Справочник.Справочник1?ref=a291a0c5895957df11e77b287dd26811
// 
// Возвращаемое значение:
//   - 
//
Функция ПолучитьСсылкуИзНавСсылки(сНавСсылка) Экспорт
	Результат 	= Неопределено;
	сПризнак 	= "e1cib/data/";
	сРазделитель= "?ref=";
	чНачалоЗнач	= Найти(сНавСсылка,сПризнак);
	Если чНачалоЗнач Тогда
		сНавСсылка = Сред(сНавСсылка,чНачалоЗнач+СтрДлина(сПризнак));
		мНавСсылка = СтрРазделить(СтрЗаменить(сНавСсылка,сРазделитель,"?"),"?",Ложь);
		Если мНавСсылка.Количество()=2 Тогда
			мПуть = СтрРазделить(мНавСсылка[0],".");
			Если мПуть.Количество()=2 Тогда
				МенеджерТипа = ОбщийМодульСерверПовтИсп_Ei.ПолучитьМенеджерТипаПоПсевдониму(мПуть[0]);
				Если Не МенеджерТипа = Неопределено Тогда
					Менеджер 	= МенеджерТипа[мПуть[1]];
					Результат 	= Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбщийМодульКлиентСервер_Ei.вПреобразоватьИдентификатор(мНавСсылка[1])));
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли
	КонецЕсли;
	Возврат Результат;
КонецФункции
	
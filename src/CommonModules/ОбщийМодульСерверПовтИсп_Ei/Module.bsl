
Функция ПолучитьМенеджерТипаПоПсевдониму(Псевдоним) Экспорт
	Для Каждого элСоответ ИЗ ТипыКлиентСервер_Ei.Ключевые() Цикл
		мИмен = СтрРазделить(элСоответ.Значение,";");
		Если мИмен.Количество()>1 Тогда
			Если нРег(Псевдоним) = нРег(мИмен[1]) Тогда 		
				Возврат Вычислить(мИмен[0]);
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
КонецФункции	

// Пытается получить ссылку или объект из навигационной ссылки
//
// Параметры:
//  сНавСсылка	 - Строка - Навигационная ссылка вида 	e1cib/data/Справочник.Справочник1?ref=a291a0c5895957df11e77b287dd26811
//  													e1cib/data/ВнешнийИсточникДанных.POS.Таблица.BASEDOC_DISCOUNT?ref=8001000001B18D28
// 
// Возвращаемое значение:
//   Произвольный
Функция ПолучитьСсылкуИзНавСсылки(Знач сНавСсылка) Экспорт
	Результат 	= Неопределено;
	сПризнак 	= "e1cib/data/";
	сРазделитель= "?ref=";
	чНачалоЗнач	= Найти(сНавСсылка,сПризнак);
	Если чНачалоЗнач Тогда
		сНавСсылка = Сред(сНавСсылка,чНачалоЗнач+СтрДлина(сПризнак));
		мНавСсылка = СтрРазделить(СтрЗаменить(сНавСсылка,сРазделитель,"?"),"?",Ложь);
		Если мНавСсылка.Количество()=2 Тогда
			мПуть = СтрРазделить(мНавСсылка.Получить(0),".");
			Если мПуть.Количество()>1 Тогда
				МенеджерТипа = ОбщийМодульСерверПовтИсп_Ei.ПолучитьМенеджерТипаПоПсевдониму(мПуть.Получить(0));
				Если Не МенеджерТипа = Неопределено Тогда
					Попытка	
						Менеджер 	= МенеджерТипа[мПуть.Получить(1)];
						Если мПуть.Количество()= 2 Тогда					
							Результат 	= Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбщийМодульКлиентСервер_Ei.вПреобразоватьИдентификатор(мНавСсылка.Получить(1))));				
						ИначеЕсли мПуть.Количество()= 4 Тогда
							//это внешний источник данных 
							МенеджерТаблицы	= Менеджер.Таблицы[мПуть.Получить(3)];
							Результат 		= МенеджерТаблицы.ПолучитьСсылку(мНавСсылка.Получить(1));			
						КонецЕсли;
					Исключение
						Результат 	= Неопределено;
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;					
		КонецЕсли
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция Формы() Экспорт
	Возврат Новый Соответствие();
КонецФункции

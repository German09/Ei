Функция Загрузить(Форма,ВариантИД,Результат,мКолонокРезультата) Экспорт
	Если Результат = Неопределено Тогда
		//это очистка значения
		Результат =  Новый ДеревоЗначений();
	КонецЕсли;	
	Возврат РезультатТаблицаВызовСервера_Ei.ЗагрузитьДляОбработчика(Форма,ВариантИД,Результат,мКолонокРезультата,РезультатДеревоКлиентСервер_Ei);;
КонецФункции

// Привести результат к типу, который возможно показать
// 
// Параметры:
//  Значение - Произвольный - значение которые мы птыемся показать данным обработчиком
// 
// Возвращаемое значение:
//	ДеревоЗначений - Значение приведенное к типу	который можно тут отобразить   
Функция ПривестиРезультат(Значение) Экспорт
	ОписаниеТипаРезультата 	= Новый ОписаниеТипов(РезультатДеревоКлиентСервер_Ei.Свойства().ТипРеквизита);
	Результат 				= ОписаниеТипаРезультата.ПривестиЗначение(Неопределено); //ДеревоЗначений
	Если ТипЗнч(Значение) = Тип("МакетКомпоновкиДанных") Тогда				
		РезультатыСервер_Ei.ВывестиВКоллекециюСКД(Значение,Результат); //Устарела после использования ПроцессорВывода_Ei
	ИначеЕсли ТипЗнч(Значение) = Тип("ОтчетОбъект.ПроцессорВывода_Ei") Тогда
		Значение.ВывестиВКоллекцию(Результат);	
	ИначеЕсли ТипЗнч(Значение) = Тип("РезультатЗапроса") Тогда
		Результат 	= Значение.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ИначеЕсли ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
		Результат 	= ВыгрузитьТаблицуЗначенийВДеревоЗначений(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("ВыборкаИзРезультатаЗапроса") Тогда
		Результат = Значение.Владелец().Выгрузить(ОбходРезультатаЗапроса.Прямой);				
	ИначеЕсли Не Значение = Неопределено Тогда
		Попытка 
			СериализаторXDTO.ЗаписатьXDTO(Значение);
			//если не можем сериализовать то скорее всего и не получится это значение как то обработать и передать на клиент для отображения
		Исключение
			ВызватьИсключение СтрШаблон("Не удалось отобразить результат (%1) в данном представлении ",ТипЗнч(Значение));
		КонецПопытки;		
		КолонкаИмя = ОбщегоНазначенияКлиентСервер_Ei.вВрегПослеПробела(ТипыКлиентСервер_Ei.ВСтроку(ТипЗнч(Значение)));
		Результат.Колонки.Добавить(КолонкаИмя);
		Результат.Строки.Добавить()[КолонкаИмя] = Значение;	
	КонецЕсли;
	Возврат Результат;		
КонецФункции

Функция ОпределитьРазмерность(Результат) Экспорт
	Перем ОбъемКоллекции;
	Если ТипЗнч(Результат) = Тип("ДеревоЗначений") Тогда
		ВспомКолонка = ДобавитьВспомКолонку(Результат);
			ОбъемКоллекции = ""+КоллекцияВызовСервера_Ei.ПолучитьСтрокиКоллекции(Результат,Ложь,ВспомКолонка.Имя).Количество();
		Результат.Колонки.Удалить(ВспомКолонка);
		Если ЗначениеЗаполнено(ОбъемКоллекции) Тогда
			ОбъемКоллекции = ""+ОбъемКоллекции+"/"+Результат.Колонки.Количество();
		КонецЕсли;				
	КонецЕсли;
	Возврат ОбъемКоллекции;		
КонецФункции
 
Функция ДобавитьВспомКолонку(Результат) Экспорт
	ИмяКолонки = ОбщегоНазначенияКлиентСервер_Ei.ИдентификаторВКлюч(Новый УникальныйИдентификатор());
	Возврат Результат.Колонки.Добавить(ИмяКолонки,Новый ОписаниеТипов("Булево"));	
КонецФункции

Функция ПолучитьДопустимыеСвойства(Значение, УникальныйИдентификатор) Экспорт
	Результат 				= Новый СписокЗначений;
	Результат.Добавить(ОписаниеЗначенияКлиентСервер_Ei.Подготовить(Значение.Строки,УникальныйИдентификатор),"Строки");
	Результат.Добавить(ОписаниеЗначенияКлиентСервер_Ei.Подготовить(Значение.Колонки,УникальныйИдентификатор),"Колонки");
	Возврат Результат;		
КонецФункции

// Функция выгружает данные из таблицы значений в дерево значений
// 
// Параметры:
//  Таблица 			-ТаблицаЗначений
//  КолонкаГруппировки - Строка - Колонка группировки
// 
// Возвращаемое значение:
//  ДеревоЗначений 
Функция ВыгрузитьТаблицуЗначенийВДеревоЗначений(Таблица, КолонкаГруппировки = Неопределено) Экспорт
    Дерево = Новый ДеревоЗначений;
    Для Каждого Колонка Из Таблица.Колонки Цикл
        Дерево.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
    КонецЦикла;
    
    Для Каждого СтрокаТаблицы ИЗ Таблица Цикл
    	СтрокаГруппировки = Неопределено;
    	Если Не КолонкаГруппировки= Неопределено Тогда 
        	СтрокаГруппировки = Дерево.Строки.Найти(СтрокаТаблицы[КолонкаГруппировки], КолонкаГруппировки, Истина);
        КонецЕсли;	
        Если СтрокаГруппировки = Неопределено Тогда
            Набор = Дерево.Строки;
        Иначе
            Набор = СтрокаГруппировки.Строки;
        КонецЕсли;
        ЗаполнитьЗначенияСвойств(Набор.Добавить(), СтрокаТаблицы);
    КонецЦикла;
    Возврат Дерево;
КонецФункции	
#Область ИнтерфейсВариантов

Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",			ВариантыКлиентСерверПовторноеИспользование_Ei.ИмяЭлементаАлгоритма());
	Результат.Вставить("Синоним",		ВариантыКлиентСерверПовторноеИспользование_Ei.ИмяЭлементаАлгоритма());
	Результат.Вставить("Картинка",		БиблиотекаКартинок.Алгоритм_Ei);
	Результат.Вставить("КартинкаСсылка",ПоместитьВоВременноеХранилище(Результат.Картинка,Новый УникальныйИдентификатор));
	Возврат Результат;
КонецФункции

Функция ВыполнитьВариант(Форма,УникальныйИдентификатор,ТД,Параметры,ДопПараметры,ОбработчикРезультата = Неопределено) Экспорт
	Перем КонтекстВыполнения;
	Перем ОписаниеЗначения;
	ТекстВыполняемогоКода = ПолучитьТекстВыражения(Форма, ТД);	
	Если ЗначениеЗаполнено(ТекстВыполняемогоКода) Тогда
		Если ОбработчикРезультата =  Неопределено ИЛИ  
			 ОбработчикРезультата.ПереопределитьВыполнение(Форма,УникальныйИдентификатор,ТД,Параметры,ДопПараметры,ВариантКлиентСервер_Ei_Алгоритм,ОписаниеЗначения) Тогда
			//мсТипов 				= РезультатыКлиентСервер_Ei.мТиповОжидаемыхРезультатов();
			КонтекстВыполнения 		= ПолучитьКонтекстВыполнения(Форма, ТД, ДопПараметры);
			ОписаниеЗначения		= ВыполнитьКлиентСервер_Ei.Выражение(ТекстВыполняемогоКода,УникальныйИдентификатор,,КонтекстВыполнения);
		КонецЕсли;		
		КонтекстВыполнения.Свойство("Параметры",Параметры); // для передачи через входной параметры в ПоказатьРезультат() TODO #19 разобраться с возможностью обновления параметров в алгоритмах
	КонецЕсли;
	Возврат ОписаниеЗначения;	
КонецФункции

// Подготовить данные для помещения их в параметры сеанса НаборВариантов_Ei
// 
// Параметры:
//  Форма Форма конструктора
//  Строка Строка дерева вариантов
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Подготовить данные:
// * Инструкция 
Функция ПодготовитьДанные(Форма, Строка) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Инструкция",Строка.Язык);
	Возврат Новый ФиксированнаяСтруктура(Результат);		
КонецФункции

#Если Клиент Тогда

Функция ПолучитьРазмерность(Форма,ТД) Экспорт
	ТекстЗапроса = ПолучитьТекстВыражения(Форма, ТД);
	Возврат ТекстМодуляКлиент_Ei.ПолучитьЧислоСтрок(ТекстЗапроса)
КонецФункции	
	
Процедура Инициализировать(Форма, Контейнер) Экспорт
	ВариантКлиент_Ei_Алгоритм.Инициализировать(Форма, Контейнер);
КонецПроцедуры

Процедура ПриИзмененииДанных(Форма) Экспорт
	ВариантКлиент_Ei_Алгоритм.ПриИзмененииДанных(Форма);
Конецпроцедуры

Процедура ПриОтображении(Форма) Экспорт
	ВариантКлиент_Ei_Алгоритм.ПриОтображении(Форма);	
Конецпроцедуры

Процедура ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ВариантКлиент_Ei_Алгоритм.ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке);
КонецПроцедуры

Процедура УстановитьПараметры(Форма) Экспорт
	Возврат;	
КонецПроцедуры

Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ВариантКлиент_Ei_Алгоритм.РасшифровкаОшибки(Форма,Элемент);			
КонецПроцедуры

#КонецЕсли

#КонецОбласти

Функция ПолучитьКонтекстВыполнения(Форма, ТД, ДопПараметры)
	Перем КонтекстВыполнения;
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ДопПараметры,"КонтекстВыполнения") Тогда
		ДопПараметры.Свойство("КонтекстВыполнения",КонтекстВыполнения);	
	Иначе
		#Если Клиент Тогда
			КонтекстВыполнения 	= ВариантыКлиент_Ei.ПолучитьСтруктуруДоступныхПеременных(Форма,ТД,Ложь);
		#КонецЕсли			
	КонецЕсли;
	Возврат КонтекстВыполнения;
КонецФункции

Функция ПолучитьТекстВыражения(Форма, ТД)
	Если ОбщийМодульКлиентСервер_Ei.ЕстьСвойство(ТД,"Инструкции") Тогда
		//такая структура данных специфична для вызова из обработки выполнения
		Возврат ТД.Инструкции.Алгоритм;	
	Иначе
		#Если Клиент Тогда
			//получим текст алгорима это при интерактивном выполненнии
			Возврат ВариантыКлиент_Ei.ПолучитьТекстДляВыполнения(Форма,ТД,"Язык");
		#КонецЕсли	
	КонецЕсли;
КонецФункции

#Область ИнтерфейсВариантов

Функция Свойства() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Имя",			"Алгоритм");
	Результат.Вставить("Синоним",		"Алгоритм");
	Результат.Вставить("Картинка",		БиблиотекаКартинок.Алгоритм_Ei);
	Результат.Вставить("КартинкаСсылка",ПоместитьВоВременноеХранилище(Результат.Картинка,Новый УникальныйИдентификатор));
	Результат.Вставить("Класс",			ВариантыКлиентСервер_Ei);
	Результат.Вставить("Исполнение",	Истина); //Исполняется и выводит результат или просто возможно сохранение данных
	Возврат Результат;
КонецФункции

Функция ВыполнитьВариант(УникальныйИдентификатор,ДопПараметры,ОбработчикРезультата = Неопределено,ДанныеКлиента) Экспорт
	//Перем КонтекстВыполнения;
	Перем ОписаниеЗначения;
	ТекстВыполняемогоКода = ПолучитьТекстВыражения();	
	Если ЗначениеЗаполнено(ТекстВыполняемогоКода) Тогда
		Если ОбработчикРезультата =  Неопределено ИЛИ  
			 ОбработчикРезультата.ПереопределитьВыполнение(УникальныйИдентификатор,ДопПараметры,ВариантКлиентСервер_Ei_Алгоритм,ОписаниеЗначения) Тогда
			ОписаниеЗначения		= ВыполнитьКлиентСервер_Ei.Выражение(ТекстВыполняемогоКода,УникальныйИдентификатор);
		КонецЕсли;		
	КонецЕсли;
	Возврат ОписаниеЗначения;	
КонецФункции

Процедура ПослеВыполнения(Форма,ДанныеКлиента) Экспорт
	Возврат;	
КонецПроцедуры

// Подготовить данные для помещения их в параметры сеанса НаборВариантов_Ei
// 
// Параметры:
//  Форма Форма конструктора
//  Строка Строка дерева вариантов
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Подготовить данные:
// * Инструкция 
Функция ПодготовитьДанные(Строка) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Инструкция",Строка.Язык);
	Возврат Новый ФиксированнаяСтруктура(Результат);		
КонецФункции

// Загрузить данные из файла
// 
// Параметры:
//  Объект		-ДанныеФормыКоллекцияЭлементовДерева - Строка в которую грузим настройку
//  Настройка  	-ФиксированнаяСтруктура,Структура - Сохраненная настройка
//
Процедура ЗагрузитьДанные(Объект,Настройка) Экспорт
	Если ТипЗнч(Настройка) =  Тип("ФиксированнаяСтруктура") ИЛИ ТипЗнч(Настройка) =  Тип("Структура") Тогда
		Объект.Язык		= Настройка.Инструкция;
	КонецЕсли;	
КонецПроцедуры

#Если Клиент Тогда

Функция ПолучитьРазмерность(Форма,ТД) Экспорт
	ТекстЗапроса = ПолучитьТекстВыражения();
	Возврат ТекстМодуляКлиент_Ei.ПолучитьЧислоСтрок(ТекстЗапроса)
КонецФункции	

Процедура ПриИзмененииДанных(Форма) Экспорт
	ВариантКлиент_Ei_Алгоритм.ПриИзмененииДанных(Форма);
Конецпроцедуры

Процедура ПриОтображении(Форма) Экспорт
	ВариантКлиент_Ei_Алгоритм.ПриОтображении(Форма);	
Конецпроцедуры

Процедура ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке) Экспорт
	ВариантКлиент_Ei_Алгоритм.ОбработкаОшибокВыполнения(Форма,СобытиеОтладки,ИнфоОбОшибке);
КонецПроцедуры

Процедура УстановитьПараметры(Форма) Экспорт
	Возврат;	
КонецПроцедуры

Процедура РасшифровкаОшибки(Форма,Элемент) Экспорт
	ВариантКлиент_Ei_Алгоритм.РасшифровкаОшибки(Форма,Элемент);			
КонецПроцедуры

#Иначе

Процедура Инициализировать(Форма, Контейнер) Экспорт
	ДобавляемыеРеквизиты	= Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Язык", Новый ОписаниеТипов("Строка"),КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента(),,Истина));
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	элФормы 	= Форма.Элементы.Добавить("Язык", Тип("ПолеФормы"), Контейнер);
	элФормы.Вид 				= ВидПоляФормы.ПолеТекстовогоДокумента;
	элФормы.ПутьКДанным			= "Элементы."+КонструкторКлиентСервер_Ei.ИмяОсновногоЭлмента()+".ТекущиеДанные.Язык";
	элФормы.ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Нет;
	элФормы.УстановитьДействие("ПриИзменении","АлгоритмПолеПриИзменении");
	
	ИмяКоманды	= "ДоступныеПеременные";
	Кнопка = Форма.Элементы.Добавить(Свойства().Имя+ИмяКоманды, Тип("КнопкаФормы"), элФормы.КонтекстноеМеню);
	Кнопка.ИмяКоманды = ИмяКоманды;
КонецПроцедуры			

#КонецЕсли

#КонецОбласти


Функция ПолучитьТекстВыражения()
	Возврат ВариантыКлиентСервер_Ei.ПолучитьИнструкцию(Неопределено,Свойства().Имя);	
КонецФункции

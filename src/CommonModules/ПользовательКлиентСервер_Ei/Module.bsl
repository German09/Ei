Процедура Проверить(Настройки) Экспорт
	Если Не ТипЗнч(Настройки) =  Тип("Структура") Тогда
		Настройки =  Новый Структура();
	КонецЕсли;			
КонецПроцедуры

Функция ПодготовитьКлючНастроек(ТД) Экспорт	
	Возврат "_"+СтрЗаменить(ТД.КлючНастроек,"-","_");
КонецФункции

Функция Получить(Ключ,НастройкиПользователя) Экспорт 
	Перем Результат;
	Проверить(НастройкиПользователя);
	НастройкиПользователя.Свойство(Ключ,Результат);
	Возврат Результат;		
КонецФункции

Процедура Сохранить(Ключ, НастройкиПользователя, Значение) Экспорт  
	Проверить(НастройкиПользователя);
	НастройкиПользователя.Вставить(Ключ,Значение); 		
КонецПроцедуры
#Область ПрограммныйИнтерфейс
// Проверить.
// 
// Параметры:
//  Настройки  -  Структура, Неопределено -
Процедура ПроверитьНастройки(Настройки) Экспорт
	Если Не ТипЗнч(Настройки) =  Тип("Структура") Тогда
		Настройки =  Новый Структура();
	КонецЕсли;			
КонецПроцедуры

// Подготовить ключ настроек.
// 
// Параметры:
//  ТекД - ДанныеФормыЭлементДерева - Текущая строка данных варианта
// 
// Возвращаемое значение:
//  см. ОбщегоНазначенияКлиентСервер_Ei.ИдентификаторВКлюч
Функция ПодготовитьКлючНастроек(ТекД) Экспорт	
	Возврат ОбщегоНазначенияКлиентСервер_Ei.ИдентификаторВКлюч(ТекД.КлючНастроек);
КонецФункции

// Получить.
// 
// Параметры:
//  Ключ 					- Строка
//  НастройкиПользователя  	- Структура, Неопределено -
// 
// Возвращаемое значение:
//  Произвольный
Функция ПолучитьЗначениеНастройки(Ключ,НастройкиПользователя) Экспорт
	Перем Результат;
	ПроверитьНастройки(НастройкиПользователя);
	НастройкиПользователя.Свойство(Ключ,Результат);
	Возврат Результат;		
КонецФункции

// Сохранить.
// 
// Параметры:
//  Ключ 					- Строка
//  НастройкиПользователя  	- Структура, Неопределено -
//  Значение 				- Произвольный
Процедура Сохранить(Ключ, НастройкиПользователя, Значение) Экспорт  
	ПроверитьНастройки(НастройкиПользователя);
	НастройкиПользователя.Вставить(Ключ,Значение); 		
КонецПроцедуры
#КонецОбласти


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Результат 				= СтруктурыЗначенийВызовСервера_Ei.ПереопределитьЗначение(Параметры.ОписаниеЗначения);
	ИмяОсновногоРеквизита   = "ТЗ";
	ТаблицаОткрытьВызовСервера_Ei.ДобавитьРеквизитыТЗ(ЭтаФорма,ИмяОсновногоРеквизита,Результат);				
	ЗначениеВРеквизитФормы(Результат,ИмяОсновногоРеквизита); // переставил сюда, был в самом конце процедуры
	мКолонокРезультата 	= ОбщийМодульСервер_Ei.ПолучитьКолонкиРезультата(Результат);
	ТаблицаОткрытьВызовСервера_Ei.ДобавитьКолонкиВЭлемент(ЭтаФорма,0,ИмяОсновногоРеквизита,ИмяОсновногоРеквизита,мКолонокРезультата);
КонецПроцедуры

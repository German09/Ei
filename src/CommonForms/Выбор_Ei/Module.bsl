//Вызов осуществляется:
//	ВыборКлиент_Ei.НачалоВыбора() //см. параметры вызова

&НаКлиенте
Перем Выбор Экспорт;
//  Выбор		- Структура - Вспомогательная структура
//				ПараметрыСтроки			- Соответствие 						- Накопление соотвесвия типов и значени  более подробно в процедурее ПараметрыСтроки()
//				Переменные              - Структура							- Фиксированная структура переменных используемая для встроенного языка
//				ТекущиеДанные			- СтрокаТаблицыЗначений.Структура	- Используется для определения значений - ЭтоВыражение,ИмяПараметра
//				ДоступныеПеременные		- Структура							- ВыборПеременные, которые можно выбрать в текщем контексте
//				ОграничениеТипа			- ОписаниеТипов						- Типы которые доступны для выбора в текущем контексте, учитываются и для переменных
//				ЗапретитьВстроенныйЯзык - Неопределено						- Если это свойство указано не открываем окно встроенного языка
//  			Форма	 				- Форма 							- Форма в которой отображен диалог выбора 

&НаКлиенте
Перем НаследованиеФорм Экспорт; 		//переменная используемая в фреймворке наследования форм, храняться формы от которых текущая форма заимствует поведение + форма в которую нужно передать далее свое поведение 


#Область ВыборТипаИЛИЗначения

// ОБРАБОТЧИКИ СОБЫТИЙ ДЕРЕВА ЗНАЧЕНИЙ
#Область ОбработчикиСобытийДерева

&НаКлиенте
Процедура Выбор_FormTable(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) Экспорт
	ВыборКлиент_Ei.ДеревоЗначенийВыбор(ПереопределитьФорму(), Выбор, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)	
КонецПроцедуры

&НаКлиенте
Процедура ПередРазворачиванием_FormTable(Элемент, Строка, Отказ) Экспорт
	ВыборКлиент_Ei.ДеревоЗначенийПередРазворачиванием(ПереопределитьФорму(), Выбор, Элемент, Строка, Отказ);	
КонецПроцедуры

&НаКлиенте
Процедура ПередНачаломДобавления_FormTable(Элемент, Отказ, Копирование, Родитель, Группа, Параметр) Экспорт
	ВыборКлиент_Ei.ДеревоЗначенийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр);	
КонецПроцедуры

&НаКлиенте
Процедура ПередНачаломИзменения_FormTable(Элемент, Отказ) Экспорт
	ВыборКлиент_Ei.ДеревоЗначенийПередНачаломИзменения(Элемент, Отказ) 
КонецПроцедуры

&НаКлиенте
Процедура ПриНачалеРедактирования_FormTable(Элемент, НоваяСтрока, Копирование) Экспорт
	ВыборКлиент_Ei.ДеревоЗначенийПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование);
КонецПроцедуры

&НаКлиенте
Процедура ПриАктивизацииСтроки_FormTable(Элемент) Экспорт
	ВыборКлиент_Ei.ДеревоЗначенийПриАктивизацииСтроки(ПереопределитьФорму(), Выбор, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПередОкончаниемРедактирования_FormTable(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ) Экспорт
	ВыборКлиент_Ei.ДеревоЗначенийПередОкончаниемРедактирования(ПереопределитьФорму(), Выбор, Элемент, НоваяСтрока, ОтменаРедактирования, Отказ);
КонецПроцедуры

&НаКлиенте
Процедура Регулирование_ПолеВвода(Элемент, Направление, СтандартнаяОбработка) Экспорт
	ВыборКлиент_Ei.ДеревоЗначенийПредставлениеРегулирование(ПереопределитьФорму(), Выбор, Элемент,Направление,СтандартнаяОбработка);	
КонецПроцедуры

&НаКлиенте
Процедура НачалоПеретаскивания_FormTable(Элемент, ПараметрыПеретаскивания, Выполнение) Экспорт
	ВыборКлиент_Ei.ДеревоВыбораНачалоПеретаскивания(ПереопределитьФорму(), Выбор, Элемент, ПараметрыПеретаскивания, Выполнение)
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ДеревоВыбораЗакрыть(Команда)
	ВыборКлиент_Ei.ЗакрытьВыбор(ПереопределитьФорму());
КонецПроцедуры

#КонецОбласти


#Область НаследованиеФорм

#Область Общие

// Функция - Получить описание формы
// Возвращаемое значение:
//   - Адрес во временном хранилище - во временном хранилище содержится структура с описанием формы
//
&НаКлиенте
Функция СериализоватьФорму(ФормаПотомок) Экспорт
	НаследованиеФормКлиент_Ei.Инициализировать(НаследованиеФорм);
	НаследованиеФорм.ФормаПотомок = ФормаПотомок;
	Возврат СериализоватьФормуНаСервере();	
КонецФункции

// Функция - Получить описание формы
// Возвращаемое значение:
//   - Адрес во временном хранилище - во временном хранилище содержится структура с описанием формы
//
&НаСервере
Функция СериализоватьФормуНаСервере() 
	Возврат НаследованиеФормВызовСервера_Ei.Сериализовать(ЭтаФорма,РеквизитФормыВЗначение("Объект"));	
КонецФункции

&НаКлиенте
Функция ПереопределитьФорму()
	Возврат НаследованиеФормКлиент_Ei.ПереопределитьФорму(НаследованиеФорм,ЭтаФорма);	
Конецфункции	

#КонецОбласти

#Область ПереопределениеСобытияФормыВызываемыхИзПотомка

&НаКлиенте
Процедура Команда(Команда) Экспорт
	Если СтрЗаканчиваетсяНа(нРег(Команда.Имя), нРег("ДеревоВыбораЗакрыть")) Тогда
		ДеревоВыбораЗакрыть(Команда);		
	КонецЕСли;	
КонецПроцедуры	

#КонецОбласти

#КонецОбласти


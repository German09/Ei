#Область ОписаниеПеременных
&НаКлиенте
Перем НаследованиеФорм Экспорт; 		//переменная используемая в фреймворке наследования форм, храняться формы от которых текущая форма заимствует поведение + форма в которую нужно передать далее свое поведение
#КонецОбласти 

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ТекстМодуля = Параметры.ТекстМодуля;
	Заголовок 	= Параметры.Имя;
	Алгоритм 	= РедакторКодаКлиент_Ei.Инициализация();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	ПроверкиПередЗакрытием(Отказ);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	//ОбработкаКлиентСервер_Алгоритм_Ei.ЗагрузитьНастройку(СтрокаОбработки.Настройка);	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДокументСформирован_ПолеФормыПолеHTMLДокумента(Элемент) 
	Форма = ПереопределитьФорму();
	ПараметрыКлиент_Ei.ДокументСформирован(Форма,Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатии_ПолеФормыПолеHTMLДокумента(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	Форма = ПереопределитьФорму();
	ПараметрыКлиент_Ei.ПриНажатии(Форма, Элемент, ДанныеСобытия, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы


&НаКлиенте
Процедура ДоступныеПеременные(Команда)
	Форма = ПереопределитьФорму();
	ОбработкаАлгоритмКлиент_Ei.ДоступныеПеременные(Форма,Команда);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПроверкиПередЗакрытием(Отказ)
	Если Не ТолькоПросмотр Тогда
		ВычислитьМодифицированность();
		Если Модифицированность Тогда
			Отказ = Истина;
			ВопросПредЗакрытием();
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВычислитьМодифицированность()
	Модифицированность = Не (ТекстМодуля = Параметры.ТекстМодуля);	
КонецПроцедуры	

&НаКлиенте
Асинх Процедура ВопросПредЗакрытием()
	Ответ = Ждать ВопросАсинх("Сохранить текущие изменения?", РежимДиалогаВопрос.ДаНетОтмена);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ТолькоПросмотр = Истина;
		Закрыть(ТекстМодуля);
	ИначеЕсли Ответ = КодВозвратаДиалога.Отмена Тогда
		//отказались от продолжения операции
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		ТолькоПросмотр = Истина;
		Закрыть();
	КонецЕсли;	
КонецПроцедуры

#Область НаследованиеФорм

//Обязательно объявление переменной НаследованиеФорм

//@skip-check export-method-in-command-form-module
#Область Общие


&НаСервере
Функция СериализоватьФорму(ПутьРеквизитов) Экспорт 
	Возврат НаследованиеФормВызовСервера_Ei.Сериализовать(ЭтотОбъект,ПутьРеквизитов);	
КонецФункции


&НаСервере
Процедура ДополнитьФорму(ЭлементРодительИмя,АдресВоВременномХранилище,ЭлементКПИмя = Неопределено) Экспорт
	НаследованиеФормВызовСервера_Ei.Структурировать(ЭтотОбъект,ЭлементРодительИмя,АдресВоВременномХранилище,ЭлементКПИмя);		
КонецПроцедуры

&НаКлиенте
Функция ПереопределитьФорму()
	Возврат НаследованиеФормКлиент_Ei.Переопределить(НаследованиеФорм,ЭтотОбъект);	
Конецфункции

&НаСервере
Процедура Переместить(ЭлементИмя,РодительИмя,МестоположениеИмя = Неопределено) Экспорт
	ОбщегоНазначения_Ei.Переместить(ЭтотОбъект,ЭлементИмя,РодительИмя,МестоположениеИмя);
КонецПроцедуры		



// Внешнее событие.
// 
// Параметры:
//  Источник - Строка - ожидаем "FileWatcher"; см. Файл
//  Событие  - Строка - папка слежения, ровно как передана в НачатьСлежение
//  Данные   - Строка 
&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	//события от папки, за которой уже не следим, могут прийти с опозданием - пропускаем их
	Если Источник = ФайлыКлиент_Ei.ИмяВкОтслеживания()
		И Не ВКОтслеживания = Неопределено И Не ВКОтслеживания = Ложь И ВКОтслеживания.СлежениеАктивно(Событие) Тогда
		ФайлыКлиент_Ei.СобытиеОтслеживания(ЭтотОбъект, Событие, ПрочитатьЗначениеJSON(Данные));
	КонецЕсли;
КонецПроцедуры


// Процедура - Сохраняет измененную колленцию в показателях результата
//
// Параметры:
//  ТД	 - ДанныеФормыЭлементДерева	 - Строка дерева вариантов
//
&НаКлиенте
Процедура ВставитьКоллекциюРезультата(ТД)
	Если Не ТД = Неопределено Тогда
		ИмяОсновногоРеквизита = РезультатыКлиент_Ei.ПолучитьИмяОсновногоРеквизита(ТД);
		ОбщегоНазначенияКлиентСервер_Ei.ПроверитьПоказателиРезультата(ТД.ПоказателиРезультата);
	 	ОписаниеЗначенияСохраненное = ТД.ПоказателиРезультата.сооАдресовРезультатов.Получить(ТД.ПоказателиВыполнения.ВидРезультата);
		АдресКоллекции 				= ?(ОписаниеЗначенияСохраненное = Неопределено, УникальныйИдентификатор,ОписаниеЗначенияСохраненное.Ссылка);
		ОписаниеЗначения 			= СохранитьКоллекциюРезультата(ИмяОсновногоРеквизита,АдресКоллекции);
		ТД.ПоказателиРезультата.сооАдресовРезультатов.Вставить(ТД.ПоказателиВыполнения.ВидРезультата,ОписаниеЗначения);
	КонецЕсли;	
КонецПроцедуры 

// Функция - Сохранить коллекцию результата
//
// Параметры:
//  ИмяОсновногоРеквизита	 - Строка	 - Имя реквизита формы 
//  АдресКоллекции			 - УникальныйИдентификатор, Строка	 - Уникальный идентифкатор формы или ранее полученный адрес во временном хранилище
// 
// Возвращаемое значение:
//   - Структура описания значения
//
&НаСервере
Функция СохранитьКоллекциюРезультата(ИмяОсновногоРеквизита,АдресКоллекции)
	//Результат 		= Неопределено;
	Если ТипЗнч(ЭтотОбъект[ИмяОсновногоРеквизита]) = Тип("ТабличныйДокумент") Тогда
		Значение = Новый ТабличныйДокумент;
		Значение.Вывести(ЭтотОбъект[ИмяОсновногоРеквизита]); //именно так если просто взять табличный документ то это быдет ссылка на адрес формы и ее сохранять бесполезно, нужно делать новый объект
	Иначе
		Значение = РеквизитФормыВЗначение(ИмяОсновногоРеквизита);
	КонецЕсли;
	//Возврат ОписаниеЗначенияВызовСервера_Ei.Подготовить(Значение,АдресКоллекции);	
КонецФункции


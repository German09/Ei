&НаКлиенте
Перем НаследованиеФорм Экспорт; 		//переменная используемая в фреймворке наследования форм, храняться формы от которых текущая форма заимствует поведение + форма в которую нужно передать далее свое поведение 

#Область Команды
&НаКлиенте
Процедура ВыполнитьДействие(Команда)
	Форма 	= ПереопределитьФорму();
	Элемент = ВариантЗапросКлиент_Ei.ЭлементИнструкции(Форма);
	РедакторКодаКлиент_Ei.ВыполнитьДействие(Команда, Элемент, Форма);
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗапрос(Команда)
	ВариантыКлиент_Ei.ВыполнитьВарианты(ПереопределитьФорму());
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИЗ(Команда)
	// ТУТ ВЫГОДНЕЕ ПОКАЗЫВАТЬ В ДИН СПИСКЕ пока не придумал как
	
	//ВариантыКлиент_Ei.ПроверитьПоказателиВыполнения(ТД.ПоказателиВыполнения);
	//ТД.ПоказателиВыполнения.ВидРезультата = "DynamicList";//0; //переключаемся на ДС
	ВариантыКлиент_Ei.ВыполнитьВарианты(ПереопределитьФорму(),Новый Структура("ПрефиксЗапроса","Выбрать * Из "));
	//вАктуализироватьТекСтраницуРезультата(ТД)
КонецПроцедуры

&НаКлиенте
Процедура КонструкторЗапроса(Команда)
	Форма 				= ПереопределитьФорму();
	Элемент 			= ВариантЗапросКлиент_Ei.ЭлементИнструкции(Форма);
	ПараметрыЗапроса 	= РедакторКодаКлиент_Ei.ПолучитьТекст(Элемент);
	 
	РедакторКодаКлиент_Ei.КонструкторЗапросаВызвать(Элемент,ПараметрыЗапроса);
КонецПроцедуры

&НаКлиенте
Процедура ПредприятиеВЯзыкПараметрыСсылка(Команда)
	ВариантЗапросКлиент_Ei.ПреобразоватьВВыражение(ПереопределитьФорму(),Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПредприятиеВЯзыкПараметрыЯвные(Команда)
	ВариантЗапросКлиент_Ei.ПреобразоватьВВыражение(ПереопределитьФорму(),Ложь);
КонецПроцедуры
#КонецОбласти

#Область События

///////////////////////////////////////////////////////////////////////////////
// Обработчики событий редактора (ПолеHTML)

&НаКлиенте
Процедура ДокументСформирован_ПолеФормыПолеHTMLДокумента(Элемент) Экспорт
	Форма = ПереопределитьФорму();
	ВариантЗапросКлиент_Ei.ДокументСформирован(Форма,Элемент);
КонецПроцедуры


&НаКлиенте
Процедура ПриНажатии_ПолеФормыПолеHTMLДокумента(Элемент, ДанныеСобытия, СтандартнаяОбработка) Экспорт
	Форма = ПереопределитьФорму();
	ВариантЗапросКлиент_Ei.ПриНажатии(Форма,Элемент, ДанныеСобытия, СтандартнаяОбработка);
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Обработчики событий формы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Запрос = РедакторКодаКлиент_Ei.Инициализация();
КонецПроцедуры
#КонецОбласти

#Область НаследованиеФорм


#Область Общие

&НаСервере
Функция СериализоватьФорму(ПутьРеквизитов) Экспорт 
	Возврат НаследованиеФормВызовСервера_Ei.Сериализовать(ЭтаФорма,ПутьРеквизитов);	
КонецФункции

&НаСервере
Процедура ДополнитьФорму(ЭлементРодительИмя,АдресВоВременномХранилище,ЭлементКПИмя = Неопределено) Экспорт
	НаследованиеФормВызовСервера_Ei.Структурировать(ЭтаФорма,ЭлементРодительИмя,АдресВоВременномХранилище,ЭлементКПИмя);		
КонецПроцедуры

&НаКлиенте
Функция ПереопределитьФорму()
	Возврат НаследованиеФормКлиент_Ei.Переопределить(НаследованиеФорм,ЭтаФорма);	
Конецфункции	

#КонецОбласти

#Область ПереопределениеСобытияФормыВызываемыхИзПотомка

&НаКлиенте
Процедура Команда(Команда) Экспорт
	Если СтрЗаканчиваетсяНа(нРег(Команда.Имя), нРег("ВыполнитьИЗ")) Тогда
		ВыполнитьИЗ(Команда);
	ИначеЕсли СтрЗаканчиваетсяНа(нРег(Команда.Имя), нРег("ВыполнитьЗапрос")) Тогда
		ВыполнитьЗапрос(Команда);
	ИначеЕсли СтрЗаканчиваетсяНа(нРег(Команда.Имя), нРег("КонструкторЗапроса")) Тогда
		КонструкторЗапроса(Команда);
	ИначеЕсли СтрЗаканчиваетсяНа(нРег(Команда.Имя), нРег("ПредприятиеВЯзыкПараметрыСсылка")) Тогда
		ПредприятиеВЯзыкПараметрыСсылка(Команда);
	ИначеЕсли СтрЗаканчиваетсяНа(нРег(Команда.Имя), нРег("ПредприятиеВЯзыкПараметрыЯвные")) Тогда
		ПредприятиеВЯзыкПараметрыЯвные(Команда);
	Иначе		
		ВыполнитьДействие(Команда);
	КонецЕсли;	
КонецПроцедуры	

#КонецОбласти

#КонецОбласти

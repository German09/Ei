&НаКлиенте
Перем cooИнфОбОшибке Экспорт; //Храним информацию об ошибке для строки события

&НаКлиенте
Процедура ДеревоСообщенийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ИнформацияОбошибке = cooИнфОбОшибке.Получить(Элемент.ТекущиеДанные);
	Если Не ИнформацияОбошибке = Неопределено Тогда
		//@skip-check bsl-legacy-check-static-feature-access
		ПоказатьИнформациюОбОшибке(ИнформацияОбошибке);
	Иначе
		Если Поле = Элементы.ДеревоСообщенийДействие Тогда
			ПоказатьЗначение(,Элемент.ТекущиеДанные.Действие);
		ИначеЕсли Поле = Элементы.ДеревоСообщенийСообщениеОбОшибке Тогда
			ПоказатьЗначение(,Элемент.ТекущиеДанные.СообщениеОбОшибке);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПодключитьВнешнююОбработкуНаСервере()
    ВнешниеОбработки.Подключить("v8res://mngbase/StandardEventLog.epf", "StandardEventLog", false);
КонецПроцедуры

&НаКлиенте
Процедура ЖурналРегистрацииНажатие(Элемент)
	ПодключитьВнешнююОбработкуНаСервере();
	//по хорошему нужно добавить отбор по событию Ei
	ОткрытьФорму("ВнешняяОбработка.StandardEventLog.Форма");
КонецПроцедуры

ЗакрыватьПриЗакрытииВладельца = Истина;
// Журнал выполнения Ei: хронология операций с вложенностью и длительностями.
// Форма только читает журнал регистрации, замеры ведет см. ЖурналКлиентСервер_Ei
// Выполнение варианта связано с запуском в истории и восстанавливается из журнала, см. ИсторияКлиент_Ei
// Открывается из см. ЖурналКлиент_Ei.ОткрытьПросмотр

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Как картинка команды Журнал и оповещений об ошибках, см. ОбщаяКартинка.Отладка_Ei
	//https://symbl.cc/ru/1F41E/
	Заголовок = СтрШаблон("%1 %2", ОбщегоНазначенияКлиентСерверПовтИсп_Ei.ПолучитьСтрокуUniCode(128030),
		НСтр("ru = 'Журнал выполнения'"));
	
	Период.Вариант = ВариантСтандартногоПериода.Сегодня;
	ТолькоТекущийСеанс = Истина;
	ЗаполнитьДерево();
	
	Если ЗначениеЗаполнено(Параметры.ИдЗамера) Тогда
		ИдентификаторСтроки = НайтиСтроку(ДеревоСообщений.ПолучитьЭлементы(), Параметры.ИдЗамера);
		Если ИдентификаторСтроки <> Неопределено Тогда
			Элементы.ДеревоСообщений.ТекущаяСтрока = ИдентификаторСтроки;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	ЗаполнитьДерево();
	
КонецПроцедуры

&НаКлиенте
Процедура ТолькоТекущийСеансПриИзменении(Элемент)
	
	ЗаполнитьДерево();
	
КонецПроцедуры

&НаКлиенте
Процедура ЖурналРегистрацииНажатие(Элемент)
	
	ПараметрыЖурнала = ПараметрыЖурналаРегистрации();
	Если ПараметрыЖурнала = Неопределено Тогда
		// В базе без БСП - стандартный просмотр журнала, отбор в нем не передать.
		ПодключитьВнешнююОбработкуНаСервере();
		ОткрытьФорму("ВнешняяОбработка.StandardEventLog.Форма");
	Иначе
		ОткрытьФорму("Обработка.ЖурналРегистрации.Форма.ЖурналРегистрации", ПараметрыЖурнала, ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоСообщений

&НаКлиенте
Процедура ДеревоСообщенийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Операция = Новый Структура;
	Операция.Вставить("Действие", ТекущиеДанные.Действие);
	Операция.Вставить("Текст", ТекущиеДанные.Текст);
	Операция.Вставить("СообщениеОбОшибке", ТекущиеДанные.СообщениеОбОшибке);
	Операция.Вставить("КлючСтроки", ТекущиеДанные.КлючСтроки);
	Операция.Вставить("Вариант", ТекущиеДанные.Вариант);
	Операция.Вставить("Запуск", ТекущиеДанные.Запуск);
	Операция.Вставить("Ид", ТекущиеДанные.Ид);
	Операция.Вставить("ЕстьОшибка", ТекущиеДанные.Статус = ЖурналКлиентСервер_Ei.СтатусыЗамера().Ошибка);
	Если ЗначениеЗаполнено(Операция.Запуск) Тогда
		ВыбратьДействиеЗапуска(Операция);
	ИначеЕсли Операция.ЕстьОшибка Тогда
		ПоказатьОшибкуОперации(Операция);
	Иначе
		ПоказатьТекстОперации(Операция);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	
	ЖурналКлиент_Ei.Отправить();
	ЗаполнитьДерево();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Запуск варианта из истории: восстановить в подстроку Ei или открыть текст операции.
//
// Параметры:
//  Операция - Структура - данные строки дерева, см. ДеревоСообщенийВыбор
//
&НаКлиенте
Асинх Процедура ВыбратьДействиеЗапуска(Операция)
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("Восстановить", НСтр("ru = 'Восстановить'"));
	Кнопки.Добавить("Текст", НСтр("ru = 'Открыть текст'"));
	Если Операция.ЕстьОшибка Тогда
		Кнопки.Добавить("Ошибка", НСтр("ru = 'Ошибка'"));
	КонецЕсли;
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
	
	Ответ = Ждать ВопросАсинх(НСтр("ru = 'Восстановить запуск в подстроку?'"), Кнопки, , "Восстановить");
	Если Ответ = "Восстановить" Тогда
		ФормаEi = ФормаEi();
		Если ФормаEi = Неопределено Тогда
			ПоказатьПредупреждение( , НСтр("ru = 'Восстановить запуск можно в открытой форме Ei с этим набором'"));
		Иначе
			ИсторияКлиент_Ei.ВосстановитьЗапускВарианта(ФормаEi, Операция.КлючСтроки, Операция.Вариант, Операция.Запуск);
			ФормаEi.Активизировать();
		КонецЕсли;
	ИначеЕсли Ответ = "Текст" Тогда
		ПоказатьТекстОперации(Операция);
	ИначеЕсли Ответ = "Ошибка" Тогда
		ПоказатьОшибкуОперации(Операция);
	КонецЕсли;
	
КонецПроцедуры

// Ошибка операции стандартным окном платформы, как раньше в форме отладки. Исходная информация об ошибке
// есть только у замеров этого сеанса, для остальных ошибка показывается текстом вместе с операцией.
//
// Параметры:
//  Операция - Структура - данные строки дерева, см. ДеревоСообщенийВыбор
//
&НаКлиенте
Процедура ПоказатьОшибкуОперации(Операция)
	
	ИнформацияОбОшибке = ЖурналКлиент_Ei.ИнформацияОбОшибкеЗамера(Операция.Ид);
	Если ИнформацияОбОшибке = Неопределено Тогда
		ПоказатьТекстОперации(Операция);
	Иначе
		//@skip-check bsl-legacy-check-static-feature-access
		ПоказатьИнформациюОбОшибке(ИнформацияОбОшибке);
	КонецЕсли;
	
КонецПроцедуры

// Полный текст операции и ошибки в отдельном окне, как значение ячейки в таблице результата.
//
// Параметры:
//  Операция - Структура - данные строки дерева, см. ДеревоСообщенийВыбор
//
&НаКлиенте
Процедура ПоказатьТекстОперации(Операция)
	
	Текст = Операция.Текст;
	Если ЗначениеЗаполнено(Операция.СообщениеОбОшибке) Тогда
		// Замер без ошибки тоже может нести сообщение, см. ЖурналКлиентСервер_Ei.ЗавершитьЗамер
		Подпись = ?(Операция.ЕстьОшибка, НСтр("ru = 'Ошибка:'"), НСтр("ru = 'Сообщение:'"));
		Текст = Текст + Символы.ПС + Символы.ПС + Подпись + Символы.ПС + Операция.СообщениеОбОшибке;
	КонецЕсли;
	ОбщегоНазначенияКлиент_Ei.ПоказатьЗначениеРасш(ЭтотОбъект, Текст, Операция.Действие, РежимОткрытияОкнаФормы.Независимый);
	
КонецПроцедуры

// Форма Ei, в которую восстанавливается запуск: владелец журнала, а если журнал открыт из оповещения об ошибке -
// любая открытая форма Ei.
//
// Возвращаемое значение:
//  ФормаКлиентскогоПриложения, Неопределено - Неопределено, если открытой формы Ei нет
//
&НаКлиенте
Функция ФормаEi()
	
	ИмяФормыEi = "ОбщаяФорма.Ei";
	Если ВладелецФормы <> Неопределено И ВладелецФормы.ИмяФормы = ИмяФормыEi И ВладелецФормы.Открыта() Тогда
		Возврат ВладелецФормы;
	КонецЕсли;
	
	Для Каждого ОкноКлиента Из ПолучитьОкна() Цикл
		Для Каждого Форма Из ОкноКлиента.Содержимое Цикл
			Если Форма.ИмяФормы = ИмяФормыEi Тогда
				Возврат Форма;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДерево()
	
	Корни = ДеревоСообщений.ПолучитьЭлементы();
	Корни.Очистить();
	
	Прочитанные = ЖурналВызовСервера_Ei.ПрочитатьЗамеры(Период.ДатаНачала, Период.ДатаОкончания, ТолькоТекущийСеанс);
	
	// Запись, выполненная внутри другой операции (серверная часть запуска варианта, вычисление параметра),
	// встает под нее по идентификатору внешней операции, если та есть среди прочитанных.
	Идентификаторы = Новый Соответствие;
	Для Каждого Прочитанный Из Прочитанные Цикл
		СобратьИдентификаторы(Прочитанный.Замер, Идентификаторы);
	КонецЦикла;
	
	ВложенныеПоВнешнему = Новый Соответствие;
	Корневые = Новый ТаблицаЗначений;
	Корневые.Колонки.Добавить("Начало");
	Корневые.Колонки.Добавить("Прочитанный");
	Для Каждого Прочитанный Из Прочитанные Цикл
		Внешний = ЗначениеСвойства(Прочитанный.Замер, "Внешний", "");
		Если ЗначениеЗаполнено(Внешний) И Идентификаторы.Получить(Внешний) <> Неопределено Тогда
			Вложенные = ВложенныеПоВнешнему.Получить(Внешний);
			Если Вложенные = Неопределено Тогда
				Вложенные = Новый Массив;
				ВложенныеПоВнешнему.Вставить(Внешний, Вложенные);
			КонецЕсли;
			Вложенные.Добавить(Прочитанный);
		Иначе
			Корневой = Корневые.Добавить();
			Корневой.Начало = Прочитанный.Замер.Начало;
			Корневой.Прочитанный = Прочитанный;
		КонецЕсли;
	КонецЦикла;
	
	// Последние операции сверху.
	Корневые.Сортировать("Начало Убыв");
	Для Каждого Корневой Из Корневые Цикл
		ЗаполнитьСтроку(Корни.Добавить(), Корневой.Прочитанный.Замер, Корневой.Прочитанный, ВложенныеПоВнешнему);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтроку(Строка, Замер, Прочитанный, ВложенныеПоВнешнему)
	
	СтатусыЗамера = ЖурналКлиентСервер_Ei.СтатусыЗамера();
	Если Замер.Статус = СтатусыЗамера.Ошибка Тогда
		Префикс = "✗ ";
	ИначеЕсли Замер.Статус = СтатусыЗамера.НеЗавершен Тогда
		Префикс = "⚠ ";
	Иначе
		Префикс = "";
	КонецЕсли;
	
	Строка.Ид = Замер.Ид;
	Строка.Тип = Замер.Тип;
	Строка.Статус = Замер.Статус;
	Строка.Текст = Замер.Операция;
	Строка.Действие = Префикс + СокрЛП(СтрПолучитьСтроку(Замер.Операция, 1));
	Строка.СообщениеОбОшибке = Замер.Ошибка;
	Если Замер.Статус = СтатусыЗамера.Ошибка Тогда
		Строка.Ошибка = КраткоеОписаниеОшибки(Замер.Ошибка);
	КонецЕсли;
	Строка.Продолжительность = Замер.Длительность / 1000;
	Строка.ДатаНачала = Замер.Начало;
	Строка.Дата = МестноеВремя('00010101' + Цел(Замер.Начало / 1000));
	Строка.Сеанс = Прочитанный.Сеанс;
	Строка.Приложение = Прочитанный.Приложение;
	
	Контекст = ЗначениеСвойства(Замер, "Контекст");
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Строка.КлючСтроки = ЗначениеСвойства(Контекст, "КлючСтроки", "");
		Строка.Вариант = ЗначениеСвойства(Контекст, "Вариант", "");
		Строка.Запуск = ЗначениеСвойства(Контекст, "Запуск", "");
	КонецЕсли;
	
	Для Каждого Вложенный Из Замер.События Цикл
		ЗаполнитьСтроку(Строка.ПолучитьЭлементы().Добавить(), Вложенный, Прочитанный, ВложенныеПоВнешнему);
	КонецЦикла;
	
	Вложенные = ВложенныеПоВнешнему.Получить(Замер.Ид);
	Если Вложенные <> Неопределено Тогда
		Для Каждого ВложенныйПрочитанный Из Вложенные Цикл
			ЗаполнитьСтроку(Строка.ПолучитьЭлементы().Добавить(), ВложенныйПрочитанный.Замер, ВложенныйПрочитанный,
				ВложенныеПоВнешнему);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СобратьИдентификаторы(Замер, Идентификаторы)
	
	Идентификаторы.Вставить(Замер.Ид, Истина);
	Для Каждого Вложенный Из Замер.События Цикл
		СобратьИдентификаторы(Вложенный, Идентификаторы);
	КонецЦикла;
	
КонецПроцедуры

// Краткое описание ошибки для колонки дерева из подробного представления, которое пишется в журнал:
// последняя причина ("по причине:") без координат модуля в фигурных скобках.
//
// Параметры:
//  ПодробноеПредставление - Строка - подробное представление ошибки из замера
//
// Возвращаемое значение:
//  Строка
//
&НаСервереБезКонтекста
Функция КраткоеОписаниеОшибки(ПодробноеПредставление)
	
	Строки = СтрРазделить(ПодробноеПредставление, Символы.ПС, Ложь);
	Описание = "";
	ПослеПричины = Истина;
	Для Каждого СтрокаОшибки Из Строки Цикл
		СтрокаОшибки = СокрЛП(СтрокаОшибки);
		Если ПустаяСтрока(СтрокаОшибки) Тогда
			Продолжить;
		КонецЕсли;
		Если НРег(СтрокаОшибки) = НРег(НСтр("ru = 'по причине:'")) Тогда
			ПослеПричины = Истина;
		ИначеЕсли ПослеПричины Тогда
			Описание = СтрокаОшибки;
			ПослеПричины = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрНачинаетсяС(Описание, "{") Тогда
		Позиция = СтрНайти(Описание, "}:");
		Если Позиция > 0 Тогда
			Описание = СокрЛП(Сред(Описание, Позиция + 2));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

// Значение свойства прочитанного замера: записи прежних версий Ei могут не содержать новых свойств.
//
// Возвращаемое значение:
//  Произвольный
//
&НаСервереБезКонтекста
Функция ЗначениеСвойства(Структура, Имя, ПоУмолчанию = Неопределено)
	
	Значение = ПоУмолчанию;
	Если Структура.Свойство(Имя) И Структура[Имя] <> Неопределено Тогда
		Значение = Структура[Имя];
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Возвращаемое значение:
//  Число, Неопределено - идентификатор строки дерева с замером ИдЗамера
//
&НаСервере
Функция НайтиСтроку(Строки, ИдЗамера)
	
	Идентификатор = Неопределено;
	Для Каждого Строка Из Строки Цикл
		Если Строка.Ид = ИдЗамера Тогда
			Идентификатор = Строка.ПолучитьИдентификатор();
		Иначе
			Идентификатор = НайтиСтроку(Строка.ПолучитьЭлементы(), ИдЗамера);
		КонецЕсли;
		Если Идентификатор <> Неопределено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Идентификатор;
	
КонецФункции

// Параметры формы журнала регистрации БСП с отбором по замерам Ei текущего пользователя.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если в базе нет обработки ЖурналРегистрации из БСП
//
&НаСервере
Функция ПараметрыЖурналаРегистрации()
	
	ПараметрыЖурнала = Неопределено;
	Если Метаданные.Обработки.Найти("ЖурналРегистрации") <> Неопределено Тогда
		ПараметрыЖурнала = Новый Структура;
		ПараметрыЖурнала.Вставить("СобытиеЖурналаРегистрации", ЖурналКлиентСервер_Ei.ИмяСобытияЖурнала());
		ПараметрыЖурнала.Вставить("Пользователь", ИмяПользователя());
		ПараметрыЖурнала.Вставить("ДатаНачала", Период.ДатаНачала);
		ПараметрыЖурнала.Вставить("ДатаОкончания", Период.ДатаОкончания);
		Если ТолькоТекущийСеанс Тогда
			ПараметрыЖурнала.Вставить("Сеанс", НомерСеансаИнформационнойБазы());
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПараметрыЖурнала;
	
КонецФункции


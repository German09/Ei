
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	КоллекцияВызовСервера_Ei.Инициализация(ЭтотОбъект, Отказ, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

//@skip-check module-unused-method
#Область СлужебныеПроцедурыИФункции
#Область РаботаСКоллекцией

&НаКлиенте
Процедура КоллекцияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	КоллекцияКлиент_Ei.Выбор(ЭтотОбъект, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);		
КонецПроцедуры

&НаКлиенте
Процедура КоллекцияПриАктивизацииСтроки(Элемент)
	КоллекцияКлиент_Ei.ПриАктивизацииСтроки(ЭтотОбъект, Элемент);		
КонецПроцедуры

&НаКлиенте
Процедура КоллекцияПриАктивизацииЯчейки(Элемент)
	КоллекцияКлиент_Ei.ПриАктивизацииЯчейки(ЭтотОбъект, Элемент);		
КонецПроцедуры

&НаКлиенте
Процедура КоллекцияНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	ЗначенияЯчеек = КоллекцияКлиент_Ei.ПолучитьВыделенныеЯчейки(ЭтотОбъект,Элемент, Элемент.ВыделенныеСтроки, Элемент.ТекущийЭлемент); 
	ПеретаскиваниеКлиент_Ei.НачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение, ЗначенияЯчеек);
КонецПроцедуры

#КонецОбласти
#КонецОбласти

// Окно запроса MCP: человек разрешает или отклоняет серверный код, выполняет или отклоняет клиентский.
// Открывается из см. ЗапросыMCPКлиент_Ei.ПриПолученииЗапроса

#Область ОписаниеПеременных

// Данные уведомления mcp_ЗапросВыполненияКода, заполняются до открытия формы.
&НаКлиенте
Перем Запрос Экспорт;

&НаКлиенте
Перем ЗапросЗакрыт;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Запрос = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ЗапросЗакрыт = Ложь;
	ЭтоКлиент = Запрос.Контекст = "client";
	
	Код = Запрос.Код;
	ОпасныеКонструкции = СтрСоединить(Запрос.ОпасныеКонструкции, ", ");
	
	Если ЭтоКлиент Тогда
		Заголовок = НСтр("ru = 'MCP: выполнить код в клиенте?'");
		Действие = НСтр("ru = 'выполнить код в этом клиенте 1С. Код можно изменить перед выполнением'");
	Иначе
		Заголовок = НСтр("ru = 'MCP: разрешить код на сервере?'");
		Действие = НСтр("ru = 'выполнить код на сервере в HTTP-сеансе MCP. Код выполнит MCP без изменений'");
	КонецЕсли;
	
	Описание = СтрШаблон(НСтр("ru = 'Модель через MCP просит %1.
		|Запрос создан %2, ответ принимается до %3 (UTC).'"),
		Действие, Формат(Запрос.Создан, "ДЛФ=T"), Формат(Запрос.СрокДействия, "ДЛФ=T"));
	
	Элементы.Код.ТолькоПросмотр = Не ЭтоКлиент;
	Элементы.ОпасныеКонструкции.Видимость = ЗначениеЗаполнено(ОпасныеКонструкции);
	Элементы.ФормаРазрешить.Видимость = Не ЭтоКлиент;
	Элементы.ФормаВыполнитьКод.Видимость = ЭтоКлиент;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = ЗапросыMCPКлиент_Ei.ИмяСобытияЗапросЗакрыт()
		И Запрос <> Неопределено
		И Параметр = Запрос.Идентификатор Тогда
		ЗакрытьЗапрос();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Разрешить(Команда)
	
	ЗапросыMCPКлиент_Ei.Ответить(Запрос, "Разрешено");
	ЗакрытьЗапрос();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКод(Команда)
	
	ЗапросыMCPКлиент_Ei.ВыполнитьИОтветить(Запрос, Код);
	ЗакрытьЗапрос();
	
КонецПроцедуры

&НаКлиенте
Процедура Отклонить(Команда)
	
	ЗапросыMCPКлиент_Ei.Ответить(Запрос, "Отклонено");
	ЗакрытьЗапрос();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗакрытьЗапрос()
	
	Если ЗапросЗакрыт Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросЗакрыт = Истина;
	Если Открыта() Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

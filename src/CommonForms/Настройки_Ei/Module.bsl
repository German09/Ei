
#Область ОбработчикиСобытийФормы
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	КаталогИсходныхКодов = НастройкиПользователяКлиентСервер_Ei.ПолучитьКаталогИсходногоКода(ВладелецФормы.НастройкиПользователя);
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Асинх Процедура КаталогИсходныхКодовНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ФайлКаталог 	= Новый Файл(КаталогИсходныхКодов);
	Длг 			= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Длг.Каталог 	= ФайлКаталог;
	Длг.Заголовок 	= "Выберите каталог проекта EDT, текущей конфигурации";
	Длг.МножественныйВыбор 	= Ложь;
	Каталоги = Ждать Длг.ВыбратьАсинх();
	Если Не Каталоги =  Неопределено Тогда
		Для Каждого Каталог ИЗ Каталоги Цикл
			КаталогИсходныхКодов = Каталог;
			Пояснения = Новый Массив;
			КакталогИсходников = Новый Файл(КаталогИсходныхКодов+ПолучитьРазделительПути()+ФайлыКлиентСервер_Ei.КаталогИсходников()); 
			Если Не Ждать КакталогИсходников.СуществуетАсинх() Тогда
				//см. РедакторКодаКлиент_Ei.ЗагрузитьОбщийМодульПоИмени
				//см. РедакторКодаКлиент_Ei.ЗагрузитьМодульМенеджераИлиОбъектаПоИмени
				Пояснения.Добавить(СтрШаблон("каталог %1 - в алгоритмах исходники не будут загружены",ФайлыКлиентСервер_Ei.КаталогИсходников()));	
			КонецЕсли;
			КакталогОпределенияПроекта = Новый Файл(КаталогИсходныхКодов+ПолучитьРазделительПути()+EDTКлиент_Ei.ОпределениеПроекта().Каталог); 
			Если Не Ждать КакталогОпределенияПроекта.СуществуетАсинх() Тогда
				//см. EDTКлиент_Ei.СоздатьОпределение
				Пояснения.Добавить(СтрШаблон("каталог %1 - при сохранении связь с проектом будет отсутствовать",EDTКлиент_Ei.ОпределениеПроекта().Каталог));	
			КонецЕсли;
			Если Пояснения.Количество() Тогда
				ПоказатьОповещениеПользователя("В каталоге отсутствует проект EDT",,СтрСоединить(Пояснения,Символы.ПС));		
			КонецЕсли;		 	 
			Прервать;		
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры
#КонецОбласти


#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	НастройкиПользователяКлиентСервер_Ei.СохранитьКаталогИсходногоКода(ВладелецФормы.НастройкиПользователя,КаталогИсходныхКодов);
	КонструкторКлиент_Ei.ЗапомнитьНастройки(ВладелецФормы);
	Закрыть();
КонецПроцедуры
#КонецОбласти

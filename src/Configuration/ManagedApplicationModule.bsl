&После("ПриНачалеРаботыСистемы")
Асинх Процедура РедакторКода_ПриНачалеРаботыСистемы()
	Подключено=Истина;
	#Если ВебКлиент Тогда
		Подключено=Ждать ПодключитьРасширениеРаботыСФайламиАсинх();

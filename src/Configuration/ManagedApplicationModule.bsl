#Область ОписаниеПеременных

//@skip-check extension-variable-prefix
Перем КлиентИнициализирован_Ei;

#КонецОбласти

#Область ОбработчикиСобытий

//@skip-check extension-method-prefix
&После("ПриНачалеРаботыСистемы")
Процедура ПриНачалеРаботыСистемы_Ei()
	ИнициализироватьКлиент_Ei();
КонецПроцедуры

//@skip-check extension-method-prefix
&После("OnStart")
Процедура OnStart_Ei()
	ИнициализироватьКлиент_Ei();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//@skip-check extension-method-prefix
Асинх Процедура ИнициализироватьКлиент_Ei()
	Если КлиентИнициализирован_Ei = Истина Тогда
		Возврат;
	КонецЕсли;
	КлиентИнициализирован_Ei = Истина;

	ЗапросыMCPКлиент_Ei.ПодключитьОбработчики();
	ФоновоеВыполнениеКлиент_Ei.ПодключитьОбработчики();
	#Если ВебКлиент Тогда
		Подключено = Ждать ПодключитьРасширениеРаботыСФайламиАсинх();
		Если Не Подключено Тогда
			Ждать УстановитьРасширениеРаботыСФайламиАсинх();
		КонецЕсли;
	#КонецЕсли
КонецПроцедуры

#КонецОбласти

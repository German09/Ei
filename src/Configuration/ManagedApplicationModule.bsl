#Область ОписаниеПеременных
//@skip-check extension-variable-prefix
Перем КаталогВременныхФайлов_Ei Экспорт;
#КонецОбласти

#Область ОбработчикиСобытий
//@skip-check extension-method-prefix
&После("ПриНачалеРаботыСистемы")
Асинх Процедура ПриНачалеРаботыСистемы_Ei()
	Подключено=Истина;
	#Если ВебКлиент Тогда
		Подключено = Ждать ПодключитьРасширениеРаботыСФайламиАсинх();
		Если НЕ Подключено Тогда
			Обещание = Ждать УстановитьРасширениеРаботыСФайламиАсинх();
		КонецЕсли;
	#КонецЕсли
	Если Подключено Тогда
		КаталогВременныхФайлов_Ei = Ждать КаталогВременныхФайловАсинх();
	КонецЕсли;
КонецПроцедуры
#КонецОбласти
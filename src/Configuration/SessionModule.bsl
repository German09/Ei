
&После("УстановкаПараметровСеанса")
Процедура УстановкаПараметровСеанса_Ei(ИменаПараметровСеанса)
	ИнициализироватьПараметрыСеанса_Ei(ИменаПараметровСеанса);
КонецПроцедуры

&После("SessionParametersSetting")
Процедура SessionParametersSetting_Ei(ИменаПараметровСеанса)
	ИнициализироватьПараметрыСеанса_Ei(ИменаПараметровСеанса);
КонецПроцедуры

Процедура ИнициализироватьПараметрыСеанса_Ei(ИменаПараметровСеанса)
	Если ИменаПараметровСеанса = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УстановленныеПараметры = Новый Массив;
	Для Каждого ИмяПараметра Из ИменаПараметровСеанса Цикл
		УстановитьЗначениеПараметраСеанса(ИмяПараметра, УстановленныеПараметры);
	КонецЦикла;
КонецПроцедуры

// Установить значения параметров сеанса и возвратить имена установленных параметров сеанса
// в параметре УстановленныеПараметры.
//
// Параметры
//  ИмяПараметра  - Строка - имя параметра сеанса, который требуется установить (проинициализировать).
//  УстановленныеПараметры  - Массив - массив, в который добавляются имена
//                                     установленных (проинициализированных) параметров.
//
Процедура УстановитьЗначениеПараметраСеанса(Знач ИмяПараметра, УстановленныеПараметры)
 
 // Если в данном вызове УстановкаПараметровСеанса параметр ИмяПараметра уже
 // был установлен - возврат.
	Если УстановленныеПараметры.Найти(ИмяПараметра) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
 
	Если ИмяПараметра = "НаборВариантов_Ei" Тогда
	   	ПараметрыСеанса.НаборВариантов_Ei = Новый ФиксированнаяСтруктура;
	   	УстановленныеПараметры.Добавить(ИмяПараметра);
	ИначеЕсли ИмяПараметра = "Набор_Ei" Тогда
	   	ПараметрыСеанса.Набор_Ei = "";
	   	УстановленныеПараметры.Добавить(ИмяПараметра);
	ИначеЕсли ИмяПараметра = "ЗапускВарианта_Ei" Тогда
		// Идентификатор выполняемого запуска варианта, см. ИсторияВызовСервера_Ei
		ПараметрыСеанса.ЗапускВарианта_Ei = "";
		УстановленныеПараметры.Добавить(ИмяПараметра);
	ИначеЕсли ИмяПараметра = "Объект_Процессы_Ei" Тогда
	   	ПараметрыСеанса.Объект_Процессы_Ei = Новый ФиксированныйМассив(Новый Массив);
	   	УстановленныеПараметры.Добавить(ИмяПараметра); 
	ИначеЕсли ИмяПараметра = "ХешАдресов_Ei" Тогда
	   	ПараметрыСеанса.ХешАдресов_Ei = Новый ФиксированноеСоответствие(Новый Соответствие());;
	   	УстановленныеПараметры.Добавить(ИмяПараметра); 
	ИначеЕсли ИмяПараметра = "РедакторКодаДанные_Ei" Тогда
		КоллекцияОбщихМодулей 	= РедакторКодаВызовСервера_Ei.ПолучитьКоллекциюОбщихМодулей();
		СтруктураДанных			= Новый Структура;
		СтруктураДанных.Вставить("ОбщиеМодули",ОбщегоНазначенияКлиентСервер_Ei.СериализоватьJSON(КоллекцияОбщихМодулей.Общие));
	   	ПараметрыСеанса.РедакторКодаДанные_Ei = Новый ФиксированнаяСтруктура(СтруктураДанных);
	   	УстановленныеПараметры.Добавить(ИмяПараметра);               
	КонецЕсли;
	
КонецПроцедуры
